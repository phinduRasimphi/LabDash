@model IEnumerable<LabDash.Models.Patient>

@{
    ViewData["Title"] = "Patient Information";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="records-box">

    <div style="padding:20px;border-bottom:1px solid #eee;">
        <h2 style="color:#0d766e;">
            Patient Information
        </h2>
    </div>

    <table class="table table-hover">

        <thead class="table-success">

            <tr>
                <th>Patient ID</th>
                <th>Name</th>
                <th>ID Number</th>
                <th>Email</th>
                <th></th>
            </tr>

        </thead>

        <tbody>

            @foreach (var item in Model)
            {
                <tr>

                    <td>@item.PatientID</td>

                    <td>@item.Name @item.Surname</td>

                    <td>@item.IDNumber</td>

                    <td>@item.Email</td>

                    <td>

                        <a asp-action="Details"
                           asp-route-id="@item.PatientID"
                           class="btn-view">

                            View Record

                        </a>

                    </td>

                </tr>
            }

        </tbody>

    </table>

</div>