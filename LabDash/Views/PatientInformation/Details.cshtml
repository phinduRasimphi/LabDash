@model LabDash.Models.Patient

@{
    ViewData["Title"] = "Patient Medical Information";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="records-box">

    <div style="padding:20px;border-bottom:1px solid #eee;">

        <h2 style="color:#0d766e;">

            Patient Medical Information

        </h2>

    </div>

    <div style="padding:25px;">

        <div class="row">

            <div class="col-md-6">

                <h4>Patient Details</h4>

                <hr />

                <p><strong>Name:</strong> @Model.Name @Model.Surname</p>

                <p><strong>ID Number:</strong> @Model.IDNumber</p>

                <p><strong>Date of Birth:</strong> @Model.DOB.ToString("dd MMM yyyy")</p>

                <p><strong>Email:</strong> @Model.Email</p>

            </div>

            <div class="col-md-6">

                <h4>Medical Information</h4>

                <hr />

                <div class="alert alert-danger">

                    <strong>Allergies</strong>

                    <br />

                    @Model.Allergies

                </div>

                <div class="alert alert-warning">

                    <strong>Medical Conditions</strong>

                    <br />

                    @Model.MedicalConditions

                </div>

                <div class="alert alert-info">

                    <strong>Medication</strong>

                    <br />

                    @Model.Medication

                </div>

            </div>

        </div>

        <hr />

        <a asp-action="Index"
           class="btn btn-secondary">

            Back

        </a>

    </div>

</div>