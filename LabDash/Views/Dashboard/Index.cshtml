                transition: background .15s
            }

                .pat-row-link:hover {
                    background: #F0F7F6
                }

            .pat-urgency {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600
            }

                .pat-urgency.routine {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

                .pat-urgency.urgent {
                    background: var(--or-dim);
                    color: #924E18
                }

                .pat-urgency.stat {
                    background: var(--rd-dim);
                    color: #942F28
                }

            .pat-status {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600
            }

                .pat-status.submitted {
                    background: #F0F4F8;
                    color: #3C5770
                }

                .pat-status.inprogress {
                    background: var(--or-dim);
                    color: #924E18
                }

                .pat-status.completed {
                    background: var(--gn-dim);
                    color: var(--gn)
                }

                .pat-status.released {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

            .pat-profile-list {
                padding: 10px 26px 18px
            }

            .pat-profile-row {
                display: flex;
                justify-content: space-between;
                padding: 11px 0;
                border-bottom: 1px solid var(--ln);
                font-size: 13.5px
            }

            .pat-profile-label {
                font-weight: 600;
                color: var(--ink-s)
            }

            /* quick actions */
            .pat-action {
                display: flex;
                flex-direction: column;
                text-decoration: none;
                color: inherit;
                background: var(--bg);
                border-radius: var(--r);
                padding: 28px 24px;
                box-shadow: var(--sh-sm);
                position: relative;
                overflow: hidden;
                transition: transform .25s,box-shadow .25s
            }

                .pat-action::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 4px;
                    background: linear-gradient(90deg,var(--pt),var(--pt-deep))
                }

                .pat-action:hover {
                    transform: translateY(-6px);
                    box-shadow: var(--sh);
                    text-decoration: none;
                    color: inherit
                }

            .pat-action-icon {
                width: 54px;
                height: 54px;
                margin-bottom: 16px;
                border-radius: 16px;
                background: var(--pt-dim);
                color: var(--pt);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 23px
            }

            .pat-action h5 {
                font-weight: 700;
                margin: 0 0 8px;
                font-size: 15px
            }

            .pat-action p {
                margin: 0;
                color: var(--ink-s);
                font-size: 13px;
                line-height: 1.6
            }

            .pat-action-foot {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-top: auto;
                padding-top: 16px;
                min-height: 48px
            }

            .pat-badges {
                display: flex;
                gap: 6px;
                flex-wrap: wrap
            }

            .pat-badge {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600;
                background: #F0F4F8;
                color: #3C5770
            }

                .pat-badge.info {
                    background: var(--bl-dim);
                    color: var(--bl)
                }

                .pat-badge.ok {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

                .pat-badge.warn {
                    background: var(--or-dim);
                    color: #924E18
                }

            .pat-action-go {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--pt-dim);
                color: var(--pt);
                margin-left: auto;
                transition: transform .2s,background .2s,color .2s
            }

            .pat-action:hover .pat-action-go {
                transform: translateX(4px);
                background: var(--pt);
                color: #fff
            }

            /* keyboard focus */
            .pat-stat:focus-visible, .pat-action:focus-visible, .pat-refresh:focus-visible, .pat-row-link:focus-visible, .pat-alert-link:focus-visible, .pat-panel-link:focus-visible {
                outline: 3px solid rgba(14,140,127,.45);
                outline-offset: 2px
            }

            .pat-footer {
                margin-top: 50px;
                text-align: center
            }

                .pat-footer hr {
                    border: none;
                    border-top: 1px solid var(--ln);
                    margin-bottom: 22px
                }

            .pat-footer-content {
                display: flex;
                justify-content: center;
                gap: 12px;
                color: var(--ink-s);
                font-size: 13px
            }

                .pat-footer-content i {
                    color: var(--pt)
                }

            @@media(max-width:1100px) {
                .pat-grid-4, .pat-grid-3 {
                    grid-template-columns: repeat(2,1fr)
                }

                .pat-split {
                    grid-template-columns: 1fr
                }
            }

            @@media(max-width:900px) {
                .pat-banner {
                    flex-direction: column;
                    gap: 24px
                }

                .pat-clock {
                    width: 100%;
                    border-left: none;
                    border-top: 1px solid rgba(255,255,255,.28);
                    padding-top: 18px;
                    padding-left: 0
                }

                .pat-banner-left {
                    flex-direction: column
                }
            }

            @@media(max-width:640px) {
                .pat-wrap {
                    padding: 20px 16px
                }

                .pat-grid-4, .pat-grid-3 {
                    grid-template-columns: 1fr
                }

                .pat-alert-strip {
                    flex-direction: column
                }
            }

            @@media(prefers-reduced-motion:reduce) {
                .pat-wrap, .pat-icon-ring, .pat-refresh.is-loading i {
                    animation: none
                }
            }
        </style>


    }
  
                
