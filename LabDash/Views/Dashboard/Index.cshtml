@section Scripts {
    <script>
        function updateClock() {
            const now = new Date();
            document.getElementById("currentDate").innerHTML = now.toLocaleDateString("en-ZA", {
                weekday: "long", day: "numeric", month: "long", year: "numeric"
            });
            document.getElementById("currentTime").innerHTML = now.toLocaleTimeString("en-ZA", {
                hour: "2-digit", minute: "2-digit", second: "2-digit"
            });
        }
        updateClock();
        setInterval(updateClock, 1000);

        // Animated counters
        document.querySelectorAll(".counter").forEach(counter => {
            let target = Number(counter.dataset.value);
            let current = 0;
            let increment = target > 0 ? Math.ceil(target / 40) : 1;
            const timer = setInterval(() => {
                current += increment;
                if (current >= target) {
                    counter.innerHTML = target;
                    clearInterval(timer);
                } else {
                    counter.innerHTML = current;
                }
            }, 30);
        });
    </script>
}

<style>
    :root {
        --db-paper: #F0F7F6;
        --db-raised: #FFFFFF;
        --db-ink: #102C27;
        --db-ink-soft: #52716C;
        --db-ink-faint: #8FA9A3;
        --db-line: #E1EEEC;
        --db-line-strong: #CCE3DF;

        --db-teal: #0E8C7F;
        --db-teal-deep: #0A5850;
        --db-teal-dim: #E3F4F1;
        --db-teal-grad-start: #12A392;
        --db-teal-grad-end: #0A4F48;

        --db-blue: #2C6E9E; --db-blue-dim: #E4F0F9;
        --db-green: #2E8B57; --db-green-dim: #E4F5EB;
        --db-purple: #6D4EA8; --db-purple-dim: #EEE8F9;
        --db-red: #B0463F; --db-red-dim: #F7E8E7;
        --db-orange: #B76A2C; --db-orange-dim: #FBEEE1;
        --db-gold: #B4862A; --db-gold-dim: #FBF1DA;

        --db-radius: 20px;
        --db-radius-sm: 13px;
        --db-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --db-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    body { background: var(--db-paper); }

    .db-wrap {
        max-width: 1280px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--db-ink);
        font-family: 'Inter', sans-serif;
        animation: dbFadeIn .5s ease;
    }

    @@keyframes dbFadeIn {
        from { opacity: 0; transform: translateY(12px); }
        to { opacity: 1; transform: translateY(0); }
    }

    /* ============ BANNER ============ */
    .db-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--db-teal-grad-start), var(--db-teal-grad-end));
        border-radius: var(--db-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }
    .db-banner-pattern {
        position: absolute; inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%),
                           radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .db-banner-left { display: flex; align-items: center; gap: 22px; position: relative; z-index: 1; }

    .db-banner-icon {
        position: relative;
        width: 76px; height: 76px; border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex; align-items: center; justify-content: center;
        color: #fff; font-size: 30px; flex-shrink: 0;
    }
    .db-icon-ring {
        position: absolute; inset: -6px; border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: dbRingPulse 2.4s ease-out infinite;
    }
    @@keyframes dbRingPulse {
        0% { transform: scale(0.9); opacity: .8; }
        100% { transform: scale(1.35); opacity: 0; }
    }

    .db-banner-text { position: relative; z-index: 1; }
    .db-banner-text h1 {
        font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 26px;
        margin: 0 0 4px; color: #fff; letter-spacing: -.01em;
    }
    .db-banner-text h1 span { color: #E9FFFB; }
    .db-banner-text p { margin: 0 0 14px; color: rgba(255,255,255,.85); font-size: 14.5px; }

    .db-pills { display: flex; gap: 10px; flex-wrap: wrap; }
    .db-pill {
        display: inline-flex; align-items: center; gap: 8px;
        padding: 7px 15px; border-radius: 999px;
        background: rgba(255,255,255,.16); color: #fff;
        font-size: 12.5px; font-weight: 500;
    }

    .db-clock {
        position: relative; z-index: 1;
        min-width: 230px; text-align: left;
        border-left: 1px solid rgba(255,255,255,.28);
        padding-left: 28px; flex-shrink: 0;
    }
    .db-clock small {
        font-family: 'Inter', sans-serif; font-weight: 600; letter-spacing: .04em; text-transform: uppercase;
        color: #DFF9F8; font-size: 11px;
    }
    #currentDate { margin-top: 6px; font-size: 14px; color: #fff; }
    #currentTime {
        font-family: 'IBM Plex Mono', monospace; font-size: 26px; font-weight: 600;
        letter-spacing: .02em; color: #fff; margin-top: 2px;
    }

    /* ============ WORKFLOW PIPELINE (signature) ============ */
    .db-pulse {
        background: var(--db-raised);
        border-radius: var(--db-radius);
        box-shadow: var(--db-shadow);
        padding: 26px 30px;
        margin-bottom: 28px;
    }
    .db-pulse-label {
        font-family: 'Inter', sans-serif; font-weight: 700; font-size: 12.5px;
        letter-spacing: .03em; text-transform: uppercase; color: var(--db-teal-deep);
        display: flex; align-items: center; gap: 8px; margin-bottom: 22px;
    }

    .db-flow { display: flex; align-items: flex-start; }
    .db-flow-node { display: flex; flex-direction: column; align-items: center; flex: 0 0 auto; width: 130px; }
    .db-flow-circle {
        width: 48px; height: 48px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 18px; color: #fff; margin-bottom: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,.12);
    }
    .db-flow-circle.n-teal { background: var(--db-teal); }
    .db-flow-circle.n-blue { background: var(--db-blue); }
    .db-flow-circle.n-green { background: var(--db-green); }
    .db-flow-circle.n-purple { background: var(--db-purple); }
    .db-flow-count { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 20px; color: var(--db-ink); }
    .db-flow-label { font-size: 12px; color: var(--db-ink-soft); text-align: center; margin-top: 2px; }

    .db-flow-line {
        flex: 1 1 auto; height: 3px; background: var(--db-line);
        border-radius: 3px; margin-top: 24px; position: relative; overflow: hidden;
    }
    .db-flow-line-fill { position: absolute; left: 0; top: 0; height: 100%; background: var(--db-teal); border-radius: 3px; }

    .db-pulse-chips { display: flex; gap: 10px; margin-top: 24px; flex-wrap: wrap; }
    .db-chip {
        display: inline-flex; align-items: center; gap: 8px;
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 12.5px;
        padding: 8px 16px; border-radius: 999px;
    }
    .db-chip.chip-stat { background: var(--db-red-dim); color: var(--db-red); }
    .db-chip.chip-overdue { background: var(--db-orange-dim); color: var(--db-orange); }

    /* ============ SECTION HEADS ============ */
    .db-section-head { display: flex; justify-content: space-between; align-items: center; margin-bottom: 18px; }
    .db-section-head h3 { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 20px; margin: 0 0 3px; }
    .db-section-head p { margin: 0; color: var(--db-ink-soft); font-size: 13.5px; }
    .db-mt-lg { margin-top: 44px; }
    .db-mb-lg { margin-bottom: 30px; }

    /* ============ GRIDS ============ */
    .db-grid { display: grid; gap: 18px; }
    .db-grid-4 { grid-template-columns: repeat(4, 1fr); }
    .db-grid-mt { margin-top: 18px; }

    /* ============ STAT CARDS ============ */
    .db-stat {
        background: var(--db-raised);
        border-radius: var(--db-radius);
        box-shadow: var(--db-shadow-sm);
        padding: 22px;
        display: flex; align-items: center; gap: 16px;
        border-top: 3px solid var(--db-teal);
        transition: transform .2s, box-shadow .2s;
    }
    .db-stat:hover { transform: translateY(-5px); box-shadow: var(--db-shadow); }
    .db-stat-urgent { border-top-color: var(--db-red); }

    .db-stat-icon {
        width: 54px; height: 54px; border-radius: 15px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; font-size: 21px;
    }
    .db-stat-icon.c-teal { background: var(--db-teal-dim); color: var(--db-teal); }
    .db-stat-icon.c-teal-deep { background: var(--db-teal-dim); color: var(--db-teal-deep); }
    .db-stat-icon.c-blue { background: var(--db-blue-dim); color: var(--db-blue); }
    .db-stat-icon.c-green { background: var(--db-green-dim); color: var(--db-green); }
    .db-stat-icon.c-purple { background: var(--db-purple-dim); color: var(--db-purple); }
    .db-stat-icon.c-red { background: var(--db-red-dim); color: var(--db-red); }
    .db-stat-icon.c-orange { background: var(--db-orange-dim); color: var(--db-orange); }
    .db-stat-icon.c-gold { background: var(--db-gold-dim); color: var(--db-gold); }

    .db-stat .num { font-family: 'Poppins', sans-serif; font-size: 27px; font-weight: 700; color: var(--db-ink); }
    .db-stat h5 { margin: 2px 0 0; font-size: 13.5px; font-weight: 600; }
    .db-stat small { color: var(--db-ink-faint); font-size: 12px; }

    /* ============ QUICK ACTION CARDS ============ */
    .db-action {
        display: block; text-decoration: none; color: var(--db-ink);
        background: var(--db-raised); border-radius: var(--db-radius);
        padding: 28px 24px; text-align: left;
        box-shadow: var(--db-shadow-sm);
        position: relative; overflow: hidden;
        transition: transform .25s, box-shadow .25s;
    }
    .db-action::before {
        content: ""; position: absolute; top: 0; left: 0; width: 100%; height: 4px;
        background: linear-gradient(90deg, var(--db-teal), var(--db-teal-deep));
    }
    .db-action:hover { transform: translateY(-6px); box-shadow: var(--db-shadow); color: var(--db-ink); text-decoration: none; }
    .db-action:hover .db-action-go { transform: translateX(4px); opacity: 1; }
    .db-action-icon {
        width: 54px; height: 54px; margin-bottom: 16px; border-radius: 16px;
        background: var(--db-teal-dim); color: var(--db-teal);
        display: flex; align-items: center; justify-content: center; font-size: 23px;
    }
    .db-action h5 { font-weight: 700; margin: 0 0 8px; font-size: 15px; }
    .db-action p { color: var(--db-ink-soft); margin: 0; font-size: 13px; line-height: 1.6; }
    .db-action-go {
        display: inline-flex; margin-top: 14px; color: var(--db-teal);
        opacity: .5; transition: transform .2s, opacity .2s; font-size: 13px;
    }

    /* ============ PERFORMANCE STRIP ============ */
    .db-perf-strip {
        background: var(--db-raised); border-radius: var(--db-radius);
        box-shadow: var(--db-shadow-sm); display: flex; align-items: center;
        padding: 22px 10px;
    }
    .db-perf-item { flex: 1; display: flex; align-items: center; gap: 14px; justify-content: center; }
    .db-perf-icon {
        width: 46px; height: 46px; border-radius: 50%;
        background: var(--db-teal-dim); color: var(--db-teal);
        display: flex; align-items: center; justify-content: center; font-size: 18px; flex-shrink: 0;
    }
    .db-perf-item h4 { font-family: 'Poppins', sans-serif; font-size: 20px; font-weight: 700; margin: 0; text-align: left; }
    .db-perf-item span { color: var(--db-ink-soft); font-size: 12.5px; }
    .db-perf-div { width: 1px; align-self: stretch; background: var(--db-line); margin: 0 4px; }

    /* ============ PANELS (filter / queue) ============ */
    .db-panel {
        background: var(--db-raised); border-radius: var(--db-radius);
        box-shadow: var(--db-shadow); overflow: hidden;
    }
    .db-panel-head {
        display: flex; justify-content: space-between; align-items: center;
        padding: 18px 26px; border-bottom: 1px solid var(--db-line);
    }
    .db-panel-head span:first-child {
        font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 15.5px; color: var(--db-ink);
        display: flex; align-items: center; gap: 10px;
    }
    .db-panel-head span:first-child i { color: var(--db-teal); }
    .db-panel-head small { display: block; color: var(--db-ink-faint); font-size: 12.5px; margin-top: 2px; }
    .db-panel-tag {
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px;
        background: var(--db-teal-dim); color: var(--db-teal-deep);
        padding: 6px 13px; border-radius: 999px;
    }
    .db-panel-count {
        font-family: 'Inter', sans-serif; font-weight: 700; font-size: 12.5px;
        background: var(--db-teal); color: #fff; padding: 7px 15px; border-radius: 999px;
    }
    .db-panel-body { padding: 26px; }

    /* ============ FILTER FORM ============ */
    .db-filter-grid { display: grid; grid-template-columns: 1fr 1fr 1.4fr 1.4fr auto; gap: 16px; align-items: end; }
    .db-field { display: flex; flex-direction: column; gap: 7px; }
    .db-field label {
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 12px;
        letter-spacing: .02em; color: var(--db-ink-soft);
    }
    .db-select, .db-input {
        height: 46px; border-radius: var(--db-radius-sm); border: 1px solid var(--db-line-strong);
        padding: 0 14px; font-family: 'Inter', sans-serif; font-size: 13.5px; color: var(--db-ink);
        background: var(--db-raised); outline: none; transition: border-color .15s, box-shadow .15s;
    }
    .db-select:focus, .db-input:focus { border-color: var(--db-teal); box-shadow: 0 0 0 3px var(--db-teal-dim); }
    .db-btn-apply {
        height: 46px; border: none; border-radius: 999px; padding: 0 24px;
        background: var(--db-teal); color: #fff; font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px;
        display: inline-flex; align-items: center; gap: 8px; cursor: pointer; white-space: nowrap; transition: .15s;
    }
    .db-btn-apply:hover { background: var(--db-teal-deep); }

    /* ============ TABLE ============ */
    .db-table-wrap { overflow-x: auto; }
    .db-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .db-table thead th {
        text-align: left; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 11.5px;
        letter-spacing: .04em; text-transform: uppercase; color: var(--db-ink-faint);
        padding: 15px 22px; background: var(--db-teal-dim); white-space: nowrap;
    }
    .db-table tbody td { padding: 16px 22px; border-bottom: 1px solid var(--db-line); }
    .db-table tbody tr:hover { background: var(--db-teal-dim); }
    .db-table tbody tr:last-child td { border-bottom: none; }
    .db-text-center { text-align: center; }

    /* Urgency / status badges (for use once bound to Model) */
    .db-badge {
        display: inline-flex; align-items: center; gap: 6px;
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px;
        padding: 5px 12px; border-radius: 999px;
    }
    .db-badge.b-stat { background: var(--db-red-dim); color: var(--db-red); }
    .db-badge.b-urgent { background: var(--db-orange-dim); color: var(--db-orange); }
    .db-badge.b-routine { background: var(--db-teal-dim); color: var(--db-teal-deep); }

    .db-empty { padding: 60px 24px; text-align: center; }
    .db-empty i {
        width: 96px; height: 96px; margin: 0 auto 20px; border-radius: 50%;
        background: var(--db-teal-dim); color: var(--db-teal);
        display: flex; align-items: center; justify-content: center; font-size: 42px;
    }
    .db-empty h3 { font-family: 'Poppins', sans-serif; font-weight: 700; margin: 0 0 10px; }
    .db-empty p { color: var(--db-ink-soft); margin: 0 0 22px; line-height: 1.7; }

    .db-btn-solid {
        display: inline-flex; align-items: center; gap: 8px; text-decoration: none;
        background: var(--db-teal); color: #fff; border-radius: 999px; padding: 11px 22px;
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px; transition: .15s;
    }
    .db-btn-solid:hover { background: var(--db-teal-deep); color: #fff; }

    /* ============ FOOTER ============ */
    .db-footer { margin-top: 50px; text-align: center; }
    .db-footer hr { border: none; border-top: 1px solid var(--db-line); margin-bottom: 22px; }
    .db-footer-content {
        display: flex; justify-content: center; align-items: center; flex-wrap: wrap; gap: 12px;
        color: var(--db-ink-faint); font-size: 13px;
    }
    .db-footer-content i { color: var(--db-teal); }
    .db-footer-divider { color: var(--db-line-strong); }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 1100px) {
        .db-grid-4 { grid-template-columns: repeat(2, 1fr); }
        .db-filter-grid { grid-template-columns: 1fr 1fr; }
        .db-perf-strip { flex-wrap: wrap; gap: 16px; }
        .db-perf-div { display: none; }
    }

    @@media (max-width: 900px) {
        .db-banner { flex-direction: column; align-items: flex-start; gap: 24px; }
        .db-clock { width: 100%; border-left: none; border-top: 1px solid rgba(255,255,255,.28); padding-left: 0; padding-top: 18px; }
        .db-banner-left { flex-direction: column; text-align: center; width: 100%; }
        .db-flow { overflow-x: auto; }
    }

    @@media (max-width: 640px) {
        .db-wrap { padding: 20px 16px 50px; }
        .db-grid-4 { grid-template-columns: 1fr; }
        .db-filter-grid { grid-template-columns: 1fr; }
        .db-panel-head { flex-direction: column; align-items: flex-start; gap: 10px; }
        .db-flow-node { width: 100px; }
        .db-flow-label { font-size: 10.5px; }
    }
</style>

