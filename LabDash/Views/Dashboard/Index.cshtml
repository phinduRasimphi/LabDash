            border-radius: var(--adm-radius);
            padding: 32px 36px;
            margin-bottom: 22px;
            box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
            overflow: hidden;
        }

        .adm-banner-pattern {
            position: absolute;
            inset: 0;
