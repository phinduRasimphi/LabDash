    media (max-width: 640px) {
        .db-wrap { padding: 0; }
        .db-grid-4 { grid-template-columns: 1fr; }
        .db-flow-node { width: 100px; }
        .db-flow-label { font-size: 10.5px; }
    }
</style>

<div class="db-wrap">
    <!-- BANNER -->
    <div class="db-banner">
        <div class="db-banner-pattern"></div>
        <div class="db-banner-left">
            <div class="db-banner-icon">
                <span class="db-icon-ring"></span>
                <i class="fa-solid fa-stethoscope"></i>
            </div>
            <div class="db-banner-text">
                <h1>Welcome, <span>@User.Identity?.Name</span></h1>
                <p>Doctor Dashboard</p>
                <div class="db-pills">
                    <span class="db-pill"><i class="fa-solid fa-calendar-days"></i> Daily overview</span>
                    <span class="db-pill"><i class="fa-solid fa-hospital-user"></i> Patient management</span>
                </div>
            </div>
        </div>
        <div class="db-clock">
            <small>Today's date</small>
            <div id="currentDate"></div>
            <div id="currentTime"></div>
        </div>
    </div>

    <!-- WORKFLOW PIPELINE -->
    <div class="db-pulse">
        <div class="db-pulse-label">
            <i class="fa-solid fa-timeline"></i> Patient test pipeline
        </div>
        <div class="db-flow">
            <div class="db-flow-node">
                <div class="db-flow-circle n-teal"><i class="fa-solid fa-paper-plane"></i></div>
                <div class="db-flow-count">@(ViewBag.PendingRequests ?? 0)</div>
                <div class="db-flow-label">Submitted</div>
            </div>
            <div class="db-flow-line"><span class="db-flow-line-fill" style="width:40%"></span></div>
            <div class="db-flow-node">
                <div class="db-flow-circle n-blue"><i class="fa-solid fa-vial-circle-check"></i></div>
                <div class="db-flow-count">@(ViewBag.CompletedRequests ?? 0)</div>
                <div class="db-flow-label">Completed</div>
            </div>
            <div class="db-flow-line"><span class="db-flow-line-fill" style="width:70%"></span></div>
            <div class="db-flow-node">
                <div class="db-flow-circle n-green"><i class="fa-solid fa-circle-check"></i></div>
                <div class="db-flow-count">@(ViewBag.CompletedRequests ?? 0)</div>
                <div class="db-flow-label">Released</div>
            </div>
            <div class="db-flow-line"><span class="db-flow-line-fill" style="width:80%"></span></div>
            <div class="db-flow-node">
                <div class="db-flow-circle n-purple"><i class="fa-solid fa-file-medical"></i></div>
                <div class="db-flow-count">@(ViewBag.AbnormalResults ?? 0)</div>
                <div class="db-flow-label">Abnormal</div>
            </div>
        </div>
        <div class="db-pulse-chips">
            <span class="db-chip chip-stat"><i class="fa-solid fa-bolt"></i> @(ViewBag.PendingRequests ?? 0) pending</span>
            <span class="db-chip chip-overdue"><i class="fa-solid fa-triangle-exclamation"></i> @(ViewBag.AbnormalResults ?? 0) abnormal</span>
        </div>
    </div>

    <!-- ABNORMAL ALERTS CARD -->
    <div class="db-grid db-grid-4">
