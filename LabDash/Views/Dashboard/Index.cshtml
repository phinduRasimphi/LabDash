        <script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
        <script src="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.js"></script>
        <link href="https://cdn.jsdelivr.net/npm/fullcalendar@5.11.3/main.min.css" rel="stylesheet" />
        <script src="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/js/all.min.js"></script>

        <script>
            let patients = JSON.parse(localStorage.getItem('patients')) || [];
            let testRequests = JSON.parse(localStorage.getItem('testRequests')) || [];

            if (patients.length === 0) {
                patients = [
                    { id: 'P001', name: 'Thabo', surname: 'Nkosi', createdDate: new Date(Date.now() - 2 * 86400000).toISOString() },
                    { id: 'P002', name: 'Lerato', surname: 'Moloi', createdDate: new Date(Date.now() - 4 * 86400000).toISOString() },
                    { id: 'P003', name: 'Sipho', surname: 'Dlamini', createdDate: new Date(Date.now() - 6 * 86400000).toISOString() },
                    { id: 'P004', name: 'Nomsa', surname: 'Mbeki', createdDate: new Date(Date.now() - 1 * 86400000).toISOString() },
                    { id: 'P005', name: 'Jabu', surname: 'Khumalo', createdDate: new Date(Date.now() - 3 * 86400000).toISOString() }
                ];
                localStorage.setItem('patients', JSON.stringify(patients));
            }

            if (testRequests.length === 0) {
                testRequests = [
                    { id: 'REQ001', patientId: 'P001', patientName: 'Thabo Nkosi', requestDate: new Date().toISOString().split('T')[0], urgency: 'STAT', status: 'Completed' },
                    { id: 'REQ002', patientId: 'P002', patientName: 'Lerato Moloi', requestDate: new Date(Date.now() - 1 * 86400000).toISOString().split('T')[0], urgency: 'Urgent', status: 'In Progress' },
                    { id: 'REQ003', patientId: 'P003', patientName: 'Sipho Dlamini', requestDate: new Date(Date.now() + 2 * 86400000).toISOString().split('T')[0], urgency: 'Routine', status: 'Submitted' },
                    { id: 'REQ004', patientId: 'P004', patientName: 'Nomsa Mbeki', requestDate: new Date(Date.now() + 1 * 86400000).toISOString().split('T')[0], urgency: 'Routine', status: 'Completed' },
                    { id: 'REQ005', patientId: 'P005', patientName: 'Jabu Khumalo', requestDate: new Date(Date.now() - 2 * 86400000).toISOString().split('T')[0], urgency: 'STAT', status: 'In Progress' }
                ];
                localStorage.setItem('testRequests', JSON.stringify(testRequests));
            }

            function getStatusClass(status) {
                const map = { 'Completed': 'status-completed', 'In Progress': 'status-progress', 'Submitted': 'status-submitted', 'Released by doctor': 'status-released', 'Cancelled': 'status-cancelled' };
                return map[status] || 'status-submitted';
            }

            function getUrgencyClass(urgency) {
                const map = { 'STAT': 'urgency-stat', 'Urgent': 'urgency-urgent', 'Routine': 'urgency-routine' };
                return map[urgency] || 'urgency-routine';
            }

            function animateNumber(element, start, end, duration = 500) {
                let startTimestamp = null;
                const step = (timestamp) => {
                    if (!startTimestamp) startTimestamp = timestamp;
                    const progress = Math.min((timestamp - startTimestamp) / duration, 1);
                    element.innerText = Math.floor(progress * (end - start) + start);
                    if (progress < 1) window.requestAnimationFrame(step);
                };
                window.requestAnimationFrame(step);
            }

            animateNumber(document.getElementById('totalPatients'), 0, patients.length, 500);
            animateNumber(document.getElementById('totalRequests'), 0, testRequests.length, 500);
            animateNumber(document.getElementById('resultsReady'), 0, testRequests.filter(r => r.status === 'Completed').length, 500);
            animateNumber(document.getElementById('inProgress'), 0, testRequests.filter(r => r.status === 'In Progress').length, 500);

            // LINE CHART - ULTRA COMPACT
            function getLast7Days() {
                let days = [];
                for (let i = 6; i >= 0; i--) {
                    let d = new Date();
                    d.setDate(d.getDate() - i);
                    days.push(d.toISOString().split('T')[0]);
                }
                return days;
            }

            function getRegistrationCounts() {
                let last7Days = getLast7Days();
                return last7Days.map(day => patients.filter(p => p.createdDate?.split('T')[0] === day).length);
            }

            new Chart(document.getElementById('patientChart').getContext('2d'), {
                type: 'line',
                data: {
                    labels: getLast7Days().map(d => new Date(d).toLocaleDateString('en-GB', { weekday: 'short', day: 'numeric' })),
                    datasets: [{
                        label: 'New Patients',
                        data: getRegistrationCounts(),
                        borderColor: '#0d6b63',
                        backgroundColor: 'rgba(13, 107, 99, 0.05)',
                        borderWidth: 1,
                        pointBackgroundColor: '#0d6b63',
                        pointBorderColor: 'white',
                        pointBorderWidth: 0.5,
                        pointRadius: 1.5,
                        pointHoverRadius: 2.5,
                        tension: 0.3,
                        fill: true
                    }]
                },
                options: {
                    responsive: true,
                    maintainAspectRatio: true,
                    plugins: {
                        legend: { position: 'top', labels: { font: { size: 6 }, boxWidth: 8 } },
                        tooltip: { bodyFont: { size: 8 }, titleFont: { size: 8 } }
                    },
                    scales: {
                        y: { beginAtZero: true, ticks: { stepSize: 1, font: { size: 5 } }, grid: { lineWidth: 0.5 } },
                        x: { ticks: { font: { size: 5 } }, grid: { display: false } }
                    }
                }
            });

            // CALENDAR - ULTRA COMPACT
            const calendar = new FullCalendar.Calendar(document.getElementById('calendarContainer'), {
                initialView: 'dayGridMonth',
                headerToolbar: { left: 'prev,next', center: 'title', right: '' },
                events: testRequests.map(r => ({
                    title: r.patientName.split(' ')[0].substring(0, 3),
                    start: r.requestDate,
                    color: r.urgency === 'STAT' ? '#dc3545' : r.urgency === 'Urgent' ? '#f57c00' : '#0d6b63'
                })),
                eventClick: () => window.location.href = '@Url.Action("Track", "TestRequest")',
                height: 'auto',
                dayMaxEvents: 1,
                buttonText: { prev: '◀', next: '▶' }
            });
            calendar.render();

            // RECENT REQUESTS
            const recent = [...testRequests].reverse().slice(0, 5);
            const tbody = document.getElementById('recentRequests');
            if (recent.length === 0) {
                tbody.innerHTML = '<tr><td colspan="5" class="empty-state"><i class="fas fa-flask"></i>No test requests found</td></tr>';
            } else {
                tbody.innerHTML = recent.map(r => {
                    const patient = patients.find(p => p.id == r.patientId);
                    return `
                        <tr>
                            <td><strong>#${r.id}</strong></td>
                            <td>${patient ? `${patient.name} ${patient.surname}` : 'Unknown'}</td>
                            <td>${r.requestDate ? new Date(r.requestDate).toLocaleDateString('en-GB', { day: '2-digit', month: 'short' }) : 'N/A'}</td>
                            <td><span class="urgency-badge ${getUrgencyClass(r.urgency)}">${r.urgency || 'Routine'}</span></td>
                            <td><span class="status-badge ${getStatusClass(r.status)}"><i class="fas ${r.status === 'Completed' ? 'fa-check-circle' : r.status === 'In Progress' ? 'fa-spinner fa-pulse' : 'fa-clock'}"></i> ${r.status || 'Submitted'}</span></td>
                        </tr>
                    `;
                }).join('');
            }
        </script>
    }
    else if (User.IsInRole("Lab_Technician"))
   {
