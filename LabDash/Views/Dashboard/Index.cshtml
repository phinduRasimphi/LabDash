                   asp-action="Index"
                   class="card-box dashboard-card-link">

                    <h4>Nearing Deadline</h4>

                    <h1 style="color:orange;">
                        @ViewBag.NearingDeadline
                    </h1>

                    <p>Less than 30 minutes remaining</p>

                </a>

            </div>



            <!-- ===================== FILTERS ===================== -->

            <div class="records-box" style="padding:20px;margin-bottom:25px;">

                <h4 style="margin-bottom:20px;color:#0d766e;">
                    <i class="fa-solid fa-filter"></i>
                    Filter Test Queue
                </h4>

                <form asp-controller="Dashboard"
                      asp-action="Index"
                      method="get">

                    <div style="
                        display:grid;
                        grid-template-columns:repeat(auto-fit,minmax(220px,1fr));
                        gap:15px;">

                        <!-- Urgency -->

                        <select name="urgency" class="form-control">

                            <option value="">All Urgencies</option>

                            <option value="STAT">STAT</option>

                            <option value="Urgent">Urgent</option>

                            <option value="Routine">Routine</option>

                        </select>


                        <!-- Category -->

                        <input type="text"
                               name="category"
                               class="form-control"
                               placeholder="Category">


                        <!-- Due Time -->

                        <input type="datetime-local"
                               name="dueTime"
                               class="form-control">


                        <!-- Request Number -->

                        <input type="text"
                               name="requestNumber"
                               class="form-control"
                               placeholder="Request Number">


                        <button class="btn btn-success">

                            <i class="fa-solid fa-magnifying-glass"></i>

                            Apply Filters

                        </button>

                    </div>

                </form>

            </div>



            <!-- ===================== TEST QUEUE ===================== -->

            <div class="records-box">

                <div style="
                    padding:20px;
                    border-bottom:1px solid #eee;">

                    <h3 style="color:#0d766e;">

                        <i class="fa-solid fa-vials"></i>

                        Technician Test Queue

                    </h3>

                </div>

                <table>

                    <thead>

                        <tr>

                            <th>REQUEST</th>

                            <th>PATIENT</th>

                            <th>CATEGORY</th>

                            <th>URGENCY</th>

                            <th>EXPECTED COMPLETION</th>

                            <th>STATUS</th>

                            <th>ACTION</th>

                        </tr>

                    </thead>

                    @* <tbody> *@

                    <tbody>

                        @if (ViewBag.TestQueue != null)
                        {
                            foreach (var item in ViewBag.TestQueue)
                            {
                                var expected = item.StartDateTime == null
                                    ? (DateTime?)null
                                    : item.StartDateTime.Value.AddHours(item.TestType.TurnaroundTimeHours);

                                bool overdue = expected.HasValue &&
                                               DateTime.Now > expected.Value;

                                <tr>

                                    <td>TR-@item.RequestId</td>

                                    <td>@item.TestRequest.PatientId</td>

                                    <td>@item.TestType.Category</td>

                                    <td>
                                        @if (item.TestRequest.Urgency == "STAT")
                                        {
                                            <span class="badge bg-danger">STAT</span>
                                        }
                                        else
                                        {
                                            @item.TestRequest.Urgency
                                        }
                                    </td>

                                    <td>
                                        @(expected?.ToString("dd MMM yyyy HH:mm") ?? "-")
                                    </td>

                                    <td>
                                        @if (overdue)
                                        {
                                            <span class="badge bg-danger">OVERDUE</span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-success">@item.Status</span>
                                        }
                                    </td>

                                    <td>
                                        @if (item.Status == "In Progress")
                                        {
                                            <a asp-controller="CaptureResults"
                                               asp-action="Capture"
                                               asp-route-id="@item.TestRequestItemId"
                                               class="btn-view">
                                                Capture
                                            </a>
                                        }
                                        else if (item.Status == "Completed")
                                        {
                                            <a asp-controller="Verification"
                                               asp-action="Verify"
                                               asp-route-id="@item.TestRequestItemId"
                                               class="btn-edit">
                                                Verify
                                            </a>
                                        }
                                        else if (item.Status == "To Be Reviewed")
                                        {
                                            <a asp-controller="ToBeReviewed"
                                               asp-action="Review"
                                               asp-route-id="@item.TestRequestItemId"
                                               class="btn-delete">
                                                Review
                                            </a>
                                        }
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center text-muted">
                                    No tests found.
                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>
    }
    else if (User.IsInRole("Lab_Manager"))
    {
        
    }
    else
    {
        <h1>No User Role</h1>
    }
}
    }
    }