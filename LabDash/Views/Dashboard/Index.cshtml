            <!-- Recent Activity -->
            <div class="recent-section">
                <div class="recent-title">
                    <i class="fas fa-clock"></i> Recent Activity
                </div>
                <div class="table-container">
                    <table class="data-table">
                        <thead>
                            <tr>
                                <th>Request ID</th>
                                <th>Patient Name</th>
                                <th>Date</th>
                                <th>Urgency</th>
                                <th>Status</th>
                            </tr>
                        </thead>
                        <tbody id="recentRequests"></tbody>
                    </table>
                </div>
