    }
    .db-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: dbRingPulse 2.4s ease-out infinite;
    }
    keyframes dbRingPulse {
        0% { transform: scale(0.9); opacity: .8; }
        100% { transform: scale(1.35); opacity: 0; }
    }
    .db-banner-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 26px;
        margin: 0 0 4px;
        color: #fff;
        letter-spacing: -.01em;
    }
    .db-banner-text h1 span { color: #E9FFFB; }
    .db-banner-text p {
        margin: 0 0 14px;
        color: rgba(255,255,255,.85);
        font-size: 14.5px;
    }
    .db-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }
    .db-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
    }
    .db-clock {
        position: relative;
        z-index: 1;
        min-width: 230px;
        text-align: left;
        border-left: 1px solid rgba(255,255,255,.28);
        padding-left: 28px;
        flex-shrink: 0;
    }
    .db-clock small {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #DFF9F8;
        font-size: 11px;
    }
    #currentDate { margin-top: 6px; font-size: 14px; color: #fff; }
    #currentTime {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 26px;
        font-weight: 600;
        letter-spacing: .02em;
        color: #fff;
        margin-top: 2px;
    }

    /* ============ WORKFLOW PIPELINE ============ */
    .db-pulse {
        background: var(--db-raised);
        border-radius: var(--db-radius);
        box-shadow: var(--db-shadow);
        padding: 26px 30px;
        margin-bottom: 28px;
    }
    .db-pulse-label {
        font-family: 'Inter', sans-serif;
        font-weight: 700;
        font-size: 12.5px;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: var(--db-teal-deep);
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 22px;
    }
    .db-flow {
        display: flex;
        align-items: flex-start;
    }
    .db-flow-node {
        display: flex;
        flex-direction: column;
        align-items: center;
        flex: 0 0 auto;
        width: 130px;
    }
    .db-flow-circle {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 18px;
        color: #fff;
        margin-bottom: 10px;
        box-shadow: 0 4px 10px rgba(0,0,0,.12);
    }
    .db-flow-circle.n-teal { background: var(--db-teal); }
    .db-flow-circle.n-blue { background: var(--db-blue); }
    .db-flow-circle.n-green { background: var(--db-green); }
    .db-flow-circle.n-purple { background: var(--db-purple); }
    .db-flow-count {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 20px;
        color: var(--db-ink);
    }
    .db-flow-label {
        font-size: 12px;
        color: var(--db-ink-soft);
        text-align: center;
        margin-top: 2px;
    }
    .db-flow-line {
        flex: 1 1 auto;
        height: 3px;
        background: var(--db-line);
        border-radius: 3px;
        margin-top: 24px;
        position: relative;
        overflow: hidden;
    }
    .db-flow-line-fill {
        position: absolute;
        left: 0;
        top: 0;
        height: 100%;
        background: var(--db-teal);
        border-radius: 3px;
    }
    .db-pulse-chips {
        display: flex;
        gap: 10px;
        margin-top: 24px;
        flex-wrap: wrap;
    }
    .db-chip {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 12.5px;
        padding: 8px 16px;
        border-radius: 999px;
    }
    .db-chip.chip-stat { background: var(--db-red-dim); color: var(--db-red); }
    .db-chip.chip-overdue { background: var(--db-orange-dim); color: var(--db-orange); }

    /* ============ SECTION HEADS ============ */
    .db-section-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 18px;
    }
    .db-section-head h3 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 20px;
        margin: 0 0 3px;
    }
    .db-section-head p {
        margin: 0;
        color: var(--db-ink-soft);
        font-size: 13.5px;
    }
    .db-mt-lg { margin-top: 44px; }

    /* ============ GRIDS ============ */
    .db-grid {
        display: grid;
        gap: 18px;
    }
    .db-grid-4 { grid-template-columns: repeat(4, 1fr); }
    .db-grid-mt { margin-top: 18px; }

    /* ============ STAT CARDS ============ */
    .db-stat {
        background: var(--db-raised);
        border-radius: var(--db-radius);
        box-shadow: var(--db-shadow-sm);
        padding: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        border-top: 3px solid var(--db-teal);
        transition: transform .2s, box-shadow .2s;
    }
    .db-stat:hover {
        transform: translateY(-5px);
        box-shadow: var(--db-shadow);
    }
    .db-stat-urgent { border-top-color: var(--db-red); }
    .db-stat-icon {
        width: 54px;
        height: 54px;
        border-radius: 15px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }
    .db-stat-icon.c-teal { background: var(--db-teal-dim); color: var(--db-teal); }
    .db-stat-icon.c-blue { background: var(--db-blue-dim); color: var(--db-blue); }
    .db-stat-icon.c-green { background: var(--db-green-dim); color: var(--db-green); }
    .db-stat-icon.c-purple { background: var(--db-purple-dim); color: var(--db-purple); }
    .db-stat-icon.c-red { background: var(--db-red-dim); color: var(--db-red); }
    .db-stat-icon.c-orange { background: var(--db-orange-dim); color: var(--db-orange); }
    .db-stat-icon.c-gold { background: var(--db-gold-dim); color: var(--db-gold); }
    .db-stat .num {
        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        font-weight: 700;
        color: var(--db-ink);
    }
    .db-stat h5 {
        margin: 2px 0 0;
        font-size: 13.5px;
        font-weight: 600;
    }
    .db-stat small {
        color: var(--db-ink-faint);
        font-size: 12px;
    }

    /* ============ QUICK ACTION CARDS ============ */
    .db-action {
        display: block;
        text-decoration: none;
        color: var(--db-ink);
        background: var(--db-raised);
        border-radius: var(--db-radius);
        padding: 28px 24px;
        text-align: left;
        box-shadow: var(--db-shadow-sm);
        position: relative;
        overflow: hidden;
        transition: transform .25s, box-shadow .25s;
    }
    .db-action::before {
        content: "";
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 4px;
        background: linear-gradient(90deg, var(--db-teal), var(--db-teal-deep));
    }
    .db-action:hover {
        transform: translateY(-6px);
        box-shadow: var(--db-shadow);
        color: var(--db-ink);
        text-decoration: none;
    }
    .db-action:hover .db-action-go {
        transform: translateX(4px);
        opacity: 1;
    }
    .db-action-icon {
        width: 54px;
        height: 54px;
        margin-bottom: 16px;
        border-radius: 16px;
        background: var(--db-teal-dim);
        color: var(--db-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }
    .db-action h5 {
        font-weight: 700;
        margin: 0 0 8px;
        font-size: 15px;
    }
    .db-action p {
        color: var(--db-ink-soft);
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
    }
    .db-action-go {
        display: inline-flex;
        margin-top: 14px;
        color: var(--db-teal);
        opacity: .5;
        transition: transform .2s, opacity .2s;
        font-size: 13px;
    }

    /* ============ FOOTER ============ */
    .db-footer {
        margin-top: 50px;
        text-align: center;
    }
    .db-footer hr {
        border: none;
        border-top: 1px solid var(--db-line);
