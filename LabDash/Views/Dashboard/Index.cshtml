        color: var(--red);
        background: var(--red-light);
    }

    .c-orange {
        color: var(--orange);
        background: var(--orange-light);
    }

    .c-gold {
        color: var(--gold);
        background: var(--gold-light);
    }

    .db-stat-body {
        min-width: 0;
    }

    .db-stat-body .num {
        color: var(--teal-deep);

        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        line-height: 1;

        font-weight: 800;
    }

    .db-stat-body h5 {
        margin: 6px 0 2px;

        color: var(--text);

        font-size: 13px;
        font-weight: 700;
    }

    .db-stat-body small {
        display: block;

        color: var(--muted);

        font-size: 10px;
        line-height: 1.45;
    }


    /* =========================================================
       QUICK ACTIONS
       ========================================================= */

    .db-action {
        position: relative;

        min-height: 165px;

        padding: 22px;

        text-decoration: none;

        border-radius: var(--radius);

        background: var(--white);
        border: 1px solid var(--teal-border);

        box-shadow: var(--shadow-sm);

        transition:
            transform .2s ease,
            box-shadow .2s ease,
            border-color .2s ease;
    }

    .db-action:hover {
        transform: translateY(-4px);

        border-color: var(--teal);

        box-shadow: var(--shadow);

        text-decoration: none;
    }

    .db-action-icon {
        width: 45px;
        height: 45px;

        display: flex;
        align-items: center;
        justify-content: center;

        margin-bottom: 13px;

        border-radius: 13px;

        color: var(--teal);
        background: var(--teal-light);

        font-size: 17px;
    }

    .db-action h5 {
        margin: 0 0 5px;

        color: var(--teal-deep);

        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    .db-action p {
        max-width: 230px;

        margin: 0;

        color: var(--muted);

        font-size: 11px;
        line-height: 1.55;
    }

    .db-action-go {
        position: absolute;

        right: 18px;
        bottom: 18px;

        width: 28px;
        height: 28px;

        display: flex;
        align-items: center;
        justify-content: center;

        border-radius: 50%;

        color: var(--teal);
        background: var(--teal-light);

        font-size: 11px;

        transition: all .2s ease;
    }

    .db-action:hover .db-action-go {
        color: white;
        background: var(--teal);
        transform: translateX(2px);
    }


    /* =========================================================
       PANEL
       ========================================================= */

    .db-panel {
        overflow: hidden;

        border-radius: var(--radius);

        background: var(--white);
        border: 1px solid var(--teal-border);

        box-shadow: var(--shadow-sm);
    }

    .db-mb-lg {
        margin-bottom: 20px;
    }

    .db-panel-head {
        min-height: 58px;

        display: flex;
        align-items: center;
        justify-content: space-between;

        padding: 14px 20px;

        background: var(--teal-soft);

        border-bottom: 1px solid var(--teal-border);

        color: var(--teal-deep);
    }

    .db-panel-head > div {
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

    .db-panel-head span {
        display: flex;
        align-items: center;
        gap: 8px;

        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

    .db-panel-head small {
        color: var(--muted);

        font-size: 10px;
        font-weight: 500;
    }

    .db-panel-tag {
        padding: 5px 10px;

        border-radius: 20px;

        color: var(--teal-deep);
        background: var(--white);
        border: 1px solid var(--teal-border);

        font-family: 'Inter', sans-serif !important;
        font-size: 10px !important;
    }

    .db-panel-count {
        color: var(--teal);
        font-size: 11px !important;
    }


    /* =========================================================
       FILTERS
       ========================================================= */

    .db-panel-body {
        padding: 20px;
    }

    .db-filter-grid {
        display: grid;

        grid-template-columns:
            1fr
            1fr
            1fr
            1.15fr
            auto;

        align-items: end;

        gap: 14px;
    }

    .db-field {
        min-width: 0;
    }

    .db-field label {
        display: block;

        margin-bottom: 7px;

        color: var(--text);

        font-size: 10px;
        font-weight: 700;
    }

    .db-select,
    .db-input {
        width: 100%;
        height: 42px;

        padding: 0 12px;

        outline: none;

        border-radius: 10px;

        color: var(--text);
        background: var(--white);

        border: 1px solid var(--teal-border);

        font-family: 'Inter', sans-serif;
        font-size: 11px;

        transition:
            border-color .2s ease,
            box-shadow .2s ease;
    }

    .db-select:focus,
    .db-input:focus {
        border-color: var(--teal);

        box-shadow:
            0 0 0 3px rgba(0,143,131,.10);
    }

    .db-input::placeholder {
        color: #9aabaa;
    }

    .db-field-btn {
        display: flex;
        gap: 7px;
    }

    .db-btn-apply,
    .db-btn-reset {
        height: 42px;

        padding: 0 15px;

        border-radius: 10px;

        font-family: 'Inter', sans-serif;

        font-size: 11px;
        font-weight: 700;

        cursor: pointer;

        transition: all .2s ease;
    }

    .db-btn-apply {
        color: white;
        background: var(--teal);
        border: 1px solid var(--teal);
    }

    .db-btn-apply:hover {
        background: var(--teal-dark);
        border-color: var(--teal-dark);

        transform: translateY(-1px);
    }

    .db-btn-reset {
        color: var(--teal-deep);
        background: var(--white);
        border: 1px solid var(--teal-border);
    }

    .db-btn-reset:hover {
        background: var(--teal-light);
        border-color: var(--teal);
    }


    /* =========================================================
       TABLE
       ========================================================= */

    .db-table-wrap {
        width: 100%;

        overflow-x: auto;
    }

    .db-table {
        width: 100%;

        border-collapse: collapse;

        font-size: 11px;
    }

    .db-table thead th {
        padding: 13px 14px;

        white-space: nowrap;

        text-align: left;

        color: var(--teal-deep);
        background: #f5fbfa;

        border-bottom: 1px solid var(--teal-border);

        font-family: 'Poppins', sans-serif;
        font-size: 10px;
        font-weight: 700;

        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .db-table tbody td {
        padding: 14px;

        color: var(--text);

        border-bottom: 1px solid #edf4f3;

        vertical-align: middle;
    }

    .db-table tbody tr {
        transition: background .15s ease;
    }

    .db-table tbody tr:hover {
        background: var(--teal-soft);
    }

    .db-table tbody tr:last-child td {
        border-bottom: none;
    }

    .db-table strong {
        font-weight: 700;
    }


    /* =========================================================
       REQUEST NUMBER
       ========================================================= */

    .db-request-number {
        display: inline-block;

        padding: 5px 8px;

        border-radius: 7px;

        color: var(--teal-deep);
        background: var(--teal-light);

        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        font-weight: 600;
    }


    /* =========================================================
       STATUS BADGES
       ========================================================= */

    .db-status-neutral,
    .db-status-info,
    .db-status-success,
    .db-status-warning,
    .db-status-danger {
        display: inline-flex;
        align-items: center;

        padding: 5px 9px;

        border-radius: 20px;

        white-space: nowrap;

        font-size: 9px;
        font-weight: 700;
    }

    .db-status-neutral {
        color: var(--teal-deep);
        background: var(--teal-light);
    }

    .db-status-info {
        color: #236b88;
        background: var(--blue-light);
    }

    .db-status-success {
        color: #146c43;
        background: var(--green-light);
    }

    .db-status-warning {
        color: #995c00;
        background: var(--gold-light);
    }

    .db-status-danger {
        color: #b42318;
        background: var(--red-light);
    }


    /* =========================================================
       DUE TIME
       ========================================================= */

    .db-due-overdue {
        display: inline-flex;

        padding: 5px 8px;

        border-radius: 7px;

        color: #b42318;
        background: var(--red-light);

        font-weight: 700;
        font-size: 9px;
    }

    .db-due-near {
        display: inline-flex;

        padding: 5px 8px;

        border-radius: 7px;

        color: #995c00;
        background: var(--gold-light);

        font-weight: 700;
        font-size: 9px;
    }


    /* =========================================================
       TABLE ACTION
       ========================================================= */

    .db-table-action {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;

        padding: 7px 11px;

        border-radius: 8px;

        color: white !important;
        background: var(--teal);

        text-decoration: none !important;

        font-size: 9px;
        font-weight: 700;

        white-space: nowrap;

        transition: all .2s ease;
    }

    .db-table-action:hover {
        color: white !important;
        background: var(--teal-dark);

        transform: translateY(-1px);
    }


    /* =========================================================
       EMPTY / LOADING
       ========================================================= */

    .db-empty {
        padding: 45px 20px;

        text-align: center;
    }

    .db-empty > i {
        margin-bottom: 12px;

        color: var(--teal);

        font-size: 27px;
    }

    .db-empty h3 {
        margin: 0 0 5px;

        color: var(--teal-deep);

        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    .db-empty p {
        max-width: 420px;

        margin: 0 auto;

        color: var(--muted);

        font-size: 11px;
    }

    .db-btn-solid {
        margin-top: 15px;

        padding: 9px 15px;

        border: none;
        border-radius: 9px;

        color: white;
        background: var(--teal);

        font-size: 11px;
        font-weight: 700;

        cursor: pointer;
    }

    .db-btn-solid:hover {
        background: var(--teal-dark);
    }


    /* =========================================================
       FOOTER
       ========================================================= */

    .db-footer {
        margin-top: 35px;
    }

    .db-footer hr {
        margin: 0 0 15px;

        border: none;
        border-top: 1px solid var(--teal-border);
    }

    .db-footer-content {
        display: flex;
        align-items: center;
        justify-content: center;
        flex-wrap: wrap;

        gap: 9px;

        color: var(--muted);

        font-size: 10px;
    }

    .db-footer-content i {
        color: var(--teal);
    }

    .db-footer-divider {
        color: var(--teal-border);
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1200px) {

        .db-grid-4 {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .db-filter-grid {
            grid-template-columns:
                repeat(2, minmax(0, 1fr));
        }

        .db-field-btn {
            align-items: center;
        }
    }


    @@media (max-width: 850px) {

        .db-wrap {
            padding: 20px 18px 40px;
        }

        .db-banner {
            align-items: flex-start;
            flex-direction: column;
            gap: 20px;

            padding: 25px;
        }

        .db-clock {
            width: 100%;

            text-align: left;
        }

        .db-flow {
            overflow-x: auto;
            justify-content: flex-start;

            padding-bottom: 8px;
        }

        .db-flow-node {
            min-width: 125px;
        }

        .db-flow-line {
            min-width: 55px;
        }
    }


    @@media (max-width: 650px) {

        .db-grid-4 {
            grid-template-columns: 1fr;
        }

        .db-filter-grid {
            grid-template-columns: 1fr;
        }

        .db-banner-left {
            align-items: flex-start;
            flex-direction: column;
        }

        .db-banner-text h1 {
            font-size: 22px;
        }

        .db-pulse {
            padding: 18px;
        }

        .db-section-head {
            align-items: flex-start;
            flex-direction: column;
            gap: 5px;
        }

        .db-table {
            min-width: 950px;
        }

        .db-field-btn {
            width: 100%;
        }

        .db-btn-apply,
        .db-btn-reset {
            flex: 1;
        }
    }
</style>

    }
}

    
    else if (User.IsInRole("Lab_Manager"))
{
    <style>

        /* ================================
           LAB MANAGER DASHBOARD
           ================================ */

        .manager-dashboard {
            background: #f0fdfa;
            min-height: 100vh;
            padding: 25px;
            width: 100%;
            box-sizing: border-box;
            overflow-x: hidden;
        }

        /* HEADER */

        .manager-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .manager-header h1 {
            margin: 0;
            color: #134e4a;
            font-size: 28px;
            font-weight: 700;
        }

        .manager-header p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 14px;
        }

        .manager-date {
            background: white;
            padding: 12px 18px;
            border-radius: 10px;
            color: #475569;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        .manager-date i {
            color: #0f766e;
            margin-right: 6px;
        }

        /* STATISTICS */

        .manager-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .manager-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #ccfbf1;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .manager-card h3 {
            margin: 0;
            font-size: 28px;
            color: #134e4a;
        }

        .manager-card p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 13px;
        }

        .manager-card i {
            float: right;
            font-size: 25px;
            color: #0f766e;
        }

        /* CONTENT */

        .manager-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .manager-panel {
            background: white;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #ccfbf1;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            min-width: 0;
        }

        .manager-panel h2 {
            margin: 0 0 18px;
            font-size: 17px;
            color: #134e4a;
        }

        .manager-panel h2 i {
            color: #0f766e;
            margin-right: 7px;
        }

        /* TABLE */

        .manager-table {
            width: 100%;
            border-collapse: collapse;
        }

        .manager-table th {
            background: #f0fdfa;
            color: #475569;
            padding: 12px;
            text-align: left;
            font-size: 12px;
        }

        .manager-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 13px;
            color: #475569;
        }

        .manager-table td:first-child {
            font-weight: 600;
            color: #134e4a;
        }

        .stock-good {
            color: #15803d;
            font-weight: 700;
        }

        .stock-low {
            color: #dc2626;
            font-weight: 700;
        }

        .badge-good {
            background: #dcfce7;
            color: #15803d;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-low {
            background: #fee2e2;
            color: #dc2626;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        /* STOCK ALERTS */

        .stock-alert {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff7f7;
            padding: 13px;
            margin-bottom: 10px;
            border-left: 4px solid #dc2626;
            border-radius: 8px;
        }

        .stock-alert strong {
            display: block;
            color: #334155;
            font-size: 13px;
        }

        .stock-alert small {
            color: #94a3b8;
        }

        /* QUICK ACTIONS */

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .quick-action {
            text-decoration: none;
            text-align: center;
            background: white;
            border: 1px solid #ccfbf1;
            border-radius: 12px;
            padding: 20px;
            transition: 0.2s;
        }

        .quick-action:hover {
            border-color: #0f766e;
            transform: translateY(-2px);
        }

        .quick-action i {
            display: block;
            color: #0f766e;
            font-size: 24px;
            margin-bottom: 8px;
        }

        .quick-action span {
            color: #334155;
            font-size: 13px;
            font-weight: 600;
        }

        /* EMPTY */

        .empty-message {
            text-align: center;
            padding: 30px;
            color: #64748b;
        }

        .empty-message i {
            font-size: 35px;
            color: #0f766e;
            margin-bottom: 10px;
        }

        /* RESPONSIVE */

        @@media (max-width: 1000px) {

            .manager-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .manager-content {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 600px) {

            .manager-dashboard {
                padding: 15px;
            }

            .manager-header {
                display: block;
            }

            .manager-date {
                margin-top: 15px;
            }

            .manager-stats {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }
        }

    </style>


    <div class="manager-dashboard">

        <!-- HEADER -->

        <div class="manager-header">

            <div>

                <h1>
                    Laboratory Manager Dashboard
                </h1>

                <p>
                    Manage laboratory consumables and monitor stock levels.
                </p>

            </div>

            <div class="manager-date">

                <i class="fa-solid fa-calendar-days"></i>

                @DateTime.Now.ToString("dddd, dd MMMM yyyy")

            </div>

        </div>


        <!-- STATISTICS -->

        <div class="manager-stats">

            <div class="manager-card">

                <i class="fa-solid fa-boxes-stacked"></i>

                <h3>
                    @(ViewBag.TotalConsumables ?? 0)
                </h3>

                <p>
                    Total Consumables
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-cubes"></i>

                <h3>
                    @(ViewBag.TotalStock ?? 0)
                </h3>

                <p>
                    Stock on Hand
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-triangle-exclamation"></i>

                <h3>
                    @(ViewBag.LowStock ?? 0)
                </h3>

                <p>
                    Low Stock Items
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-truck"></i>

                <h3>
                    @(ViewBag.SupplierCount ?? 0)
                </h3>

                <p>
                    Suppliers
                </p>

            </div>

        </div>


        <!-- CONSUMABLES + ALERTS -->

        <div class="manager-content">


            <!-- CONSUMABLES -->

            <div class="manager-panel">

                <h2>

                    <i class="fa-solid fa-boxes-stacked"></i>

                    Consumable Stock

                </h2>


                @if (ViewBag.Consumables != null &&
                     ViewBag.Consumables.Count > 0)
                {

                    <div style="overflow-x:auto;">

                        <table class="manager-table">

                            <thead>

                                <tr>

                                    <th>Name</th>

                                    <th>Supplier</th>

                                    <th>Stock</th>

                                    <th>Reorder</th>

                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in ViewBag.Consumables)
                                {

                                    <tr>

                                        <td>
                                            @item.Name
                                        </td>

                                        <td>
                                            @(item.SupplierName ?? "Not specified")
                                        </td>

                                        <td class="@(item.StockLevel <= item.ReorderLevel
                                            ? "stock-low"
                                            : "stock-good")">

                                            @item.StockLevel

                                        </td>

                                        <td>
                                            @item.ReorderLevel
                                        </td>

                                        <td>

                                            @if (item.StockLevel <= item.ReorderLevel)
                                            {
                                                <span class="badge-low">
                                                    Low Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-good">
                                                    In Stock
                                                </span>
                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-message">

                        <i class="fa-solid fa-box-open"></i>

                        <p>
                            No consumables have been added yet.
                        </p>

                        <a asp-controller="Consumable"
                           asp-action="Create"
                           class="btn btn-success">

                            Add Consumable

                        </a>

                    </div>

                }

            </div>


            <!-- LOW STOCK -->

            <div class="manager-panel">

                <h2>

                    <i class="fa-solid fa-bell"></i>

                    Low Stock Alerts

                </h2>


                @if (ViewBag.LowStockItems != null &&
                     ViewBag.LowStockItems.Count > 0)
                {

                    @foreach (var item in ViewBag.LowStockItems)
                    {

                        <div class="stock-alert">

                            <div>

                                <strong>
                                    @item.Name
                                </strong>

                                <small>
                                    Stock: @item.StockLevel |
                                    Reorder: @item.ReorderLevel
                                </small>

                            </div>

                            <span class="badge-low">
                                Low
                            </span>

                        </div>

                    }

                }
                else
                {

                    <div class="empty-message">

                        <i class="fa-solid fa-circle-check"></i>

                        <p>
                            No low-stock items.
                        </p>

                    </div>

                }

            </div>

        </div>


        <!-- QUICK ACTIONS -->

