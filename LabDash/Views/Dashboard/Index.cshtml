        <script>
            (function() {
                /* ---------- Clock ---------- */
                function updatePatClock() {
                    var now = new Date();
                    document.getElementById("patCurrentDate").textContent = now.toLocaleDateString("en-ZA", {
                        weekday: "long", day: "numeric", month: "long", year: "numeric"
                    });
                    document.getElementById("patCurrentTime").textContent = now.toLocaleTimeString("en-ZA", {
                        hour: "2-digit", minute: "2-digit", second: "2-digit"
                    });
                }
                updatePatClock();
                setInterval(updatePatClock, 1000);

                /* ---------- Count-up animation for the stat numbers ---------- */
                var reduceMotion = window.matchMedia && window.matchMedia("(prefers-reduced-motion: reduce)").matches;

                function countUp(el, from, to) {
                    if (reduceMotion || from === to) { el.textContent = to; return; }
                    var start = performance.now(), dur = 700;
                    (function tick(now) {
                        var p = Math.min((now - start) / dur, 1);
                        el.textContent = Math.round(from + (to - from) * (1 - Math.pow(1 - p, 3)));
                        if (p < 1) requestAnimationFrame(tick);
                    })(start);
                }

                function statValues() {
                    var out = {};
                    document.querySelectorAll("#patStats [data-stat]").forEach(function(el) {
                        out[el.dataset.stat] = parseInt(el.textContent, 10) || 0;
                    });
                    return out;
                }

                // The real number is already in the HTML, so if JS fails the cards are still correct.
                document.querySelectorAll("#patStats [data-stat]").forEach(function(el) {
                    countUp(el, 0, parseInt(el.textContent, 10) || 0);
                });

                /* ---------- Live refresh: re-reads this page and swaps the data sections ---------- */
                var REFRESH_MS = 60000;
                var SWAP_IDS = ["patStats", "patAlerts", "patSplit", "patActions"];
                var btn = document.getElementById("patRefresh");
                var label = document.getElementById("patRefreshLabel");
                var busy = false;

                async function refresh() {
                    if (busy) return;
                    busy = true;
                    btn.classList.add("is-loading");
                    try {
                        var res = await fetch(window.location.href, {
                            credentials: "same-origin",
                            cache: "no-store",
                            headers: { "X-Requested-With": "XMLHttpRequest" }
                        });
                        if (!res.ok) throw new Error("HTTP " + res.status);

                        var doc = new DOMParser().parseFromString(await res.text(), "text/html");
                        if (!doc.getElementById("patStats")) throw new Error("Not the dashboard (session expired?)");

                        var before = statValues();
                        SWAP_IDS.forEach(function(id) {
                            var cur = document.getElementById(id), next = doc.getElementById(id);
                            if (cur && next) cur.innerHTML = next.innerHTML;
                        });
                        document.querySelectorAll("#patStats [data-stat]").forEach(function(el) {
                            var to = parseInt(el.textContent, 10) || 0;
                            countUp(el, before[el.dataset.stat] || 0, to);
                        });

                        label.textContent = "Updated " + new Date().toLocaleTimeString("en-ZA", {
                            hour: "2-digit", minute: "2-digit", second: "2-digit"
                        });
                    } catch (err) {
                        label.textContent = "Refresh failed — retry";
                    } finally {
                        busy = false;
                        btn.classList.remove("is-loading");
                    }
                }

                btn.addEventListener("click", refresh);
                setInterval(function() { if (!document.hidden) refresh(); }, REFRESH_MS);
                document.addEventListener("visibilitychange", function() { if (!document.hidden) refresh(); });

                /* ---------- Clickable table rows (works after refresh too) ---------- */
                document.addEventListener("click", function(e) {
                    var row = e.target.closest("tr[data-href]");
                    if (row && !e.target.closest("a")) window.location.href = row.dataset.href;
                });
                document.addEventListener("keydown", function(e) {
                    if (e.key !== "Enter") return;
                    var row = e.target.closest && e.target.closest("tr[data-href]");
                    if (row) window.location.href = row.dataset.href;
                });
            })();
        </script>

