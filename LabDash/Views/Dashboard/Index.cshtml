            --adm-teal-deep: #0A5850;
            --adm-teal-dim: #E3F4F1;
            --adm-teal-grad-start: #12A392;
            --adm-teal-grad-end: #0A4F48;
            --adm-blue: #2C6E9E;
            --adm-blue-dim: #E4F0F9;
            --adm-purple: #6D4EA8;
            --adm-purple-dim: #EEE8F9;
