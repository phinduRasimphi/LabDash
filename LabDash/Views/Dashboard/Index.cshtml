                    box-shadow: 0 2px 10px rgba(15,23,42,0.05);
                }


                /* =========================================
                       STAT CARDS
                       ========================================= */

                .dashboard-card {
                    background: white;
                    border-radius: 15px;
                    padding: 22px;
                    display: flex;
                    align-items: center;
                    gap: 17px;
                    min-height: 145px;
                    border: 1px solid #e2e8f0;
                    transition: all .25s ease;
                }

                    .dashboard-card:hover {
                        transform: translateY(-4px);
                        box-shadow: 0 12px 25px rgba(15,23,42,0.08);
                    }

                .card-icon {
                    width: 55px;
                    height: 55px;
                    min-width: 55px;
                    border-radius: 13px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 23px;
                }

                .category-icon {
                    background: #e0f2fe;
                    color: #0284c7;
                }

                .test-icon {
                    background: #dcfce7;
                    color: #16a34a;
                }

                .stock-icon {
                    background: #fef3c7;
                    color: #d97706;
                }

                .staff-icon {
                    background: #ede9fe;
                    color: #7c3aed;
                }

                .card-label {
                    display: block;
                    color: #64748b;
                    font-size: 13px;
                    font-weight: 500;
                }

                .card-information h2 {
                    margin: 3px 0;
                    font-size: 27px;
                    font-weight: 700;
                    color: #0f172a;
                }

                .card-description {
                    color: #94a3b8;
                    font-size: 11px;
                }


                /* =========================================
                       PANELS
                       ========================================= */

                .dashboard-panel {
                    height: 100%;
                    background: white;
                    border: 1px solid #e2e8f0;
                    border-radius: 15px;
                    padding: 22px;
                }

                .panel-header {
                    display: flex;
                    justify-content: space-between;
                    align-items: flex-start;
                    margin-bottom: 20px;
                }

                    .panel-header h4 {
                        margin: 0;
                        color: #0f172a;
                        font-size: 17px;
                        font-weight: 700;
                    }

                    .panel-header p {
                        margin: 4px 0 0;
                        color: #94a3b8;
                        font-size: 12px;
                    }

                    .panel-header > i {
                        color: #0f766e;
                        font-size: 20px;
                    }


                /* =========================================
                       OVERVIEW
                       ========================================= */

                .overview-grid {
                    display: grid;
                    grid-template-columns: 1fr 1fr;
                    gap: 12px;
                }

                .overview-item {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 13px;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    transition: .2s;
                }

                    .overview-item:hover {
                        background: #f8fafc;
                        border-color: #99f6e4;
                    }

                .overview-icon {
                    width: 38px;
                    height: 38px;
                    min-width: 38px;
                    border-radius: 9px;
                    background: #f0fdfa;
                    color: #0f766e;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                .overview-item strong {
                    display: block;
                    font-size: 12px;
                    color: #334155;
                }

                .overview-item span {
                    display: block;
                    color: #94a3b8;
                    font-size: 10px;
                    margin-top: 2px;
                }

                .overview-item a {
                    margin-left: auto;
                    color: #0f766e;
                    font-size: 11px;
                    font-weight: 600;
                    text-decoration: none;
                }


                /* =========================================
                       QUICK ACTIONS
                       ========================================= */

                .quick-actions {
                    display: flex;
                    flex-direction: column;
                    gap: 7px;
                }

                .quick-action {
                    display: flex;
                    align-items: center;
                    gap: 11px;
                    padding: 10px;
                    border-radius: 9px;
                    text-decoration: none;
                    transition: .2s;
                }

                    .quick-action:hover {
                        background: #f8fafc;
                    }

                    .quick-action > span {
                        width: 35px;
                        height: 35px;
                        min-width: 35px;
                        border-radius: 8px;
                        background: #f0fdfa;
                        color: #0f766e;
                        display: flex;
                        align-items: center;
                        justify-content: center;
                    }

                    .quick-action strong {
                        display: block;
                        font-size: 12px;
                        color: #334155;
                    }

                    .quick-action small {
                        color: #94a3b8;
                        font-size: 10px;
                    }

                    .quick-action .arrow {
                        margin-left: auto;
                        color: #cbd5e1;
                        font-size: 12px;
                    }


                /* =========================================
                       STAFF
                       ========================================= */

                .staff-management {
                    display: flex;
                    flex-direction: column;
                    gap: 9px;
                }

                .staff-card {
                    display: flex;
                    align-items: center;
                    gap: 12px;
                    padding: 11px;
                    border: 1px solid #e2e8f0;
                    border-radius: 10px;
                    text-decoration: none;
                    transition: .2s;
                }

                    .staff-card:hover {
                        background: #f8fafc;
                        transform: translateX(3px);
                    }

                .staff-card-icon {
                    width: 40px;
                    height: 40px;
                    min-width: 40px;
                    border-radius: 9px;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                }

                    .staff-card-icon.doctor {
                        background: #dbeafe;
                        color: #2563eb;
                    }

                    .staff-card-icon.technician {
                        background: #dcfce7;
                        color: #16a34a;
                    }

                    .staff-card-icon.assignment {
                        background: #fef3c7;
                        color: #d97706;
                    }

                .staff-card strong {
                    display: block;
                    color: #334155;
                    font-size: 12px;
                }

                .staff-card span {
                    display: block;
                    color: #94a3b8;
                    font-size: 10px;
                    margin-top: 2px;
                }

                .staff-card > i {
                    margin-left: auto;
                    color: #94a3b8;
                }


                /* =========================================
                       REPORT
                       ========================================= */

                .report-box {
                    display: flex;
                    gap: 15px;
                    padding: 16px;
                    background: #f8fafc;
                    border-radius: 12px;
                    margin-bottom: 15px;
                }

                .report-icon {
                    width: 48px;
                    height: 48px;
                    min-width: 48px;
                    border-radius: 11px;
                    background: #fee2e2;
                    color: #dc2626;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 21px;
                }

                .report-content h5 {
                    margin: 0 0 5px;
                    font-size: 14px;
                    color: #334155;
                }

                .report-content p {
                    margin: 0 0 12px;
                    color: #64748b;
                    font-size: 11px;
                    line-height: 1.5;
                }

                .btn-report {
                    display: inline-flex;
                    align-items: center;
                    gap: 7px;
                    background: #0f766e;
                    color: white;
                    padding: 8px 12px;
                    border-radius: 7px;
                    font-size: 11px;
                    font-weight: 600;
                    text-decoration: none;
                    transition: .2s;
                }

                    .btn-report:hover {
                        background: #115e59;
                        color: white;
                    }

                .report-info {
                    display: flex;
                    justify-content: space-between;
                    gap: 8px;
                }

                    .report-info div {
                        display: flex;
                        align-items: center;
                        gap: 5px;
                        color: #64748b;
                        font-size: 9px;
                    }

                    .report-info i {
                        color: #0f766e;
                    }


                /* =========================================
                       RESPONSIVE
                       ========================================= */

                @@media (max-width: 992px) {

                    .manager-sidebar {
                        width: 220px;
                    }

                    .manager-content {
                        margin-left: 220px;
                    }
                }


                @@media (max-width: 768px) {

                    .manager-sidebar {
                        width: 70px;
                    }

                    .sidebar-brand > div:not(.brand-icon),
                    .nav-title,
                    .nav-link span,
                    .sidebar-footer {
                        display: none;
                    }

                    .sidebar-brand {
                        justify-content: center;
                        padding: 15px;
                    }

                    .nav-link {
                        justify-content: center;
                    }

                        .nav-link i {
                            font-size: 18px;
                        }

                    .manager-content {
                        margin-left: 70px;
                    }

                    .dashboard-header {
                        display: block;
                    }

                    .dashboard-date {
                        margin-top: 15px;
                        display: inline-flex;
                    }

                    .overview-grid {
                        grid-template-columns: 1fr;
                    }
                }

            </style>

        }


        @section Scripts {

            <script>

                // Display current date
                const dateElement = document.getElementById("currentDate");

                if (dateElement) {

                    const today = new Date();

                    dateElement.textContent = today.toLocaleDateString(
                        'en-ZA',
                        {
                            weekday: 'long',
                            year: 'numeric',
                            month: 'long',
                            day: 'numeric'
                        }
                    );
                }

            </script>

        }
    }
    else
    {
        <h1>No User Role</h1>
    }
}
    
    