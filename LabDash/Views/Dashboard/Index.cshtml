    @section Scripts {

        <script>

            // =====================================================
            // CLOCK
            // =====================================================

            function updateClock() {

                const now = new Date();

                document.getElementById("currentDate").innerHTML =
                    now.toLocaleDateString("en-ZA", {
                        weekday: "long",
                        day: "numeric",
                        month: "long",
                        year: "numeric"
                    });

                document.getElementById("currentTime").innerHTML =
                    now.toLocaleTimeString("en-ZA", {
                        hour: "2-digit",
                        minute: "2-digit",
                        second: "2-digit"
                    });
            }

            updateClock();

            setInterval(updateClock, 1000);


            // =====================================================
            // LOAD REAL DASHBOARD DATA
            // =====================================================

            async function loadDashboardSummary() {

                try {

                    const response =
                        await fetch(
                            '@Url.Action("DashboardSummary", "AvailableTests")'
                        );

                    if (!response.ok) {

                        throw new Error(
                            "DashboardSummary request failed."
                        );
                    }

                    const data =
                        await response.json();


                    // =============================================
                    // UPDATE COUNTERS
                    // =============================================

                    setValue(
                        "availableCount",
                        data.available
                    );

                    setValue(
                        "inProgressCount",
                        data.inProgress
                    );

                    setValue(
                        "completedCount",
                        data.completed
                    );

                    setValue(
                        "verifiedCount",
                        data.verified
                    );

                    setValue(
                        "reviewCount",
                        data.toBeReviewed
                    );

                    setValue(
                        "urgentCount",
                        data.urgent
                    );


                    // =============================================
                    // PIPELINE
                    // =============================================

                    setValue(
                        "flowAvailable",
                        data.available
                    );

                    setValue(
                        "flowInProgress",
                        data.inProgress
                    );

                    setValue(
                        "flowVerified",
                        data.verified
                    );

                    setValue(
                        "flowReview",
                        data.toBeReviewed
                    );


                    // =============================================
                    // CHIPS
                    // =============================================

                    document.getElementById("urgentChip")
                        .textContent =
                        data.urgent + " STAT tests";


                    // Your current controller does not return
                    // overdue yet, so don't pretend that it does.

                    document.getElementById("overdueChip")
                        .textContent =
                        "0 overdue tests";


                    document.getElementById("overdueCount")
                        .textContent = "0";


                    // =============================================
                    // QUEUE COUNT
                    // =============================================

                    const total =
                        Number(data.inProgress) +
                        Number(data.available);

                    document.getElementById("queueCount")
                        .textContent =
                        total + " tests";

                }
                catch (error) {

                    console.error(
                        "Dashboard loading error:",
                        error
                    );

                    showDashboardError();
                }
            }


            // =====================================================
            // SET VALUE
            // =====================================================

            function setValue(id, value) {

                const element =
                    document.getElementById(id);

                if (!element)
                    return;

                element.textContent =
                    value ?? 0;
            }


            // =====================================================
            // ERROR
            // =====================================================

            function showDashboardError() {

                document.getElementById("queueBody").innerHTML = `

                    <tr>

                        <td colspan="7">

                            <div class="db-empty">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                                <h3>
                                    Dashboard data could not be loaded
                                </h3>

                                <p>
                                    The dashboard could not retrieve the
                                    laboratory workload.
                                    Please refresh the page.
                                </p>

                                <button
                                    type="button"
                                    class="db-btn-solid"
                                    onclick="loadDashboardSummary()">

                                    <i class="fa-solid fa-rotate-right"></i>
                                    Try again

                                </button>

                            </div>

                        </td>

                    </tr>

                `;
            }


            // =====================================================
            // START DASHBOARD
            // =====================================================

            document.addEventListener(
                "DOMContentLoaded",
                function () {

                    loadDashboardSummary();

                }
            );

        </script>

    }


