        .adm-status-warn .adm-status-dot { background: var(--adm-orange); box-shadow: 0 0 0 4px var(--adm-orange-dim); }
        .adm-status-list { margin: 10px 0 0 22px; padding: 0; color: var(--adm-ink-soft); font-size: 13px; line-height: 1.7; }

        /* ============ SECTION HEADS ============ */
