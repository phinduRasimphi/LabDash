    }
    .db-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--db-ink-faint);
        font-size: 13px;
    }
    .db-footer-content i { color: var(--db-teal); }
    .db-footer-divider { color: var(--db-line-strong); }

    /* ============ RESPONSIVE ============ */
    media (max-width: 1100px) {
        .db-grid-4 { grid-template-columns: repeat(2, 1fr); }
