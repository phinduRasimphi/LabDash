@using LabDash.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@model LabDash.Models.AdminDashboardViewModel
@inject SignInManager<LabUser> SignInManager
@inject UserManager<LabUser> UserManager
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}



@if (SignInManager.IsSignedIn(User))
{
    if (User.IsInRole("Admin"))
{
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/Chart.js/4.4.4/chart.umd.min.js"></script>

    <div class="adm-wrap">

        <!-- ==========================================
            HEADER
        =========================================== -->
        <div class="adm-banner">
            <div class="adm-banner-pattern"></div>

            <div class="adm-banner-left">
                <div class="adm-banner-icon">
                    <span class="adm-icon-ring"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="adm-banner-text">
                    <h1>Welcome, <span>@User.Identity?.Name</span></h1>
                    <p>NMB-HLabSys Admin Control Center</p>
                    <div class="adm-pills">
                        <span class="adm-pill"><i class="fa-solid fa-database"></i> Reference data governance</span>
                        <span class="adm-pill"><i class="fa-solid fa-gears"></i> System configuration</span>
                    </div>
                </div>
            </div>

            <div class="adm-clock">
                <small>Today's date</small>
                <div id="adminCurrentDate"></div>
                <div id="adminCurrentTime"></div>
            </div>
        </div>

        <!-- ==========================================
            SYSTEM STATUS STRIP
        =========================================== -->
        <div class="adm-status-strip">
            <div class="adm-status-left">
                <span class="adm-status-dot"></span>
                <span><strong>All systems operational</strong> &middot; core reference databases secure, 0 warnings flagged</span>
            </div>
            <a class="adm-status-link" href="@Url.Action("SystemTables", "Admin")">
                Verify tables <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- ==========================================
            REFERENCE DATA OVERVIEW
        =========================================== -->
        <div class="adm-section-head">
            <div>
                <h3>Reference data overview</h3>
                <p>Live counts of the medical reference records your system depends on.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-4">

            <div class="adm-stat">
                <div class="adm-stat-icon c-teal"><i class="fa-solid fa-heart-pulse"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.ConditionCount</div>
                    <h5>Conditions</h5>
                    <small>Active classifications</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-purple"><i class="fa-solid fa-allergies"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.AllergyCount</div>
                    <h5>Allergies</h5>
                    <small>Tracked intolerances</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-blue"><i class="fa-solid fa-pills"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.MedicationCount</div>
                    <h5>Medications</h5>
                    <small>Verified formulary</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-gold"><i class="fa-solid fa-layer-group"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@(Model.ConditionCount + Model.AllergyCount + Model.MedicationCount)</div>
                    <h5>Total records</h5>
                    <small>Across all reference tables</small>
                </div>
            </div>

        </div>

        <!-- ==========================================
            QUICK ACTIONS
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Quick actions</h3>
                <p>Manage the reference data that powers the rest of the system.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-3">

            <a href="@Url.Action("Conditions", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-heart-pulse"></i></div>
                <h5>Manage conditions</h5>
                <p>Add, edit, or retire medical condition classifications used across patient records.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <!-- Not wired to a controller yet — shown as a disabled preview card -->
            <div class="adm-action adm-action-disabled" aria-disabled="true">
                <span class="adm-soon-badge">Coming soon</span>
                <div class="adm-action-icon"><i class="fa-solid fa-allergies"></i></div>
                <h5>Manage allergies</h5>
                <p>Add, edit, or retire allergy reference records used across patient records.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </div>

            <div class="adm-action adm-action-disabled" aria-disabled="true">
                <span class="adm-soon-badge">Coming soon</span>
                <div class="adm-action-icon"><i class="fa-solid fa-pills"></i></div>
                <h5>Manage medications</h5>
                <p>Add, edit, or retire medications available in the patient medical history.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </div>

            <div class="adm-action adm-action-disabled" aria-disabled="true">
                <span class="adm-soon-badge">Coming soon</span>
                <div class="adm-action-icon"><i class="fa-solid fa-tags"></i></div>
                <h5>Manage categories</h5>
                <p>Maintain the category lists used to group conditions, allergies, and medications.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </div>

            <a href="@Url.Action("SystemTables", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-database"></i></div>
                <h5>System tables</h5>
                <p>Inspect and verify the integrity of the underlying reference tables.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <div class="adm-action adm-action-disabled" aria-disabled="true">
                <span class="adm-soon-badge">Coming soon</span>
                <div class="adm-action-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <h5>Data quality checks</h5>
                <p>Find duplicate names, uncategorized items, and empty categories automatically.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </div>

        </div>

        <!-- ==========================================
            BREAKDOWN + RECENT DATA
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Reference data insights</h3>
                <p>How your reference records are distributed, and what's changed recently.</p>
            </div>
        </div>

        <div class="adm-split">

            <!-- Recently added / changed reference data — honest empty state until wired to real data -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-clock-rotate-left"></i> Recent reference data changes</span>
                    <span class="adm-panel-tag">Reference data</span>
                </div>
                <div class="adm-empty-state">
                    <div class="adm-empty-icon"><i class="fa-regular fa-folder-open"></i></div>
                    <h5>Nothing to show yet</h5>
                    <p>Once conditions, allergies, and medications are being managed, the most recently
                       added or edited records will appear here automatically.</p>
                </div>
            </div>

            <!-- Real breakdown chart built from Model counts you already have -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-chart-pie"></i> Reference data breakdown</span>
                </div>
                <div class="adm-chart-body">
                    <canvas id="adminBreakdownChart"></canvas>
                    <div class="adm-chart-legend">
                        <div class="adm-legend-row">
                            <span class="adm-legend-dot" style="background:var(--adm-teal)"></span>
                            <span>Conditions</span>
                            <strong>@Model.ConditionCount</strong>
                        </div>
                        <div class="adm-legend-row">
                            <span class="adm-legend-dot" style="background:var(--adm-purple)"></span>
                            <span>Allergies</span>
                            <strong>@Model.AllergyCount</strong>
                        </div>
                        <div class="adm-legend-row">
                            <span class="adm-legend-dot" style="background:var(--adm-blue)"></span>
                            <span>Medications</span>
                            <strong>@Model.MedicationCount</strong>
                        </div>
                    </div>
                </div>
            </div>

        </div>

        <!-- ==========================================
            FOOTER
        =========================================== -->
        <div class="adm-footer">
            <hr />
            <div class="adm-footer-content">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Laboratory Information Management System</span>
                <span class="adm-footer-divider">|</span>
                <span>Admin Control Center</span>
                <span class="adm-footer-divider">|</span>
                <span>@DateTime.Now.Year</span>
            </div>
        </div>

    </div>

    <script>
        function updateAdminClock() {
            const now = new Date();
            document.getElementById("adminCurrentDate").innerHTML = now.toLocaleDateString("en-ZA", {
                weekday: "long", day: "numeric", month: "long", year: "numeric"
            });
            document.getElementById("adminCurrentTime").innerHTML = now.toLocaleTimeString("en-ZA", {
                hour: "2-digit", minute: "2-digit", second: "2-digit"
            });
        }
        updateAdminClock();
        setInterval(updateAdminClock, 1000);

        // Reference data breakdown chart — driven entirely by the counts already
        // passed to the view via Model, no extra controller/endpoint required.
        (function () {
            const ctx = document.getElementById('adminBreakdownChart');
            if (!ctx) return;

            const conditionCount = @Model.ConditionCount;
            const allergyCount = @Model.AllergyCount;
            const medicationCount = @Model.MedicationCount;
            const total = conditionCount + allergyCount + medicationCount;

            new Chart(ctx, {
                type: 'doughnut',
                data: {
                    labels: ['Conditions', 'Allergies', 'Medications'],
                    datasets: [{
                        data: [conditionCount, allergyCount, medicationCount],
                        backgroundColor: ['#0E8C7F', '#6D4EA8', '#2C6E9E'],
                        borderColor: '#FFFFFF',
                        borderWidth: 3,
                        hoverOffset: 6
                    }]
                },
                options: {
                    cutout: '68%',
                    plugins: {
                        legend: { display: false },
                        tooltip: {
                            callbacks: {
                                label: function (item) {
                                    const value = item.raw;
                                    const pct = total > 0 ? Math.round((value / total) * 100) : 0;
                                    return `${item.label}: ${value} (${pct}%)`;
                                }
                            }
                        }
                    }
                }
            });
        })();
    </script>

    <style>
        :root {
            --adm-paper: #F0F7F6;
            --adm-raised: #FFFFFF;
            --adm-ink: #102C27;
            --adm-ink-soft: #52716C;
            --adm-ink-faint: #8FA9A3;
            --adm-line: #E1EEEC;
            --adm-line-strong: #CCE3DF;
            --adm-teal: #0E8C7F;
            --adm-teal-deep: #0A5850;
            --adm-teal-dim: #E3F4F1;
            --adm-teal-grad-start: #12A392;
            --adm-teal-grad-end: #0A4F48;
            --adm-blue: #2C6E9E;
            --adm-blue-dim: #E4F0F9;
            --adm-purple: #6D4EA8;
            --adm-purple-dim: #EEE8F9;
            --adm-red: #B0463F;
            --adm-red-dim: #F7E8E7;
            --adm-orange: #B76A2C;
            --adm-orange-dim: #FBEEE1;
            --adm-gold: #B4862A;
            --adm-gold-dim: #FBF1DA;
            --adm-radius: 20px;
            --adm-radius-sm: 13px;
            --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
            --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
        }

        .adm-wrap {
            max-width: 1280px;
            margin: 0 auto;
            padding: 26px 24px 60px;
            color: var(--adm-ink);
            font-family: 'Inter', sans-serif;
            animation: admFadeIn .5s ease;
        }

        @@keyframes admFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ============ BANNER ============ */
        .adm-banner {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
            border-radius: var(--adm-radius);
            padding: 32px 36px;
            margin-bottom: 22px;
            box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
            overflow: hidden;
        }

        .adm-banner-pattern {
            position: absolute;
            inset: 0;
            background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
            pointer-events: none;
        }

        .adm-banner-left {
            display: flex;
            align-items: center;
            gap: 22px;
            position: relative;
            z-index: 1;
        }

        .adm-banner-icon {
            position: relative;
            width: 76px;
            height: 76px;
            border-radius: 50%;
            background: rgba(255,255,255,.16);
            border: 2px solid rgba(255,255,255,.32);
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-size: 30px;
            flex-shrink: 0;
        }

        .adm-icon-ring {
            position: absolute;
            inset: -6px;
            border-radius: 50%;
            border: 1.5px solid rgba(255,255,255,.4);
            animation: admRingPulse 2.4s ease-out infinite;
        }

        @@keyframes admRingPulse {
            0% { transform: scale(0.9); opacity: .8; }
            100% { transform: scale(1.35); opacity: 0; }
        }

        .adm-banner-text { position: relative; z-index: 1; }

        .adm-banner-text h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin: 0 0 4px;
            color: #fff;
            letter-spacing: -.01em;
        }

        .adm-banner-text h1 span { color: #E9FFFB; }

        .adm-banner-text p {
            margin: 0 0 14px;
            color: rgba(255,255,255,.85);
            font-size: 14.5px;
        }

        .adm-pills { display: flex; gap: 10px; flex-wrap: wrap; }

        .adm-pill {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 7px 15px;
            border-radius: 999px;
            background: rgba(255,255,255,.16);
            color: #fff;
            font-size: 12.5px;
            font-weight: 500;
        }

        .adm-clock {
            position: relative;
            z-index: 1;
            min-width: 230px;
            text-align: left;
            border-left: 1px solid rgba(255,255,255,.28);
            padding-left: 28px;
            flex-shrink: 0;
        }

        .adm-clock small {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: #DFF9F8;
            font-size: 11px;
        }

        #adminCurrentDate { margin-top: 6px; font-size: 14px; color: #fff; }

        #adminCurrentTime {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 26px;
            font-weight: 600;
            letter-spacing: .02em;
            color: #fff;
            margin-top: 2px;
        }

        /* ============ STATUS STRIP ============ */
        .adm-status-strip {
            background: var(--adm-raised);
            border-radius: var(--adm-radius);
            box-shadow: var(--adm-shadow-sm);
            padding: 16px 24px;
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 28px;
            border-left: 4px solid var(--adm-teal);
        }

        .adm-status-left {
            display: flex;
            align-items: center;
            gap: 12px;
            font-size: 14px;
            color: var(--adm-ink);
        }

        .adm-status-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            background: var(--adm-teal);
            flex-shrink: 0;
            box-shadow: 0 0 0 4px var(--adm-teal-dim);
        }

        .adm-status-link {
            color: var(--adm-teal-deep);
            font-weight: 600;
            font-size: 13.5px;
            text-decoration: none;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .adm-status-link:hover { text-decoration: underline; }

        /* ============ SECTION HEADS ============ */
        .adm-section-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 18px;
        }

        .adm-section-head h3 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 20px;
            margin: 0 0 3px;
        }

        .adm-section-head p {
            margin: 0;
            color: var(--adm-ink-soft);
            font-size: 13.5px;
        }

        .adm-mt-lg { margin-top: 44px; }

        /* ============ GRIDS ============ */
        .adm-grid { display: grid; gap: 18px; }
        .adm-grid-4 { grid-template-columns: repeat(4, 1fr); }
        .adm-grid-3 { grid-template-columns: repeat(3, 1fr); }
        .adm-grid-2 { grid-template-columns: repeat(2, 1fr); }

        /* ============ STAT CARDS ============ */
        .adm-stat {
            background: var(--adm-raised);
            border-radius: var(--adm-radius);
            box-shadow: var(--adm-shadow-sm);
            padding: 22px;
            display: flex;
            align-items: center;
            gap: 16px;
            border-top: 3px solid var(--adm-teal);
            transition: transform .2s, box-shadow .2s;
        }

        .adm-stat:hover { transform: translateY(-5px); box-shadow: var(--adm-shadow); }

        .adm-stat-icon {
            width: 54px;
            height: 54px;
            border-radius: 15px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 21px;
        }

        .adm-stat-icon.c-teal { background: var(--adm-teal-dim); color: var(--adm-teal); }
        .adm-stat-icon.c-blue { background: var(--adm-blue-dim); color: var(--adm-blue); }
        .adm-stat-icon.c-purple { background: var(--adm-purple-dim); color: var(--adm-purple); }
        .adm-stat-icon.c-gold { background: var(--adm-gold-dim); color: var(--adm-gold); }

        .adm-stat .num {
            font-family: 'Poppins', sans-serif;
            font-size: 27px;
            font-weight: 700;
            color: var(--adm-ink);
        }

        .adm-stat h5 { margin: 2px 0 0; font-size: 13.5px; font-weight: 600; }
        .adm-stat small { color: var(--adm-ink-faint); font-size: 12px; }

        /* ============ QUICK ACTION CARDS ============ */
        .adm-action {
            display: block;
            text-decoration: none;
            color: var(--adm-ink);
            background: var(--adm-raised);
            border-radius: var(--adm-radius);
            padding: 28px 24px;
            text-align: left;
            box-shadow: var(--adm-shadow-sm);
            position: relative;
            overflow: hidden;
            transition: transform .25s, box-shadow .25s;
        }

        .adm-action::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            width: 100%;
            height: 4px;
            background: linear-gradient(90deg, var(--adm-teal), var(--adm-teal-deep));
        }

        .adm-action:hover {
            transform: translateY(-6px);
            box-shadow: var(--adm-shadow);
            color: var(--adm-ink);
            text-decoration: none;
        }

        .adm-action:hover .adm-action-go { transform: translateX(4px); opacity: 1; }

        .adm-action-icon {
            width: 54px;
            height: 54px;
            margin-bottom: 16px;
            border-radius: 16px;
            background: var(--adm-teal-dim);
            color: var(--adm-teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 23px;
        }

        .adm-action h5 { font-weight: 700; margin: 0 0 8px; font-size: 15px; }

        .adm-action p {
            color: var(--adm-ink-soft);
            margin: 0;
            font-size: 13px;
            line-height: 1.6;
        }

        .adm-action-go {
            display: inline-flex;
            margin-top: 14px;
            color: var(--adm-teal);
            opacity: .5;
            transition: transform .2s, opacity .2s;
            font-size: 13px;
        }

        /* Disabled "coming soon" quick action cards — no controller required */
        .adm-action-disabled {
            cursor: not-allowed;
            opacity: .68;
            filter: grayscale(.15);
        }

        .adm-action-disabled::before {
            background: linear-gradient(90deg, var(--adm-ink-faint), var(--adm-line-strong));
        }

        .adm-action-disabled:hover {
            transform: none;
            box-shadow: var(--adm-shadow-sm);
        }

        .adm-action-disabled .adm-action-icon {
            background: var(--adm-line);
            color: var(--adm-ink-faint);
        }

        .adm-action-disabled .adm-action-go { opacity: .3; }

        .adm-soon-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: var(--adm-gold-dim);
            color: var(--adm-gold);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 999px;
        }

        /* ============ SPLIT PANELS ============ */
        .adm-split {
            display: grid;
            grid-template-columns: 1.2fr 0.8fr;
            gap: 18px;
        }

        .adm-panel {
            background: var(--adm-raised);
            border-radius: var(--adm-radius);
            box-shadow: var(--adm-shadow);
            overflow: hidden;
        }

        .adm-panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 26px;
            border-bottom: 1px solid var(--adm-line);
        }

        .adm-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            color: var(--adm-ink);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .adm-panel-head span:first-child i { color: var(--adm-teal); }

        .adm-panel-tag {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 11.5px;
            background: var(--adm-teal-dim);
            color: var(--adm-teal-deep);
            padding: 6px 13px;
            border-radius: 999px;
        }

        /* ============ EMPTY STATE ============ */
        .adm-empty-state {
            padding: 48px 30px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .adm-empty-icon {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: var(--adm-teal-dim);
            color: var(--adm-teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 4px;
        }

        .adm-empty-state h5 {
            margin: 0;
            font-size: 14.5px;
            font-weight: 700;
            color: var(--adm-ink);
        }

        .adm-empty-state p {
            margin: 0;
            max-width: 340px;
            font-size: 13px;
            color: var(--adm-ink-soft);
            line-height: 1.6;
        }

        /* ============ CHART PANEL ============ */
        .adm-chart-body {
            padding: 24px 26px 28px;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 18px;
        }

        .adm-chart-body canvas {
            max-width: 210px;
            max-height: 210px;
        }

        .adm-chart-legend {
            width: 100%;
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .adm-legend-row {
            display: flex;
            align-items: center;
            gap: 10px;
            font-size: 13px;
            color: var(--adm-ink-soft);
        }

        .adm-legend-row strong {
            margin-left: auto;
            color: var(--adm-ink);
            font-weight: 700;
        }

        .adm-legend-dot {
            width: 10px;
            height: 10px;
            border-radius: 50%;
            flex-shrink: 0;
        }

        /* ============ FOOTER ============ */
        .adm-footer { margin-top: 50px; text-align: center; }

        .adm-footer hr {
            border: none;
            border-top: 1px solid var(--adm-line);
            margin-bottom: 22px;
        }

        .adm-footer-content {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--adm-ink-faint);
            font-size: 13px;
        }

        .adm-footer-content i { color: var(--adm-teal); }
        .adm-footer-divider { color: var(--adm-line-strong); }

        /* ============ RESPONSIVE ============ */
        @@media (max-width: 1100px) {
            .adm-grid-4 { grid-template-columns: repeat(2, 1fr); }
            .adm-grid-3 { grid-template-columns: repeat(2, 1fr); }
            .adm-split { grid-template-columns: 1fr; }
        }

        @@media (max-width: 900px) {
            .adm-banner { flex-direction: column; align-items: flex-start; gap: 24px; }

            .adm-clock {
                width: 100%;
                border-left: none;
                border-top: 1px solid rgba(255,255,255,.28);
                padding-left: 0;
                padding-top: 18px;
            }

            .adm-banner-left { flex-direction: column; text-align: center; width: 100%; }
        }

        @@media (max-width: 640px) {
            .adm-wrap { padding: 20px 16px 50px; }
            .adm-grid-4, .adm-grid-3, .adm-grid-2 { grid-template-columns: 1fr; }

            .adm-status-strip {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }
    </style>
}


    
