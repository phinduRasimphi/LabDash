    @section Scripts {

        <script>

            // =========================================================
            // CLOCK
            // =========================================================

            function updateClock() {

                const now = new Date();

                const dateElement =
                    document.getElementById("currentDate");

                const timeElement =
                    document.getElementById("currentTime");

                if (dateElement) {

                    dateElement.textContent =
                        now.toLocaleDateString("en-ZA", {
                            weekday: "long",
                            day: "numeric",
                            month: "long",
                            year: "numeric"
                        });

                }

                if (timeElement) {

                    timeElement.textContent =
                        now.toLocaleTimeString("en-ZA", {
                            hour: "2-digit",
                            minute: "2-digit",
                            second: "2-digit"
                        });

                }

            }


            updateClock();

            setInterval(updateClock, 1000);


            // =========================================================
            // SET VALUE
            // =========================================================

            function setValue(id, value) {

                const element =
                    document.getElementById(id);

                if (!element)
                    return;

                element.textContent =
                    value ?? 0;
            }


            // =========================================================
            // LOAD SUMMARY
            // =========================================================

            async function loadDashboardSummary() {

                try {

                    const response =
                        await fetch(
                            '@Url.Action("DashboardSummary", "AvailableTests")'
                        );


                    if (!response.ok) {

                        throw new Error(
                            "Unable to load dashboard summary."
                        );

                    }


                    const data =
                        await response.json();


                    // =================================================
                    // MAIN CARDS
                    // =================================================

                    setValue(
                        "availableCount",
                        data.waitingToBeSelected
                    );


                    setValue(
                        "inProgressCount",
                        data.selectedByTechnician
                    );


                    setValue(
                        "verifiedCount",
                        data.waitingForVerification
                    );


                    setValue(
                        "reviewCount",
                        data.waitingForReview
                    );


                    setValue(
                        "urgentCount",
                        data.urgent
                    );


                    setValue(
                        "overdueCount",
                        data.overdue
                    );


                    setValue(
                        "nearDeadlineCount",
                        data.nearDeadline
                    );


                    setValue(
                        "completedCount",
                        data.verified
                    );


                    // =================================================
                    // PIPELINE
                    // =================================================

                    setValue(
                        "flowAvailable",
                        data.waitingToBeSelected
                    );


                    setValue(
                        "flowInProgress",
                        data.selectedByTechnician
                    );


                    setValue(
                        "flowVerified",
                        data.waitingForVerification
                    );


                    setValue(
                        "flowReview",
                        data.waitingForReview
                    );


                    // =================================================
                    // CHIPS
                    // =================================================

                    document.getElementById("urgentChip")
                        .textContent =
                        `${data.urgent ?? 0} STAT tests`;


                    document.getElementById("overdueChip")
                        .textContent =
                        `${data.overdue ?? 0} overdue tests`;


                    document.getElementById("nearDeadlineChip")
                        .textContent =
                        `${data.nearDeadline ?? 0} near deadline`;

                }
                catch (error) {

                    console.error(
                        "Dashboard summary error:",
                        error
                    );

                }

            }


            // =========================================================
            // LOAD CATEGORIES
            // =========================================================

            async function loadCategories() {

                try {

                    const response =
                        await fetch(
                            '@Url.Action("DashboardCategories", "AvailableTests")'
                        );


                    if (!response.ok)
                        throw new Error(
                            "Unable to load categories."
                        );


                    const categories =
                        await response.json();


                    const select =
                        document.getElementById(
                            "filterCategory"
                        );


                    if (!select)
                        return;


                    select.innerHTML =
                        '<option value="">All categories</option>';


                    categories.forEach(category => {

                        const option =
                            document.createElement("option");

                        option.value = category;

                        option.textContent = category;

                        select.appendChild(option);

                    });

                }
                catch (error) {

                    console.error(
                        "Category loading error:",
                        error
                    );

                }

            }


            // =========================================================
            // LOAD QUEUE
            // =========================================================

            async function loadQueue() {

                const urgency =
                    document.getElementById(
                        "filterUrgency"
                    ).value;


                const category =
                    document.getElementById(
                        "filterCategory"
                    ).value;


                const due =
                    document.getElementById(
                        "filterDue"
                    ).value;


                const requestNumber =
                    document.getElementById(
                        "filterRequest"
                    ).value.trim();


                const params =
                    new URLSearchParams();


                if (urgency)
                    params.append(
                        "urgency",
                        urgency
                    );


                if (category)
                    params.append(
                        "category",
                        category
                    );


                if (due)
                    params.append(
                        "due",
                        due
                    );


                if (requestNumber)
                    params.append(
                        "requestNumber",
                        requestNumber
                    );


                try {

                    showQueueLoading();


                    const url =
                        '@Url.Action("DashboardQueue", "AvailableTests")'
                        +
                        (
                            params.toString()
                                ? "?" + params.toString()
                                : ""
                        );


                    const response =
                        await fetch(url);


                    if (!response.ok)
                        throw new Error(
                            "Unable to load technician queue."
                        );


                    const tests =
                        await response.json();


                    renderQueue(tests);

                }
                catch (error) {

                    console.error(
                        "Queue loading error:",
                        error
                    );

                    showQueueError();

                }

            }


            // =========================================================
            // RENDER QUEUE
            // =========================================================

            function renderQueue(tests) {

                const body =
                    document.getElementById(
                        "queueBody"
                    );


                const count =
                    document.getElementById(
                        "queueCount"
                    );


                count.textContent =
                    `${tests.length} test${tests.length === 1 ? "" : "s"}`;


                if (!tests.length) {

                    body.innerHTML = `

                        <tr>

                            <td colspan="8">

                                <div class="db-empty">

                                    <i class="fa-solid fa-circle-check"></i>

                                    <h3>
                                        No tests found
                                    </h3>

                                    <p>
                                        There are no laboratory tests
                                        matching the selected filters.
                                    </p>

                                </div>

                            </td>

                        </tr>

                    `;

                    return;
                }


                body.innerHTML =
                    tests.map(test => {

                        // =============================================
                        // URGENCY
                        // =============================================

                        let urgencyClass =
                            "db-status-neutral";


                        if (test.urgency === "STAT") {

                            urgencyClass =
                                "db-status-danger";

                        }
                        else if (test.urgency === "Urgent") {

                            urgencyClass =
                                "db-status-warning";

                        }
                        else if (test.urgency === "Priority") {

                            urgencyClass =
                                "db-status-info";

                        }


                        // =============================================
                        // STATUS
                        // =============================================

                        let statusClass =
                            "db-status-neutral";


                        if (test.status === "In Progress") {

                            statusClass =
                                "db-status-info";

                        }
                        else if (test.status === "Completed") {

                            statusClass =
                                "db-status-success";

                        }
                        else if (
                            test.status === "To Be Reviewed"
                        ) {

                            statusClass =
                                "db-status-warning";

                        }
                        else if (
                            test.status === "Submitted"
                        ) {

                            statusClass =
                                "db-status-neutral";

                        }


                        // =============================================
                        // DUE TIME
                        // =============================================

                        let dueClass = "";

                        if (test.overdue) {

                            dueClass =
                                "db-due-overdue";

                        }
                        else if (test.nearDeadline) {

                            dueClass =
                                "db-due-near";

                        }


                        let dueText =
                            test.dueDisplay || "—";


                        if (
                            test.status === "In Progress" &&
                            test.minutesRemaining !== null &&
                            test.minutesRemaining !== undefined
                        ) {

                            if (test.minutesRemaining < 0) {

                                dueText =
                                    `Overdue by ${Math.abs(test.minutesRemaining)} min`;

                            }
                            else if (test.minutesRemaining === 0) {

                                dueText =
                                    "Due now";

                            }
                            else {

                                dueText =
                                    `${test.minutesRemaining} min remaining`;

                            }

                        }


                        // =============================================
                        // ACTION
                        // =============================================

                        let action = "";


                        if (test.status === "Submitted") {

                            action = `

                                <a
                                    href="@Url.Action("Index", "AvailableTests")"
                                    class="db-table-action">

                                    <i class="fa-solid fa-arrow-right"></i>

                                    Select

                                </a>

                            `;

                        }
                        else if (
                            test.status === "In Progress"
                        ) {

                            action = `

                                <a
                                    href="@Url.Action("ProcessTest", "AvailableTests")?id=${test.id}"
                                    class="db-table-action">

                                    <i class="fa-solid fa-flask"></i>

                                    Process

                                </a>

                            `;

                        }
                        else if (
                            test.status === "Completed"
                        ) {

                            action = `

                                <a
                                    href="@Url.Action("Index", "Verification")"
                                    class="db-table-action">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Verify

                                </a>

                            `;

                        }
                        else if (
                            test.status === "To Be Reviewed"
                        ) {

                            action = `

                                <a
                                    href="@Url.Action("Index", "Verification")"
                                    class="db-table-action">

                                    <i class="fa-solid fa-file-medical"></i>

                                    Review

                                </a>

                            `;

                        }


                        return `

                            <tr>

                                <td>

                                    <span class="db-request-number">

                                        #${escapeHtml(
                                            String(test.requestId)
                                        )}

                                    </span>

                                </td>


                                <td>

                                    <strong>
                                        ${escapeHtml(
                                            test.patient
                                        )}
                                    </strong>

                                </td>


                                <td>

                                    <strong>
                                        ${escapeHtml(
                                            test.testName
                                        )}
                                    </strong>

                                </td>


                                <td>

                                    ${escapeHtml(
                                        test.category
                                    )}

                                </td>


                                <td>

                                    <span class="${urgencyClass}">

                                        ${escapeHtml(
                                            test.urgency
                                        )}

                                    </span>

                                </td>


                                <td>

                                    <span class="${statusClass}">

                                        ${escapeHtml(
                                            test.statusDisplay
                                        )}

                                    </span>

                                </td>


                                <td>

                                    <span class="${dueClass}">

                                        ${escapeHtml(
                                            dueText
                                        )}

                                    </span>

                                </td>


                                <td>

                                    ${action}

                                </td>

                            </tr>

                        `;

                    }).join("");

            }


            // =========================================================
            // ESCAPE HTML
            // =========================================================

            function escapeHtml(value) {

                const div =
                    document.createElement("div");

                div.textContent =
                    value ?? "";

                return div.innerHTML;

            }


            // =========================================================
            // LOADING
            // =========================================================

            function showQueueLoading() {

                document.getElementById(
                    "queueBody"
                ).innerHTML = `

                    <tr>

                        <td colspan="8">

                            <div class="db-empty">

                                <i class="fa-solid fa-spinner fa-spin"></i>

                                <h3>
                                    Loading laboratory workload...
                                </h3>

                                <p>
                                    Retrieving your current test queue.
                                </p>

                            </div>

                        </td>

                    </tr>

                `;

            }


            // =========================================================
            // ERROR
            // =========================================================

            function showQueueError() {

                document.getElementById(
                    "queueBody"
                ).innerHTML = `

                    <tr>

                        <td colspan="8">

                            <div class="db-empty">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                                <h3>
                                    Dashboard data could not be loaded
                                </h3>

                                <p>
                                    The technician queue could not
                                    be retrieved.
                                </p>

                                <button
                                    type="button"
                                    class="db-btn-solid"
                                    onclick="loadQueue()">

                                    <i class="fa-solid fa-rotate-right"></i>

                                    Try again

                                </button>

                            </div>

                        </td>

                    </tr>

                `;

            }


            // =========================================================
            // APPLY FILTER
            // =========================================================

            document.getElementById(
                "applyFilter"
            ).addEventListener(
                "click",
                function () {

                    loadQueue();

                }
            );


            // =========================================================
            // RESET FILTER
            // =========================================================

            document.getElementById(
                "resetFilter"
            ).addEventListener(
                "click",
                function () {

                    document.getElementById(
                        "filterUrgency"
                    ).value = "";


                    document.getElementById(
                        "filterCategory"
                    ).value = "";


                    document.getElementById(
                        "filterDue"
                    ).value = "";


                    document.getElementById(
                        "filterRequest"
                    ).value = "";


                    loadQueue();

                }
            );


            // =========================================================
            // ENTER KEY SEARCH
            // =========================================================

            document.getElementById(
                "filterRequest"
            ).addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Enter") {

                        event.preventDefault();

                        loadQueue();

                    }

                }
            );


            // =========================================================
            // INITIAL LOAD
            // =========================================================

            document.addEventListener(
                "DOMContentLoaded",
                async function () {

                    await loadDashboardSummary();

                    await loadCategories();

                    await loadQueue();

                }
            );

        </script>
