@using LabDash.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@model LabDash.Models.AdminDashboardViewModel

@using LabDash.Models
@inject SignInManager<LabUser> SignInManager
@inject UserManager<LabUser> UserManager
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}



@if (SignInManager.IsSignedIn(User))
if (User.IsInRole("Admin"))
{
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

    <div class="adm-wrap">
        @{
            var warnings = Model.Warnings ?? new List<string>();
            var healthy = warnings.Count == 0;
            var activityTotal = (Model.ActivityCounts ?? new List<int>()).Sum();

            var byAction = Model.ActivityByAction ?? new Dictionary<string, int>();
            int CountOf(string key) => byAction.TryGetValue(key, out var found) ? found : 0;

            string BadgeClass(string action) => (action ?? "").ToLowerInvariant() switch
            {
                "created" => "is-created",
                "updated" => "is-updated",
                "deactivated" or "deleted" => "is-removed",
                "reactivated" => "is-restored",
                _ => ""
            };
        }

        <!-- ==========================================
            HEADER
        =========================================== -->
        <div class="adm-banner">
            <div class="adm-banner-pattern"></div>

            <div class="adm-banner-left">
                <div class="adm-banner-icon">
                    <span class="adm-icon-ring"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="adm-banner-text">
                        <h1>Welcome, <span>@Model.AdminName</span></h1>
                    <p>NMB-HLabSys Admin Control Center</p>
                    <div class="adm-pills">
                        <span class="adm-pill"><i class="fa-solid fa-database"></i> Reference data governance</span>
                        <span class="adm-pill"><i class="fa-solid fa-gears"></i> System configuration</span>
                    </div>
                </div>
            </div>

            <div class="adm-clock">
                <small>Today's date</small>
                <div id="adminCurrentDate"></div>
                <div id="adminCurrentTime"></div>
            </div>
        </div>

        <!-- ==========================================
            SYSTEM STATUS STRIP
        =========================================== -->
        <div class="adm-status-strip @(healthy ? "" : "adm-status-warn")">
            <div class="adm-status-body">
                <div class="adm-status-left">
                    <span class="adm-status-dot"></span>
                    @if (healthy)
                    {
                        <span><strong>Reference data looks healthy</strong> &middot; all checks passed, 0 warnings</span>
                    }
                    else
                    {
                        <span><strong>@warnings.Count @(warnings.Count == 1 ? "item needs" : "items need") attention</strong></span>
                    }
                </div>

                @if (!healthy)
                {
                    <ul class="adm-status-list">
                        @foreach (var w in warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                }
            </div>

            <a class="adm-status-link" href="@Url.Action("DataQuality", "Admin")">
                Review checks <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- ==========================================
            REFERENCE DATA OVERVIEW
        =========================================== -->
        <div class="adm-section-head">
            <div>
                <h3>Reference data overview</h3>
                <p>Live counts of the medical reference records your system depends on.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-4">

            <div class="adm-stat">
                <div class="adm-stat-icon c-teal"><i class="fa-solid fa-heart-pulse"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.ConditionCount</div>
                    <h5>Conditions</h5>
                    <small>Active classifications</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-purple"><i class="fa-solid fa-allergies"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.AllergyCount</div>
                    <h5>Allergies</h5>
                    <small>Tracked intolerances</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-blue"><i class="fa-solid fa-pills"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.MedicationCount</div>
                    <h5>Medications</h5>
                    <small>Verified formulary</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-gold"><i class="fa-solid fa-layer-group"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@(Model.ConditionCount + Model.AllergyCount + Model.MedicationCount)</div>
                    <h5>Total records</h5>
                    <small>Across all reference tables</small>
                </div>
            </div>

        </div>

        <!-- ==========================================
            QUICK ACTIONS
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Quick actions</h3>
                <p>Manage the reference data that powers the rest of the system.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-3">

            <a href="@Url.Action("Conditions", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-heart-pulse"></i></div>
                <h5>Manage conditions</h5>
                <p>Add, edit, or retire condition classifications and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("Allergies", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-allergies"></i></div>
                <h5>Manage allergies</h5>
                <p>Add, edit, or retire allergy records and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("Medications", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-pills"></i></div>
                <h5>Manage medications</h5>
                <p>Add, edit, or retire medications and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("AuditLog", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                <h5>Audit log</h5>
                <p>Review who created, changed, or deactivated reference data and when.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("SystemTables", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-database"></i></div>
                <h5>System tables</h5>
                <p>Manage sample types and units used across requests and results.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("DataQuality", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <h5>Data quality checks</h5>
                <p>Find duplicate names, archived-category records, and empty tables automatically.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

        </div>

        <!-- ==========================================
            INSIGHTS: RECENT CHANGES + ACTIVITY
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Reference data insights</h3>
                <p>Recent changes, and how much activity there has been over the last 30 days.</p>
            </div>
        </div>

        <div class="adm-split">

            <!-- LEFT: recent changes feed (from the audit log) -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-clock-rotate-left"></i> Recent reference data changes</span>
                    <span class="adm-panel-tag">Reference data</span>
                </div>

                @if (Model.RecentChanges != null && Model.RecentChanges.Count > 0)
                {
                    <ul class="adm-feed">
                        @foreach (var log in Model.RecentChanges)
                        {
                            <li class="adm-feed-item">
                                <span class="adm-feed-badge @BadgeClass(log.Action)">@log.Action</span>
                                <div class="adm-feed-text">
                                    <strong>@log.TableName</strong>
                                    <span>@log.Details</span>
                                    <small>@log.UserName &middot; @log.ActionDate.ToString("dd MMM yyyy, HH:mm")</small>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="adm-panel-foot" href="@Url.Action("AuditLog", "Admin")">View full audit log &rarr;</a>
                }
                else
                {
                    <div class="adm-empty-state">
                        <div class="adm-empty-icon"><i class="fa-regular fa-folder-open"></i></div>
                        <h5>Nothing to show yet</h5>
                        <p>Once conditions, allergies, and medications are being managed, the most recent changes will appear here automatically.</p>
                    </div>
                }
            </div>

            <!-- RIGHT: activity over time (range toggle, KPIs, trend, chart, what changed) -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-chart-line"></i> Activity over time</span>
                    <div class="adm-range" role="group" aria-label="Choose a date range">
                        <button type="button" class="adm-range-btn" data-range="7">7D</button>
                        <button type="button" class="adm-range-btn" data-range="14">14D</button>
                        <button type="button" class="adm-range-btn is-active" data-range="30">30D</button>
                    </div>
                </div>

                <div class="adm-activity-body">

                    <div class="adm-kpis">
                        <div class="adm-kpi">
                            <small>Total changes</small>
                            <strong id="adminActTotal">@activityTotal</strong>
                            <em id="adminActRange">last 30 days</em>
                        </div>
                        <div class="adm-kpi">
                            <small>Daily average</small>
                            <strong id="adminActAvg">0.0</strong>
                            <em>changes per day</em>
                        </div>
                        <div class="adm-kpi">
                            <small>Busiest day</small>
                            <strong id="adminActBusiest">&mdash;</strong>
                            <em id="adminActBusiestSub">no activity yet</em>
                        </div>
                    </div>

                    <div class="adm-chart-row">
                        <span class="adm-chart-cap">Daily changes</span>
                        <span id="adminActTrend" class="adm-trend"></span>
                    </div>

                    <div class="adm-activity-canvas">
                        <div id="adminActivityChart" class="adm-svgchart"></div>
                        @if (activityTotal == 0)
                        {
                            <div class="adm-activity-hint">
                                <i class="fa-regular fa-lightbulb"></i>
                                <span>No changes yet. Add or edit a record and it will show up here.</span>
                            </div>
                        }
                    </div>

                    <div class="adm-mix">
                        <div class="adm-mix-head">
                            <span>What changed</span>
                            <small>Last 30 days</small>
                        </div>

                        <div class="adm-mix-bar">
                            <span class="adm-mix-seg is-created" style="flex-grow:@CountOf("Created")"></span>
                            <span class="adm-mix-seg is-updated" style="flex-grow:@CountOf("Updated")"></span>
                            <span class="adm-mix-seg is-removed" style="flex-grow:@CountOf("Removed")"></span>
                            <span class="adm-mix-seg is-restored" style="flex-grow:@CountOf("Restored")"></span>
                        </div>

                        <div class="adm-mix-legend">
                            <div><span class="adm-dot is-created"></span>Added <strong>@CountOf("Created")</strong></div>
                            <div><span class="adm-dot is-updated"></span>Edited <strong>@CountOf("Updated")</strong></div>
                            <div><span class="adm-dot is-removed"></span>Deactivated <strong>@CountOf("Removed")</strong></div>
                            <div><span class="adm-dot is-restored"></span>Restored <strong>@CountOf("Restored")</strong></div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- ==========================================
            FOOTER
        =========================================== -->
        <div class="adm-footer">
            <hr />
            <div class="adm-footer-content">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Laboratory Information Management System</span>
                <span class="adm-footer-divider">|</span>
                <span>Admin Control Center</span>
                <span class="adm-footer-divider">|</span>
                <span>@DateTime.Now.Year</span>
            </div>
        </div>

    </div>

    <script>
        function updateAdminClock() {
            const now = new Date();
            document.getElementById("adminCurrentDate").innerHTML = now.toLocaleDateString("en-ZA", {
                weekday: "long", day: "numeric", month: "long", year: "numeric"
            });
            document.getElementById("adminCurrentTime").innerHTML = now.toLocaleTimeString("en-ZA", {
                hour: "2-digit", minute: "2-digit", second: "2-digit"
            });
        }
        updateAdminClock();
        setInterval(updateAdminClock, 1000);

        // Activity over time: dependency-free SVG area chart with a 7/14/30 day toggle,
        // KPI tiles and a trend badge. All data comes from the view model, so no extra
        // endpoint, controller or chart library is needed.
        (function () {
            const box = document.getElementById('adminActivityChart');
            if (!box) return;

            const allLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityLabels));
            const allCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityCounts));

            const SVG_NS = 'http://www.w3.org/2000/svg';
            const H = 210;
            let range = 30;

            const sum = function (arr) {
                return arr.reduce(function (a, b) { return a + b; }, 0);
            };

            const setText = function (id, text) {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            const svgEl = function (name, attrs) {
                const el = document.createElementNS(SVG_NS, name);
                Object.keys(attrs || {}).forEach(function (key) { el.setAttribute(key, attrs[key]); });
                return el;
            };

            const tip = document.createElement('div');
            tip.className = 'adm-svgtip';
            box.appendChild(tip);

            // ---------- chart ----------
            function drawChart(labels, counts) {
                const old = box.querySelector('svg');
                if (old) box.removeChild(old);

                const n = counts.length;
                if (n === 0) return;

                const W = box.clientWidth || 520;
                const pad = { l: 34, r: 12, t: 14, b: 26 };
                const iw = W - pad.l - pad.r;
                const ih = H - pad.t - pad.b;
                const base = pad.t + ih;

                const top = Math.max(4, Math.max.apply(null, counts));
                const step = Math.ceil(top / 4);
                const yMax = step * 4;

                const xAt = function (i) { return n === 1 ? pad.l + iw / 2 : pad.l + (i * iw) / (n - 1); };
                const yAt = function (v) { return base - (v / yMax) * ih; };

                const svg = svgEl('svg', {
                    width: W,
                    height: H,
                    viewBox: '0 0 ' + W + ' ' + H,
                    role: 'img',
                    'aria-label': 'Changes per day'
                });

                const defs = svgEl('defs');
                const grad = svgEl('linearGradient', { id: 'admActGrad', x1: 0, y1: 0, x2: 0, y2: 1 });
                grad.appendChild(svgEl('stop', { offset: '0%', 'stop-color': '#0E8C7F', 'stop-opacity': '0.35' }));
                grad.appendChild(svgEl('stop', { offset: '100%', 'stop-color': '#0E8C7F', 'stop-opacity': '0' }));
                defs.appendChild(grad);
                svg.appendChild(defs);

                // horizontal grid lines + y labels (always whole numbers)
                for (let t = 0; t <= 4; t++) {
                    const v = t * step;
                    const y = yAt(v);
                    svg.appendChild(svgEl('line', { x1: pad.l, x2: W - pad.r, y1: y, y2: y, stroke: '#E1EEEC', 'stroke-width': 1 }));
                    const lab = svgEl('text', { x: pad.l - 8, y: y + 4, 'text-anchor': 'end', 'font-size': 11, fill: '#8FA9A3' });
                    lab.textContent = v;
                    svg.appendChild(lab);
                }

                // x labels, counted back from the most recent day
                const every = Math.max(1, Math.ceil(n / 6));
                for (let i = n - 1; i >= 0; i -= every) {
                    const anchor = i === n - 1 ? 'end' : (i === 0 ? 'start' : 'middle');
                    const lab = svgEl('text', { x: xAt(i), y: H - 6, 'text-anchor': anchor, 'font-size': 11, fill: '#8FA9A3' });
                    lab.textContent = labels[i];
                    svg.appendChild(lab);
                }

                // smooth line + filled area
                let line = 'M ' + xAt(0) + ' ' + yAt(counts[0]);
                for (let i = 1; i < n; i++) {
                    const x0 = xAt(i - 1);
                    const y0 = yAt(counts[i - 1]);
                    const x1 = xAt(i);
                    const y1 = yAt(counts[i]);
                    const xm = (x0 + x1) / 2;
                    line += ' C ' + xm + ' ' + y0 + ', ' + xm + ' ' + y1 + ', ' + x1 + ' ' + y1;
                }
                const area = line + ' L ' + xAt(n - 1) + ' ' + base + ' L ' + xAt(0) + ' ' + base + ' Z';

                svg.appendChild(svgEl('path', { d: area, fill: 'url(#admActGrad)' }));
                svg.appendChild(svgEl('path', {
                    d: line,
                    fill: 'none',
                    stroke: '#0E8C7F',
                    'stroke-width': 2.5,
                    'stroke-linecap': 'round',
                    'stroke-linejoin': 'round'
                }));

                // dots (every day on short ranges, only busy days on long ones)
                counts.forEach(function (v, i) {
                    if (v > 0 || n <= 14) {
                        svg.appendChild(svgEl('circle', { cx: xAt(i), cy: yAt(v), r: 3.5, fill: '#FFFFFF', stroke: '#0E8C7F', 'stroke-width': 2 }));
                    }
                });

                // hover guide + tooltip
                const guide = svgEl('line', { y1: pad.t, y2: base, stroke: '#0E8C7F', 'stroke-width': 1, 'stroke-dasharray': '3 3', opacity: 0 });
                const dot = svgEl('circle', { r: 5.5, fill: '#0E8C7F', stroke: '#FFFFFF', 'stroke-width': 2, opacity: 0 });
                svg.appendChild(guide);
                svg.appendChild(dot);

                const hit = svgEl('rect', { x: pad.l, y: pad.t, width: iw, height: ih, fill: 'transparent' });

                function show(evt) {
                    const rect = svg.getBoundingClientRect();
                    const px = evt.clientX - rect.left;
                    let i = n === 1 ? 0 : Math.round(((px - pad.l) / iw) * (n - 1));
                    i = Math.max(0, Math.min(n - 1, i));

                    const x = xAt(i);
                    const y = yAt(counts[i]);

                    guide.setAttribute('x1', x);
                    guide.setAttribute('x2', x);
                    guide.setAttribute('opacity', 1);
                    dot.setAttribute('cx', x);
                    dot.setAttribute('cy', y);
                    dot.setAttribute('opacity', 1);

                    tip.textContent = labels[i] + ': ' + counts[i] + (counts[i] === 1 ? ' change' : ' changes');
                    tip.style.left = Math.min(Math.max(x, 64), W - 64) + 'px';
                    tip.style.top = Math.max(y - 12, 40) + 'px';
                    tip.style.opacity = 1;
                }

                function hide() {
                    guide.setAttribute('opacity', 0);
                    dot.setAttribute('opacity', 0);
                    tip.style.opacity = 0;
                }

                hit.addEventListener('pointermove', show);
                hit.addEventListener('pointerdown', show);
                hit.addEventListener('pointerleave', hide);
                svg.appendChild(hit);

                box.insertBefore(svg, tip);
            }

            // ---------- trend badge: last 7 days vs the 7 days before (uses the full 30 days of data) ----------
            function renderTrend() {
                const el = document.getElementById('adminActTrend');
                if (!el) return;

                const last7 = sum(allCounts.slice(-7));
                const prev7 = sum(allCounts.slice(-14, -7));

                el.className = 'adm-trend';
                el.textContent = '';

                if (last7 === 0 && prev7 === 0) return;

                if (prev7 === 0) {
                    el.textContent = '\u25B2 New activity this week';
                    el.classList.add('is-up');
                    return;
                }

                const pct = Math.round(((last7 - prev7) / prev7) * 100);

                if (pct === 0) {
                    el.textContent = 'Same as the previous 7 days';
                } else if (pct > 0) {
                    el.textContent = '\u25B2 ' + pct + '% vs previous 7 days';
                    el.classList.add('is-up');
                } else {
                    el.textContent = '\u25BC ' + Math.abs(pct) + '% vs previous 7 days';
                    el.classList.add('is-down');
                }
            }

            // ---------- tiles + chart for the selected range ----------
            function render() {
                const labels = allLabels.slice(-range);
                const counts = allCounts.slice(-range);

                const total = sum(counts);
                const max = counts.length ? Math.max.apply(null, counts) : 0;

                setText('adminActTotal', total);
                setText('adminActRange', 'last ' + range + ' days');
                setText('adminActAvg', (total / range).toFixed(1));
                setText('adminActBusiest', max > 0 ? labels[counts.lastIndexOf(max)] : '\u2014');
                setText('adminActBusiestSub', max > 0 ? max + (max === 1 ? ' change' : ' changes') : 'no activity yet');

                // a drawing problem must never stop the toggle or the tiles from working
                try {
                    drawChart(labels, counts);
                } catch (err) {
                    if (window.console) console.error('Activity chart failed to draw:', err);
                }
            }

            // toggle is wired first, so it works whatever happens to the chart
            document.querySelectorAll('.adm-range-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.adm-range-btn').forEach(function (b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    range = parseInt(btn.getAttribute('data-range'), 10) || 30;
                    render();
                });
            });

            renderTrend();
            render();

            let resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(render, 150);
            });
        })();
    </script>

    <style>
        :root {
            --adm-paper: #F0F7F6;
            --adm-raised: #FFFFFF;
            --adm-ink: #102C27;
            --adm-ink-soft: #52716C;
            --adm-ink-faint: #8FA9A3;
            --adm-line: #E1EEEC;
            --adm-line-strong: #CCE3DF;
            --adm-teal: #0E8C7F;
            --adm-teal-deep: #0A5850;
            --adm-teal-dim: #E3F4F1;
            --adm-teal-grad-start: #12A392;
            --adm-teal-grad-end: #0A4F48;
            --adm-blue: #2C6E9E;
            --adm-blue-dim: #E4F0F9;
            --adm-purple: #6D4EA8;
            --adm-purple-dim: #EEE8F9;
            --adm-red: #B0463F;
            --adm-red-dim: #F7E8E7;
            --adm-orange: #B76A2C;
            --adm-orange-dim: #FBEEE1;
            --adm-gold: #B4862A;
            --adm-gold-dim: #FBF1DA;
            --adm-radius: 20px;
            --adm-radius-sm: 13px;
            --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
            --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
        }

        .adm-wrap {
            max-width: 1280px;
            margin: 0 auto;
            padding: 26px 24px 60px;
            color: var(--adm-ink);
            font-family: 'Inter', sans-serif;
            animation: admFadeIn .5s ease;
        }

        @@keyframes admFadeIn {
            from { opacity: 0; transform: translateY(12px); }
            to { opacity: 1; transform: translateY(0); }
        }

        /* ============ BANNER ============ */
        .adm-banner {
            position: relative;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 24px;
            background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
            border-radius: var(--adm-radius);
            padding: 32px 36px;
            margin-bottom: 22px;
            box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
            overflow: hidden;
        }

        .adm-banner-pattern {
