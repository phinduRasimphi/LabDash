@using LabDash.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@model LabDash.Models.AdminDashboardViewModel

@using LabDash.Models
@inject SignInManager<LabUser> SignInManager
@inject UserManager<LabUser> UserManager
@{
    ViewData["Title"] = "Index";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}



@if (SignInManager.IsSignedIn(User))
if (User.IsInRole("Admin"))
{
   @* ===================================================================
   ADMIN DASHBOARD (with dark mode)
   In Views/Home/Index.cshtml (or wherever this view lives), replace everything
   BETWEEN the braces of:

       @if (SignInManager.IsSignedIn(User))
       if (User.IsInRole("Admin"))
       {
           ... replace this part ...
       }

   Keep the braces and the `else if (User.IsInRole("Patient"))` that follows.
   =================================================================== *@

    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

    <div class="adm-wrap">
        @{
            var warnings = Model.Warnings ?? new List<string>();
            var healthy = warnings.Count == 0;
            var activityTotal = (Model.ActivityCounts ?? new List<int>()).Sum();

            var byAction = Model.ActivityByAction ?? new Dictionary<string, int>();
            int CountOf(string key) => byAction.TryGetValue(key, out var found) ? found : 0;

            string BadgeClass(string action) => (action ?? "").ToLowerInvariant() switch
            {
                "created" => "is-created",
                "updated" => "is-updated",
                "deactivated" or "deleted" => "is-removed",
                "reactivated" => "is-restored",
                _ => ""
            };
            var dayCounts = Model.ActivityCounts ?? new List<int>();
            var todayCount = dayCounts.Count > 0 ? dayCounts[dayCounts.Count - 1] : 0;
            var weekCount = dayCounts.Skip(Math.Max(0, dayCounts.Count - 7)).Sum();
            var totalRefs = Model.ConditionCount + Model.AllergyCount + Model.MedicationCount;
            int SharePct(int v) => totalRefs == 0 ? 0 : (int)Math.Round(v * 100.0 / totalRefs);
            var healthScore = Math.Max(0, 100 - warnings.Count * 20);
            var yesterdayCount = dayCounts.Count > 1 ? dayCounts[dayCounts.Count - 2] : 0;
            var dayDelta = todayCount - yesterdayCount;
            string DeltaText(int d) => d == 0 ? "same as yesterday" : (d > 0 ? "▲ " : "▼ ") + Math.Abs(d) + " vs yesterday";
            var topTables = Model.RecentChanges == null
                ? new List<KeyValuePair<string, int>>()
                : Model.RecentChanges
                    .GroupBy(l => l.TableName ?? "Unknown")
                    .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
                    .OrderByDescending(k => k.Value).Take(4).ToList();

            var topUsers = Model.RecentChanges == null
                ? new List<KeyValuePair<string, int>>()
                : Model.RecentChanges
                    .GroupBy(l => l.UserName ?? "Unknown")
                    .Select(g => new KeyValuePair<string, int>(g.Key, g.Count()))
                    .OrderByDescending(k => k.Value).Take(4).ToList();

            var maxTable = topTables.Count > 0 ? topTables.Max(k => k.Value) : 1;
            var maxUser = topUsers.Count > 0 ? topUsers.Max(k => k.Value) : 1;

            var lastChange = (Model.RecentChanges != null && Model.RecentChanges.Count > 0)
                ? Model.RecentChanges.Max(l => l.ActionDate).ToString("dd MMM, HH:mm")
                : "None yet";
        }

        <!-- ==========================================
            HEADER
        =========================================== -->
        <div class="adm-banner">
            <div class="adm-banner-pattern"></div>

            <div class="adm-banner-left">
                <div class="adm-banner-icon">
                    <span class="adm-icon-ring"></span>
                    <i class="fa-solid fa-shield-halved"></i>
                </div>
                <div class="adm-banner-text">
                    <h1>Welcome, <span>@Model.AdminName</span></h1>
                    <p>NMB-HLabSys Admin Control Center</p>
                    <div class="adm-pills">
                        <span class="adm-pill"><i class="fa-solid fa-database"></i> Reference data governance</span>
                        <span class="adm-pill"><i class="fa-solid fa-gears"></i> System configuration</span>
                    </div>
                </div>
            </div>

            <div class="adm-clock">
                <small>Today's date</small>
                <div id="adminCurrentDate"></div>
                <div id="adminCurrentTime"></div>
            </div>
        </div>

        <!-- ==========================================
            SYSTEM STATUS STRIP
        =========================================== -->
        <div class="adm-status-strip @(healthy ? "" : "adm-status-warn")">
            <div class="adm-status-body">
                <div class="adm-status-left">
                    <span class="adm-status-dot"></span>
                    @if (healthy)
                    {
                        <span><strong>Reference data looks healthy</strong> &middot; all checks passed, 0 warnings</span>
                    }
                    else
                    {
                        <span><strong>@warnings.Count @(warnings.Count == 1 ? "item needs" : "items need") attention</strong></span>
                    }
                </div>

                @if (!healthy)
                {
                    <ul class="adm-status-list">
                        @foreach (var w in warnings)
                        {
                            <li>@w</li>
                        }
                    </ul>
                }
            </div>

            <a class="adm-status-link" href="@Url.Action("DataQuality", "Admin")">
                Review checks <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        <!-- ==========================================
            AT A GLANCE
        =========================================== -->
        <div class="adm-glance">
            <div class="adm-glance-card">
                <small>Changes today</small>
                <strong>@todayCount</strong>
                <em>@DeltaText(dayDelta)</em>
            </div>
            <div class="adm-glance-card">
                <small>Last 7 days</small>
                <strong>@weekCount</strong>
                <em>total changes</em>
            </div>
            <div class="adm-glance-card">
                <small>Last change</small>
                <strong class="is-sm">@lastChange</strong>
                <em>most recent audit entry</em>
            </div>
            <div class="adm-glance-card adm-health @(healthy ? "" : "is-warn")">
                <div class="adm-health-ring" style="--pct:@healthScore"><span>@healthScore%</span></div>
                <div>
                    <small>Data health</small>
                    <em>@(healthy ? "All checks passed" : warnings.Count + (warnings.Count == 1 ? " warning" : " warnings"))</em>
                </div>
            </div>
        </div>

        <!-- ==========================================
            REFERENCE DATA OVERVIEW
        =========================================== -->
        <div class="adm-section-head">
            <div>
                <h3>Reference data overview</h3>
                <p>Live counts of the medical reference records your system depends on.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-4">

            <div class="adm-stat">
                <div class="adm-stat-icon c-teal"><i class="fa-solid fa-heart-pulse"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.ConditionCount</div>
                    <h5>Conditions</h5>
                    <small>Active classifications</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-purple"><i class="fa-solid fa-allergies"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.AllergyCount</div>
                    <h5>Allergies</h5>
                    <small>Tracked intolerances</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-blue"><i class="fa-solid fa-pills"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@Model.MedicationCount</div>
                    <h5>Medications</h5>
                    <small>Verified formulary</small>
                </div>
            </div>

            <div class="adm-stat">
                <div class="adm-stat-icon c-gold"><i class="fa-solid fa-layer-group"></i></div>
                <div class="adm-stat-body">
                    <div class="num">@(Model.ConditionCount + Model.AllergyCount + Model.MedicationCount)</div>
                    <h5>Total records</h5>
                    <small>Across all reference tables</small>
                </div>
            </div>

        </div>

        <!-- ==========================================
            REFERENCE DATA BREAKDOWN
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Reference data breakdown</h3>
                <p>How your records are split, and where the recent changes are happening.</p>
            </div>
        </div>

        <div class="adm-grid adm-grid-3">

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-chart-pie"></i> Composition</span>
                </div>
                <div class="adm-bars-body">
                    <div class="adm-mix-bar">
                        <span class="adm-mix-seg is-created" style="flex-grow:@Model.ConditionCount"></span>
                        <span class="adm-mix-seg is-purple" style="flex-grow:@Model.AllergyCount"></span>
                        <span class="adm-mix-seg is-updated" style="flex-grow:@Model.MedicationCount"></span>
                    </div>
                    <div class="adm-mix-legend adm-legend-1">
                        <div><span class="adm-dot is-created"></span>Conditions <strong>@SharePct(Model.ConditionCount)%</strong></div>
                        <div><span class="adm-dot is-purple"></span>Allergies <strong>@SharePct(Model.AllergyCount)%</strong></div>
                        <div><span class="adm-dot is-updated"></span>Medications <strong>@SharePct(Model.MedicationCount)%</strong></div>
                    </div>
                </div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-table-list"></i> Most changed tables</span>
                </div>
                <div class="adm-bars-body">
                    @if (topTables.Count == 0)
                    {
                        <p class="adm-noresult">No changes recorded yet.</p>
                    }
                    else
                    {
                        foreach (var t in topTables)
                        {
                            <div class="adm-rank">
                                <div class="adm-rank-label"><span>@t.Key</span><strong>@t.Value</strong></div>
                                <div class="adm-rank-bar"><span style="width:@((int)Math.Round(t.Value * 100.0 / maxTable))%"></span></div>
                            </div>
                        }
                    }
                </div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-user-clock"></i> Most active users</span>
                </div>
                <div class="adm-bars-body">
                    @if (topUsers.Count == 0)
                    {
                        <p class="adm-noresult">No changes recorded yet.</p>
                    }
                    else
                    {
                        foreach (var u in topUsers)
                        {
                            <div class="adm-rank">
                                <div class="adm-rank-label"><span>@u.Key</span><strong>@u.Value</strong></div>
                                <div class="adm-rank-bar"><span class="is-blue" style="width:@((int)Math.Round(u.Value * 100.0 / maxUser))%"></span></div>
                            </div>
                        }
                    }
                </div>
            </div>

        </div>

        <!-- ==========================================
            QUICK ACTIONS
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Quick actions</h3>
                <p>Manage the reference data that powers the rest of the system.</p>
            </div>
            <div class="adm-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input id="admActionSearch" type="search" placeholder="Search actions..." aria-label="Search quick actions" />
            </div>
        </div>

        <div class="adm-grid adm-grid-3" id="admActions">

            <a href="@Url.Action("Conditions", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-heart-pulse"></i></div>
                <h5>Manage conditions</h5>
                <p>Add, edit, or retire condition classifications and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("Allergies", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-allergies"></i></div>
                <h5>Manage allergies</h5>
                <p>Add, edit, or retire allergy records and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("Medications", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-pills"></i></div>
                <h5>Manage medications</h5>
                <p>Add, edit, or retire medications and their categories.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("AuditLog", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-clipboard-list"></i></div>
                <h5>Audit log</h5>
                <p>Review who created, changed, or deactivated reference data and when.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("SystemTables", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-database"></i></div>
                <h5>System tables</h5>
                <p>Manage sample types and units used across requests and results.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a href="@Url.Action("DataQuality", "Admin")" class="adm-action">
                <div class="adm-action-icon"><i class="fa-solid fa-magnifying-glass"></i></div>
                <h5>Data quality checks</h5>
                <p>Find duplicate names, archived-category records, and empty tables automatically.</p>
                <span class="adm-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

        </div>
        <p id="admActionEmpty" class="adm-noresult" hidden>No actions match your search.</p>

        <!-- ==========================================
            INSIGHTS: RECENT CHANGES + ACTIVITY
        =========================================== -->
        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Reference data insights</h3>
                <p>Recent changes, and how much activity there has been over the last 30 days.</p>
            </div>
        </div>

        <div class="adm-split">

            <!-- LEFT: recent changes feed (from the audit log) -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-clock-rotate-left"></i> Recent reference data changes</span>
                    <span class="adm-panel-tag">Reference data</span>
                </div>

                @if (Model.RecentChanges != null && Model.RecentChanges.Count > 0)
                {
                    <div class="adm-chips" role="group" aria-label="Filter changes">
                        <button type="button" class="adm-chip is-active" data-kind="all">All</button>
                        <button type="button" class="adm-chip" data-kind="is-created">Added</button>
                        <button type="button" class="adm-chip" data-kind="is-updated">Edited</button>
                        <button type="button" class="adm-chip" data-kind="is-removed">Removed</button>
                        <button type="button" class="adm-chip" data-kind="is-restored">Restored</button>
                        <button type="button" class="adm-chip adm-chip-export" id="admExport"><i class="fa-solid fa-file-csv"></i> Export CSV</button>
                    </div>
                    <ul class="adm-feed">
                        @foreach (var log in Model.RecentChanges)
                        {
                            <li class="adm-feed-item" data-kind="@BadgeClass(log.Action)">
                                <span class="adm-feed-badge @BadgeClass(log.Action)">@log.Action</span>
                                <div class="adm-feed-text">
                                    <strong>@log.TableName</strong>
                                    <span>@log.Details</span>
                                    <small>@log.UserName &middot; @log.ActionDate.ToString("dd MMM yyyy, HH:mm")</small>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="adm-panel-foot" href="@Url.Action("AuditLog", "Admin")">View full audit log &rarr;</a>
                }
                else
                {
                    <div class="adm-empty-state">
                        <div class="adm-empty-icon"><i class="fa-regular fa-folder-open"></i></div>
                        <h5>Nothing to show yet</h5>
                        <p>Once conditions, allergies, and medications are being managed, the most recent changes will appear here automatically.</p>
                    </div>
                }
            </div>

            <!-- RIGHT: activity over time (range toggle, KPIs, trend, chart, what changed) -->
            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-chart-line"></i> Activity over time</span>
                    <div class="adm-range" role="group" aria-label="Choose a date range">
                        <button type="button" class="adm-range-btn" data-range="7">7D</button>
                        <button type="button" class="adm-range-btn" data-range="14">14D</button>
                        <button type="button" class="adm-range-btn is-active" data-range="30">30D</button>
                    </div>
                </div>

                <div class="adm-activity-body">

                    <div class="adm-kpis">
                        <div class="adm-kpi">
                            <small>Total changes</small>
                            <strong id="adminActTotal">@activityTotal</strong>
                            <em id="adminActRange">last 30 days</em>
                        </div>
                        <div class="adm-kpi">
                            <small>Daily average</small>
                            <strong id="adminActAvg">0.0</strong>
                            <em>changes per day</em>
                        </div>
                        <div class="adm-kpi">
                            <small>Busiest day</small>
                            <strong id="adminActBusiest">&mdash;</strong>
                            <em id="adminActBusiestSub">no activity yet</em>
                        </div>
                    </div>

                    <div class="adm-chart-row">
                        <span class="adm-chart-cap">Daily changes</span>
                        <span id="adminActTrend" class="adm-trend"></span>
                    </div>

                    <div class="adm-activity-canvas">
                        <div id="adminActivityChart" class="adm-svgchart"></div>
                        @if (activityTotal == 0)
                        {
                            <div class="adm-activity-hint">
                                <i class="fa-regular fa-lightbulb"></i>
                                <span>No changes yet. Add or edit a record and it will show up here.</span>
                            </div>
                        }
                    </div>

                    <div class="adm-heat-wrap">
                        <span class="adm-chart-cap">Activity heat strip</span>
                        <div id="adminHeat" class="adm-heat"></div>
                        <div class="adm-heat-legend">
                            <span>Less</span>
                            <i class="adm-heat-cell l0"></i><i class="adm-heat-cell l1"></i><i class="adm-heat-cell l2"></i><i class="adm-heat-cell l3"></i><i class="adm-heat-cell l4"></i>
                            <span>More</span>
                        </div>
                    </div>

                    <div class="adm-mix">
                        <div class="adm-mix-head">
                            <span>What changed</span>
                            <small>Last 30 days</small>
                        </div>

                        <div class="adm-mix-bar">
                            <span class="adm-mix-seg is-created" style="flex-grow:@CountOf("Created")"></span>
                            <span class="adm-mix-seg is-updated" style="flex-grow:@CountOf("Updated")"></span>
                            <span class="adm-mix-seg is-removed" style="flex-grow:@CountOf("Removed")"></span>
                            <span class="adm-mix-seg is-restored" style="flex-grow:@CountOf("Restored")"></span>
                        </div>

                        <div class="adm-mix-legend">
                            <div><span class="adm-dot is-created"></span>Added <strong>@CountOf("Created")</strong></div>
                            <div><span class="adm-dot is-updated"></span>Edited <strong>@CountOf("Updated")</strong></div>
                            <div><span class="adm-dot is-removed"></span>Deactivated <strong>@CountOf("Removed")</strong></div>
                            <div><span class="adm-dot is-restored"></span>Restored <strong>@CountOf("Restored")</strong></div>
                        </div>
                    </div>

                </div>
            </div>

        </div>

        <!-- ==========================================
            SETUP CHECKLIST
        =========================================== -->
        @{
            var checklist = new[]
            {
                new { Text = "Resolve data quality warnings", Done = healthy,                  Url = Url.Action("DataQuality", "Admin") },
                new { Text = "Add condition records",         Done = Model.ConditionCount > 0,  Url = Url.Action("Conditions", "Admin") },
                new { Text = "Add allergy records",           Done = Model.AllergyCount > 0,    Url = Url.Action("Allergies", "Admin") },
                new { Text = "Add medication records",        Done = Model.MedicationCount > 0, Url = Url.Action("Medications", "Admin") }
            };
            var doneCount = checklist.Count(c => c.Done);
            var donePct = (int)Math.Round(doneCount * 100.0 / checklist.Length);
        }

        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Setup checklist</h3>
                <p>Make sure the reference data the rest of the system relies on is in place.</p>
            </div>
        </div>

        <div class="adm-panel">
            <div class="adm-check-head">
                <span>@doneCount of @checklist.Length complete</span>
                <div class="adm-rank-bar"><span style="width:@donePct%"></span></div>
            </div>
            <ul class="adm-check">
                @foreach (var item in checklist)
                {
                    <li>
                        <a href="@item.Url" class="@(item.Done ? "is-done" : "")">
                            <span class="adm-check-mark"><i class="fa-solid @(item.Done ? "fa-check" : "fa-arrow-right")"></i></span>
                            <span>@item.Text</span>
                        </a>
                    </li>
                }
            </ul>
        </div>

        <!-- ==========================================
            REFERENCE TABLES + RECENTLY REMOVED
        =========================================== -->
        @{
            var refTables = new[]
            {
                new { Name = "Conditions",  Count = Model.ConditionCount,  Page = "Conditions",  Icon = "fa-heart-pulse" },
                new { Name = "Allergies",   Count = Model.AllergyCount,    Page = "Allergies",   Icon = "fa-allergies" },
                new { Name = "Medications", Count = Model.MedicationCount, Page = "Medications", Icon = "fa-pills" }
            };
            var removedItems = Model.RecentChanges?.Where(l => BadgeClass(l.Action) == "is-removed").Take(5).ToList();
        }

        <div class="adm-section-head adm-mt-lg">
            <div>
                <h3>Reference tables</h3>
                <p>See how big each table is, and what was removed recently.</p>
            </div>
        </div>

        <div class="adm-split">

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-table"></i> Reference tables</span>
                </div>
                <div class="adm-bars-body">
                    @foreach (var t in refTables)
                    {
                        <div class="adm-rank">
                            <div class="adm-rank-label">
                                <span><i class="fa-solid @t.Icon"></i> @t.Name</span>
                                <strong>@t.Count &middot; @SharePct(t.Count)%</strong>
                            </div>
                            <div class="adm-rank-bar"><span style="width:@SharePct(t.Count)%"></span></div>
                            <a class="adm-mini-link" href="@Url.Action(t.Page, "Admin")">Manage @t.Name.ToLower() &rarr;</a>
                        </div>
                    }
                </div>
            </div>

            <div class="adm-panel">
                <div class="adm-panel-head">
                    <span><i class="fa-solid fa-trash-can-arrow-up"></i> Recently removed records</span>
                    <span class="adm-panel-tag">Last 5</span>
                </div>
                @if (removedItems != null && removedItems.Count > 0)
                {
                    <ul class="adm-feed">
                        @foreach (var log in removedItems)
                        {
                            <li class="adm-feed-item">
                                <span class="adm-feed-badge is-removed">@log.Action</span>
                                <div class="adm-feed-text">
                                    <strong>@log.TableName</strong>
                                    <span>@log.Details</span>
                                    <small>@log.UserName &middot; @log.ActionDate.ToString("dd MMM yyyy, HH:mm")</small>
                                </div>
                            </li>
                        }
                    </ul>
                    <a class="adm-panel-foot" href="@Url.Action("AuditLog", "Admin")">View full audit log &rarr;</a>
                }
                else
                {
                    <div class="adm-empty-state">
                        <div class="adm-empty-icon"><i class="fa-regular fa-circle-check"></i></div>
                        <h5>Nothing removed recently</h5>
                        <p>Deactivated or deleted records will show up here.</p>
                    </div>
                }
            </div>

        </div>

        <!-- ==========================================
            FOOTER
        =========================================== -->
        <div class="adm-footer">
            <hr />
            <div class="adm-footer-content">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Laboratory Information Management System</span>
                <span class="adm-footer-divider">|</span>
                <span>Admin Control Center</span>
                <span class="adm-footer-divider">|</span>
                <span>@DateTime.Now.Year</span>
            </div>
        </div>

    </div>

    <script>
        function updateAdminClock() {
            const now = new Date();
            document.getElementById("adminCurrentDate").innerHTML = now.toLocaleDateString("en-ZA", {
                weekday: "long", day: "numeric", month: "long", year: "numeric"
            });
            document.getElementById("adminCurrentTime").innerHTML = now.toLocaleTimeString("en-ZA", {
                hour: "2-digit", minute: "2-digit", second: "2-digit"
            });
        }
        updateAdminClock();
        setInterval(updateAdminClock, 1000);

        // Activity over time: dependency-free SVG area chart with a 7/14/30 day toggle,
        // KPI tiles and a trend badge. All data comes from the view model, so no extra
        // endpoint, controller or chart library is needed.
        // Colours are read from the page's CSS variables, so the chart follows light/dark mode.
        (function () {
            const box = document.getElementById('adminActivityChart');
            if (!box) return;

            const allLabels = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityLabels));
            const allCounts = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ActivityCounts));

            const SVG_NS = 'http://www.w3.org/2000/svg';
            const H = 210;
            let range = 30;

            const sum = function (arr) {
                return arr.reduce(function (a, b) { return a + b; }, 0);
            };

            const setText = function (id, text) {
                const el = document.getElementById(id);
                if (el) el.textContent = text;
            };

            const cssVar = function (name, fallback) {
                const v = getComputedStyle(document.documentElement).getPropertyValue(name).trim();
                return v || fallback;
            };

            const svgEl = function (name, attrs) {
                const el = document.createElementNS(SVG_NS, name);
                Object.keys(attrs || {}).forEach(function (key) { el.setAttribute(key, attrs[key]); });
                return el;
            };

            const tip = document.createElement('div');
            tip.className = 'adm-svgtip';
            box.appendChild(tip);

            // ---------- chart ----------
            function drawChart(labels, counts) {
                const old = box.querySelector('svg');
                if (old) box.removeChild(old);

                const n = counts.length;
                if (n === 0) return;

                const cGrid = cssVar('--adm-line', '#E1EEEC');
                const cLabel = cssVar('--adm-ink-faint', '#8FA9A3');
                const cTeal = cssVar('--adm-teal', '#0E8C7F');
                const cDot = cssVar('--adm-raised', '#FFFFFF');

                const W = box.clientWidth || 520;
                const pad = { l: 34, r: 12, t: 14, b: 26 };
                const iw = W - pad.l - pad.r;
                const ih = H - pad.t - pad.b;
                const base = pad.t + ih;

                const top = Math.max(4, Math.max.apply(null, counts));
                const step = Math.ceil(top / 4);
                const yMax = step * 4;

                const xAt = function (i) { return n === 1 ? pad.l + iw / 2 : pad.l + (i * iw) / (n - 1); };
                const yAt = function (v) { return base - (v / yMax) * ih; };

                const svg = svgEl('svg', {
                    width: W,
                    height: H,
                    viewBox: '0 0 ' + W + ' ' + H,
                    role: 'img',
                    'aria-label': 'Changes per day'
                });

                const defs = svgEl('defs');
                const grad = svgEl('linearGradient', { id: 'admActGrad', x1: 0, y1: 0, x2: 0, y2: 1 });
                grad.appendChild(svgEl('stop', { offset: '0%', 'stop-color': cTeal, 'stop-opacity': '0.35' }));
                grad.appendChild(svgEl('stop', { offset: '100%', 'stop-color': cTeal, 'stop-opacity': '0' }));
                defs.appendChild(grad);
                svg.appendChild(defs);

                // horizontal grid lines + y labels (always whole numbers)
                for (let t = 0; t <= 4; t++) {
                    const v = t * step;
                    const y = yAt(v);
                    svg.appendChild(svgEl('line', { x1: pad.l, x2: W - pad.r, y1: y, y2: y, stroke: cGrid, 'stroke-width': 1 }));
                    const lab = svgEl('text', { x: pad.l - 8, y: y + 4, 'text-anchor': 'end', 'font-size': 11, fill: cLabel });
                    lab.textContent = v;
                    svg.appendChild(lab);
                }

                // x labels, counted back from the most recent day
                const every = Math.max(1, Math.ceil(n / 6));
                for (let i = n - 1; i >= 0; i -= every) {
                    const anchor = i === n - 1 ? 'end' : (i === 0 ? 'start' : 'middle');
                    const lab = svgEl('text', { x: xAt(i), y: H - 6, 'text-anchor': anchor, 'font-size': 11, fill: cLabel });
                    lab.textContent = labels[i];
                    svg.appendChild(lab);
                }

                // smooth line + filled area
                let line = 'M ' + xAt(0) + ' ' + yAt(counts[0]);
                for (let i = 1; i < n; i++) {
                    const x0 = xAt(i - 1);
                    const y0 = yAt(counts[i - 1]);
                    const x1 = xAt(i);
                    const y1 = yAt(counts[i]);
                    const xm = (x0 + x1) / 2;
                    line += ' C ' + xm + ' ' + y0 + ', ' + xm + ' ' + y1 + ', ' + x1 + ' ' + y1;
                }
                const area = line + ' L ' + xAt(n - 1) + ' ' + base + ' L ' + xAt(0) + ' ' + base + ' Z';

                svg.appendChild(svgEl('path', { d: area, fill: 'url(#admActGrad)' }));
                svg.appendChild(svgEl('path', {
                    d: line,
                    fill: 'none',
                    stroke: cTeal,
                    'stroke-width': 2.5,
                    'stroke-linecap': 'round',
                    'stroke-linejoin': 'round'
                }));

                // dots (every day on short ranges, only busy days on long ones)
                counts.forEach(function (v, i) {
                    if (v > 0 || n <= 14) {
                        svg.appendChild(svgEl('circle', { cx: xAt(i), cy: yAt(v), r: 3.5, fill: cDot, stroke: cTeal, 'stroke-width': 2 }));
                    }
                });

                // hover guide + tooltip
                const guide = svgEl('line', { y1: pad.t, y2: base, stroke: cTeal, 'stroke-width': 1, 'stroke-dasharray': '3 3', opacity: 0 });
                const dot = svgEl('circle', { r: 5.5, fill: cTeal, stroke: cDot, 'stroke-width': 2, opacity: 0 });
                svg.appendChild(guide);
                svg.appendChild(dot);

                const hit = svgEl('rect', { x: pad.l, y: pad.t, width: iw, height: ih, fill: 'transparent' });

                function show(evt) {
                    const rect = svg.getBoundingClientRect();
                    const px = evt.clientX - rect.left;
                    let i = n === 1 ? 0 : Math.round(((px - pad.l) / iw) * (n - 1));
                    i = Math.max(0, Math.min(n - 1, i));

                    const x = xAt(i);
                    const y = yAt(counts[i]);

                    guide.setAttribute('x1', x);
                    guide.setAttribute('x2', x);
                    guide.setAttribute('opacity', 1);
                    dot.setAttribute('cx', x);
                    dot.setAttribute('cy', y);
                    dot.setAttribute('opacity', 1);

                    tip.textContent = labels[i] + ': ' + counts[i] + (counts[i] === 1 ? ' change' : ' changes');
                    tip.style.left = Math.min(Math.max(x, 64), W - 64) + 'px';
                    tip.style.top = Math.max(y - 12, 40) + 'px';
                    tip.style.opacity = 1;
                }

                function hide() {
                    guide.setAttribute('opacity', 0);
                    dot.setAttribute('opacity', 0);
                    tip.style.opacity = 0;
                }

                hit.addEventListener('pointermove', show);
                hit.addEventListener('pointerdown', show);
                hit.addEventListener('pointerleave', hide);
                svg.appendChild(hit);

                box.insertBefore(svg, tip);
            }

            // ---------- trend badge: last 7 days vs the 7 days before (uses the full 30 days of data) ----------
            function renderTrend() {
                const el = document.getElementById('adminActTrend');
                if (!el) return;

                const last7 = sum(allCounts.slice(-7));
                const prev7 = sum(allCounts.slice(-14, -7));

                el.className = 'adm-trend';
                el.textContent = '';

                if (last7 === 0 && prev7 === 0) return;

                if (prev7 === 0) {
                    el.textContent = '\u25B2 New activity this week';
                    el.classList.add('is-up');
                    return;
                }

                const pct = Math.round(((last7 - prev7) / prev7) * 100);

                if (pct === 0) {
                    el.textContent = 'Same as the previous 7 days';
                } else if (pct > 0) {
                    el.textContent = '\u25B2 ' + pct + '% vs previous 7 days';
                    el.classList.add('is-up');
                } else {
                    el.textContent = '\u25BC ' + Math.abs(pct) + '% vs previous 7 days';
                    el.classList.add('is-down');
                }
            }

            function renderHeat(labels, counts) {
                const el = document.getElementById('adminHeat');
                if (!el) return;
                const max = Math.max.apply(null, counts.concat([0]));
                el.innerHTML = '';
                counts.forEach(function (v, i) {
                    const cell = document.createElement('span');
                    const lvl = (v === 0 || max === 0) ? 0 : Math.min(4, Math.ceil((v / max) * 4));
                    cell.className = 'adm-heat-cell l' + lvl;
                    cell.title = labels[i] + ': ' + v + (v === 1 ? ' change' : ' changes');
                    el.appendChild(cell);
                });
            }

            // ---------- tiles + chart for the selected range ----------
            function render() {
                const labels = allLabels.slice(-range);
                const counts = allCounts.slice(-range);

                const total = sum(counts);
                const max = counts.length ? Math.max.apply(null, counts) : 0;

                setText('adminActTotal', total);
                setText('adminActRange', 'last ' + range + ' days');
                setText('adminActAvg', (total / range).toFixed(1));
                setText('adminActBusiest', max > 0 ? labels[counts.lastIndexOf(max)] : '\u2014');
                setText('adminActBusiestSub', max > 0 ? max + (max === 1 ? ' change' : ' changes') : 'no activity yet');

                // a drawing problem must never stop the toggle or the tiles from working
                try {
                    renderHeat(labels, counts);
                    drawChart(labels, counts);
                } catch (err) {
                    if (window.console) console.error('Activity chart failed to draw:', err);
                }
            }

            // toggle is wired first, so it works whatever happens to the chart
            document.querySelectorAll('.adm-range-btn').forEach(function (btn) {
                btn.addEventListener('click', function () {
                    document.querySelectorAll('.adm-range-btn').forEach(function (b) { b.classList.remove('is-active'); });
                    btn.classList.add('is-active');
                    range = parseInt(btn.getAttribute('data-range'), 10) || 30;
                    render();
                });
            });

            renderTrend();
            render();

            let resizeTimer;
            window.addEventListener('resize', function () {
                clearTimeout(resizeTimer);
                resizeTimer = setTimeout(render, 150);
            });

            // redraw the chart when the theme is switched (light <-> dark)
            new MutationObserver(function () { render(); }).observe(
                document.documentElement,
                { attributes: true, attributeFilter: ['class'] }
            );
        })();
    </script>

    <script>
(function () {
    // ---------- quick action search ----------
    var search = document.getElementById('admActionSearch');
    var emptyMsg = document.getElementById('admActionEmpty');
    if (search) {
        search.addEventListener('input', function () {
            var q = search.value.trim().toLowerCase(), shown = 0;
            document.querySelectorAll('#admActions .adm-action').forEach(function (card) {
                var hit = card.textContent.toLowerCase().indexOf(q) !== -1;
                card.style.display = hit ? '' : 'none';
                if (hit) shown++;
            });
            if (emptyMsg) emptyMsg.hidden = shown !== 0;
        });
    }

    // ---------- feed filter chips ----------
    document.querySelectorAll('.adm-chip[data-kind]').forEach(function (chip) {
        chip.addEventListener('click', function () {
            document.querySelectorAll('.adm-chip[data-kind]').forEach(function (c) { c.classList.remove('is-active'); });
            chip.classList.add('is-active');
            var kind = chip.getAttribute('data-kind');
            document.querySelectorAll('.adm-feed-item').forEach(function (li) {
                li.style.display = (kind === 'all' || li.getAttribute('data-kind') === kind) ? '' : 'none';
            });
        });
    });

    // ---------- CSV export: visible rows only, formula-safe ----------
    var exp = document.getElementById('admExport');
    if (exp) exp.addEventListener('click', function () {
        var cell = function (t) {
            t = String(t || '').replace(/\s+/g, ' ').trim();
           if (/^[=+\-@@\t\r]/.test(t)) t = "'" + t;   // neutralise Excel formulas
            return '"' + t.replace(/"/g, '""') + '"';
        };
        var rows = [['Action', 'Table', 'Details', 'User and time'].map(cell).join(',')];
        document.querySelectorAll('.adm-feed-item').forEach(function (li) {
            if (li.style.display === 'none') return;
            rows.push([
                li.querySelector('.adm-feed-badge'),
                li.querySelector('strong'),
                li.querySelector('.adm-feed-text span'),
                li.querySelector('small')
            ].map(function (el) { return cell(el ? el.textContent : ''); }).join(','));
        });
        var blob = new Blob(['\uFEFF' + rows.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
        var a = document.createElement('a');
        a.href = URL.createObjectURL(blob);
        a.download = 'recent-changes-' + new Date().toISOString().slice(0, 10) + '.csv';
        document.body.appendChild(a); a.click(); document.body.removeChild(a);
        URL.revokeObjectURL(a.href);
    });
})();
</script>

    <style>

