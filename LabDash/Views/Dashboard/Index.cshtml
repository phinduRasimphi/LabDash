        .adm-action-disabled {
            cursor: not-allowed;
            opacity: .68;
            filter: grayscale(.15);
        }

        .adm-action-disabled::before {
            background: linear-gradient(90deg, var(--adm-ink-faint), var(--adm-line-strong));
        }

        .adm-action-disabled:hover {
            transform: none;
            box-shadow: var(--adm-shadow-sm);
        }

        .adm-action-disabled .adm-action-icon {
            background: var(--adm-line);
            color: var(--adm-ink-faint);
        }

        .adm-action-disabled .adm-action-go { opacity: .3; }

        .adm-soon-badge {
            position: absolute;
            top: 16px;
            right: 16px;
            background: var(--adm-gold-dim);
            color: var(--adm-gold);
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .03em;
            text-transform: uppercase;
            padding: 4px 10px;
            border-radius: 999px;
        }

        /* ============ SPLIT PANELS ============ */
        .adm-split {
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 18px;
        }

        .adm-panel {
            background: var(--adm-raised);
            border-radius: var(--adm-radius);
            box-shadow: var(--adm-shadow);
            overflow: hidden;
        }

        .adm-panel-head {
            display: flex;
            justify-content: space-between;
            align-items: center;
            padding: 18px 26px;
            border-bottom: 1px solid var(--adm-line);
        }

        .adm-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            color: var(--adm-ink);
            display: flex;
            align-items: center;
            gap: 10px;
        }

        .adm-panel-head span:first-child i { color: var(--adm-teal); }

        .adm-panel-tag {
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 11.5px;
            background: var(--adm-teal-dim);
            color: var(--adm-teal-deep);
            padding: 6px 13px;
            border-radius: 999px;
        }

        .adm-panel-foot {
            display: block;
            padding: 14px 26px;
            border-top: 1px solid var(--adm-line);
            color: var(--adm-teal-deep);
            font-weight: 600;
            font-size: 13.5px;
            text-decoration: none;
        }

        .adm-panel-foot:hover { text-decoration: underline; }

        /* ============ EMPTY STATE ============ */
        .adm-empty-state {
            padding: 48px 30px;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 10px;
        }

        .adm-empty-icon {
            width: 58px;
            height: 58px;
            border-radius: 50%;
            background: var(--adm-teal-dim);
            color: var(--adm-teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 22px;
            margin-bottom: 4px;
        }

        .adm-empty-state h5 {
            margin: 0;
            font-size: 14.5px;
            font-weight: 700;
            color: var(--adm-ink);
        }

        .adm-empty-state p {
            margin: 0;
            max-width: 340px;
            font-size: 13px;
            color: var(--adm-ink-soft);
            line-height: 1.6;
        }

        /* ============ RECENT CHANGES FEED ============ */
        .adm-feed { list-style: none; margin: 0; padding: 6px 26px 10px; }
        .adm-feed-item { display: flex; gap: 14px; align-items: flex-start; padding: 14px 0; border-bottom: 1px solid var(--adm-line); }
        .adm-feed-item:last-child { border-bottom: none; }
        .adm-feed-badge { flex-shrink: 0; min-width: 96px; text-align: center; font-size: 11px; font-weight: 700; text-transform: uppercase; letter-spacing: .03em; padding: 5px 10px; border-radius: 999px; background: var(--adm-line); color: var(--adm-ink-soft); }
        .adm-feed-badge.is-created { background: var(--adm-teal-dim); color: var(--adm-teal-deep); }
        .adm-feed-badge.is-updated { background: var(--adm-blue-dim); color: var(--adm-blue); }
        .adm-feed-badge.is-removed { background: var(--adm-red-dim); color: var(--adm-red); }
        .adm-feed-badge.is-restored { background: var(--adm-gold-dim); color: var(--adm-gold); }
        .adm-feed-text { display: flex; flex-direction: column; gap: 2px; min-width: 0; font-size: 13px; }
        .adm-feed-text strong { font-size: 13.5px; }
        .adm-feed-text span { color: var(--adm-ink-soft); overflow-wrap: anywhere; }
        .adm-feed-text small { color: var(--adm-ink-faint); font-size: 12px; }

        /* ============ ACTIVITY PANEL ============ */
        .adm-range {
            display: inline-flex;
            gap: 2px;
            padding: 3px;
            border-radius: 999px;
            background: var(--adm-teal-dim);
        }

        .adm-range-btn {
            border: 0;
            background: transparent;
            font-family: 'Inter', sans-serif;
            font-weight: 600;
            font-size: 11.5px;
            color: var(--adm-teal-deep);
            padding: 6px 12px;
            border-radius: 999px;
            cursor: pointer;
            transition: background .15s, color .15s;
        }

        .adm-range-btn:hover { background: rgba(14, 140, 127, .12); }
        .adm-range-btn.is-active { background: var(--adm-teal); color: #fff; }

        .adm-activity-body { padding: 22px 26px 26px; }

        .adm-kpis {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 12px;
            margin-bottom: 20px;
        }

        .adm-kpi {
            display: flex;
            flex-direction: column;
            gap: 2px;
            min-width: 0;
            padding: 14px 16px;
            border-radius: var(--adm-radius-sm);
            background: var(--adm-paper);
        }

        .adm-kpi small {
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: var(--adm-ink-faint);
        }

        .adm-kpi strong {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            line-height: 1.25;
            color: var(--adm-ink);
        }

        .adm-kpi em { font-style: normal; font-size: 12px; color: var(--adm-ink-soft); }

        .adm-chart-row {
            display: flex;
            justify-content: space-between;
            align-items: center;
            flex-wrap: wrap;
            gap: 10px;
            margin-bottom: 10px;
        }

        .adm-chart-cap { font-size: 12.5px; font-weight: 600; color: var(--adm-ink-soft); }

        .adm-trend {
            font-size: 11.5px;
            font-weight: 700;
            padding: 5px 11px;
            border-radius: 999px;
            background: var(--adm-line);
            color: var(--adm-ink-soft);
        }

        .adm-trend:empty { display: none; }
        .adm-trend.is-up { background: var(--adm-teal-dim); color: var(--adm-teal-deep); }
        .adm-trend.is-down { background: var(--adm-blue-dim); color: var(--adm-blue); }

        .adm-activity-canvas { position: relative; height: 210px; }

        .adm-svgchart { position: relative; width: 100%; height: 210px; }
        .adm-svgchart svg { display: block; touch-action: pan-y; }

        .adm-svgtip {
            position: absolute;
            z-index: 2;
            transform: translate(-50%, -100%);
            padding: 7px 11px;
            border-radius: 8px;
            background: #102C27;
            color: #fff;
            font-size: 12px;
            font-weight: 600;
            white-space: nowrap;
            pointer-events: none;
            opacity: 0;
            transition: opacity .12s;
        }

        .adm-activity-hint {
            position: absolute;
            left: 50%;
            top: 44%;
            transform: translate(-50%, -50%);
            display: flex;
            align-items: center;
            gap: 8px;
            max-width: 90%;
            padding: 9px 16px;
            border: 1px dashed var(--adm-line-strong);
            border-radius: 999px;
            background: rgba(255, 255, 255, .92);
            color: var(--adm-ink-soft);
            font-size: 12.5px;
            text-align: center;
            pointer-events: none;
        }

        .adm-activity-hint i { color: var(--adm-gold); }

        /* "What changed" breakdown */
        .adm-mix {
            margin-top: 22px;
            padding-top: 18px;
            border-top: 1px solid var(--adm-line);
        }

        .adm-mix-head {
            display: flex;
            justify-content: space-between;
            align-items: baseline;
            margin-bottom: 10px;
        }

        .adm-mix-head span { font-size: 13px; font-weight: 700; }
        .adm-mix-head small { color: var(--adm-ink-faint); font-size: 12px; }

        .adm-mix-bar {
            display: flex;
            height: 10px;
            border-radius: 999px;
            overflow: hidden;
            background: var(--adm-line);
        }

        .adm-mix-seg { flex-basis: 0; min-width: 0; }
        .adm-mix-seg.is-created { background: var(--adm-teal); }
        .adm-mix-seg.is-updated { background: var(--adm-blue); }
        .adm-mix-seg.is-removed { background: var(--adm-red); }
        .adm-mix-seg.is-restored { background: var(--adm-gold); }

        .adm-mix-legend {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 8px 18px;
            margin-top: 12px;
        }

        .adm-mix-legend div {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: var(--adm-ink-soft);
        }

        .adm-mix-legend strong { margin-left: auto; color: var(--adm-ink); }

        .adm-dot { width: 9px; height: 9px; border-radius: 50%; flex-shrink: 0; }
        .adm-dot.is-created { background: var(--adm-teal); }
        .adm-dot.is-updated { background: var(--adm-blue); }
        .adm-dot.is-removed { background: var(--adm-red); }
        .adm-dot.is-restored { background: var(--adm-gold); }


        /* ============ AT A GLANCE ============ */
        .adm-glance { display: grid; grid-template-columns: repeat(4, 1fr); gap: 18px; margin-bottom: 28px; }
        .adm-glance-card { background: var(--adm-raised); border-radius: var(--adm-radius); box-shadow: var(--adm-shadow-sm); padding: 18px 22px; display: flex; flex-direction: column; gap: 2px; min-width: 0; }
        .adm-glance-card small { font-size: 11px; font-weight: 600; letter-spacing: .04em; text-transform: uppercase; color: var(--adm-ink-faint); }
        .adm-glance-card strong { font-family: 'Poppins', sans-serif; font-size: 26px; line-height: 1.3; color: var(--adm-ink); }
        .adm-glance-card strong.is-sm { font-size: 17px; line-height: 2; }
        .adm-glance-card em { font-style: normal; font-size: 12px; color: var(--adm-ink-soft); }
        .adm-health { flex-direction: row; align-items: center; gap: 16px; }
        .adm-health-ring { --pct: 0; width: 64px; height: 64px; border-radius: 50%; flex-shrink: 0; position: relative; display: flex; align-items: center; justify-content: center; background: conic-gradient(var(--adm-teal) calc(var(--pct) * 1%), var(--adm-line) 0); }
        .adm-health-ring::before { content: ""; position: absolute; inset: 7px; border-radius: 50%; background: var(--adm-raised); }
        .adm-health-ring span { position: relative; font: 700 14px 'Poppins', sans-serif; color: var(--adm-teal-deep); }
        .adm-health.is-warn .adm-health-ring { background: conic-gradient(var(--adm-orange) calc(var(--pct) * 1%), var(--adm-line) 0); }
        .adm-health.is-warn .adm-health-ring span { color: var(--adm-orange); }

        /* ============ BREAKDOWN PANELS ============ */
        .adm-bars-body { padding: 20px 26px 24px; }
        .adm-legend-1 { grid-template-columns: 1fr; }
        .adm-mix-seg.is-purple { background: var(--adm-purple); }
        .adm-dot.is-purple { background: var(--adm-purple); }
        .adm-rank { margin-bottom: 16px; }
        .adm-rank:last-child { margin-bottom: 0; }
        .adm-rank-label { display: flex; justify-content: space-between; gap: 10px; font-size: 13px; margin-bottom: 7px; color: var(--adm-ink-soft); }
        .adm-rank-label span { overflow-wrap: anywhere; }
        .adm-rank-label strong { color: var(--adm-ink); }
        .adm-rank-bar { height: 10px; border-radius: 999px; background: var(--adm-line); overflow: hidden; }
        .adm-rank-bar span { display: block; height: 100%; border-radius: 999px; background: var(--adm-teal); transition: width .6s ease; }
        .adm-rank-bar span.is-blue { background: var(--adm-blue); }
        .adm-noresult { margin: 0; text-align: center; color: var(--adm-ink-soft); font-size: 13px; padding: 10px 0; }

        /* ============ SEARCH ============ */
        .adm-search { position: relative; }
        .adm-search i { position: absolute; left: 14px; top: 50%; transform: translateY(-50%); color: var(--adm-ink-faint); font-size: 13px; }
        .adm-search input { width: 240px; max-width: 100%; height: 40px; padding: 0 14px 0 36px; border-radius: 999px; border: 1px solid var(--adm-line-strong); background: var(--adm-raised); color: var(--adm-ink); font: 500 13px 'Inter', sans-serif; outline: none; }
        .adm-search input:focus { border-color: var(--adm-teal); box-shadow: 0 0 0 3px rgba(14, 140, 127, .12); }

        /* ============ FEED CHIPS ============ */
        .adm-chips { display: flex; gap: 8px; flex-wrap: wrap; padding: 14px 26px; border-bottom: 1px solid var(--adm-line); }
        .adm-chip { border: 1px solid var(--adm-line); background: var(--adm-raised); color: var(--adm-ink-soft); font: 600 12px 'Inter', sans-serif; padding: 6px 13px; border-radius: 999px; cursor: pointer; transition: background .15s, color .15s; }
        .adm-chip:hover { background: var(--adm-teal-dim); }
        .adm-chip.is-active { background: var(--adm-teal); border-color: var(--adm-teal); color: #fff; }
        .adm-chip-export { margin-left: auto; color: var(--adm-teal-deep); }
        .adm-chip-export i { margin-right: 5px; }

        /* ============ HEAT STRIP ============ */
        .adm-heat-wrap { margin-top: 20px; }
        .adm-heat { display: flex; gap: 3px; margin-top: 8px; }
        .adm-heat-cell { flex: 1; min-width: 4px; height: 22px; border-radius: 4px; background: var(--adm-line); display: inline-block; }
        .adm-heat-cell.l1 { background: #BFE5DF; }
        .adm-heat-cell.l2 { background: #7FCBC1; }
        .adm-heat-cell.l3 { background: #3FAE9F; }
        .adm-heat-cell.l4 { background: var(--adm-teal-deep); }
        .adm-heat-legend { display: flex; align-items: center; justify-content: flex-end; gap: 4px; margin-top: 8px; font-size: 11px; color: var(--adm-ink-faint); }
        .adm-heat-legend .adm-heat-cell { flex: none; width: 14px; height: 14px; border-radius: 3px; }

        /* ============ CHECKLIST ============ */
        .adm-check-head { padding: 18px 26px; border-bottom: 1px solid var(--adm-line); display: flex; flex-direction: column; gap: 10px; font-size: 13px; font-weight: 600; color: var(--adm-ink); }
        .adm-check { list-style: none; margin: 0; padding: 8px 14px 12px; }
        .adm-check a { display: flex; align-items: center; gap: 13px; padding: 12px; border-radius: 14px; color: var(--adm-ink); text-decoration: none; font-size: 13.5px; font-weight: 600; transition: background .15s; }
        .adm-check a:hover { background: var(--adm-paper); color: var(--adm-ink); text-decoration: none; }
        .adm-check-mark { width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--adm-line); display: flex; align-items: center; justify-content: center; font-size: 12px; color: var(--adm-teal); flex-shrink: 0; }
        .adm-check a.is-done .adm-check-mark { background: var(--adm-teal); border-color: var(--adm-teal); color: #fff; }
        .adm-check a.is-done span:last-child { color: var(--adm-ink-soft); text-decoration: line-through; }

        @@media (max-width: 1100px) {
            .adm-glance { grid-template-columns: repeat(2, 1fr); }
        }
        @@media (max-width: 640px) {
            .adm-glance { grid-template-columns: 1fr; }
            .adm-search { width: 100%; }
            .adm-search input { width: 100%; }
            .adm-chips { padding: 12px 16px; }
        }
        .adm-mini-link { display: inline-block; margin-top: 8px; font-size: 12.5px; font-weight: 600; color: var(--adm-teal-deep); text-decoration: none; }
        .adm-mini-link:hover { text-decoration: underline; }
        .adm-rank-label i { color: var(--adm-teal); margin-right: 6px; }

        .adm-footer { margin-top: 50px; text-align: center; }

        .adm-footer hr {
            border: none;
            border-top: 1px solid var(--adm-line);
            margin-bottom: 22px;
        }

        .adm-footer-content {
            display: flex;
            justify-content: center;
            align-items: center;
            flex-wrap: wrap;
            gap: 12px;
            color: var(--adm-ink-faint);
            font-size: 13px;
        }

        .adm-footer-content i { color: var(--adm-teal); }
        .adm-footer-divider { color: var(--adm-line-strong); }

        /* ============ RESPONSIVE ============ */
        @@media (max-width: 1100px) {
            .adm-grid-4 { grid-template-columns: repeat(2, 1fr); }
            .adm-grid-3 { grid-template-columns: repeat(2, 1fr); }
            .adm-split { grid-template-columns: 1fr; }
        }

        @@media (max-width: 900px) {
            .adm-banner { flex-direction: column; align-items: flex-start; gap: 24px; }

            .adm-clock {
                width: 100%;
                border-left: none;
                border-top: 1px solid rgba(255,255,255,.28);
                padding-left: 0;
                padding-top: 18px;
            }

            .adm-banner-left { flex-direction: column; text-align: center; width: 100%; }
        }

        @@media (max-width: 640px) {
            .adm-wrap { padding: 20px 16px 50px; }
            .adm-grid-4, .adm-grid-3, .adm-grid-2 { grid-template-columns: 1fr; }
            .adm-kpis { grid-template-columns: 1fr; }
            .adm-activity-body { padding: 18px 18px 22px; }

            .adm-status-strip {
                flex-direction: column;
                align-items: flex-start;
                gap: 10px;
            }
        }


        /* ==========================================================
           DARK MODE (html.rq-dark, same switch as the rest of the app)
           The shared dark rules force "color: inherit" on span / p / li / small / th / td
           and restyle anything with "panel", "card" or "chip" in its class name,
           so the colour rules below use !important where they have to win.
        ========================================================== */

        /* 1. Re-point the page's variables at the shared dark palette */
        html.rq-dark {
            --adm-paper: #141C18;
            --adm-raised: #172019;
            --adm-ink: #E8EEEB;
            --adm-ink-soft: #A5B0AA;
            --adm-ink-faint: #7F8B85;
            --adm-line: #26302B;
            --adm-line-strong: #34403A;
            --adm-teal: #2CC4BA;
            --adm-teal-deep: #5ED0C4;
            --adm-teal-dim: #12302D;
            --adm-teal-grad-start: #0F7F74;
            --adm-teal-grad-end: #0A3A35;
            --adm-blue: #6CB0E8;
            --adm-blue-dim: #14283A;
            --adm-purple: #B39DEB;
            --adm-purple-dim: #2A2142;
            --adm-red: #E1736B;
            --adm-red-dim: #3A1B18;
            --adm-orange: #E39A55;
            --adm-orange-dim: #33200F;
            --adm-gold: #E0B84A;
            --adm-gold-dim: #33280F;
            --adm-shadow: 0 6px 24px rgba(0, 0, 0, .45);
            --adm-shadow-sm: 0 3px 10px rgba(0, 0, 0, .3);
        }

        /* 2. Banner text (the shared h1 / p / small rules would otherwise grey it) */
        html.rq-dark .adm-wrap .adm-banner-text h1 { color: #fff !important; }
        html.rq-dark .adm-wrap .adm-banner-text h1 span { color: #E9FFFB !important; }
        html.rq-dark .adm-wrap .adm-banner-text p { color: rgba(255, 255, 255, .85) !important; }
        html.rq-dark .adm-wrap .adm-clock small { color: #DFF9F8 !important; }

        /* 3. Panel tag + panel footer link (the shared catch-all restyles anything named "panel") */
        html.rq-dark .adm-wrap .adm-panel .adm-panel-head .adm-panel-tag {
            background-color: var(--adm-teal-dim) !important;
            color: var(--adm-teal-deep) !important;
            box-shadow: none !important;
            border-color: transparent !important;
        }

        html.rq-dark .adm-wrap .adm-split .adm-panel a.adm-panel-foot {
            background-color: transparent !important;
            color: var(--adm-teal-deep) !important;
            box-shadow: none !important;
        }

        /* 4. Text colours that the shared "color: inherit" rule would flatten */
        html.rq-dark .adm-wrap .adm-section-head p,
        html.rq-dark .adm-wrap .adm-status-list li,
        html.rq-dark .adm-wrap .adm-action p,
        html.rq-dark .adm-wrap .adm-empty-state p,
        html.rq-dark .adm-wrap .adm-feed-text span,
        html.rq-dark .adm-wrap .adm-chart-cap,
        html.rq-dark .adm-wrap .adm-activity-hint span,
        html.rq-dark .adm-wrap .adm-rank-label span,
        html.rq-dark .adm-wrap .adm-noresult,
        html.rq-dark .adm-wrap .adm-check a.is-done span:last-child {
            color: var(--adm-ink-soft) !important;
        }

        html.rq-dark .adm-wrap .adm-stat small,
        html.rq-dark .adm-wrap .adm-glance-card small,
        html.rq-dark .adm-wrap .adm-kpi small,
        html.rq-dark .adm-wrap .adm-feed-text small,
        html.rq-dark .adm-wrap .adm-mix-head small,
        html.rq-dark .adm-wrap .adm-heat-legend span,
        html.rq-dark .adm-wrap .adm-footer-content span {
            color: var(--adm-ink-faint) !important;
        }

        html.rq-dark .adm-wrap .adm-footer-content .adm-footer-divider {
            color: var(--adm-line-strong) !important;
        }

        html.rq-dark .adm-wrap .adm-mix-head span {
            color: var(--adm-ink) !important;
        }

        html.rq-dark .adm-wrap .adm-action .adm-action-go {
            color: var(--adm-teal) !important;
        }

        html.rq-dark .adm-wrap .adm-health-ring span {
            color: var(--adm-teal-deep) !important;
        }

        html.rq-dark .adm-wrap .adm-health.is-warn .adm-health-ring span {
            color: var(--adm-orange) !important;
        }

        /* trend badge */
        html.rq-dark .adm-wrap .adm-chart-row .adm-trend {
            background: var(--adm-line);
            color: var(--adm-ink-soft) !important;
        }

        html.rq-dark .adm-wrap .adm-chart-row .adm-trend.is-up {
            background: var(--adm-teal-dim);
            color: var(--adm-teal-deep) !important;
        }

        html.rq-dark .adm-wrap .adm-chart-row .adm-trend.is-down {
            background: var(--adm-blue-dim);
            color: var(--adm-blue) !important;
        }

        /* setup checklist marks */
        html.rq-dark .adm-wrap .adm-check a .adm-check-mark {
            color: var(--adm-teal) !important;
        }

        html.rq-dark .adm-wrap .adm-check a.is-done .adm-check-mark {
            background: #0F7F74;
