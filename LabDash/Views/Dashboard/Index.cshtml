        // ---------- server-side helpers + data (plain C#, no markup yet) ----------
        // Flip each to true once the matching controller action + view exists.
        // While false, the button is disabled (or opens the preview drawer) instead of leading to a 404.
        const bool summaryPageReady = true;    // Patient/RequestDetails
        const bool resultsPageReady = true;    // Patient/Results (already exists)
        const bool reportPageReady = true;     // Patient/DownloadResultsPdf (already exists)

        var profile = Model.PatientProfile;
        var fullName = $"{profile.Name} {profile.Surname}".Trim();
        var recent = Model.PatientRecentRequests != null ? Model.PatientRecentRequests.Take(5).ToList() : null;
        int totalReq = Model.PatientTotalRequests;
        int otherReq = Math.Max(0, totalReq - Model.PatientPendingRequests - Model.PatientInProgressRequests - Model.PatientResultsReady);

        // StatusKey is still used for URGENCY (stat / urgent / routine).
        string StatusKey(string css) => (css ?? "").Trim().ToLowerInvariant();

        // The request STAGE always comes from the status text, using the one shared rule
        // (same rule as Patient/RequestDetails), never from the CSS class.
        string StageKey(string status) => LabDash.Helper.RequestStage.KeyOf(status);

        int StepOf(string key) => key switch { "submitted" => 1, "inprogress" => 2, "completed" => 3, "released" => 4, "cancelled" => 0, _ => 1 };
        int Pct(int v) => totalReq == 0 ? 0 : (int)Math.Round(v * 100.0 / totalReq);
        string TimeInSystem(DateTime d)
        {
            var span = DateTime.Now - d;
            if (span.TotalMinutes < 1) return "Just now";
            if (span.TotalHours < 1) return $"{(int)span.TotalMinutes} min";
            if (span.TotalDays < 1) return $"{(int)span.TotalHours} h";
            var days = (int)span.TotalDays;
            return days == 1 ? "1 day" : $"{days} days";
        }
        string UrgencyText(string css) => StatusKey(css) switch
        {
            "stat" => "STAT means the laboratory treats this as an emergency and processes it before everything else.",
            "urgent" => "Urgent requests are processed ahead of routine work, usually within the same day.",
            _ => "Routine requests are processed in the normal order the laboratory receives them."
        };
        string NextText(string key) => key switch
        {
            "submitted" => "The laboratory will receive your sample and a technician will pick up the test.",
            "inprogress" => "A technician is analysing your sample. Results are verified before they are released.",
            "completed" => "Testing is complete. Your results are being checked and will be released shortly.",
            "released" => "Your results are released. You can view them or download the report.",
            "cancelled" => "This request was cancelled, so no further results will be added.",
            _ => "Open the request for the latest status."
        };
        int StatusCount(string key) => recent == null ? 0 : recent.Count(r => StageKey(r.Status) == key);
        int UrgencyCount(string key) => recent == null ? 0 : recent.Count(r => StatusKey(r.UrgencyCssClass) == key);

        var missing = new List<string>();
        if (string.IsNullOrWhiteSpace(profile.Name)) missing.Add("Name");
        if (string.IsNullOrWhiteSpace(profile.Surname)) missing.Add("Surname");
        if (string.IsNullOrWhiteSpace(profile.IDNumber?.ToString())) missing.Add("ID number");
        if (string.IsNullOrWhiteSpace(profile.Cellphone?.ToString())) missing.Add("Contact number");
        if (string.IsNullOrWhiteSpace(profile.Email?.ToString())) missing.Add("Email");
        int completePct = (int)Math.Round((5 - missing.Count) * 100.0 / 5);
        bool hasContact = !missing.Contains("Contact number");

        var dataJson = System.Text.Json.JsonSerializer.Serialize(new
        {
            abnormal = Model.PatientAbnormalCount,
            ready = Model.PatientResultsReady,
            inprogress = Model.PatientInProgressRequests,
            total = totalReq,
            chart = new[] { Model.PatientPendingRequests, Model.PatientInProgressRequests, Model.PatientResultsReady, otherReq },
            abnormalUrl = Url.Action("Results", "Patient", new { abnormal = true }),
            readyUrl = Url.Action("Requests", "Patient", new { status = "ready" }),
            progressUrl = Url.Action("Requests", "Patient", new { status = "inprogress" }),
            requests = recent == null
                ? new List<object>()
                : recent.Take(3).Select(r => (object)new
                {
                    id = r.RequestID.ToString(),
                    key = StageKey(r.Status),
                    status = r.Status,
                    date = r.RequestDate.ToString("dd MMM yyyy"),
                    url = Url.Action("RequestDetails", "Patient", new { id = r.RequestID })
                }).ToList()
        });

