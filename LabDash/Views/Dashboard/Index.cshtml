                                                        }
                                                        <button type="button" class="pat-btn" data-preview="@id"><i class="fa-solid fa-up-right-from-square"></i> Full preview</button>
                                                    </div>
                                                </div>
                                            </td>
                                        </tr>
                                    }
                                    <tr class="pat-filter-empty" id="patFilterEmpty" hidden>
