                .pat-stat-icon.c-teal {
                    background: var(--pt-dim);
                    color: var(--pt)
                }

                .pat-stat-icon.c-blue {
                    background: var(--bl-dim);
                    color: var(--bl)
                }

                .pat-stat-icon.c-purple {
                    background: var(--pr-dim);
                    color: var(--pr)
                }

                .pat-stat-icon.c-orange {
                    background: var(--or-dim);
                    color: var(--or)
                }

            .pat-stat .num {
                font-family: 'Poppins',sans-serif;
                font-size: 27px;
                font-weight: 700
            }

            /* ---------- panels + table ---------- */
            .pat-split {
                display: grid;
                grid-template-columns: 1.2fr 0.8fr;
                gap: 18px;
                align-items: start
            }

            .pat-split-even {
                grid-template-columns: 1fr 1fr
            }

            .pat-panel {
                background: var(--bg);
                border-radius: var(--r);
                box-shadow: var(--sh);
                overflow: hidden
            }

            .pat-panel-head {
                display: flex;
                justify-content: space-between;
                align-items: center;
                padding: 18px 26px;
                border-bottom: 1px solid var(--ln)
            }

                .pat-panel-head span {
                    font-family: 'Poppins',sans-serif;
                    font-weight: 700;
                    font-size: 15.5px;
                    display: flex;
                    align-items: center;
                    gap: 10px
                }

                    .pat-panel-head span i {
                        color: var(--pt)
                    }

            .pat-panel-link {
                color: var(--pt-deep);
                font-weight: 600;
                font-size: 13px;
                text-decoration: none
            }

                .pat-panel-link:hover {
                    text-decoration: underline
                }

            .pat-table-wrap {
                overflow-x: auto
            }

            .pat-table {
                width: 100%;
                border-collapse: collapse
            }

                .pat-table th {
                    background: #F0F7F6;
                    text-align: left;
                    padding: 12px 26px;
                    font-size: 12px;
                    text-transform: uppercase;
                    color: var(--ink-s);
                    border-bottom: 1px solid var(--ln)
                }

                .pat-table td {
                    padding: 14px 26px;
                    border-bottom: 1px solid var(--ln);
                    font-size: 14px
                }

            .pat-table-empty {
                text-align: center;
                color: var(--ink-s);
                padding: 40px 26px !important
            }

            .pat-row {
                cursor: pointer;
                transition: background .15s
            }

                .pat-row:hover {
                    background: #F0F7F6
                }

                .pat-row[aria-expanded="true"] {
                    background: #F0F7F6
                }

            .pat-chev {
                font-size: 10px;
                color: var(--pt);
                margin-right: 8px;
                transition: transform .2s
            }

            .pat-row[aria-expanded="true"] .pat-chev {
                transform: rotate(90deg)
            }

            .pat-chips {
                display: flex;
                gap: 8px;
                flex-wrap: wrap;
                padding: 14px 26px;
                border-bottom: 1px solid var(--ln)
            }

            .pat-chip {
                display: inline-flex;
                align-items: center;
                gap: 7px;
                border: 1px solid var(--ln);
                background: var(--bg);
                color: var(--ink-s);
                font: 600 12px 'Inter',sans-serif;
                padding: 6px 13px;
                border-radius: 999px;
                cursor: pointer;
                transition: background .15s,color .15s,border-color .15s
            }

                .pat-chip b {
                    font-weight: 700;
                    background: #F0F4F8;
                    color: #3C5770;
                    border-radius: 999px;
                    padding: 1px 8px;
                    font-size: 11px
                }

                .pat-chip:hover {
                    background: var(--pt-dim)
                }

                .pat-chip.is-active {
                    background: var(--pt);
                    border-color: var(--pt);
                    color: #fff
                }

                    .pat-chip.is-active b {
                        background: rgba(255,255,255,.22);
                        color: #fff
                    }

            .pat-detail-row > td {
                background: #F7FBFA;
                padding: 0 !important
            }

            .pat-detail {
                padding: 22px 26px 24px
            }

            .pat-track {
                display: flex
            }

            .pat-tstep {
                flex: 1;
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 8px;
                position: relative;
                text-align: center
            }

                .pat-tstep::before {
                    content: "";
                    position: absolute;
                    top: 15px;
                    right: 50%;
                    width: 100%;
                    height: 3px;
                    background: var(--ln);
                    z-index: 0
                }

                .pat-tstep:first-child::before {
                    display: none
                }

                .pat-tstep.done::before, .pat-tstep.current::before {
                    background: var(--pt)
                }

            .pat-tdot {
                position: relative;
                z-index: 1;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                background: var(--bg);
                border: 2px solid var(--ln);
                color: var(--ink-s);
                font: 700 12px 'Inter',sans-serif
            }

            .pat-tstep.done .pat-tdot {
                background: var(--pt);
                border-color: var(--pt);
                color: #fff
            }

            .pat-tstep.current .pat-tdot {
                border-color: var(--pt);
                color: var(--pt-deep);
                box-shadow: 0 0 0 4px var(--pt-dim)
            }

            .pat-tlabel {
                font-size: 11.5px;
                font-weight: 600;
                color: var(--ink-s)
            }

            .pat-tstep.done .pat-tlabel, .pat-tstep.current .pat-tlabel {
                color: var(--ink)
            }

            .pat-facts {
                display: grid;
                grid-template-columns: repeat(4,1fr);
                gap: 12px;
                margin: 20px 0 14px
            }

                .pat-facts > div {
                    display: flex;
                    flex-direction: column;
                    gap: 4px;
                    align-items: flex-start;
                    background: var(--bg);
                    border: 1px solid var(--ln);
                    border-radius: 12px;
                    padding: 11px 13px
                }

                .pat-facts small {
                    font-size: 11px;
                    font-weight: 600;
                    color: var(--ink-s);
                    text-transform: uppercase;
                    letter-spacing: .03em
                }

                .pat-facts strong {
                    font-size: 14px
                }

            .pat-explain {
                display: flex;
                gap: 10px;
                margin: 8px 0;
                font-size: 13px;
                line-height: 1.55;
                color: var(--ink-s)
            }

                .pat-explain i {
                    color: var(--pt);
                    margin-top: 3px
                }

                .pat-explain strong {
                    color: var(--ink)
                }

            .pat-detail-actions {
                display: flex;
                flex-wrap: wrap;
                gap: 10px;
                margin-top: 16px
            }

            .pat-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                border: 1px solid var(--ln);
                background: var(--bg);
                color: var(--pt-deep);
                font: 600 13px 'Inter',sans-serif;
                padding: 9px 16px;
                border-radius: 999px;
                cursor: pointer;
                text-decoration: none;
                transition: background .15s,color .15s,border-color .15s
            }

                .pat-btn:hover {
                    background: var(--pt-dim);
                    color: var(--pt-deep);
                    text-decoration: none
                }

                .pat-btn.primary {
                    background: var(--pt);
                    border-color: var(--pt);
                    color: #fff
                }

                    .pat-btn.primary:hover {
                        background: var(--pt-deep);
                        border-color: var(--pt-deep);
                        color: #fff
                    }

                .pat-btn.is-disabled {
                    opacity: .5;
                    cursor: not-allowed;
                    pointer-events: auto
                }

                    .pat-btn.is-disabled:hover {
                        background: var(--pt);
                        border-color: var(--pt)
                    }

            .pat-urgency {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600
            }

                .pat-urgency.routine {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

                .pat-urgency.urgent {
                    background: var(--or-dim);
                    color: #924E18
                }

                .pat-urgency.stat {
                    background: var(--rd-dim);
                    color: #942F28
                }

            .pat-status {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600
            }

                .pat-status.submitted {
                    background: #F0F4F8;
                    color: #3C5770
                }

                .pat-status.inprogress {
                    background: var(--or-dim);
                    color: #924E18
                }

                .pat-status.completed {
                    background: var(--gn-dim);
                    color: var(--gn)
                }

                .pat-status.released {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

            /* ---------- profile ---------- */
            .pat-complete {
                display: flex;
                align-items: center;
                gap: 18px;
                padding: 20px 26px;
                border-bottom: 1px solid var(--ln)
            }

            .pat-ring {
                --pct: 0;
                width: 72px;
                height: 72px;
                border-radius: 50%;
                flex-shrink: 0;
                background: conic-gradient(var(--pt) calc(var(--pct) * 1%), var(--ln) 0);
                display: flex;
                align-items: center;
                justify-content: center;
                position: relative
            }

                .pat-ring::before {
                    content: "";
                    position: absolute;
                    inset: 8px;
                    border-radius: 50%;
                    background: var(--bg)
                }

                .pat-ring span {
                    position: relative;
                    font: 700 15px 'Poppins',sans-serif;
                    color: var(--pt-deep)
                }

            .pat-complete-text {
                display: flex;
                flex-direction: column;
                gap: 3px;
                min-width: 0
            }

                .pat-complete-text strong {
                    font-size: 14.5px
                }

                .pat-complete-text small {
                    color: var(--ink-s);
                    font-size: 12.5px;
                    line-height: 1.5
                }

            .pat-profile-list {
                padding: 10px 26px 18px
            }

            .pat-profile-row {
                display: flex;
                justify-content: space-between;
                gap: 12px;
                padding: 11px 0;
                border-bottom: 1px solid var(--ln);
                font-size: 13.5px
            }

            .pat-profile-val {
                text-align: right;
                overflow-wrap: anywhere
            }

            .pat-profile-label {
                font-weight: 600;
                color: var(--ink-s)
            }

            /* ---------- quick actions ---------- */
            .pat-action {
                display: flex;
                flex-direction: column;
                text-decoration: none;
                color: inherit;
                background: var(--bg);
                border-radius: var(--r);
                padding: 28px 24px;
                box-shadow: var(--sh-sm);
                position: relative;
                overflow: hidden;
                transition: transform .25s,box-shadow .25s
            }

                .pat-action::before {
                    content: "";
                    position: absolute;
                    top: 0;
                    left: 0;
                    width: 100%;
                    height: 4px;
                    background: linear-gradient(90deg,var(--pt),var(--pt-deep))
                }

                .pat-action:hover {
                    transform: translateY(-6px);
                    box-shadow: var(--sh);
                    text-decoration: none;
                    color: inherit
                }

            .pat-action-icon {
                width: 54px;
                height: 54px;
                margin-bottom: 16px;
                border-radius: 16px;
                background: var(--pt-dim);
                color: var(--pt);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 23px
            }

            .pat-action h5 {
                font-weight: 700;
                margin: 0 0 8px;
                font-size: 15px
            }

            .pat-action p {
                margin: 0;
                color: var(--ink-s);
                font-size: 13px;
                line-height: 1.6
            }

            .pat-action-foot {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 10px;
                margin-top: auto;
                padding-top: 16px;
                min-height: 48px
            }

            .pat-badges {
                display: flex;
                gap: 6px;
                flex-wrap: wrap
            }

            .pat-badge {
                display: inline-block;
                padding: 3px 10px;
                border-radius: 999px;
                font-size: 11.5px;
                font-weight: 600;
                background: #F0F4F8;
                color: #3C5770
            }

                .pat-badge.info {
                    background: var(--bl-dim);
                    color: var(--bl)
                }

                .pat-badge.ok {
                    background: var(--pt-dim);
                    color: var(--pt-deep)
                }

                .pat-badge.warn {
                    background: var(--or-dim);
                    color: #924E18
                }

            .pat-action-go {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                width: 32px;
                height: 32px;
                border-radius: 50%;
                background: var(--pt-dim);
                color: var(--pt);
                margin-left: auto;
                transition: transform .2s,background .2s,color .2s
            }

            .pat-action:hover .pat-action-go {
                transform: translateX(4px);
                background: var(--pt);
                color: #fff
            }

            /* ---------- health insights ---------- */
            .pat-insights {
                display: grid;
                grid-template-columns: repeat(3,1fr);
                gap: 18px;
                align-items: start
            }

            .pat-donut-body {
                padding: 22px 26px 24px
            }

            .pat-donut {
                position: relative;
                height: 190px;
                margin-bottom: 18px
            }

                .pat-donut canvas {
                    max-width: 100%;
                    max-height: 100%
                }

            .pat-donut-center {
                position: absolute;
                inset: 0;
                display: flex;
                flex-direction: column;
                align-items: center;
                justify-content: center;
                pointer-events: none
            }

                .pat-donut-center strong {
                    font: 700 28px 'Poppins',sans-serif
                }

                .pat-donut-center small {
                    color: var(--ink-s);
                    font-size: 12px
                }

            .pat-legend {
                list-style: none;
                margin: 0;
                padding: 0;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 8px 16px
            }

            .pat-legend-2 {
                margin-top: 14px
            }

            .pat-legend li {
                display: flex;
                align-items: center;
                gap: 8px;
                font-size: 12.5px;
                color: var(--ink-s)
            }

            .pat-legend strong {
                margin-left: auto;
                color: var(--ink)
            }

            .pat-dot {
                width: 9px;
                height: 9px;
                border-radius: 50%;
                flex-shrink: 0
            }

            .pat-mini-empty {
                display: flex;
                flex-direction: column;
                align-items: center;
                gap: 10px;
                padding: 32px 26px;
                text-align: center;
                color: var(--ink-s);
                font-size: 13px;
                line-height: 1.55
            }

                .pat-mini-empty i {
                    font-size: 24px;
                    color: var(--pt)
                }

            .pat-timeline {
                list-style: none;
                margin: 0;
                padding: 10px 26px 14px;
                position: relative
            }

                .pat-timeline li {
                    position: relative;
                    padding: 12px 0 12px 26px
                }

                    .pat-timeline li::before {
                        content: "";
                        position: absolute;
                        left: 5px;
                        top: 0;
                        bottom: 0;
                        width: 2px;
                        background: var(--ln)
                    }

                    .pat-timeline li:first-child::before {
                        top: 50%
                    }

                    .pat-timeline li:last-child::before {
                        bottom: 50%
                    }

            .pat-tl-dot {
                position: absolute;
                left: 0;
                top: 18px;
                width: 12px;
                height: 12px;
                border-radius: 50%;
                background: #3C5770;
                border: 2px solid var(--bg);
                box-shadow: 0 0 0 1px var(--ln)
            }

                .pat-tl-dot.inprogress {
                    background: var(--or)
                }

                .pat-tl-dot.completed {
                    background: var(--gn)
                }

                .pat-tl-dot.released {
                    background: var(--pt)
                }

            .pat-timeline a {
                display: flex;
                flex-direction: column;
                gap: 1px;
                color: inherit;
                text-decoration: none;
                font-size: 13px
            }

                .pat-timeline a:hover {
                    text-decoration: none;
                    color: inherit
                }

                    .pat-timeline a:hover strong {
                        color: var(--pt-deep)
                    }

            .pat-timeline strong {
                font-size: 13.5px
            }

            .pat-timeline span {
                color: var(--ink-s)
            }

            .pat-timeline small {
                color: #8FA9A3;
                font-size: 12px
            }

            .pat-steps {
                list-style: none;
                margin: 0;
                padding: 8px 14px 12px
            }

                .pat-steps a {
                    display: flex;
                    align-items: center;
                    gap: 13px;
                    padding: 12px;
                    border-radius: 14px;
                    color: inherit;
                    text-decoration: none;
                    transition: background .15s
                }

                    .pat-steps a:hover {
                        background: #F0F7F6;
                        text-decoration: none;
                        color: inherit
                    }

            .pat-check {
                width: 34px;
                height: 34px;
                border-radius: 50%;
                border: 2px solid var(--ln);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 13px;
                color: var(--pt);
                flex-shrink: 0
            }

            .pat-steps .is-done .pat-check {
                background: var(--pt);
                border-color: var(--pt);
                color: #fff
            }

            .pat-steps strong {
                display: block;
                font-size: 13.5px
            }

            .pat-steps small {
                display: block;
                color: var(--ink-s);
                font-size: 12px;
                margin-top: 2px
            }

            /* ---------- pipeline + urgency ---------- */
            .pat-bars {
                padding: 20px 26px 24px
            }

            .pat-bar-row {
                margin-bottom: 16px
            }

                .pat-bar-row:last-child {
                    margin-bottom: 0
                }

            .pat-bar-label {
                display: flex;
                justify-content: space-between;
                font-size: 13px;
                margin-bottom: 7px;
                color: var(--ink-s)
            }

                .pat-bar-label strong {
                    color: var(--ink)
                }

            .pat-bar {
                height: 10px;
                border-radius: 999px;
                background: var(--ln);
                overflow: hidden
            }

                .pat-bar span {
                    display: block;
                    height: 100%;
                    border-radius: 999px;
                    transition: width .6s ease
                }

            .b-blue {
                background: var(--bl)
            }

            .b-orange {
                background: var(--or)
            }

            .b-teal {
                background: var(--pt)
            }

            .b-purple {
                background: var(--pr)
            }

            .pat-stack {
                display: flex;
                height: 14px;
                border-radius: 999px;
                overflow: hidden;
                background: var(--ln)
            }

                .pat-stack span {
                    flex-basis: 0;
                    min-width: 0
                }

            .s-routine {
                background: var(--pt)
            }

            .s-urgent {
                background: var(--or)
            }

            .s-stat {
                background: var(--rd)
            }

            .pat-note {
                margin: 14px 0 0;
                font-size: 12px;
                color: #8FA9A3
            }

            /* ---------- tips + help ---------- */
            .pat-tip {
                background: var(--bg);
                border-radius: var(--r);
                box-shadow: var(--sh-sm);
                padding: 24px;
                border-top: 3px solid var(--pt)
            }

            .pat-tip-icon {
                width: 46px;
                height: 46px;
                border-radius: 14px;
                background: var(--pt-dim);
                color: var(--pt);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 19px;
                margin-bottom: 14px
            }

            .pat-tip h5 {
                margin: 0 0 8px;
                font-weight: 700;
                font-size: 15px
            }

            .pat-tip p {
                margin: 0;
                color: var(--ink-s);
                font-size: 13px;
                line-height: 1.65
            }

            .pat-help {
                display: flex;
                justify-content: space-between;
                align-items: center;
                gap: 18px;
                flex-wrap: wrap;
                margin-top: 18px;
                padding: 24px 30px;
                border-radius: var(--r);
                background: linear-gradient(125deg,#12A392,#0A4F48);
                color: #fff;
                box-shadow: 0 14px 30px rgba(10,90,80,.18)
            }

                .pat-help h4 {
                    margin: 0 0 4px;
                    font: 700 18px 'Poppins',sans-serif;
                    color: #fff
                }

                .pat-help p {
                    margin: 0;
                    color: rgba(255,255,255,.85);
                    font-size: 13.5px
                }

            .pat-help-btn {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                background: #fff;
                color: var(--pt-deep);
                font: 700 13.5px 'Inter',sans-serif;
                padding: 11px 20px;
                border-radius: 999px;
                text-decoration: none;
                transition: transform .2s
            }

                .pat-help-btn:hover {
                    transform: translateY(-2px);
                    color: var(--pt-deep);
                    text-decoration: none
                }

            /* ---------- footer ---------- */
            .pat-footer {
                margin-top: 50px;
                text-align: center
            }

                .pat-footer hr {
                    border: none;
                    border-top: 1px solid var(--ln);
                    margin-bottom: 22px
                }

            .pat-footer-content {
                display: flex;
                justify-content: center;
                flex-wrap: wrap;
                gap: 12px;
                color: var(--ink-s);
                font-size: 13px
            }

                .pat-footer-content i {
                    color: var(--pt)
                }

            /* ---------- keyboard focus ---------- */
            .pat-stat:focus-visible, .pat-action:focus-visible, .pat-refresh:focus-visible, .pat-row:focus-visible, .pat-alert-link:focus-visible, .pat-panel-link:focus-visible,
            .pat-bell:focus-visible, .pat-chip:focus-visible, .pat-btn:focus-visible, .pat-nitem:focus-visible, .pat-notif-markall:focus-visible, .pat-drawer-close:focus-visible,
            .pat-backtop:focus-visible, .pat-steps a:focus-visible, .pat-help-btn:focus-visible, .pat-toast:focus-visible {
                outline: 3px solid rgba(14,140,127,.45);
                outline-offset: 2px
            }

            /* ---------- responsive ---------- */
            @@media (max-width: 1100px) {
                .pat-grid-4, .pat-grid-3 {
                    grid-template-columns: repeat(2,1fr)
                }

                .pat-split, .pat-split-even {
                    grid-template-columns: 1fr
                }

                .pat-insights {
                    grid-template-columns: 1fr 1fr
                }
            }

            @@media (max-width: 900px) {
                .pat-banner {
                    flex-direction: column;
                    align-items: flex-start;
                    gap: 24px
                }

                .pat-clock {
                    width: 100%;
                    border-left: none;
                    border-top: 1px solid rgba(255,255,255,.28);
                    padding-top: 18px;
                    padding-left: 0
                }

                .pat-banner-left {
                    flex-direction: column
                }

                .pat-facts {
                    grid-template-columns: repeat(2,1fr)
                }
            }

            @@media (max-width: 640px) {
                .pat-wrap {
                    padding: 20px 16px
                }

                .pat-grid-4, .pat-grid-3, .pat-insights {
                    grid-template-columns: 1fr
                }

                .pat-alert-strip {
                    flex-direction: column;
                    align-items: flex-start
                }

                .pat-chips {
                    padding: 12px 16px
                }

                .pat-table th, .pat-table td {
                    padding-left: 16px;
                    padding-right: 16px
                }

                .pat-detail {
                    padding: 18px 16px 20px
                }

                .pat-tlabel {
                    font-size: 10.5px
                }

                .pat-toasts {
                    right: 16px;
                    top: 76px
                }

                .pat-bell-wrap.is-float {
                    right: 16px
                }
            }

            @@media (prefers-reduced-motion: reduce) {
                .pat-wrap, .pat-icon-ring, .pat-refresh.is-loading i, .pat-bell.is-ringing i, .pat-toast {
                    animation: none
                }

                .pat-toast-bar {
                    animation-duration: 8s
                }

                .pat-drawer, .pat-overlay, .pat-backtop, .pat-bar span, .pat-progress, .pat-chev {
                    transition: none
                }
            }


            /* ==========================================================
                           DARK MODE (html.rq-dark, same switch as the rest of the app)
                           The shared dark rules force "color: inherit" on span / p / li / small / th / td,
                           and restyle anything with "panel" or "chip" in its class name, so the colour
                           rules below use !important where they have to win.
                           The drawer, toasts and back-to-top button sit outside .pat-wrap, so their
                           rules do not start from .pat-wrap.
                        ========================================================== */

            /* 1. Re-point the page's variables at the shared dark palette */
            html.rq-dark {
                --pt: #2CC4BA;
                --pt-deep: #5ED0C4;
                --pt-dim: #12302D;
                --bl: #6CB0E8;
                --bl-dim: #14283A;
                --pr: #B39DEB;
                --pr-dim: #2A2142;
                --or: #E0A540;
                --or-dim: #33280F;
                --rd: #E1736B;
                --rd-dim: #3A1B18;
                --gn: #5CBB82;
                --gn-dim: #13301F;
                --bg: #172019;
                --ink: #E8EEEB;
                --ink-s: #A5B0AA;
                --ln: #26302B;
                --sh: 0 6px 24px rgba(0, 0, 0, .45);
                --sh-sm: 0 3px 10px rgba(0, 0, 0, .3);
            }

                /* 2. Banner + help block: darker teal gradient, white text */
                html.rq-dark .pat-wrap .pat-banner,
                html.rq-dark .pat-wrap .pat-help {
                    background: linear-gradient(125deg, #0F7F74, #0A3A35);
                }

                html.rq-dark .pat-wrap .pat-banner-text h1 {
                    color: #fff !important;
                }

                    html.rq-dark .pat-wrap .pat-banner-text h1 span {
                        color: #E9FFFB !important;
                    }

                        html.rq-dark .pat-wrap .pat-banner-text h1 span#patGreeting {
                            color: #fff !important;
                        }

                html.rq-dark .pat-wrap .pat-banner-text p {
                    color: rgba(255, 255, 255, .85) !important;
                }

                html.rq-dark .pat-wrap .pat-clock small {
                    color: #DFF9F8 !important;
                }

                html.rq-dark .pat-wrap .pat-help h4 {
                    color: #fff !important;
                }

                html.rq-dark .pat-wrap .pat-help p {
                    color: rgba(255, 255, 255, .85) !important;
                }

                html.rq-dark .pat-wrap .pat-help a.pat-help-btn {
                    background: #E8EEEB;
                    color: #0A3A35;
                }

                    html.rq-dark .pat-wrap .pat-help a.pat-help-btn:hover {
                        color: #0A3A35;
                    }

                /* 3. "View All" / "Edit" links in panel headers (the shared catch-all restyles anything named "panel") */
                html.rq-dark .pat-wrap .pat-panel .pat-panel-head a.pat-panel-link {
                    background-color: transparent !important;
                    color: var(--pt-deep) !important;
                    box-shadow: none !important;
                }

                /* notification dropdown keeps its shadow */
                html.rq-dark .pat-wrap .pat-topbar .pat-bell-slot .pat-bell-wrap .pat-notif-panel {
                    box-shadow: 0 14px 36px rgba(0, 0, 0, .55) !important;
                }

                /* 4. Text colours that the shared "color: inherit" rule would flatten */
                html.rq-dark .pat-wrap .pat-crumb span,
                html.rq-dark .pat-wrap .pat-section-head p,
                html.rq-dark .pat-wrap .pat-stat small,
                html.rq-dark .pat-wrap .pat-table th,
                html.rq-dark .pat-wrap .pat-table td.pat-table-empty,
                html.rq-dark .pat-wrap .pat-facts small,
                html.rq-dark .pat-wrap .pat-explain,
                html.rq-dark .pat-wrap .pat-explain span,
                html.rq-dark .pat-wrap .pat-complete-text small,
                html.rq-dark .pat-wrap .pat-profile-label,
                html.rq-dark .pat-wrap .pat-legend li,
                html.rq-dark .pat-wrap .pat-donut-center small,
                html.rq-dark .pat-wrap .pat-mini-empty span,
                html.rq-dark .pat-wrap .pat-timeline span,
                html.rq-dark .pat-wrap .pat-steps small,
                html.rq-dark .pat-wrap .pat-bar-label span,
                html.rq-dark .pat-wrap .pat-tip p,
                html.rq-dark .pat-wrap .pat-footer-content span,
                html.rq-dark .pat-notif-panel .pat-ntext small,
                html.rq-dark .pat-toasts .pat-ntext small,
                html.rq-dark .pat-notif-panel .pat-mini-empty span {
                    color: var(--ink-s) !important;
                }

                html.rq-dark .pat-wrap .pat-timeline small,
                html.rq-dark .pat-wrap .pat-note {
                    color: #7F8B85 !important;
                }

                html.rq-dark .pat-wrap .pat-profile-row .pat-profile-val {
                    color: var(--ink) !important;
                }

                html.rq-dark .pat-wrap .pat-stat .pat-stat-go {
                    color: var(--pt) !important;
                }

                html.rq-dark .pat-wrap .pat-ring span {
                    color: var(--pt-deep) !important;
                }

                html.rq-dark .pat-wrap .pat-bell .pat-bell-badge {
                    color: #fff !important;
                    border-color: var(--bg);
                }

                /* notification / toast icons */
                html.rq-dark .n-warn .pat-nicon {
                    color: var(--or) !important;
                }

                html.rq-dark .n-ok .pat-nicon {
                    color: var(--pt) !important;
                }

                html.rq-dark .n-info .pat-nicon {
                    color: var(--bl) !important;
                }

                html.rq-dark .n-req .pat-nicon {
                    color: var(--pr) !important;
                }

                /* progress tracker (rows + drawer) */
                html.rq-dark .pat-tstep .pat-tdot {
                    color: var(--ink-s) !important;
                }

                html.rq-dark .pat-tstep.current .pat-tdot {
                    color: var(--pt-deep) !important;
                }

                html.rq-dark .pat-tstep.done .pat-tdot {
                    background: #0F7F74;
                    border-color: #0F7F74;
                    color: #fff !important;
                }

                html.rq-dark .pat-tstep .pat-tlabel {
                    color: var(--ink-s) !important;
                }

                html.rq-dark .pat-tstep.done .pat-tlabel,
                html.rq-dark .pat-tstep.current .pat-tlabel {
                    color: var(--ink) !important;
                }

                /* next steps checklist */
                html.rq-dark .pat-wrap .pat-steps a .pat-check {
                    color: var(--pt) !important;
                }

                html.rq-dark .pat-wrap .pat-steps a.is-done .pat-check {
                    background: #0F7F74;
                    border-color: #0F7F74;
                    color: #fff !important;
                }

                /* 5. Urgency + status badges (their text colours were dark browns / reds) */
                html.rq-dark .pat-urgency.routine {
                    color: var(--pt-deep) !important;
                }

                html.rq-dark .pat-urgency.urgent {
                    color: #E0A540 !important;
                }

                html.rq-dark .pat-urgency.stat {
                    color: #E1736B !important;
                }

                html.rq-dark .pat-status.submitted {
                    background: #26302B;
                    color: #B8C7C1;
                }

                html.rq-dark .pat-status.inprogress {
                    color: #E0A540;
                }

                html.rq-dark .pat-wrap .pat-badge {
                    background: #26302B;
                    color: #B8C7C1;
                }

                    html.rq-dark .pat-wrap .pat-badge.info {
                        background: var(--bl-dim);
                        color: var(--bl);
                    }

                    html.rq-dark .pat-wrap .pat-badge.ok {
                        background: var(--pt-dim);
                        color: var(--pt-deep);
                    }

                    html.rq-dark .pat-wrap .pat-badge.warn {
                        background: var(--or-dim);
                        color: #E0A540;
                    }

                html.rq-dark .pat-wrap .pat-timeline li .pat-tl-dot {
                    background: #7F8B85;
                }

                    html.rq-dark .pat-wrap .pat-timeline li .pat-tl-dot.inprogress {
                        background: var(--or);
                    }

                    html.rq-dark .pat-wrap .pat-timeline li .pat-tl-dot.completed {
                        background: var(--gn);
                    }

                    html.rq-dark .pat-wrap .pat-timeline li .pat-tl-dot.released {
                        background: var(--pt);
                    }

                /* 6. Buttons and chips that were solid teal with white text */
                html.rq-dark .pat-btn.primary,
                html.rq-dark .pat-btn.primary.is-disabled:hover {
                    background: #0F7F74;
                    border-color: #0F7F74;
                    color: #fff !important;
                }

                    html.rq-dark .pat-btn.primary:hover {
                        background: #0A5850;
                        border-color: #0A5850;
                    }

                html.rq-dark .pat-wrap .pat-chips .pat-chip {
                    border-color: var(--ln);
                }

                    html.rq-dark .pat-wrap .pat-chips .pat-chip.is-active {
                        background: #0F7F74;
                        border-color: #0F7F74;
                        color: #fff;
                    }

                    html.rq-dark .pat-wrap .pat-chips .pat-chip b {
                        background: #26302B;
                        color: #A5B0AA;
                    }

                    html.rq-dark .pat-wrap .pat-chips .pat-chip.is-active b {
                        background: rgba(255, 255, 255, .22);
                        color: #fff;
                    }

                html.rq-dark .pat-backtop {
                    background: #0F7F74;
                    color: #fff;
                }

                    html.rq-dark .pat-backtop:hover {
                        background: #0A5850;
                    }

                html.rq-dark .pat-wrap .pat-action:hover .pat-action-go {
                    background: #0F7F74;
                    color: #fff !important;
                }

                html.rq-dark .pat-wrap .pat-action .pat-action-go {
                    color: var(--pt) !important;
                }

                /* 7. Light hover / zebra shades become dark ones */
                html.rq-dark .pat-wrap .pat-table th {
                    background: #141C18;
                }

                html.rq-dark .pat-wrap .pat-table .pat-row:hover,
                html.rq-dark .pat-wrap .pat-table .pat-row[aria-expanded="true"] {
                    background: #1B2620;
                }

                html.rq-dark .pat-wrap .pat-table .pat-detail-row > td {
                    background: #141C18;
                }

                html.rq-dark .pat-wrap .pat-steps a:hover {
                    background: #1B2620;
                }

                html.rq-dark .pat-nitem:hover {
                    background: #1B2620;
                }

                /* 8. Drawer + overlay */
                html.rq-dark .pat-overlay {
                    background: rgba(0, 0, 0, .65);
                }

                html.rq-dark .pat-drawer {
                    box-shadow: -12px 0 40px rgba(0, 0, 0, .55);
                }

                html.rq-dark .pat-drawer-close:hover {
                    background: #0F7F74;
                    color: #fff;
                }

                html.rq-dark .pat-toast-x:hover {
                    background: var(--pt-dim);
                }
        </style>





    }
      else if (User.IsInRole("Lab_Technician"))
{
    @* ViewData["Title"] = "Laboratory Technician Dashboard"; *@

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />

    <div class="db-wrap" id="techWrap">

        <!-- =========================================================
             TOP BAR: BREADCRUMB + NOTIFICATION BELL
             ========================================================= -->
        <div class="db-topbar">

            <nav class="db-crumb" aria-label="Breadcrumb">
                <span>Technician Portal</span>
                <i class="fa-solid fa-chevron-right"></i>
                <strong aria-current="page">Dashboard</strong>
            </nav>

            <div class="db-bell-wrap" id="techBellWrap">

                <button type="button" class="db-bell" id="techBell"
                        aria-label="Notifications" aria-haspopup="true" aria-expanded="false">
                    <i class="fa-solid fa-bell"></i>
                    <span class="db-bell-badge" id="techBellBadge" hidden>0</span>
                </button>

                <div class="db-n-panel" id="techNotifPanel" role="dialog" aria-label="Notifications" hidden>

                    <div class="db-n-head">
                        <div class="db-n-head-title">
                            <i class="fa-solid fa-bell"></i>
                            <span>Notifications</span>
                            <em id="techNotifUnread">0 new</em>
                        </div>
                        <button type="button" class="db-n-markall" id="techMarkAll">Mark all as read</button>
                    </div>

                    <div class="db-n-status ok" id="techNotifStatus">
                        <i class="fa-solid fa-circle-check"></i>
                        <span>Checking your workload...</span>
                    </div>

                    <div class="db-n-tabs" role="tablist">
                        <button type="button" class="db-n-tab active" data-tab="all" role="tab">All <b id="tabAll">0</b></button>
                        <button type="button" class="db-n-tab" data-tab="urgent" role="tab">Urgent <b id="tabUrgent">0</b></button>
                        <button type="button" class="db-n-tab" data-tab="flow" role="tab">Workflow <b id="tabFlow">0</b></button>
                    </div>

                    <div class="db-n-list" id="techNotifList"></div>

                    <div class="db-n-foot">
                        <span id="techNotifChecked">Checking...</span>
                        <span class="db-n-foot-btns">
                            <button type="button" id="techNotifRestore" hidden>Restore dismissed</button>
                            <button type="button" id="techNotifRefresh"><i class="fa-solid fa-rotate-right"></i> Refresh</button>
                        </span>
                    </div>

                </div>
            </div>

        </div>

        <div class="db-toasts" id="techToasts" aria-live="polite"></div>


        <!-- =========================================================
             WELCOME BANNER
             ========================================================= -->
        <div class="db-banner">

            <div class="db-banner-pattern"></div>

            <div class="db-banner-left">

                <div class="db-banner-icon">
                    <span class="db-icon-ring"></span>
                    <i class="fa-solid fa-flask-vial"></i>
                </div>

                <div class="db-banner-text">

                    <h1><span id="techGreeting" style="color:#fff">Welcome</span>, <span>@User.Identity?.Name</span></h1>

                    <p>Laboratory Technician Dashboard</p>

                    <div class="db-pills">
                        <span class="db-pill"><i class="fa-solid fa-user-doctor"></i> Lab Technician</span>
                        <span class="db-pill"><i class="fa-solid fa-calendar-check"></i> Updated @DateTime.Now.ToString("d MMM yyyy")</span>
                        <span class="db-pill"><i class="fa-solid fa-vials"></i> Daily work queue</span>
                    </div>

                </div>

            </div>

            <div class="db-banner-right">

                <!-- CLOCK -->
                <div class="db-clock">
                    <small>Today's date</small>
                    <div id="currentDate"></div>
                    <div id="currentTime"></div>
                </div>

            </div>

        </div>


        <!-- =========================================================
             WORKLOAD HEALTH STRIP
             ========================================================= -->
        <div class="db-health ok" id="techHealth" data-act="all">

            <div class="db-health-msg">
                <span class="db-health-dot"></span>
                <span id="techHealthText"><strong>Checking your workload</strong> &middot; one moment</span>
            </div>

            <button type="button" class="db-health-cta" id="techHealthCta">
                Review queue <i class="fa-solid fa-arrow-right"></i>
            </button>

        </div>


        <!-- =========================================================
             WORKFLOW PIPELINE
             ========================================================= -->
        <div class="db-pulse">

            <div class="db-pulse-label">
                <i class="fa-solid fa-timeline"></i>
                Technician workload pipeline
            </div>

            <div class="db-flow">

                <div class="db-flow-node">
                    <div class="db-flow-circle n-teal"><i class="fa-solid fa-vials"></i></div>
                    <div class="db-flow-count" id="flowInProgress">0</div>
                    <div class="db-flow-label">Selected / In Progress</div>
                </div>

                <div class="db-flow-line"><span class="db-flow-line-fill"></span></div>

                <div class="db-flow-node">
                    <div class="db-flow-circle n-blue"><i class="fa-solid fa-hourglass-half"></i></div>
                    <div class="db-flow-count" id="flowAvailable">0</div>
                    <div class="db-flow-label">Waiting Selection</div>
                </div>

                <div class="db-flow-line"><span class="db-flow-line-fill"></span></div>

                <div class="db-flow-node">
                    <div class="db-flow-circle n-green"><i class="fa-solid fa-circle-check"></i></div>
                    <div class="db-flow-count" id="flowVerified">0</div>
                    <div class="db-flow-label">Ready to Verify</div>
                </div>

                <div class="db-flow-line"><span class="db-flow-line-fill"></span></div>

                <div class="db-flow-node">
                    <div class="db-flow-circle n-purple"><i class="fa-solid fa-file-medical"></i></div>
                    <div class="db-flow-count" id="flowReview">0</div>
                    <div class="db-flow-label">Returned to You</div>
                </div>

            </div>

            <div class="db-pulse-chips">

                <span class="db-chip chip-stat">
                    <i class="fa-solid fa-bolt"></i>
                    <span id="urgentChip">0 STAT tests</span>
                </span>

                <span class="db-chip chip-overdue">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    <span id="overdueChip">0 overdue tests</span>
                </span>

                <span class="db-chip">
                    <i class="fa-solid fa-stopwatch"></i>
                    <span id="nearDeadlineChip">0 near deadline</span>
                </span>

            </div>

        </div>


        <!-- =========================================================
             WORKLOAD
             ========================================================= -->
        <div class="db-section-head">
            <div>
                <h3>Technician workload</h3>
                <p>Overview of laboratory tests requiring your attention.</p>
            </div>
        </div>

        <div class="db-grid db-grid-4">

            <a asp-controller="AvailableTests" asp-action="InProgress" class="db-stat db-stat-link">
                <div class="db-stat-icon c-teal"><i class="fa-solid fa-vials"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="inProgressCount">0</div>
                    <h5>Selected tests</h5>
                    <small>Currently assigned to you</small>
                </div>
            </a>

            <a asp-controller="AvailableTests" asp-action="Index" class="db-stat db-stat-link">
                <div class="db-stat-icon c-blue"><i class="fa-solid fa-hourglass-half"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="availableCount">0</div>
                    <h5>Waiting selection</h5>
                    <small>Samples received and awaiting technician</small>
                </div>
            </a>

            <a asp-controller="Verification" asp-action="Index" class="db-stat db-stat-link">
                <div class="db-stat-icon c-green"><i class="fa-solid fa-circle-check"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="verifiedCount">0</div>
                    <h5>Ready for you to verify</h5>
                    <small>Results captured by other technicians</small>
                </div>
            </a>

            <a asp-controller="ToBeReviewed" asp-action="Index" class="db-stat db-stat-link">
                <div class="db-stat-icon c-purple"><i class="fa-solid fa-file-medical"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="reviewCount">0</div>
                    <h5>Returned to you</h5>
                    <small>Sent back by a verifier for correction</small>
                </div>
            </a>

        </div>

        <div class="db-grid db-grid-4 db-grid-mt">

            <div class="db-stat db-stat-link db-stat-urgent db-stat-crit" role="button" tabindex="0" data-urgency="STAT">
                <div class="db-stat-icon c-red"><i class="fa-solid fa-bolt"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="urgentCount">0</div>
                    <h5>STAT tests</h5>
                    <small>Immediate attention required</small>
                </div>
            </div>

            <div class="db-stat db-stat-link db-stat-urgent" role="button" tabindex="0" data-due="overdue">
                <div class="db-stat-icon c-orange"><i class="fa-solid fa-hourglass-end"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="overdueCount">0</div>
                    <h5>Overdue tests</h5>
                    <small>Past turnaround time</small>
                </div>
            </div>

            <div class="db-stat db-stat-link" role="button" tabindex="0" data-due="near">
                <div class="db-stat-icon c-gold"><i class="fa-solid fa-stopwatch"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="nearDeadlineCount">0</div>
                    <h5>Near turnaround limit</h5>
                    <small>Due within 30 minutes</small>
                </div>
            </div>

            <a asp-controller="AvailableTests" asp-action="Completed" class="db-stat db-stat-link">
                <div class="db-stat-icon c-teal-deep"><i class="fa-solid fa-award"></i></div>
                <div class="db-stat-body">
                    <div class="num counter" id="completedCount">0</div>
                    <h5>Verified tests</h5>
                    <small>Laboratory results verified</small>
                </div>
            </a>

        </div>


        <!-- =========================================================
             QUICK ACTIONS
             ========================================================= -->
        <div class="db-section-head db-mt-lg">
            <div>
                <h3>Quick actions</h3>
                <p>Access your laboratory functions.</p>
            </div>
        </div>

        <div class="db-grid db-grid-4">

            <a asp-controller="AvailableTests" asp-action="Index" class="db-action">
                <div class="db-action-icon"><i class="fa-solid fa-vials"></i></div>
                <h5>Available tests</h5>
                <p>View tests waiting to be selected.</p>
                <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a asp-controller="AvailableTests" asp-action="InProgress" class="db-action">
                <div class="db-action-icon"><i class="fa-solid fa-flask"></i></div>
                <h5>Tests in progress</h5>
                <p>Continue working on your assigned tests.</p>
                <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
            </a>

            <a asp-controller="CaptureResults" asp-action="Index" class="db-action">
                <div class="db-action-icon"><i class="fa-solid fa-pen-to-square"></i></div>
                <h5>Capture results</h5>
                <p>Record laboratory findings and observations.</p>
                <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
