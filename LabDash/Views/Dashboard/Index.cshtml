                14.5px;
        }


        .db-pills {

            display: flex;

            gap: 10px;

            flex-wrap: wrap;
        }


        .db-pill {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding:
                7px 15px;

            border-radius:
                999px;

            background:
                rgba(255,255,255,.16);

            color: #fff;

            font-size:
                12.5px;
        }


        .db-clock {

            position: relative;

            z-index: 1;

            min-width: 230px;

            border-left:
                1px solid
                rgba(255,255,255,.28);

            padding-left: 28px;
        }


        .db-clock small {

            color: #DFF9F8;

            font-size: 11px;

            font-weight: 600;

            text-transform: uppercase;
        }


        #currentDate {

            margin-top: 6px;

            color: #fff;

            font-size: 14px;
        }


        #currentTime {

            margin-top: 2px;

            color: #fff;

            font-family:
                'IBM Plex Mono',
                monospace;

            font-size: 26px;

            font-weight: 600;
        }


        /* =========================================================
           PIPELINE
           ========================================================= */

        .db-pulse {

            background:
                var(--db-raised);

            border-radius:
                var(--db-radius);

            box-shadow:
                var(--db-shadow);

            padding:
                26px 30px;

            margin-bottom:
                28px;
        }


        .db-pulse-label {

            color:
                var(--db-teal-deep);

            font-size:
                12.5px;

            font-weight:
                700;

            text-transform:
                uppercase;

            margin-bottom:
                22px;
        }


        .db-flow {

            display: flex;

            align-items:
                flex-start;
        }


        .db-flow-node {

            width: 130px;

            flex:
                0 0 auto;

            display: flex;

            flex-direction:
                column;

            align-items:
                center;
        }


        .db-flow-circle {

            width: 48px;

            height: 48px;

            border-radius: 50%;

            display: flex;

            align-items: center;

            justify-content: center;

            color: #fff;

            margin-bottom: 10px;

            box-shadow:
                0 4px 10px
                rgba(0,0,0,.12);
        }


        .n-teal {
            background: var(--db-teal);
        }

        .n-blue {
            background: var(--db-blue);
        }

        .n-green {
            background: var(--db-green);
        }

        .n-purple {
            background: var(--db-purple);
        }


        .db-flow-count {

            font-family:
                'Poppins',
                sans-serif;

            font-size: 20px;

            font-weight: 700;
        }


        .db-flow-label {

            font-size: 12px;

            color:
                var(--db-ink-soft);

            text-align: center;
        }


        .db-flow-line {

            flex: 1;

            height: 3px;

            background:
                var(--db-line);

            margin-top: 24px;

            border-radius: 3px;
        }


        .db-flow-line-fill {

            display: block;

            height: 100%;

            width: 0%;

            background:
                var(--db-teal);

            border-radius: 3px;
        }


        .db-pulse-chips {

            display: flex;

            gap: 10px;

            margin-top: 24px;

            flex-wrap: wrap;
        }


        .db-chip {

            display: inline-flex;

            align-items: center;

            gap: 8px;

            padding:
                8px 16px;

            border-radius:
                999px;

            font-size:
                12.5px;

            font-weight:
                600;
        }


        .chip-stat {

            background:
                var(--db-red-dim);

            color:
                var(--db-red);
        }


        .chip-overdue {

            background:
                var(--db-orange-dim);

            color:
                var(--db-orange);
        }


        /* =========================================================
           HEADINGS
           ========================================================= */

        .db-section-head {

            display: flex;

            justify-content:
                space-between;

            align-items:
                center;

            margin-bottom:
                18px;
        }


        .db-section-head h3 {

            font-family:
                'Poppins',
                sans-serif;

            font-size:
                20px;

            margin:
                0 0 3px;
        }


        .db-section-head p {

            margin: 0;

            color:
                var(--db-ink-soft);

            font-size:
                13.5px;
        }


        .db-mt-lg {

            margin-top:
                44px;
        }


        .db-mb-lg {

            margin-bottom:
                30px;
        }


        /* =========================================================
           GRID
           ========================================================= */

        .db-grid {

            display: grid;

            gap: 18px;
        }


        .db-grid-4 {

            grid-template-columns:
                repeat(4,1fr);
        }


        .db-grid-mt {

            margin-top:
                18px;
        }


        /* =========================================================
           STAT CARDS
           ========================================================= */

        .db-stat {

            background:
                var(--db-raised);

            border-radius:
                var(--db-radius);

            box-shadow:
                var(--db-shadow-sm);

            padding:
                22px;

            display: flex;

            align-items:
                center;

            gap: 16px;

            border-top:
                3px solid
                var(--db-teal);

            transition:
                .2s;
        }


        .db-stat:hover {

            transform:
                translateY(-5px);

            box-shadow:
                var(--db-shadow);
        }


        .db-stat-urgent {

            border-top-color:
                var(--db-red);
        }


        .db-stat-icon {

            width: 54px;

            height: 54px;

            border-radius: 15px;

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 21px;

            flex-shrink: 0;
        }


        .c-teal {

            background:
                var(--db-teal-dim);

            color:
                var(--db-teal);
        }


        .c-teal-deep {

            background:
                var(--db-teal-dim);

            color:
                var(--db-teal-deep);
        }


        .c-blue {

            background:
                var(--db-blue-dim);

            color:
                var(--db-blue);
        }


        .c-green {

            background:
                var(--db-green-dim);

            color:
                var(--db-green);
        }


        .c-purple {

            background:
                var(--db-purple-dim);

            color:
                var(--db-purple);
        }


        .c-red {

            background:
                var(--db-red-dim);

            color:
                var(--db-red);
        }


        .c-orange {

            background:
                var(--db-orange-dim);

            color:
                var(--db-orange);
        }


        .c-gold {

            background:
                var(--db-gold-dim);

            color:
                var(--db-gold);
        }


        .db-stat .num {

            font-family:
                'Poppins',
                sans-serif;

            font-size:
                27px;

            font-weight:
                700;
        }


        .db-stat h5 {

            margin:
                2px 0 0;

            font-size:
                13.5px;
        }


        .db-stat small {

            color:
                var(--db-ink-faint);

            font-size:
                12px;
        }


        /* =========================================================
           ACTION CARDS
           ========================================================= */

        .db-action {

            display: block;

            text-decoration: none;

            color:
                var(--db-ink);

            background:
                var(--db-raised);

            border-radius:
                var(--db-radius);

            padding:
                28px 24px;

            box-shadow:
                var(--db-shadow-sm);

            position: relative;

            transition:
                .25s;
        }


        .db-action:hover {

            transform:
                translateY(-6px);

            box-shadow:
                var(--db-shadow);

            color:
                var(--db-ink);

            text-decoration:
                none;
        }


        .db-action-icon {

            width: 54px;

            height: 54px;

            margin-bottom: 16px;

            border-radius: 16px;

            background:
                var(--db-teal-dim);

            color:
                var(--db-teal);

            display: flex;

            align-items: center;

            justify-content: center;

            font-size: 23px;
        }


        .db-action h5 {

            font-weight: 700;

            margin:
                0 0 8px;
        }


        .db-action p {

            color:
                var(--db-ink-soft);

            font-size:
                13px;

            line-height:
                1.6;
        }


        .db-action-go {

            color:
                var(--db-teal);
        }


        /* =========================================================
           PANEL
           ========================================================= */

        .db-panel {

            background:
                var(--db-raised);

            border-radius:
                var(--db-radius);

            box-shadow:
                var(--db-shadow);

            overflow:
                hidden;
        }


        .db-panel-head {

            display: flex;

            justify-content:
                space-between;

            align-items:
                center;

            padding:
                18px 26px;

            border-bottom:
                1px solid
                var(--db-line);
        }


        .db-panel-head span:first-child {

            font-family:
                'Poppins',
                sans-serif;

            font-weight:
                700;

            display:
                flex;

            align-items:
                center;

            gap: 10px;
        }


        .db-panel-head span:first-child i {

            color:
                var(--db-teal);
        }


        .db-panel-head small {

            display:
                block;

            color:
                var(--db-ink-faint);

            font-size:
                12.5px;

            margin-top:
                3px;
        }


        .db-panel-tag {

            background:
                var(--db-teal-dim);

            color:
                var(--db-teal-deep);

            padding:
                6px 13px;

            border-radius:
                999px;

            font-size:
                11.5px;

            font-weight:
                600;
        }


        .db-panel-count {

            background:
                var(--db-teal);

            color:
                white;

            padding:
                7px 15px;

            border-radius:
                999px;

            font-size:
                12.5px;

            font-weight:
                700;
        }


        .db-panel-body {

            padding:
                26px;
        }


        /* =========================================================
           FILTER
           ========================================================= */

        .db-filter-grid {

            display: grid;

            grid-template-columns:
                1fr 1fr 1.4fr 1.4fr auto;

            gap: 16px;

            align-items:
                end;
        }


        .db-field {

            display: flex;

            flex-direction:
                column;

            gap: 7px;
        }


        .db-field label {

            font-size:
                12px;

            font-weight:
                600;

            color:
                var(--db-ink-soft);
        }


        .db-select,
        .db-input {

            height:
                46px;

            border:
                1px solid
                var(--db-line-strong);

            border-radius:
                var(--db-radius-sm);

            padding:
                0 14px;

            font-size:
                13.5px;

            color:
                var(--db-ink);

            background:
                white;
        }


        .db-btn-apply {

            height:
                46px;

            border:
                none;

            border-radius:
                999px;

            padding:
                0 24px;

            background:
                var(--db-teal);

            color:
                white;

            font-weight:
                600;

            cursor:
                pointer;
        }


        /* =========================================================
           TABLE
           ========================================================= */

        .db-table-wrap {

            overflow-x:
                auto;
        }


        .db-table {

            width:
                100%;

            border-collapse:
                collapse;
        }


        .db-table th {

            text-align:
                left;

            padding:
                15px 22px;

            background:
                var(--db-teal-dim);

            color:
                var(--db-ink-faint);

            font-size:
                11.5px;

            text-transform:
                uppercase;
        }


        .db-table td {

            padding:
                16px 22px;

            border-bottom:
                1px solid
                var(--db-line);
        }


        .db-empty {

            padding:
                60px 24px;

            text-align:
                center;
        }


        .db-empty i {

            width:
                96px;

            height:
                96px;

            margin:
                0 auto 20px;

            border-radius:
                50%;

            background:
                var(--db-teal-dim);

            color:
                var(--db-teal);

            display:
                flex;

            align-items:
                center;

            justify-content:
                center;

            font-size:
                42px;
        }


        .db-empty h3 {

            margin:
                0 0 10px;

            font-family:
                'Poppins',
                sans-serif;
        }


        .db-empty p {

            color:
                var(--db-ink-soft);

            line-height:
                1.7;
        }


        /* =========================================================
           FOOTER
           ========================================================= */

        .db-footer {

            margin-top:
                50px;

            text-align:
                center;
        }


        .db-footer hr {

            border:
                none;

            border-top:
                1px solid
                var(--db-line);
        }


        .db-footer-content {

            display:
                flex;

            justify-content:
                center;

            align-items:
                center;

            flex-wrap:
                wrap;

            gap:
                12px;

            color:
                var(--db-ink-faint);

            font-size:
                13px;
        }


        .db-footer-content i {

            color:
                var(--db-teal);
        }


        /* =========================================================
           RESPONSIVE
           ========================================================= */

        @@media(max-width:1100px) {

            .db-grid-4 {

                grid-template-columns:
                    repeat(2,1fr);
            }

            .db-filter-grid {

                grid-template-columns:
                    1fr 1fr;
            }
        }


        @@media(max-width:700px) {

            .db-banner {

                flex-direction:
                    column;

                align-items:
                    flex-start;
            }

            .db-clock {

                width:
                    100%;

                border-left:
                    none;

                border-top:
                    1px solid
                    rgba(255,255,255,.3);

                padding:
                    18px 0 0;
            }

            .db-grid-4 {

                grid-template-columns:
                    1fr;
            }

            .db-filter-grid {

                grid-template-columns:
                    1fr;
            }

            .db-flow {

                overflow-x:
                    auto;
            }
        }

    </style>
}

    
    else if (User.IsInRole("Lab_Manager"))
{
    <style>

        /* ================================
           LAB MANAGER DASHBOARD
           ================================ */

        .manager-dashboard {
            background: #f0fdfa;
            min-height: 100vh;
            padding: 25px;
            width: 100%;
            box-sizing: border-box;
            overflow-x: hidden;
        }

        /* HEADER */

        .manager-header {
            display: flex;
            justify-content: space-between;
            align-items: center;
            margin-bottom: 25px;
        }

        .manager-header h1 {
            margin: 0;
            color: #134e4a;
            font-size: 28px;
            font-weight: 700;
        }

        .manager-header p {
            margin: 6px 0 0;
            color: #64748b;
            font-size: 14px;
        }

        .manager-date {
            background: white;
            padding: 12px 18px;
            border-radius: 10px;
            color: #475569;
            box-shadow: 0 3px 12px rgba(0,0,0,0.06);
        }

        .manager-date i {
            color: #0f766e;
            margin-right: 6px;
        }

        /* STATISTICS */

        .manager-stats {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 18px;
            margin-bottom: 25px;
        }

        .manager-card {
            background: white;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #ccfbf1;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
        }

        .manager-card h3 {
            margin: 0;
            font-size: 28px;
            color: #134e4a;
        }

        .manager-card p {
            margin: 5px 0 0;
            color: #64748b;
            font-size: 13px;
        }

        .manager-card i {
            float: right;
            font-size: 25px;
            color: #0f766e;
        }

        /* CONTENT */

        .manager-content {
            display: grid;
            grid-template-columns: 2fr 1fr;
            gap: 20px;
            margin-bottom: 25px;
        }

        .manager-panel {
            background: white;
            border-radius: 14px;
            padding: 20px;
            border: 1px solid #ccfbf1;
            box-shadow: 0 4px 15px rgba(0,0,0,0.05);
            min-width: 0;
        }

        .manager-panel h2 {
            margin: 0 0 18px;
            font-size: 17px;
            color: #134e4a;
        }

        .manager-panel h2 i {
            color: #0f766e;
            margin-right: 7px;
        }

        /* TABLE */

        .manager-table {
            width: 100%;
            border-collapse: collapse;
        }

        .manager-table th {
            background: #f0fdfa;
            color: #475569;
            padding: 12px;
            text-align: left;
            font-size: 12px;
        }

        .manager-table td {
            padding: 12px;
            border-bottom: 1px solid #e2e8f0;
            font-size: 13px;
            color: #475569;
        }

        .manager-table td:first-child {
            font-weight: 600;
            color: #134e4a;
        }

        .stock-good {
            color: #15803d;
            font-weight: 700;
        }

        .stock-low {
            color: #dc2626;
            font-weight: 700;
        }

        .badge-good {
            background: #dcfce7;
            color: #15803d;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        .badge-low {
            background: #fee2e2;
            color: #dc2626;
            padding: 5px 9px;
            border-radius: 20px;
            font-size: 11px;
            font-weight: 700;
        }

        /* STOCK ALERTS */

        .stock-alert {
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #fff7f7;
            padding: 13px;
            margin-bottom: 10px;
            border-left: 4px solid #dc2626;
            border-radius: 8px;
        }

        .stock-alert strong {
            display: block;
            color: #334155;
            font-size: 13px;
        }

        .stock-alert small {
            color: #94a3b8;
        }

        /* QUICK ACTIONS */

        .quick-actions {
            display: grid;
            grid-template-columns: repeat(4, 1fr);
            gap: 15px;
        }

        .quick-action {
            text-decoration: none;
            text-align: center;
            background: white;
            border: 1px solid #ccfbf1;
            border-radius: 12px;
            padding: 20px;
            transition: 0.2s;
        }

        .quick-action:hover {
            border-color: #0f766e;
            transform: translateY(-2px);
        }

        .quick-action i {
            display: block;
            color: #0f766e;
            font-size: 24px;
            margin-bottom: 8px;
        }

        .quick-action span {
            color: #334155;
            font-size: 13px;
            font-weight: 600;
        }

        /* EMPTY */

        .empty-message {
            text-align: center;
            padding: 30px;
            color: #64748b;
        }

        .empty-message i {
            font-size: 35px;
            color: #0f766e;
            margin-bottom: 10px;
        }

        /* RESPONSIVE */

        @@media (max-width: 1000px) {

            .manager-stats {
                grid-template-columns: repeat(2, 1fr);
            }

            .manager-content {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: repeat(2, 1fr);
            }
        }

        @@media (max-width: 600px) {

            .manager-dashboard {
                padding: 15px;
            }

            .manager-header {
                display: block;
            }

            .manager-date {
                margin-top: 15px;
            }

            .manager-stats {
                grid-template-columns: 1fr;
            }

            .quick-actions {
                grid-template-columns: 1fr;
            }
        }

    </style>


    <div class="manager-dashboard">

        <!-- HEADER -->

        <div class="manager-header">

            <div>

                <h1>
                    Laboratory Manager Dashboard
                </h1>

                <p>
                    Manage laboratory consumables and monitor stock levels.
                </p>

            </div>

            <div class="manager-date">

                <i class="fa-solid fa-calendar-days"></i>

                @DateTime.Now.ToString("dddd, dd MMMM yyyy")

            </div>

        </div>


        <!-- STATISTICS -->

        <div class="manager-stats">

            <div class="manager-card">

                <i class="fa-solid fa-boxes-stacked"></i>

                <h3>
                    @(ViewBag.TotalConsumables ?? 0)
                </h3>

                <p>
                    Total Consumables
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-cubes"></i>

                <h3>
                    @(ViewBag.TotalStock ?? 0)
                </h3>

                <p>
                    Stock on Hand
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-triangle-exclamation"></i>

                <h3>
                    @(ViewBag.LowStock ?? 0)
                </h3>

                <p>
                    Low Stock Items
                </p>

            </div>


            <div class="manager-card">

                <i class="fa-solid fa-truck"></i>

                <h3>
                    @(ViewBag.SupplierCount ?? 0)
                </h3>

                <p>
                    Suppliers
                </p>

            </div>

        </div>


        <!-- CONSUMABLES + ALERTS -->

        <div class="manager-content">


            <!-- CONSUMABLES -->

            <div class="manager-panel">

                <h2>

                    <i class="fa-solid fa-boxes-stacked"></i>

                    Consumable Stock

                </h2>


                @if (ViewBag.Consumables != null &&
                     ViewBag.Consumables.Count > 0)
                {

                    <div style="overflow-x:auto;">

                        <table class="manager-table">

                            <thead>

                                <tr>

                                    <th>Name</th>

                                    <th>Supplier</th>

                                    <th>Stock</th>

                                    <th>Reorder</th>

                                    <th>Status</th>

                                </tr>

                            </thead>

                            <tbody>

                                @foreach (var item in ViewBag.Consumables)
                                {

                                    <tr>

                                        <td>
                                            @item.Name
                                        </td>

                                        <td>
                                            @(item.SupplierName ?? "Not specified")
                                        </td>

                                        <td class="@(item.StockLevel <= item.ReorderLevel
                                            ? "stock-low"
                                            : "stock-good")">

                                            @item.StockLevel

                                        </td>

                                        <td>
                                            @item.ReorderLevel
                                        </td>

                                        <td>

                                            @if (item.StockLevel <= item.ReorderLevel)
                                            {
                                                <span class="badge-low">
                                                    Low Stock
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="badge-good">
                                                    In Stock
                                                </span>
                                            }

                                        </td>

                                    </tr>

                                }

                            </tbody>

                        </table>

                    </div>

                }
                else
                {

                    <div class="empty-message">

                        <i class="fa-solid fa-box-open"></i>

                        <p>
                            No consumables have been added yet.
                        </p>

                        <a asp-controller="Consumable"
                           asp-action="Create"
                           class="btn btn-success">

                            Add Consumable

                        </a>

                    </div>

                }

            </div>


            <!-- LOW STOCK -->

            <div class="manager-panel">

                <h2>

                    <i class="fa-solid fa-bell"></i>

                    Low Stock Alerts

                </h2>


                @if (ViewBag.LowStockItems != null &&
                     ViewBag.LowStockItems.Count > 0)
                {

                    @foreach (var item in ViewBag.LowStockItems)
                    {

                        <div class="stock-alert">

                            <div>

                                <strong>
                                    @item.Name
                                </strong>

                                <small>
                                    Stock: @item.StockLevel |
                                    Reorder: @item.ReorderLevel
                                </small>

                            </div>

                            <span class="badge-low">
                                Low
                            </span>

                        </div>

                    }

                }
                else
                {

                    <div class="empty-message">

                        <i class="fa-solid fa-circle-check"></i>

                        <p>
                            No low-stock items.
                        </p>

                    </div>

                }

            </div>

        </div>


        <!-- QUICK ACTIONS -->

        <div class="manager-panel">

            <h2>

                <i class="fa-solid fa-bolt"></i>

                Quick Actions

            </h2>


            <div class="quick-actions">

                <a asp-controller="Consumable"
                   asp-action="Create"
                   class="quick-action">

                    <i class="fa-solid fa-box-open"></i>

                    <span>
                        Add Consumable
                    </span>

                </a>


                <a asp-controller="Consumable"
                   asp-action="Index"
                   class="quick-action">

                    <i class="fa-solid fa-boxes-stacked"></i>

                    <span>
                        Manage Consumables
                    </span>

                </a>


                <a asp-controller="Consumable"
                   asp-action="Index"
                   class="quick-action">

                    <i class="fa-solid fa-arrow-right-arrow-left"></i>

                    <span>
                        Adjust Stock
                    </span>

                </a>


                <a asp-controller="Consumable"
                   asp-action="Index"
                   class="quick-action">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    <span>
                        View Stock
                    </span>

                </a>

            </div>

        </div>

    </div>
    }
    else
    {
        <h1>No User Role</h1>
    }
}
    
    