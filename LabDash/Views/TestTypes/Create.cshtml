@model LabDash.Models.TestType

@{
    ViewData["Title"] = "Create Test Type";
    var consumables = ViewBag.Consumables as IEnumerable<LabDash.Models.Consumable>;
}

<div class="container-fluid py-4">

    <!-- HEADER -->

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none">

            <i class="fa-solid fa-arrow-left me-2"></i>
            Back to Test Types

        </a>

        <h2 class="fw-bold mt-3 mb-1">
            Create Test Type
        </h2>

        <p class="text-muted">
            Add a new laboratory test to the test catalogue.
        </p>

    </div>


    <form asp-action="Create"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="row g-4">


            <!-- LEFT SIDE -->

            <div class="col-lg-8">

                <!-- BASIC INFORMATION -->

                <div class="card border-0 shadow-sm mb-4">

                    <div class="card-header bg-white py-3">

                        <h5 class="fw-bold mb-0">

                            <i class="fa-solid fa-flask me-2 text-primary"></i>

                            Test Information

                        </h5>

                    </div>


                    <div class="card-body">

                        <!-- TEST NAME -->

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">
                            </label>

                            <input asp-for="Name"
                                   class="form-control form-control-lg"
                                   placeholder="e.g. Haemoglobin" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- CATEGORY -->

                        <div class="mb-4">

                            <label asp-for="TestCategoryId"
                                   class="form-label fw-semibold">

                                Test Category

                            </label>

                            <select asp-for="TestCategoryId"
                                    asp-items="ViewBag.TestCategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Select Test Category --
                                </option>

                            </select>

                            <span asp-validation-for="TestCategoryId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="mb-4">

                            <label asp-for="RequiredSampleType"
                                   class="form-label fw-semibold">

                                Required Sample Type

                            </label>

                            <select asp-for="RequiredSampleType"
                                    class="form-select">

                                <option value="">
                                    -- Select Sample Type --
                                </option>

                                <option value="Whole Blood">
                                    Whole Blood
                                </option>

                                <option value="Bone Marrow">
                                    Bone Marrow
                                </option>

                                <option value="Plasma">
                                    Plasma
                                </option>

                                <option value="Serum">
                                    Serum
                                </option>

                                <option value="Urine">
                                    Urine
                                </option>

                                <option value="CSF">
                                    Cerebrospinal Fluid
                                </option>

                            </select>

                            <span asp-validation-for="RequiredSampleType"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- UNIT -->

                        <div class="mb-4">

                            <label asp-for="UnitOfMeasurement"
                                   class="form-label fw-semibold">

                                Unit of Measurement

                            </label>

                            <select asp-for="UnitOfMeasurement"
                                    class="form-select">

                                <option value="">
                                    -- Select Unit --
                                </option>

                                <option value="µL">µL</option>
                                <option value="mcL">mcL</option>
                                <option value="g/dL">g/dL</option>
                                <option value="g/L">g/L</option>
                                <option value="g/mL">g/mL</option>
                                <option value="k/µL">k/µL</option>
                                <option value="x10³/µL">x10³/µL</option>
                                <option value="mmol/L">mmol/L</option>
                                <option value="mg/dL">mg/dL</option>
                                <option value="%">%</option>

                            </select>

                        </div>


                        <!-- REFERENCE RANGE -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">
                                Normal / Reference Range
                            </label>

                            <div class="row g-3">

                                <div class="col-md-6">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            Min
                                        </span>

                                        <input asp-for="ReferenceRangeLow"
                                               class="form-control"
                                               type="number"
                                               step="0.01" />

                                    </div>

                                    <span asp-validation-for="ReferenceRangeLow"
                                          class="text-danger">
                                    </span>

                                </div>


                                <div class="col-md-6">

                                    <div class="input-group">

                                        <span class="input-group-text">
                                            Max
                                        </span>

                                        <input asp-for="ReferenceRangeHigh"
                                               class="form-control"
                                               type="number"
                                               step="0.01" />

                                    </div>

                                    <span asp-validation-for="ReferenceRangeHigh"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- TURNAROUND -->

                        <div>

                            <label asp-for="TurnaroundTimeHours"
                                   class="form-label fw-semibold">

                                Turnaround Time

                            </label>

                            <div class="input-group">

                                <input asp-for="TurnaroundTimeHours"
                                       class="form-control"
                                       type="number"
                                       min="1" />

                                <span class="input-group-text">
                                    Hours
                                </span>

                            </div>

                            <span asp-validation-for="TurnaroundTimeHours"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- RIGHT SIDE -->

            <div class="col-lg-4">

                <!-- CONSUMABLES -->

                <div class="card border-0 shadow-sm">

                    <div class="card-header bg-white py-3">

                        <h5 class="fw-bold mb-1">

                            <i class="fa-solid fa-boxes-stacked me-2 text-primary"></i>

                            Consumables

                        </h5>

                        <small class="text-muted">
                            Select the consumables required to perform one test.
                        </small>

                    </div>


                    <div class="card-body">

                        @if (consumables != null && consumables.Any())
                        {
                            foreach (var consumable in consumables)
                            {
                                <div class="border rounded-3 p-3 mb-3">

                                    <div class="form-check">

                                        <input class="form-check-input"
                                               type="checkbox"
                                               name="SelectedConsumableIds"
                                               value="@consumable.ConsumableID"
                                               id="consumable_@consumable.ConsumableID" />

                                        <label class="form-check-label fw-semibold"
                                               for="consumable_@consumable.ConsumableID">

                                            @consumable.Name

                                        </label>

                                    </div>


                                    <div class="mt-2">

                                        <label class="form-label small text-muted">
                                            Quantity per test
                                        </label>

                                        <input type="number"
                                               name="ConsumableQuantities"
                                               value="1"
                                               min="1"
                                               class="form-control" />

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">

                                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                                No consumables are currently available.

                            </div>
                        }

                    </div>

                </div>


                <!-- BUTTONS -->

                <div class="d-grid gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-primary btn-lg">

                        <i class="fa-solid fa-check me-2"></i>

                        Create Test Type

                    </button>

                    <a asp-action="Index"
                       class="btn btn-light btn-lg">

                        Cancel

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}