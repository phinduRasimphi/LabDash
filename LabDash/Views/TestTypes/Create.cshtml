@model LabDash.Models.TestType

@{
    ViewData["Title"] = "Create Test Type";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var consumables =
        ViewBag.Consumables as IEnumerable<LabDash.Models.Consumable>;
}

<style>

    .test-page {
        padding: 30px;
    }

    .page-title {
        font-size: 28px;
        font-weight: 700;
        color: #134e4a;
    }

    .page-subtitle {
        color: #64748b;
    }

    .card {
        border: none;
        border-radius: 12px;
        box-shadow: 0 3px 12px rgba(0,0,0,0.06);
    }

    .card-header {
        background: white;
        border-bottom: 1px solid #e2e8f0;
        border-radius: 12px 12px 0 0 !important;
    }

    .section-icon {
        color: #0f766e;
    }

    .form-control,
    .form-select {
        border-radius: 8px;
        padding: 11px 13px;
        border: 1px solid #cbd5e1;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 0.2rem rgba(15,118,110,.15);
        }

    .btn-teal {
        background: #0f766e;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 12px;
        font-weight: 600;
    }

        .btn-teal:hover {
            background: #115e59;
            color: white;
        }

    .consumable-item {
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 14px;
        margin-bottom: 12px;
        transition: 0.2s ease;
    }

        .consumable-item:hover {
            background: #f0fdfa;
            border-color: #99f6e4;
        }

        .consumable-item.selected {
            background: #f0fdfa;
            border-color: #0f766e;
        }

    .quantity-input:disabled {
        background-color: #f1f5f9;
        cursor: not-allowed;
    }

    .consumable-help {
        font-size: 12px;
        color: #64748b;
        margin-top: 5px;
    }

</style>


<div class="test-page">

    <!-- ========================================================= -->
    <!-- HEADER -->
    <!-- ========================================================= -->

    <div class="mb-4">

        <a asp-action="Index"
           class="text-decoration-none"
           style="color:#0f766e;">

            <i class="fa-solid fa-arrow-left me-2"></i>

            Back to Test Types

        </a>

        <h1 class="page-title mt-3 mb-1">
            Create Test Type
        </h1>

        <p class="page-subtitle">
            Add a new laboratory test to the test catalogue.
        </p>

    </div>


    <!-- ========================================================= -->
    <!-- FORM -->
    <!-- ========================================================= -->

    <form asp-action="Create"
          method="post"
          id="createTestTypeForm">

        @Html.AntiForgeryToken()


        <!-- VALIDATION SUMMARY -->

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger">
        </div>


        <div class="row g-4">


            <!-- ================================================= -->
            <!-- TEST INFORMATION -->
            <!-- ================================================= -->

            <div class="col-lg-8">

                <div class="card">

                    <div class="card-header py-3">

                        <h5 class="fw-bold mb-0">

                            <i class="fa-solid fa-flask section-icon me-2"></i>

                            Test Information

                        </h5>

                    </div>


                    <div class="card-body p-4">


                        <!-- ===================================== -->
                        <!-- TEST NAME -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label asp-for="Name"
                                   class="form-label fw-semibold">

                                Test Name

                            </label>

                            <input asp-for="Name"
                                   class="form-control"
                                   placeholder="Enter test name" />

                            <span asp-validation-for="Name"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ===================================== -->
                        <!-- TEST CATEGORY -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label asp-for="TestCategoryId"
                                   class="form-label fw-semibold">

                                Test Category

                            </label>

                            <select asp-for="TestCategoryId"
                                    asp-items="ViewBag.TestCategoryId"
                                    class="form-select">

                                <option value="">
                                    -- Select Test Category --
                                </option>

                            </select>

                            <span asp-validation-for="TestCategoryId"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ===================================== -->
                        <!-- SAMPLE TYPE -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label asp-for="RequiredSampleType"
                                   class="form-label fw-semibold">

                                Required Sample Type

                            </label>

                            <select asp-for="RequiredSampleType"
                                    asp-items="ViewBag.SampleTypes"
                                    class="form-select">

                                <option value="">
                                    -- Select Sample Type --
                                </option>

                            </select>

                            <span asp-validation-for="RequiredSampleType"
                                  class="text-danger">
                            </span>

                            <small class="text-muted">

                                <i class="fa-solid fa-circle-info me-1"></i>

                                Sample types are managed through the Sample Type Lookup.

                            </small>

                        </div>


                        <!-- ===================================== -->
                        <!-- UNIT OF MEASUREMENT -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label asp-for="UnitOfMeasurement"
                                   class="form-label fw-semibold">

                                Unit of Measurement

                            </label>

                            <select asp-for="UnitOfMeasurement"
                                    class="form-select">

                                <option value="">
                                    -- Select Unit --
                                </option>

                                <option value="µL">µL</option>
                                <option value="mcL">mcL</option>
                                <option value="g/dL">g/dL</option>
                                <option value="g/L">g/L</option>
                                <option value="g/mL">g/mL</option>
                                <option value="k/µL">k/µL</option>
                                <option value="x10³/µL">x10³/µL</option>
                                <option value="mmol/L">mmol/L</option>
                                <option value="mg/dL">mg/dL</option>
                                <option value="%">%</option>

                            </select>

                            <span asp-validation-for="UnitOfMeasurement"
                                  class="text-danger">
                            </span>

                        </div>


                        <!-- ===================================== -->
                        <!-- REFERENCE RANGE -->
                        <!-- ===================================== -->

                        <div class="mb-4">

                            <label class="form-label fw-semibold">

                                Normal / Reference Range

                            </label>

                            <div class="row g-3">


                                <!-- MINIMUM -->

                                <div class="col-md-6">

                                    <label asp-for="ReferenceRangeLow"
                                           class="form-label">

                                        Minimum

                                    </label>

                                    <input asp-for="ReferenceRangeLow"
                                           type="number"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="Minimum value" />

                                    <span asp-validation-for="ReferenceRangeLow"
                                          class="text-danger">
                                    </span>

                                </div>


                                <!-- MAXIMUM -->

                                <div class="col-md-6">

                                    <label asp-for="ReferenceRangeHigh"
                                           class="form-label">

                                        Maximum

                                    </label>

                                    <input asp-for="ReferenceRangeHigh"
                                           type="number"
                                           step="0.01"
                                           class="form-control"
                                           placeholder="Maximum value" />

                                    <span asp-validation-for="ReferenceRangeHigh"
                                          class="text-danger">
                                    </span>

                                </div>

                            </div>

                        </div>


                        <!-- ===================================== -->
                        <!-- TURNAROUND TIME -->
                        <!-- ===================================== -->

                        <div class="mb-2">

                            <label asp-for="TurnaroundTimeHours"
                                   class="form-label fw-semibold">

                                Turnaround Time

                            </label>

                            <div class="input-group">

                                <input asp-for="TurnaroundTimeHours"
                                       type="number"
                                       min="1"
                                       class="form-control"
                                       placeholder="Enter time" />

                                <span class="input-group-text">

                                    Hours

                                </span>

                            </div>

                            <span asp-validation-for="TurnaroundTimeHours"
                                  class="text-danger">
                            </span>

                        </div>

                    </div>

                </div>

            </div>


            <!-- ================================================= -->
            <!-- CONSUMABLES -->
            <!-- ================================================= -->

            <div class="col-lg-4">

                <div class="card">

                    <div class="card-header py-3">

                        <h5 class="fw-bold mb-1">

                            <i class="fa-solid fa-boxes-stacked section-icon me-2"></i>

                            Consumables

                        </h5>

                        <small class="text-muted">

                            Select the consumables used for this test.

                        </small>

                    </div>


                    <div class="card-body p-4">


                        @if (consumables != null && consumables.Any())
                        {
                            foreach (var consumable in consumables)
                            {
                                <div class="consumable-item"
                                     data-consumable-container>

                                    <!-- CHECKBOX -->

                                    <div class="form-check">

                                        <input class="form-check-input consumable-checkbox"
                                               type="checkbox"
                                               name="SelectedConsumableIds"
                                               value="@consumable.ConsumableID"
                                               id="consumable_@consumable.ConsumableID" />

                                        <label class="form-check-label fw-semibold"
                                               for="consumable_@consumable.ConsumableID">

                                            @consumable.Name

                                        </label>

                                    </div>


                                    <!-- QUANTITY -->

                                    <div class="mt-2">

                                        <label class="form-label small text-muted">

                                            Quantity per test

                                        </label>

                                        <input type="number"
                                               name="ConsumableQuantities"
                                               value="1"
                                               min="1"
                                               class="form-control quantity-input"
                                               disabled />

                                        <div class="consumable-help">

                                            Select the consumable first.

                                        </div>

                                    </div>

                                </div>
                            }
                        }
                        else
                        {
                            <div class="alert alert-warning">

                                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                                No consumables have been added yet.

                            </div>
                        }

                    </div>

                </div>


                <!-- ================================================= -->
                <!-- BUTTONS -->
                <!-- ================================================= -->

                <div class="d-grid gap-2 mt-4">

                    <button type="submit"
                            class="btn btn-teal">

                        <i class="fa-solid fa-save me-2"></i>

                        Create Test Type

                    </button>


                    <a asp-action="Index"
                       class="btn btn-light">

                        Cancel

                    </a>

                </div>

            </div>

        </div>

    </form>

</div>


<!-- ============================================================= -->
<!-- JAVASCRIPT -->
<!-- ============================================================= -->
@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }


    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const checkboxes =
                document.querySelectorAll(".consumable-checkbox");


            checkboxes.forEach(function(checkbox) {

                checkbox.addEventListener("change", function() {

                    const container =
                        checkbox.closest("[data-consumable-container]");

                    const quantityInput =
                        container.querySelector(".quantity-input");

                    const helpText =
                        container.querySelector(".consumable-help");


                    if (checkbox.checked) {

                        // Enable quantity input
                        quantityInput.disabled = false;

                        // Highlight selected consumable
                        container.classList.add("selected");

                        // Update help text
                        helpText.textContent =
                            "Enter the quantity required for one test.";

                    }
                    else {

                        // Disable quantity input
                        quantityInput.disabled = true;

                        // Reset quantity
                        quantityInput.value = 1;

                        // Remove highlight
                        container.classList.remove("selected");

                        // Update help text
                        helpText.textContent =
                            "Select the consumable first.";

                    }

                });

            });


            // =====================================================
            // FORM VALIDATION
            // =====================================================

            const form =
                document.getElementById("createTestTypeForm");


            form.addEventListener("submit", function(event) {

                const selectedConsumables =
                    document.querySelectorAll(
                        ".consumable-checkbox:checked"
                    );


                let valid = true;


                selectedConsumables.forEach(function(checkbox) {

                    const container =
                        checkbox.closest(
                            "[data-consumable-container]"
                        );

                    const quantityInput =
                        container.querySelector(
                            ".quantity-input"
                        );


                    const quantity =
                        parseInt(quantityInput.value);


                    if (isNaN(quantity) || quantity <= 0) {

                        valid = false;

                        quantityInput.classList.add(
                            "is-invalid"
                        );

                    }
                    else {

                        quantityInput.classList.remove(
                            "is-invalid"
                        );

                    }

                });


                if (!valid) {

                    event.preventDefault();

                    alert(
                        "Please enter a quantity greater than zero for every selected consumable."
                    );

                }

            });

        });

    </script>

}