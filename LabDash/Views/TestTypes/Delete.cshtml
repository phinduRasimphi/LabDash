@model LabDash.Models.TestType

@{
    ViewData["Title"] = "Delete Test Type";
}

<div class="container-fluid py-5">

    <div class="row justify-content-center">

        <div class="col-lg-7">

            <div class="card border-0 shadow-sm">


                <!-- HEADER -->

                <div class="card-header bg-danger text-white py-4">

                    <div class="d-flex align-items-center">

                        <div class="rounded-circle bg-white
                            text-danger d-flex
                            align-items-center
                            justify-content-center me-3"
                             style="width:55px;height:55px;">

                            <i class="fa-solid fa-trash fs-4"></i>

                        </div>

                        <div>

                            <h4 class="mb-1 fw-bold">
                                Delete Test Type
                            </h4>

                            <p class="mb-0 opacity-75">
                                This action cannot be undone.
                            </p>

                        </div>

                    </div>

                </div>


                <!-- BODY -->

                <div class="card-body p-4">

                    <div class="alert alert-warning">

                        <i class="fa-solid fa-triangle-exclamation me-2"></i>

                        Are you sure you want to delete this test type?

                    </div>


                    <!-- TEST -->

                    <div class="border rounded-3 p-4 mb-4">

                        <h4 class="fw-bold mb-3">
                            @Model.Name
                        </h4>


                        <div class="row g-3">

                            <div class="col-md-6">

                                <small class="text-muted">
                                    Category
                                </small>

                                <div class="fw-semibold">

                                    @(Model.TestCategory?.CategoryName
                                        ?? "Not assigned")

                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Sample Type
                                </small>

                                <div class="fw-semibold">
                                    @Model.RequiredSampleType
                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Turnaround Time
                                </small>

                                <div class="fw-semibold">
                                    @Model.TurnaroundTimeHours hours
                                </div>

                            </div>


                            <div class="col-md-6">

                                <small class="text-muted">
                                    Technicians
                                </small>

                                <div class="fw-semibold">

                                    @(Model.TechnicianTestTypes?.Count ?? 0)

                                </div>

                            </div>

                        </div>

                    </div>


                    <!-- WARNING -->
                    @if (Model.TechnicianTestTypes != null &&
                                             Model.TechnicianTestTypes.Any())
                    {
                        <div class="alert alert-info">

                            <i class="fa-solid fa-circle-info me-2"></i>

                            This test type currently has
                            <strong>
                                @Model.TechnicianTestTypes.Count
                            </strong>
                            technician assignment(s).

                            These assignments will also be removed.

                        </div>
                    }


                    @if (Model.TestTypeConsumables != null &&
                         Model.TestTypeConsumables.Any())
                    {
                        <div class="alert alert-info">

                            <i class="fa-solid fa-boxes-stacked me-2"></i>

                            This test type has
                            <strong>
                                @Model.TestTypeConsumables.Count
                            </strong>
                            consumable relationship(s).

                        </div>
                    }


                    <!-- FORM -->

                    <form asp-action="Delete"
                          method="post">

                        @Html.AntiForgeryToken()

                        <input type="hidden"
                               asp-for="Id" />


                        <div class="d-flex justify-content-end gap-2">

                            <a asp-action="Index"
                               class="btn btn-light px-4">

                                Cancel

                            </a>


                            <button type="submit"
                                    class="btn btn-danger px-4">

                                <i class="fa-solid fa-trash me-2"></i>

                                Delete Test Type

                            </button>

                        </div>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>
