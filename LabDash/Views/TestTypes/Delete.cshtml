@model LabDash.Models.TestType

@{
    ViewData["Title"] = "Delete Test Type";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>

    .delete-page {
        padding: 40px;
        max-width: 800px;
        margin: auto;
    }

    .delete-card {
        background: white;
        border: none;
        border-radius: 14px;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .delete-header {
        background: #fef2f2;
        padding: 25px;
        text-align: center;
    }

    .delete-icon {
        width: 70px;
        height: 70px;
        background: #fee2e2;
        color: #dc2626;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: auto;
        font-size: 30px;
    }

    .delete-title {
        color: #134e4a;
        font-weight: 700;
    }

    .detail-box {
        background: #f8fafc;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 20px;
    }

    .btn-danger-custom {
        background: #dc2626;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 11px 22px;
        font-weight: 600;
    }

        .btn-danger-custom:hover {
            background: #b91c1c;
            color: white;
        }

</style>


<div class="delete-page">

    <div class="delete-card">

        <div class="delete-header">

            <div class="delete-icon">

                <i class="fa-solid fa-trash"></i>

            </div>

            <h3 class="delete-title mt-3">
                Delete Test Type?
            </h3>

            <p class="text-muted mb-0">
                Are you sure you want to delete this test type?
            </p>

        </div>


        <div class="p-4">

            <div class="detail-box">

                <div class="row g-3">

                    <div class="col-md-6">

                        <small class="text-muted">
                            Test Name
                        </small>

                        <div class="fw-bold">
                            @Model.Name
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Category
                        </small>

                        <div class="fw-bold">

                            @(Model.TestCategory?.CategoryName
                              ?? "Not assigned")

                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Sample Type
                        </small>

                        <div class="fw-bold">
                            @Model.RequiredSampleType
                        </div>

                    </div>


                    <div class="col-md-6">

                        <small class="text-muted">
                            Unit
                        </small>

                        <div class="fw-bold">
                            @Model.UnitOfMeasurement
                        </div>

                    </div>

                </div>

            </div>


            <div class="alert alert-warning">

                <i class="fa-solid fa-triangle-exclamation me-2"></i>

                A test type that has already been used in a test request
                cannot be deleted.

            </div>


            <form asp-action="Delete"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="Id" />


                <div class="d-flex justify-content-end gap-2">

                    <a asp-action="Index"
                       class="btn btn-light">

                        Cancel

                    </a>

                    <button type="submit"
                            class="btn-danger-custom">

                        <i class="fa-solid fa-trash me-2"></i>

                        Delete Test Type

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>
