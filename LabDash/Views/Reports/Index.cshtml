@model LabDash.Models.ViewModels.TechnicianReportViewModel

@{
    ViewData["Title"] = "Technician Reports";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="records-box">

    <div style="padding:20px;border-bottom:1px solid #eee;">

        <h2 style="color:#0d766e;">

            <i class="fa-solid fa-file-pdf"></i>

            Technician Reports

        </h2>

        <p style="color:gray;">
            Generate a report of completed laboratory tests within a selected date range.
        </p>

    </div>

    <div style="padding:30px;">

        @if (TempData["Error"] != null)
        {
            <div class="alert alert-danger">
                @TempData["Error"]
            </div>
        }

        <form asp-action="Generate" method="post">

            <div class="row">

                <div class="col-md-6">

                    <label asp-for="FromDate" class="form-label"></label>

                    <input asp-for="FromDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="FromDate"
                          class="text-danger"></span>

                </div>

                <div class="col-md-6">

                    <label asp-for="ToDate" class="form-label"></label>

                    <input asp-for="ToDate"
                           type="date"
                           class="form-control" />

                    <span asp-validation-for="ToDate"
                          class="text-danger"></span>

                </div>

            </div>

            <br />

            <button class="btn btn-success">

                <i class="fa-solid fa-file-pdf"></i>

                Generate PDF Report

            </button>

        </form>

    </div>

</div>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}