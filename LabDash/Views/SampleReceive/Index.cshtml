@model IEnumerable<LabDash.Models.SampleReceive>

@{
    ViewData["Title"] = "Received Samples";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    // South Africa Standard Time — adjust the ID if this app is deployed
    // across multiple timezones and should instead use the current user's TZ.
    var localTz = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --ink: #0f2f2d;
        --muted: #6b817f;
        --line: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
        --radius-lg: 20px;
        --shadow-soft: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
    }

    .src-body-bg,
    .src-body-bg * {
        box-sizing: border-box;
    }

    .src-body-bg {
        background: var(--page-bg);
        color: var(--ink);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    .src-page-container {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
    }

    /*================ HERO HEADER =================*/

    .src-page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .src-header-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .src-page-header h2 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .src-page-header p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .src-header-stat {
        min-width: 150px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

        .src-header-stat span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .src-header-stat strong {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

    /*================ STATISTICS =================*/

    .src-stats-row {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .src-stat-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 24px;
        background: #fff;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .src-stat-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--teal);
        background: var(--teal-light);
        font-size: 22px;
    }

    .src-stat-card h2 {
        margin: 0;
        color: var(--teal-dark);
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.5px;
    }

    .src-stat-card p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
    }

    /*================ TABLE CARD =================*/

    .src-page-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .src-toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 18px 26px;
        border-bottom: 1px solid var(--line);
    }

        .src-toolbar h4 {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 0;
            color: var(--ink);
            font-family: "Inter", sans-serif;
            font-size: 17px;
            font-weight: 700;
        }

            .src-toolbar h4 > i {
                color: var(--teal);
                font-size: 16px;
            }

    .src-count-pill {
        padding: 4px 12px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .src-search-box {
        position: relative;
        width: 340px;
        max-width: 100%;
    }

        .src-search-box i {
            position: absolute;
            top: 50%;
            left: 17px;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
        }

        .src-search-box input {
            width: 100%;
            height: 46px;
            padding: 0 16px 0 44px;
            color: var(--ink);
            background: var(--field-bg);
            border: 1px solid var(--teal-border);
            border-radius: 999px;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }

            .src-search-box input::placeholder {
                color: #8aa09e;
            }

            .src-search-box input:focus {
                background: #fff;
                border-color: var(--teal);
                box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
            }

    /*================ TABLE =================*/

    .src-table-scroll {
        overflow-x: auto;
    }

    .src-table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .src-table thead th {
            padding: 15px 20px;
            color: var(--teal-dark);
            background: var(--teal-light);
            border: none;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
            text-align: left;
            text-transform: uppercase;
            vertical-align: middle;
            white-space: nowrap;
        }

        .src-table td {
            padding: 18px 20px;
            color: var(--ink);
            background: #fff;
            border-bottom: 1px solid var(--line);
            font-size: 14px;
            text-align: left;
            vertical-align: middle;
        }

        .src-table tbody tr:hover td {
            background: var(--teal-soft);
        }

    .src-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        flex-shrink: 0;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #d5c98a;
        color: var(--teal-dark);
        font-weight: 700;
        font-size: 12px;
    }

    .src-technician-cell {
        display: flex;
        align-items: center;
        gap: 10px;
        font-weight: 600;
    }

    .src-barcode-text {
        font-family: "Consolas", monospace;
        font-weight: 700;
        color: var(--teal-dark);
        letter-spacing: .5px;
    }

    .src-badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .src-badge-sample {
        color: var(--success);
        background: var(--success-soft);
    }

    .src-badge-received {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .src-badge-partial {
        color: var(--warning);
        background: var(--warning-soft);
    }

    .src-badge-default {
        color: #607572;
        background: #edf4f3;
    }

    .src-date-primary {
        font-weight: 600;
        color: var(--ink);
    }

    .src-date-secondary {
        margin-top: 2px;
        color: var(--muted);
        font-size: 12px;
    }

    .src-empty-row {
        padding: 60px 20px !important;
        text-align: center !important;
        color: var(--muted);
    }

        .src-empty-row i {
            margin-bottom: 14px;
            color: var(--teal);
            opacity: .85;
        }

        .src-empty-row h5 {
            margin: 0 0 4px;
            color: var(--ink);
            font-size: 18px;
            font-weight: 700;
        }

        .src-empty-row p {
            margin: 0;
        }

    /*================ RESPONSIVE =================*/

    @@media (max-width: 992px) {

        .src-stats-row {
            grid-template-columns: 1fr;
        }

        .src-header-stat {
            display: none;
        }

        .src-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .src-search-box {
            width: 100%;
        }
    }

    @@media (max-width: 576px) {

        .src-page-container {
            padding: 12px 9px 28px;
        }

        .src-page-header {
            padding: 18px;
            border-radius: 20px;
        }

            .src-page-header h2 {
                font-size: 19px;
            }

        .src-toolbar {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

</style>

<div class="src-body-bg">

    <div class="src-page-container">

        <div class="src-page-header">

            <div class="src-header-icon">
                <i class="fas fa-flask"></i>
            </div>

            <div>
                <h2>Received Samples</h2>
                <p>View all laboratory samples that have been successfully received.</p>
            </div>

            <div class="src-header-stat">
                <span>Total received</span>
                <strong>@Model.Count()</strong>
            </div>

        </div>

        <div class="src-stats-row">

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-vials"></i>
                </div>

                <div>
                    <h2>@Model.Count()</h2>
                    <p>Total Samples Received</p>
                </div>

            </div>

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-barcode"></i>
                </div>

                <div>
                    <h2>@Model.Select(x => x.SampleBarcode).Distinct().Count()</h2>
                    <p>Unique Barcodes</p>
                </div>

            </div>

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-user-nurse"></i>
                </div>

                <div>
                    <h2>@Model.Select(x => x.TechnicianName).Distinct().Count()</h2>
                    <p>Technicians</p>
                </div>

            </div>

        </div>

        <div class="src-page-card">

            <div class="src-toolbar">

                <h4>
                    <i class="fas fa-clipboard-list"></i>
                    All Received Samples
                    <span class="src-count-pill">
                        @Model.Count() record@(Model.Count() == 1 ? "" : "s")
                    </span>
                </h4>

                <div class="src-search-box">

                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="srcSearchInput"
                           class="form-control"
                           placeholder="Search request, barcode or technician..."
                           aria-label="Search received samples" />

                </div>

            </div>

            <div class="src-table-scroll">
                <table class="src-table">

                    <thead>

                        <tr>

                            <th>Request ID</th>

                            <th>Barcode</th>

                            <th>Sample Type</th>

                            <th>Received By</th>

                            <th>Date &amp; Time Received</th>

                            <th>Sample Status</th>

                            <th>Request Status</th>

                        </tr>

                    </thead>

                    <tbody>

                        @if (Model.Any())
                        {
                            foreach (var item in Model)
                            {
                                var techName = string.IsNullOrWhiteSpace(item.TechnicianName)
                                    ? "Unknown"
                                    : item.TechnicianName;

                                var initials = string.Join("", techName
                                                                .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                                .Take(2)
                                                                .Select(n => n[0]))
                                                                .ToUpper();

                                if (string.IsNullOrEmpty(initials))
                                {
                                    initials = "?";
                                }

                                // Stored as UTC in the database (see SampleReceiveController) —
                                // convert to local time for display.
                                var localReceived = TimeZoneInfo.ConvertTimeFromUtc(
                                    DateTime.SpecifyKind(item.DateTimeReceived, DateTimeKind.Utc),
                                    localTz);

                                var requestStatus = item.TestRequest?.Status ?? "Unknown";

                                var requestBadgeClass = requestStatus switch
                                {
                                    "Samples Received" => "src-badge-received",
                                    "Partially Received" => "src-badge-partial",
                                    _ => "src-badge-default"
                                };

                                var requestIcon = requestStatus switch
                                {
                                    "Samples Received" => "fa-check-circle",
                                    "Partially Received" => "fa-hourglass-half",
                                    _ => "fa-question-circle"
                                };

                                <tr>

                                    <td><strong>#@item.RequestId</strong></td>

                                    <td>
                                        <span class="src-barcode-text">@item.SampleBarcode</span>
                                    </td>

                                    <td>@item.SampleType</td>

                                    <td>
                                        <div class="src-technician-cell">
                                            <span class="src-avatar">@initials</span>
                                            @techName
                                        </div>
                                    </td>

                                    <td>
                                        <div class="src-date-primary">@localReceived.ToString("dd MMM yyyy")</div>
                                        <div class="src-date-secondary">@localReceived.ToString("HH:mm")</div>
                                    </td>

                                    <td>
                                        <span class="src-badge-status src-badge-sample">
                                            <i class="fas fa-check-circle"></i>
                                            @item.Status
                                        </span>
                                    </td>

                                    <td>
                                        <span class="src-badge-status @requestBadgeClass">
                                            <i class="fas @requestIcon"></i>
                                            @requestStatus
                                        </span>
                                    </td>

                                </tr>
                            }
                        }
                        else
                        {
                            <tr>

                                <td colspan="7" class="src-empty-row">

                                    <i class="fas fa-inbox fa-3x mb-3"></i>

                                    <h5>No Samples Found</h5>

                                    <p>No laboratory samples have been received yet.</p>

                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput = document.getElementById("srcSearchInput");

            if (searchInput) {

                searchInput.addEventListener("keyup", function() {

                    const filter = this.value.toLowerCase();

                    const rows = document.querySelectorAll(".src-table tbody tr");

                    rows.forEach(function(row) {

                        const text = row.innerText.toLowerCase();

                        if (text.indexOf(filter) > -1) {
                            row.style.display = "";
                        }
                        else {
                            row.style.display = "none";
                        }

                    });

                });

            }

        });

    </script>

}