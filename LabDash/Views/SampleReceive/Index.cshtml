@model IEnumerable<LabDash.Models.SampleReceive>

@{
    ViewData["Title"] = "Received Samples";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    body {
        background: #eef7f8;
        font-family: 'Segoe UI', sans-serif;
    }

    .page-container {
        max-width: 1200px;
        margin: 35px auto;
    }

    .page-card {
        background: white;
        border-radius: 12px;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
        overflow: hidden;
    }

    .page-header {
        background: #009688;
        color: white;
        padding: 18px 25px;
    }

        .page-header h2 {
            margin: 0;
            font-size: 28px;
            font-weight: 600;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: #00897B;
            color: white;
        }

        .table th {
            text-align: center;
            vertical-align: middle;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
        }

    .badge-status {
        background: #009688;
        color: white;
        padding: 7px 14px;
        border-radius: 20px;
        font-size: 13px;
    }

    .empty-row {
        padding: 30px;
        text-align: center;
        color: gray;
    }
</style>

<div class="page-container">

    <div class="page-card">

        <div class="page-header">
            <h2>Received Samples</h2>
        </div>

        <table class="table table-hover table-bordered">

            <thead>

                <tr>
                    <th>Request ID</th>
                    <th>Barcode</th>
                    <th>Sample Type</th>
                    <th>Received By</th>
                    <th>Date & Time Received</th>
                    <th>Status</th>
                </tr>

            </thead>

            <tbody>

                @if (Model.Any())
                {
                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>@item.RequestId</td>

                            <td>@item.SampleBarcode</td>

                            <td>@item.SampleType</td>

                            <td>@item.TechnicianName</td>

                            <td>@item.DateTimeReceived.ToString("dd MMM yyyy HH:mm")</td>

                            <td>
                                <span class="badge-status">
                                    @item.Status
                                </span>
                            </td>

                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="6" class="empty-row">
                            No samples have been received yet.
                        </td>
                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>