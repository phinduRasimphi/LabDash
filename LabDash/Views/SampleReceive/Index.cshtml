@model IEnumerable<LabDash.Models.SampleReceive>

@{
    ViewData["Title"] = "Received Samples";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    // South Africa Standard Time — adjust the ID if this app is deployed
    // across multiple timezones and should instead use the current user's TZ.
    var localTz = TimeZoneInfo.FindSystemTimeZoneById("South Africa Standard Time");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    .src-body-bg {
        background: #eef7f8;
        font-family: "Segoe UI", sans-serif;
    }

    .src-page-container {
        max-width: 1400px;
        margin: 35px auto;
        padding: 0 20px;
    }

    .src-stats-row {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .src-stat-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
        display: flex;
        align-items: center;
        gap: 18px;
        transition: transform .15s ease;
    }

        .src-stat-card:hover {
            transform: translateY(-2px);
        }

    .src-stat-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: rgba(0,150,136,.10);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
        color: #009688;
        flex-shrink: 0;
    }

    .src-stat-card h2 {
        margin: 0;
        color: #00695C;
        font-size: 30px;
        font-weight: 700;
    }

    .src-stat-card p {
        margin: 4px 0 0;
        color: #777;
        font-size: 15px;
    }

    .src-page-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 30px rgba(0,0,0,.08);
    }

    .src-page-header {
        background: linear-gradient(135deg, #00897B 0%, #00695C 100%);
        color: white;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
    }

        .src-page-header h2 {
            margin: 0;
            font-size: 32px;
            font-weight: 700;
        }

        .src-page-header p {
            margin: 6px 0 0;
            opacity: .9;
            font-size: 14.5px;
        }

    .src-count-pill {
        background: rgba(255,255,255,.18);
        border-radius: 30px;
        padding: 10px 20px;
        font-weight: 600;
        font-size: 14px;
        white-space: nowrap;
    }

    .src-toolbar {
        padding: 22px 30px;
        border-bottom: 1px solid #ececec;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        flex-wrap: wrap;
    }

    .src-search-box {
        width: 350px;
        position: relative;
    }

        .src-search-box i {
            position: absolute;
            left: 15px;
            top: 16px;
            color: #888;
        }

        .src-search-box input {
            padding-left: 42px;
            border-radius: 10px;
            height: 48px;
            border: 1px solid #dde5e5;
        }

            .src-search-box input:focus {
                border-color: #009688;
                box-shadow: 0 0 0 3px rgba(0,150,136,.12);
                outline: none;
            }

    .src-table {
        margin: 0;
        width: 100%;
        border-collapse: collapse;
    }

        .src-table thead {
            background: #00897B;
            color: white;
        }

        .src-table th {
            padding: 18px;
            border: none;
            text-align: center;
            vertical-align: middle;
            font-weight: 600;
            font-size: 13.5px;
            text-transform: uppercase;
            letter-spacing: .4px;
        }

        .src-table td {
            padding: 16px 18px;
            text-align: center;
            vertical-align: middle;
            border-bottom: 1px solid #f0f0f0;
        }

        .src-table tbody tr:hover {
            background: #f7fbfb;
        }

    .src-avatar {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        width: 34px;
        height: 34px;
        border-radius: 50%;
        background: rgba(0,150,136,.12);
        color: #00695C;
        font-weight: 700;
        font-size: 13px;
        margin-right: 8px;
        vertical-align: middle;
    }

    .src-technician-cell {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 4px;
    }

    .src-barcode-text {
        font-family: "Consolas", monospace;
        font-weight: 700;
        color: #00695C;
        letter-spacing: .5px;
    }

    .src-badge-status {
        border-radius: 30px;
        padding: 8px 16px;
        font-size: 13px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .src-badge-received {
        background: #009688;
        color: white;
    }

    .src-badge-partial {
        background: #FFA000;
        color: white;
    }

    .src-badge-default {
        background: #90A4AE;
        color: white;
    }

    .src-date-primary {
        font-weight: 600;
        color: #333;
    }

    .src-date-secondary {
        color: #999;
        font-size: 12.5px;
    }

    .src-empty-row {
        text-align: center;
        color: #888;
        padding: 60px 20px;
    }

        .src-empty-row i {
            color: #cfe3e2;
        }

        .src-empty-row h5 {
            color: #555;
            margin-top: 10px;
        }

    @@media(max-width:992px) {

        .src-stats-row {
            grid-template-columns: 1fr;
        }

        .src-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .src-search-box {
            width: 100%;
        }
    }

</style>

<div class="src-body-bg">

    <div class="src-page-container">

        <div class="src-stats-row">

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-vials"></i>
                </div>

                <div>
                    <h2>@Model.Count()</h2>
                    <p>Total Samples Received</p>
                </div>

            </div>

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-barcode"></i>
                </div>

                <div>
                    <h2>@Model.Select(x => x.SampleBarcode).Distinct().Count()</h2>
                    <p>Unique Barcodes</p>
                </div>

            </div>

            <div class="src-stat-card">

                <div class="src-stat-icon">
                    <i class="fas fa-user-nurse"></i>
                </div>

                <div>
                    <h2>@Model.Select(x => x.TechnicianName).Distinct().Count()</h2>
                    <p>Technicians</p>
                </div>

            </div>

        </div>

        <div class="src-page-card">

            <div class="src-page-header">

                <div>

                    <h2>
                        <i class="fas fa-flask"></i>
                        Received Samples
                    </h2>

                    <p>
                        View all laboratory samples that have been successfully received.
                    </p>

                </div>

                <div class="src-count-pill">
                    <i class="fas fa-clipboard-list"></i>
                    @Model.Count() record@(Model.Count() == 1 ? "" : "s")
                </div>

            </div>

            <div class="src-toolbar">

                <div class="src-search-box">

                    <i class="fas fa-search"></i>

                    <input type="text"
                           id="srcSearchInput"
                           class="form-control"
                           placeholder="Search request, barcode or technician..." />

                </div>

            </div>

            <table class="src-table">

                <thead>

                    <tr>

                        <th>Request ID</th>

                        <th>Barcode</th>

                        <th>Sample Type</th>

                        <th>Received By</th>

                        <th>Date &amp; Time Received</th>

                        <th>Sample Status</th>

                        <th>Request Status</th>

                    </tr>

                </thead>

                <tbody>

                    @if (Model.Any())
                    {
                        foreach (var item in Model)
                        {
                            var techName = string.IsNullOrWhiteSpace(item.TechnicianName)
                                ? "Unknown"
                                : item.TechnicianName;

                            var initials = string.Join("", techName
                                                            .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                            .Take(2)
                                                            .Select(n => n[0]))
                                                            .ToUpper();

                            if (string.IsNullOrEmpty(initials))
                            {
                                initials = "?";
                            }

                            // Stored as UTC in the database (see SampleReceiveController) —
                            // convert to local time for display.
                            var localReceived = TimeZoneInfo.ConvertTimeFromUtc(
                                DateTime.SpecifyKind(item.DateTimeReceived, DateTimeKind.Utc),
                                localTz);

                            var requestStatus = item.TestRequest?.Status ?? "Unknown";

                            var requestBadgeClass = requestStatus switch
                            {
                                "Samples Received" => "src-badge-received",
                                "Partially Received" => "src-badge-partial",
                                _ => "src-badge-default"
                            };

                            var requestIcon = requestStatus switch
                            {
                                "Samples Received" => "fa-check-circle",
                                "Partially Received" => "fa-hourglass-half",
                                _ => "fa-question-circle"
                            };

                            <tr>

                                <td>#@item.RequestId</td>

                                <td>
                                    <span class="src-barcode-text">@item.SampleBarcode</span>
                                </td>

                                <td>@item.SampleType</td>

                                <td>
                                    <div class="src-technician-cell">
                                        <span class="src-avatar">@initials</span>
                                        @techName
                                    </div>
                                </td>

                                <td>
                                    <div class="src-date-primary">@localReceived.ToString("dd MMM yyyy")</div>
                                    <div class="src-date-secondary">@localReceived.ToString("HH:mm")</div>
                                </td>

                                <td>
                                    <span class="src-badge-status src-badge-received">
                                        <i class="fas fa-check-circle"></i>
                                        @item.Status
                                    </span>
                                </td>

                                <td>
                                    <span class="src-badge-status @requestBadgeClass">
                                        <i class="fas @requestIcon"></i>
                                        @requestStatus
                                    </span>
                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="7" class="src-empty-row">

                                <i class="fas fa-inbox fa-3x mb-3"></i>

                                <h5>No Samples Found</h5>

                                <p>No laboratory samples have been received yet.</p>

                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>

    </div>

</div>

@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const searchInput = document.getElementById("srcSearchInput");

            if (searchInput) {

                searchInput.addEventListener("keyup", function() {

                    const filter = this.value.toLowerCase();

                    const rows = document.querySelectorAll(".src-table tbody tr");

                    rows.forEach(function(row) {

                        const text = row.innerText.toLowerCase();

                        if (text.indexOf(filter) > -1) {
                            row.style.display = "";
                        }
                        else {
                            row.style.display = "none";
                        }

                    });

                });

            }

        });

    </script>

}