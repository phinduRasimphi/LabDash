@model LabDash.Models.SampleReceive

@{
    ViewData["Title"] = "Receive Patient Sample";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    body {
        background: #eef7f8;
        font-family: "Segoe UI", sans-serif;
    }

    .receive-container {
        max-width: 1050px;
        margin: 35px auto;
    }

    .receive-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.10);
        border: none;
    }

    .receive-header {
        background: #009688;
        color: white;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .header-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,.35);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 34px;
        background: rgba(255,255,255,.08);
    }

    .receive-header h2 {
        margin: 0;
        font-size: 40px;
        font-weight: 700;
    }

    .receive-header p {
        margin: 6px 0 0;
        font-size: 18px;
        opacity: .95;
    }

    .receive-body {
        padding: 40px;
    }

    .form-row {
        display: grid;
        grid-template-columns: 250px 1fr;
        align-items: center;
        gap: 30px;
        padding: 18px 0;
    }

    .notes-row {
        align-items: start;
    }

    .form-label {
        font-size: 17px;
        font-weight: 600;
        color: #2f3e46;
        margin: 0;
    }

        .form-label i {
            color: #009688;
            width: 25px;
            margin-right: 8px;
        }

    hr {
        margin: 0;
        border-color: #ececec;
    }

    .form-control,
    .form-select {
        height: 50px;
        border-radius: 10px;
        border: 1px solid #d9dee3;
        font-size: 15px;
        transition: .25s;
    }

        .form-control:focus,
        .form-select:focus {
            border-color: #009688;
            box-shadow: 0 0 0 .18rem rgba(0,150,136,.15);
        }

    textarea.form-control {
        height: 150px;
        resize: vertical;
    }

    .required {
        color: #dc3545;
    }

    .footer-buttons {
        margin-top: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .btn-clear {
        border: 1px solid #ced4da;
        background: white;
        color: #555;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        transition: .25s;
    }

        .btn-clear:hover {
            background: #f4f4f4;
        }

    .btn-receive {
        background: #009688;
        color: white;
        border: none;
        padding: 13px 35px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        transition: .3s;
    }

        .btn-receive:hover {
            background: #00796B;
            color: white;
            transform: translateY(-2px);
        }

    .validation-summary-errors ul {
        margin-bottom: 20px;
    }

    .text-danger {
        font-size: 14px;
    }

    @@media(max-width:900px) {

        .receive-container {
            padding: 15px;
        }

        .receive-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .form-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .footer-buttons {
            flex-direction: column;
            gap: 15px;
        }

            .footer-buttons button {
                width: 100%;
            }
    }

</style>

<div class="receive-container">

    <div class="receive-card">

        <div class="receive-header">

            <div class="header-left">

                <div class="header-icon">
                    <i class="fas fa-vials"></i>
                </div>

                <div>

                    <h2>Receive Patient Sample</h2>

                    <p>
                        Verify the request and record the received laboratory sample.
                    </p>

                </div>

            </div>

        </div>

        <div class="receive-body">

            <form asp-action="Receive" method="post">

                <div asp-validation-summary="ModelOnly" class="text-danger"></div>

                <!-- Test Request -->

                <div class="form-row">

                    <label asp-for="RequestId" class="form-label">
                        <i class="fas fa-clipboard-list"></i>
                        Test Request
                        <span class="required">*</span>
                    </label>

                    <div>

                        <select asp-for="RequestId"
                                asp-items="ViewBag.RequestList"
                                class="form-select">

                            <option value="">-- Select Test Request --</option>

                        </select>

                        <span asp-validation-for="RequestId"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr />

                <!-- Technician -->

                <div class="form-row">

                    <label asp-for="TechnicianName" class="form-label">
                        <i class="fas fa-user"></i>
                        Technician Receiving Sample
                    </label>

                    <div>

                        <input asp-for="TechnicianName"
                               class="form-control"
                               placeholder="Enter technician name" />

                        <span asp-validation-for="TechnicianName"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr />

                <!-- Barcode -->

                <div class="form-row">

                    <label asp-for="SampleBarcode" class="form-label">
                        <i class="fas fa-barcode"></i>
                        Sample Barcode
                    </label>

                    <div>

                        <input asp-for="SampleBarcode"
                               class="form-control"
                               placeholder="Scan or enter barcode" />

                        <span asp-validation-for="SampleBarcode"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr />

                <!-- Sample Type -->

                <div class="form-row">

                    <label asp-for="SampleType" class="form-label">
                        <i class="fas fa-flask"></i>
                        Sample Type
                    </label>

                    <div>

                        <select asp-for="SampleType" class="form-select">

                            <option value="">-- Select Sample Type --</option>

                            <option>Blood</option>
                            <option>Urine</option>
                            <option>Saliva</option>
                            <option>Stool</option>
                            <option>Sputum</option>
                            <option>Plasma</option>
                            <option>Serum</option>
                            <option>Tissue</option>

                        </select>

                        <span asp-validation-for="SampleType"
                              class="text-danger"></span>

                    </div>

                </div>

                <hr />

                <!-- Notes -->

                <div class="form-row notes-row">

                    <label asp-for="Notes" class="form-label">
                        <i class="fas fa-note-sticky"></i>
                        Notes
                    </label>

                    <div>

                        <textarea asp-for="Notes"
                                  class="form-control"
                                  placeholder="Optional notes..."></textarea>

                        <span asp-validation-for="Notes"
                              class="text-danger"></span>

                    </div>

                </div>

                <div class="footer-buttons">

                    <button type="reset" class="btn btn-clear">
                        <i class="fas fa-rotate-left"></i>
                        Clear Form
                    </button>

                    <button type="submit" class="btn btn-receive">
                        <i class="fas fa-vials"></i>
                        Receive Sample
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}