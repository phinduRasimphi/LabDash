@model IEnumerable<LabDash.Models.TestRequest>

@{
    ViewData["Title"] = "Sample Receive";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var requests = Model?.ToList() ?? new List<LabDash.Models.TestRequest>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Poppins:wght@600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    :root {
        --teal: #008f83;
        --teal-dark: #006f67;
        --teal-light: #e8f7f5;
        --teal-border: #ccebe7;
        --text: #008f83;
        --muted: #718096;
        --border: #e4ebef;
        --white: #ffffff;
        --danger: #dc3545;
        --warning: #c58a00;
        --success: #198754;
    }

    * {
        box-sizing: border-box;
    }

    body {
        font-family: 'Inter', sans-serif;
        background: #f5f8fa;
        color: var(--text);
    }

    .receive-page {
        padding: 25px;
        width: 100%;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .page-header {
        background: linear-gradient(135deg, #008f83, #006f67);
        border-radius: 18px;
        padding: 26px 30px;
        color: #ffffff;
        margin-bottom: 22px;
        box-shadow: 0 8px 25px rgba(0, 111, 103, .15);
    }

    .page-header-content {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .page-title {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        font-weight: 800;
        color: #ffffff;
    }

    .page-subtitle {
        margin: 6px 0 0;
        color: #ffffff;
        opacity: .9;
        font-size: 14px;
    }

    .header-icon {
        width: 54px;
        height: 54px;
        border-radius: 15px;
        background: rgba(255,255,255,.15);
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 23px;
    }


    /* =========================================================
           ALERTS
           ========================================================= */

    .alert-box {
        border-radius: 12px;
        padding: 14px 17px;
        margin-bottom: 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 14px;
        font-weight: 600;
    }

    .alert-success {
        background: #e9f8ef;
        color: #187341;
        border: 1px solid #ccebd8;
    }

    .alert-danger {
        background: #fff0f1;
        color: #b42332;
        border: 1px solid #f3c9ce;
    }

    .alert-box button {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font-size: 17px;
    }


    /* =========================================================
           STATISTICS
           ========================================================= */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 18px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 4px 14px rgba(0, 143, 131, .06);
    }

    .stat-icon {
        width: 48px;
        height: 48px;
        border-radius: 13px;
        background: var(--teal-light);
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
    }

    .stat-number {
        font-family: 'Poppins', sans-serif;
        font-size: 23px;
        font-weight: 800;
        line-height: 1;
        color: var(--teal);
    }

    .stat-label {
        color: var(--muted);
        font-size: 12px;
        margin-top: 5px;
    }


    /* =========================================================
           SEARCH
           ========================================================= */

    .toolbar {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 15px;
        padding: 15px;
        margin-bottom: 20px;
    }

    .search-wrapper {
        position: relative;
    }

        .search-wrapper i {
            position: absolute;
            left: 15px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--teal);
        }

    .search-input {
        width: 100%;
        border: 1px solid #d8e2e7;
        border-radius: 11px;
        padding: 12px 15px 12px 43px;
        outline: none;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: var(--teal);
        background: #ffffff;
        transition: .2s;
    }

        .search-input::placeholder {
            color: #8b9aa2;
        }

        .search-input:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(0,143,131,.1);
        }


    /* =========================================================
           REQUEST CARD
           ========================================================= */

    .request-card {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 17px;
        margin-bottom: 22px;
        overflow: hidden;
        box-shadow: 0 5px 18px rgba(0,143,131,.05);
    }

    .request-header {
        padding: 20px 22px;
        background: #ffffff;
        border-bottom: 1px solid var(--border);
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
    }

    .request-label {
        color: var(--teal);
        text-transform: uppercase;
        font-size: 10px;
        letter-spacing: .08em;
        font-weight: 800;
    }

    .request-number {
        margin-top: 3px;
        font-family: 'Poppins', sans-serif;
        font-size: 21px;
        font-weight: 800;
        color: var(--teal);
    }

    .request-badges {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .badge {
        border-radius: 30px;
        padding: 7px 12px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .badge-routine {
        background: #e7f6f3;
        color: #007b70;
    }

    .badge-urgent {
        background: #fff0d7;
        color: #a66b00;
    }

    .badge-stat {
        background: #ffe4e6;
        color: #bd2635;
    }

    .badge-pending {
        background: #e9f3f4;
        color: #008f83;
    }

    .badge-partial {
        background: #fff5dc;
        color: #9a6c00;
    }


    /* =========================================================
           PATIENT
           ========================================================= */

    .patient-section {
        padding: 17px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        border-bottom: 1px solid var(--border);
    }

    .patient-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: var(--teal-light);
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
    }

    .patient-name {
        font-weight: 800;
        font-size: 14px;
        color: var(--teal);
    }

    .patient-id {
        color: var(--muted);
        font-size: 11px;
        margin-top: 3px;
    }


    /* =========================================================
           REQUEST TESTS
           ========================================================= */

    .tests-section {
        padding: 17px 22px;
        border-bottom: 1px solid var(--border);
    }

    .section-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        font-weight: 700;
        font-size: 13px;
        margin-bottom: 10px;
        color: var(--teal);
    }

        .section-heading i {
            color: var(--teal);
        }

    .test-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .test-tag {
        background: #edf8f7;
        color: #007e74;
        border-radius: 30px;
        padding: 7px 11px;
        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
           PROGRESS
           ========================================================= */

    .progress-section {
        padding: 17px 22px;
        border-bottom: 1px solid var(--border);
    }

    .progress-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 9px;
    }

    .progress-title {
        font-weight: 700;
        font-size: 12px;
        color: var(--teal);
    }

    .progress-count {
        color: var(--muted);
        font-size: 11px;
    }

    .progress-percentage {
        color: var(--teal);
        font-weight: 800;
        font-size: 12px;
    }

    .progress-bar {
        height: 8px;
        background: #e8edef;
        border-radius: 20px;
        overflow: hidden;
    }

    .progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #008f83, #00a99a);
        border-radius: 20px;
        transition: width .3s ease;
    }


    /* =========================================================
           SAMPLE / TEST TABLE
           ========================================================= */

    .samples-section {
        padding: 17px 22px;
    }

    .samples-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 12px;
    }

    .awaiting-badge {
        background: #edf8f7;
        color: var(--teal);
        border-radius: 30px;
        padding: 6px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    .table-wrapper {
        border: 1px solid var(--border);
        border-radius: 12px;
        overflow-x: auto;
    }

    .sample-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 850px;
    }

        .sample-table thead {
            background: #008f83;
            color: #ffffff;
        }

        .sample-table th {
            padding: 12px 10px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .02em;
            font-weight: 800;
            color: #ffffff;
            white-space: nowrap;
        }

        .sample-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #edf1f3;
            font-size: 12px;
            vertical-align: middle;
            color: var(--teal);
        }

        .sample-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .sample-table tbody tr:hover {
            background: #f3fbfa;
        }

    .test-type-name {
        font-weight: 800;
        color: var(--teal);
    }

    .test-category {
        color: var(--muted);
        font-size: 10px;
        margin-top: 3px;
    }

    .sample-type {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        color: var(--teal);
        font-weight: 600;
    }

        .sample-type i {
            color: var(--teal);
        }


    /* =========================================================
           BARCODE
           ========================================================= */

    .barcode-edit-form {
        display: flex;
        align-items: center;
        gap: 5px;
    }

    .barcode-input {
        width: 145px;
        height: 36px;
        border: 1px solid #cfdde2;
        border-radius: 8px;
        padding: 0 10px;
        color: var(--teal);
        background: #ffffff;
        font-size: 11px;
        font-weight: 700;
        outline: none;
    }

        .barcode-input:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(0,143,131,.1);
        }

    .barcode-save {
        width: 36px;
        height: 36px;
        border: 0;
        border-radius: 8px;
        background: var(--teal);
        color: #ffffff;
        cursor: pointer;
        transition: .2s;
    }

        .barcode-save:hover {
            background: var(--teal-dark);
        }

    .barcode-input.invalid {
        border-color: #dc3545;
        background: #fff5f5;
    }

    .barcode-validation {
        display: none;
        margin-top: 5px;
        color: #c92a3a;
        font-size: 10px;
        font-weight: 600;
    }

        .barcode-validation.show {
            display: block;
        }


    /* =========================================================
           STATUS
           ========================================================= */

    .status-awaiting {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #fff5df;
        color: #9b6b00;
        border-radius: 20px;
        padding: 7px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    .status-received {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: #e8f7ee;
        color: #187342;
        border-radius: 20px;
        padding: 7px 10px;
        font-size: 10px;
        font-weight: 700;
    }

    .muted-cell {
        color: #9aa8ae;
    }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .receive-form {
        margin: 0;
    }

    .receive-button {
        border: 0;
        background: #008f83;
        color: #ffffff;
        border-radius: 9px;
        padding: 9px 14px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        white-space: nowrap;
        transition: .2s;
    }

        .receive-button:hover {
            background: #006f67;
            transform: translateY(-1px);
        }

        .receive-button i {
            margin-right: 5px;
        }


    /* =========================================================
           EMPTY
           ========================================================= */

    .empty-state {
        background: #ffffff;
        border: 1px solid var(--border);
        border-radius: 17px;
        padding: 55px 25px;
        text-align: center;
    }

    .empty-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: var(--teal-light);
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 25px;
    }

    .empty-state h3 {
        font-family: 'Poppins', sans-serif;
        margin: 0 0 7px;
        color: var(--teal);
    }

    .empty-state p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }


    /* =========================================================
           MODAL
           ========================================================= */

    .modal-overlay {
        position: fixed;
        inset: 0;
        background: rgba(0, 111, 103, .55);
        display: none;
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
    }

        .modal-overlay.show {
            display: flex;
        }

    .receive-modal {
        width: 100%;
        max-width: 470px;
        background: #ffffff;
        border-radius: 18px;
        box-shadow: 0 25px 60px rgba(0,143,131,.2);
        overflow: hidden;
    }

    .modal-header {
        background: #008f83;
        color: #ffffff;
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .modal-header h3 {
            margin: 0;
            font-family: 'Poppins', sans-serif;
            font-size: 17px;
            color: #ffffff;
        }

    .modal-close {
        border: 0;
        background: transparent;
        color: #ffffff;
        font-size: 20px;
        cursor: pointer;
    }

    .modal-body {
        padding: 22px;
    }

    .modal-info {
        background: #f5faf9;
        border: 1px solid var(--teal-border);
        border-radius: 11px;
        padding: 14px;
        margin-bottom: 18px;
    }

    .modal-info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 6px 0;
        font-size: 12px;
    }

        .modal-info-row span:first-child {
            color: var(--muted);
        }

        .modal-info-row span:last-child {
            font-weight: 700;
            color: var(--teal);
            text-align: right;
        }

    .notes-label {
        display: block;
        font-size: 12px;
        font-weight: 700;
        margin-bottom: 7px;
        color: var(--teal);
    }

    .notes-input {
        width: 100%;
        min-height: 90px;
        resize: vertical;
        border: 1px solid #d5e0e4;
        border-radius: 10px;
        padding: 11px;
        outline: none;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        color: var(--teal);
        background: #ffffff;
    }

        .notes-input:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(0,143,131,.1);
        }

    .modal-footer {
        padding: 15px 22px;
        border-top: 1px solid var(--border);
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }

    .cancel-button {
        border: 1px solid var(--teal-border);
        background: #ffffff;
        color: var(--teal);
        border-radius: 9px;
        padding: 9px 14px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

        .cancel-button:hover {
            background: var(--teal-light);
        }

    .confirm-button {
        border: 0;
        background: #008f83;
        color: #ffffff;
        border-radius: 9px;
        padding: 9px 16px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

        .confirm-button:hover {
            background: #006f67;
        }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .page-header-content {
            align-items: flex-start;
        }

        .receive-page {
            padding: 15px;
        }
    }

</style>

<div class="receive-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div class="page-header-content">

            <div>
                <h1 class="page-title">
                    <i class="fa-solid fa-vials"></i>
                    Sample Receive
                </h1>

                <p class="page-subtitle">
                    Receive and verify individual laboratory samples before testing.
                </p>
            </div>

            <div class="header-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-box alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

            <button type="button"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box alert-danger">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

            <button type="button"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }


    <!-- =========================================================
         STATISTICS
         ========================================================= -->

    @{
        var totalRequests = requests.Count;

        var totalSamples = requests
            .SelectMany(r => r.Samples ?? Enumerable.Empty<LabDash.Models.Sample>())
            .Count();

        var waitingSamples = requests
            .SelectMany(r => r.Samples ?? Enumerable.Empty<LabDash.Models.Sample>())
            .Count(s => !s.IsReceived);

        var urgentRequests = requests
            .Count(r =>
                string.Equals(r.Urgency, "STAT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(r.Urgency, "Urgent", StringComparison.OrdinalIgnoreCase));
    }

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <div>
                <div class="stat-number">
                    @totalRequests
                </div>

                <div class="stat-label">
                    Requests Awaiting Samples
                </div>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-vial"></i>
            </div>

            <div>
                <div class="stat-number">
                    @waitingSamples
                </div>

                <div class="stat-label">
                    Samples Awaiting Receipt
                </div>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <div class="stat-number">
                    @urgentRequests
                </div>

                <div class="stat-label">
                    Urgent / STAT Requests
                </div>
            </div>

        </div>

    </div>


    <!-- =========================================================
         SEARCH
         ========================================================= -->

    <div class="toolbar">

        <div class="search-wrapper">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="sampleSearch"
                   class="search-input"
                   placeholder="Scan barcode, or search patient / test..." />

        </div>

    </div>


    <!-- =========================================================
         REQUESTS
         ========================================================= -->

    @if (!requests.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="fa-solid fa-vial-circle-check"></i>
            </div>

            <h3>No Samples Awaiting Receipt</h3>

            <p>
                There are currently no pending sample requests.
            </p>

        </div>
    }
    else
    {
        foreach (var request in requests)
        {
            var samples = request.Samples?
                .OrderBy(s => s.SampleId)
                .ToList()
                ?? new List<LabDash.Models.Sample>();

            var testItems = request.TestRequestItems?
                .OrderBy(i => i.TestRequestItemId)
                .ToList()
                ?? new List<LabDash.Models.TestRequestItem>();

            var receivedCount = samples.Count(s => s.IsReceived);

            var sampleCount = samples.Count;

            var percentage = sampleCount > 0
                ? (int)Math.Round((double)receivedCount / sampleCount * 100)
                : 0;

            var searchText =
    $"#{request.RequestId} " +
    $"{request.Patient?.Name} " +
    $"{request.Patient?.Surname} " +
    $"{request.Patient?.PatientID} " +
    string.Join(" ", testItems.Select(i => i.TestType?.Name ?? ""));

            var urgencyClass =
                request.Urgency == "STAT"
                    ? "badge-stat"
                    : request.Urgency == "Urgent"
                        ? "badge-urgent"
                        : "badge-routine";

            var statusClass =
                request.Status == "Partially Received"
                    ? "badge-partial"
                    : "badge-pending";

            <div class="request-card"
                 data-search="@searchText">

                <!-- =================================================
                     REQUEST HEADER
                     ================================================= -->

                <div class="request-header">

                    <div>

                        <div class="request-label">
                            Test Request
                        </div>

                        <div class="request-number">
                            #@request.RequestId
                        </div>

                    </div>


                    <div class="request-badges">

                        <span class="badge @urgencyClass">

                            <i class="fa-solid fa-clock"></i>

                            @(string.IsNullOrWhiteSpace(request.Urgency)
                                ? "Routine"
                                : request.Urgency)

                        </span>


                        <span class="badge @statusClass">
                            @request.Status
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     PATIENT
                     ================================================= -->

                <div class="patient-section">

                    @{
                        var patientFirst =
                            request.Patient?.Name?.Trim() ?? "";

                        var patientLast =
                            request.Patient?.Surname?.Trim() ?? "";

                        var initials =
                            $"{(patientFirst.Length > 0 ? patientFirst[0].ToString() : "")}" +
                            $"{(patientLast.Length > 0 ? patientLast[0].ToString() : "")}";
                    }

                    <div class="patient-avatar">
                        @(string.IsNullOrWhiteSpace(initials) ? "P" : initials)
                    </div>

                    <div>

                        <div class="patient-name">
                            @(string.IsNullOrWhiteSpace(patientFirst + patientLast)
                                ? "Unknown Patient"
                                : $"{patientFirst} {patientLast}")
                        </div>

                        <div class="patient-id">
                            ID:
                            @(request.Patient?.PatientID.ToString() ?? "Not available")
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     REQUESTED TESTS
                     ================================================= -->

                <div class="tests-section">

                    <div class="section-heading">
                        <i class="fa-solid fa-flask"></i>
                        <span>Requested Tests</span>
                    </div>

                    <div class="test-tags">

                        @if (testItems.Any())
                        {
                            foreach (var item in testItems)
                            {
                                <span class="test-tag">
                                    @(item.TestType?.Name ?? "Unknown Test")
                                </span>
                            }
                        }
                        else
                        {
                            <span class="test-tag">
                                No test information available
                            </span>
                        }

                    </div>

                </div>


                <!-- =================================================
                     PROGRESS
                     ================================================= -->

                <div class="progress-section">

                    <div class="progress-top">

                        <div>
                            <div class="progress-title">
                                Sample Reception Progress
                            </div>

                            <div class="progress-count">
                                @receivedCount of @sampleCount samples received
                            </div>
                        </div>

                        <div class="progress-percentage">
                            @percentage%
                        </div>

                    </div>

                    <div class="progress-bar">

                        <div class="progress-fill"
                             style="width:@percentage%;"></div>

                    </div>

                </div>


                <!-- =================================================
                     INDIVIDUAL SAMPLE TABLE
                     ================================================= -->

                <div class="samples-section">

                    <div class="samples-heading">

                        <div class="section-heading"
                             style="margin-bottom:0;">

                            <i class="fa-solid fa-vial"></i>

                            <span>
                                Individual Samples
                            </span>

                        </div>

                        <span class="awaiting-badge">

                            @samples.Count(s => !s.IsReceived)
                            awaiting

                        </span>

                    </div>


                    <div class="table-wrapper">

                        <table class="sample-table">

                            <thead>

                                <tr>

                                    <!-- CHANGED:
                                         SAMPLE -> TEST TYPE -->

                                    <th>
                                        Test Type
                                    </th>

                                    <th>
                                        Sample Type
                                    </th>

                                    <th>
                                        Barcode
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Received By
                                    </th>

                                    <th>
                                        Date Received
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (!samples.Any())
                                {
                                    <tr>

                                        <td colspan="7"
                                            style="text-align:center;padding:30px;color:#718096;">

                                            No physical samples have been created
                                            for this request.

                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    for (int sampleIndex = 0;
                                         sampleIndex < samples.Count;
                                         sampleIndex++)
                                    {
                                        var sample = samples[sampleIndex];

                                        /*
                                         * A TestRequestItem does not contain
                                         * SampleId in the current model.
                                         *
                                         * Therefore we display the test type
                                         * by matching the physical sample to
                                         * the test item by position.
                                         *
                                         * If there are more samples than tests,
                                         * the remaining samples display
                                         * "Additional Sample".
                                         */

                                        LabDash.Models.TestRequestItem? matchedTest = null;

                                        if (sampleIndex < testItems.Count)
                                        {
                                            matchedTest = testItems[sampleIndex];
                                        }

                                        var testName =
                                            matchedTest?.TestType?.Name
                                            ?? "Additional Sample";

                                        var testCategory =
                                            matchedTest?.TestType?.Category
                                            ?? "";

                                        <tr>

                                            <!-- TEST TYPE -->

                                            <td>

                                                <div class="test-type-name">
                                                    @testName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(testCategory))
                                                {
                                                    <div class="test-category">
                                                        @testCategory
                                                    </div>
                                                }

                                            </td>


                                            <!-- SAMPLE TYPE -->

                                            <td>

                                                <span class="sample-type">

                                                    <i class="fa-solid fa-droplet"></i>

                                                    @(string.IsNullOrWhiteSpace(sample.SampleType)
                                                        ? "Not specified"
                                                        : sample.SampleType)

                                                </span>

                                            </td>


                                            <!-- BARCODE -->

                                            <td>

                                                @if (!sample.IsReceived)
                                                {
                                                    <form asp-controller="SampleReceive"
                                                          asp-action="EditBarcode"
                                                          method="post"
                                                          class="barcode-edit-form"
                                                          data-barcode-form="true">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="requestId"
                                                               value="@request.RequestId" />

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <input type="hidden"
                                                               name="oldBarcode"
                                                               value="@sample.Barcode" />

                                                        <input type="text"
                                                               name="newBarcode"
                                                               value="@sample.Barcode"
                                                               class="barcode-input"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               aria-label="Barcode" />

                                                        <button type="submit"
                                                                class="barcode-save"
                                                                title="Save barcode">

                                                            <i class="fa-solid fa-floppy-disk"></i>

                                                        </button>

                                                    </form>

                                                    <div class="barcode-validation">
                                                    </div>
                                                }
                                                else
                                                {
                                                    <strong style="color:#007e74;">
                                                        @sample.Barcode
                                                    </strong>
                                                }

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                @if (sample.IsReceived)
                                                {
                                                    <span class="status-received">

                                                        <i class="fa-solid fa-check"></i>

                                                        Received

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-awaiting">

                                                        <i class="fa-solid fa-clock"></i>

                                                        Awaiting

                                                    </span>
                                                }

                                            </td>


                                            <!-- RECEIVED BY -->

                                            <td>

                                                @if (sample.IsReceived &&
                                                     !string.IsNullOrWhiteSpace(sample.ReceivedByTechnician))
                                                {
                                                    <span>
                                                        @sample.ReceivedByTechnician
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="muted-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>


                                            <!-- DATE RECEIVED -->

                                            <td>

                                                @if (sample.IsReceived &&
                                                     sample.DateReceived.HasValue)
                                                {
                                                    <span>
                                                        @sample.DateReceived.Value.ToString("dd MMM yyyy HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="muted-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>


                                            <!-- ACTION -->

                                            <td>

                                                @if (!sample.IsReceived)
                                                {
                                                    <form asp-controller="SampleReceive"
                                                          asp-action="ReceiveSample"
                                                          method="post"
                                                          class="receive-form">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <input type="hidden"
                                                               name="requestId"
                                                               value="@request.RequestId" />

                                                        <input type="hidden"
                                                               name="barcode"
                                                               value="@sample.Barcode" />

                                                        <input type="hidden"
                                                               name="notes"
                                                               value="" />

                                                        <button type="button"
                                                                class="receive-button"
                                                                data-sample-type="@sample.SampleType"
                                                                data-barcode="@sample.Barcode"
                                                                data-test-type="@testName"
                                                                onclick="openReceiveModal(this)">

                                                            <i class="fa-solid fa-vial-circle-check"></i>

                                                            Receive

                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <span style="color:#198754;font-weight:700;font-size:11px;">
                                                        <i class="fa-solid fa-circle-check"></i>
                                                        Complete
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     REQUEST FOOTER
                     ================================================= -->

                <div style="
                    padding:14px 22px;
                    background:#fbfcfd;
                    border-top:1px solid var(--border);
                    display:flex;
                    justify-content:space-between;
                    align-items:center;
                    gap:20px;
                    font-size:11px;
                    color:#718096;
                ">

                    <div>

                        <strong>
                            Request Status
                        </strong>

                        <div style="margin-top:3px;">
                            @request.Status
                        </div>

                    </div>


                    <div>

                        <strong>
                            Samples
                        </strong>

                        <div style="margin-top:3px;">
                            @receivedCount / @sampleCount received
                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>


<!-- =============================================================
     RECEIVE MODAL
     ============================================================= -->

<div id="receiveModal"
     class="modal-overlay">

    <div class="receive-modal">

        <div class="modal-header">

            <h3>
                <i class="fa-solid fa-vial-circle-check"></i>
                Confirm Sample Receipt
            </h3>

            <button type="button"
                    class="modal-close"
                    onclick="closeReceiveModal()">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div class="modal-body">

            <div class="modal-info">

                <div class="modal-info-row">

                    <span>
                        Test Type
                    </span>

                    <span id="modalTestType">
                        —
                    </span>

                </div>


                <div class="modal-info-row">

                    <span>
                        Sample Type
                    </span>

                    <span id="modalSampleType">
                        —
                    </span>

                </div>


                <div class="modal-info-row">

                    <span>
                        Barcode
                    </span>

                    <span id="modalBarcode">
                        —
                    </span>

                </div>

            </div>


            <label class="notes-label"
                   for="modalNotes">

                Notes
                <span style="font-weight:400;color:#718096;">
                    (optional)
                </span>

            </label>

            <textarea id="modalNotes"
                      class="notes-input"
                      placeholder="Add any notes about this sample..."></textarea>

        </div>


        <div class="modal-footer">

            <button type="button"
                    class="cancel-button"
                    onclick="closeReceiveModal()">

                Cancel

            </button>

            <button type="button"
                    class="confirm-button"
                    onclick="confirmReceiveSample()">

                <i class="fa-solid fa-check"></i>
                Confirm Receipt

            </button>

        </div>

    </div>

</div>


@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       SEARCH
       ========================================================= */

    const searchInput = document.getElementById("sampleSearch");

    if (searchInput) {

        searchInput.addEventListener("input", function () {

            const search =
                this.value.toLowerCase().trim();

            document
                .querySelectorAll(".request-card")
                .forEach(function (card) {

                    const text =
                        card.getAttribute("data-search")?.toLowerCase() || "";

                    card.style.display =
                        text.includes(search) ? "" : "none";

                });

        });

    }


    /* =========================================================
       BARCODE EDIT VALIDATION
       ========================================================= */

    document
        .querySelectorAll('[data-barcode-form="true"]')
        .forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const input =
                    form.querySelector('input[name="newBarcode"]');

                if (!input) {
                    return;
                }

                const value =
                    input.value.trim();

                const oldBarcode =
                    form.querySelector('input[name="oldBarcode"]')?.value.trim() || "";

                if (!value) {

                    event.preventDefault();

                    input.classList.add("invalid");

                    alert("Please enter a barcode.");

                    return;
                }

                /*
                 * Prevent accidental submission of the exact same value.
                 */

                if (value.toUpperCase() === oldBarcode.toUpperCase()) {

                    event.preventDefault();

                    alert("The barcode has not changed.");

                    return;
                }

                /*
                 * Basic barcode validation.
                 *
                 * This prevents spaces and obviously malformed
                 * barcode values from being submitted.
                 */

                if (/\s/.test(value)) {

                    event.preventDefault();

                    input.classList.add("invalid");

                    alert("The barcode cannot contain spaces.");

                    return;
                }

                input.classList.remove("invalid");

            });

        });


    /* =========================================================
       RECEIVE MODAL
       ========================================================= */

    let selectedReceiveForm = null;


    window.openReceiveModal = function (button) {

        selectedReceiveForm =
            button.closest(".receive-form");

        if (!selectedReceiveForm) {
            return;
        }


        const sampleType =
            button.getAttribute("data-sample-type")
            || "Not specified";


        const barcode =
            button.getAttribute("data-barcode")
            || "Not available";


        const testType =
            button.getAttribute("data-test-type")
            || "Test";


        const modalSampleType =
            document.getElementById("modalSampleType");

        const modalBarcode =
            document.getElementById("modalBarcode");

        const modalTestType =
            document.getElementById("modalTestType");

        const modalNotes =
            document.getElementById("modalNotes");


        if (modalSampleType) {
            modalSampleType.textContent = sampleType;
        }


        if (modalBarcode) {
            modalBarcode.textContent = barcode;
        }


        if (modalTestType) {
            modalTestType.textContent = testType;
        }


        if (modalNotes) {
            modalNotes.value = "";
        }


        const modal =
            document.getElementById("receiveModal");


        if (modal) {
            modal.classList.add("show");
        }

    };


    /* =========================================================
       CLOSE MODAL
       ========================================================= */

    window.closeReceiveModal = function () {

        const modal =
            document.getElementById("receiveModal");

        if (modal) {
            modal.classList.remove("show");
        }

        selectedReceiveForm = null;

    };


    /* =========================================================
       CONFIRM RECEIPT
       ========================================================= */

    window.confirmReceiveSample = function () {

        if (!selectedReceiveForm) {
            return;
        }


        const notes =
            document.getElementById("modalNotes")?.value || "";


        const notesInput =
            selectedReceiveForm.querySelector(
                'input[name="notes"]'
            );


        if (notesInput) {
            notesInput.value = notes;
        }


        selectedReceiveForm.submit();

        closeReceiveModal();

    };


    /* =========================================================
       CLICK OUTSIDE MODAL
       ========================================================= */

    document.addEventListener("click", function (event) {

        const modal =
            document.getElementById("receiveModal");

        if (!modal) {
            return;
        }


        if (event.target === modal) {
            closeReceiveModal();
        }

    });


    /* =========================================================
       ESCAPE
       ========================================================= */

    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {
            closeReceiveModal();
        }

    });

});

</script>

}