@model IEnumerable<LabDash.Models.TestRequest>

@{
    ViewData["Title"] = "Sample Receiving";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<div class="sample-page">

    <div class="sample-container">

        <!-- =====================================================
             HEADER
        ====================================================== -->

        <div class="sample-header">

            <div class="header-icon">
                <i class="fa-solid fa-vials"></i>
            </div>

            <div>
                <h1>Sample Receiving</h1>

                <p>
                    Review laboratory test requests, verify samples,
                    edit barcodes and receive samples.
                </p>
            </div>

        </div>


        <!-- =====================================================
             ALERTS
        ====================================================== -->
        @if (TempData["Success"] != null)
        {
            <div class="alert-box success">

                <i class="fa-solid fa-circle-check"></i>

                <div>
                    <strong>Success</strong>
                    <span>@TempData["Success"]</span>
                </div>

            </div>
        }

        @if (TempData["Error"] != null)
        {
            <div class="alert-box error">

                <i class="fa-solid fa-circle-exclamation"></i>

                <div>
                    <strong>Error</strong>
                    <span>@TempData["Error"]</span>
                </div>

            </div>
        }


        <!-- =====================================================
             STATISTICS
        ====================================================== -->

        <div class="stats-grid">

            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-clipboard-list"></i>
                </div>

                <div>
                    <h2>@Model.Count()</h2>
                    <p>Requests Awaiting Samples</p>
                </div>

            </div>


            <div class="stat-card">

                <div class="stat-icon">
                    <i class="fa-solid fa-vial"></i>
                </div>

                <div>
                    <h2>
                        @Model.Sum(x =>
                            x.Samples?.Count(s => !s.IsReceived) ?? 0)
                    </h2>

                    <p>Samples Awaiting Receipt</p>
                </div>

            </div>


            <div class="stat-card urgent-stat">

                <div class="stat-icon">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                </div>

                <div>
                    <h2>
                        @Model.Count(x =>
                            x.Urgency == "STAT" ||
                            x.Urgency == "Urgent")
                    </h2>

                    <p>Urgent Requests</p>
                </div>

            </div>

        </div>


        <!-- =====================================================
             MAIN CARD
        ====================================================== -->

        <div class="main-card">

            <div class="card-header">

                <div>
                    <h2>
                        <i class="fa-solid fa-flask"></i>
                        Pending Sample Requests
                    </h2>

                    <p>
                        Samples are listed according to request urgency.
                    </p>
                </div>

                <div class="count-pill">
                    @Model.Count() request@(Model.Count() == 1 ? "" : "s")
                </div>

            </div>


            <!-- =================================================
                 SEARCH
            ================================================== -->

            <div class="toolbar">

                <div class="search-box">

                    <i class="fa-solid fa-search"></i>

                    <input type="text"
                           id="sampleSearch"
                           placeholder="Search request, patient, barcode or test..." />

                </div>

            </div>


            <!-- =================================================
                 REQUEST LIST
            ================================================== -->

            <div class="request-list">

                @if (Model.Any())
                {
                    foreach (var request in Model)
                    {
                        var urgencyClass =
                            request.Urgency switch
                            {
                                "STAT" => "urgency-stat",
                                "Urgent" => "urgency-urgent",
                                "Priority" => "urgency-priority",
                                _ => "urgency-routine"
                            };

                        var urgencyIcon =
                            request.Urgency switch
                            {
                                "STAT" => "fa-triangle-exclamation",
                                "Urgent" => "fa-bolt",
                                "Priority" => "fa-arrow-up",
                                _ => "fa-clock"
                            };

                        var patientName =
                            request.Patient != null
                                ? $"{request.Patient.Name} {request.Patient.Surname}"
                                : "Unknown Patient";

                        var pendingSamples =
                            request.Samples?
                                .Where(s => !s.IsReceived)
                                .ToList()
                            ?? new List<LabDash.Models.Sample>();


                        <div class="request-card"
                             data-search="
                            @request.RequestId
                            @patientName
                            @request.Urgency
                            @string.Join(" ", request.TestRequestItems.Select(x => x.TestType?.Name))
                            @string.Join(" ", request.Samples.Select(x => x.Barcode))">

                            <!-- =================================
                                 REQUEST HEADER
                            ================================== -->

                            <div class="request-top">

                                <div class="request-number">

                                    <span class="request-label">
                                        TEST REQUEST
                                    </span>

                                    <strong>
                                        #@request.RequestId
                                    </strong>

                                </div>


                                <span class="urgency-badge @urgencyClass">

                                    <i class="fa-solid @urgencyIcon"></i>

                                    @(string.IsNullOrWhiteSpace(request.Urgency)
                                        ? "Routine"
                                        : request.Urgency)

                                </span>

                            </div>


                            <!-- =================================
                                 PATIENT
                            ================================== -->

                            <div class="patient-section">

                                <div class="patient-avatar">

                                    @if (request.Patient != null)
                                    {
                                        @request.Patient.Name.Substring(0, 1).ToUpper()
                                    }
                                    else
                                    {
                                        <text>?</text>
                                    }

                                </div>

                                <div>

                                    <strong>
                                        @patientName
                                    </strong>

                                    <span>
                                        ID:
                                        @(request.Patient?.IDNumber ?? "Not available")
                                    </span>

                                </div>

                            </div>


                            <!-- =================================
                                 TESTS
                            ================================== -->

                            <div class="tests-section">

                                <div class="section-title">
                                    <i class="fa-solid fa-microscope"></i>
                                    Requested Tests
                                </div>

                                <div class="test-list">

                                    @foreach (var test in request.TestRequestItems)
                                    {
                                        <span class="test-chip">

                                            <i class="fa-solid fa-flask"></i>

                                            @(test.TestType?.Name ?? "Unknown Test")

                                        </span>
                                    }

                                </div>

                            </div>


                            <!-- =================================
                                 SAMPLES
                            ================================== -->

                            <div class="samples-section">

                                <div class="section-title">

                                    <i class="fa-solid fa-vial"></i>

                                    Samples

                                </div>


                                @if (request.Samples != null &&
                                     request.Samples.Any())
                                {

                                    <div class="sample-table-wrapper">

                                        <table class="sample-table">

                                            <thead>

                                                <tr>

                                                    <th>Sample Type</th>

                                                    <th>Barcode</th>

                                                    <th>Status</th>

                                                    <th>Received By</th>

                                                    <th>Date Received</th>

                                                    <th>Actions</th>

                                                </tr>

                                            </thead>


                                            <tbody>

                                                @foreach (var sample in request.Samples)
                                                {

                                                    <tr>

                                                        <!-- SAMPLE TYPE -->

                                                        <td>

                                                            <div class="sample-type">

                                                                <i class="fa-solid fa-vial"></i>

                                                                <span>
                                                                    @sample.SampleType
                                                                </span>

                                                            </div>

                                                        </td>


                                                        <!-- BARCODE -->

                                                        <td>

                                                            @if (!sample.IsReceived)
                                                            {
                                                                <form asp-action="EditBarcode"
                                                                      method="post"
                                                                      class="barcode-edit-form">

                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden"
                                                                           name="requestId"
                                                                           value="@request.RequestId" />

                                                                    <input type="hidden"
                                                                           name="oldBarcode"
                                                                           value="@sample.Barcode" />

                                                                    <input type="text"
                                                                           name="newBarcode"
                                                                           value="@sample.Barcode"
                                                                           class="barcode-input" />

                                                                    <button type="submit"
                                                                            class="save-barcode"
                                                                            title="Save barcode">

                                                                        <i class="fa-solid fa-floppy-disk"></i>

                                                                    </button>

                                                                </form>
                                                            }
                                                            else
                                                            {
                                                                <span class="barcode-display">
                                                                    @sample.Barcode
                                                                </span>
                                                            }

                                                        </td>


                                                        <!-- STATUS -->

                                                        <td>

                                                            @if (sample.IsReceived)
                                                            {
                                                                <span class="status received">

                                                                    <i class="fa-solid fa-circle-check"></i>

                                                                    Received

                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="status waiting">

                                                                    <i class="fa-solid fa-clock"></i>

                                                                    Awaiting

                                                                </span>
                                                            }

                                                        </td>


                                                        <!-- TECHNICIAN -->

                                                        <td>

                                                            @if (sample.IsReceived)
                                                            {
                                                                <span>
                                                                    @(sample.ReceivedByTechnician ?? "Unknown")
                                                                </span>
                                                            }
                                                            else
                                                            {
                                                                <span class="not-received">
                                                                    —
                                                                </span>
                                                            }

                                                        </td>


                                                        <!-- DATE -->

                                                        <td>

                                                            @if (sample.IsReceived &&
                                                                 sample.DateReceived.HasValue)
                                                            {
                                                                @sample.DateReceived.Value.ToString(
                                                                    "dd MMM yyyy HH:mm")
                                                            }
                                                            else
                                                            {
                                                                <span class="not-received">
                                                                    —
                                                                </span>
                                                            }

                                                        </td>


                                                        <!-- ACTION -->

                                                        <td>

                                                            @if (!sample.IsReceived)
                                                            {
                                                                <form asp-action="ReceiveSample"
                                                                      method="post"
                                                                      class="receive-form">

                                                                    @Html.AntiForgeryToken()

                                                                    <input type="hidden"
                                                                           name="requestId"
                                                                           value="@request.RequestId" />

                                                                    <input type="hidden"
                                                                           name="barcode"
                                                                           value="@sample.Barcode"
                                                                           class="receive-barcode" />

                                                                    <input type="hidden"
                                                                           name="notes"
                                                                           value="" />

                                                                    <button type="submit"
                                                                            class="receive-btn"
                                                                            onclick="return confirm('Receive this sample?');">

                                                                        <i class="fa-solid fa-vial-circle-check"></i>

                                                                        Receive

                                                                    </button>

                                                                </form>
                                                            }
                                                            else
                                                            {
                                                                <span class="received-label">

                                                                    <i class="fa-solid fa-check"></i>

                                                                    Complete

                                                                </span>
                                                            }

                                                        </td>

                                                    </tr>
                                                }

                                            </tbody>

                                        </table>

                                    </div>

                                }
                                else
                                {
                                    <div class="no-samples">

                                        <i class="fa-solid fa-vial-virus"></i>

                                        <span>
                                            No samples have been registered for this request.
                                        </span>

                                    </div>
                                }

                            </div>


                            <!-- =================================
                                 REQUEST STATUS
                            ================================== -->

                            <div class="request-footer">

                                <div>

                                    <span class="footer-label">
                                        Request Status
                                    </span>

                                    <strong>
                                        @request.Status
                                    </strong>

                                </div>

                                <div>

                                    <span class="footer-label">
                                        Request Date
                                    </span>

                                    <strong>
                                        @request.RequestDate.ToString("dd MMM yyyy HH:mm")
                                    </strong>

                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {

                    <div class="empty-state">

                        <i class="fa-solid fa-vial-circle-check"></i>

                        <h3>No Samples Awaiting Receipt</h3>

                        <p>
                            There are currently no pending laboratory
                            samples to receive.
                        </p>

                    </div>

                }

            </div>

        </div>

    </div>

</div>


<style>

    * {
        box-sizing: border-box;
    }

    .sample-page {
        min-height: 100vh;
        background: #f1f6f8;
        padding: 30px 20px 60px;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .sample-container {
        max-width: 1450px;
        margin: auto;
    }


    /* HEADER */

    .sample-header {
        background: linear-gradient(135deg, #0e8178, #086b64);
        color: white;
        border-radius: 18px;
        padding: 25px 30px;
        display: flex;
        align-items: center;
        gap: 18px;
        margin-bottom: 22px;
        box-shadow: 0 8px 22px rgba(0,0,0,.08);
    }

    .header-icon {
        width: 62px;
        height: 62px;
        border-radius: 50%;
        display: flex;
        justify-content: center;
        align-items: center;
        background: rgba(255,255,255,.15);
        font-size: 26px;
    }

    .sample-header h1 {
        margin: 0;
        font-size: 29px;
    }

    .sample-header p {
        margin: 6px 0 0;
        opacity: .9;
        font-size: 13px;
    }


    /* ALERTS */

    .alert-box {
        display: flex;
        gap: 12px;
        align-items: center;
        padding: 14px 17px;
        border-radius: 12px;
        margin-bottom: 18px;
    }

        .alert-box.success {
            background: #e9f8f3;
            color: #176b52;
            border: 1px solid #c2e9dd;
        }

        .alert-box.error {
            background: #fdeeee;
            color: #a52834;
            border: 1px solid #f4c7c7;
        }

        .alert-box strong {
            display: block;
        }

        .alert-box span {
            font-size: 13px;
        }


    /* STATS */

    .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .stat-card {
        background: white;
        border-radius: 15px;
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        box-shadow: 0 5px 18px rgba(0,0,0,.06);
    }

    .stat-icon {
        width: 52px;
        height: 52px;
        border-radius: 50%;
        background: rgba(14,129,120,.10);
        color: #0e8178;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .stat-card h2 {
        margin: 0;
        color: #00695c;
        font-size: 27px;
    }

    .stat-card p {
        margin: 3px 0 0;
        color: #7b8790;
        font-size: 12px;
    }


    /* MAIN CARD */

    .main-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 8px 28px rgba(0,0,0,.07);
    }

    .card-header {
        background: linear-gradient(135deg, #00897b, #00695c);
        color: white;
        padding: 25px 30px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .card-header h2 {
            margin: 0;
            font-size: 23px;
        }

        .card-header p {
            margin: 5px 0 0;
            opacity: .88;
            font-size: 12.5px;
        }

    .count-pill {
        background: rgba(255,255,255,.17);
        padding: 9px 17px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }


    /* TOOLBAR */

    .toolbar {
        padding: 20px 30px;
        border-bottom: 1px solid #edf1f2;
    }

    .search-box {
        width: 390px;
        max-width: 100%;
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 15px;
            color: #8a989e;
        }

        .search-box input {
            width: 100%;
            height: 46px;
            border: 1px solid #dce4e6;
            border-radius: 10px;
            padding-left: 42px;
            outline: none;
        }

            .search-box input:focus {
                border-color: #0e8178;
                box-shadow: 0 0 0 3px rgba(14,129,120,.1);
            }


    /* REQUEST LIST */

    .request-list {
        padding: 25px 30px;
    }

    .request-card {
        border: 1px solid #e1e8ea;
        border-radius: 15px;
        margin-bottom: 20px;
        overflow: hidden;
        transition: .2s;
    }

        .request-card:hover {
            box-shadow: 0 5px 18px rgba(0,0,0,.06);
        }


    /* REQUEST TOP */

    .request-top {
        background: #f6fafb;
        padding: 18px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #e4eaec;
    }

    .request-label {
        display: block;
        color: #8a989e;
        font-size: 10px;
        letter-spacing: 1px;
        font-weight: 700;
    }

    .request-number strong {
        color: #26363b;
        font-size: 21px;
    }


    /* URGENCY */

    .urgency-badge {
        border-radius: 30px;
        padding: 8px 14px;
        color: white;
        font-size: 12px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .urgency-stat {
        background: #c62828;
    }

    .urgency-urgent {
        background: #ef6c00;
    }

    .urgency-priority {
        background: #d89b00;
    }

    .urgency-routine {
        background: #00897b;
    }


    /* PATIENT */

    .patient-section {
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 13px;
        border-bottom: 1px solid #edf1f2;
    }

    .patient-avatar {
        width: 45px;
        height: 45px;
        border-radius: 50%;
        background: #dff2ef;
        color: #00695c;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }

    .patient-section strong {
        display: block;
        color: #334155;
        font-size: 14px;
    }

    .patient-section span {
        display: block;
        color: #89979d;
        font-size: 11px;
        margin-top: 3px;
    }


    /* TESTS */

    .tests-section,
    .samples-section {
        padding: 18px 22px;
    }

    .section-title {
        color: #334155;
        font-weight: 700;
        font-size: 12px;
        margin-bottom: 12px;
    }

        .section-title i {
            color: #0e8178;
            margin-right: 5px;
        }

    .test-list {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .test-chip {
        background: #eef7f6;
        color: #00695c;
        border-radius: 20px;
        padding: 7px 11px;
        font-size: 11px;
        font-weight: 600;
    }

        .test-chip i {
            margin-right: 5px;
        }


    /* SAMPLE TABLE */

    .sample-table-wrapper {
        overflow-x: auto;
    }

    .sample-table {
        width: 100%;
        border-collapse: collapse;
    }

        .sample-table th {
            background: #00897b;
            color: white;
            padding: 12px 10px;
            font-size: 10px;
            text-transform: uppercase;
            letter-spacing: .3px;
            text-align: center;
        }

        .sample-table td {
            padding: 12px 10px;
            border-bottom: 1px solid #edf1f2;
            text-align: center;
            font-size: 12px;
            vertical-align: middle;
        }

    .sample-type {
        display: flex;
        align-items: center;
        gap: 7px;
        justify-content: center;
        color: #475569;
        font-weight: 600;
    }

        .sample-type i {
            color: #0e8178;
        }


    /* BARCODE */

    .barcode-edit-form {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 5px;
    }

    .barcode-input {
        width: 145px;
        height: 36px;
        border: 1px solid #d3dfe2;
        border-radius: 7px;
        padding: 0 9px;
        font-family: Consolas, monospace;
        font-weight: 700;
        color: #00695c;
        font-size: 11px;
        outline: none;
    }

        .barcode-input:focus {
            border-color: #0e8178;
            box-shadow: 0 0 0 2px rgba(14,129,120,.1);
        }

    .barcode-display {
        font-family: Consolas, monospace;
        font-weight: 700;
        color: #00695c;
    }

    .save-barcode {
        width: 35px;
        height: 35px;
        border: none;
        border-radius: 7px;
        background: #455a64;
        color: white;
        cursor: pointer;
    }

        .save-barcode:hover {
            background: #26363b;
        }


    /* STATUS */

    .status {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

        .status.received {
            background: #e5f7f2;
            color: #087f63;
        }

        .status.waiting {
            background: #fff5df;
            color: #a96e00;
        }

    .not-received {
        color: #aab4b8;
    }


    /* RECEIVE BUTTON */

    .receive-btn {
        border: none;
        background: #0e8178;
        color: white;
        border-radius: 8px;
        padding: 8px 13px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
    }

        .receive-btn:hover {
            background: #086b64;
        }

    .received-label {
        color: #087f63;
        font-weight: 700;
        font-size: 11px;
    }


    /* FOOTER */

    .request-footer {
        background: #f8fafb;
        border-top: 1px solid #edf1f2;
        padding: 14px 22px;
        display: flex;
        justify-content: space-between;
        gap: 20px;
    }

    .footer-label {
        display: block;
        color: #929da1;
        font-size: 10px;
        text-transform: uppercase;
    }

    .request-footer strong {
        color: #475569;
        font-size: 12px;
    }


    /* EMPTY */

    .empty-state {
        padding: 80px 20px;
        text-align: center;
        color: #87969b;
    }

        .empty-state i {
            font-size: 55px;
            color: #b9dcd8;
        }

        .empty-state h3 {
            color: #455a64;
            margin: 15px 0 5px;
        }


    /* NO SAMPLES */

    .no-samples {
        padding: 20px;
        background: #fff8e8;
        color: #866b2b;
        border-radius: 9px;
        text-align: center;
        font-size: 12px;
    }


    /* RESPONSIVE */

    @@media(max-width: 900px) {

        .stats-grid {
            grid-template-columns: 1fr;
        }

        .card-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .request-list {
            padding: 15px;
        }
    }

    @@media(max-width: 650px) {

        .sample-page {
            padding: 18px 10px;
        }

        .sample-header {
            padding: 20px;
        }

            .sample-header h1 {
                font-size: 22px;
            }

        .request-top {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .request-footer {
            flex-direction: column;
        }
    }

</style>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const searchInput =
                document.getElementById("sampleSearch");

            if (!searchInput)
                return;

            searchInput.addEventListener("input", function () {

                const search =
                        this.value.toLowerCase().trim();

                    const cards =
                    document.querySelectorAll(".request-card");

                cards.forEach(function (card) {

                    const text =
                        card.getAttribute("data-search")
                                ?.toLowerCase() || "";

                        card.style.display =
                        text.includes(search)
                                ? ""
                            : "none";

                    });

                });

            });

    </script>

}