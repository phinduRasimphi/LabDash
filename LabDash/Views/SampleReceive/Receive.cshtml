@model LabDash.Models.SampleReceive

@{
ViewData["Title"] = "Receive Patient Sample";
Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="receive-page">
    <div class="receive-container">

    <!-- HEADER -->
    <div class="receive-header">
        <div class="header-icon">
            <i class="fa-solid fa-vials"></i>
        </div>

        <div>
            <h1>Receive Patient Sample</h1>
            <p>Verify the patient request and record the laboratory sample received.</p>
        </div>
    </div>

    <!-- SUCCESS -->
    @if (TempData["Success"] != null)
    {
        <div class="alert-message success-message">
            <i class="fa-solid fa-circle-check"></i>
            <div>
                <strong>Success</strong>
                <span>@TempData["Success"]</span>
            </div>
        </div>
    }

    <!-- ERROR -->
    @if (TempData["Error"] != null)
    {
        <div class="alert-message error-message">
            <i class="fa-solid fa-circle-exclamation"></i>
            <div>
                <strong>Error</strong>
                <span>@TempData["Error"]</span>
            </div>
        </div>
    }

    <!-- VALIDATION -->
    <div asp-validation-summary="All" class="validation-summary"></div>

    <!-- RECEIVE CARD -->
    <div class="receive-card">

        <form asp-controller="SampleReceive"
              asp-action="Receive"
              method="post"
              id="receiveForm">

            @Html.AntiForgeryToken()

            <!-- REQUEST -->
            <div class="form-group">

                <label asp-for="RequestId">
                    <i class="fa-solid fa-clipboard-list"></i>
                    Test Request
                    <span>*</span>
                </label>

                <select asp-for="RequestId"
                        asp-items="@(ViewBag.RequestList as IEnumerable<SelectListItem>)"
                        id="requestId"
                        class="form-control">

                    <option value="">-- Select Test Request --</option>

                </select>

                <span asp-validation-for="RequestId"
                      class="field-error"></span>

                @if (ViewBag.RequestList == null)
                {
                    <div class="request-warning">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        No test requests were loaded.
                    </div>
                }

            </div>

            <!-- TECHNICIAN -->
            <div class="form-group">

                <label>
                    <i class="fa-solid fa-user"></i>
                    Technician
                </label>

                <div class="technician-box">

                    <div class="technician-avatar">
                        @{
                            var technicianName = User.Identity?.Name ?? "Unknown";

                            var initials = string.Join(
                                "",
                                technicianName
                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                    .Take(2)
                                    .Select(x => x[0])
                            ).ToUpper();

                            if (string.IsNullOrWhiteSpace(initials))
                            {
                                initials = "?";
                            }
                        }

                        @initials
                    </div>

                    <div>
                        <strong>@technicianName</strong>
                        <small>Logged-in laboratory technician</small>
                    </div>

                </div>

            </div>

            <!-- BARCODE -->
            <div class="form-group">

                <label asp-for="SampleBarcode">
                    <i class="fa-solid fa-barcode"></i>
                    Sample Barcode
                    <span>*</span>
                </label>

                <div class="barcode-wrapper">

                    <input asp-for="SampleBarcode"
                           id="sampleBarcode"
                           class="form-control"
                           placeholder="Enter or scan sample barcode"
                           autocomplete="off" />

                    <button type="button"
                            id="checkBarcode"
                            class="check-button">

                        <i class="fa-solid fa-magnifying-glass"></i>
                        Verify

                    </button>

                </div>

                <span asp-validation-for="SampleBarcode"
                      class="field-error"></span>

                <div id="barcodeMessage"
                     class="barcode-message">
                </div>

            </div>

            <!-- SAMPLE TYPE -->
            <div class="form-group">

                <label>
                    <i class="fa-solid fa-flask"></i>
                    Sample Type
                </label>

                <div id="sampleTypeBox"
                     class="readonly-box">

                    <i class="fa-solid fa-circle-question"></i>

                    <span id="sampleTypeText">
                        Sample type will appear after barcode verification.
                    </span>

                </div>

                <input asp-for="SampleType"
                       type="hidden"
                       id="sampleType" />

            </div>

            <!-- DATE / TIME -->
            <div class="form-group">

                <label>
                    <i class="fa-solid fa-clock"></i>
                    Date & Time Received
                </label>

                <div class="readonly-box">

                    <i class="fa-solid fa-calendar-check"></i>

                    <span id="currentDateTime">
                        @DateTime.Now.ToString("dd MMMM yyyy HH:mm")
                    </span>

                </div>

                <small class="help-text">
                    The server records the official receiving time automatically.
                </small>

            </div>

            <!-- NOTES -->
            <div class="form-group">

                <label asp-for="Notes">
                    <i class="fa-solid fa-note-sticky"></i>
                    Notes
                </label>

                <textarea asp-for="Notes"
                          class="form-control notes"
                          placeholder="Optional notes about the received sample..."></textarea>

            </div>

            <!-- BUTTONS -->
            <div class="form-actions">

                <button type="button"
                        id="clearButton"
                        class="clear-button">

                    <i class="fa-solid fa-rotate-left"></i>
                    Clear

                </button>

                <button type="submit"
                        id="receiveButton"
                        class="receive-button"
                        disabled>

                    <i class="fa-solid fa-vial-circle-check"></i>
                    Receive Sample

                </button>

            </div>

        </form>

    </div>

    <!-- INFORMATION -->
    <div class="information-card">

        <div class="information-icon">
            <i class="fa-solid fa-circle-info"></i>
        </div>

        <div>
            <strong>Receiving procedure</strong>

            <p>
                Select the test request, enter or scan the sample barcode,
                click <strong>Verify</strong>, confirm the sample type,
                then click <strong>Receive Sample</strong>.
            </p>
        </div>

    </div>

</div>

</div>

<style>

    * {
        box-sizing: border-box;
    }

    /* =========================================================
           PAGE
           ========================================================= */

    .receive-page {
        min-height: 100vh;
        background: #f1f6f8;
        padding: 32px 20px 60px;
        font-family: "Segoe UI", Arial, sans-serif;
    }

    .receive-container {
        width: 100%;
        max-width: 973px;
        margin: 0 auto;
    }


    /* =========================================================
           PAGE HEADER
           Matches Available Laboratory Tests
           ========================================================= */

    .receive-header {
        background: linear-gradient(135deg, #0e8178, #086b64);
        color: #ffffff;
        border-radius: 18px;
        min-height: 118px;
        padding: 25px 32px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.08);
    }

    .header-icon {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(255, 255, 255, 0.14);
        border: 2px solid rgba(255, 255, 255, 0.30);
        font-size: 27px;
        flex-shrink: 0;
    }

    .receive-header h1 {
        margin: 0;
        font-size: 29px;
        line-height: 1.2;
        font-weight: 700;
        letter-spacing: -0.3px;
    }

    .receive-header p {
        margin: 7px 0 0;
        font-size: 13px;
        line-height: 1.5;
        color: rgba(255, 255, 255, 0.92);
    }


    /* =========================================================
           ALERTS
           ========================================================= */

    .alert-message {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px 17px;
        border-radius: 12px;
        margin-bottom: 18px;
        font-size: 13px;
    }

        .alert-message > i {
            font-size: 21px;
            flex-shrink: 0;
        }

        .alert-message strong {
            display: block;
            font-size: 13px;
            margin-bottom: 2px;
        }

        .alert-message span {
            font-size: 13px;
        }

    .success-message {
        background: #e9f8f3;
        border: 1px solid #c2e9dd;
        color: #176b52;
    }

    .error-message {
        background: #fdeeee;
        border: 1px solid #f4c7c7;
        color: #a52834;
    }


    /* =========================================================
           VALIDATION
           ========================================================= */

    .validation-summary {
        color: #dc3545;
        font-size: 13px;
        margin-bottom: 15px;
    }

        .validation-summary:empty {
            display: none;
        }

    .field-error {
        display: block;
        color: #dc3545;
        font-size: 12px;
        margin-top: 5px;
    }


    /* =========================================================
           MAIN RECEIVE CARD
           ========================================================= */

    .receive-card {
        background: #ffffff;
        border-radius: 18px;
        padding: 30px 34px;
        box-shadow: 0 6px 20px rgba(31, 45, 61, 0.07);
        border: 1px solid #edf1f3;
    }


    /* =========================================================
           FORM GROUP
           ========================================================= */

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            color: #334155;
            font-size: 13px;
            font-weight: 600;
            margin-bottom: 8px;
        }

            .form-group label i {
                width: 21px;
                color: #0e8178;
                margin-right: 2px;
            }

            .form-group label span {
                color: #dc3545;
                margin-left: 3px;
            }


    /* =========================================================
           INPUTS
           ========================================================= */

    .form-control {
        width: 100%;
        height: 50px;
        border: 1px solid #d8e1e5;
        border-radius: 10px;
        background: #ffffff;
        padding: 0 15px;
        color: #334155;
        font-family: inherit;
        font-size: 13px;
        outline: none;
        transition: all 0.2s ease;
    }

        .form-control::placeholder {
            color: #94a3b8;
        }

        .form-control:hover {
            border-color: #b8c8cc;
        }

        .form-control:focus {
            border-color: #0e8178;
            box-shadow: 0 0 0 3px rgba(14, 129, 120, 0.10);
        }

    select.form-control {
        cursor: pointer;
    }

    textarea.form-control {
        height: 110px;
        padding: 13px 15px;
        resize: vertical;
        line-height: 1.5;
    }


    /* =========================================================
           REQUEST WARNING
           ========================================================= */

    .request-warning {
        margin-top: 8px;
        padding: 10px 13px;
        border-radius: 9px;
        background: #fff8e6;
        border: 1px solid #f5df9f;
        color: #856404;
        font-size: 12px;
    }

        .request-warning i {
            margin-right: 6px;
        }


    /* =========================================================
           TECHNICIAN CARD
           ========================================================= */

    .technician-box {
        min-height: 60px;
        border-radius: 10px;
        border: 1px solid #dce8e8;
        background: #f1f8f7;
        display: flex;
        align-items: center;
        padding: 8px 14px;
        gap: 12px;
    }

    .technician-avatar {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #0e8178;
        color: #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .technician-box strong {
        display: block;
        color: #334155;
        font-size: 13px;
        font-weight: 700;
    }

    .technician-box small {
        display: block;
        color: #7b8c95;
        font-size: 11px;
        margin-top: 2px;
    }


    /* =========================================================
           BARCODE
           ========================================================= */

    .barcode-wrapper {
        display: flex;
        gap: 10px;
        width: 100%;
    }

        .barcode-wrapper .form-control {
            flex: 1;
        }

    .check-button {
        height: 50px;
        min-width: 108px;
        padding: 0 20px;
        border: none;
        border-radius: 10px;
        background: #455a64;
        color: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .check-button:hover {
            background: #34474f;
            transform: translateY(-1px);
        }

        .check-button:active {
            transform: translateY(0);
        }


    /* =========================================================
           READ ONLY BOXES
           ========================================================= */

    .readonly-box {
        min-height: 50px;
        border-radius: 10px;
        border: 1px solid #dce8e8;
        background: #f4f9f9;
        padding: 12px 15px;
        display: flex;
        align-items: center;
        gap: 10px;
        color: #607d8b;
        font-size: 13px;
    }

        .readonly-box i {
            color: #0e8178;
            flex-shrink: 0;
        }

    #sampleTypeBox {
        transition: all 0.2s ease;
    }

    .help-text {
        display: block;
        color: #84939b;
        margin-top: 6px;
        font-size: 11px;
    }


    /* =========================================================
           BARCODE STATUS
           ========================================================= */

    .barcode-message {
        min-height: 18px;
        margin-top: 7px;
        font-size: 12px;
    }

    .barcode-success {
        color: #16845f;
        font-weight: 600;
    }

    .barcode-error {
        color: #dc3545;
        font-weight: 600;
    }

    .barcode-checking {
        color: #607d8b;
    }


    /* =========================================================
           FORM BUTTON AREA
           ========================================================= */

    .form-actions {
        margin-top: 28px;
        padding-top: 22px;
        border-top: 1px solid #edf1f3;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }


    /* CLEAR */

    .clear-button {
        height: 46px;
        padding: 0 22px;
        border: 1px solid #d5dee1;
        border-radius: 10px;
        background: #ffffff;
        color: #64748b;
        font-family: inherit;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .clear-button:hover {
            background: #f5f7f8;
            border-color: #c3ced2;
            color: #475569;
        }


    /* RECEIVE */

    .receive-button {
        height: 48px;
        padding: 0 26px;
        border: none;
        border-radius: 10px;
        background: #0e8178;
        color: #ffffff;
        font-family: inherit;
        font-size: 13px;
        font-weight: 700;
        cursor: pointer;
        box-shadow: 0 4px 10px rgba(14, 129, 120, 0.16);
        transition: all 0.2s ease;
    }

        .receive-button:hover:not(:disabled) {
            background: #096b64;
            transform: translateY(-1px);
            box-shadow: 0 6px 14px rgba(14, 129, 120, 0.20);
        }

        .receive-button:active:not(:disabled) {
            transform: translateY(0);
        }

        .receive-button:disabled {
            background: #b7c3c7;
            color: #ffffff;
            cursor: not-allowed;
            box-shadow: none;
        }


    /* =========================================================
           INFORMATION CARD
           ========================================================= */

    .information-card {
        margin-top: 18px;
        background: #eaf6f5;
        border: 1px solid #d4ece9;
        border-left: 5px solid #0e8178;
        border-radius: 12px;
        padding: 16px 18px;
        display: flex;
        align-items: flex-start;
        gap: 13px;
        color: #315f5a;
    }

    .information-icon {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #d6eeeb;
        color: #0e8178;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 15px;
    }

    .information-card strong {
        display: block;
        color: #285e59;
        font-size: 13px;
        margin-bottom: 3px;
    }

    .information-card p {
        margin: 0;
        font-size: 12px;
        line-height: 1.55;
        color: #55736f;
    }

        .information-card p strong {
            display: inline;
            font-size: inherit;
            margin: 0;
        }


    /* =========================================================
           MOBILE
           ========================================================= */

    @@media (max-width: 700px) {

        .receive-page {
            padding: 20px 12px 50px;
        }

        .receive-container {
            max-width: 100%;
        }

        .receive-header {
            min-height: auto;
            padding: 22px;
            border-radius: 15px;
            gap: 15px;
        }

        .header-icon {
            width: 54px;
            height: 54px;
            font-size: 22px;
        }

        .receive-header h1 {
            font-size: 22px;
        }

        .receive-header p {
            font-size: 12px;
        }

        .receive-card {
            padding: 22px 18px;
            border-radius: 15px;
        }

        .barcode-wrapper {
            flex-direction: column;
        }

        .check-button {
            width: 100%;
        }

        .form-actions {
            flex-direction: column-reverse;
            gap: 10px;
            align-items: stretch;
        }

        .clear-button,
        .receive-button {
            width: 100%;
        }

        .information-card {
            padding: 14px;
        }
    }


    /* =========================================================
           SMALL SCREENS
           ========================================================= */

    @@media (max-width: 450px) {

        .receive-header {
            padding: 18px;
        }

            .receive-header h1 {
                font-size: 20px;
            }

        .receive-card {
            padding: 18px 15px;
        }

        .form-group {
            margin-bottom: 19px;
        }
    }

</style>

@section Scripts {

<partial name="_ValidationScriptsPartial" />

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const requestId = document.getElementById("requestId");
        const barcode = document.getElementById("sampleBarcode");
        const checkButton = document.getElementById("checkBarcode");
        const receiveButton = document.getElementById("receiveButton");
        const clearButton = document.getElementById("clearButton");
        const message = document.getElementById("barcodeMessage");
        const sampleType = document.getElementById("sampleType");
        const sampleTypeText = document.getElementById("sampleTypeText");
        const sampleTypeBox = document.getElementById("sampleTypeBox");
        const form = document.getElementById("receiveForm");

        let barcodeVerified = false;

        function resetBarcode() {

            barcodeVerified = false;

            receiveButton.disabled = true;

            sampleType.value = "";

            sampleTypeText.textContent =
                "Sample type will appear after barcode verification.";

            sampleTypeBox.style.color = "#607d8b";

            message.textContent = "";

            message.className = "barcode-message";
        }

        async function verifyBarcode() {

            resetBarcode();

            const request = requestId.value;
            const code = barcode.value.trim();

            if (!request) {

                message.textContent =
                    "Please select a test request first.";

                message.className =
                    "barcode-message barcode-error";

                return;
            }

            if (!code) {

                message.textContent =
                    "Please enter or scan the sample barcode.";

                message.className =
                    "barcode-message barcode-error";

                return;
            }

            message.textContent =
                "Checking barcode...";

            message.className =
                "barcode-message barcode-checking";

            try {

                const url =
                    "/SampleReceive/GetSampleType"
                    + "?requestId="
                    + encodeURIComponent(request)
                    + "&barcode="
                    + encodeURIComponent(code);

                const response =
                    await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });

                if (!response.ok) {

                    throw new Error(
                        "Server returned " + response.status
                    );
                }

                const data = await response.json();

                if (data.found) {

                    barcodeVerified = true;

                    sampleType.value =
                        data.sampleType;

                    sampleTypeText.textContent =
                        data.sampleType;

                    sampleTypeBox.style.color =
                        "#00695c";

                    message.innerHTML =
                        '<i class="fa-solid fa-circle-check"></i> ' +
                        'Barcode verified successfully.';

                    message.className =
                        "barcode-message barcode-success";

                    receiveButton.disabled = false;

                } else {

                    resetBarcode();

                    message.textContent =
                        data.message ||
                        "Barcode was not found.";

                    message.className =
                        "barcode-message barcode-error";
                }

            }
            catch (error) {

                resetBarcode();

                console.error(error);

                message.textContent =
                    "Could not verify the barcode. Please try again.";

                message.className =
                    "barcode-message barcode-error";
            }
        }

        requestId.addEventListener("change", function () {

            barcode.value = "";

            resetBarcode();

        });

        checkButton.addEventListener(
            "click",
            verifyBarcode
        );

        barcode.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    verifyBarcode();
                }

            }
        );

        barcode.addEventListener(
            "input",
            function () {

                barcodeVerified = false;

                receiveButton.disabled = true;

                sampleType.value = "";

                sampleTypeText.textContent =
                    "Click Verify to check this barcode.";

                message.textContent = "";

            }
        );

        clearButton.addEventListener(
            "click",
            function () {

                requestId.value = "";

                barcode.value = "";

                const notes =
                    document.querySelector(
                        "textarea[name='Notes']"
                    );

                if (notes) {
                    notes.value = "";
                }

                resetBarcode();

            }
        );

        form.addEventListener(
            "submit",
            function (event) {

                if (!barcodeVerified) {

                    event.preventDefault();

                    alert(
                        "Please verify the sample barcode before receiving the sample."
                    );

                    return;
                }

                receiveButton.disabled = true;

                receiveButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Recording Sample...';

            }
        );

    });

</script>

}

