@section Scripts {

```
<partial name="_ValidationScriptsPartial" />

<script>

    document.addEventListener("DOMContentLoaded", function () {

        const requestId =
            document.getElementById("requestId");

        const barcode =
            document.getElementById("sampleBarcode");

        const checkButton =
            document.getElementById("checkBarcode");

        const receiveButton =
            document.getElementById("receiveButton");

        const clearButton =
            document.getElementById("clearButton");

        const message =
            document.getElementById("barcodeMessage");

        const sampleType =
            document.getElementById("sampleType");

        const sampleTypeText =
            document.getElementById("sampleTypeText");

        const sampleTypeBox =
            document.getElementById("sampleTypeBox");

        const form =
            document.getElementById("receiveForm");


        let barcodeVerified = false;


        // ==========================================
        // RESET
        // ==========================================

        function resetBarcode() {

            barcodeVerified = false;

            receiveButton.disabled = true;

            sampleType.value = "";

            sampleTypeText.textContent =
                "Sample type will appear after barcode verification.";

            sampleTypeBox.style.color = "#607d8b";

            message.textContent = "";

            message.className = "barcode-message";
        }


        // ==========================================
        // VERIFY BARCODE
        // ==========================================

        async function verifyBarcode() {

            resetBarcode();

            const request =
                requestId.value;

            const code =
                barcode.value.trim();


            if (!request) {

                message.textContent =
                    "Please select a test request first.";

                message.className =
                    "barcode-message barcode-error";

                return;
            }


            if (!code) {

                message.textContent =
                    "Please enter or scan the sample barcode.";

                message.className =
                    "barcode-message barcode-error";

                return;
            }


            message.textContent =
                "Checking barcode...";

            message.className =
                "barcode-message barcode-checking";


            try {

                const url =
                    "/SampleReceive/GetSampleType"
                    + "?requestId="
                    + encodeURIComponent(request)
                    + "&barcode="
                    + encodeURIComponent(code);


                const response =
                    await fetch(url, {
                        method: "GET",
                        headers: {
                            "Accept": "application/json"
                        }
                    });


                if (!response.ok) {

                    throw new Error(
                        "Server returned " +
                        response.status
                    );
                }


                const data =
                    await response.json();


                if (data.found) {

                    barcodeVerified = true;

                    sampleType.value =
                        data.sampleType;

                    sampleTypeText.textContent =
                        data.sampleType;

                    sampleTypeBox.style.color =
                        "#00695c";


                    message.innerHTML =
                        '<i class="fa-solid fa-circle-check"></i> ' +
                        'Barcode verified successfully.';


                    message.className =
                        "barcode-message barcode-success";


                    receiveButton.disabled = false;

                }
                else {

                    resetBarcode();

                    message.textContent =
                        data.message ||
                        "Barcode was not found.";

                    message.className =
                        "barcode-message barcode-error";
                }

            }
            catch (error) {

                resetBarcode();

                console.error(error);

                message.textContent =
                    "Could not verify the barcode. Please try again.";

                message.className =
                    "barcode-message barcode-error";
            }
        }


        // ==========================================
        // REQUEST CHANGED
        // ==========================================

        requestId.addEventListener(
            "change",
            function () {

                barcode.value = "";

                resetBarcode();

            }
        );


        // ==========================================
        // VERIFY BUTTON
        // ==========================================

        checkButton.addEventListener(
            "click",
            verifyBarcode
        );


        // ==========================================
        // ENTER KEY
        // ==========================================

        barcode.addEventListener(
            "keydown",
            function (event) {

                if (event.key === "Enter") {

                    event.preventDefault();

                    verifyBarcode();
                }

            }
        );


        // ==========================================
        // BARCODE CHANGED
        // ==========================================

        barcode.addEventListener(
            "input",
            function () {

                barcodeVerified = false;

                receiveButton.disabled = true;

                sampleType.value = "";

                sampleTypeText.textContent =
                    "Click Verify to check this barcode.";

                message.textContent = "";

            }
        );


        // ==========================================
        // CLEAR
        // ==========================================

        clearButton.addEventListener(
            "click",
            function () {

                requestId.value = "";

                barcode.value = "";

                document.querySelector(
                    "textarea[name='Notes']"
                ).value = "";

                resetBarcode();

            }
        );


        // ==========================================
        // FINAL SUBMIT CHECK
        // ==========================================

        form.addEventListener(
            "submit",
            function (event) {

                if (!barcodeVerified) {

                    event.preventDefault();

                    alert(
                        "Please verify the sample barcode before receiving the sample."
                    );

                    return;
                }


                receiveButton.disabled = true;

                receiveButton.innerHTML =
                    '<i class="fa-solid fa-spinner fa-spin"></i> Recording Sample...';

            }
        );

    });

</script>

