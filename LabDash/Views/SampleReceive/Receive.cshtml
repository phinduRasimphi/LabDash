@model LabDash.Models.SampleReceive

@{
    ViewData["Title"] = "Receive Patient Sample";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    .rps-body-bg {
        background: #eef7f8;
        font-family: "Segoe UI", sans-serif;
    }

    .rps-container {
        max-width: 1050px;
        margin: 35px auto;
        padding: 0 20px;
    }

    .rps-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.10);
        border: none;
    }

    .rps-header {
        background: linear-gradient(135deg, #00897B 0%, #00695C 100%);
        color: white;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .rps-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .rps-header-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,.35);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 34px;
        background: rgba(255,255,255,.08);
        flex-shrink: 0;
    }

    .rps-header h2 {
        margin: 0;
        font-size: 36px;
        font-weight: 700;
    }

    .rps-header p {
        margin: 6px 0 0;
        font-size: 17px;
        opacity: .95;
    }

    .rps-body {
        padding: 40px;
    }

    .rps-form-row {
        display: grid;
        grid-template-columns: 250px 1fr;
        align-items: center;
        gap: 30px;
        padding: 18px 0;
    }

    .rps-notes-row {
        align-items: start;
    }

    .rps-form-label {
        font-size: 17px;
        font-weight: 600;
        color: #2f3e46;
        margin: 0;
    }

        .rps-form-label i {
            color: #009688;
            width: 25px;
            margin-right: 8px;
        }

    .rps-divider {
        margin: 0;
        border: none;
        border-top: 1px solid #ececec;
    }

    .rps-form-control,
    .rps-form-select {
        height: 50px;
        border-radius: 10px;
        border: 1px solid #d9dee3;
        font-size: 15px;
        transition: .25s;
        width: 100%;
        padding: 0 14px;
    }

        .rps-form-control:focus,
        .rps-form-select:focus {
            border-color: #009688;
            box-shadow: 0 0 0 .18rem rgba(0,150,136,.15);
            outline: none;
        }

    textarea.rps-form-control {
        height: 150px;
        resize: vertical;
        padding: 12px 14px;
    }

    .rps-readonly-display {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 50px;
        padding: 0 16px;
        border-radius: 10px;
        background: #f2f8f8;
        border: 1px solid #dce8e7;
        color: #00695C;
        font-weight: 600;
    }

    .rps-readonly-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #009688;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12.5px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rps-required {
        color: #dc3545;
    }

    .rps-footer-buttons {
        margin-top: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rps-btn-clear {
        border: 1px solid #ced4da;
        background: white;
        color: #555;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        transition: .25s;
    }

        .rps-btn-clear:hover {
            background: #f4f4f4;
        }

    .rps-btn-receive {
        background: #009688;
        color: white;
        border: none;
        padding: 13px 35px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        transition: .3s;
    }

        .rps-btn-receive:hover {
            background: #00796B;
            color: white;
            transform: translateY(-2px);
        }

    .rps-validation-summary ul {
        margin-bottom: 20px;
    }

    .rps-text-danger {
        font-size: 14px;
        color: #dc3545;
    }

    @@media(max-width:900px) {

        .rps-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .rps-form-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .rps-footer-buttons {
            flex-direction: column;
            gap: 15px;
        }

            .rps-footer-buttons button {
                width: 100%;
            }
    }

</style>

<div class="rps-body-bg">

    <div class="rps-container">

        <div class="rps-card">

            <div class="rps-header">

                <div class="rps-header-left">

                    <div class="rps-header-icon">
                        <i class="fas fa-vials"></i>
                    </div>

                    <div>

                        <h2>Receive Patient Sample</h2>

                        <p>
                            Verify the request and record the received laboratory sample.
                        </p>

                    </div>

                </div>

            </div>

            <div class="rps-body">

                <form asp-action="Receive" method="post">

                    <div asp-validation-summary="ModelOnly" class="rps-validation-summary rps-text-danger"></div>

                    <!-- Test Request -->

                    <div class="rps-form-row">

                        <label asp-for="RequestId" class="rps-form-label">
                            <i class="fas fa-clipboard-list"></i>
                            Test Request
                            <span class="rps-required">*</span>
                        </label>

                        <div>

                            <select asp-for="RequestId"
                                    asp-items="ViewBag.RequestList"
                                    class="rps-form-select">

                                <option value="">-- Select Test Request --</option>

                            </select>

                            <span asp-validation-for="RequestId"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Technician (read-only, server-assigned) -->

                    <div class="rps-form-row">

                        <label class="rps-form-label">
                            <i class="fas fa-user"></i>
                            Technician Receiving Sample
                        </label>

                        <div>

                            <div class="rps-readonly-display">
                                <span class="rps-readonly-avatar">
                                    @{
                                        var currentName = User.Identity?.Name ?? "?";
                                        var displayInitials = string.Join("", currentName
                                                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                                    .Take(2)
                                                                    .Select(n => n[0])).ToUpper();
                                    }
                                    @displayInitials
                                </span>
                                @currentName
                            </div>

                            <small class="text-muted">
                                Automatically recorded as the logged-in technician.
                            </small>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Barcode -->

                    <div class="rps-form-row">

                        <label asp-for="SampleBarcode" class="rps-form-label">
                            <i class="fas fa-barcode"></i>
                            Sample Barcode
                        </label>

                        <div>

                            <input asp-for="SampleBarcode"
                                   class="rps-form-control"
                                   placeholder="Scan or enter barcode" />

                            <span asp-validation-for="SampleBarcode"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Sample Type -->

                    <div class="rps-form-row">

                        <label asp-for="SampleType" class="rps-form-label">
                            <i class="fas fa-flask"></i>
                            Sample Type
                        </label>

                        <div>

                            <select asp-for="SampleType" class="rps-form-select">

                                <option value="">-- Select Sample Type --</option>

                                <option>Blood</option>
                                <option>Urine</option>
                                <option>Saliva</option>
                                <option>Stool</option>
                                <option>Sputum</option>
                                <option>Plasma</option>
                                <option>Serum</option>
                                <option>Tissue</option>

                            </select>

                            <span asp-validation-for="SampleType"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Notes -->

                    <div class="rps-form-row rps-notes-row">

                        <label asp-for="Notes" class="rps-form-label">
                            <i class="fas fa-note-sticky"></i>
                            Notes
                        </label>

                        <div>

                            <textarea asp-for="Notes"
                                      class="rps-form-control"
                                      placeholder="Optional notes..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <div class="rps-footer-buttons">

                        <button type="reset" class="btn rps-btn-clear">
                            <i class="fas fa-rotate-left"></i>
                            Clear Form
                        </button>

                        <button type="submit" class="btn rps-btn-receive">
                            <i class="fas fa-vials"></i>
                            Receive Sample
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}