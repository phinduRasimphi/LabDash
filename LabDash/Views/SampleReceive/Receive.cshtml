@model IEnumerable<LabDash.Models.TestRequest>

@{
    ViewData["Title"] = "Sample Receive";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var requests = Model?.ToList() ?? new List<LabDash.Models.TestRequest>();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --ink: #0f2f2d;
        --muted: #6b817f;
        --border: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --danger: #c0443f;
        --danger-soft: #fde8e8;
        --danger-border: #f3c4c4;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
        --radius-lg: 20px;
        --shadow-soft: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .receive-page,
    .receive-page *,
    #receiveModal,
    #receiveModal * {
        box-sizing: border-box;
    }

    .receive-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--ink);
        background: var(--page-bg);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    .receive-page *:focus-visible,
    #receiveModal *:focus-visible {
        outline: 3px solid rgba(15, 148, 136, .4);
        outline-offset: 2px;
        border-radius: 8px;
    }


    /* =========================================================
       HERO HEADER
       ========================================================= */

    .receive-page .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .receive-page .header-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .receive-page .page-title {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .receive-page .page-subtitle {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .receive-page .header-stat {
        min-width: 150px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

    .receive-page .header-stat span {
        display: block;
        margin-bottom: 4px;
        color: rgba(255, 255, 255, .78);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .receive-page .header-stat strong {
        color: #fff;
        font-size: 22px;
        font-weight: 700;
    }


    /* =========================================================
       ALERTS
       ========================================================= */

    .receive-page .alert-box {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        margin-bottom: 20px;
        border-radius: 16px;
        box-shadow: var(--shadow-soft);
        font-size: 13px;
        font-weight: 600;
    }

    .receive-page .alert-success {
        color: #187341;
        background: var(--success-soft);
        border: 1px solid #ccebd8;
        border-left: 4px solid var(--success);
    }

    .receive-page .alert-danger {
        color: #7c343b;
        background: var(--danger-soft);
        border: 1px solid var(--danger-border);
        border-left: 4px solid var(--danger);
    }

    .receive-page .alert-box button {
        margin-left: auto;
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        font-size: 16px;
    }


    /* =========================================================
       STATISTICS
       ========================================================= */

    .receive-page .stats-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .receive-page .stat-card {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 24px;
        background: #fff;
        border: 0;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .receive-page .stat-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--teal);
        background: var(--teal-light);
        font-size: 22px;
    }

    .receive-page .stat-number {
        color: var(--teal-dark);
        font-family: "Inter", sans-serif;
        font-size: 28px;
        font-weight: 800;
        letter-spacing: -.5px;
        line-height: 1;
    }

    .receive-page .stat-label {
        margin-top: 6px;
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .3px;
        text-transform: uppercase;
    }


    /* =========================================================
       SEARCH
       ========================================================= */

    .receive-page .toolbar {
        padding: 16px 20px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .receive-page .search-wrapper {
        position: relative;
    }

    .receive-page .search-wrapper i {
        position: absolute;
        top: 50%;
        left: 17px;
        transform: translateY(-50%);
        color: var(--muted);
        pointer-events: none;
    }

    .receive-page .search-input {
        width: 100%;
        height: 46px;
        padding: 0 16px 0 44px;
        color: var(--ink);
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 999px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

    .receive-page .search-input::placeholder {
        color: #8aa09e;
    }

    .receive-page .search-input:focus {
        background: #fff;
        border-color: var(--teal);
        box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
    }


    /* =========================================================
       REQUEST CARD
       ========================================================= */

    .receive-page .request-card {
        margin-bottom: 22px;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .receive-page .request-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 18px 26px;
        background: #fff;
        border-bottom: 1px solid var(--border);
    }

    .receive-page .request-label {
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .receive-page .request-number {
        margin-top: 3px;
        color: var(--ink);
        font-family: "Inter", sans-serif;
        font-size: 20px;
        font-weight: 700;
    }

    .receive-page .request-badges {
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

    .receive-page .badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .receive-page .badge-routine {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .receive-page .badge-urgent {
        color: var(--warning);
        background: var(--warning-soft);
    }

    .receive-page .badge-stat {
        color: var(--danger);
        background: var(--danger-soft);
    }

    .receive-page .badge-pending {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .receive-page .badge-partial {
        color: var(--warning);
        background: var(--warning-soft);
    }


    /* =========================================================
       PATIENT
       ========================================================= */

    .receive-page .patient-section {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 16px 26px;
        border-bottom: 1px solid var(--border);
    }

    .receive-page .patient-avatar {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--teal-dark);
        background: #fff;
        border: 2px solid #d5c98a;
        border-radius: 50%;
        font-size: 14px;
        font-weight: 700;
    }

    .receive-page .patient-name {
        color: var(--ink);
        font-size: 15px;
        font-weight: 700;
    }

    .receive-page .patient-id {
        margin-top: 3px;
        color: var(--muted);
        font-size: 12px;
    }


    /* =========================================================
       REQUESTED TESTS
       ========================================================= */

    .receive-page .tests-section {
        padding: 18px 26px;
        border-bottom: 1px solid var(--border);
    }

    .receive-page .section-heading {
        display: flex;
        align-items: center;
        gap: 9px;
        margin-bottom: 10px;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 700;
    }

    .receive-page .section-heading.no-margin {
        margin-bottom: 0;
    }

    .receive-page .section-heading i {
        color: var(--teal);
    }

    .receive-page .test-tags {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .receive-page .test-tag {
        padding: 6px 13px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }


    /* =========================================================
       PROGRESS
       ========================================================= */

    .receive-page .progress-section {
        padding: 18px 26px;
        border-bottom: 1px solid var(--border);
    }

    .receive-page .progress-top {
        display: flex;
        justify-content: space-between;
        margin-bottom: 10px;
    }

    .receive-page .progress-title {
        color: var(--ink);
        font-size: 13px;
        font-weight: 700;
    }

    .receive-page .progress-count {
        margin-top: 2px;
        color: var(--muted);
        font-size: 12px;
    }

    .receive-page .progress-percentage {
        color: var(--teal-dark);
        font-size: 16px;
        font-weight: 800;
    }

    /* renamed from .progress-bar so Bootstrap's .progress-bar cannot interfere */
    .receive-page .reception-bar {
        height: 10px;
        overflow: hidden;
        background: #e3ecec;
        border-radius: 999px;
    }

    .receive-page .progress-fill {
        height: 100%;
        background: var(--btn-gradient);
        border-radius: 999px;
        transition: width .3s ease;
    }


    /* =========================================================
       SAMPLE TABLE
       ========================================================= */

    .receive-page .samples-section {
        padding: 18px 26px 24px;
    }

    .receive-page .samples-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 14px;
    }

    .receive-page .awaiting-badge {
        padding: 4px 12px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .receive-page .table-wrapper {
        overflow-x: auto;
        border: 1px solid var(--border);
        border-radius: 14px;
    }

    .receive-page .sample-table {
        width: 100%;
        min-width: 850px;
        border-collapse: separate;
        border-spacing: 0;
    }

    .receive-page .sample-table thead th {
        padding: 14px 16px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border: 0;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .4px;
        text-align: left;
        text-transform: uppercase;
        white-space: nowrap;
    }

    .receive-page .sample-table td {
        padding: 14px 16px;
        color: var(--ink);
        background: #fff;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
        text-align: left;
        vertical-align: middle;
    }

    .receive-page .sample-table tbody tr:last-child td {
        border-bottom: 0;
    }

    .receive-page .sample-table tbody tr:hover td {
        background: var(--teal-soft);
    }

    .receive-page .test-type-name {
        color: var(--ink);
        font-weight: 700;
    }

    .receive-page .test-category {
        margin-top: 3px;
        color: var(--muted);
        font-size: 11px;
    }

    .receive-page .sample-type {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        color: var(--ink);
        font-weight: 600;
    }

    .receive-page .sample-type i {
        color: var(--teal);
    }

    .receive-page .barcode-received {
        color: var(--teal-dark);
        font-family: "Consolas", monospace;
        font-weight: 700;
        letter-spacing: .5px;
    }


    /* =========================================================
       BARCODE
       ========================================================= */

    .receive-page .barcode-edit-form {
        display: flex;
        align-items: center;
        gap: 6px;
        margin: 0;
    }

    .receive-page .barcode-input {
        width: 155px;
        height: 38px;
        padding: 0 12px;
        color: var(--teal-dark);
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 10px;
        font-family: "Consolas", monospace;
        font-size: 12px;
        font-weight: 700;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

    .receive-page .barcode-input:focus {
        background: #fff;
        border-color: var(--teal);
        box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
    }

    .receive-page .barcode-input.invalid {
        background: #fff7f7;
        border-color: var(--danger);
    }

    .receive-page .barcode-save {
        width: 38px;
        height: 38px;
        color: var(--teal-dark);
        background: #fff;
        border: 1.5px solid var(--teal-border);
        border-radius: 10px;
        cursor: pointer;
        transition: .2s;
    }

    .receive-page .barcode-save:hover {
        color: #fff;
        background: var(--teal);
        border-color: var(--teal);
    }

    .receive-page .barcode-validation {
        display: none;
        margin-top: 5px;
        color: var(--danger);
        font-size: 11px;
        font-weight: 600;
    }

    .receive-page .barcode-validation.show {
        display: block;
    }


    /* =========================================================
       STATUS
       ========================================================= */

    .receive-page .status-awaiting,
    .receive-page .status-received {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .receive-page .status-awaiting {
        color: var(--warning);
        background: var(--warning-soft);
    }

    .receive-page .status-received {
        color: var(--success);
        background: var(--success-soft);
    }

    .receive-page .muted-cell {
        color: #9aa8ae;
    }

    .receive-page .complete-text {
        color: var(--success);
        font-size: 12px;
        font-weight: 700;
    }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .receive-page .receive-form {
        margin: 0;
    }

    .receive-page .receive-button {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 9px 16px;
        color: #fff;
        background: var(--btn-gradient);
        border: 0;
        border-radius: 12px;
        box-shadow: 0 6px 14px rgba(10, 93, 85, .25);
        font-family: "Inter", sans-serif;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
        cursor: pointer;
        transition: transform .15s, box-shadow .15s;
    }

    .receive-page .receive-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 9px 20px rgba(10, 93, 85, .34);
    }

    .receive-page .receive-button i {
        margin: 0;
    }


    /* =========================================================
       REQUEST FOOTER
       ========================================================= */

    .receive-page .request-footer {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 20px;
        padding: 14px 26px;
        color: var(--muted);
        background: var(--teal-soft);
        border-top: 1px solid var(--border);
        font-size: 12px;
    }

    .receive-page .request-footer strong {
        color: var(--ink);
        font-weight: 700;
    }

    .receive-page .request-footer div div {
        margin-top: 3px;
    }


    /* =========================================================
       EMPTY
       ========================================================= */

    .receive-page .empty-state {
        padding: 60px 25px;
        text-align: center;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .receive-page .empty-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        color: var(--teal);
        background: var(--teal-light);
        border-radius: 50%;
        font-size: 25px;
    }

    .receive-page .empty-state h3 {
        margin: 0 0 6px;
        color: var(--ink);
        font-family: "Inter", sans-serif;
        font-size: 18px;
        font-weight: 700;
    }

    .receive-page .empty-state p {
        margin: 0;
        color: var(--muted);
        font-size: 13px;
    }

    .receive-page .no-samples-cell {
        padding: 30px !important;
        color: var(--muted) !important;
        text-align: center !important;
    }


    /* =========================================================
       MODAL (scoped to #receiveModal so Bootstrap's .modal-* classes are overridden)
       ========================================================= */

    #receiveModal.modal-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(15, 47, 45, .55);
        font-family: "Inter", sans-serif;
        color: var(--ink);
    }

    #receiveModal.modal-overlay.show {
        display: flex;
    }

    #receiveModal .receive-modal {
        width: 100%;
        max-width: 480px;
        overflow: hidden;
        background: #fff;
        border-radius: var(--radius-lg);
        box-shadow: 0 25px 60px rgba(10, 60, 55, .3);
    }

    #receiveModal .modal-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        color: var(--ink);
        background: #fff;
        border-bottom: 1px solid var(--border);
    }

    #receiveModal .modal-header h3 {
        display: flex;
        align-items: center;
        gap: 11px;
        margin: 0;
        color: var(--ink);
        font-family: "Inter", sans-serif;
        font-size: 17px;
        font-weight: 700;
    }

    #receiveModal .modal-header h3 i {
        color: var(--teal);
        font-size: 16px;
    }

    #receiveModal .modal-close {
        width: 34px;
        height: 34px;
        color: var(--muted);
        background: transparent;
        border: 0;
        border-radius: 10px;
        font-size: 18px;
        cursor: pointer;
    }

    #receiveModal .modal-close:hover {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    #receiveModal .modal-body {
        padding: 22px 26px;
    }

    #receiveModal .modal-info {
        padding: 12px 16px;
        margin-bottom: 18px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

    #receiveModal .modal-info-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 7px 0;
        font-size: 13px;
    }

    #receiveModal .modal-info-row span:first-child {
        color: var(--muted);
    }

    #receiveModal .modal-info-row span:last-child {
        color: var(--ink);
        font-weight: 700;
        text-align: right;
        overflow-wrap: anywhere;
    }

    #receiveModal .notes-label {
        display: block;
        margin-bottom: 8px;
        color: var(--ink);
        font-size: 13px;
        font-weight: 600;
    }

    #receiveModal .notes-label span {
        color: var(--muted);
        font-weight: 400;
    }

    #receiveModal .notes-input {
        width: 100%;
        min-height: 100px;
        padding: 12px 16px;
        color: var(--ink);
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        line-height: 1.6;
        outline: none;
        resize: vertical;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

    #receiveModal .notes-input::placeholder {
        color: #8aa09e;
    }

    #receiveModal .notes-input:focus {
        background: #fff;
        border-color: var(--teal);
        box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
    }

    #receiveModal .modal-footer {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding: 16px 26px;
        border-top: 1px solid var(--border);
    }

    #receiveModal .cancel-button,
    #receiveModal .confirm-button {
        min-height: 42px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 10px 20px;
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: box-shadow .15s, transform .1s, background .15s;
    }

    #receiveModal .cancel-button {
        color: #3f605d;
        background: #fff;
        border: 1px solid var(--teal-border);
    }

    #receiveModal .cancel-button:hover {
        color: var(--teal-dark);
        background: var(--teal-soft);
    }

    #receiveModal .confirm-button {
        color: #fff;
        background: var(--btn-gradient);
        border: 0;
        box-shadow: 0 8px 18px rgba(10, 93, 85, .28);
    }

    #receiveModal .confirm-button:hover {
        transform: translateY(-1px);
        box-shadow: 0 10px 22px rgba(10, 93, 85, .36);
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 900px) {

        .receive-page .stats-grid {
            grid-template-columns: 1fr;
        }

        .receive-page .header-stat {
            display: none;
        }
    }

    @@media (max-width: 576px) {

        .receive-page {
            padding: 12px 9px 28px;
        }

        .receive-page .page-header {
            padding: 18px;
            border-radius: 20px;
        }

        .receive-page .page-title {
            font-size: 19px;
        }

        .receive-page .request-header,
        .receive-page .patient-section,
        .receive-page .tests-section,
        .receive-page .progress-section,
        .receive-page .samples-section,
        .receive-page .request-footer {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

</style>

<div class="receive-page">

    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="page-header">

        <div class="header-icon">
            <i class="fa-solid fa-vials"></i>
        </div>

        <div>
            <h1 class="page-title">Sample Receive</h1>

            <p class="page-subtitle">
                Receive and verify individual laboratory samples before testing.
            </p>
        </div>

        <div class="header-stat">
            <span>Requests waiting</span>
            <strong>@requests.Count</strong>
        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->

    @if (TempData["Success"] != null)
    {
        <div class="alert-box alert-success">

            <i class="fa-solid fa-circle-check"></i>

            <span>
                @TempData["Success"]
            </span>

            <button type="button"
                    aria-label="Dismiss"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert-box alert-danger">

            <i class="fa-solid fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

            <button type="button"
                    aria-label="Dismiss"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }


    <!-- =========================================================
         STATISTICS
         ========================================================= -->

    @{
        var totalRequests = requests.Count;

        var totalSamples = requests
            .SelectMany(r => r.Samples ?? Enumerable.Empty<LabDash.Models.Sample>())
            .Count();

        var waitingSamples = requests
            .SelectMany(r => r.Samples ?? Enumerable.Empty<LabDash.Models.Sample>())
            .Count(s => !s.IsReceived);

        var urgentRequests = requests
            .Count(r =>
                string.Equals(r.Urgency, "STAT", StringComparison.OrdinalIgnoreCase) ||
                string.Equals(r.Urgency, "Urgent", StringComparison.OrdinalIgnoreCase));
    }

    <div class="stats-grid">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-clipboard-list"></i>
            </div>

            <div>
                <div class="stat-number">
                    @totalRequests
                </div>

                <div class="stat-label">
                    Requests Awaiting Samples
                </div>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-vial"></i>
            </div>

            <div>
                <div class="stat-number">
                    @waitingSamples
                </div>

                <div class="stat-label">
                    Samples Awaiting Receipt
                </div>
            </div>

        </div>


        <div class="stat-card">

            <div class="stat-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div>
                <div class="stat-number">
                    @urgentRequests
                </div>

                <div class="stat-label">
                    Urgent / STAT Requests
                </div>
            </div>

        </div>

    </div>


    <!-- =========================================================
         SEARCH
         ========================================================= -->

    <div class="toolbar">

        <div class="search-wrapper">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="sampleSearch"
                   class="search-input"
                   placeholder="Scan barcode, or search patient / test..."
                   aria-label="Search sample requests" />

        </div>

    </div>


    <!-- =========================================================
         REQUESTS
         ========================================================= -->

    @if (!requests.Any())
    {
        <div class="empty-state">

            <div class="empty-icon">
                <i class="fa-solid fa-vial-circle-check"></i>
            </div>

            <h3>No Samples Awaiting Receipt</h3>

            <p>
                There are currently no pending sample requests.
            </p>

        </div>
    }
    else
    {
        foreach (var request in requests)
        {
            var samples = request.Samples?
                .OrderBy(s => s.SampleId)
                .ToList()
                ?? new List<LabDash.Models.Sample>();

            var testItems = request.TestRequestItems?
                .OrderBy(i => i.TestRequestItemId)
                .ToList()
                ?? new List<LabDash.Models.TestRequestItem>();

            var receivedCount = samples.Count(s => s.IsReceived);

            var sampleCount = samples.Count;

            var percentage = sampleCount > 0
                ? (int)Math.Round((double)receivedCount / sampleCount * 100)
                : 0;

            var searchText =
    $"#{request.RequestId} " +
    $"{request.Patient?.Name} " +
    $"{request.Patient?.Surname} " +
    $"{request.Patient?.PatientID} " +
    string.Join(" ", testItems.Select(i => i.TestType?.Name ?? ""));

            var urgencyClass =
                request.Urgency == "STAT"
                    ? "badge-stat"
                    : request.Urgency == "Urgent"
                        ? "badge-urgent"
                        : "badge-routine";

            var statusClass =
                request.Status == "Partially Received"
                    ? "badge-partial"
                    : "badge-pending";

            <div class="request-card"
                 data-search="@searchText">

                <!-- =================================================
                     REQUEST HEADER
                     ================================================= -->

                <div class="request-header">

                    <div>

                        <div class="request-label">
                            Test Request
                        </div>

                        <div class="request-number">
                            #@request.RequestId
                        </div>

                    </div>


                    <div class="request-badges">

                        <span class="badge @urgencyClass">

                            <i class="fa-solid fa-clock"></i>

                            @(string.IsNullOrWhiteSpace(request.Urgency)
                                ? "Routine"
                                : request.Urgency)

                        </span>


                        <span class="badge @statusClass">
                            @request.Status
                        </span>

                    </div>

                </div>


                <!-- =================================================
                     PATIENT
                     ================================================= -->

                <div class="patient-section">

                    @{
                        var patientFirst =
                            request.Patient?.Name?.Trim() ?? "";

                        var patientLast =
                            request.Patient?.Surname?.Trim() ?? "";

                        var initials =
                            $"{(patientFirst.Length > 0 ? patientFirst[0].ToString() : "")}" +
                            $"{(patientLast.Length > 0 ? patientLast[0].ToString() : "")}";
                    }

                    <div class="patient-avatar">
                        @(string.IsNullOrWhiteSpace(initials) ? "P" : initials)
                    </div>

                    <div>

                        <div class="patient-name">
                            @(string.IsNullOrWhiteSpace(patientFirst + patientLast)
                                ? "Unknown Patient"
                                : $"{patientFirst} {patientLast}")
                        </div>

                        <div class="patient-id">
                            ID:
                            @(request.Patient?.PatientID.ToString() ?? "Not available")
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     REQUESTED TESTS
                     ================================================= -->

                <div class="tests-section">

                    <div class="section-heading">
                        <i class="fa-solid fa-flask"></i>
                        <span>Requested Tests</span>
                    </div>

                    <div class="test-tags">

                        @if (testItems.Any())
                        {
                            foreach (var item in testItems)
                            {
                                <span class="test-tag">
                                    @(item.TestType?.Name ?? "Unknown Test")
                                </span>
                            }
                        }
                        else
                        {
                            <span class="test-tag">
                                No test information available
                            </span>
                        }

                    </div>

                </div>


                <!-- =================================================
                     PROGRESS
                     ================================================= -->

                <div class="progress-section">

                    <div class="progress-top">

                        <div>
                            <div class="progress-title">
                                Sample Reception Progress
                            </div>

                            <div class="progress-count">
                                @receivedCount of @sampleCount samples received
                            </div>
                        </div>

                        <div class="progress-percentage">
                            @percentage%
                        </div>

                    </div>

                    <div class="reception-bar">

                        <div class="progress-fill"
                             style="width:@percentage%;"></div>

                    </div>

                </div>


                <!-- =================================================
                     INDIVIDUAL SAMPLE TABLE
                     ================================================= -->

                <div class="samples-section">

                    <div class="samples-heading">

                        <div class="section-heading no-margin">

                            <i class="fa-solid fa-vial"></i>

                            <span>
                                Individual Samples
                            </span>

                        </div>

                        <span class="awaiting-badge">

                            @samples.Count(s => !s.IsReceived)
                            awaiting

                        </span>

                    </div>


                    <div class="table-wrapper">

                        <table class="sample-table">

                            <thead>

                                <tr>

                                    <th>
                                        Test Type
                                    </th>

                                    <th>
                                        Sample Type
                                    </th>

                                    <th>
                                        Barcode
                                    </th>

                                    <th>
                                        Status
                                    </th>

                                    <th>
                                        Received By
                                    </th>

                                    <th>
                                        Date Received
                                    </th>

                                    <th>
                                        Action
                                    </th>

                                </tr>

                            </thead>


                            <tbody>

                                @if (!samples.Any())
                                {
                                    <tr>

                                        <td colspan="7"
                                            class="no-samples-cell">

                                            No physical samples have been created
                                            for this request.

                                        </td>

                                    </tr>
                                }
                                else
                                {
                                    for (int sampleIndex = 0;
                                         sampleIndex < samples.Count;
                                         sampleIndex++)
                                    {
                                        var sample = samples[sampleIndex];

                                        /*
                                         * A TestRequestItem does not contain
                                         * SampleId in the current model.
                                         *
                                         * Therefore we display the test type
                                         * by matching the physical sample to
                                         * the test item by position.
                                         *
                                         * If there are more samples than tests,
                                         * the remaining samples display
                                         * "Additional Sample".
                                         */

                                        LabDash.Models.TestRequestItem? matchedTest = null;

                                        if (sampleIndex < testItems.Count)
                                        {
                                            matchedTest = testItems[sampleIndex];
                                        }

                                        var testName =
                                            matchedTest?.TestType?.Name
                                            ?? "Additional Sample";

                                        var testCategory =
                                            matchedTest?.TestType?.Category
                                            ?? "";

                                        <tr>

                                            <!-- TEST TYPE -->

                                            <td>

                                                <div class="test-type-name">
                                                    @testName
                                                </div>

                                                @if (!string.IsNullOrWhiteSpace(testCategory))
                                                {
                                                    <div class="test-category">
                                                        @testCategory
                                                    </div>
                                                }

                                            </td>


                                            <!-- SAMPLE TYPE -->

                                            <td>

                                                <span class="sample-type">

                                                    <i class="fa-solid fa-droplet"></i>

                                                    @(string.IsNullOrWhiteSpace(sample.SampleType)
                                                        ? "Not specified"
                                                        : sample.SampleType)

                                                </span>

                                            </td>


                                            <!-- BARCODE -->

                                            <td>

                                                @if (!sample.IsReceived)
                                                {
                                                    <form asp-controller="SampleReceive"
                                                          asp-action="EditBarcode"
                                                          method="post"
                                                          class="barcode-edit-form"
                                                          data-barcode-form="true">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="requestId"
                                                               value="@request.RequestId" />

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <input type="hidden"
                                                               name="oldBarcode"
                                                               value="@sample.Barcode" />

                                                        <input type="text"
                                                               name="newBarcode"
                                                               value="@sample.Barcode"
                                                               class="barcode-input"
                                                               autocomplete="off"
                                                               spellcheck="false"
                                                               aria-label="Barcode" />

                                                        <button type="submit"
                                                                class="barcode-save"
                                                                title="Save barcode">

                                                            <i class="fa-solid fa-floppy-disk"></i>

                                                        </button>

                                                    </form>

                                                    <div class="barcode-validation">
                                                    </div>
                                                }
                                                else
                                                {
                                                    <strong class="barcode-received">
                                                        @sample.Barcode
                                                    </strong>
                                                }

                                            </td>


                                            <!-- STATUS -->

                                            <td>

                                                @if (sample.IsReceived)
                                                {
                                                    <span class="status-received">

                                                        <i class="fa-solid fa-check"></i>

                                                        Received

                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="status-awaiting">

                                                        <i class="fa-solid fa-clock"></i>

                                                        Awaiting

                                                    </span>
                                                }

                                            </td>


                                            <!-- RECEIVED BY -->

                                            <td>

                                                @if (sample.IsReceived &&
                                                     !string.IsNullOrWhiteSpace(sample.ReceivedByTechnician))
                                                {
                                                    <span>
                                                        @sample.ReceivedByTechnician
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="muted-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>


                                            <!-- DATE RECEIVED -->

                                            <td>

                                                @if (sample.IsReceived &&
                                                     sample.DateReceived.HasValue)
                                                {
                                                    <span>
                                                        @sample.DateReceived.Value.ToString("dd MMM yyyy HH:mm")
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="muted-cell">
                                                        —
                                                    </span>
                                                }

                                            </td>


                                            <!-- ACTION -->

                                            <td>

                                                @if (!sample.IsReceived)
                                                {
                                                    <form asp-controller="SampleReceive"
                                                          asp-action="ReceiveSample"
                                                          method="post"
                                                          class="receive-form">

                                                        @Html.AntiForgeryToken()

                                                        <input type="hidden"
                                                               name="sampleId"
                                                               value="@sample.SampleId" />

                                                        <input type="hidden"
                                                               name="requestId"
                                                               value="@request.RequestId" />

                                                        <input type="hidden"
                                                               name="barcode"
                                                               value="@sample.Barcode" />

                                                        <input type="hidden"
                                                               name="notes"
                                                               value="" />

                                                        <button type="button"
                                                                class="receive-button"
                                                                data-sample-type="@sample.SampleType"
                                                                data-barcode="@sample.Barcode"
                                                                data-test-type="@testName"
                                                                onclick="openReceiveModal(this)">

                                                            <i class="fa-solid fa-vial-circle-check"></i>

                                                            Receive

                                                        </button>

                                                    </form>
                                                }
                                                else
                                                {
                                                    <span class="complete-text">
                                                        <i class="fa-solid fa-circle-check"></i>
                                                        Complete
                                                    </span>
                                                }

                                            </td>

                                        </tr>
                                    }
                                }

                            </tbody>

                        </table>

                    </div>

                </div>


                <!-- =================================================
                     REQUEST FOOTER
                     ================================================= -->

                <div class="request-footer">

                    <div>

                        <strong>
                            Request Status
                        </strong>

                        <div>
                            @request.Status
                        </div>

                    </div>


                    <div>

                        <strong>
                            Samples
                        </strong>

                        <div>
                            @receivedCount / @sampleCount received
                        </div>

                    </div>

                </div>

            </div>
        }
    }

</div>


<!-- =============================================================
     RECEIVE MODAL
     ============================================================= -->

<div id="receiveModal"
     class="modal-overlay">

    <div class="receive-modal">

        <div class="modal-header">

            <h3>
                <i class="fa-solid fa-vial-circle-check"></i>
                Confirm Sample Receipt
            </h3>

            <button type="button"
                    class="modal-close"
                    aria-label="Close"
                    onclick="closeReceiveModal()">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>


        <div class="modal-body">

            <div class="modal-info">

                <div class="modal-info-row">

                    <span>
                        Test Type
                    </span>

                    <span id="modalTestType">
                        —
                    </span>

                </div>


                <div class="modal-info-row">

                    <span>
                        Sample Type
                    </span>

                    <span id="modalSampleType">
                        —
                    </span>

                </div>


                <div class="modal-info-row">

                    <span>
                        Barcode
                    </span>

                    <span id="modalBarcode">
                        —
                    </span>

                </div>

            </div>


            <label class="notes-label"
                   for="modalNotes">

                Notes
                <span>
                    (optional)
                </span>

            </label>

            <textarea id="modalNotes"
                      class="notes-input"
                      placeholder="Add any notes about this sample..."></textarea>

        </div>


        <div class="modal-footer">

            <button type="button"
                    class="cancel-button"
                    onclick="closeReceiveModal()">

                Cancel

            </button>

            <button type="button"
                    class="confirm-button"
                    onclick="confirmReceiveSample()">

                <i class="fa-solid fa-check"></i>
                Confirm Receipt

            </button>

        </div>

    </div>

</div>


@section Scripts {

<script>

document.addEventListener("DOMContentLoaded", function () {

    /* =========================================================
       SEARCH
       ========================================================= */

    const searchInput = document.getElementById("sampleSearch");

    if (searchInput) {

        searchInput.addEventListener("input", function () {

            const search =
                this.value.toLowerCase().trim();

            document
                .querySelectorAll(".request-card")
                .forEach(function (card) {

                    const text =
                        card.getAttribute("data-search")?.toLowerCase() || "";

                    card.style.display =
                        text.includes(search) ? "" : "none";

                });

        });

    }


    /* =========================================================
       BARCODE EDIT VALIDATION
       ========================================================= */

    document
        .querySelectorAll('[data-barcode-form="true"]')
        .forEach(function (form) {

            form.addEventListener("submit", function (event) {

                const input =
                    form.querySelector('input[name="newBarcode"]');

                if (!input) {
                    return;
                }

                const value =
                    input.value.trim();

                const oldBarcode =
                    form.querySelector('input[name="oldBarcode"]')?.value.trim() || "";

                if (!value) {

                    event.preventDefault();

                    input.classList.add("invalid");

                    alert("Please enter a barcode.");

                    return;
                }

                /*
                 * Prevent accidental submission of the exact same value.
                 */

                if (value.toUpperCase() === oldBarcode.toUpperCase()) {

                    event.preventDefault();

                    alert("The barcode has not changed.");

                    return;
                }

                /*
                 * Basic barcode validation.
                 *
                 * This prevents spaces and obviously malformed
                 * barcode values from being submitted.
                 */

                if (/\s/.test(value)) {

                    event.preventDefault();

                    input.classList.add("invalid");

                    alert("The barcode cannot contain spaces.");

                    return;
                }

                input.classList.remove("invalid");

            });

        });


    /* =========================================================
       RECEIVE MODAL
       ========================================================= */

    let selectedReceiveForm = null;


    window.openReceiveModal = function (button) {

        selectedReceiveForm =
            button.closest(".receive-form");

        if (!selectedReceiveForm) {
            return;
        }


        const sampleType =
            button.getAttribute("data-sample-type")
            || "Not specified";


        const barcode =
            button.getAttribute("data-barcode")
            || "Not available";


        const testType =
            button.getAttribute("data-test-type")
            || "Test";


        const modalSampleType =
            document.getElementById("modalSampleType");

        const modalBarcode =
            document.getElementById("modalBarcode");

        const modalTestType =
            document.getElementById("modalTestType");

        const modalNotes =
            document.getElementById("modalNotes");


        if (modalSampleType) {
            modalSampleType.textContent = sampleType;
        }


        if (modalBarcode) {
            modalBarcode.textContent = barcode;
        }


        if (modalTestType) {
            modalTestType.textContent = testType;
        }


        if (modalNotes) {
            modalNotes.value = "";
        }


        const modal =
            document.getElementById("receiveModal");


        if (modal) {
            modal.classList.add("show");
        }

    };


    /* =========================================================
       CLOSE MODAL
       ========================================================= */

    window.closeReceiveModal = function () {

        const modal =
            document.getElementById("receiveModal");

        if (modal) {
            modal.classList.remove("show");
        }

        selectedReceiveForm = null;

    };


    /* =========================================================
       CONFIRM RECEIPT
       ========================================================= */

    window.confirmReceiveSample = function () {

        if (!selectedReceiveForm) {
            return;
        }


        const notes =
            document.getElementById("modalNotes")?.value || "";


        const notesInput =
            selectedReceiveForm.querySelector(
                'input[name="notes"]'
            );


        if (notesInput) {
            notesInput.value = notes;
        }


        selectedReceiveForm.submit();

        closeReceiveModal();

    };


    /* =========================================================
       CLICK OUTSIDE MODAL
       ========================================================= */

    document.addEventListener("click", function (event) {

        const modal =
            document.getElementById("receiveModal");

        if (!modal) {
            return;
        }


        if (event.target === modal) {
            closeReceiveModal();
        }

    });


    /* =========================================================
       ESCAPE
       ========================================================= */

    document.addEventListener("keydown", function (event) {

        if (event.key === "Escape") {
            closeReceiveModal();
        }

    });

});

</script>

}