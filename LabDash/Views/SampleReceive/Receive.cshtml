@model LabDash.Models.SampleReceive

@{
    ViewData["Title"] = "Receive Patient Sample";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    .rps-body-bg {
        background: #eef7f8;
        font-family: "Segoe UI", sans-serif;
    }

    .rps-container {
        max-width: 1050px;
        margin: 35px auto;
        padding: 0 20px;
    }

    .rps-card {
        background: #fff;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.10);
        border: none;
    }

    .rps-header {
        background: linear-gradient(135deg, #00897B 0%, #00695C 100%);
        color: white;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .rps-header-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .rps-header-icon {
        width: 75px;
        height: 75px;
        border-radius: 50%;
        border: 3px solid rgba(255,255,255,.35);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 34px;
        background: rgba(255,255,255,.08);
        flex-shrink: 0;
    }

    .rps-header h2 {
        margin: 0;
        font-size: 36px;
        font-weight: 700;
    }

    .rps-header p {
        margin: 6px 0 0;
        font-size: 17px;
        opacity: .95;
    }

    .rps-body {
        padding: 40px;
    }

    .rps-form-row {
        display: grid;
        grid-template-columns: 250px 1fr;
        align-items: center;
        gap: 30px;
        padding: 18px 0;
    }

    .rps-notes-row {
        align-items: start;
    }

    .rps-form-label {
        font-size: 17px;
        font-weight: 600;
        color: #2f3e46;
        margin: 0;
    }

        .rps-form-label i {
            color: #009688;
            width: 25px;
            margin-right: 8px;
        }

    .rps-divider {
        margin: 0;
        border: none;
        border-top: 1px solid #ececec;
    }

    .rps-form-control,
    .rps-form-select {
        height: 50px;
        border-radius: 10px;
        border: 1px solid #d9dee3;
        font-size: 15px;
        transition: .25s;
        width: 100%;
        padding: 0 14px;
    }

        .rps-form-control:focus,
        .rps-form-select:focus {
            border-color: #009688;
            box-shadow: 0 0 0 .18rem rgba(0,150,136,.15);
            outline: none;
        }

    textarea.rps-form-control {
        height: 150px;
        resize: vertical;
        padding: 12px 14px;
    }

    .rps-readonly-display {
        display: flex;
        align-items: center;
        gap: 12px;
        height: 50px;
        padding: 0 16px;
        border-radius: 10px;
        background: #f2f8f8;
        border: 1px solid #dce8e7;
        color: #00695C;
        font-weight: 600;
        transition: border-color .2s, color .2s;
    }

    .rps-readonly-avatar {
        width: 30px;
        height: 30px;
        border-radius: 50%;
        background: #009688;
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12.5px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .rps-required {
        color: #dc3545;
    }

    .rps-footer-buttons {
        margin-top: 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

    .rps-btn-clear {
        border: 1px solid #ced4da;
        background: white;
        color: #555;
        padding: 12px 28px;
        border-radius: 10px;
        font-weight: 600;
        transition: .25s;
    }

        .rps-btn-clear:hover {
            background: #f4f4f4;
        }

    .rps-btn-receive {
        background: #009688;
        color: white;
        border: none;
        padding: 13px 35px;
        border-radius: 10px;
        font-size: 16px;
        font-weight: 600;
        transition: .3s;
    }

        .rps-btn-receive:hover:not(:disabled) {
            background: #00796B;
            color: white;
            transform: translateY(-2px);
        }

        .rps-btn-receive:disabled {
            background: #b0bec5;
            cursor: not-allowed;
            transform: none;
        }

    .rps-validation-summary ul {
        margin-bottom: 20px;
    }

    .rps-text-danger {
        font-size: 14px;
        color: #dc3545;
    }

    @@media(max-width:900px) {

        .rps-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .rps-form-row {
            grid-template-columns: 1fr;
            gap: 12px;
        }

        .rps-footer-buttons {
            flex-direction: column;
            gap: 15px;
        }

            .rps-footer-buttons button {
                width: 100%;
            }
    }

</style>

<div class="rps-body-bg">

    <div class="rps-container">

        <div class="rps-card">

            <div class="rps-header">

                <div class="rps-header-left">

                    <div class="rps-header-icon">
                        <i class="fas fa-vials"></i>
                    </div>

                    <div>

                        <h2>@* Receive *@ Patient Sample</h2>

                        <p>
                            Verify the request and record the received laboratory sample.
                        </p>

                    </div>

                </div>

            </div>

            <div class="rps-body">

                <form asp-action="Receive" method="post" id="receiveSampleForm">

                    <div asp-validation-summary="ModelOnly" class="rps-validation-summary rps-text-danger"></div>

                    <!-- Test Request -->

                    <div class="rps-form-row">

                        <label asp-for="RequestId" class="rps-form-label">
                            <i class="fas fa-clipboard-list"></i>
                            Test Request
                            <span class="rps-required">*</span>
                        </label>

                        <div>

                            <select asp-for="RequestId"
                                    id="requestIdSelect"
                                    asp-items="ViewBag.RequestList"
                                    class="rps-form-select">

                                <option value="">-- Select Test Request --</option>

                            </select>

                            <span asp-validation-for="RequestId"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Technician (read-only, server-assigned) -->

                    <div class="rps-form-row">

                        <label class="rps-form-label">
                            <i class="fas fa-user"></i>
                            Technician
                        </label>

                        <div>

                            <div class="rps-readonly-display">
                                <span class="rps-readonly-avatar">
                                    @{
                                        var currentName = string.IsNullOrWhiteSpace(User.Identity?.Name) ? "Unknown" : User.Identity!.Name!;
                                        var displayInitials = string.Join("", currentName
                                                                    .Split(' ', StringSplitOptions.RemoveEmptyEntries)
                                                                    .Take(2)
                                                                    .Select(n => n[0])).ToUpper();
                                        if (string.IsNullOrEmpty(displayInitials))
                                        {
                                            displayInitials = "?";
                                        }
                                    }
                                    @displayInitials
                                </span>
                                @currentName
                            </div>

                            <small class="text-muted">
                                Automatically recorded as the logged-in technician.
                            </small>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Barcode -->

                    <div class="rps-form-row">

                        <label asp-for="SampleBarcode" class="rps-form-label">
                            <i class="fas fa-barcode"></i>
                            Sample Barcode
                            <span class="rps-required">*</span>
                        </label>

                        <div>

                            <input asp-for="SampleBarcode"
                                   id="sampleBarcodeInput"
                                   class="rps-form-control"
                                   placeholder="Scan or enter barcode"
                                   autocomplete="off"
                                   autocorrect="off"
                                   autocapitalize="off"
                                   spellcheck="false"
                                   data-lpignore="true"
                                   data-form-type="other" />

                            <span asp-validation-for="SampleBarcode"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Sample Type (resolved from barcode, read-only) -->

                    <div class="rps-form-row">

                        <label class="rps-form-label">
                            <i class="fas fa-flask"></i>
                            Sample Type
                        </label>

                        <div>

                            <div class="rps-readonly-display" id="sampleTypeDisplay">
                                <i class="fas fa-circle-question" style="color:#9aa;"></i>
                                <span id="sampleTypeText">Select a request and enter a barcode</span>
                            </div>

                            <input type="hidden" asp-for="SampleType" id="sampleTypeHidden" />

                            <span asp-validation-for="SampleType"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <hr class="rps-divider" />

                    <!-- Notes -->

                    <div class="rps-form-row rps-notes-row">

                        <label asp-for="Notes" class="rps-form-label">
                            <i class="fas fa-note-sticky"></i>
                            Notes
                        </label>

                        <div>

                            <textarea asp-for="Notes"
                                      class="rps-form-control"
                                      placeholder="Optional notes..."></textarea>

                            <span asp-validation-for="Notes"
                                  class="rps-text-danger"></span>

                        </div>

                    </div>

                    <div class="rps-footer-buttons">

                        <button type="reset" class="btn rps-btn-clear" id="clearFormBtn">
                            <i class="fas fa-rotate-left"></i>
                            Clear Form
                        </button>

                        <button type="submit" class="btn rps-btn-receive" id="submitReceiveBtn" disabled>
                            <i class="fas fa-vials"></i>
                            Receive Sample
                        </button>

                    </div>

                </form>

            </div>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        (function() {
            const requestSelect = document.getElementById('requestIdSelect');
            const barcodeInput = document.getElementById('sampleBarcodeInput');
            const typeDisplay = document.getElementById('sampleTypeDisplay');
            const typeText = document.getElementById('sampleTypeText');
            const typeHidden = document.getElementById('sampleTypeHidden');
            const submitBtn = document.getElementById('submitReceiveBtn');

            let debounceTimer = null;

            function resetTypeDisplay(message, isError) {
                typeText.textContent = message;
                typeHidden.value = '';
                typeDisplay.style.borderColor = isError ? '#dc3545' : '#dce8e7';
                typeDisplay.style.color = isError ? '#dc3545' : '#00695C';
                if (submitBtn) submitBtn.disabled = true;
            }

            async function lookupSampleType() {
                const requestId = requestSelect ? requestSelect.value : '';
                const barcode = barcodeInput.value.trim();

                if (!requestId) {
                    resetTypeDisplay('Select a test request first', false);
                    return;
                }

                if (!barcode) {
                    resetTypeDisplay('Enter a barcode', false);
                    return;
                }

                typeText.textContent = 'Looking up...';

                try {
                    const res = await fetch(
                        `/SampleReceive/GetSampleType?requestId=${encodeURIComponent(requestId)}&barcode=${encodeURIComponent(barcode)}`
                    );
                    const data = await res.json();

                    if (data.found) {
                        typeText.textContent = data.sampleType;
                        typeHidden.value = data.sampleType;
                        typeDisplay.style.borderColor = '#dce8e7';
                        typeDisplay.style.color = '#00695C';
                        if (submitBtn) submitBtn.disabled = false;
                    } else {
                        resetTypeDisplay(data.message || 'Barcode not recognized for this request', true);
                    }
                } catch (err) {
                    resetTypeDisplay('Could not verify barcode — check your connection', true);
                }
            }

            if (requestSelect) {
                requestSelect.addEventListener('change', function() {
                    // Changing the request invalidates any barcode already typed
                    lookupSampleType();
                });
            }

            barcodeInput.addEventListener('input', function() {
                clearTimeout(debounceTimer);
                debounceTimer = setTimeout(lookupSampleType, 400);
            });

            // Also resolve immediately on Enter/Tab, since barcode scanners
            // typically send the scanned value followed by an Enter keystroke.
            barcodeInput.addEventListener('keydown', function(e) {
                if (e.key === 'Enter') {
                    e.preventDefault();
                    clearTimeout(debounceTimer);
                    lookupSampleType();
                }
            });

            const clearBtn = document.getElementById('clearFormBtn');
            if (clearBtn) {
                clearBtn.addEventListener('click', function() {
                    // native reset fires first; wait a tick then reset the derived display
                    setTimeout(function() {
                        resetTypeDisplay('Select a test request and enter a barcode', false);
                    }, 0);
                });
            }

            // Never trust a browser-restored or pre-filled barcode value.
            // pageshow also covers bfcache restores (back/forward navigation),
            // which DOMContentLoaded does not.
            window.addEventListener('pageshow', function() {
                barcodeInput.value = '';
                resetTypeDisplay('Select a test request and enter a barcode', false);
            });

            // Start disabled until a valid barcode/type is confirmed
            if (submitBtn) submitBtn.disabled = true;
        })();
    </script>
}