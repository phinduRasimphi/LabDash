@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Test History";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var totalTests = Model.Count();

    var completed = Model.Count(x => x.Status == "Completed");

    var inProgress = Model.Count(x => x.Status == "In Progress");

    var submitted = Model.Count(x => x.Status == "Submitted");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    body {
        background: #eef7f8;
        font-family: 'Segoe UI',sans-serif;
    }

    .page-container {
        max-width: 1450px;
        margin: 35px auto;
    }

    .page-header {
        background: linear-gradient(135deg,#009688,#00796B);
        color: white;
        padding: 30px 35px;
        border-radius: 18px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,.10);
    }

        .page-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
        }

        .page-header p {
            margin-top: 8px;
            opacity: .92;
        }

    .header-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        background: rgba(255,255,255,.15);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 34px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 8px 22px rgba(0,0,0,.08);
        transition: .3s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

        .stat-card h6 {
            color: #666;
            margin-bottom: 8px;
        }

        .stat-card h3 {
            margin: 0;
            color: #009688;
            font-size: 32px;
            font-weight: bold;
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: rgba(0,150,136,.12);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #009688;
        font-size: 24px;
    }

    .table-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .table-toolbar {
        padding: 22px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #ececec;
    }

        .table-toolbar h4 {
            margin: 0;
            color: #009688;
            font-weight: 700;
        }

    .search-box {
        position: relative;
        width: 350px;
    }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 15px;
            color: gray;
        }

        .search-box input {
            border-radius: 30px;
            height: 46px;
            padding-left: 42px;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: #00897B;
            color: white;
        }

        .table th {
            text-align: center;
            padding: 16px;
            border: none;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
            padding: 18px;
        }

        .table tbody tr:hover {
            background: #f5fbfb;
        }

    .badge-status {
        padding: 8px 16px;
        border-radius: 30px;
        color: white;
        font-size: 13px;
        font-weight: 600;
    }

    .status-completed {
        background: #009688;
    }

    .status-progress {
        background: #ff9800;
    }

    .status-submitted {
        background: #6c757d;
    }

    .empty-state {
        padding: 70px;
        text-align: center;
    }

        .empty-state i {
            font-size: 70px;
            color: #009688;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            color: #444;
        }

        .empty-state p {
            color: gray;
        }

    @@media(max-width:992px) {

        .stats {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .table-toolbar {
            flex-direction: column;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }
    }

</style>

<div class="page-container">

    <div class="page-header">

        <div>

            <h2>

                <i class="fa-solid fa-clock-rotate-left"></i>

                Test History

            </h2>

            <p>

                Review all laboratory tests that have been assigned to you.

            </p>

        </div>

        <div class="header-icon">

            <i class="fa-solid fa-folder-open"></i>

        </div>

    </div>

    <div class="stats">

        <div class="stat-card">

            <div>

                <h6>Total Tests</h6>

                <h3>@totalTests</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-vials"></i>

            </div>

        </div>

        <div class="stat-card">

            <div>

                <h6>Completed</h6>

                <h3>@completed</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

        </div>

        <div class="stat-card">

            <div>

                <h6>In Progress</h6>

                <h3>@inProgress</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-spinner"></i>

            </div>

        </div>

        <div class="stat-card">

            <div>

                <h6>Submitted</h6>

                <h3>@submitted</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-file-circle-plus"></i>

            </div>

        </div>

    </div>

    <div class="table-card">

        <div class="table-toolbar">

            <h4>

                <i class="fa-solid fa-list-check"></i>

                Laboratory Test History

            </h4>

            <div class="search-box">

                <i class="fa-solid fa-search"></i>

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search history..." />

            </div>

        </div>
        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="fa-solid fa-folder-open"></i>

                <h3>No Test History Available</h3>

                <p>
                    You have not been assigned any laboratory tests yet.
                </p>

            </div>
        }
        else
        {
            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Request</th>

                        <th>Test Type</th>

                        <th>Category</th>

                        <th>Started</th>

                        <th>Completed</th>

                        <th>Turnaround</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        TimeSpan? turnaround = null;

                        if (item.StartDateTime.HasValue &&
                            item.CompletionDateTime.HasValue)
                        {
                            turnaround =
                                item.CompletionDateTime.Value -
                                item.StartDateTime.Value;
                        }

                        <tr>

                            <td>

                                <strong>TR-@item.RequestId</strong>

                            </td>

                            <td>

                                @item.TestType?.Name

                            </td>

                            <td>

                                @item.TestType?.Category

                            </td>

                            <td>

                                @(item.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "-")

                            </td>

                            <td>

                                @(item.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "-")

                            </td>

                            <td>

                                @if (turnaround != null)
                                {
                                    <span class="text-success fw-semibold">

                                        <i class="fa-solid fa-clock"></i>

                                        @turnaround.Value.Days d
                                        @turnaround.Value.Hours h
                                        @turnaround.Value.Minutes m

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        -

                                    </span>
                                }

                            </td>

                            <td>

                                @if (item.Status == "Completed")
                                {
                                    <span class="badge-status status-completed">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Completed

                                    </span>
                                }
                                else if (item.Status == "In Progress")
                                {
                                    <span class="badge-status status-progress">

                                        <i class="fa-solid fa-spinner"></i>

                                        In Progress

                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status status-submitted">

                                        <i class="fa-solid fa-file-circle-plus"></i>

                                        Submitted

                                    </span>
                                }

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }

    </div>

</div>

@section Scripts
{
    <script>

        document.getElementById("searchInput")
            .addEventListener("keyup", function () {

                var value = this.value.toLowerCase();

                document.querySelectorAll("tbody tr").forEach(function (row) {

                    row.style.display =
                        row.innerText.toLowerCase().includes(value)
                        ? ""
                        : "none";

                });

            });

    </script>
}