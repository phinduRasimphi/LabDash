@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Laboratory Test History";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid py-4">

    <!-- PAGE HEADER -->

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold text-teal">

                <i class="fa-solid fa-clock-rotate-left me-2"></i>

                Laboratory Test History

            </h2>

            <p class="text-muted mb-0">

                View every laboratory test that has been assigned to and processed by you.

            </p>

        </div>

        <div>

            <a asp-action="Completed"
               class="btn btn-outline-primary rounded-pill">

                <i class="fa-solid fa-arrow-left me-2"></i>

                Completed Tests

            </a>

        </div>

    </div>


    <!-- DASHBOARD CARDS -->

    <div class="row g-4 mb-4">

        <div class="col-lg-3">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Total Tests

                            </small>

                            <h2 class="fw-bold mt-2">

                                @ViewBag.TotalTests

                            </h2>

                        </div>

                        <i class="fa-solid fa-vials fa-3x text-primary"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-3">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Completed

                            </small>

                            <h2 class="fw-bold mt-2 text-success">

                                @ViewBag.Completed

                            </h2>

                        </div>

                        <i class="fa-solid fa-circle-check fa-3x text-success"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-3">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                Verified

                            </small>

                            <h2 class="fw-bold mt-2 text-info">

                                @ViewBag.Verified

                            </h2>

                        </div>

                        <i class="fa-solid fa-shield-check fa-3x text-info"></i>

                    </div>

                </div>

            </div>

        </div>


        <div class="col-lg-3">

            <div class="card border-0 shadow rounded-4">

                <div class="card-body">

                    <div class="d-flex justify-content-between">

                        <div>

                            <small class="text-muted">

                                In Progress

                            </small>

                            <h2 class="fw-bold mt-2 text-warning">

                                @ViewBag.InProgress

                            </h2>

                        </div>

                        <i class="fa-solid fa-flask fa-3x text-warning"></i>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- SEARCH -->

    <div class="card shadow border-0 rounded-4 mb-4">

        <div class="card-body">

            <form asp-action="TestHistory"
                  method="get">

                <div class="row">

                    <div class="col-md-10">

                        <input type="text"
                               class="form-control form-control-lg"
                               name="search"
                               value="@ViewBag.Search"
                               placeholder="Search patient name, surname, test type or status..." />

                    </div>

                    <div class="col-md-2">

                        <button class="btn btn-teal btn-lg w-100">

                            <i class="fa-solid fa-search me-2"></i>

                            Search

                        </button>

                    </div>

                </div>

            </form>

        </div>

    </div>


    <!-- HISTORY TABLE -->

    <div class="card border-0 shadow rounded-4">

        <div class="card-header bg-teal text-white">

            <div class="d-flex justify-content-between align-items-center">

                <h5 class="mb-0">

                    <i class="fa-solid fa-clipboard-list me-2"></i>

                    Technician Audit Trail

                </h5>

                <span class="badge bg-light text-dark">

                    @Model.Count() Records

                </span>

            </div>

        </div>

        <div class="table-responsive">

            <table class="table table-hover align-middle mb-0">

                <thead class="table-light">

                    <tr>

                        <th>Patient</th>

                        <th>Laboratory Test</th>

                        <th>Started</th>

                        <th>Completed</th>

                        <th>Status</th>

                        <th width="220">Actions</th>

                    </tr>

                </thead>

                <tbody id="historyTable">
                    @foreach (var item in Model)
                    {
                        <tr>

                            <!-- PATIENT -->

                            <td>

                                <div class="d-flex align-items-center">

                                    <div class="rounded-circle bg-teal text-white
                                        d-flex justify-content-center align-items-center me-3"
                                         style="width:45px;height:45px;">

                                        <i class="fa-solid fa-user"></i>

                                    </div>

                                    <div>

                                        <strong>

                                            @item.TestRequest.Patient.Name
                                            @item.TestRequest.Patient.Surname

                                        </strong>

                                        <br />

                                        <small class="text-muted">

                                            @item.TestRequest.Patient.IDNumber

                                        </small>

                                    </div>

                                </div>

                            </td>

                            <!-- LAB TEST -->

                            <td>

                                <strong>

                                    @item.TestType.Name

                                </strong>

                                <br />

                                <small class="text-muted">

                                    @item.TestType.Category

                                </small>

                            </td>

                            <!-- STARTED -->

                            <td>

                                @if (item.StartDateTime.HasValue)
                                {
                                    @item.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </td>

                            <!-- COMPLETED -->

                            <td>

                                @if (item.CompletionDateTime.HasValue)
                                {
                                    @item.CompletionDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                }
                                else
                                {
                                    <span class="text-muted">-</span>
                                }

                            </td>

                            <!-- STATUS -->

                            <td>

                                @switch (item.Status)
                                {
                                    case "Submitted":
                                        <span class="badge bg-secondary">
                                            Submitted
                                        </span>
                                        break;

                                    case "In Progress":
                                        <span class="badge bg-warning text-dark">
                                            In Progress
                                        </span>
                                        break;

                                    case "Completed":
                                        <span class="badge bg-primary">
                                            Completed
                                        </span>
                                        break;

                                    case "Verified":
                                        <span class="badge bg-success">
                                            Verified
                                        </span>
                                        break;

                                    case "To Be Reviewed":
                                        <span class="badge bg-danger">
                                            To Be Reviewed
                                        </span>
                                        break;

                                    default:
                                        <span class="badge bg-dark">
                                            @item.Status
                                        </span>
                                        break;
                                }

                            </td>

                            <!-- ACTIONS -->

                            <td>

                                <div class="d-flex gap-2 flex-wrap">

                                    <a asp-action="ProcessTest"
                                       asp-route-id="@item.TestRequestItemId"
                                       class="btn btn-outline-primary btn-sm rounded-pill">

                                        <i class="fa-solid fa-eye me-1"></i>

                                        View

                                    </a>

                                    <a asp-controller="CaptureResults"
                                       asp-action="Details"
                                       asp-route-id="@item.TestRequestItemId"
                                       class="btn btn-success btn-sm rounded-pill">

                                        <i class="fa-solid fa-file-medical me-1"></i>

                                        Results

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                    @if (!Model.Any())
                    {
                        <tr>

                            <td colspan="6">

                                <div class="text-center py-5">

                                    <i class="fa-solid fa-folder-open
                                    fa-4x text-secondary mb-3"></i>

                                    <h4>

                                        No Test History Found

                                    </h4>

                                    <p class="text-muted">

                                        There are no laboratory tests in your history that match
                                        the selected search criteria.

                                    </p>

                                    <a asp-action="Index"
                                       class="btn btn-teal rounded-pill mt-2">

                                        <i class="fa-solid fa-arrow-left me-2"></i>

                                        Back to Available Tests

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>
    </div>

<style>

    body{
        background:#f4f8fb;
    }

    .text-teal{
        color:#0f766e;
    }

    .bg-teal{
        background:#0f766e !important;
    }

    .btn-teal{
        background:#0f766e;
        color:white;
        border:none;
    }

    .btn-teal:hover{
        background:#115e59;
        color:white;
    }

    .card{
        border-radius:18px;
        transition:.25s;
    }

    .card:hover{
        transform:translateY(-4px);
        box-shadow:0 12px 28px rgba(0,0,0,.12)!important;
    }

    .rounded-4{
        border-radius:18px!important;
    }

    .card-header{
        border-top-left-radius:18px!important;
        border-top-right-radius:18px!important;
    }

    .table thead th{

        font-weight:600;
        color:#495057;
        white-space:nowrap;

    }

    .table td,
    .table th{

        vertical-align:middle;

    }

    .table tbody tr:hover{

        background:#f8fbfc;

    }

    .badge{

        font-size:.80rem;
        padding:.55rem .85rem;

    }

    .btn{

        font-weight:600;

    }

    .form-control:focus{

        border-color:#0f766e;
        box-shadow:0 0 0 .2rem rgba(15,118,110,.15);

    }

    .table{

        margin-bottom:0;

    }

</style>

@section Scripts{

<script>

document.addEventListener("DOMContentLoaded", function () {

    const search = document.querySelector("input[name='search']");

    if(search){

        search.addEventListener("keyup", function(){

            let value = this.value.toLowerCase();

            let rows = document.querySelectorAll("#historyTable tr");

            rows.forEach(function(row){

                let text = row.innerText.toLowerCase();

                row.style.display =
                    text.includes(value) ? "" : "none";

            });

        });

    }

});

</script>

}