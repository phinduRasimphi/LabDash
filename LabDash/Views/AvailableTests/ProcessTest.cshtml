            color: #153b4d;
            font-size: 12px;
            font-weight: 800;
            line-height: 1.4;
            word-break: break-word;
        }


    /* =========================================================
           DIVIDER
           ========================================================= */

    .pt-divider {
        height: 1px;
        background: #e1eaed;
        margin: 19px 0 16px;
    }


    /* =========================================================
           SUBSECTION TITLE
           ========================================================= */

    .pt-subsection-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        color: #123b4c;
        font-family: 'Poppins', sans-serif;
        font-size: 11px;
        font-weight: 800;
    }

        .pt-subsection-title i {
            color: #087a70;
            font-size: 13px;
        }


    /* =========================================================
           CLINICAL INFORMATION
           ========================================================= */

    .pt-clinical-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 11px;
    }

    .pt-clinical-card {
        min-height: 105px;
        padding: 14px;
        border-radius: 13px;
        display: flex;
        align-items: flex-start;
        gap: 10px;
        border: 1px solid transparent;
        transition: .2s ease;
    }

        .pt-clinical-card:hover {
            transform: translateY(-2px);
        }

    .pt-clinical-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 14px;
    }

    .pt-clinical-card span {
        display: block;
        text-transform: uppercase;
        font-size: 7px;
        font-weight: 800;
        letter-spacing: .5px;
        margin-bottom: 5px;
    }

    .pt-clinical-card strong {
        display: block;
        font-size: 10px;
        line-height: 1.5;
        font-weight: 800;
        word-break: break-word;
    }


    /* =========================================================
           ALLERGIES - RED
           ========================================================= */

    .pt-clinical-card.allergy {
        background: #fff0f2;
        border-color: #f3cbd1;
    }

        .pt-clinical-card.allergy .pt-clinical-icon {
            background: #ffe0e4;
            color: #d52f49;
            border: 1px solid #f4c3ca;
        }

        .pt-clinical-card.allergy span {
            color: #b52b40;
        }

        .pt-clinical-card.allergy strong {
            color: #7d2635;
        }


    /* =========================================================
           MEDICAL CONDITIONS - YELLOW
           ========================================================= */

    .pt-clinical-card.condition {
        background: #fff7e2;
        border-color: #f0dfad;
    }

        .pt-clinical-card.condition .pt-clinical-icon {
            background: #ffedb9;
            color: #b77d00;
            border: 1px solid #f0d98e;
        }

        .pt-clinical-card.condition span {
            color: #a16f00;
        }

        .pt-clinical-card.condition strong {
            color: #765600;
        }


    /* =========================================================
           MEDICATION - LIGHT TEAL
           ========================================================= */

    .pt-clinical-card.medication {
        background: #e8f7f5;
        border-color: #c9e8e3;
    }

        .pt-clinical-card.medication .pt-clinical-icon {
            background: #d5efeb;
            color: #087a70;
            border: 1px solid #bfe2dc;
        }

        .pt-clinical-card.medication span {
            color: #087a70;
        }

        .pt-clinical-card.medication strong {
            color: #145f5a;
        }


    /* =========================================================
           DOCTOR NOTES
           ========================================================= */

    .pt-notes {
        background: #edf7fa;
        border: 1px solid #d3e8ee;
        border-left: 4px solid #087a70;
