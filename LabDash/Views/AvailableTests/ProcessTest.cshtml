        height: 58px;
        background: #e3f4f1;
        color: #087a70;
        border: 1px solid #cee9e5;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        flex-shrink: 0;
    }

    .pt-lab-test-label {
        color: #78919d;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .5px;
        text-transform: uppercase;
        margin-bottom: 3px;
    }

    .pt-lab-test-name {
        color: #123b4c;
        font-family: 'Poppins', sans-serif;
        font-size: 20px;
        font-weight: 800;
        margin-bottom: 6px;
    }

    .pt-category-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: #e4f4f2;
        color: #087a70;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }


    /* =========================================================
           TEST INFO BOXES
           ========================================================= */

    .pt-test-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 11px;
    }

    .pt-test-info-box {
        min-height: 70px;
        border-radius: 13px;
        padding: 12px;
        border: 1px solid #dfe9ec;
        background: #f7fafb;
        position: relative;
    }

        .pt-test-info-box.sample {
            background: #e9f7f5;
            border-color: #d0ebe7;
        }

        .pt-test-info-box.unit {
            background: #f0f8f6;
            border-color: #dceeea;
        }

        .pt-test-info-box.reference {
            background: #fff8e7;
            border-color: #f1e5c5;
        }

        .pt-test-info-box.time {
            background: #edf6fa;
            border-color: #dcebf1;
        }

        .pt-test-info-box.request {
            background: #f1f5f7;
            border-color: #e1e8eb;
        }

        .pt-test-info-box.item {
            background: #e8f4f8;
