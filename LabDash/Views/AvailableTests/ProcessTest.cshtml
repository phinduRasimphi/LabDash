@model LabDash.Models.TestRequestItem

@using LabDash.Models

@{
    ViewData["Title"] = "Process Laboratory Test";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var testItem = ViewBag.TestItem as TestRequestItem ?? Model;
    var testType = ViewBag.TestType as TestType;
    var patient = ViewBag.Patient as Patient;
    var request = ViewBag.TestRequest as TestRequest;

    bool isOverdue = ViewBag.IsOverdue != null &&
                     (bool)ViewBag.IsOverdue;

    int progressPercentage = ViewBag.ProgressPercentage != null
        ? Convert.ToInt32(ViewBag.ProgressPercentage)
        : 0;

    string dueDateTime = ViewBag.DueDateTime?.ToString()
        ?? "Not available";

    string timeRemaining = ViewBag.TimeRemaining?.ToString()
        ?? "Not available";

    var consumables = ViewBag.Consumables as IEnumerable<dynamic>
                      ?? Enumerable.Empty<dynamic>();

    string status = testItem?.Status ?? "Submitted";

    int statusIndex = status switch
    {
        "Verified" => 4,
        "Completed" => 3,
        "In Progress" => 2,
        "Samples Received" => 1,
        _ => 0
    };

    string patientName = patient != null
        ? $"{patient.Name} {patient.Surname}"
        : "Patient information unavailable";

    string referenceRange = testType != null
        ? $"{testType.ReferenceRangeLow} - {testType.ReferenceRangeHigh}"
        : "Not specified";

    string turnaroundTime = "Not specified";

    if (testType != null && testType.TurnaroundTimeMinutes > 0)
    {
        int hours = testType.TurnaroundTimeMinutes / 60;
        int minutes = testType.TurnaroundTimeMinutes % 60;

        if (hours > 0 && minutes > 0)
        {
            turnaroundTime = $"{hours} hr {minutes} min";
        }
        else if (hours > 0)
        {
            turnaroundTime = $"{hours} hr";
        }
        else
        {
            turnaroundTime = $"{minutes} min";
        }
    }
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet" />

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


<style>

    /* =========================================================
           PROCESS LABORATORY TEST
           COMPLETE PAGE
           ========================================================= */


    /* =========================================================
           GLOBAL
           ========================================================= */

    .pt-page {
        min-height: 100vh;
        padding: 28px 34px 55px;
        background: #eef6f7;
        color: #173b4d;
        font-family: 'Inter', sans-serif;
    }

        .pt-page *,
        .pt-page *::before,
        .pt-page *::after {
            box-sizing: border-box;
        }


    /* =========================================================
           HEADER
           ========================================================= */

    .pt-header {
        position: relative;
