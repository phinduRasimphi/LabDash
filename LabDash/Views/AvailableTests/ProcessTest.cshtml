        gap: 20px;
    }

    .pt-selected-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .pt-sample-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: #e2f4f1;
        color: #087a70;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        flex-shrink: 0;
        border: 1px solid #cce9e5;
    }

    .pt-section-kicker {
        display: block;
        color: #087a70;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .8px;
        text-transform: uppercase;
        margin-bottom: 4px;
    }

    .pt-selected-title h2 {
        margin: 0;
        color: #123b4c;
        font-family: 'Poppins', sans-serif;
        font-size: 23px;
        font-weight: 800;
    }

    .pt-selected-title p {
        margin: 4px 0 0;
        color: #78919d;
        font-size: 11px;
    }

    .pt-processing-badge {
        display: flex;
        align-items: center;
        gap: 8px;
        background: #e4f6f2;
        color: #087a70;
        padding: 10px 15px;
        border-radius: 30px;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
        border: 1px solid #cce9e4;
    }

        .pt-processing-badge span {
            width: 8px;
            height: 8px;
            background: #20c878;
            border-radius: 50%;
            box-shadow: 0 0 0 4px rgba(32, 200, 120, 0.10);
        }


    /* =========================================================
           MAIN GRID
           ========================================================= */

    .pt-main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 20px;
    }

    .pt-card {
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #dce8eb;
        box-shadow: 0 8px 24px rgba(20, 70, 82, 0.06);
    }


    /* =========================================================
           CARD HEADER
           ========================================================= */

    .pt-card-header {
        min-height: 55px;
        padding: 0 20px;
        background: linear-gradient( 135deg, #087a70, #099286 );
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 800;
    }

    .pt-card-header-title {
        display: flex;
        align-items: center;
        gap: 9px;
    }

        .pt-card-header-title i {
            font-size: 14px;
        }

    .pt-card-header > span {
        font-size: 9px;
        color: rgba(255, 255, 255, 0.82);
    }

    .pt-card-body {
        padding: 22px;
    }


    /* =========================================================
           INFORMATION GRID
           ========================================================= */

    .pt-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 28px;
    }

    .pt-info-item {
        padding: 13px 0;
        border-bottom: 1px solid #e4edef;
    }

        .pt-info-item span {
            display: block;
            color: #78919d;
            text-transform: uppercase;
            font-size: 8px;
            font-weight: 800;
            letter-spacing: .55px;
            margin-bottom: 6px;
        }

        .pt-info-item strong {
