    }

    .pt-notes-title {
        display: block;
        color: #087a70;
        text-transform: uppercase;
        font-size: 8px;
        font-weight: 800;
        letter-spacing: .5px;
        margin-bottom: 4px;
    }

    .pt-notes p {
        margin: 0;
        color: #31566d;
        font-size: 11px;
        line-height: 1.6;
    }

    .pt-empty {
