@model LabDash.Models.TestRequestItem

@using LabDash.Models

@{
    ViewData["Title"] = "Process Laboratory Test";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var testItem = ViewBag.TestItem as TestRequestItem ?? Model;
    var testType = ViewBag.TestType as TestType;
    var patient = ViewBag.Patient as Patient;
    var request = ViewBag.TestRequest as TestRequest;

    bool isOverdue = ViewBag.IsOverdue != null &&
                     (bool)ViewBag.IsOverdue;

    int progressPercentage = ViewBag.ProgressPercentage != null
        ? Convert.ToInt32(ViewBag.ProgressPercentage)
        : 0;

    // Friendly formatting for the due date and the time remaining.
    string dueDateTime = "Not available";

    if (ViewBag.DueDateTime is DateTime dueValue)
    {
        dueDateTime = dueValue.ToString("dd MMM yyyy HH:mm");
    }

    string timeRemaining = "Not available";

    if (ViewBag.TimeRemaining is TimeSpan remainingValue)
    {
        if (remainingValue.TotalSeconds <= 0)
        {
            timeRemaining = "Due now";
        }
        else if (remainingValue.TotalHours >= 1)
        {
            timeRemaining =
                $"{(int)remainingValue.TotalHours}h {remainingValue.Minutes}m";
        }
        else
        {
            timeRemaining =
                $"{remainingValue.Minutes}m {remainingValue.Seconds}s";
        }
    }

    var consumables = ViewBag.Consumables as IEnumerable<dynamic>
                      ?? Enumerable.Empty<dynamic>();

    string status = testItem?.Status ?? "Submitted";

    int statusIndex = status switch
    {
        "Verified" => 4,
        "Completed" => 3,
        "In Progress" => 2,
        "Samples Received" => 1,
        _ => 0
    };

    string patientName = patient != null
        ? $"{patient.Name} {patient.Surname}"
        : "Patient information unavailable";

    string referenceRange = testType != null
        ? $"{testType.ReferenceRangeLow} - {testType.ReferenceRangeHigh}"
        : "Not specified";

    string turnaroundTime = "Not specified";

    if (testType != null && testType.TurnaroundTimeMinutes > 0)
    {
        turnaroundTime = $"{testType.TurnaroundTimeMinutes} minutes";
    }

    var stepLabels = new[]
    {
        "Submitted",
        "Samples received",
        "In progress",
        "Completed",
        "Verified"
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet" />
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />


<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b7a70;
        --teal-deep: #0a5f58;
        --teal-light: #e1f3f0;
        --teal-soft: #f2f8f7;
        --teal-border: #dbe9e7;
        --text: #12302f;
        --muted: #6f8584;
        --page-bg: #eaf1f1;
        --red: #a32626;
        --red-bg: #fde8e8;
        --red-border: #f5c6c6;
        --gold: #8f5a00;
        --gold-bg: #fff3dc;
        --gold-border: #f3d9a0;
        --green: #17814a;
        --green-bg: #e4f6ec;
        --blue: #22719a;
        --blue-bg: #e4f2f9;
    }

    .pt-page {
        min-height: 100vh;
        width: 100%;
        padding: 28px 32px 48px;
        background: var(--page-bg);
        color: var(--text);
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }

        .pt-page *,
        .pt-page *::before,
        .pt-page *::after {
            box-sizing: border-box;
        }


    /* BANNER */

    .pt-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .pt-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .pt-banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .pt-banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
    }

    .pt-banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .pt-banner-stats {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .pt-banner-stat {
        text-align: center;
    }

        .pt-banner-stat strong {
            display: block;
            font-size: 22px;
            font-weight: 800;
            line-height: 1.15;
        }

        .pt-banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }

    .pt-banner-status {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }

    .pt-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #18c779;
        box-shadow: 0 0 0 4px rgba(24, 199, 121, .16);
        animation: ptPulse 1.6s infinite;
    }

    @@keyframes ptPulse {

        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .35;
        }
    }


    /* CARDS + PANELS */

    .pt-card,
    .pt-panel {
        min-width: 0;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
        overflow: hidden;
    }

    .pt-panel {
        margin-bottom: 24px;
    }

    .pt-card-header,
    .pt-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 32px;
        border-bottom: 1px solid var(--teal-border);
    }

    .pt-card-header-title,
    .pt-panel-header > div {
        display: flex;
        align-items: center;
        gap: 14px;
        font-size: 17px;
        font-weight: 800;
        color: var(--text);
    }

        .pt-card-header-title i,
        .pt-panel-header > div i {
            color: var(--teal);
            font-size: 18px;
        }

    .pt-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .pt-pill.success {
            background: var(--green-bg);
            color: var(--green);
        }

        .pt-pill.danger {
            background: var(--red-bg);
            color: var(--red);
        }

        .pt-pill.warning {
            background: var(--gold-bg);
            color: var(--gold);
        }

    .pt-card-body,
    .pt-panel-body {
        padding: 26px 32px 30px;
    }

    .pt-main-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
        margin-bottom: 24px;
        align-items: stretch;
    }


    /* SAMPLE BEING TESTED */

    .pt-selected-test {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 22px 32px;
        margin-bottom: 24px;
        background: #fff;
        border-left: 5px solid var(--teal);
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
    }

    .pt-selected-title {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .pt-sample-icon {
        width: 56px;
        height: 56px;
        flex: 0 0 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 8px 18px rgba(10, 95, 88, .25);
    }

    .pt-section-kicker {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .pt-selected-title h2 {
        margin: 0;
        color: var(--teal-deep);
        font-size: 20px;
        font-weight: 800;
    }

    .pt-selected-title p {
        margin: 4px 0 0;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
    }

    .pt-processing-badge {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 9px 16px;
        border-radius: 999px;
        background: var(--teal-light);
        border: 1px solid #bfe0da;
        color: var(--teal-deep);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .pt-processing-badge span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: var(--teal);
            box-shadow: 0 0 0 4px rgba(15, 148, 136, .14);
        }


    /* PATIENT DETAILS */

    .pt-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .pt-info-item {
        min-width: 0;
        padding: 14px 16px;
        background: #fff;
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

        .pt-info-item span,
        .pt-test-info-box span,
        .pt-time-card span,
        .pt-activity-grid span {
            display: block;
            margin-bottom: 7px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .pt-info-item strong {
            display: block;
            color: var(--text);
            font-size: 14px;
            font-weight: 700;
            line-height: 1.45;
            overflow-wrap: anywhere;
        }

    .pt-divider {
        height: 1px;
        background: var(--teal-border);
        margin: 26px 0 22px;
    }

    .pt-subsection-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
    }

        .pt-subsection-title i {
            color: var(--teal);
        }


    /* CLINICAL INFORMATION */

    .pt-clinical-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .pt-clinical-card {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        min-width: 0;
        padding: 16px;
        border-radius: 16px;
        border: 1px solid transparent;
    }

    .pt-clinical-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 15px;
        background: rgba(255, 255, 255, .7);
    }

    .pt-clinical-card span {
        display: block;
        margin-bottom: 5px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .pt-clinical-card strong {
        display: block;
        font-size: 13px;
        font-weight: 600;
        line-height: 1.55;
        overflow-wrap: anywhere;
    }

    .pt-clinical-card.allergy {
        background: var(--red-bg);
        border-color: var(--red-border);
        color: var(--red);
    }

    .pt-clinical-card.condition {
        background: var(--gold-bg);
        border-color: var(--gold-border);
        color: var(--gold);
    }

    .pt-clinical-card.medication {
        background: var(--teal-light);
        border-color: #c5e4df;
        color: var(--teal-dark);
    }


    /* DOCTOR NOTES */

    .pt-notes {
        display: flex;
        align-items: flex-start;
        gap: 14px;
        padding: 17px 19px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 16px;
    }

    .pt-notes-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 14px;
    }

    .pt-notes-content {
        flex: 1;
        min-width: 0;
    }

    .pt-notes-title {
        display: block;
        margin-bottom: 5px;
        color: var(--teal-dark);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .pt-notes p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    .pt-empty {
        padding: 16px 18px;
        background: var(--teal-soft);
        border: 1px dashed var(--teal-border);
        border-radius: 16px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 500;
    }

        .pt-empty i {
            color: var(--teal);
            margin-right: 8px;
        }


    /* TEST INFORMATION */

    .pt-lab-test {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px;
        margin-bottom: 18px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 18px;
    }

    .pt-lab-test-icon {
        width: 56px;
        height: 56px;
        flex: 0 0 56px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font-size: 22px;
        box-shadow: 0 8px 18px rgba(10, 95, 88, .25);
    }

    .pt-lab-test-label {
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .pt-lab-test-name {
        margin-bottom: 8px;
        color: var(--teal-deep);
        font-size: 18px;
        font-weight: 800;
        line-height: 1.35;
        overflow-wrap: anywhere;
    }

    .pt-category-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
    }

    .pt-test-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .pt-test-info-box {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        padding: 15px 16px;
        background: #fff;
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .pt-test-info-icon {
        width: 38px;
        height: 38px;
        flex: 0 0 38px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: var(--teal-light);
        color: var(--teal);
        font-size: 14px;
    }

    .pt-test-info-box > div:last-child {
        min-width: 0;
    }

    .pt-test-info-box span {
        margin-bottom: 5px;
    }

    .pt-test-info-box strong {
        display: block;
        color: var(--text);
        font-size: 14px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .pt-test-info-box.reference {
        background: var(--gold-bg);
        border-color: var(--gold-border);
    }

        .pt-test-info-box.reference .pt-test-info-icon {
            background: #fff;
            color: var(--gold);
        }

    .pt-test-info-box.time {
        background: var(--blue-bg);
        border-color: #bfdeee;
    }

        .pt-test-info-box.time .pt-test-info-icon {
            background: #fff;
            color: var(--blue);
        }


    /* TURNAROUND */

    .pt-turnaround-grid {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 14px;
    }

    .pt-time-card {
        padding: 16px 18px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

        .pt-time-card strong {
            display: block;
            color: var(--teal-deep);
            font-size: 16px;
            font-weight: 800;
        }

    .pt-progress-section {
        margin-top: 24px;
        padding-top: 22px;
        border-top: 1px solid var(--teal-border);
    }

    .pt-progress-heading {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 10px;
        color: var(--muted);
        font-size: 13px;
        font-weight: 600;
    }

        .pt-progress-heading strong {
            color: var(--teal-dark);
            font-size: 15px;
            font-weight: 800;
        }

    .pt-progress-track {
        height: 12px;
        background: #e3eeec;
        border-radius: 999px;
        overflow: hidden;
    }

    .pt-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #0b7a70, #20b2a3);
        border-radius: 999px;
        transition: width .4s ease;
    }

    .pt-progress-fill.late {
        background: linear-gradient(90deg, #b44d16, #d9534f);
    }

    .pt-progress-caption {
        margin-top: 9px;
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 500;
    }


    /* STEPPER */

    .pt-current-step-notice {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 16px 18px;
        margin-bottom: 28px;
        background: var(--teal-light);
        border: 1px solid #c5e4df;
        border-radius: 18px;
    }

    .pt-current-step-icon {
        width: 44px;
        height: 44px;
        flex: 0 0 44px;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #fff;
        color: var(--teal-dark);
    }

    .pt-current-step-notice strong {
        display: block;
        margin-bottom: 3px;
        color: var(--teal-deep);
        font-size: 14px;
        font-weight: 800;
    }

    .pt-current-step-notice span {
        display: block;
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 500;
    }

    .pt-stepper-scroll {
        overflow-x: auto;
        padding-bottom: 6px;
    }

    .pt-stepper {
        position: relative;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        min-width: 560px;
    }

        .pt-stepper::before {
            content: "";
            position: absolute;
            top: 19px;
            left: 10%;
            right: 10%;
            height: 3px;
            background: var(--teal-border);
            z-index: 0;
        }

    .pt-step {
        position: relative;
        z-index: 1;
        width: 20%;
        text-align: center;
    }

    .pt-step-circle {
        width: 40px;
        height: 40px;
        margin: 0 auto 10px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: #e6eeed;
        color: var(--muted);
        border: 4px solid #fff;
        font-size: 12px;
        font-weight: 800;
    }

    .pt-step.done .pt-step-circle {
        background: var(--teal-dark);
        color: #fff;
    }

    .pt-step.current .pt-step-circle {
        background: var(--teal);
        color: #fff;
        box-shadow: 0 0 0 5px var(--teal-light);
    }

    .pt-step-label {
        display: block;
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 700;
    }

    .pt-step.done .pt-step-label,
    .pt-step.current .pt-step-label {
        color: var(--text);
    }

    .pt-step-label small {
        display: block;
        margin-top: 4px;
        color: var(--teal-dark);
        font-size: 11px;
        font-weight: 800;
    }


    /* CONSUMABLES */

    .pt-table-wrapper {
        overflow-x: auto;
    }

    .pt-table {
        width: 100%;
        min-width: 560px;
        border-collapse: separate;
        border-spacing: 0;
    }

        .pt-table th {
            padding: 12px 18px;
            text-align: left;
            color: var(--muted);
            font-size: 11.5px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            border-bottom: 1px solid var(--teal-border);
            white-space: nowrap;
        }

        .pt-table td {
            padding: 18px;
            border-bottom: 1px solid #edf3f2;
            color: var(--text);
            font-size: 13.5px;
            font-weight: 500;
        }

        .pt-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .pt-table tbody tr:hover {
            background: var(--teal-soft);
        }

        .pt-table td strong {
            font-weight: 700;
        }

            .pt-table td strong i {
                color: var(--teal);
                margin-right: 9px;
            }

    .pt-stock {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

        .pt-stock.good {
            background: var(--green-bg);
            color: var(--green);
        }

        .pt-stock.warning {
            background: var(--gold-bg);
            color: var(--gold);
        }

        .pt-stock.danger {
            background: var(--red-bg);
            color: var(--red);
        }

    .pt-no-data {
        padding: 36px 16px;
        text-align: center;
        color: var(--muted);
        font-size: 13.5px;
        font-weight: 500;
    }

        .pt-no-data i {
            display: block;
            margin-bottom: 12px;
            color: #9ccdc6;
            font-size: 32px;
        }


    /* ACTIVITY */

    .pt-activity-grid {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 14px;
    }

        .pt-activity-grid > div {
            padding: 16px 18px;
            background: var(--teal-soft);
            border: 1px solid var(--teal-border);
            border-radius: 16px;
        }

        .pt-activity-grid strong {
            display: block;
            color: var(--text);
            font-size: 14px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

    .pt-status-text {
        display: flex !important;
        align-items: center;
        gap: 9px;
        color: var(--teal-dark) !important;
    }

        .pt-status-text > span {
            display: inline-block !important;
            width: 8px;
            height: 8px;
            margin: 0 !important;
            border-radius: 50%;
            background: #18c779;
            flex-shrink: 0;
        }


    /* ACTIONS */

    .pt-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 14px;
    }

    .pt-actions-right {
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .pt-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 13px 22px;
        border: 1px solid transparent;
        border-radius: 14px;
        font: inherit;
        font-size: 13.5px;
        font-weight: 700;
        text-decoration: none;
        cursor: pointer;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

        .pt-btn:focus-visible {
            outline: 2px solid var(--teal-deep);
            outline-offset: 3px;
        }

    .pt-btn-back {
        background: #fff;
        border-color: var(--teal-border);
        color: var(--teal-dark);
    }

        .pt-btn-back:hover {
            background: var(--teal-light);
            color: var(--teal-deep);
        }

    .pt-btn-results {
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        box-shadow: 0 6px 16px rgba(10, 95, 88, .28);
    }

        .pt-btn-results:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(10, 95, 88, .34);
        }


    /* CONFIRMATION MODAL */

    .pt-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999999;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(7, 40, 38, .55);
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
    }

        .pt-modal.open {
            display: flex;
        }

        .pt-modal *,
        .pt-modal *::before,
        .pt-modal *::after {
            box-sizing: border-box;
        }

    .pt-modal-box {
        width: 100%;
        max-width: 450px;
        padding: 34px 32px 30px;
        text-align: center;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .28);
    }

    .pt-modal-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font-size: 25px;
        box-shadow: 0 8px 18px rgba(10, 95, 88, .28);
    }

    .pt-modal-box h3 {
        margin: 0 0 10px;
        color: var(--text);
        font-size: 20px;
        font-weight: 800;
    }

    .pt-modal-box p {
        margin: 0 0 8px;
        color: var(--muted);
        font-size: 14px;
        font-weight: 500;
        line-height: 1.65;
    }

    .pt-modal-test {
        display: inline-block;
        margin: 6px 0 24px;
        padding: 8px 16px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 700;
    }

    .pt-modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .pt-modal-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 12px;
        font: inherit;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
    }

        .pt-modal-btn:focus-visible {
            outline: 2px solid var(--teal-deep);
            outline-offset: 3px;
        }

    .pt-modal-cancel {
        border: 1px solid var(--teal-border);
        background: #fff;
        color: var(--text);
    }

        .pt-modal-cancel:hover {
            background: var(--teal-soft);
        }

    .pt-modal-confirm {
        border: 0;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        box-shadow: 0 6px 16px rgba(10, 95, 88, .28);
    }

        .pt-modal-confirm:hover {
            box-shadow: 0 9px 20px rgba(10, 95, 88, .34);
        }

    @@media (max-width: 480px) {

        .pt-modal-actions {
            flex-direction: column-reverse;
        }

        .pt-modal-btn {
            width: 100%;
            justify-content: center;
        }
    }


    /* RESPONSIVE */

    @@media (max-width: 1150px) {

        .pt-main-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .pt-activity-grid {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 800px) {

        .pt-page {
            padding: 18px;
        }

        .pt-banner {
            padding: 20px;
        }

        .pt-banner-stats {
            gap: 20px;
        }

        .pt-card-header,
        .pt-panel-header,
        .pt-card-body,
        .pt-panel-body,
        .pt-selected-test {
            padding-left: 20px;
            padding-right: 20px;
        }

        .pt-info-grid,
        .pt-test-info-grid,
        .pt-clinical-grid,
        .pt-turnaround-grid {
            grid-template-columns: minmax(0, 1fr);
        }
    }

    @@media (max-width: 520px) {

        .pt-banner h1 {
            font-size: 20px;
        }

        .pt-activity-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .pt-actions,
        .pt-actions-right {
            flex-direction: column;
            align-items: stretch;
            width: 100%;
        }

        .pt-btn {
            width: 100%;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .pt-page *,
        .pt-page *::before {
            animation: none !important;
            transition: none !important;
        }
    }

</style>


<div class="pt-page">

    <!-- =====================================================
         BANNER
         ===================================================== -->

    <div class="pt-banner">

        <div class="pt-banner-left">

            <div class="pt-banner-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>
                <h1>Process Laboratory Test</h1>
                <p>Perform and monitor the laboratory test assigned to you.</p>
            </div>

        </div>

        <div class="pt-banner-stats">

            <div class="pt-banner-stat">
                <strong>#@(testItem?.RequestId)</strong>
                <span>Request</span>
            </div>

            <div class="pt-banner-stat">
                <strong>@progressPercentage%</strong>
                <span>Progress</span>
            </div>

            <div class="pt-banner-status">
                <span class="pt-live-dot"></span>
                @status
            </div>

        </div>

    </div>


    <!-- =====================================================
         SAMPLE BEING TESTED
         ===================================================== -->

    <div class="pt-selected-test">

        <div class="pt-selected-title">

            <div class="pt-sample-icon">
                <i class="fa-solid fa-vial"></i>
            </div>

            <div>
                <span class="pt-section-kicker">Sample being tested</span>

                <h2>@(testType?.RequiredSampleType ?? "Sample")</h2>

                <p>This is the sample currently being processed for this laboratory test.</p>
            </div>

        </div>

        <div class="pt-processing-badge">
            <span></span>
            Currently being tested
        </div>

    </div>


    <!-- =====================================================
         PATIENT + TEST INFORMATION
         ===================================================== -->

    <div class="pt-main-grid">

        <!-- PATIENT INFORMATION -->

        <section class="pt-card">

            <div class="pt-card-header">
                <div class="pt-card-header-title">
                    <i class="fa-solid fa-user"></i>
                    <span>Patient information</span>
                </div>
            </div>

            <div class="pt-card-body">

                <div class="pt-info-grid">

                    <div class="pt-info-item">
                        <span>Patient name</span>
                        <strong>@patientName</strong>
                    </div>

                    <div class="pt-info-item">
                        <span>ID number</span>
                        <strong>@(patient?.IDNumber ?? "Not available")</strong>
                    </div>

                    <div class="pt-info-item">
                        <span>Date of birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not available")
                        </strong>
                    </div>

                    <div class="pt-info-item">
                        <span>Contact number</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not available")</strong>
                    </div>

                    <div class="pt-info-item">
                        <span>Email address</span>
                        <strong>@(patient?.Email ?? "Not available")</strong>
                    </div>

                </div>


                <div class="pt-divider"></div>

                <div class="pt-subsection-title">
                    <i class="fa-solid fa-notes-medical"></i>
                    <span>Patient clinical information</span>
                </div>

                <div class="pt-clinical-grid">

                    <div class="pt-clinical-card allergy">
                        <div class="pt-clinical-icon">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                        </div>

                        <div>
                            <span>Allergies</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                    ? "No allergies recorded"
                                    : patient.Allergies)
                            </strong>
                        </div>
                    </div>

                    <div class="pt-clinical-card condition">
                        <div class="pt-clinical-icon">
                            <i class="fa-solid fa-heart-pulse"></i>
                        </div>

                        <div>
                            <span>Medical conditions</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                    ? "No medical conditions recorded"
                                    : patient.MedicalConditions)
                            </strong>
                        </div>
                    </div>

                    <div class="pt-clinical-card medication">
                        <div class="pt-clinical-icon">
                            <i class="fa-solid fa-pills"></i>
                        </div>

                        <div>
                            <span>Medication</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient?.Medication)
                                    ? "No medication recorded"
                                    : patient.Medication)
                            </strong>
                        </div>
                    </div>

                </div>


                <div class="pt-divider"></div>

                <div class="pt-subsection-title">
                    <i class="fa-solid fa-user-doctor"></i>
                    <span>Doctor's clinical notes</span>
                </div>

                @if (!string.IsNullOrWhiteSpace(request?.ClinicalNotes))
                {
                    <div class="pt-notes">

                        <div class="pt-notes-icon">
                            <i class="fa-solid fa-stethoscope"></i>
                        </div>

                        <div class="pt-notes-content">
                            <span class="pt-notes-title">Clinical notes</span>
                            <p>@request.ClinicalNotes</p>
                        </div>

                    </div>
                }
                else
                {
                    <div class="pt-empty">
                        <i class="fa-solid fa-circle-info"></i>
                        No clinical notes were provided by the doctor.
                    </div>
                }

            </div>

        </section>


        <!-- TEST INFORMATION -->

        <section class="pt-card">

            <div class="pt-card-header">

                <div class="pt-card-header-title">
                    <i class="fa-solid fa-flask"></i>
                    <span>Test information</span>
                </div>

                <span class="pt-pill">TR-@(testItem?.RequestId)</span>

            </div>

            <div class="pt-card-body">

                <div class="pt-lab-test">

                    <div class="pt-lab-test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div>
                        <div class="pt-lab-test-label">Laboratory test</div>

                        <div class="pt-lab-test-name">
                            @(testType?.Name ?? "Test information unavailable")
                        </div>

                        <div class="pt-category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(testType?.Category ?? "Not specified")
                        </div>
                    </div>

                </div>


                <div class="pt-test-info-grid">

                    <div class="pt-test-info-box sample">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-droplet"></i>
                        </div>
                        <div>
                            <span>Sample type</span>
                            <strong>@(testType?.RequiredSampleType ?? "Not specified")</strong>
                        </div>
                    </div>

                    <div class="pt-test-info-box unit">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-ruler"></i>
                        </div>
                        <div>
                            <span>Unit of measurement</span>
                            <strong>@(testType?.UnitOfMeasurement ?? "Not specified")</strong>
                        </div>
                    </div>

                    <div class="pt-test-info-box reference">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>
                        <div>
                            <span>Reference range</span>
                            <strong>@referenceRange</strong>
                        </div>
                    </div>

                    <div class="pt-test-info-box time">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-clock"></i>
                        </div>
                        <div>
                            <span>Turnaround time</span>
                            <strong>@turnaroundTime</strong>
                        </div>
                    </div>

                    <div class="pt-test-info-box request">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-hashtag"></i>
                        </div>
                        <div>
                            <span>Request number</span>
                            <strong>#@(testItem?.RequestId)</strong>
                        </div>
                    </div>

                    <div class="pt-test-info-box item">
                        <div class="pt-test-info-icon">
                            <i class="fa-solid fa-barcode"></i>
                        </div>
                        <div>
                            <span>Test item</span>
                            <strong>#@(testItem?.TestRequestItemId)</strong>
                        </div>
                    </div>

                </div>

            </div>

        </section>

    </div>


    <!-- =====================================================
         TURNAROUND TIME
         ===================================================== -->

    <section class="pt-panel">

        <div class="pt-panel-header">

            <div>
                <i class="fa-solid fa-clock"></i>
                <span>Turnaround time</span>
            </div>

            @if (isOverdue)
            {
                <span class="pt-pill danger">Overdue</span>
            }
            else
            {
                <span class="pt-pill success">On track</span>
            }

        </div>

        <div class="pt-panel-body">

            <div class="pt-turnaround-grid">

                <div class="pt-time-card">
                    <span>Expected turnaround</span>
                    <strong>@turnaroundTime</strong>
                </div>

                <div class="pt-time-card">
                    <span>Expected completion</span>
                    <strong>@dueDateTime</strong>
                </div>

                <div class="pt-time-card">
                    <span>@(isOverdue ? "Status" : "Time remaining")</span>
                    <strong>@(isOverdue ? "Overdue" : timeRemaining)</strong>
                </div>

            </div>

            <div class="pt-progress-section">

                <div class="pt-progress-heading">
                    <span>Processing progress</span>
                    <strong>@progressPercentage%</strong>
                </div>

                <div class="pt-progress-track">
                    <div class="pt-progress-fill @(isOverdue ? "late" : "")"
                         style="width:@progressPercentage%;">
                    </div>
                </div>

                <div class="pt-progress-caption">
                    Share of the turnaround time that has passed since the test started.
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         TEST PROGRESS
         ===================================================== -->

    <section class="pt-panel">

        <div class="pt-panel-header">

            <div>
                <i class="fa-solid fa-list-check"></i>
                <span>Test progress</span>
            </div>

            <span class="pt-pill">@status</span>

        </div>

        <div class="pt-panel-body">

            <div class="pt-current-step-notice">

                <div class="pt-current-step-icon">
                    <i class="fa-solid fa-flask"></i>
                </div>

                <div>
                    <strong>Current status: @status</strong>
                    <span>The laboratory test is currently at this stage of processing.</span>
                </div>

            </div>

            <div class="pt-stepper-scroll">

                <div class="pt-stepper">

                    @for (int i = 0; i < stepLabels.Length; i++)
                    {
                        var stepClass =
                            (statusIndex >= i ? "done" : "") +
                            (statusIndex == i ? " current" : "");

                        <div class="pt-step @stepClass.Trim()">

                            <div class="pt-step-circle">
                                @if (statusIndex > i || (i == 4 && statusIndex >= 4))
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                                else
                                {
                                    <span>@(i + 1)</span>
                                }
                            </div>

                            <span class="pt-step-label">
                                @stepLabels[i]

                                @if (statusIndex == i)
                                {
                                    <small>Current</small>
                                }
                            </span>

                        </div>
                    }

                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         CONSUMABLES
         ===================================================== -->

    <section class="pt-panel">

        <div class="pt-panel-header">

            <div>
                <i class="fa-solid fa-boxes-stacked"></i>
                <span>Consumables</span>
            </div>

            <span class="pt-pill warning">Current stock after test starts</span>

        </div>

        <div class="pt-panel-body">

            @if (consumables.Any())
            {
                <div class="pt-table-wrapper">

                    <table class="pt-table">

                        <thead>
                            <tr>
                                <th>Consumable</th>
                                <th>Quantity required</th>
                                <th>Quantity left</th>
                                <th>Status</th>
                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var consumable in consumables)
                            {
                                var stockLeft =
                                    consumable.Consumable?.StockLevel ?? 0;

                                <tr>
                                    <td>
                                        <strong>
                                            <i class="fa-solid fa-vial"></i>
                                            @(consumable.Consumable?.Name ?? "Consumable")
                                        </strong>
                                    </td>

                                    <td>@consumable.QuantityRequired</td>

                                    <td>
                                        <strong>@stockLeft</strong>
                                    </td>

                                    <td>
                                        @if (stockLeft <= 0)
                                        {
                                            <span class="pt-stock danger">
                                                <i class="fa-solid fa-circle-xmark"></i>
                                                Out of stock
                                            </span>
                                        }
                                        else if (stockLeft <=
                                            (consumable.Consumable?.ReorderLevel ?? 5))
                                        {
                                            <span class="pt-stock warning">
                                                <i class="fa-solid fa-triangle-exclamation"></i>
                                                Low stock
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="pt-stock good">
                                                <i class="fa-solid fa-circle-check"></i>
                                                Available
                                            </span>
                                        }
                                    </td>
                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }
            else
            {
                <div class="pt-no-data">
                    <i class="fa-solid fa-box-open"></i>
                    No consumables have been assigned to this test.
                </div>
            }

        </div>

    </section>


    <!-- =====================================================
         ACTIVITY SUMMARY
         ===================================================== -->

    <section class="pt-panel">

        <div class="pt-panel-header">

            <div>
                <i class="fa-solid fa-chart-line"></i>
                <span>Activity summary</span>
            </div>

        </div>

        <div class="pt-panel-body">

            <div class="pt-activity-grid">

                <div>
                    <span>Request</span>
                    <strong>#@(testItem?.RequestId)</strong>
                </div>

                <div>
                    <span>Test item</span>
                    <strong>#@(testItem?.TestRequestItemId)</strong>
                </div>

                <div>
                    <span>Started</span>
                    <strong>
                        @(testItem?.StartDateTime != null
                            ? testItem.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                            : "Not started")
                    </strong>
                </div>

                <div>
                    <span>Current status</span>
                    <strong class="pt-status-text">
                        <span></span>
                        @status
                    </strong>
                </div>

            </div>

        </div>

    </section>


    <!-- =====================================================
         ACTION BUTTONS
         ===================================================== -->

    <div class="pt-actions">

        <a asp-controller="AvailableTests"
           asp-action="InProgress"
           class="pt-btn pt-btn-back">
            <i class="fa-solid fa-arrow-left"></i>
            Back to tests in progress
        </a>

        @if (testItem != null)
        {
            <div class="pt-actions-right">

                <a asp-controller="CaptureResults"
                   asp-action="Capture"
                   asp-route-id="@testItem.TestRequestItemId"
                   id="captureResultsLink"
                   class="pt-btn pt-btn-results">
                    <i class="fa-solid fa-pen-to-square"></i>
                    Capture results
                </a>

            </div>
        }

    </div>

</div>


<!-- =====================================================
     CAPTURE RESULTS CONFIRMATION
     ===================================================== -->

<div id="captureModal"
     class="pt-modal"
     role="dialog"
     aria-modal="true"
     aria-labelledby="captureModalTitle">

    <div class="pt-modal-box">

        <div class="pt-modal-icon">
            <i class="fa-solid fa-pen-to-square"></i>
        </div>

        <h3 id="captureModalTitle">Capture results for this test?</h3>

        <p>Are you sure you want to capture results for this test now?</p>

        <span class="pt-modal-test">
            @(testType?.Name ?? "Laboratory test") for @patientName
        </span>

        <div class="pt-modal-actions">

            <button type="button"
                    id="captureCancel"
                    class="pt-modal-btn pt-modal-cancel">
                Cancel
            </button>

            <button type="button"
                    id="captureConfirm"
                    class="pt-modal-btn pt-modal-confirm">
                <i class="fa-solid fa-check"></i>
                Yes, capture results
            </button>

        </div>

    </div>

</div>

<script>

    (function () {

        var link = document.getElementById("captureResultsLink");
        var modal = document.getElementById("captureModal");
        var cancel = document.getElementById("captureCancel");
        var confirmBtn = document.getElementById("captureConfirm");

        if (!link || !modal) {
            return;
        }

        function openModal() {
            modal.classList.add("open");
            confirmBtn.focus();
        }

        function closeModal() {
            modal.classList.remove("open");
            link.focus();
        }

        // Ask for confirmation before leaving the page.
        link.addEventListener("click", function (event) {
            event.preventDefault();
            openModal();
        });

        cancel.addEventListener("click", closeModal);

        confirmBtn.addEventListener("click", function () {
            window.location.href = link.href;
        });

        // Close when the dark background is clicked.
        modal.addEventListener("click", function (event) {
            if (event.target === modal) {
                closeModal();
            }
        });

        // Close with the Escape key.
        document.addEventListener("keydown", function (event) {
            if (event.key === "Escape" && modal.classList.contains("open")) {
                closeModal();
            }
        });

    })();

</script>