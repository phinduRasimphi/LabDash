        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 20px;
        box-shadow: 0 12px 28px rgba(4, 103, 96, 0.18);
        color: white;
    }

        .pt-header::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            right: -80px;
            top: -120px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.07);
        }

    .pt-header-left {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 18px;
    }

    .pt-header-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255, 255, 255, 0.15);
        border: 1px solid rgba(255, 255, 255, 0.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .pt-header-kicker {
        font-size: 10px;
        font-weight: 800;
        letter-spacing: 1px;
        text-transform: uppercase;
        color: #c9f5ef;
        margin-bottom: 4px;
    }

    .pt-header h1 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 28px;
        font-weight: 800;
        color: white;
    }

    .pt-header p {
        margin: 4px 0 0;
        color: rgba(255, 255, 255, 0.78);
        font-size: 12px;
    }

    .pt-header-status {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 10px 16px;
        border-radius: 30px;
        background: rgba(255, 255, 255, 0.96);
        color: #087a70;
        font-size: 10px;
        font-weight: 800;
        white-space: nowrap;
    }

    .pt-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #18c779;
        box-shadow: 0 0 0 4px rgba(24, 199, 121, 0.12);
    }


    /* =========================================================
           SAMPLE BEING TESTED
           ========================================================= */

