    }

    .pt-notes-icon {
        width: 34px;
        height: 34px;
        border-radius: 9px;
        background: #dceff2;
        color: #087a70;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 13px;
    }

    .pt-notes-content {
