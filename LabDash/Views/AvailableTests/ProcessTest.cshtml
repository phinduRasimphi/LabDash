    <!-- =========================================================
     PATIENT INFORMATION
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-user-injured"></i>
                Patient Information
            </div>
        </div>

        <div class="pt-panel-body">

            <div class="pt-info-grid">

                <div class="pt-info-item">
                    <span>Patient name</span>
                    <strong>
                        @(patient != null
                            ? $"{patient.Name} {patient.Surname}"
                            : "Not available")
                    </strong>
                </div>

                <div class="pt-info-item">
                    <span>ID number</span>
                    <strong>
                        @(patient?.IDNumber ?? "Not available")
                    </strong>
                </div>

                <div class="pt-info-item">
                    <span>Cellphone</span>
                    <strong>
                        @(patient?.CellphoneNumber ?? "Not available")
                    </strong>
                </div>

                <div class="pt-info-item">
                    <span>Email</span>
                    <strong>
                        @(patient?.Email ?? "Not available")
                    </strong>
                </div>

                <div class="pt-info-item">
                    <span>Date of birth</span>
                    <strong>
                        @(patient?.DOB.ToString("dd MMM yyyy") ?? "Not available")
                    </strong>
                </div>

                <div class="pt-info-item">
                    <span>Request status</span>
                    <strong>
                        @(testRequest?.Status ?? "In Progress")
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
     MEDICAL ALERTS
     ========================================================= -->

    <div class="pt-alert-grid">

        <div class="pt-alert-card allergy">

            <div class="pt-alert-heading">
                <i class="fa-solid fa-triangle-exclamation"></i>
                <span>Allergies</span>
            </div>

            @if (string.IsNullOrWhiteSpace(patient?.Allergies))
            {
                <div class="pt-clear">
                    <i class="fa-solid fa-circle-check"></i>
                    No recorded allergies
                </div>
            }
            else
            {
                <div class="pt-alert-content">
                    @patient.Allergies
                </div>
            }

        </div>


        <div class="pt-alert-card condition">

            <div class="pt-alert-heading">
                <i class="fa-solid fa-heart-pulse"></i>
                <span>Medical Conditions</span>
            </div>

            @if (string.IsNullOrWhiteSpace(patient?.MedicalConditions))
            {
                <div class="pt-clear">
                    <i class="fa-solid fa-circle-check"></i>
                    No conditions recorded
                </div>
            }
            else
            {
                <div class="pt-alert-content">
                    @patient.MedicalConditions
                </div>
            }

        </div>


        <div class="pt-alert-card medication">

            <div class="pt-alert-heading">
                <i class="fa-solid fa-pills"></i>
                <span>Current Medication</span>
            </div>

            @if (string.IsNullOrWhiteSpace(patient?.Medication))
            {
                <div class="pt-clear">
                    <i class="fa-solid fa-circle-check"></i>
                    No medication recorded
                </div>
            }
            else
            {
                <div class="pt-alert-content">
                    @patient.Medication
                </div>
            }

        </div>

    </div>


    <!-- =========================================================
     CLINICAL NOTES
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-notes-medical"></i>
                Doctor's Clinical Notes
            </div>
        </div>

        <div class="pt-panel-body">

            @if (string.IsNullOrWhiteSpace(testRequest?.ClinicalNotes))
            {
                <div class="pt-empty">
                    <i class="fa-solid fa-file-circle-check"></i>
                    No clinical notes were supplied.
                </div>
            }
            else
            {
                <div class="pt-notes">
                    <i class="fa-solid fa-quote-left"></i>
                    <span>@testRequest.ClinicalNotes</span>
                </div>
            }

        </div>

    </div>


    <!-- =========================================================
     TURNAROUND TIME
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-clock"></i>
                Turnaround Time
            </div>

            @if (isOverdue)
            {
                <span class="pt-header-danger">
                    <i class="fa-solid fa-clock"></i>
                    OVERDUE
                </span>
            }
            else
            {
                <span class="pt-header-success">
                    <i class="fa-solid fa-check-circle"></i>
                    ON TIME
                </span>
            }

        </div>

        <div class="pt-panel-body">

            <div class="pt-turnaround-grid">

                <div class="pt-time-card">
                    <span>Started</span>
                    <strong>
                        @FormatDate(Model.StartDateTime)
                    </strong>
                </div>


                <div class="pt-time-card">
                    <span>Expected completion</span>
                    <strong>
                        @(ViewBag.DueDateTime != null
                            ? ((DateTime)ViewBag.DueDateTime).ToString("dd MMM yyyy, HH:mm")
                            : "Not available")
                    </strong>
                </div>


                <div class="pt-time-card">

                    <span>Time remaining</span>

                    @if (isOverdue)
                    {
                        <strong class="pt-danger-text">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Overdue
                        </strong>
                    }
                    else if (ViewBag.TimeRemaining != null)
                    {
                        var remaining = (TimeSpan)ViewBag.TimeRemaining;

                        if (remaining.TotalSeconds < 0)
                        {
                            <strong class="pt-danger-text">
                                Overdue
                            </strong>
                        }
                        else
                        {
                            <strong class="pt-success-text">
                                @($"{Math.Max(0, remaining.Days)}d {Math.Max(0, remaining.Minutes)}h {Math.Max(0, remaining.Minutes)}m")
                            </strong>
                        }
                    }
                    else
                    {
                        <strong>
                            Not available
                        </strong>
                    }

                </div>

            </div>


            <div class="pt-progress-section">

                <div class="pt-progress-heading">

                    <span>Turnaround progress</span>

                    <strong>
                        @progress%
                    </strong>

                </div>

                <div class="pt-progress-track">

                    <div class="pt-progress-fill"
                         style="width:@progress%;">
                    </div>

                </div>

                <div class="pt-progress-caption">
                    @progress% of the allocated turnaround time has elapsed.
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
     TEST PROGRESS
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-list-check"></i>
                Test Progress
            </div>

            <span class="pt-progress-badge">
                @progress% Complete
            </span>
        </div>

        <div class="pt-panel-body">

            <div class="pt-stepper">

                @for (var i = 0; i < steps.Length; i++)
                {
                    var isDone = i < statusIndex;
                    var isCurrent = i == statusIndex;

                    <div class="pt-step @(isDone ? "done" : "") @(isCurrent ? "current" : "")">

                        <div class="pt-step-circle">

                            @if (isDone)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else if (isCurrent)
                            {
                                <i class="fa-solid fa-flask"></i>
                            }
                            else
                            {
                                <span>@(i + 1)</span>
                            }

                        </div>

                        <span class="pt-step-label">
                            @steps[i]
                        </span>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
     CONSUMABLES
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-boxes-stacked"></i>
                Consumables Used
            </div>
        </div>

        <div class="pt-table-wrapper">

            <table class="pt-table">

                <thead>
                    <tr>
                        <th>Consumable</th>
                        <th>Description</th>
                        <th>Quantity Used</th>
                        <th>Remaining Stock</th>
                    </tr>
                </thead>

                <tbody>

                    @if (ViewBag.Consumables != null &&
                         ((IEnumerable<dynamic>)ViewBag.Consumables).Any())
                    {
                        foreach (var item in ViewBag.Consumables)
                        {
                            <tr>

                                <td>
                                    <strong>
                                        @item.Consumable?.Name
                                    </strong>
                                </td>

                                <td>
                                    @(item.Consumable?.Description ?? "—")
                                </td>

                                <td>
                                    @item.QuantityRequired
                                </td>

                                <td>

                                    @if (item.Consumable != null &&
                                         item.Consumable.StockLevel <= item.Consumable.ReorderLevel)
                                    {
                                        <span class="pt-stock low">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            @item.Consumable.StockLevel
                                        </span>
                                    }
                                    else if (item.Consumable != null)
                                    {
                                        <span class="pt-stock good">
                                            <i class="fa-solid fa-circle-check"></i>
                                            @item.Consumable.StockLevel
                                        </span>
                                    }
                                    else
                                    {
                                        <span>—</span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="4" class="pt-no-data">
                                <i class="fa-solid fa-box-open"></i>
                                No consumables recorded for this test.
                            </td>
                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================================
     ACTIVITY SUMMARY
     ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">
            <div>
                <i class="fa-solid fa-clock-rotate-left"></i>
                Activity Summary
            </div>
        </div>

        <div class="pt-panel-body">

            <div class="pt-activity-grid">

                <div>
                    <span>Test started</span>
                    <strong>
                        @FormatDate(Model.StartDateTime)
                    </strong>
                </div>

                <div>
                    <span>Technician</span>
                    <strong>
                        @(Model.AssignedTechnician?.FullName ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Current status</span>
                    <strong class="pt-status-text">
                        <span></span>
                        @Model.Status
                    </strong>
                </div>

                <div>
                    <span>Expected completion</span>
                    <strong>
                        @(ViewBag.DueDateTime != null
                            ? ((DateTime)ViewBag.DueDateTime).ToString("dd MMM yyyy, HH:mm")
                            : "Not available")
                    </strong>
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
     ACTIONS
     ========================================================= -->

    <div class="pt-actions">

        <a asp-action="InProgress"
           class="pt-btn pt-btn-back">

            <i class="fa-solid fa-arrow-left"></i>
            Back to In Progress

        </a>


        <div class="pt-actions-right">

            <form asp-action="CompleteTest"
                  method="post"
                  class="pt-complete-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.TestRequestItemId" />

                <button type="submit"
                        class="pt-btn pt-btn-complete"
                        onclick="return confirm('Are you sure you want to mark this laboratory test as completed?');">

                    <i class="fa-solid fa-circle-check"></i>
                    Complete Test

                </button>

            </form>


            <a asp-controller="CaptureResults"
               asp-action="Capture"
               asp-route-id="@Model.TestRequestItemId"
               class="pt-btn pt-btn-results">

                <i class="fa-solid fa-vial-circle-check"></i>
                Capture Results

            </a>

        </div>

    </div>
    ```

</div>

