        border: 1px dashed #cfdee2;
        border-radius: 12px;
        padding: 13px;
        color: #66818e;
        font-size: 10px;
    }

        .pt-empty i {
            color: #087a70;
            margin-right: 6px;
        }


    /* =========================================================
           TEST INFORMATION
           ========================================================= */

    .pt-lab-test {
