        </div>


        <div class="pt-stat-card">

            <div class="pt-stat-icon">
                <i class="fa-solid fa-play"></i>
            </div>

            <div>
                <span>Started</span>
                <strong>
                    @FormatDate(Model.StartDateTime)
                </strong>
            </div>

        </div>


        <div class="pt-stat-card">

            <div class="pt-stat-icon">
                <i class="fa-solid fa-user-nurse"></i>
            </div>

            <div>
                <span>Technician</span>
                <strong>
                    @(Model.AssignedTechnician?.FullName ?? "Assigned technician")
                </strong>
            </div>

        </div>

