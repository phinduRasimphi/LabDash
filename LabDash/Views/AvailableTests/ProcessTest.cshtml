@model LabDash.Models.TestRequestItem

@{
    ViewData["Title"] = "Process Laboratory Test";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var testItem = ViewBag.TestItem as LabDash.Models.TestRequestItem;
    var testType = ViewBag.TestType as LabDash.Models.TestType;
    var patient = ViewBag.Patient as LabDash.Models.Patient;
    var testRequest = ViewBag.TestRequest as LabDash.Models.TestRequest;

    var isOverdue = ViewBag.IsOverdue is bool overdue && overdue;

    int progress = 0;

    if (ViewBag.ProgressPercentage != null)
    {
        progress = Convert.ToInt32(ViewBag.ProgressPercentage);
    }

    if (progress < 0)
    {
        progress = 0;
    }

    if (progress > 100)
    {
        progress = 100;
    }

    var status = Model?.Status ?? "In Progress";

    var steps = new[]
    {
        "Submitted",
        "Samples Received",
        "In Progress",
        "Completed",
        "Verified"
    };

    var statusIndex = status switch
    {
        "Verified" => 4,
        "Completed" => 3,
        "In Progress" => 2,
        "Samples Received" => 1,
        _ => 0
    };

    string FormatDate(DateTime? date)
    {
        return date.HasValue
            ? date.Value.ToString("dd MMM yyyy, HH:mm")
            : "Not available";
    }

    var dueDateTime = ViewBag.DueDateTime as DateTime?;

    TimeSpan? timeRemaining = null;

    if (ViewBag.TimeRemaining != null)
    {
        try
        {
            timeRemaining = (TimeSpan)ViewBag.TimeRemaining;
        }
        catch
        {
            timeRemaining = null;
        }
    }

    var consumables = ViewBag.Consumables as IEnumerable<dynamic>;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>

    /* =========================================================
           PAGE
           ========================================================= */

    .pt-page {
        background: #eef5f8;
        min-height: 100vh;
        padding: 28px 34px 50px;
        font-family: 'Inter', sans-serif;
        color: #12334a;
    }

        .pt-page * {
            box-sizing: border-box;
        }

    /* =========================================================
           TOP HEADER
           ========================================================= */

    .pt-header {
        background: #ffffff;
        border-radius: 16px;
        padding: 24px 28px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 18px;
        box-shadow: 0 8px 25px rgba(19, 71, 91, 0.08);
        border: 1px solid #e1ebef;
    }

    .pt-header-left {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .pt-header-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: #e2f3f1;
        color: #087a70;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
    }

    .pt-header-kicker {
        color: #087a70;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .7px;
        margin-bottom: 2px;
    }

    .pt-header h1 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        font-weight: 800;
        color: #092d47;
    }

    .pt-header p {
        margin: 3px 0 0;
        color: #688397;
        font-size: 13px;
    }

    .pt-header-status {
        background: #e4f5ef;
        color: #087a70;
        padding: 10px 17px;
        border-radius: 30px;
        font-size: 12px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .pt-live-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: #22c477;
        display: inline-block;
    }

    /* =========================================================
           SAMPLE BEING TESTED
           ========================================================= */

    .pt-selected-test {
        background: linear-gradient(135deg, #08786f, #078f83);
        border-radius: 16px;
        padding: 24px 26px;
        margin-bottom: 18px;
        color: white;
        box-shadow: 0 9px 24px rgba(0, 112, 103, .16);
    }

    .pt-selected-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .pt-selected-title {
        display: flex;
        align-items: center;
        gap: 17px;
    }

    .pt-sample-icon {
        width: 62px;
        height: 62px;
        border-radius: 15px;
        background: rgba(255,255,255,.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }

    .pt-section-kicker {
        display: block;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .7px;
        text-transform: uppercase;
        opacity: .85;
        margin-bottom: 3px;
    }

    .pt-selected-title h2 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 22px;
        font-weight: 800;
    }

    .pt-selected-title p {
        margin: 3px 0 0;
        font-size: 12px;
        opacity: .88;
    }

    .pt-processing-badge {
        background: rgba(255,255,255,.95);
        color: #087a70;
        padding: 10px 15px;
        border-radius: 30px;
        font-size: 11px;
        font-weight: 800;
        display: flex;
        align-items: center;
        gap: 7px;
        white-space: nowrap;
    }

        .pt-processing-badge span {
            width: 8px;
            height: 8px;
            background: #20c878;
            border-radius: 50%;
        }

    .pt-selected-divider {
        height: 1px;
        background: rgba(255,255,255,.2);
        margin: 19px 0;
    }

    .pt-test-details {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
    }

    .pt-test-detail {
        background: rgba(255,255,255,.96);
        border: 1px solid rgba(255,255,255,.7);
        border-radius: 12px;
        padding: 14px 15px;
        color: #12334a;
    }

        .pt-test-detail.primary {
            background: #e4f4f2;
            border-color: #b8dfda;
        }

    .pt-detail-label {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #087a70;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .4px;
        margin-bottom: 7px;
    }

        .pt-detail-label i {
            font-size: 10px;
        }

    .pt-test-detail strong {
        display: block;
        font-size: 14px;
        font-weight: 800;
        color: #092d47;
    }

    /* =========================================================
           TWO COLUMN INFORMATION
           ========================================================= */

    .pt-main-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 18px;
    }

    .pt-card {
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e0e9ed;
        box-shadow: 0 7px 22px rgba(24, 71, 91, .06);
    }

    .pt-card-header {
        min-height: 52px;
        padding: 0 18px;
        background: #087a70;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-size: 13px;
        font-weight: 800;
        font-family: 'Poppins', sans-serif;
    }

    .pt-card-header-title {
        display: flex;
        align-items: center;
        gap: 10px;
    }

        .pt-card-header-title i {
            font-size: 14px;
        }

    .pt-card-header.blue {
        background: #2875a5;
    }

    .pt-card-body {
        padding: 22px;
    }

    /* =========================================================
           PATIENT INFORMATION
           ========================================================= */

    .pt-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        column-gap: 28px;
    }

    .pt-info-item {
        padding: 13px 0;
        border-bottom: 1px solid #e2eaee;
    }

        .pt-info-item:nth-last-child(-n+2) {
            border-bottom: none;
        }

        .pt-info-item span {
            display: block;
            color: #7590a2;
            text-transform: uppercase;
            font-size: 9px;
            font-weight: 700;
            letter-spacing: .5px;
            margin-bottom: 6px;
        }

        .pt-info-item strong {
            display: block;
            color: #0b3048;
            font-size: 13px;
            font-weight: 800;
        }

    /* =========================================================
           TEST INFORMATION
           ========================================================= */

    .pt-lab-test {
        display: flex;
        align-items: center;
        gap: 15px;
        padding-bottom: 18px;
        border-bottom: 1px solid #dfe8ed;
        margin-bottom: 15px;
    }

    .pt-lab-test-icon {
        width: 60px;
        height: 60px;
        background: #e8f2f8;
        color: #2875a5;
        border-radius: 14px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .pt-lab-test-label {
        color: #7590a2;
        font-size: 9px;
        text-transform: uppercase;
        font-weight: 700;
        letter-spacing: .5px;
        margin-bottom: 3px;
    }

    .pt-lab-test-name {
        color: #092d47;
        font-family: 'Poppins', sans-serif;
        font-size: 21px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .pt-category-pill {
        display: inline-block;
        background: #e7f1f6;
        color: #2875a5;
        padding: 5px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
    }

    .pt-test-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .pt-test-info-box {
        min-height: 64px;
        border-radius: 12px;
        padding: 11px 13px;
        border: 1px solid transparent;
    }

        .pt-test-info-box.sample {
            background: #fcecef;
            border-color: #f4d9df;
        }

        .pt-test-info-box.unit {
            background: #e8f6f4;
            border-color: #d3ece9;
        }

        .pt-test-info-box.reference {
            background: #fff6df;
            border-color: #f2e6bd;
        }

        .pt-test-info-box.time {
            background: #e9f4fa;
            border-color: #d6e9f3;
        }

        .pt-test-info-box span {
            display: block;
            color: #718999;
            font-size: 9px;
            margin-bottom: 4px;
        }

        .pt-test-info-box strong {
            color: #092d47;
            font-size: 11px;
            font-weight: 800;
        }

    .pt-test-info-icon {
        float: left;
        width: 30px;
        height: 30px;
        margin-right: 9px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
    }

    .sample .pt-test-info-icon {
        background: #f8dce2;
        color: #d53d56;
    }

    .unit .pt-test-info-icon {
        background: #d7efeb;
        color: #087a70;
    }

    .reference .pt-test-info-icon {
        background: #fae9bb;
        color: #bf8a00;
    }

    .time .pt-test-info-icon {
        background: #d8ebf5;
        color: #2875a5;
    }

    /* =========================================================
           GENERAL FULL WIDTH PANELS
           ========================================================= */

    .pt-panel {
        background: #ffffff;
        border-radius: 16px;
        overflow: hidden;
        border: 1px solid #e0e9ed;
        box-shadow: 0 7px 22px rgba(24, 71, 91, .06);
        margin-bottom: 18px;
    }

    .pt-panel-header {
        min-height: 52px;
        padding: 0 18px;
        background: #087a70;
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 800;
    }

        .pt-panel-header > div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .pt-panel-body {
        padding: 20px;
    }

    /* =========================================================
           CLINICAL INFORMATION
           ========================================================= */

    .pt-clinical-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 13px;
    }

    .pt-clinical-card {
        min-height: 76px;
        padding: 14px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .pt-clinical-card.allergy {
            background: #fce8ec;
        }

        .pt-clinical-card.condition {
            background: #fff4dc;
        }

        .pt-clinical-card.medication {
            background: #e5f5f3;
        }

    .pt-clinical-icon {
        width: 38px;
        height: 38px;
        background: rgba(255,255,255,.72);
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }

    .allergy .pt-clinical-icon {
        color: #d53d56;
    }

    .condition .pt-clinical-icon {
        color: #b78300;
    }

    .medication .pt-clinical-icon {
        color: #087a70;
    }

    .pt-clinical-card span {
        display: block;
        color: #718999;
        text-transform: uppercase;
        font-size: 9px;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .pt-clinical-card strong {
        display: block;
        color: #12334a;
        font-size: 12px;
        line-height: 1.4;
    }

    /* =========================================================
           CLINICAL NOTES
           ========================================================= */

    .pt-notes {
        background: #edf7fb;
        border-radius: 11px;
        padding: 16px 18px;
        color: #31566d;
        font-size: 13px;
        line-height: 1.6;
        display: flex;
        gap: 12px;
    }

        .pt-notes i {
            color: #2875a5;
            font-size: 18px;
        }

    .pt-empty {
        background: #edf7fb;
        border-radius: 11px;
        padding: 15px;
        color: #55788c;
        font-size: 12px;
    }

        .pt-empty i {
            color: #2875a5;
            margin-right: 8px;
        }

    /* =========================================================
           TURNAROUND
           ========================================================= */

    .pt-header-success,
    .pt-header-danger {
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 9px;
    }

    .pt-header-success {
        background: #e2f5ed;
        color: #087a70;
    }

    .pt-header-danger {
        background: #fce5e8;
        color: #c43850;
    }

    .pt-turnaround-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }

    .pt-time-card {
        padding: 12px 14px;
        border-right: 1px solid #e1e9ed;
    }

        .pt-time-card:last-child {
            border-right: none;
        }

        .pt-time-card span {
            display: block;
            color: #7590a2;
            text-transform: uppercase;
            font-size: 9px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .pt-time-card strong {
            font-size: 12px;
            color: #12334a;
        }

    .pt-progress-section {
        margin-top: 18px;
        padding-top: 16px;
        border-top: 1px solid #e3eaee;
    }

    .pt-progress-heading {
        display: flex;
        justify-content: space-between;
        font-size: 10px;
        color: #668294;
        margin-bottom: 7px;
    }

        .pt-progress-heading strong {
            color: #087a70;
        }

    .pt-progress-track {
        height: 8px;
        background: #e4edf0;
        border-radius: 20px;
        overflow: hidden;
    }

    .pt-progress-fill {
        height: 100%;
        background: linear-gradient(90deg, #087a70, #22a99a);
        border-radius: 20px;
    }

    .pt-progress-caption {
        margin-top: 6px;
        color: #7b92a0;
        font-size: 10px;
    }

    /* =========================================================
           TEST PROGRESS
           ========================================================= */

    .pt-progress-badge {
        background: rgba(255,255,255,.16);
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 10px;
    }

    .pt-current-step-notice {
        background: #e6f5f2;
        border: 1px solid #cce9e4;
        border-radius: 12px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 24px;
    }

    .pt-current-step-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: white;
        color: #087a70;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .pt-current-step-notice strong {
        display: block;
        color: #087a70;
        font-size: 12px;
        margin-bottom: 3px;
    }

    .pt-current-step-notice span {
        display: block;
        color: #607e8f;
        font-size: 10px;
    }

    .pt-stepper {
        display: flex;
        align-items: flex-start;
        position: relative;
        justify-content: space-between;
    }

        .pt-stepper::before {
            content: "";
            position: absolute;
            top: 17px;
            left: 8%;
            right: 8%;
            height: 3px;
            background: #dbe8ec;
            z-index: 0;
        }

    .pt-step {
        position: relative;
        z-index: 1;
        width: 20%;
        text-align: center;
    }

    .pt-step-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e3edf0;
        color: #75909f;
        margin: 0 auto 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 11px;
        font-weight: 800;
        border: 4px solid #fff;
    }

    .pt-step.done .pt-step-circle {
        background: #087a70;
        color: white;
    }

    .pt-step.current .pt-step-circle {
        background: #2c7cae;
        color: white;
        box-shadow: 0 0 0 5px #dcecf5;
    }

    .pt-step-label {
        display: block;
        color: #718999;
        font-size: 9px;
        font-weight: 700;
    }

    .pt-step.done .pt-step-label,
    .pt-step.current .pt-step-label {
        color: #12334a;
    }

    .pt-step-label small {
        display: block;
        color: #087a70;
        font-size: 7px;
        margin-top: 3px;
        font-weight: 800;
    }

    /* =========================================================
           CONSUMABLES
           ========================================================= */

    .pt-consumable-rule {
        background: #fff2cf;
        color: #a97800;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 9px;
    }

    .pt-table-wrapper {
        overflow-x: auto;
    }

    .pt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .pt-table th {
            background: #f3f8fa;
            color: #6d8796;
            padding: 12px 16px;
            text-align: left;
            text-transform: uppercase;
            font-size: 8px;
            letter-spacing: .4px;
        }

        .pt-table td {
            padding: 13px 16px;
            border-top: 1px solid #e4ecef;
            color: #315368;
        }

            .pt-table td strong {
                color: #12334a;
            }

    .pt-stock {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
    }

        .pt-stock small {
            font-size: 7px;
            font-weight: 800;
        }

        .pt-stock.good {
            color: #087a70;
        }

        .pt-stock.low {
            color: #cf3d52;
        }

    .pt-no-data {
        text-align: center;
        padding: 24px !important;
        color: #8095a1 !important;
    }

        .pt-no-data i {
            margin-right: 7px;
        }

    /* =========================================================
           ACTIVITY
           ========================================================= */

    .pt-activity-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

        .pt-activity-grid > div {
            padding: 5px 20px;
            border-right: 1px solid #e1e9ed;
        }

            .pt-activity-grid > div:first-child {
                padding-left: 0;
            }

            .pt-activity-grid > div:last-child {
                border-right: none;
            }

        .pt-activity-grid span {
            display: block;
            color: #78919f;
            text-transform: uppercase;
            font-size: 8px;
            font-weight: 700;
            margin-bottom: 5px;
        }

        .pt-activity-grid strong {
            display: block;
            color: #12334a;
            font-size: 11px;
        }

    .pt-status-text {
        display: flex !important;
        align-items: center;
        gap: 6px;
        color: #087a70 !important;
    }

        .pt-status-text span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #20c878;
            display: inline-block;
            margin: 0;
        }

    /* =========================================================
           ACTIONS
           ========================================================= */

    .pt-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 4px;
    }

    .pt-actions-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pt-complete-form {
        margin: 0;
    }

    .pt-btn {
        border: none;
        text-decoration: none;
        border-radius: 9px;
        padding: 11px 16px;
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        cursor: pointer;
        transition: .2s ease;
    }

        .pt-btn:hover {
            transform: translateY(-1px);
        }

    .pt-btn-back {
        background: white;
        border: 1px solid #b9d9df;
        color: #087a70;
    }

    .pt-btn-complete {
        background: #087a70;
        color: white;
    }

    .pt-btn-results {
        background: #2875a5;
        color: white;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1100px) {

        .pt-main-grid {
            grid-template-columns: 1fr;
        }

        .pt-test-details {
            grid-template-columns: 1fr 1fr;
        }

        .pt-clinical-grid {
            grid-template-columns: 1fr;
        }

        .pt-activity-grid {
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

            .pt-activity-grid > div {
                border-right: none;
            }
    }

    @@media (max-width: 800px) {

        .pt-page {
            padding: 18px;
        }

        .pt-header {
            align-items: flex-start;
            flex-direction: column;
            gap: 15px;
        }

        .pt-selected-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .pt-test-details {
            grid-template-columns: 1fr;
        }

        .pt-info-grid,
        .pt-test-info-grid {
            grid-template-columns: 1fr;
        }

        .pt-turnaround-grid {
            grid-template-columns: 1fr;
        }

        .pt-time-card {
            border-right: none;
            border-bottom: 1px solid #e1e9ed;
        }

            .pt-time-card:last-child {
                border-bottom: none;
            }

        .pt-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .pt-actions-right {
            flex-direction: column;
            width: 100%;
        }

        .pt-btn,
        .pt-complete-form,
        .pt-complete-form button {
            width: 100%;
            justify-content: center;
        }

        .pt-stepper {
            overflow-x: auto;
            min-width: 600px;
        }

        .pt-stepper-wrapper {
            overflow-x: auto;
        }
    }

</style>


<div class="pt-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="pt-header">

        <div class="pt-header-left">

            <div class="pt-header-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>

                <div class="pt-header-kicker">
                    LABORATORY TEST PROCESSING
                </div>

                <h1>
                    Process Laboratory Test
                </h1>

                <p>
                    Perform and monitor the laboratory test assigned to you.
                </p>

            </div>

        </div>

        <div class="pt-header-status">

            <span class="pt-live-dot"></span>

            IN PROGRESS

        </div>

    </div>


    <!-- =========================================================
         SAMPLE BEING TESTED
         ========================================================= -->

    <div class="pt-selected-test">

        <div class="pt-selected-top">

            <div class="pt-selected-title">

                <div class="pt-sample-icon">
                    <i class="fa-solid fa-vial"></i>
                </div>

                <div>

                    <span class="pt-section-kicker">
                        SAMPLE BEING TESTED
                    </span>

                    <h2>
                        @(testType?.RequiredSampleType ?? "Sample not specified")
                    </h2>

                    <p>
                        This is the sample currently being processed for this laboratory test.
                    </p>

                </div>

            </div>

            <div class="pt-processing-badge">

                <span></span>

                Currently being tested

            </div>

        </div>


        <div class="pt-selected-divider"></div>


        <div class="pt-test-details">

            <div class="pt-test-detail primary">

                <span class="pt-detail-label">
                    <i class="fa-solid fa-flask"></i>
                    TEST TYPE
                </span>

                <strong>
                    @(testType?.Name ?? "Test type not specified")
                </strong>

            </div>


            <div class="pt-test-detail">

                <span class="pt-detail-label">
                    <i class="fa-solid fa-layer-group"></i>
                    CATEGORY
                </span>

                <strong>
                    @(testType?.Category ?? "Not specified")
                </strong>

            </div>


            <div class="pt-test-detail">

                <span class="pt-detail-label">
                    <i class="fa-solid fa-hashtag"></i>
                    REQUEST NUMBER
                </span>

                <strong>
                    #@(testItem?.RequestId.ToString() ?? "N/A")
                </strong>

            </div>


            <div class="pt-test-detail">

                <span class="pt-detail-label">
                    <i class="fa-solid fa-barcode"></i>
                    TEST ITEM
                </span>

                <strong>
                    #@(testItem?.TestRequestItemId.ToString() ?? "N/A")
                </strong>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PATIENT LEFT / TEST INFORMATION RIGHT
         ========================================================= -->

    <div class="pt-main-grid">

        <!-- =====================================================
             PATIENT INFORMATION
             ===================================================== -->

        <div class="pt-card">

            <div class="pt-card-header">

                <div class="pt-card-header-title">

                    <i class="fa-solid fa-user"></i>

                    Patient Information

                </div>

            </div>


            <div class="pt-card-body">

                <div class="pt-info-grid">

                    <div class="pt-info-item">

                        <span>
                            Patient Name
                        </span>

                        <strong>
                            @(patient != null
                                ? $"{patient.Name} {patient.Surname}"
                                : "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            ID Number
                        </span>

                        <strong>
                            @(patient?.IDNumber ?? "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Cellphone
                        </span>

                        <strong>
                            @(patient?.CellphoneNumber ?? "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Email
                        </span>

                        <strong>
                            @(patient?.Email ?? "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Date of Birth
                        </span>

                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Request Status
                        </span>

                        <strong>
                            @(testRequest?.Status ?? "In Progress")
                        </strong>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             TEST INFORMATION
             ===================================================== -->

        <div class="pt-card">

            <div class="pt-card-header blue">

                <div class="pt-card-header-title">

                    <i class="fa-solid fa-flask"></i>

                    Test Information

                </div>

                <span>
                    TR-@(testItem?.RequestId.ToString() ?? "N/A")
                </span>

            </div>


            <div class="pt-card-body">

                <div class="pt-lab-test">

                    <div class="pt-lab-test-icon">

                        <i class="fa-solid fa-vial"></i>

                    </div>


                    <div>

                        <div class="pt-lab-test-label">
                            LABORATORY TEST
                        </div>

                        <div class="pt-lab-test-name">
                            @(testType?.Name ?? "Laboratory Test")
                        </div>

                        <span class="pt-category-pill">

                            <i class="fa-solid fa-layer-group"></i>

                            @(testType?.Category ?? "Not specified")

                        </span>

                    </div>

                </div>


                <div class="pt-test-info-grid">

                    <!-- SAMPLE -->

                    <div class="pt-test-info-box sample">

                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-droplet"></i>

                        </div>

                        <span>
                            Sample Type
                        </span>

                        <strong>
                            @(testType?.RequiredSampleType ?? "Not specified")
                        </strong>

                    </div>


                    <!-- UNIT -->

                    <div class="pt-test-info-box unit">

                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-ruler"></i>

                        </div>

                        <span>
                            Unit of Measurement
                        </span>

                        <strong>
                            @(string.IsNullOrWhiteSpace(testType?.UnitOfMeasurement)
                                ? "Not specified"
                                : testType.UnitOfMeasurement)
                        </strong>

                    </div>


                    <!-- REFERENCE RANGE -->

                    <div class="pt-test-info-box reference">

                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-chart-line"></i>

                        </div>

                        <span>
                            Reference Range
                        </span>

                        <strong>

                            @if (testType?.ReferenceRangeLow.HasValue == true &&
                                 testType?.ReferenceRangeHigh.HasValue == true)
                            {
                                @($"{testType.ReferenceRangeLow:0.##} - {testType.ReferenceRangeHigh:0.##}")
                            }
                            else
                            {
                                @:Not specified
                            }

                        </strong>

                    </div>


                    <!-- TURNAROUND -->

                    <div class="pt-test-info-box time">

                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>

                        <span>
                            Turnaround Time
                        </span>

                        <strong>
                            @(testType?.TurnaroundTimeMinutes.ToString() ?? "0") minutes
                        </strong>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         PATIENT CLINICAL INFORMATION
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-notes-medical"></i>

                Patient Clinical Information

            </div>

        </div>


        <div class="pt-panel-body">

            <div class="pt-clinical-grid">

                <!-- ALLERGIES -->

                <div class="pt-clinical-card allergy">

                    <div class="pt-clinical-icon">

                        <i class="fa-solid fa-triangle-exclamation"></i>

                    </div>

                    <div>

                        <span>
                            Allergies
                        </span>

                        @if (string.IsNullOrWhiteSpace(patient?.Allergies))
                        {
                            <strong>
                                None
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.Allergies
                            </strong>
                        }

                    </div>

                </div>


                <!-- CONDITIONS -->

                <div class="pt-clinical-card condition">

                    <div class="pt-clinical-icon">

                        <i class="fa-solid fa-heart-pulse"></i>

                    </div>

                    <div>

                        <span>
                            Medical Conditions
                        </span>

                        @if (string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                        {
                            <strong>
                                None
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.MedicalConditions
                            </strong>
                        }

                    </div>

                </div>


                <!-- MEDICATION -->

                <div class="pt-clinical-card medication">

                    <div class="pt-clinical-icon">

                        <i class="fa-solid fa-pills"></i>

                    </div>

                    <div>

                        <span>
                            Current Medication
                        </span>

                        @if (string.IsNullOrWhiteSpace(patient?.Medication))
                        {
                            <strong>
                                None
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.Medication
                            </strong>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         DOCTOR'S CLINICAL NOTES
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-file-medical"></i>

                Doctor's Clinical Notes

            </div>

        </div>


        <div class="pt-panel-body">

            @if (string.IsNullOrWhiteSpace(testRequest?.ClinicalNotes))
            {
                <div class="pt-empty">

                    <i class="fa-solid fa-file-circle-check"></i>

                    No clinical notes were supplied.

                </div>
            }
            else
            {
                <div class="pt-notes">

                    <i class="fa-solid fa-quote-left"></i>

                    <span>
                        @testRequest.ClinicalNotes
                    </span>

                </div>
            }

        </div>

    </div>


    <!-- =========================================================
         TURNAROUND TIME
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-clock"></i>

                Turnaround Time

            </div>


            @if (isOverdue)
            {
                <span class="pt-header-danger">

                    <i class="fa-solid fa-triangle-exclamation"></i>

                    OVERDUE

                </span>
            }
            else
            {
                <span class="pt-header-success">

                    <i class="fa-solid fa-circle-check"></i>

                    ON TIME

                </span>
            }

        </div>


        <div class="pt-panel-body">

            <div class="pt-turnaround-grid">

                <div class="pt-time-card">

                    <span>
                        Started
                    </span>

                    <strong>
                        @FormatDate(Model.StartDateTime)
                    </strong>

                </div>


                <div class="pt-time-card">

                    <span>
                        Expected Completion
                    </span>

                    <strong>
                        @(dueDateTime.HasValue
                            ? dueDateTime.Value.ToString("dd MMM yyyy, HH:mm")
                            : "Not available")
                    </strong>

                </div>


                <div class="pt-time-card">

                    <span>
                        Time Remaining
                    </span>

                    @if (isOverdue)
                    {
                        <strong style="color:#cf3d52;">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            Overdue

                        </strong>
                    }
                    else if (timeRemaining.HasValue)
                    {
                        var remaining = timeRemaining.Value;

                        if (remaining.TotalSeconds <= 0)
                        {
                            <strong style="color:#cf3d52;">
                                Overdue
                            </strong>
                        }
                        else
                        {
                            <strong style="color:#087a70;">

                                @($"{remaining.Days}d {remaining.Hours}h {remaining.Minutes}m")

                            </strong>
                        }
                    }
                    else
                    {
                        <strong>
                            Not available
                        </strong>
                    }

                </div>

            </div>


            <div class="pt-progress-section">

                <div class="pt-progress-heading">

                    <span>
                        Turnaround Progress
                    </span>

                    <strong>
                        @progress%
                    </strong>

                </div>

                <div class="pt-progress-track">

                    <div class="pt-progress-fill"
                         style="width:@progress%;">
                    </div>

                </div>

                <div class="pt-progress-caption">

                    @progress% of the allocated turnaround time has elapsed.

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         TEST PROGRESS
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-list-check"></i>

                Test Progress

            </div>

            <span class="pt-progress-badge">

                @progress% Complete

            </span>

        </div>


        <div class="pt-panel-body">

            <div class="pt-current-step-notice">

                <div class="pt-current-step-icon">

                    <i class="fa-solid fa-flask"></i>

                </div>

                <div>

                    <strong>
                        Currently processing: @(testType?.Name ?? "Laboratory Test")
                    </strong>

                    <span>

                        The test is currently at the
                        <b>@status</b>
                        stage.

                    </span>

                </div>

            </div>


            <div style="overflow-x:auto;">

                <div class="pt-stepper">

                    @for (var i = 0; i < steps.Length; i++)
                    {
                        var isDone = i < statusIndex;
                        var isCurrent = i == statusIndex;

                        <div class="pt-step @(isDone ? "done" : "") @(isCurrent ? "current" : "")">

                            <div class="pt-step-circle">

                                @if (isDone)
                                {
                                    <i class="fa-solid fa-check"></i>
                                }
                                else if (isCurrent)
                                {
                                    <i class="fa-solid fa-flask"></i>
                                }
                                else
                                {
                                    <span>
                                        @(i + 1)
                                    </span>
                                }

                            </div>


                            <span class="pt-step-label">

                                @steps[i]

                                @if (isCurrent)
                                {
                                    <small>
                                        CURRENT
                                    </small>
                                }

                            </span>

                        </div>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CONSUMABLES
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-boxes-stacked"></i>

                Consumables Used

            </div>

            <span class="pt-consumable-rule">

                Warning below 150

            </span>

        </div>


        <div class="pt-table-wrapper">

            <table class="pt-table">

                <thead>

                    <tr>

                        <th>
                            Consumable
                        </th>

                        <th>
                            Description
                        </th>

                        <th>
                            Quantity Used
                        </th>

                        <th>
                            Remaining Stock
                        </th>

                    </tr>

                </thead>


                <tbody>

                    @if (consumables != null && consumables.Any())
                    {
                        foreach (var item in consumables)
                        {
                            <tr>

                                <td>

                                    <strong>
                                        @(item.Consumable?.Name ?? "Unknown consumable")
                                    </strong>

                                </td>


                                <td>
                                    @(item.Consumable?.Description ?? "—")
                                </td>


                                <td>
                                    @item.QuantityRequired
                                </td>


                                <td>

                                    @if (item.Consumable != null)
                                    {
                                        var stockLevel = Convert.ToInt32(item.Consumable.StockLevel);

                                        if (stockLevel < 150)
                                        {
                                            <span class="pt-stock low">

                                                <i class="fa-solid fa-triangle-exclamation"></i>

                                                @stockLevel

                                                <small>
                                                    LOW STOCK
                                                </small>

                                            </span>
                                        }
                                        else
                                        {
                                            <span class="pt-stock good">

                                                <i class="fa-solid fa-circle-check"></i>

                                                @stockLevel

                                                <small>
                                                    STOCK OK
                                                </small>

                                            </span>
                                        }
                                    }
                                    else
                                    {
                                        <span>
                                            —
                                        </span>
                                    }

                                </td>

                            </tr>
                        }
                    }
                    else
                    {
                        <tr>

                            <td colspan="4" class="pt-no-data">

                                <i class="fa-solid fa-box-open"></i>

                                No consumables recorded for this test.

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>

    </div>


    <!-- =========================================================
         ACTIVITY SUMMARY
         ========================================================= -->

    <div class="pt-panel">

        <div class="pt-panel-header">

            <div>

                <i class="fa-solid fa-clock-rotate-left"></i>

                Activity Summary

            </div>

        </div>


        <div class="pt-panel-body">

            <div class="pt-activity-grid">

                <div>

                    <span>
                        Test Started
                    </span>

                    <strong>
                        @FormatDate(Model.StartDateTime)
                    </strong>

                </div>


                <div>

                    <span>
                        Technician
                    </span>

                    <strong>
                        @(Model.AssignedTechnician?.FullName ?? "Not available")
                    </strong>

                </div>


                <div>

                    <span>
                        Current Status
                    </span>

                    <strong class="pt-status-text">

                        <span></span>

                        @Model.Status

                    </strong>

                </div>


                <div>

                    <span>
                        Expected Completion
                    </span>

                    <strong>
                        @(dueDateTime.HasValue
                            ? dueDateTime.Value.ToString("dd MMM yyyy, HH:mm")
                            : "Not available")
                    </strong>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         ACTIONS
         ========================================================= -->

    <div class="pt-actions">

        <a asp-action="InProgress"
           class="pt-btn pt-btn-back">

            <i class="fa-solid fa-arrow-left"></i>

            Back to In Progress

        </a>


        <div class="pt-actions-right">

            <form asp-action="CompleteTest"
                  method="post"
                  class="pt-complete-form">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       name="id"
                       value="@Model.TestRequestItemId" />

                <button type="submit"
                        class="pt-btn pt-btn-complete"
                        onclick="return confirm('Are you sure you want to mark this laboratory test as completed?');">

                    <i class="fa-solid fa-circle-check"></i>

                    Complete Test

                </button>

            </form>


            <a asp-controller="CaptureResults"
               asp-action="Capture"
               asp-route-id="@Model.TestRequestItemId"
               class="pt-btn pt-btn-results">

                <i class="fa-solid fa-vial-circle-check"></i>

                Capture Results

            </a>

        </div>

    </div>

</div>