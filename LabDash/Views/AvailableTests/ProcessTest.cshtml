        letter-spacing: .35px;
        margin-bottom: 4px;
    }

    .pt-test-info-box strong {
        display: block;
        color: #153b4d;
        font-size: 11px;
        font-weight: 800;
    }


    /* =========================================================
           GENERAL PANELS
           ========================================================= */

    .pt-panel {
        background: #ffffff;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #dce8eb;
        box-shadow: 0 8px 24px rgba(20, 70, 82, 0.06);
        margin-bottom: 20px;
    }

    .pt-panel-header {
        min-height: 54px;
        padding: 0 20px;
        background: linear-gradient( 135deg, #087a70, #099286 );
        color: white;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        font-family: 'Poppins', sans-serif;
        font-size: 13px;
        font-weight: 800;
    }

        .pt-panel-header > div {
            display: flex;
            align-items: center;
            gap: 10px;
        }

    .pt-panel-body {
        padding: 21px;
    }


    /* =========================================================
           TURNAROUND
           ========================================================= */

    .pt-header-success,
    .pt-header-danger {
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 800;
    }

    .pt-header-success {
        background: #dff5ec;
        color: #087a70;
    }

    .pt-header-danger {
        background: #fce5e8;
        color: #c43850;
    }

    .pt-turnaround-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
    }

    .pt-time-card {
        padding: 8px 18px;
        border-right: 1px solid #e2eaed;
    }

        .pt-time-card:first-child {
            padding-left: 0;
        }

        .pt-time-card:last-child {
            border-right: none;
        }

        .pt-time-card span {
            display: block;
            color: #78919d;
            text-transform: uppercase;
            font-size: 8px;
            font-weight: 800;
            margin-bottom: 6px;
        }

        .pt-time-card strong {
            font-size: 11px;
            color: #153b4d;
        }

    .pt-progress-section {
        margin-top: 19px;
        padding-top: 17px;
        border-top: 1px solid #e3ebee;
    }

    .pt-progress-heading {
        display: flex;
        justify-content: space-between;
        font-size: 9px;
        color: #668294;
        margin-bottom: 7px;
    }

        .pt-progress-heading strong {
            color: #087a70;
        }

    .pt-progress-track {
        height: 9px;
        background: #e2ecee;
        border-radius: 20px;
        overflow: hidden;
    }

    .pt-progress-fill {
        height: 100%;
        background: linear-gradient( 90deg, #087a70, #20a99b );
        border-radius: 20px;
        transition: width .4s ease;
    }

    .pt-progress-caption {
        margin-top: 7px;
        color: #7b929e;
        font-size: 9px;
    }


    /* =========================================================
           TEST PROGRESS
           ========================================================= */

    .pt-progress-badge {
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.18);
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 9px;
    }

    .pt-current-step-notice {
        background: #e6f5f2;
        border: 1px solid #cce9e4;
        border-radius: 13px;
        padding: 14px;
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 25px;
    }

    .pt-current-step-icon {
        width: 42px;
        height: 42px;
        border-radius: 10px;
        background: white;
        color: #087a70;
        display: flex;
        align-items: center;
        justify-content: center;
        box-shadow: 0 3px 10px rgba(8, 122, 112, 0.08);
    }

    .pt-current-step-notice strong {
        display: block;
        color: #087a70;
        font-size: 11px;
        margin-bottom: 3px;
    }

    .pt-current-step-notice span {
        display: block;
        color: #607e8f;
        font-size: 9px;
    }

    .pt-stepper {
        display: flex;
        align-items: flex-start;
        position: relative;
        justify-content: space-between;
    }

        .pt-stepper::before {
            content: "";
            position: absolute;
            top: 17px;
            left: 8%;
            right: 8%;
            height: 3px;
            background: #dbe8ec;
            z-index: 0;
        }

    .pt-step {
        position: relative;
        z-index: 1;
        width: 20%;
        text-align: center;
    }

    .pt-step-circle {
        width: 35px;
        height: 35px;
        border-radius: 50%;
        background: #e3edf0;
        color: #75909f;
        margin: 0 auto 8px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10px;
        font-weight: 800;
        border: 4px solid #fff;
    }

    .pt-step.done .pt-step-circle {
        background: #087a70;
        color: white;
    }

    .pt-step.current .pt-step-circle {
        background: #0a8f83;
        color: white;
        box-shadow: 0 0 0 5px #d9efeb;
    }

    .pt-step-label {
        display: block;
        color: #718999;
        font-size: 8px;
        font-weight: 700;
    }

    .pt-step.done .pt-step-label,
    .pt-step.current .pt-step-label {
        color: #123b4c;
    }

    .pt-step-label small {
        display: block;
        color: #087a70;
        font-size: 7px;
        margin-top: 3px;
        font-weight: 800;
    }


    /* =========================================================
           CONSUMABLES
           ========================================================= */

    .pt-consumable-rule {
        background: #fff2cf;
        color: #a97800;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 8px;
        font-weight: 800;
    }

    .pt-table-wrapper {
        overflow-x: auto;
    }

    .pt-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 10px;
    }

        .pt-table th {
            background: #f1f7f8;
            color: #6d8796;
            padding: 12px 16px;
            text-align: left;
            text-transform: uppercase;
            font-size: 8px;
            letter-spacing: .4px;
        }

        .pt-table td {
            padding: 13px 16px;
            border-top: 1px solid #e4ecef;
            color: #315368;
        }

            .pt-table td strong {
                color: #123b4c;
            }

                .pt-table td strong i {
                    color: #087a70;
                    margin-right: 7px;
                }

    .pt-stock {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        font-weight: 800;
    }

        .pt-stock.good {
            color: #087a70;
        }

        .pt-stock.low {
            color: #cf3d52;
        }

    .pt-no-data {
        text-align: center;
        padding: 24px !important;
        color: #8095a1 !important;
        font-size: 10px;
    }

        .pt-no-data i {
            margin-right: 7px;
        }


    /* =========================================================
           ACTIVITY
           ========================================================= */

    .pt-activity-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
    }

        .pt-activity-grid > div {
            padding: 5px 20px;
            border-right: 1px solid #e1e9ed;
        }

            .pt-activity-grid > div:first-child {
                padding-left: 0;
            }

            .pt-activity-grid > div:last-child {
                border-right: none;
            }

        .pt-activity-grid span {
            display: block;
            color: #78919f;
            text-transform: uppercase;
            font-size: 8px;
            font-weight: 800;
            margin-bottom: 5px;
        }

        .pt-activity-grid strong {
            display: block;
            color: #123b4c;
            font-size: 10px;
            word-break: break-word;
        }

    .pt-status-text {
        display: flex !important;
        align-items: center;
        gap: 6px;
        color: #087a70 !important;
    }

        .pt-status-text > span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #20c878;
            display: inline-block;
            margin: 0;
            flex-shrink: 0;
        }


    /* =========================================================
           ACTIONS
           ========================================================= */

    .pt-actions {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
        margin-top: 4px;
    }

    .pt-actions-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .pt-btn {
        border: none;
        text-decoration: none;
        border-radius: 10px;
        padding: 11px 17px;
        font-family: 'Inter', sans-serif;
        font-size: 10px;
        font-weight: 800;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        cursor: pointer;
        transition: all .2s ease;
    }

        .pt-btn:hover {
            transform: translateY(-1px);
        }

    .pt-btn-back {
        background: #ffffff;
        border: 1px solid #bddbdf;
        color: #087a70;
    }

        .pt-btn-back:hover {
            background: #eaf7f5;
            color: #087a70;
        }

    .pt-btn-results {
        background: linear-gradient( 135deg, #087a70, #099286 );
        color: white;
        box-shadow: 0 5px 13px rgba(8, 122, 112, 0.18);
    }

        .pt-btn-results:hover {
            color: white;
            box-shadow: 0 7px 17px rgba(8, 122, 112, 0.25);
        }


    /* =========================================================
           RESPONSIVE - TABLET
           ========================================================= */

    @@media (max-width: 1100px) {

        .pt-main-grid {
            grid-template-columns: 1fr;
        }

        .pt-clinical-grid {
            grid-template-columns: 1fr 1fr 1fr;
        }

        .pt-activity-grid {
            grid-template-columns: 1fr 1fr;
            gap: 15px;
        }

            .pt-activity-grid > div {
                border-right: none;
            }
    }


    /* =========================================================
           RESPONSIVE - MOBILE
           ========================================================= */

    @@media (max-width: 800px) {

        .pt-page {
            padding: 18px;
        }

        .pt-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

        .pt-header-status {
            align-self: flex-start;
        }

        .pt-selected-top {
            flex-direction: column;
            align-items: flex-start;
        }

        .pt-processing-badge {
            align-self: flex-start;
        }

        .pt-info-grid,
        .pt-test-info-grid {
            grid-template-columns: 1fr;
        }

        .pt-clinical-grid {
            grid-template-columns: 1fr;
        }

        .pt-turnaround-grid {
            grid-template-columns: 1fr;
        }

        .pt-time-card,
        .pt-time-card:first-child {
            padding: 12px 0;
            border-right: none;
            border-bottom: 1px solid #e1e9ed;
        }

            .pt-time-card:last-child {
                border-bottom: none;
            }

        .pt-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .pt-actions-right {
            width: 100%;
            flex-direction: column;
        }

        .pt-btn {
            width: 100%;
        }

        .pt-stepper {
            min-width: 600px;
        }

        .pt-activity-grid {
            grid-template-columns: 1fr;
        }

            .pt-activity-grid > div,
            .pt-activity-grid > div:first-child {
                padding: 10px 0;
                border-bottom: 1px solid #e1e9ed;
            }

                .pt-activity-grid > div:last-child {
                    border-bottom: none;
                }
    }


    /* =========================================================
           SMALL MOBILE
           ========================================================= */

    @@media (max-width: 500px) {

        .pt-page {
            padding: 12px;
        }

        .pt-header {
            padding: 22px;
        }

        .pt-header-left {
            gap: 12px;
        }

        .pt-header-icon {
            width: 50px;
            height: 50px;
            font-size: 22px;
        }

        .pt-header h1 {
            font-size: 22px;
        }

        .pt-selected-test {
            padding: 20px;
        }

        .pt-selected-title h2 {
            font-size: 19px;
        }

        .pt-card-body,
        .pt-panel-body {
            padding: 17px;
        }

        .pt-lab-test-name {
            font-size: 17px;
        }

        .pt-clinical-card {
            min-height: 82px;
            padding: 13px;
        }

        .pt-clinical-icon {
            width: 38px;
            height: 38px;
        }

        .pt-stepper {
            min-width: 550px;
        }
    }

</style>


<!-- =========================================================
     PAGE
     ========================================================= -->

<div class="pt-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="pt-header">

        <div class="pt-header-left">

            <div class="pt-header-icon">

                <i class="fa-solid fa-flask-vial"></i>

            </div>


            <div>

                <div class="pt-header-kicker">
                    Laboratory Processing
                </div>

                <h1>
                    Process Laboratory Test
                </h1>

                <p>
                    Perform and monitor the laboratory test assigned to you.
                </p>

            </div>

        </div>


        <div class="pt-header-status">

            <span class="pt-live-dot"></span>

            @status

        </div>

    </div>



    <!-- =====================================================
         SAMPLE BEING TESTED
         ===================================================== -->

    <div class="pt-selected-test">

        <div class="pt-selected-top">


            <div class="pt-selected-title">

                <div class="pt-sample-icon">

                    <i class="fa-solid fa-vial"></i>

                </div>


                <div>

                    <span class="pt-section-kicker">
                        Sample Being Tested
                    </span>

                    <h2>
                        @(testType?.RequiredSampleType ?? "Sample")
                    </h2>

                    <p>
                        This is the sample currently being processed for this laboratory test.
                    </p>

                </div>

            </div>


            <div class="pt-processing-badge">

                <span></span>

                Currently being tested

            </div>

        </div>

    </div>



    <!-- =====================================================
         PATIENT + TEST INFORMATION
         ===================================================== -->

    <div class="pt-main-grid">


        <!-- =================================================
             PATIENT INFORMATION
             ================================================= -->

        <div class="pt-card">


            <div class="pt-card-header">

                <div class="pt-card-header-title">

                    <i class="fa-solid fa-user"></i>

                    <span>
                        Patient Information
                    </span>

                </div>

            </div>


            <div class="pt-card-body">


                <!-- PATIENT DETAILS -->

                <div class="pt-info-grid">


                    <div class="pt-info-item">

                        <span>
                            Patient Name
                        </span>

                        <strong>
                            @patientName
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            ID Number
                        </span>

                        <strong>
                            @(patient?.IDNumber ?? "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Date of Birth
                        </span>

                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Contact Number
                        </span>

                        <strong>
                            @(patient?.CellphoneNumber ?? "Not available")
                        </strong>

                    </div>


                    <div class="pt-info-item">

                        <span>
                            Email Address
                        </span>

                        <strong>
                            @(patient?.Email ?? "Not available")
                        </strong>

                    </div>

                </div>



                <!-- =================================================
                     CLINICAL INFORMATION
                     ================================================= -->

                <div class="pt-divider"></div>


                <div class="pt-subsection-title">

                    <i class="fa-solid fa-notes-medical"></i>

                    <span>
                        Patient Clinical Information
                    </span>

                </div>


                <div class="pt-clinical-grid">


                    <!-- ALLERGIES -->

                    <div class="pt-clinical-card allergy">

                        <div class="pt-clinical-icon">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                        </div>


                        <div>

                            <span>
                                Allergies
                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                    ? "No allergies recorded"
                                    : patient.Allergies)

                            </strong>

                        </div>

                    </div>



                    <!-- MEDICAL CONDITIONS -->

                    <div class="pt-clinical-card condition">

                        <div class="pt-clinical-icon">

                            <i class="fa-solid fa-heart-pulse"></i>

                        </div>


                        <div>

                            <span>
                                Medical Conditions
                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                    ? "No medical conditions recorded"
                                    : patient.MedicalConditions)

                            </strong>

                        </div>

                    </div>



                    <!-- MEDICATION -->

                    <div class="pt-clinical-card medication">

                        <div class="pt-clinical-icon">

                            <i class="fa-solid fa-pills"></i>

                        </div>


                        <div>

                            <span>
                                Medication
                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(patient?.Medication)
                                    ? "No medication recorded"
                                    : patient.Medication)

                            </strong>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     DOCTOR'S CLINICAL NOTES
                     ================================================= -->

                <div class="pt-divider"></div>


                <div class="pt-subsection-title">

                    <i class="fa-solid fa-user-doctor"></i>

                    <span>
                        Doctor's Clinical Notes
                    </span>

                </div>


                @if (!string.IsNullOrWhiteSpace(request?.ClinicalNotes))
                {
                    <div class="pt-notes">


                        <div class="pt-notes-icon">

                            <i class="fa-solid fa-stethoscope"></i>

                        </div>


                        <div class="pt-notes-content">

                            <span class="pt-notes-title">
                                Clinical Notes
                            </span>

                            <p>
                                @request.ClinicalNotes
                            </p>

                        </div>


                    </div>
                }
                else
                {
                    <div class="pt-empty">

                        <i class="fa-solid fa-circle-info"></i>

                        No clinical notes were provided by the doctor.

                    </div>
                }


            </div>

        </div>



        <!-- =================================================
             TEST INFORMATION
             ================================================= -->

        <div class="pt-card">


            <div class="pt-card-header">


                <div class="pt-card-header-title">

                    <i class="fa-solid fa-flask"></i>

                    <span>
                        Test Information
                    </span>

                </div>


                <span>
                    TR-@testItem?.RequestId
                </span>


            </div>


            <div class="pt-card-body">


                <!-- LABORATORY TEST -->

                <div class="pt-lab-test">


                    <div class="pt-lab-test-icon">

                        <i class="fa-solid fa-vial"></i>

                    </div>


                    <div>

                        <div class="pt-lab-test-label">
                            Laboratory Test
                        </div>


                        <div class="pt-lab-test-name">

                            @(testType?.Name
                                ?? "Test information unavailable")

                        </div>


                        <div class="pt-category-pill">

                            <i class="fa-solid fa-layer-group"></i>

                            @(testType?.Category
                                ?? "Not specified")

                        </div>

                    </div>

                </div>



                <!-- TEST DETAILS -->

                <div class="pt-test-info-grid">


                    <!-- SAMPLE TYPE -->

                    <div class="pt-test-info-box sample">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-droplet"></i>

                        </div>


                        <span>
                            Sample Type
                        </span>


                        <strong>

                            @(testType?.RequiredSampleType
                                ?? "Not specified")

                        </strong>


                    </div>



                    <!-- UNIT -->

                    <div class="pt-test-info-box unit">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-ruler"></i>

                        </div>


                        <span>
                            Unit of Measurement
                        </span>


                        <strong>

                            @(testType?.UnitOfMeasurement
                                ?? "Not specified")

                        </strong>


                    </div>



                    <!-- REFERENCE RANGE -->

                    <div class="pt-test-info-box reference">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-chart-line"></i>

                        </div>


                        <span>
                            Reference Range
                        </span>


                        <strong>
                            @referenceRange
                        </strong>


                    </div>



                    <!-- TURNAROUND TIME -->

                    <div class="pt-test-info-box time">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-clock"></i>

                        </div>


                        <span>
                            Turnaround Time
                        </span>


                        <strong>
                            @turnaroundTime
                        </strong>


                    </div>



                    <!-- REQUEST NUMBER -->

                    <div class="pt-test-info-box request">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-hashtag"></i>

                        </div>


                        <span>
                            Request Number
                        </span>


                        <strong>
                            #@testItem?.RequestId
                        </strong>


                    </div>



                    <!-- TEST ITEM -->

                    <div class="pt-test-info-box item">


                        <div class="pt-test-info-icon">

                            <i class="fa-solid fa-barcode"></i>

                        </div>


                        <span>
                            Test Item
                        </span>


                        <strong>
                            #@testItem?.TestRequestItemId
                        </strong>


                    </div>


                </div>

            </div>

        </div>

    </div>



    <!-- =====================================================
         TURNAROUND TIME
         ===================================================== -->

    <div class="pt-panel">


        <div class="pt-panel-header">


            <div>

                <i class="fa-solid fa-clock"></i>

                <span>
                    Turnaround Time
                </span>

            </div>


            @if (isOverdue)
            {
                <span class="pt-header-danger">
                    OVERDUE
                </span>
            }
            else
            {
                <span class="pt-header-success">
                    ON TRACK
                </span>
            }


        </div>


        <div class="pt-panel-body">


            <div class="pt-turnaround-grid">


                <div class="pt-time-card">

                    <span>
                        Expected Turnaround
                    </span>

                    <strong>
                        @turnaroundTime
                    </strong>

                </div>


                <div class="pt-time-card">

                    <span>
                        Expected Completion
                    </span>

                    <strong>
                        @dueDateTime
                    </strong>

                </div>


                <div class="pt-time-card">

                    <span>

                        @(isOverdue
                            ? "Status"
                            : "Time Remaining")

                    </span>


                    <strong>

                        @(isOverdue
                            ? "OVERDUE"
                            : timeRemaining)

                    </strong>

                </div>


            </div>


            <!-- PROGRESS -->

            <div class="pt-progress-section">


                <div class="pt-progress-heading">

                    <span>
                        Processing Progress
                    </span>

                    <strong>
                        @progressPercentage%
                    </strong>

                </div>


                <div class="pt-progress-track">

                    <div class="pt-progress-fill"
                         style="width:@progressPercentage%;">
                    </div>

                </div>


                <div class="pt-progress-caption">

                    Current laboratory test progress

                </div>


            </div>


        </div>

    </div>



    <!-- =====================================================
         TEST PROGRESS
         ===================================================== -->

    <div class="pt-panel">


        <div class="pt-panel-header">


            <div>

                <i class="fa-solid fa-list-check"></i>

                <span>
                    Test Progress
                </span>

            </div>


            <span class="pt-progress-badge">

                @progressPercentage%

            </span>


        </div>


        <div class="pt-panel-body">


            <!-- CURRENT STATUS -->

            <div class="pt-current-step-notice">


                <div class="pt-current-step-icon">

                    <i class="fa-solid fa-flask"></i>

                </div>


                <div>

                    <strong>
                        Current Status: @status
                    </strong>

                    <span>
                        The laboratory test is currently at this stage of processing.
                    </span>

                </div>


            </div>



            <!-- STEPPER -->

            <div style="overflow-x:auto;">


                <div class="pt-stepper">


                    <!-- SUBMITTED -->

                    <div class="pt-step
                        @(statusIndex >= 0 ? "done" : "")
                        @(statusIndex == 0 ? "current" : "")">


                        <div class="pt-step-circle">

                            @if (statusIndex > 0)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <span>1</span>
                            }

                        </div>


                        <span class="pt-step-label">

                            Submitted

                            @if (statusIndex == 0)
                            {
                                <small>Current</small>
                            }

                        </span>


                    </div>



                    <!-- SAMPLES RECEIVED -->

                    <div class="pt-step
                        @(statusIndex >= 1 ? "done" : "")
                        @(statusIndex == 1 ? "current" : "")">


                        <div class="pt-step-circle">

                            @if (statusIndex > 1)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <span>2</span>
                            }

                        </div>


                        <span class="pt-step-label">

                            Samples Received

                            @if (statusIndex == 1)
                            {
                                <small>Current</small>
                            }

                        </span>


                    </div>



                    <!-- IN PROGRESS -->

                    <div class="pt-step
                        @(statusIndex >= 2 ? "done" : "")
                        @(statusIndex == 2 ? "current" : "")">


                        <div class="pt-step-circle">

                            @if (statusIndex > 2)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <span>3</span>
                            }

                        </div>


                        <span class="pt-step-label">

                            In Progress

                            @if (statusIndex == 2)
                            {
                                <small>Current</small>
                            }

                        </span>


                    </div>



                    <!-- COMPLETED -->

                    <div class="pt-step
                        @(statusIndex >= 3 ? "done" : "")
                        @(statusIndex == 3 ? "current" : "")">


                        <div class="pt-step-circle">

                            @if (statusIndex > 3)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <span>4</span>
                            }

                        </div>


                        <span class="pt-step-label">

                            Completed

                            @if (statusIndex == 3)
                            {
                                <small>Current</small>
                            }

                        </span>


                    </div>



                    <!-- VERIFIED -->

                    <div class="pt-step
                        @(statusIndex >= 4 ? "done" : "")
                        @(statusIndex == 4 ? "current" : "")">


                        <div class="pt-step-circle">

                            @if (statusIndex >= 4)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                <span>5</span>
                            }

                        </div>


                        <span class="pt-step-label">

                            Verified

                            @if (statusIndex == 4)
                            {
                                <small>Current</small>
                            }

                        </span>


                    </div>


                </div>

            </div>


        </div>

    </div>



    <!-- =====================================================
         CONSUMABLES
         ===================================================== -->

    <div class="pt-panel">


        <div class="pt-panel-header">


            <div>

                <i class="fa-solid fa-boxes-stacked"></i>

                <span>
                    Consumables
                </span>

            </div>


            <span class="pt-consumable-rule">
                Required for test
            </span>


        </div>


        <div class="pt-panel-body">


            @if (consumables.Any())
            {

                <div class="pt-table-wrapper">


                    <table class="pt-table">


                        <thead>

                            <tr>

                                <th>
                                    Consumable
                                </th>

                                <th>
                                    Quantity Required
                                </th>

                                <th>
                                    Status
                                </th>

                            </tr>

                        </thead>


                        <tbody>


                            @foreach (var consumable in consumables)
                            {

                                <tr>


                                    <td>

                                        <strong>

                                            <i class="fa-solid fa-vial"></i>

                                            @(consumable.Consumable?.Name
                                                ?? "Consumable")

                                        </strong>

                                    </td>


                                    <td>

                                        @consumable.QuantityRequired

                                    </td>


                                    <td>

                                        <span class="pt-stock good">

                                            <i class="fa-solid fa-circle-check"></i>

                                            Available

                                        </span>

                                    </td>


                                </tr>

                            }


                        </tbody>


                    </table>


                </div>

            }
            else
            {

                <div class="pt-no-data">

                    <i class="fa-solid fa-box-open"></i>

                    No consumables have been assigned to this test.

                </div>

            }


        </div>

    </div>



    <!-- =====================================================
         ACTIVITY SUMMARY
         ===================================================== -->

    <div class="pt-panel">


        <div class="pt-panel-header">


            <div>

                <i class="fa-solid fa-chart-line"></i>

                <span>
                    Activity Summary
                </span>

            </div>


        </div>


        <div class="pt-panel-body">


            <div class="pt-activity-grid">


                <!-- REQUEST -->

                <div>

                    <span>
                        Request
                    </span>

                    <strong>
                        #@testItem?.RequestId
                    </strong>

                </div>



                <!-- TEST ITEM -->

                <div>

                    <span>
                        Test Item
                    </span>

                    <strong>
                        #@testItem?.TestRequestItemId
                    </strong>

                </div>



                <!-- STARTED -->

                <div>

                    <span>
                        Started
                    </span>

                    <strong>

                        @(testItem?.StartDateTime != null
                            ? testItem.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                            : "Not started")

                    </strong>

                </div>



                <!-- CURRENT STATUS -->

                <div>

                    <span>
                        Current Status
                    </span>

                    <strong class="pt-status-text">

                        <span></span>

                        @status

                    </strong>

                </div>


            </div>


        </div>

    </div>



    <!-- =====================================================
         ACTION BUTTONS
         ===================================================== -->

    <div class="pt-actions">


        <a asp-controller="AvailableTests"
           asp-action="InProgress"
           class="pt-btn pt-btn-back">

            <i class="fa-solid fa-arrow-left"></i>

            Back to Tests In Progress

        </a>


        @if (testItem != null)
        {

            <div class="pt-actions-right">


                <a asp-controller="CaptureResults"
                   asp-action="Capture"
                   asp-route-id="@testItem.TestRequestItemId"
                   class="pt-btn pt-btn-results">

                    <i class="fa-solid fa-pen-to-square"></i>

                    Capture Results

                </a>


            </div>

        }


    </div>


</div>