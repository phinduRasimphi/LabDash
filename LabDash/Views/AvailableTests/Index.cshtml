@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Available Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<h2 class="mb-4">Available Tests</h2>

<table class="table table-bordered table-hover">

    <thead class="table-success">
        <tr>
            <th>Request</th>
            <th>Test</th>
            <th>Category</th>
            <th>Urgency</th>
            <th>Status</th>
            <th>Action</th>
        </tr>
    </thead>

    <tbody>

    @foreach (var item in Model)
    {
        <tr>

            <td>@item.RequestId</td>

            <td>@item.TestType.Name</td>

            <td>@item.TestType.Category</td>

            <td>@item.TestRequest.Urgency</td>

            <td>
                <span class="badge bg-warning">
                    @item.Status
                </span>
            </td>

            <td>

                <form asp-action="StartTest"
                      asp-route-id="@item.TestRequestItemId"
                      method="post">

                    <button class="btn btn-success">
                        Start Test
                    </button>

                </form>

            </td>

        </tr>
    }

    </tbody>

</table>
