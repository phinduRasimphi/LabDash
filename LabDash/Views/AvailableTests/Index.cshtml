@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Available Laboratory Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var tests = Model?.ToList() ?? new List<LabDash.Models.TestRequestItem>();

    var urgentCount = tests.Count(x =>
        x.TestRequest != null &&
        (x.TestRequest.Urgency == "Urgent" ||
         x.TestRequest.Urgency == "STAT"));

    var todayCount = tests.Count(x =>
        x.TestRequest != null &&
        x.TestRequest.RequestDate.Date == DateTime.Today);

    Func<string, (string Cls, string Label)> GetTube = category =>
    {
        if (category == "Hematology")
            return ("violet", "LAV");

        if (category == "Chemistry")
            return ("gold", "SST");

        if (category == "Coagulation")
            return ("blue", "CIT");

        if (category == "Microbiology")
            return ("green", "MSU");

        return ("violet", "GEN");
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="available-page">

    <!-- BANNER -->
    <div class="av-banner">

        <div class="av-banner-left">
            <div class="av-banner-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>
                <h1>Available Laboratory Tests</h1>
                <p>Select a test to view the patient record and begin processing.</p>
            </div>
        </div>

        <div class="av-banner-stats">
            <div class="av-banner-stat">
                <strong>@tests.Count</strong>
                <span>Available</span>
            </div>

            <div class="av-banner-stat">
                <strong>@urgentCount</strong>
                <span>Urgent</span>
            </div>

            <div class="av-banner-stat">
                <strong>@todayCount</strong>
                <span>Today</span>
            </div>
        </div>

    </div>


    <!-- MAIN CONTENT -->
    <div class="av-grid">

        <!-- AVAILABLE TESTS -->
        <section class="av-panel">

            <div class="av-panel-head">
                <h2 class="av-panel-title">
                    <i class="fa-solid fa-list-check"></i>
                    Available tests
                </h2>

                <span class="av-count-pill" id="testCount">
                    @tests.Count @(tests.Count == 1 ? "test" : "tests")
                </span>
            </div>

            <div class="av-panel-body">

                <!-- SEARCH + FILTER -->
                <div class="av-filter-bar">

                    <div class="av-search">
                        <i class="fa-solid fa-magnifying-glass"></i>

                        <input type="text"
                               id="testSearch"
                               aria-label="Search available tests"
                               placeholder="Search patient, request number or test..." />
                    </div>

                    <div class="av-select">
                        <i class="fa-solid fa-filter"></i>

                        <select id="urgencyFilter" aria-label="Filter by urgency">
                            <option value="all">All urgencies</option>
                            <option value="STAT">STAT</option>
                            <option value="Urgent">Urgent</option>
                            <option value="High">High</option>
                            <option value="Priority">Priority</option>
                            <option value="Routine">Routine</option>
                        </select>
                    </div>

                </div>


                <div id="testList">

                    @if (tests.Any())
                    {
                        foreach (var item in tests)
                        {
                            var testName = item.TestType?.Name ?? "Unknown Test";
                            var category = item.TestType?.Category ?? "Laboratory";
                            var sample = item.TestType?.RequiredSampleType ?? "Not specified";
                            var turnaround = item.TestType?.TurnaroundTimeMinutes ?? 0;

                            var patientName = "Unknown Patient";

                            if (item.TestRequest?.Patient != null)
                            {
                                patientName =
                                    $"{item.TestRequest.Patient.Name} {item.TestRequest.Patient.Surname}";
                            }

                            var urgency = item.TestRequest?.Urgency ?? "Routine";

                            var urgencyClass =
                                urgency == "Urgent" || urgency == "STAT"
                                    ? "urgent"
                                    : urgency == "High"
                                        ? "high"
                                        : "routine";

                            var urgencyIcon =
                                urgency == "Urgent" || urgency == "STAT"
                                    ? "fa-bell"
                                    : urgency == "High"
                                        ? "fa-triangle-exclamation"
                                        : "fa-circle-check";

                            var tube = GetTube(category);

                            <div class="test-row"
                                 data-test-id="@item.TestRequestItemId"
                                 data-urgency="@urgency"
                                 data-search="@($"{patientName} {testName} {item.RequestId} {category}")">

                                <!-- TUBE -->
                                <div class="tube @tube.Cls">@tube.Label</div>

                                <!-- TEST INFORMATION -->
                                <div class="test-information">

                                    <div class="test-title">
                                        <strong>@testName</strong>

                                        <span class="urgency @urgencyClass">
                                            <i class="fa-solid @urgencyIcon"></i>
                                            @urgency
                                        </span>
                                    </div>

                                    <div class="patient-line">
                                        <i class="fa-solid fa-user"></i>
                                        @patientName
                                        <span class="request-tag">Request #@item.RequestId</span>
                                    </div>

                                    <div class="test-details">
                                        <span>
                                            <i class="fa-solid fa-vial"></i>
                                            @sample
                                        </span>

                                        <span>
                                            <i class="fa-solid fa-layer-group"></i>
                                            @category
                                        </span>

                                        <span>
                                            <i class="fa-solid fa-clock"></i>
                                            @turnaround minutes
                                        </span>

                                        <span>
                                            <i class="fa-solid fa-circle"></i>
                                            @item.Status
                                        </span>
                                    </div>

                                </div>

                                <!-- ACTION -->
                                <button type="button"
                                        class="view-patient-btn"
                                        onclick="loadPatient(@item.TestRequestItemId)">
                                    <i class="fa-solid fa-user-doctor"></i>
                                    View patient
                                </button>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="av-empty">
                            <i class="fa-solid fa-vials"></i>
                            <h3>No available tests</h3>
                            <p>There are currently no laboratory tests waiting to be processed.</p>
                        </div>
                    }

                    <div class="av-empty" id="noMatches" style="display:none;">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <h3>No tests match your filters</h3>
                        <p>Try a different search term or urgency.</p>
                    </div>

                </div>

            </div>

        </section>


        <!-- PATIENT DETAILS -->
        <section class="av-panel av-sticky">

            <div class="av-panel-head">
                <h2 class="av-panel-title">
                    <i class="fa-solid fa-file-medical"></i>
                    Patient requisition
                </h2>
            </div>

            <div id="patientPanel">

                <div class="select-message">

                    <div class="select-icon">
                        <i class="fa-solid fa-file-medical"></i>
                    </div>

                    <h3>Select a test</h3>

                    <p>
                        Choose "View patient" on a laboratory test
                        to see the patient and test information.
                    </p>

                </div>

            </div>

        </section>

    </div>

</div>


<!-- START TEST FORM -->
<form id="startTestForm"
      asp-controller="AvailableTests"
      asp-action="StartTest"
      method="post"
      style="display:none;">

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="startTestId"
           name="id" />

</form>


<!-- START PROCESSING CONFIRMATION -->
<div id="processingModal" class="av-modal" role="dialog" aria-modal="true" aria-labelledby="modalTitle">

    <div class="av-modal-box">

        <div class="av-modal-icon">
            <i class="fa-solid fa-flask-vial"></i>
        </div>

        <h3 id="modalTitle">Start laboratory test?</h3>

        <p>
            This test will be assigned to you and the required
            consumables will be deducted from stock.
        </p>

        <div class="av-modal-actions">

            <button type="button"
                    class="av-btn-secondary"
                    onclick="closeProcessingModal()">
                Cancel
            </button>

            <button type="button"
                    class="av-btn-primary"
                    onclick="confirmStartProcessing()">
                <i class="fa-solid fa-play"></i>
                Start processing
            </button>

        </div>

    </div>

</div>


<style>

    :root {
        --av-primary: #0f9488;
        --av-primary-dark: #0b7a70;
        --av-primary-deep: #0a5f58;
        --av-primary-light: #e1f3f0;
        --av-soft: #f2f8f7;
        --av-border: #dbe9e7;
        --av-text: #12302f;
        --av-muted: #6f8584;
        --av-bg: #eaf1f1;
        --av-red: #a32626;
        --av-red-light: #fde8e8;
        --av-red-border: #f5c6c6;
        --av-gold: #8f5a00;
        --av-gold-light: #fff3dc;
        --av-gold-border: #f3d9a0;
        --av-green: #17814a;
        --av-green-light: #e4f6ec;
    }


    .available-page,
    .av-modal {
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        color: var(--av-text);
        -webkit-font-smoothing: antialiased;
    }

    .available-page {
        width: 100%;
        padding: 28px 32px 48px;
        background: var(--av-bg);
        min-height: 100vh;
        overflow-x: hidden;
    }

        .available-page *,
        .available-page *::before,
        .available-page *::after,
        .av-modal *,
        .av-modal *::before,
        .av-modal *::after {
            box-sizing: border-box;
        }


    /* BANNER */

    .av-banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .av-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .av-banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .av-banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
    }

    .av-banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .av-banner-stats {
        display: flex;
        align-items: center;
        gap: 34px;
        flex-wrap: wrap;
    }

    .av-banner-stat {
        text-align: center;
    }

        .av-banner-stat strong {
            display: block;
            font-size: 24px;
            font-weight: 800;
            line-height: 1.1;
        }

        .av-banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }


    /* LAYOUT */

    .av-grid {
        display: grid;
        grid-template-columns: minmax(0, 1.5fr) minmax(0, 1fr);
        gap: 24px;
        align-items: start;
    }

    .av-panel {
        min-width: 0;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
        overflow: hidden;
    }

    .av-sticky {
        position: sticky;
        top: 16px;
    }

    .av-panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        padding: 22px 32px;
        border-bottom: 1px solid var(--av-border);
    }

    .av-panel-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        color: var(--av-text);
    }

        .av-panel-title i {
            color: var(--av-primary);
            font-size: 18px;
        }

    .av-count-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--av-primary-light);
        color: var(--av-primary-dark);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .av-panel-body {
        padding: 22px 32px 12px;
    }


    /* SEARCH + FILTER */

    .av-filter-bar {
        display: flex;
        gap: 12px;
        margin-bottom: 14px;
        flex-wrap: wrap;
    }

    .av-search {
        position: relative;
        flex: 1 1 260px;
        min-width: 0;
    }

        .av-search i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--av-muted);
            font-size: 14px;
        }

        .av-search input {
            width: 100%;
            border: 1px solid var(--av-border);
            border-radius: 14px;
            padding: 13px 16px 13px 42px;
            outline: none;
            font: inherit;
            font-size: 14px;
            font-weight: 500;
            background: var(--av-soft);
            color: var(--av-text);
            transition: border-color .15s ease, box-shadow .15s ease, background .15s ease;
        }

            .av-search input::placeholder {
                color: #8aa09f;
            }

            .av-search input:focus {
                background: #fff;
                border-color: var(--av-primary);
                box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
            }

    .av-select {
        position: relative;
        flex: 0 0 190px;
    }

        .av-select i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: var(--av-primary);
            font-size: 13px;
            pointer-events: none;
        }

        .av-select select {
            width: 100%;
            border: 1px solid var(--av-border);
            border-radius: 14px;
            padding: 13px 14px 13px 40px;
            outline: none;
            font: inherit;
            font-size: 14px;
            font-weight: 600;
            background: var(--av-soft);
            color: var(--av-text);
            cursor: pointer;
        }

            .av-select select:focus {
                background: #fff;
                border-color: var(--av-primary);
                box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
            }


    /* TEST ROWS */

    .test-row {
        display: flex;
        align-items: center;
        gap: 18px;
        padding: 20px 14px;
        margin: 0 -14px;
        border-bottom: 1px solid #edf3f2;
        border-radius: 16px;
        transition: background .15s ease;
    }

        .test-row:last-of-type {
            border-bottom: 0;
        }

        .test-row:hover {
            background: var(--av-soft);
        }

        .test-row.selected {
            background: var(--av-primary-light);
        }

    .tube {
        width: 50px;
        height: 50px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 11px;
        font-weight: 800;
        letter-spacing: .02em;
    }

        .tube.violet { background: #eeeafa; color: #675b91; }
        .tube.gold   { background: #faf1d7; color: #8f6a00; }
        .tube.blue   { background: #e4eff7; color: #36668a; }
        .tube.green  { background: #e3f1ea; color: #3d7058; }

    .test-information {
        flex: 1;
        min-width: 0;
    }

    .test-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 12px;
    }

        .test-title strong {
            font-size: 15px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

    .urgency {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

        .urgency.urgent {
            color: var(--av-red);
            background: var(--av-red-light);
        }

        .urgency.high {
            color: var(--av-gold);
            background: var(--av-gold-light);
        }

        .urgency.routine {
            color: var(--av-primary-dark);
            background: var(--av-primary-light);
        }

    .patient-line {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 8px;
        margin-top: 8px;
        color: var(--av-text);
        font-size: 13.5px;
        font-weight: 600;
    }

        .patient-line > i {
            color: var(--av-primary);
        }

    .request-tag {
        padding: 3px 10px;
        border-radius: 8px;
        background: var(--av-primary-light);
        color: var(--av-primary-dark);
        font-size: 12px;
        font-weight: 700;
    }

    .test-details {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 18px;
        margin-top: 10px;
        color: var(--av-muted);
        font-size: 12.5px;
        font-weight: 500;
    }

        .test-details i {
            color: var(--av-primary);
            margin-right: 6px;
            font-size: 12px;
        }

    .view-patient-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        flex-shrink: 0;
        padding: 11px 18px;
        border: 0;
        border-radius: 12px;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font: inherit;
        font-size: 13px;
        font-weight: 700;
        white-space: nowrap;
        cursor: pointer;
        box-shadow: 0 6px 16px rgba(10, 95, 88, .28);
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .view-patient-btn:hover {
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(10, 95, 88, .34);
        }

        .view-patient-btn:focus-visible,
        .start-button:focus-visible,
        .av-btn-primary:focus-visible,
        .av-btn-secondary:focus-visible {
            outline: 2px solid var(--av-primary-deep);
            outline-offset: 3px;
        }


    /* EMPTY */

    .av-empty {
        text-align: center;
        padding: 56px 20px;
        color: var(--av-muted);
    }

        .av-empty i {
            display: block;
            font-size: 38px;
            color: #9ccdc6;
            margin-bottom: 16px;
        }

        .av-empty h3 {
            margin: 0 0 8px;
            color: var(--av-primary-deep);
            font-size: 17px;
            font-weight: 800;
        }

        .av-empty p {
            margin: 0;
            font-size: 13.5px;
        }


    /* PATIENT PANEL */

    .select-message {
        padding: 70px 30px;
        text-align: center;
        color: var(--av-muted);
    }

    .select-icon {
        width: 68px;
        height: 68px;
        margin: 0 auto 18px;
        border-radius: 50%;
        background: var(--av-primary-light);
        color: var(--av-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

    .select-message h3 {
        color: var(--av-text);
        margin: 0 0 8px;
        font-size: 17px;
        font-weight: 800;
    }

    .select-message p {
        font-size: 13.5px;
        line-height: 1.65;
        margin: 0;
    }

    .patient-content {
        padding: 24px 32px 30px;
        max-height: calc(100vh - 150px);
        overflow-y: auto;
    }

    .patient-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        padding: 18px;
        margin-bottom: 8px;
        background: var(--av-soft);
        border: 1px solid var(--av-border);
        border-radius: 18px;
    }

        .patient-header small {
            display: block;
            margin-bottom: 4px;
            color: var(--av-muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .patient-header h2 {
            margin: 0;
            font-size: 18px;
            font-weight: 800;
            color: var(--av-primary-deep);
            overflow-wrap: anywhere;
        }

    .avatar {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #d9c27a;
        color: var(--av-primary-deep);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 15px;
    }

    .detail-section,
    .consumables-section {
        padding: 20px 0 4px;
    }

        .detail-section h4,
        .consumables-section h4 {
            display: flex;
            align-items: center;
            gap: 10px;
            margin: 0 0 14px;
            color: var(--av-primary-deep);
            font-size: 13px;
            font-weight: 800;
        }

            .detail-section h4 i,
            .consumables-section h4 i {
                color: var(--av-primary);
            }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }

    .detail-item {
        min-width: 0;
        padding: 13px 15px;
        background: #fff;
        border: 1px solid var(--av-border);
        border-radius: 14px;
    }

        .detail-item small {
            display: block;
            color: var(--av-muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            margin-bottom: 6px;
        }

        .detail-item span {
            display: block;
            font-size: 13.5px;
            font-weight: 700;
            color: var(--av-primary-deep);
            overflow-wrap: anywhere;
        }

    .clinical-item {
        padding: 13px 15px;
        border: 1px solid transparent;
        border-radius: 14px;
        margin-bottom: 10px;
        font-size: 13.5px;
        font-weight: 500;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

        .clinical-item strong {
            display: block;
            margin-bottom: 3px;
            font-size: 12.5px;
            font-weight: 800;
        }

        .clinical-item.allergy {
            background: var(--av-red-light);
            border-color: var(--av-red-border);
            color: var(--av-red);
        }

        .clinical-item.condition {
            background: var(--av-gold-light);
            border-color: var(--av-gold-border);
            color: var(--av-gold);
        }

        .clinical-item.medication {
            background: var(--av-primary-light);
            border-color: #c5e4df;
            color: var(--av-primary-dark);
        }

    .doctor-note {
        margin: 0;
        padding: 15px 17px;
        background: var(--av-soft);
        border: 1px solid var(--av-border);
        border-left: 4px solid var(--av-primary);
        border-radius: 14px;
        font-size: 13.5px;
        font-weight: 500;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }


    /* CONSUMABLES */

    .stock-summary {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 13px 15px;
        border-radius: 14px;
        margin-bottom: 12px;
        font-size: 13px;
        font-weight: 700;
    }

        .stock-summary.available {
            background: var(--av-green-light);
            color: var(--av-green);
        }

        .stock-summary.unavailable {
            background: var(--av-red-light);
            color: var(--av-red);
        }

    .consumable-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .consumable-item {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        padding: 13px 15px;
        border: 1px solid var(--av-border);
        border-radius: 14px;
        background: #fff;
    }

    .consumable-info {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
    }

    .consumable-icon {
        width: 38px;
        height: 38px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: var(--av-primary-light);
        color: var(--av-primary);
    }

    .consumable-name {
        font-size: 13.5px;
        font-weight: 700;
        color: var(--av-text);
    }

    .consumable-quantity {
        margin-top: 3px;
        font-size: 12px;
        font-weight: 500;
        color: var(--av-muted);
    }

        .consumable-quantity strong {
            color: var(--av-text);
        }

    .stock-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 12px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 700;
        white-space: nowrap;
    }

        .stock-status.available {
            background: var(--av-green-light);
            color: var(--av-green);
        }

        .stock-status.unavailable {
            background: var(--av-red-light);
            color: var(--av-red);
        }

    .start-button {
        width: 100%;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
        padding: 15px;
        border: 0;
        border-radius: 14px;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font: inherit;
        font-size: 14px;
        font-weight: 800;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(10, 95, 88, .28);
        transition: transform .15s ease, box-shadow .15s ease;
    }

        .start-button:hover:not(:disabled) {
            transform: translateY(-1px);
            box-shadow: 0 11px 24px rgba(10, 95, 88, .34);
        }

        .start-button:disabled {
            background: #b8c6c5;
            box-shadow: none;
            cursor: not-allowed;
        }


    /* MODAL */

    .av-modal {
        display: none;
        position: fixed;
        inset: 0;
        z-index: 999999;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(7, 40, 38, .55);
    }

    .av-modal-box {
        width: 100%;
        max-width: 440px;
        padding: 34px 32px 30px;
        text-align: center;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 24px 60px rgba(0, 0, 0, .28);
    }

    .av-modal-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 18px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font-size: 25px;
        box-shadow: 0 8px 18px rgba(10, 95, 88, .28);
    }

    .av-modal-box h3 {
        margin: 0 0 10px;
        font-size: 20px;
        font-weight: 800;
        color: var(--av-text);
    }

    .av-modal-box p {
        margin: 0 0 26px;
        font-size: 14px;
        line-height: 1.65;
        color: var(--av-muted);
    }

    .av-modal-actions {
        display: flex;
        justify-content: center;
        gap: 12px;
    }

    .av-btn-secondary,
    .av-btn-primary {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 12px;
        font: inherit;
        font-size: 13.5px;
        font-weight: 700;
        cursor: pointer;
    }

    .av-btn-secondary {
        border: 1px solid var(--av-border);
        background: #fff;
        color: var(--av-text);
    }

        .av-btn-secondary:hover {
            background: var(--av-soft);
        }

    .av-btn-primary {
        border: 0;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        box-shadow: 0 6px 16px rgba(10, 95, 88, .28);
    }


    /* RESPONSIVE */

    @@media (max-width: 1100px) {

        .av-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .av-sticky {
            position: static;
        }

        .patient-content {
            max-height: none;
        }
    }

    @@media (max-width: 650px) {

        .available-page {
            padding: 16px 12px 32px;
        }

        .av-banner {
            padding: 20px;
        }

        .av-banner h1 {
            font-size: 20px;
        }

        .av-panel-head,
        .av-panel-body,
        .patient-content {
            padding-left: 20px;
            padding-right: 20px;
        }

        .test-row {
            flex-wrap: wrap;
            align-items: flex-start;
        }

        .view-patient-btn {
            width: 100%;
            justify-content: center;
        }

        .test-title {
            flex-direction: column;
            align-items: flex-start;
        }

        .av-select {
            flex: 1 1 100%;
        }

        .detail-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (prefers-reduced-motion: reduce) {

        .available-page *,
        .av-modal * {
            transition: none !important;
        }
    }

</style>


@section Scripts {

    <script>

        let selectedTestId = 0;


        // Escape values returned from the server before inserting into HTML.
        function esc(value) {

            if (value === null || value === undefined) {
                return "";
            }

            return String(value)
                .replace(/&/g, "&amp;")
                .replace(/</g, "&lt;")
                .replace(/>/g, "&gt;")
                .replace(/"/g, "&quot;")
                .replace(/'/g, "&#39;");
        }


        // =========================================================
        // SEARCH + URGENCY FILTER
        // =========================================================

        const searchInput = document.getElementById("testSearch");
        const urgencyFilter = document.getElementById("urgencyFilter");
        const noMatches = document.getElementById("noMatches");

        function filterTests() {

            const search =
                searchInput.value.toLowerCase().trim();

            const selectedUrgency =
                urgencyFilter.value.toLowerCase();

            const rows =
                document.querySelectorAll(".test-row");

            let visible = 0;

            rows.forEach(row => {

                const searchText =
                    row.dataset.search.toLowerCase();

                const rowUrgency =
                    (row.dataset.urgency || "Routine").toLowerCase();

                const matchesSearch =
                    searchText.includes(search);

                const matchesUrgency =
                    selectedUrgency === "all" ||
                    rowUrgency === selectedUrgency;

                if (matchesSearch && matchesUrgency) {
                    row.style.display = "";
                    visible++;
                }
                else {
                    row.style.display = "none";
                }

            });

            document.getElementById("testCount").innerText =
                visible + (visible === 1 ? " test" : " tests");

            if (noMatches) {
                noMatches.style.display =
                    (rows.length > 0 && visible === 0) ? "block" : "none";
            }
        }

        searchInput.addEventListener("input", filterTests);
        urgencyFilter.addEventListener("change", filterTests);


        // =========================================================
        // LOAD PATIENT
        // =========================================================

        function loadPatient(id) {

            selectedTestId = id;

            document.querySelectorAll(".test-row").forEach(row => {
                row.classList.remove("selected");
            });

            const selectedRow =
                document.querySelector(
                    '.test-row[data-test-id="' + id + '"]'
                );

            if (selectedRow) {
                selectedRow.classList.add("selected");
            }

            const panel =
                document.getElementById("patientPanel");

            panel.innerHTML = `

                <div class="select-message">

                    <div class="select-icon">
                        <i class="fa-solid fa-spinner fa-spin"></i>
                    </div>

                    <h3>Loading patient...</h3>

                    <p>Please wait.</p>

                </div>

            `;

            fetch(
                '@Url.Action("GetPatient", "AvailableTests")?id=' + id
            )
                .then(response => {

                    if (!response.ok) {
                        throw new Error(
                            "Unable to retrieve patient information."
                        );
                    }

                    return response.json();

                })
                .then(data => {

                    const patient = data.patient || {};
                    const test = data.test || {};
                    const consumables = data.consumables || [];

                    const allConsumablesAvailable =
                        data.allConsumablesAvailable === true;


                    // PATIENT NAME + INITIALS

                    const fullName =
                        `${patient.name || ""} ${patient.surname || ""}`.trim()
                        || "Unknown Patient";

                    const initials =
                        fullName
                            .split(" ")
                            .filter(Boolean)
                            .map(x => x.charAt(0))
                            .slice(0, 2)
                            .join("")
                            .toUpperCase();


                    // CONSUMABLE LIST

                    let consumableHtml = "";

                    if (consumables.length === 0) {

                        consumableHtml = `

                            <div class="stock-summary available">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>No consumables are required for this test.</span>
                            </div>

                        `;

                    }
                    else {

                        consumableHtml = consumables.map(c => {

                            const available = c.isAvailable === true;

                            return `

                                <div class="consumable-item">

                                    <div class="consumable-info">

                                        <div class="consumable-icon">
                                            <i class="fa-solid fa-box"></i>
                                        </div>

                                        <div>
                                            <div class="consumable-name">
                                                ${esc(c.name || "Unknown Consumable")}
                                            </div>

                                            <div class="consumable-quantity">
                                                Required: <strong>${esc(c.required)}</strong>
                                                &nbsp;|&nbsp;
                                                In stock: <strong>${esc(c.available)}</strong>
                                            </div>
                                        </div>

                                    </div>

                                    <div class="stock-status ${available ? "available" : "unavailable"}">
                                        <i class="fa-solid ${available ? "fa-circle-check" : "fa-circle-xmark"}"></i>
                                        ${available ? "Available" : "Insufficient"}
                                    </div>

                                </div>

                            `;

                        }).join("");

                    }


                    // STOCK SUMMARY

                    let stockSummaryHtml = "";

                    if (consumables.length > 0 && allConsumablesAvailable) {

                        stockSummaryHtml = `

                            <div class="stock-summary available">
                                <i class="fa-solid fa-circle-check"></i>
                                <span>All required consumables are available.</span>
                            </div>

                        `;

                    }
                    else if (consumables.length > 0) {

                        stockSummaryHtml = `

                            <div class="stock-summary unavailable">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span>
                                    One or more required consumables are insufficient.
                                    This test cannot be started.
                                </span>
                            </div>

                        `;

                    }


                    // START BUTTON

                    const startButtonHtml =
                        allConsumablesAvailable

                            ? `
                                <button type="button"
                                        class="start-button"
                                        onclick="startProcessing()">
                                    <i class="fa-solid fa-play"></i>
                                    Begin processing
                                </button>
                            `

                            : `
                                <button type="button"
                                        class="start-button"
                                        disabled>
                                    <i class="fa-solid fa-lock"></i>
                                    Cannot begin processing
                                </button>
                            `;


                    // DISPLAY PATIENT PANEL

                    panel.innerHTML = `

                        <div class="patient-content">

                            <div class="patient-header">

                                <div>
                                    <small>Request #${esc(test.requestId ?? "-")}</small>
                                    <h2>${esc(fullName)}</h2>
                                </div>

                                <div class="avatar">${esc(initials)}</div>

                            </div>


                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-user"></i>
                                    Patient information
                                </h4>

                                <div class="detail-grid">

                                    <div class="detail-item">
                                        <small>ID number</small>
                                        <span>${esc(patient.idNumber || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Cellphone</small>
                                        <span>${esc(patient.cellphone || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Email</small>
                                        <span>${esc(patient.email || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Address</small>
                                        <span>${esc(patient.address || "-")}</span>
                                    </div>

                                </div>

                            </div>


                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-flask-vial"></i>
                                    Laboratory test
                                </h4>

                                <div class="detail-grid">

                                    <div class="detail-item">
                                        <small>Test</small>
                                        <span>${esc(test.name || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Category</small>
                                        <span>${esc(test.category || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Sample</small>
                                        <span>${esc(test.sample || "-")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Turnaround</small>
                                        <span>${esc(test.turnaround ?? "-")} minutes</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Urgency</small>
                                        <span>${esc(test.urgency || "Routine")}</span>
                                    </div>

                                    <div class="detail-item">
                                        <small>Status</small>
                                        <span>${esc(test.status || "Submitted")}</span>
                                    </div>

                                </div>

                            </div>


                            <div class="consumables-section">

                                <h4>
                                    <i class="fa-solid fa-boxes-stacked"></i>
                                    Required consumables
                                </h4>

                                ${stockSummaryHtml}

                                <div class="consumable-list">
                                    ${consumableHtml}
                                </div>

                            </div>


                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-notes-medical"></i>
                                    Clinical information
                                </h4>

                                <div class="clinical-item allergy">
                                    <strong>Allergies</strong>
                                    ${esc(patient.allergies || "None recorded")}
                                </div>

                                <div class="clinical-item condition">
                                    <strong>Medical conditions</strong>
                                    ${esc(patient.conditions || "None recorded")}
                                </div>

                                <div class="clinical-item medication">
                                    <strong>Medication</strong>
                                    ${esc(patient.medication || "None recorded")}
                                </div>

                            </div>


                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-file-lines"></i>
                                    Doctor's notes
                                </h4>

                                <p class="doctor-note">
                                    ${esc(patient.notes || "No clinical notes recorded.")}
                                </p>

                            </div>


                            ${startButtonHtml}

                        </div>

                    `;

                })
                .catch(error => {

                    console.error(error);

                    panel.innerHTML = `

                        <div class="select-message">

                            <div class="select-icon"
                                 style="background:#fde8e8;color:#a32626;">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                            </div>

                            <h3>Unable to load patient</h3>

                            <p>Please try selecting the test again.</p>

                        </div>

                    `;

                });

        }


        // =========================================================
        // START PROCESSING
        // =========================================================

        function startProcessing() {

            if (!selectedTestId || selectedTestId === 0) {
                alert("Please select a laboratory test first.");
                return;
            }

            document.getElementById("processingModal").style.display = "flex";
        }

        function closeProcessingModal() {
            document.getElementById("processingModal").style.display = "none";
        }

        function confirmStartProcessing() {

            document.getElementById("processingModal").style.display = "none";
            document.getElementById("startTestId").value = selectedTestId;
            document.getElementById("startTestForm").submit();
        }

        // Close the popup when the dark background is clicked.
        document.getElementById("processingModal").addEventListener("click", function (event) {

            if (event.target === this) {
                closeProcessingModal();
            }
        });

        // Close the popup with the Escape key.
        document.addEventListener("keydown", function (event) {

            if (event.key === "Escape") {
                closeProcessingModal();
            }
        });

    </script>

}