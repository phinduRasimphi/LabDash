@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Available Laboratory Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var tests = Model?.ToList() ?? new List<LabDash.Models.TestRequestItem>();

    Func<string, (string Cls, string Label)> GetTube = category =>
    {
        if (category == "Hematology")
            return ("violet", "LAV");

        if (category == "Chemistry")
            return ("gold", "SST");

        if (category == "Coagulation")
            return ("blue", "CIT");

        if (category == "Microbiology")
            return ("green", "MSU");

        return ("violet", "GEN");
    };
}

<div class="available-page">

    <!-- HEADER -->
    <div class="available-header">

        <div class="header-icon">
            <i class="fa-solid fa-flask-vial"></i>
        </div>

        <div>
            <h1>Available Laboratory Tests</h1>
            <p>Select a laboratory test to view the patient record and begin processing.</p>
        </div>

    </div>


    <!-- SUMMARY CARDS -->
    <div class="summary-grid">

        <div class="summary-card">
            <div>
                <span>Total Available</span>
                <strong>@tests.Count</strong>
            </div>

            <div class="summary-icon teal">
                <i class="fa-solid fa-vials"></i>
            </div>
        </div>


        <div class="summary-card">
            <div>
                <span>Urgent</span>
                <strong class="red">
                    @tests.Count(x =>
                        x.TestRequest != null &&
                        (
                            x.TestRequest.Urgency == "Urgent" ||
                            x.TestRequest.Urgency == "STAT"
                        ))
                </strong>
            </div>

            <div class="summary-icon red">
                <i class="fa-solid fa-bell"></i>
            </div>
        </div>


        <div class="summary-card">
            <div>
                <span>Today's Requests</span>
                <strong class="gold">
                    @tests.Count(x =>
                        x.TestRequest != null &&
                        x.TestRequest.RequestDate.Date == DateTime.Today)
                </strong>
            </div>

            <div class="summary-icon gold">
                <i class="fa-solid fa-calendar-day"></i>
            </div>
        </div>


        <div class="summary-card">
            <div>
                <span>Waiting to Start</span>
                <strong class="teal">@tests.Count</strong>
            </div>

            <div class="summary-icon teal">
                <i class="fa-solid fa-hourglass-start"></i>
            </div>
        </div>

    </div>


    <!-- SEARCH -->
    <div class="search-box">

        <i class="fa-solid fa-magnifying-glass"></i>

        <input type="text"
               id="testSearch"
               placeholder="Search by patient, request number or test name..." />

    </div>


    <!-- MAIN CONTENT -->
    <div class="content-grid">

        <!-- AVAILABLE TESTS -->
        <div class="tests-card">

            <div class="card-header">

                <div>
                    <i class="fa-solid fa-list-check"></i>
                    Available Tests
                </div>

                <span id="testCount">@tests.Count tests</span>

            </div>


            <div id="testList">

                @if (tests.Any())
                {
                    <div style="background:red;color:white;padding:20px;font-size:20px;">
                        TEST DISPLAY CHECK - THERE ARE @tests.Count TESTS
                    </div>
                    foreach (var item in tests)
                    {
                        var testName = item.TestType?.Name ?? "Unknown Test";
                        var category = item.TestType?.Category ?? "Laboratory";
                        var sample = item.TestType?.RequiredSampleType ?? "Not specified";
                        var turnaround = item.TestType?.TurnaroundTimeHours ?? 0;

                        var patientName = "Unknown Patient";

                        if (item.TestRequest?.Patient != null)
                        {
                            patientName =
                                $"{item.TestRequest.Patient.Name} {item.TestRequest.Patient.Surname}";
                        }

                        var urgency = item.TestRequest?.Urgency ?? "Routine";

                        var urgencyClass =
                            urgency == "Urgent" || urgency == "STAT"
                                ? "urgent"
                                : urgency == "High"
                                    ? "high"
                                    : "routine";

                        var urgencyIcon =
                            urgency == "Urgent" || urgency == "STAT"
                                ? "fa-bell"
                                : urgency == "High"
                                    ? "fa-triangle-exclamation"
                                    : "fa-circle-check";

                        var tube = GetTube(category);

                        <div class="test-row"
                             data-test-id="@item.TestRequestItemId"
                             data-search="@($"{patientName} {testName} {item.RequestId} {category}")">

                            <!-- TUBE -->
                            <div class="tube @tube.Cls">
                                @tube.Label
                            </div>


                            <!-- TEST INFORMATION -->
                            <div class="test-information">

                                <div class="test-title">

                                    <strong>
                                        @testName
                                    </strong>

                                    <span class="urgency @urgencyClass">

                                        <i class="fa-solid @urgencyIcon"></i>

                                        @urgency

                                    </span>

                                </div>


                                <div class="patient-line">

                                    <i class="fa-solid fa-user"></i>

                                    @patientName

                                    <span>•</span>

                                    Request #@item.RequestId

                                </div>


                                <div class="test-details">

                                    <span>
                                        <i class="fa-solid fa-vial"></i>
                                        @sample
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-layer-group"></i>
                                        @category
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-clock"></i>
                                        @turnaround hours
                                    </span>

                                    <span>
                                        <i class="fa-solid fa-circle"></i>
                                        @item.Status
                                    </span>

                                </div>

                            </div>


                            <!-- ACTION -->
                            <button type="button"
                                    class="view-patient-btn"
                                    onclick="loadPatient(@item.TestRequestItemId)">

                                <i class="fa-solid fa-user-doctor"></i>

                                View Patient

                            </button>

                        </div>
                    }
                }
                else
                {
                    <div class="empty-state">

                        <i class="fa-solid fa-vials"></i>

                        <h3>No Available Tests</h3>

                        <p>
                            There are currently no laboratory tests waiting to be processed.
                        </p>

                    </div>
                }

            </div>

        </div>


        <!-- PATIENT DETAILS -->
        <div class="patient-card">

            <div class="card-header">

                <div>
                    <i class="fa-solid fa-file-medical"></i>
                    Patient Requisition
                </div>

            </div>


            <div id="patientPanel">

                <div class="select-message">

                    <div class="select-icon">
                        <i class="fa-solid fa-file-medical"></i>
                    </div>

                    <h3>Select a test</h3>

                    <p>
                        Select "View Patient" on a laboratory test
                        to view the patient and test information.
                    </p>

                </div>

            </div>

        </div>

    </div>

</div>


<!-- START TEST FORM -->
<form id="startTestForm"
      asp-controller="AvailableTests"
      asp-action="StartTest"
      method="post"
      style="display:none;">

    @Html.AntiForgeryToken()

    <input type="hidden"
           id="startTestId"
           name="id" />

</form>


<style>

    :root {
        --av-primary: #0d766e;
        --av-primary-dark: #095a54;
        --av-primary-light: #e7f5f3;
        --av-text: #1f2937;
        --av-muted: #6b7280;
        --av-border: #e5e7eb;
        --av-bg: #f5f7fa;
        --av-card: #ffffff;
        --av-red: #dc3545;
        --av-red-light: #fbe9ea;
        --av-gold: #b98900;
        --av-gold-light: #fbf2dc;
    }


    .available-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 25px 20px 60px;
        font-family: "Segoe UI", Arial, sans-serif;
        color: var(--av-text);
    }


    /* HEADER */

    .available-header {
        background: linear-gradient(135deg, #0d766e, #0a5d57);
        color: white;
        border-radius: 18px;
        padding: 28px 32px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }


    .header-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
    }


    .available-header h1 {
        margin: 0 0 5px;
        font-size: 27px;
        font-weight: 700;
    }


    .available-header p {
        margin: 0;
        font-size: 14px;
        opacity: .9;
    }


    /* SUMMARY */

    .summary-grid {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 16px;
        margin-bottom: 20px;
    }


    .summary-card {
        background: white;
        border: 1px solid var(--av-border);
        border-radius: 16px;
        padding: 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 4px 18px rgba(0,0,0,.04);
    }


        .summary-card span {
            display: block;
            font-size: 12px;
            color: var(--av-muted);
            margin-bottom: 5px;
        }


        .summary-card strong {
            font-size: 28px;
            color: var(--av-primary);
        }


            .summary-card strong.red {
                color: var(--av-red);
            }


            .summary-card strong.gold {
                color: var(--av-gold);
            }


            .summary-card strong.teal {
                color: var(--av-primary);
            }


    .summary-icon {
        width: 45px;
        height: 45px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 19px;
    }


        .summary-icon.teal {
            background: var(--av-primary-light);
            color: var(--av-primary);
        }


        .summary-icon.red {
            background: var(--av-red-light);
            color: var(--av-red);
        }


        .summary-icon.gold {
            background: var(--av-gold-light);
            color: var(--av-gold);
        }


    /* SEARCH */

    .search-box {
        background: white;
        border: 1px solid var(--av-border);
        border-radius: 14px;
        padding: 13px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
        margin-bottom: 20px;
    }


        .search-box > i {
            color: var(--av-muted);
        }


        .search-box input {
            border: none;
            outline: none;
            width: 100%;
            font-size: 14px;
            color: var(--av-text);
        }


    /* GRID */

    .content-grid {
        display: grid;
        grid-template-columns: 1.5fr 1fr;
        gap: 20px;
        align-items: start;
    }


    .tests-card,
    .patient-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--av-border);
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
    }


    /* CARD HEADER */

    .card-header {
        background: linear-gradient(135deg, #0d766e, #0a5d57);
        color: white;
        padding: 17px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 600;
        font-size: 15px;
    }


        .card-header i {
            margin-right: 8px;
        }


        .card-header span {
            background: rgba(255,255,255,.18);
            padding: 5px 11px;
            border-radius: 30px;
            font-size: 12px;
        }


    /* TEST ROW */

    .test-row {
        padding: 18px 20px;
        border-bottom: 1px solid #edf0f2;
        display: flex;
        align-items: center;
        gap: 15px;
        transition: .15s;
    }


        .test-row:last-child {
            border-bottom: none;
        }


        .test-row:hover {
            background: #f1faf8;
        }


    .tube {
        width: 46px;
        height: 46px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 10px;
        font-weight: 700;
    }


        .tube.violet {
            background: #eeeafa;
            color: #675b91;
        }


        .tube.gold {
            background: #faf1d7;
            color: #a47800;
        }


        .tube.blue {
            background: #e8f0f6;
            color: #3e6c8c;
        }


        .tube.green {
            background: #e7f0eb;
            color: #46745f;
        }


    .test-information {
        flex: 1;
        min-width: 0;
    }


    .test-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }


        .test-title strong {
            font-size: 15px;
        }


    .urgency {
        padding: 4px 9px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
    }


        .urgency.urgent {
            color: var(--av-red);
            background: var(--av-red-light);
        }


        .urgency.high {
            color: var(--av-gold);
            background: var(--av-gold-light);
        }


        .urgency.routine {
            color: var(--av-primary-dark);
            background: var(--av-primary-light);
        }


    .patient-line {
        margin-top: 5px;
        color: var(--av-muted);
        font-size: 13px;
    }


        .patient-line i {
            color: var(--av-primary);
            margin-right: 5px;
        }


    .test-details {
        display: flex;
        flex-wrap: wrap;
        gap: 12px;
        margin-top: 9px;
        color: var(--av-muted);
        font-size: 11.5px;
    }


        .test-details i {
            color: var(--av-primary);
            margin-right: 4px;
        }


    /* BUTTON */

    .view-patient-btn {
        border: 1px solid var(--av-primary);
        color: var(--av-primary-dark);
        background: white;
        border-radius: 30px;
        padding: 9px 13px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }


        .view-patient-btn:hover {
            background: var(--av-primary);
            color: white;
        }


    /* EMPTY */

    .empty-state {
        text-align: center;
        padding: 60px 25px;
        color: var(--av-muted);
    }


        .empty-state i {
            font-size: 38px;
            color: var(--av-primary);
            margin-bottom: 15px;
        }


        .empty-state h3 {
            margin: 0 0 7px;
            color: var(--av-text);
        }


        .empty-state p {
            margin: 0;
            font-size: 13px;
        }


    /* PATIENT PANEL */

    .select-message {
        padding: 70px 25px;
        text-align: center;
        color: var(--av-muted);
    }


    .select-icon {
        width: 65px;
        height: 65px;
        margin: 0 auto 15px;
        border-radius: 50%;
        background: var(--av-primary-light);
        color: var(--av-primary);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }


    .select-message h3 {
        color: var(--av-text);
        margin: 0 0 8px;
    }


    .select-message p {
        font-size: 13px;
        line-height: 1.6;
        margin: 0;
    }


    .patient-content {
        padding: 20px;
    }


    .patient-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }


        .patient-header small {
            display: block;
            color: var(--av-muted);
            font-size: 11px;
            margin-bottom: 4px;
        }


        .patient-header h2 {
            margin: 0;
            font-size: 20px;
        }


    .avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--av-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
    }


    .detail-section {
        border-top: 1px solid var(--av-border);
        padding: 16px 0;
    }


        .detail-section h4 {
            margin: 0 0 12px;
            color: var(--av-primary-dark);
            font-size: 12px;
            text-transform: uppercase;
        }


    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
    }


    .detail-item small {
        display: block;
        color: var(--av-muted);
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 3px;
    }


    .detail-item span {
        font-size: 13px;
        font-weight: 600;
    }


    .clinical-item {
        padding: 10px;
        border-radius: 9px;
        margin-bottom: 7px;
        font-size: 12px;
        line-height: 1.5;
    }


        .clinical-item.allergy {
            background: var(--av-red-light);
            color: #8b2e33;
        }


        .clinical-item.condition {
            background: var(--av-gold-light);
            color: #76591c;
        }


        .clinical-item.medication {
            background: var(--av-primary-light);
            color: var(--av-primary-dark);
        }


    .start-button {
        width: 100%;
        border: none;
        border-radius: 12px;
        background: var(--av-primary);
        color: white;
        padding: 14px;
        font-weight: 700;
        font-size: 14px;
        cursor: pointer;
        margin-top: 10px;
    }


        .start-button:hover {
            background: var(--av-primary-dark);
        }


    @@media (max-width: 950px) {

        .summary-grid {
            grid-template-columns: 1fr 1fr;
        }

        .content-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 650px) {

        .summary-grid {
            grid-template-columns: 1fr;
        }

        .test-row {
            align-items: flex-start;
            flex-wrap: wrap;
        }

        .view-patient-btn {
            width: 100%;
        }

        .test-title {
            align-items: flex-start;
            flex-direction: column;
        }
    }

</style>


@section Scripts {

    <script>

        let selectedTestId = 0;


        // =========================================================
        // SEARCH
        // =========================================================

        document.getElementById("testSearch").addEventListener("input", function() {

            const search = this.value.toLowerCase().trim();

            const rows = document.querySelectorAll(".test-row");

            let visible = 0;

            rows.forEach(row => {

                const text =
                    row.dataset.search.toLowerCase();

                if (text.includes(search)) {

                    row.style.display = "";
                    visible++;

                } else {

                    row.style.display = "none";

                }

            });

            document.getElementById("testCount").innerText =
                visible + (visible === 1 ? " test" : " tests");

        });


        // =========================================================
        // LOAD PATIENT
        // =========================================================

        function loadPatient(id) {

            selectedTestId = id;


            // Highlight selected row

            document.querySelectorAll(".test-row").forEach(row => {

                row.style.background = "";

            });


            const selectedRow =
                document.querySelector(
                    '.test-row[data-test-id="' + id + '"]'
                );


            if (selectedRow) {

                selectedRow.style.background = "#e7f5f3";

            }


            const panel =
                document.getElementById("patientPanel");


            panel.innerHTML = `

                    <div class="select-message">

                        <div class="select-icon">

                            <i class="fa-solid fa-spinner fa-spin"></i>

                        </div>

                        <h3>Loading patient...</h3>

                        <p>Please wait.</p>

                    </div>

                `;


            fetch(
                '@Url.Action("GetPatient", "AvailableTests")?id=' + id
            )
                .then(response => {

                    if (!response.ok) {

                        throw new Error(
                            "Unable to retrieve patient information."
                        );

                    }

                    return response.json();

                })
                .then(data => {

                    const patient = data.patient || {};
                    const test = data.test || {};


                    const fullName =
                        `${patient.name || ""} ${patient.surname || ""}`.trim()
                        || "Unknown Patient";


                    const initials =
                        fullName
                            .split(" ")
                            .filter(Boolean)
                            .map(x => x.charAt(0))
                            .slice(0, 2)
                            .join("")
                            .toUpperCase();


                    panel.innerHTML = `

                        <div class="patient-content">


                            <div class="patient-header">

                                <div>

                                    <small>
                                        REQUEST #${test.requestId ?? "-"}
                                    </small>

                                    <h2>
                                        ${fullName}
                                    </h2>

                                </div>

                                <div class="avatar">
                                    ${initials}
                                </div>

                            </div>


                            <!-- PATIENT INFORMATION -->

                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-user"></i>
                                    Patient Information
                                </h4>


                                <div class="detail-grid">

                                    <div class="detail-item">

                                        <small>ID Number</small>

                                        <span>
                                            ${patient.idNumber || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Cellphone</small>

                                        <span>
                                            ${patient.cellphone || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Email</small>

                                        <span>
                                            ${patient.email || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Address</small>

                                        <span>
                                            ${patient.address || "-"}
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- TEST -->

                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-flask-vial"></i>
                                    Laboratory Test
                                </h4>


                                <div class="detail-grid">

                                    <div class="detail-item">

                                        <small>Test</small>

                                        <span>
                                            ${test.name || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Category</small>

                                        <span>
                                            ${test.category || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Sample</small>

                                        <span>
                                            ${test.sample || "-"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Turnaround</small>

                                        <span>
                                            ${test.turnaround ?? "-"} hours
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Urgency</small>

                                        <span>
                                            ${test.urgency || "Routine"}
                                        </span>

                                    </div>


                                    <div class="detail-item">

                                        <small>Status</small>

                                        <span>
                                            ${test.status || "Submitted"}
                                        </span>

                                    </div>

                                </div>

                            </div>


                            <!-- CLINICAL INFORMATION -->

                            <div class="detail-section">

                                <h4>
                                    <i class="fa-solid fa-notes-medical"></i>
                                    Clinical Information
                                </h4>


                                <div class="clinical-item allergy">

                                    <strong>Allergies</strong><br>

                                    ${patient.allergies || "None recorded"}

                                </div>


                                <div class="clinical-item condition">

                                    <strong>Medical Conditions</strong><br>

                                    ${patient.conditions || "None recorded"}

                                </div>


                                <div class="clinical-item medication">

                                    <strong>Medication</strong><br>

                                    ${patient.medication || "None recorded"}

                                </div>

                            </div>


                            <!-- DOCTOR NOTES -->

                            <div class="detail-section">

                                <h4>

                                    <i class="fa-solid fa-file-lines"></i>

                                    Doctor's Notes

                                </h4>


                                <p style="
                                    font-size:13px;
                                    line-height:1.6;
                                    margin:0;
                                ">

                                    ${patient.notes || "No clinical notes recorded."}

                                </p>

                            </div>


                            <!-- START -->

                            <button
                                type="button"
                                class="start-button"
                                onclick="startProcessing()">

                                <i class="fa-solid fa-play"></i>

                                Begin Processing

                            </button>

                        </div>

                    `;

                })
                .catch(error => {

                    console.error(error);


                    panel.innerHTML = `

                        <div class="select-message">

                            <div class="select-icon"
                                 style="background:#fbe9ea;color:#dc3545;">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                            </div>

                            <h3>Unable to load patient</h3>

                            <p>
                                Please try selecting the test again.
                            </p>

                        </div>

                    `;

                });

        }


        // =========================================================
        // START PROCESSING
        // =========================================================

        function startProcessing() {

            if (!selectedTestId || selectedTestId === 0) {

                alert("Please select a laboratory test first.");

                return;

            }


            const confirmed =
                confirm(
                    "Start processing this laboratory test?"
                );


            if (!confirmed) {

                return;

            }


            document.getElementById("startTestId").value =
                selectedTestId;


            document.getElementById("startTestForm").submit();

        }

    </script>

}