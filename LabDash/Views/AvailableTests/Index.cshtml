@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Available Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    body {
        background: #eef7f8;
        font-family: "Segoe UI", sans-serif;
    }

    .page-container {
        max-width: 1400px;
        margin: 35px auto;
    }

    /* Alert Messages */

    .alert {
        border: none;
        border-radius: 12px;
        padding: 14px 20px;
        font-weight: 500;
        box-shadow: 0 5px 15px rgba(0,0,0,.08);
    }

        .alert i {
            margin-right: 8px;
        }

    /* Statistics */

    .stats-row {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
        margin-bottom: 25px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 25px;
        display: flex;
        align-items: center;
        gap: 18px;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .stat-icon {
        width: 70px;
        height: 70px;
        border-radius: 50%;
        background: rgba(0,150,136,.12);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
        color: #009688;
    }

    .stat-card h2 {
        margin: 0;
        color: #009688;
        font-size: 30px;
        font-weight: 700;
    }

    .stat-card p {
        margin: 4px 0 0;
        color: #777;
        font-size: 15px;
    }

    /* Main Card */

    .page-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 12px 35px rgba(0,0,0,.08);
    }

    .page-header {
        background: #009688;
        color: white;
        padding: 28px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .page-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
        }

        .page-header p {
            margin-top: 6px;
            opacity: .9;
            font-size: 16px;
        }

    .total-tests {
        background: rgba(255,255,255,.15);
        padding: 12px 22px;
        border-radius: 30px;
        font-weight: 600;
        font-size: 16px;
    }

    @@media(max-width:992px) {

        .stats-row {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }

</style>

<div class="page-container">

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger mb-4">

            <i class="fas fa-circle-exclamation"></i>

            @TempData["Error"]

        </div>
    }

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success mb-4">

            <i class="fas fa-circle-check"></i>

            @TempData["Success"]

        </div>
    }

    <!-- Statistics -->

    <div class="stats-row">

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-vials"></i>
            </div>

            <div>

                <h2>@Model.Count()</h2>

                <p>Total Available Tests</p>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-flask"></i>
            </div>

            <div>

                <h2>@Model.Select(x => x.TestType.Category).Distinct().Count()</h2>

                <p>Test Categories</p>

            </div>

        </div>

        <div class="stat-card">

            <div class="stat-icon">
                <i class="fas fa-user-doctor"></i>
            </div>

            <div>

                <h2>@Model.Select(x => x.TestRequest.RequestId).Distinct().Count()</h2>

                <p>Patient Requests</p>

            </div>

        </div>

    </div>

    <!-- Main Card -->

    <div class="page-card">

        <div class="page-header">

            <div>

                <h2>

                    <i class="fas fa-vials"></i>

                    Available Tests

                </h2>

                <p>

                    Select a laboratory test to begin processing.

                </p>

            </div>

            <div class="total-tests">

                <i class="fas fa-list-check"></i>

                @Model.Count() Available

            </div>

        </div>
                <!-- Toolbar -->

        <div class="toolbar">

            <div class="search-box">

                <i class="fas fa-search"></i>

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search request, test, category or urgency..." />

            </div>

        </div>

        <style>

            .toolbar{

                padding:22px 30px;
                border-bottom:1px solid #ececec;
                background:#fff;

            }

            .search-box{

                width:380px;
                position:relative;

            }

            .search-box i{

                position:absolute;
                left:15px;
                top:16px;
                color:#7a7a7a;

            }

            .search-box input{

                height:48px;
                border-radius:10px;
                padding-left:42px;
                border:1px solid #d8d8d8;
                transition:.25s;

            }

            .search-box input:focus{

                border-color:#009688;
                box-shadow:0 0 0 .15rem rgba(0,150,136,.15);

            }

            .table{

                margin:0;

            }

            .table thead{

                background:#00897B;
                color:white;

            }

            .table th{

                padding:18px;
                border:none;
                text-align:center;
                vertical-align:middle;
                font-size:15px;
                font-weight:600;

            }

            .table td{

                padding:18px;
                vertical-align:middle;
                text-align:center;
                border-color:#eef2f3;

            }

            .table tbody tr{

                transition:.25s;

            }

            .table tbody tr:hover{

                background:#f7fbfb;

            }

            .badge-progress{

                padding:8px 16px;
                border-radius:30px;
                font-size:13px;
                font-weight:600;

            }

            .btn-start{

                background:#009688;
                color:white;
                border:none;
                border-radius:8px;
                padding:10px 18px;
                font-weight:600;
                transition:.25s;

            }

            .btn-start:hover{

                background:#00796B;
                color:white;
                transform:translateY(-2px);

            }

            .status-badge{

                border-radius:30px;
                padding:8px 16px;
                font-size:13px;
                font-weight:600;

            }

        </style>

        <table class="table table-hover">

            <thead>

                <tr>

                    <th><i class="fas fa-clock"></i><br />Progress</th>

                    <th><i class="fas fa-file-medical"></i><br />Request</th>

                    <th><i class="fas fa-vials"></i><br />Test</th>

                    <th><i class="fas fa-layer-group"></i><br />Category</th>

                    <th><i class="fas fa-triangle-exclamation"></i><br />Urgency</th>

                    <th><i class="fas fa-circle-info"></i><br />Status</th>

                    <th><i class="fas fa-play"></i><br />Action</th>

                    <th><i class="fas fa-hourglass-half"></i><br />Expected Completion</th>

                </tr>

            </thead>

            <tbody>

@foreach (var item in Model)
{
    var expectedCompletion =
        item.StartDateTime?.AddHours(item.TestType.TurnaroundTimeHours);

    bool overdue =
        expectedCompletion.HasValue &&
        DateTime.Now > expectedCompletion.Value;

    <tr>
                        @if (overdue)
                        {
                            <td>
                                <span class="badge bg-danger badge-progress">
                                    <i class="fas fa-clock"></i>
                                    OVERDUE
                                </span>
                            </td>
                        }
                        else
                        {
                            <td>
                                <span class="badge bg-success badge-progress">
                                    <i class="fas fa-check-circle"></i>
                                    ON TIME
                                </span>
                            </td>
                        }

                        <td>
                            <strong>#@item.RequestId</strong>
                        </td>

                        <td>
                            <strong>@item.TestType.Name</strong>
                        </td>

                        <td>

                            <span class="badge bg-info text-dark status-badge">

                                @item.TestType.Category

                            </span>

                        </td>

                        <td>

                            @if (item.TestRequest.Urgency == "Urgent")
                            {
                                <span class="badge bg-danger status-badge">
                                    <i class="fas fa-bolt"></i>
                                    Urgent
                                </span>
                            }
                            else if (item.TestRequest.Urgency == "High")
                            {
                                <span class="badge bg-warning text-dark status-badge">
                                    <i class="fas fa-triangle-exclamation"></i>
                                    High
                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success status-badge">
                                    <i class="fas fa-circle-check"></i>
                                    Normal
                                </span>
                            }

                        </td>

                        <td>

                            @if (item.Status == "Pending")
                            {
                                <span class="badge bg-warning text-dark status-badge">

                                    <i class="fas fa-hourglass-half"></i>

                                    Pending

                                </span>
                            }
                            else if (item.Status == "In Progress")
                            {
                                <span class="badge bg-primary status-badge">

                                    <i class="fas fa-spinner"></i>

                                    In Progress

                                </span>
                            }
                            else
                            {
                                <span class="badge bg-success status-badge">

                                    <i class="fas fa-check-circle"></i>

                                    @item.Status

                                </span>
                            }

                        </td>

                        <td>

                            <form asp-action="StartTest"
                                  asp-route-id="@item.TestRequestItemId"
                                  method="post">

                                <button type="submit" class="btn btn-start">

                                    <i class="fas fa-play"></i>

                                    Start Test

                                </button>

                            </form>

                        </td>

                        <td>

                            @if (item.StartDateTime.HasValue)
                            {
                                var expected =
                                    item.StartDateTime.Value.AddHours(item.TestType.TurnaroundTimeHours);

                                <strong>

                                    @expected.ToString("dd MMM yyyy")

                                </strong>

                                <br />

                                <small class="text-muted">

                                    @expected.ToString("HH:mm")

                                </small>

                                <br />

                                @if (DateTime.Now < expected)
                                {
                                    var remaining = expected - DateTime.Now;

                                    <small class="text-success">

                                        <i class="fas fa-clock"></i>

                                        @remaining.Days d
                                        @remaining.Hours h
                                        @remaining.Minutes m left

                                    </small>
                                }
                                else
                                {
                                    var late = DateTime.Now - expected;

                                    <small class="text-danger">

                                        <i class="fas fa-triangle-exclamation"></i>

                                        @late.Days d
                                        @late.Hours h
                                        @late.Minutes m overdue

                                    </small>
                                }
                            }
                            else
                            {
                                <span class="text-muted">

                                    Not Started

                                </span>
                            }

                        </td>

                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr>

                        <td colspan="8" class="text-center py-5">

                            <i class="fas fa-vials fa-3x text-muted mb-3"></i>

                            <h5>No Available Tests</h5>

                            <p class="text-muted">

                                There are currently no tests available for processing.

                            </p>

                        </td>

                    </tr>
                }

            </tbody>

        </table>

    </div>

</div>

@section Scripts {

    <script>

        document.getElementById("searchInput").addEventListener("keyup", function () {

            let value = this.value.toLowerCase();

            document.querySelectorAll("tbody tr").forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                        ? ""
                        : "none";

            });

        });

    </script>

}
