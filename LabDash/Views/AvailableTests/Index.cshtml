@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Available Laboratory Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    // Maps test category to a specimen tube cap color, mirroring real
    // venipuncture tube tops so technicians recognise it at a glance.
    Func<string, (string Cls, string Label)> capFor = category => category switch
    {
        "Hematology" => ("violet", "LAV"),
        "Chemistry" => ("gold", "SST"),
        "Coagulation" => ("blue", "CIT"),
        "Microbiology" => ("green", "MSU"),
        _ => ("violet", "GEN")
    };
}

<div class="at-wrap">

    <!-- BANNER HEADER -->
    <div class="at-banner">
        <div class="at-banner-left">
            <div class="at-icon-badge">
                <i class="fa-solid fa-flask-vial"></i>
            </div>
            <div>
                <h1>Available Laboratory Tests</h1>
                <p>Select a test to pull the patient record and begin processing.</p>
            </div>
        </div>
        <a asp-action="InProgress" class="at-pill-btn">
            <i class="fa-solid fa-flask"></i> In progress
        </a>
    </div>

    <!-- STATS -->
    <div class="at-stats">
        <div class="at-stat-card">
            <div>
                <small>Total tests</small>
                <h2>@Model.Count()</h2>
            </div>
            <i class="fa-solid fa-vials at-ic-teal"></i>
        </div>
        <div class="at-stat-card">
            <div>
                <small>Urgent</small>
                <h2 class="at-red">@Model.Count(x => x.TestRequest.Urgency == "Urgent")</h2>
            </div>
            <i class="fa-solid fa-bell at-ic-red"></i>
        </div>
        <div class="at-stat-card">
            <div>
                <small>Today's requests</small>
                <h2 class="at-gold">@Model.Count(x => x.TestRequest.RequestDate.Date == DateTime.Today)</h2>
            </div>
            <i class="fa-solid fa-calendar-day at-ic-gold"></i>
        </div>
        <div class="at-stat-card">
            <div>
                <small>Available</small>
                <h2 class="at-teal">@Model.Count()</h2>
            </div>
            <i class="fa-solid fa-circle-check at-ic-teal"></i>
        </div>
    </div>

    <!-- SEARCH -->
    <div class="at-card at-search-card">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input class="at-search" id="searchBox" placeholder="scan barcode, or search patient / test..." />
    </div>

    <div class="at-layout">

        <!-- TEST LIST -->
        <div class="at-card at-list-card">
            <div class="at-card-head">
                <span><i class="fa-solid fa-list-ul"></i> Available tests</span>
                <span class="at-count-chip">@Model.Count() tests</span>
            </div>

            <div id="testContainer">
                @foreach (var item in Model)
                {
                    var cap = capFor(item.TestType.Category);
                    var urgencyCls = item.TestRequest.Urgency == "Urgent" ? "urgent"
                        : item.TestRequest.Urgency == "High" ? "high" : "routine";
                    var urgencyIcon = item.TestRequest.Urgency == "Urgent" ? "fa-bell"
                        : item.TestRequest.Urgency == "High" ? "fa-triangle-exclamation" : "fa-circle-check";

                    <div class="at-row" data-test-id="@item.TestRequestItemId" onclick="loadPatient(@item.TestRequestItemId)">
                        <div class="at-row-icon @cap.Cls">@cap.Label</div>

                        <div class="at-row-main">
                            <div class="at-row-top">
                                <strong>@item.TestType.Name</strong>
                                <span class="at-badge @urgencyCls">
                                    <i class="fa-solid @urgencyIcon"></i> @item.TestRequest.Urgency
                                </span>
                            </div>
                            <small>@item.TestRequest.Patient.Name @item.TestRequest.Patient.Surname · Request #@item.RequestId</small>

                            <div class="at-row-meta">
                                <span><i class="fa-solid fa-vial"></i> @item.TestType.RequiredSampleType</span>
                                <span><i class="fa-solid fa-tags"></i> @item.TestType.Category</span>
                                <span><i class="fa-solid fa-hourglass-half"></i> @item.TestType.TurnaroundTimeHours h</span>
                            </div>
                        </div>

                        <button type="button" class="at-view-btn" onclick="event.stopPropagation(); loadPatient(@item.TestRequestItemId)">
                            <i class="fa-solid fa-user-doctor"></i> View patient
                        </button>
                    </div>
                }
            </div>

            @if (!Model.Any())
            {
                <div class="at-empty">
                    <i class="fa-solid fa-circle-check"></i>
                    <h3>No available tests</h3>
                    <p>There are currently no laboratory requests assigned to your specialization.</p>
                </div>
            }
        </div>

        <!-- REQUISITION SLIP -->
        <div class="at-card at-slip-card">
            <div class="at-card-head">
                <span><i class="fa-solid fa-file-medical"></i> Requisition slip</span>
            </div>
            <div id="slipPanel">
                <div class="at-empty-slip">
                    <i class="fa-solid fa-file-medical"></i>
                    Select a test to pull the patient record.
                </div>
            </div>
        </div>

    </div>
</div>

<form id="startTestForm" asp-action="StartTest" method="post" style="display:none;">
    @Html.AntiForgeryToken()
    <input type="hidden" name="id" id="startTestId" value="" />
</form>

<style>
    :root {
        --at-teal: #0F9488;
        --at-teal-dark: #0B5B52;
        --at-teal-tint: #E7F5F3;
        --at-ink: #1F2937;
        --at-ink-soft: #6B7280;
        --at-line: #EEF2F1;
        --at-gold: #B98900;
        --at-gold-tint: #FBF2DC;
        --at-red: #DC3545;
        --at-red-tint: #FBE9EA;
        --at-violet: #6B5B95;
        --at-violet-tint: #EFECF6;
        --at-blue: #3E6C8C;
        --at-blue-tint: #E7EFF4;
        --at-green: #4B7B67;
        --at-green-tint: #E9F1EC;
        --at-radius: 20px;
        --at-shadow: 0 4px 20px rgba(15, 23, 42, .06);
    }

    .at-wrap {
        max-width: 1180px;
        margin: 0 auto;
        padding: 24px 0 60px;
        color: var(--at-ink);
        font-family: 'Segoe UI', Inter, sans-serif;
    }

    .at-banner {
        background: linear-gradient(135deg, var(--at-teal), var(--at-teal-dark));
        border-radius: var(--at-radius);
        padding: 30px 34px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 24px;
        color: #fff;
        box-shadow: var(--at-shadow);
    }

    .at-banner-left {
        display: flex;
        align-items: center;
        gap: 20px;
    }

    .at-icon-badge {
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(255,255,255,.15);
        border: 2px solid rgba(255,255,255,.4);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        flex-shrink: 0;
    }

    .at-banner h1 {
        margin: 0 0 6px;
        font-size: 26px;
        font-weight: 700;
    }

    .at-banner p {
        margin: 0;
        opacity: .9;
        font-size: 14.5px;
    }

    .at-pill-btn {
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.5);
        color: #fff;
        text-decoration: none;
        padding: 10px 20px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        font-weight: 600;
        font-size: 14px;
        transition: .15s;
        white-space: nowrap;
    }

        .at-pill-btn:hover {
            background: rgba(255,255,255,.28);
        }

    .at-stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 20px;
    }

    .at-stat-card {
        background: #fff;
        border-radius: var(--at-radius);
        box-shadow: var(--at-shadow);
        padding: 20px 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        transition: transform .2s, box-shadow .2s;
    }

        .at-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 26px rgba(15,23,42,.1);
        }

        .at-stat-card small {
            display: block;
            color: var(--at-ink-soft);
            font-size: 13px;
            margin-bottom: 6px;
        }

        .at-stat-card h2 {
            margin: 0;
            font-size: 26px;
            font-weight: 700;
            color: var(--at-ink);
        }

            .at-stat-card h2.at-red {
                color: var(--at-red);
            }

            .at-stat-card h2.at-gold {
                color: var(--at-gold);
            }

            .at-stat-card h2.at-teal {
                color: var(--at-teal);
            }

        .at-stat-card i {
            font-size: 30px;
            opacity: .85;
        }

    .at-ic-teal {
        color: var(--at-teal);
    }

    .at-ic-red {
        color: var(--at-red);
    }

    .at-ic-gold {
        color: var(--at-gold);
    }

    .at-card {
        background: #fff;
        border-radius: var(--at-radius);
        box-shadow: var(--at-shadow);
    }

    .at-search-card {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 22px;
        margin-bottom: 20px;
    }

        .at-search-card i {
            color: var(--at-ink-soft);
            font-size: 15px;
        }

    .at-search {
        flex: 1;
        border: none;
        outline: none;
        font-size: 15px;
        padding: 6px 0;
        color: var(--at-ink);
    }

        .at-search::placeholder {
            color: #9CA3AF;
        }

    .at-layout {
        display: grid;
        grid-template-columns: 1.4fr 1fr;
        gap: 20px;
        align-items: start;
    }

    .at-card-head {
        background: linear-gradient(135deg, var(--at-teal), var(--at-teal-dark));
        color: #fff;
        padding: 16px 22px;
        border-radius: var(--at-radius) var(--at-radius) 0 0;
        font-weight: 600;
        font-size: 15px;
        display: flex;
        justify-content: space-between;
        align-items: center;
    }

        .at-card-head i {
            margin-right: 8px;
        }

    .at-count-chip {
        background: rgba(255,255,255,.2);
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
    }

    .at-list-card, .at-slip-card {
        padding-bottom: 6px;
        overflow: hidden;
    }

    .at-row {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px 22px;
        border-bottom: 1px solid var(--at-line);
        cursor: pointer;
        transition: background .15s;
    }

        .at-row:hover {
            background: var(--at-teal-tint);
        }

        .at-row.at-selected {
            background: var(--at-teal-tint);
        }

        .at-row:last-child {
            border-bottom: none;
        }

    .at-row-icon {
        width: 42px;
        height: 42px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 10.5px;
        font-weight: 700;
        flex-shrink: 0;
    }

        .at-row-icon.violet {
            background: var(--at-violet-tint);
            color: var(--at-violet);
        }

        .at-row-icon.gold {
            background: var(--at-gold-tint);
            color: var(--at-gold);
        }

        .at-row-icon.blue {
            background: var(--at-blue-tint);
            color: var(--at-blue);
        }

        .at-row-icon.green {
            background: var(--at-green-tint);
            color: var(--at-green);
        }

    .at-row-main {
        flex: 1;
        min-width: 0;
    }

    .at-row-top {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
    }

        .at-row-top strong {
            font-size: 15.5px;
            color: var(--at-ink);
        }

    .at-row-main small {
        display: block;
        color: var(--at-ink-soft);
        font-size: 13px;
        margin: 3px 0 8px;
    }

    .at-row-meta {
        display: flex;
        gap: 16px;
        flex-wrap: wrap;
        font-size: 12.5px;
        color: var(--at-ink-soft);
    }

        .at-row-meta i {
            color: var(--at-teal);
            margin-right: 4px;
        }

    .at-badge {
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .03em;
        text-transform: uppercase;
        padding: 5px 11px;
        border-radius: 999px;
        white-space: nowrap;
    }

        .at-badge.urgent {
            background: var(--at-red-tint);
            color: var(--at-red);
        }

        .at-badge.high {
            background: var(--at-gold-tint);
            color: var(--at-gold);
        }

        .at-badge.routine {
            background: var(--at-teal-tint);
            color: var(--at-teal-dark);
        }

    .at-view-btn {
        border: 1px solid var(--at-teal);
        background: transparent;
        color: var(--at-teal-dark);
        font-weight: 600;
        font-size: 13px;
        padding: 9px 16px;
        border-radius: 999px;
        display: inline-flex;
        align-items: center;
        gap: 7px;
        cursor: pointer;
        white-space: nowrap;
        transition: .15s;
        flex-shrink: 0;
    }

        .at-view-btn:hover {
            background: var(--at-teal);
            color: #fff;
        }

    .at-empty, .at-empty-slip {
        padding: 60px 24px;
        text-align: center;
        color: var(--at-ink-soft);
    }

        .at-empty i, .at-empty-slip i {
            font-size: 34px;
            margin-bottom: 12px;
            display: block;
            color: var(--at-teal);
        }

        .at-empty h3 {
            color: var(--at-ink);
            margin: 0 0 6px;
        }

    /* SLIP CONTENT (rendered via JS) */
    .at-slip-body {
        padding: 22px;
    }

    .at-slip-head {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 18px;
    }

    .at-pid {
        font-size: 12px;
        color: var(--at-ink-soft);
        margin: 0 0 4px;
    }

    .at-pname {
        font-size: 20px;
        font-weight: 700;
        margin: 0;
        color: var(--at-ink);
    }

    .at-avatar {
        width: 48px;
        height: 48px;
        border-radius: 50%;
        background: var(--at-teal-dark);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 16px;
        flex-shrink: 0;
    }

    .at-slip-section {
        padding: 16px 0;
        border-top: 1px solid var(--at-line);
    }

        .at-slip-section h4 {
            font-size: 12.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: var(--at-teal-dark);
            margin: 0 0 12px;
            display: flex;
            align-items: center;
            gap: 7px;
        }

        .at-slip-section p {
            margin: 0;
            font-size: 14px;
            line-height: 1.55;
            color: var(--at-ink);
        }

    .at-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 16px;
    }

    .at-info-item small {
        display: block;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        color: var(--at-ink-soft);
        margin-bottom: 3px;
    }

    .at-info-item span {
        font-size: 14px;
        font-weight: 600;
        color: var(--at-ink);
    }

    .at-flag-row {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .at-flag {
        padding: 10px 12px;
        border-radius: 10px;
        font-size: 13px;
        display: flex;
        gap: 8px;
        align-items: flex-start;
        line-height: 1.4;
    }

        .at-flag.allergy {
            background: var(--at-red-tint);
            color: #8B2E33;
        }

        .at-flag.condition {
            background: var(--at-gold-tint);
            color: #7C5D1E;
        }

        .at-flag.med {
            background: var(--at-teal-tint);
            color: var(--at-teal-dark);
        }

        .at-flag i {
            margin-top: 2px;
            font-size: 12px;
        }

    .at-reminder {
        margin: 0 22px 18px;
        border-radius: 12px;
        background: var(--at-teal-tint);
        border-left: 4px solid var(--at-teal);
        padding: 14px 16px;
        font-size: 12.5px;
        color: var(--at-teal-dark);
        line-height: 1.7;
    }

        .at-reminder strong {
            display: block;
            margin-bottom: 4px;
            font-size: 12px;
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .at-stamp-wrap {
        padding: 0 22px 22px;
    }

    .at-stamp {
        width: 100%;
        font-weight: 700;
        font-size: 15px;
        letter-spacing: .02em;
        padding: 15px;
        background: var(--at-teal);
        border: none;
        border-radius: 12px;
        color: #fff;
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        transition: background .15s, transform .1s;
        box-shadow: var(--at-shadow);
    }

        .at-stamp:hover {
            background: var(--at-teal-dark);
        }

        .at-stamp:active {
            transform: scale(.98);
        }

        .at-stamp.at-stamped {
            background: var(--at-teal-dark);
        }

    @@media (max-width: 900px) {
        .at-layout {
            grid-template-columns: 1fr;
        }

        .at-stats {
            grid-template-columns: 1fr 1fr;
        }

        .at-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

        .at-row {
            flex-wrap: wrap;
        }
    }
</style>

@section Scripts
{
    <script>
        let atSelectedId = 0;

        function loadPatient(id) {
            atSelectedId = id;

            document.querySelectorAll(".at-row").forEach(row => {
                row.classList.remove("at-selected");
                if (parseInt(row.dataset.testId) === id) {
                    row.classList.add("at-selected");
                }
            });

            fetch('/AvailableTests/GetPatientDetails?id=' + id)
                .then(response => {
                    if (!response.ok) throw new Error("Unable to load patient.");
                    return response.json();
                })
                .then(data => {
                    const initials = (data.patientName || "").split(" ").filter(Boolean).map(p => p[0]).slice(0, 2).join("").toUpperCase();

                    document.getElementById("slipPanel").innerHTML = `
                                <div class="at-slip-body">
                                    <div class="at-slip-head">
                                        <div>
                                            <p class="at-pid">SPECIMEN · REQ #${data.requestId || ''}</p>
                                            <h3 class="at-pname">${data.patientName}</h3>
                                        </div>
                                        <div class="at-avatar">${initials}</div>
                                    </div>

                                    <div class="at-slip-section">
                                        <h4><i class="fa-solid fa-flask-vial"></i> Selected test</h4>
                                        <div class="at-info-grid">
                                            <div class="at-info-item"><small>Test</small><span>${data.testName || '-'}</span></div>
                                            <div class="at-info-item"><small>Category</small><span>${data.category || '-'}</span></div>
                                            <div class="at-info-item"><small>Sample</small><span>${data.sample || '-'}</span></div>
                                            <div class="at-info-item"><small>Turnaround</small><span>${data.turnaround || '-'} hours</span></div>
                                        </div>
                                    </div>

                                    <div class="at-slip-section">
                                        <h4><i class="fa-solid fa-notes-medical"></i> Clinical flags</h4>
                                        <div class="at-flag-row">
                                            <div class="at-flag allergy"><i class="fa-solid fa-triangle-exclamation"></i> Allergies — ${data.allergies || 'None recorded'}</div>
                                            <div class="at-flag condition"><i class="fa-solid fa-heart-pulse"></i> Conditions — ${data.conditions || 'None recorded'}</div>
                                            <div class="at-flag med"><i class="fa-solid fa-pills"></i> Medication — ${data.medication || 'None recorded'}</div>
                                        </div>
                                    </div>

                                    <div class="at-slip-section">
                                        <h4><i class="fa-solid fa-file-lines"></i> Doctor's clinical notes</h4>
                                        <p>${data.clinicalNotes || 'No clinical notes.'}</p>
                                    </div>
                                </div>

                                <div class="at-reminder">
                                    <strong>Before you start</strong>
                                    Verify the sample barcode. Confirm patient identity. Consumables are deducted automatically once processing begins.
                                </div>

                                <div class="at-stamp-wrap">
                                    <button type="button" class="at-stamp" id="stampBtn">
                                        <i class="fa-solid fa-stamp"></i> Begin processing
                                    </button>
                                </div>
                            `;

                    document.getElementById("stampBtn").addEventListener("click", function() {
                        if (!confirm("Start processing this laboratory test?")) return;

                        this.classList.add("at-stamped");
                        this.innerHTML = '<i class="fa-solid fa-check"></i> Processing started';
                        this.disabled = true;

                        setTimeout(() => {
                            document.getElementById("startTestId").value = atSelectedId;
                            document.getElementById("startTestForm").submit();
                        }, 320);
                    });
                })
                .catch(error => {
                    alert(error.message);
                });
        }

        document.getElementById("searchBox").addEventListener("keyup", function() {
            const value = this.value.toLowerCase();
            document.querySelectorAll(".at-row").forEach(row => {
                row.style.display = row.innerText.toLowerCase().includes(value) ? "" : "none";
            });
        });
    </script>
}

