@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Tests In Progress";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var tests = Model?.ToList() ?? new List<LabDash.Models.TestRequestItem>();

    var totalTests = tests.Count;

    var overdueTests = tests.Count(item =>
        item.StartDateTime.HasValue &&
        DateTime.Now >
        item.StartDateTime.Value.AddMinutes(item.TestType?.TurnaroundTimeMinutes ?? 0)
    );

    var onScheduleTests = totalTests - overdueTests;

    var currentTest = tests
        .FirstOrDefault(x => x.Status == "In Progress")
        ?? tests.FirstOrDefault();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="progress-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="progress-header">

        <div class="header-left">

            <div class="header-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div class="header-content">

                <div class="header-eyebrow">
                    <i class="fa-solid fa-circle"></i>
                    LABORATORY WORK QUEUE
                </div>

                <h1>Tests in Progress</h1>

                <p>
                    Monitor and continue laboratory tests currently assigned to you.
                </p>

            </div>

        </div>

        <a asp-action="Index" class="available-tests-button">
            <i class="fa-solid fa-arrow-left"></i>
            <span>Available Tests</span>
        </a>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="progress-alert success-alert">

            <div class="alert-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="alert-content">
                <strong>Success</strong>
                <span>@TempData["Success"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="progress-alert error-alert">

            <div class="alert-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="alert-content">
                <strong>Attention</strong>
                <span>@TempData["Error"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }


    <!-- =========================================================
         SUMMARY STATISTICS
         ========================================================= -->

    <div class="statistics-grid">

        <!-- ACTIVE -->
        <div class="stat-card">

            <div class="stat-icon teal-icon">
                <i class="fa-solid fa-vials"></i>
            </div>

            <div class="stat-information">

                <span class="stat-label">
                    Active Tests
                </span>

                <strong class="stat-number">
                    @totalTests
                </strong>

                <span class="stat-description">
                    Currently assigned
                </span>

            </div>

            <div class="stat-decoration">
                <i class="fa-solid fa-flask"></i>
            </div>

        </div>


        <!-- OVERDUE -->
        <div class="stat-card">

            <div class="stat-icon red-icon">
                <i class="fa-solid fa-clock"></i>
            </div>

            <div class="stat-information">

                <span class="stat-label">
                    Overdue
                </span>

                <strong class="stat-number">
                    @overdueTests
                </strong>

                <span class="stat-description">
                    Require attention
                </span>

            </div>

            <div class="stat-decoration">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

        </div>


        <!-- ON SCHEDULE -->
        <div class="stat-card">

            <div class="stat-icon green-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="stat-information">

                <span class="stat-label">
                    On Schedule
                </span>

                <strong class="stat-number">
                    @onScheduleTests
                </strong>

                <span class="stat-description">
                    Within turnaround time
                </span>

            </div>

            <div class="stat-decoration">
                <i class="fa-solid fa-chart-line"></i>
            </div>

        </div>

    </div>


    <!-- =========================================================
         CURRENT TEST
         ========================================================= -->
    @if (currentTest != null)
    {
        var currentPatient =
            currentTest.TestRequest?.Patient;

        var currentTestType =
            currentTest.TestType;

        var currentPatientName =
            $"{currentPatient?.Name} {currentPatient?.Surname}".Trim();

        if (string.IsNullOrWhiteSpace(currentPatientName))
        {
            currentPatientName = "Patient";
        }

        <div class="current-test-wrapper">

            <div class="current-test-card">

                <!-- CURRENT HEADER -->

                <div class="current-header">

                    <div class="current-header-left">

                        <div class="current-flask">

                            <div class="flask-pulse"></div>

                            <i class="fa-solid fa-flask"></i>

                        </div>

                        <div>

                            <div class="processing-label">
                                <span class="live-dot"></span>
                                CURRENT TEST BEING PROCESSED
                            </div>

                            <h2>
                                @(currentTestType?.Name ?? "Laboratory Test")
                            </h2>

                            <p>
                                @(currentTestType?.Category ?? "Laboratory")
                            </p>

                        </div>

                    </div>


                    <div class="current-status">

                        <span class="status-dot"></span>

                        <span>IN PROGRESS</span>

                    </div>

                </div>


                <!-- CURRENT TEST DETAILS -->

                <div class="current-details">

                    <!-- TEST -->

                    <div class="current-detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-flask"></i>
                        </div>

                        <div class="detail-content">

                            <span>TEST TYPE</span>

                            <strong>
                                @(currentTestType?.Name ?? "Not specified")
                            </strong>

                        </div>

                    </div>


                    <!-- SAMPLE -->

                    <div class="current-detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-vial"></i>
                        </div>

                        <div class="detail-content">

                            <span>SAMPLE</span>

                            <strong>
                                @(currentTestType?.RequiredSampleType ?? "Not specified")
                            </strong>

                        </div>

                    </div>


                    <!-- PATIENT -->

                    <div class="current-detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div class="detail-content">

                            <span>PATIENT</span>

                            <strong>
                                @currentPatientName
                            </strong>

                        </div>

                    </div>


                    <!-- STARTED -->

                    <div class="current-detail">

                        <div class="detail-icon">
                            <i class="fa-solid fa-play"></i>
                        </div>

                        <div class="detail-content">

                            <span>STARTED</span>

                            <strong>
                                @(currentTest.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not started")
                            </strong>

                        </div>

                    </div>


                    <!-- COUNTDOWN -->

                    <div class="current-detail countdown-detail">

                        <div class="detail-icon countdown-icon">
                            <i class="fa-solid fa-stopwatch"></i>
                        </div>

                        <div class="detail-content">

                            <span>TIME REMAINING</span>

                            @if (currentTest.StartDateTime.HasValue &&
                                 currentTestType != null)
                            {
                                <strong id="currentCountdown"
                                        class="countdown-display"
                                        data-start="@currentTest.StartDateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                                        data-turnaround="@currentTestType.TurnaroundTimeMinutes">

                                    Calculating...

                                </strong>
                            }
                            else
                            {
                                <strong class="countdown-display">
                                    Not started
                                </strong>
                            }

                        </div>

                    </div>

                </div>


                <!-- CURRENT FOOTER -->

                <div class="current-footer">

                    <div class="current-message">

                        <div class="message-icon">
                            <i class="fa-solid fa-info"></i>
                        </div>

                        <div>

                            <strong>Test currently assigned to you</strong>

                            <span>
                                Continue processing this laboratory test or capture its results when ready.
                            </span>

                        </div>

                    </div>

                    <a asp-action="ProcessTest"
                       asp-route-id="@currentTest.TestRequestItemId"
                       class="continue-current-button">

                        <span>Continue Test</span>

                        <i class="fa-solid fa-arrow-right"></i>

                    </a>

                </div>

            </div>

        </div>
    }


    <!-- =========================================================
         SEARCH / TOOLBAR
         ========================================================= -->

    <div class="queue-toolbar">

        <div class="queue-heading">

            <div class="queue-heading-icon">
                <i class="fa-solid fa-list-check"></i>
            </div>

            <div>

                <h2>Active Laboratory Tests</h2>

                <p>
                    Tests currently assigned to your work queue
                </p>

            </div>

            <span class="queue-count">
                @totalTests
            </span>

        </div>


        <div class="search-container">

            <i class="fa-solid fa-magnifying-glass"></i>

            <input type="text"
                   id="searchInput"
                   class="search-input"
                   placeholder="Search patient, ID or laboratory test..."
                   autocomplete="off" />

            <button type="button"
                    id="clearSearch"
                    class="clear-search"
                    title="Clear search">

                <i class="fa-solid fa-xmark"></i>

            </button>

        </div>

    </div>


    <!-- =========================================================
         TABLE
         ========================================================= -->

    <div class="table-card">

        <div class="table-responsive">

            <table class="progress-table">

                <thead>

                    <tr>

                        <th>Patient</th>

                        <th>Laboratory Test</th>

                        <th>Started</th>

                        <th>Turnaround</th>

                        <th>Status</th>

                        <th class="actions-heading">
                            Actions
                        </th>

                    </tr>

                </thead>

                <tbody id="progressTable">

                    @foreach (var item in tests)
                    {
                        var testType = item.TestType;

                        var patient = item.TestRequest?.Patient;

                        var patientName =
                            $"{patient?.Name} {patient?.Surname}".Trim();

                        if (string.IsNullOrWhiteSpace(patientName))
                        {
                            patientName = "Unknown Patient";
                        }

                        var turnaround =
                            testType?.TurnaroundTimeMinutes ?? 0;

                        var expectedCompletion =
                            item.StartDateTime.HasValue
                                ? item.StartDateTime.Value.AddMinutes(turnaround)
                                : DateTime.Now;

                        var isOverdue =
                            item.StartDateTime.HasValue &&
                            DateTime.Now > expectedCompletion;

                        var isCurrent =
                            currentTest != null &&
                            item.TestRequestItemId ==
                            currentTest.TestRequestItemId;

                        var firstInitial =
                            patient?.Name?.FirstOrDefault() ?? 'P';

                        var secondInitial =
                            patient?.Surname?.FirstOrDefault() ?? 'A';

                        var initials =
                            $"{firstInitial}{secondInitial}".ToUpper();

                        <tr class="
                            @(isOverdue ? "overdue-row" : "")
                            @(isCurrent ? "current-row" : "")
                            "
                            data-search="
                            @patientName
                            @(patient?.IDNumber ?? "")
                            @(testType?.Name ?? "")
                            @(testType?.Category ?? "")
                            @item.Status
                            ">

                            <!-- PATIENT -->

                            <td>

                                <div class="patient-cell">

                                    <div class="patient-avatar">
                                        @initials
                                    </div>

                                    <div class="patient-information">

                                        <strong>
                                            @patientName
                                        </strong>

                                        @if (!string.IsNullOrWhiteSpace(patient?.IDNumber))
                                        {
                                            <small>
                                                <i class="fa-regular fa-id-card"></i>
                                                @patient.IDNumber
                                            </small>
                                        }
                                        else
                                        {
                                            <small>
                                                Patient information
                                            </small>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- TEST -->

                            <td>

                                <div class="test-cell">

                                    <div class="test-icon">
                                        <i class="fa-solid fa-flask-vial"></i>
                                    </div>

                                    <div>

                                        <strong>
                                            @(testType?.Name ?? "Unknown Test")
                                        </strong>

                                        <small>
                                            @(testType?.Category ?? "Laboratory")
                                        </small>

                                    </div>

                                </div>

                            </td>


                            <!-- STARTED -->

                            <td>

                                <div class="started-cell">

                                    <i class="fa-regular fa-calendar"></i>

                                    <div>

                                        @if (item.StartDateTime.HasValue)
                                        {
                                            <strong>
                                                @item.StartDateTime.Value.ToString("dd MMM yyyy")
                                            </strong>

                                            <small>
                                                @item.StartDateTime.Value.ToString("HH:mm")
                                            </small>
                                        }
                                        else
                                        {
                                            <strong>
                                                Not started
                                            </strong>
                                        }

                                    </div>

                                </div>

                            </td>


                            <!-- TURNAROUND -->

                            <td>

                                @if (isOverdue)
                                {
                                    <span class="status-badge overdue-badge">

                                        <i class="fa-solid fa-clock"></i>

                                        Overdue

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge turnaround-badge">

                                        <i class="fa-solid fa-stopwatch"></i>

                                        @turnaround min

                                    </span>
                                }

                                <small class="due-time @(isOverdue ? "due-overdue" : "")">

                                    <i class="fa-regular fa-clock"></i>

                                    Due @expectedCompletion.ToString("dd MMM HH:mm")

                                </small>

                            </td>


                            <!-- STATUS -->

                            <td>

                                @if (isCurrent)
                                {
                                    <span class="status-badge progress-badge">

                                        <span class="mini-live-dot"></span>

                                        In Progress

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge standard-status">

                                        <i class="fa-solid fa-circle"></i>

                                        @item.Status

                                    </span>
                                }

                            </td>


                            <!-- ACTIONS -->

                            <td>

                                <div class="action-buttons">

                                    <a asp-action="ProcessTest"
                                       asp-route-id="@item.TestRequestItemId"
                                       class="action-button continue-button">

                                        <i class="fa-solid fa-arrow-right"></i>

                                        <span>Continue</span>

                                    </a>

                                    <a asp-controller="CaptureResults"
                                       asp-action="Capture"
                                       asp-route-id="@item.TestRequestItemId"
                                       class="action-button results-button">

                                        <i class="fa-solid fa-vial-circle-check"></i>

                                        <span>Results</span>

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }


                    <!-- =====================================================
                         EMPTY STATE
                         ===================================================== -->
                    @if (!tests.Any())
                    {
                        <tr class="empty-row">

                            <td colspan="6">

                                <div class="empty-state">

                                    <div class="empty-icon">

                                        <i class="fa-solid fa-circle-check"></i>

                                    </div>

                                    <h3>No Active Tests</h3>

                                    <p>
                                        You currently have no laboratory tests in progress.
                                    </p>

                                    <a asp-action="Index"
                                       class="empty-button">

                                        <i class="fa-solid fa-flask-vial"></i>

                                        View Available Tests

                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        </div>


        <!-- NO SEARCH RESULTS -->

        <div id="noSearchResults"
             class="search-empty"
             style="display:none;">

            <div class="search-empty-icon">
                <i class="fa-solid fa-magnifying-glass"></i>
            </div>

            <h3>No matching tests</h3>

            <p>
                No active laboratory tests match your search.
            </p>

            <button type="button"
                    id="resetSearch"
                    class="reset-search-button">

                Clear Search

            </button>

        </div>

    </div>

</div>


<style>

    /* =========================================================
           COLOUR SYSTEM
           ========================================================= */

    :root {
        --lab-teal: #0E8C7F;
        --lab-teal-dark: #0A5850;
        --lab-teal-deep: #064B45;
        --lab-teal-light: #E5F4F1;
        --lab-teal-soft: #F1FAF8;
        --lab-paper: #F3F8F7;
        --lab-white: #FFFFFF;
        --lab-text: #14302C;
        --lab-text-soft: #55716C;
        --lab-text-muted: #8CA5A0;
        --lab-border: #DCEAE7;
        --lab-border-dark: #C9DDD9;
        --lab-red: #B0463F;
        --lab-red-light: #F8E9E8;
        --lab-gold: #B4862A;
        --lab-gold-light: #FBF1DA;
        --lab-green: #16856F;
        --lab-green-light: #E4F4EF;
        --radius-lg: 20px;
        --radius-md: 14px;
        --radius-sm: 10px;
        --shadow: 0 8px 30px rgba(10, 88, 80, 0.07);
        --shadow-small: 0 3px 12px rgba(10, 88, 80, 0.06);
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .progress-page {
        max-width: 1240px;
        margin: 0 auto;
        padding: 26px 0 70px;
        color: var(--lab-text);
        font-family: 'Inter', sans-serif;
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .progress-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        padding: 26px 30px;
        margin-bottom: 22px;
        border-radius: var(--radius-lg);
        background: linear-gradient( 125deg, var(--lab-teal), var(--lab-teal-dark) );
        box-shadow: var(--shadow);
        position: relative;
        overflow: hidden;
    }


        .progress-header::after {
            content: "";
            position: absolute;
            width: 240px;
            height: 240px;
            right: -100px;
            top: -130px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }


    .header-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }


    .header-icon {
        width: 58px;
        height: 58px;
        flex-shrink: 0;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 23px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.32);
    }


    .header-content h1 {
        margin: 3px 0 4px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        font-weight: 800;
        letter-spacing: -.02em;
    }


    .header-content p {
        margin: 0;
        color: rgba(255,255,255,.82);
        font-size: 14px;
    }


    .header-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        color: rgba(255,255,255,.72);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .12em;
    }


        .header-eyebrow i {
            color: #A7F1E6;
            font-size: 6px;
        }


    .available-tests-button {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 18px;
        border-radius: 999px;
        border: 1px solid rgba(255,255,255,.4);
        background: rgba(255,255,255,.12);
        color: #fff;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: .2s;
        white-space: nowrap;
        position: relative;
        z-index: 2;
    }


        .available-tests-button:hover {
            background: rgba(255,255,255,.23);
            color: #fff;
            transform: translateY(-1px);
        }


    /* =========================================================
           ALERTS
           ========================================================= */

    .progress-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 17px;
        margin-bottom: 20px;
        border-radius: var(--radius-md);
        border: 1px solid transparent;
    }


    .success-alert {
        background: var(--lab-teal-light);
        color: var(--lab-teal-deep);
        border-color: #C8E5E0;
    }


    .error-alert {
        background: var(--lab-red-light);
        color: #7A312C;
        border-color: #EBCBC8;
    }


    .alert-icon {
        width: 34px;
        height: 34px;
        border-radius: 10px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }


    .success-alert .alert-icon {
        background: #D2EEE9;
    }


    .error-alert .alert-icon {
        background: #F2D9D7;
    }


    .alert-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 13px;
    }


        .alert-content strong {
            font-size: 12px;
        }


        .alert-content span {
            opacity: .85;
        }


    .alert-close {
        border: none;
        background: transparent;
        color: inherit;
        cursor: pointer;
        opacity: .55;
    }


        .alert-close:hover {
            opacity: 1;
        }


    /* =========================================================
           STATISTICS
           ========================================================= */

    .statistics-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 24px;
    }


    .stat-card {
        background: var(--lab-white);
        border: 1px solid var(--lab-border);
        border-radius: var(--radius-lg);
        padding: 20px;
        display: flex;
        align-items: center;
        gap: 15px;
        position: relative;
        overflow: hidden;
        box-shadow: var(--shadow-small);
        transition: transform .18s, box-shadow .18s;
    }


        .stat-card:hover {
            transform: translateY(-2px);
            box-shadow: var(--shadow);
        }


    .stat-icon {
        width: 51px;
        height: 51px;
        border-radius: 15px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
    }


    .teal-icon {
        background: var(--lab-teal-light);
        color: var(--lab-teal);
    }


    .red-icon {
        background: var(--lab-red-light);
        color: var(--lab-red);
    }


    .green-icon {
        background: var(--lab-green-light);
        color: var(--lab-green);
    }


    .stat-information {
        position: relative;
        z-index: 2;
    }


    .stat-label {
        display: block;
        color: var(--lab-text-muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 2px;
    }


    .stat-number {
        display: block;
        color: var(--lab-text);
        font-family: 'Poppins', sans-serif;
        font-size: 27px;
        line-height: 1.15;
        font-weight: 800;
    }


    .stat-description {
        display: block;
        color: var(--lab-text-muted);
        font-size: 11px;
        margin-top: 3px;
    }


    .stat-decoration {
        position: absolute;
        right: -10px;
        bottom: -16px;
        font-size: 75px;
        opacity: .035;
        color: var(--lab-teal);
    }


    /* =========================================================
           CURRENT TEST
           ========================================================= */

    .current-test-wrapper {
        margin-bottom: 28px;
    }


    .current-test-card {
        overflow: hidden;
        background: var(--lab-white);
        border: 2px solid var(--lab-teal);
        border-radius: var(--radius-lg);
        box-shadow: 0 10px 35px rgba(10,88,80,.12);
        position: relative;
    }


        .current-test-card::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--lab-teal);
