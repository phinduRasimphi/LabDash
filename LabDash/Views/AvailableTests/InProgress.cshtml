@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Tests In Progress";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="pg-wrap">

    <div class="pg-banner">
        <div class="pg-banner-icon"><i class="fa-solid fa-flask-vial"></i></div>
        <div class="pg-banner-text">
            <h1>Tests in progress</h1>
            <p>Monitor active laboratory tests currently assigned to you.</p>
        </div>
        <a asp-action="Index" class="pg-tab-link">
            <i class="fa-solid fa-arrow-left"></i> Available tests
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="pg-alert pg-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="pg-alert-close" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="pg-alert pg-alert-error">
            <i class="fa-solid fa-triangle-exclamation"></i>
            <span>@TempData["Error"]</span>
            <button type="button" class="pg-alert-close" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <div class="pg-stats">
        <div class="pg-stat">
            <div class="pg-stat-icon c-teal"><i class="fa-solid fa-vials"></i></div>
            <div>
                <small>Active tests</small>
                <div class="num">@ViewBag.Total</div>
            </div>
        </div>
        <div class="pg-stat">
            <div class="pg-stat-icon c-red"><i class="fa-solid fa-clock"></i></div>
            <div>
                <small>Overdue</small>
                <div class="num">@ViewBag.Overdue</div>
            </div>
        </div>
        <div class="pg-stat">
            <div class="pg-stat-icon c-teal-deep"><i class="fa-solid fa-circle-check"></i></div>
            <div>
                <small>On schedule</small>
                <div class="num">@(ViewBag.Total - ViewBag.Overdue)</div>
            </div>
        </div>
    </div>

    <div class="pg-search-row">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" class="pg-search" placeholder="Search patient or laboratory test..." />
    </div>

    <div class="pg-panel-label">Active laboratory tests <span class="pg-count">@Model.Count() tests</span></div>

    <div class="pg-table-wrap">
        <table class="pg-table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Test</th>
                    <th>Started</th>
                    <th>Turnaround</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="progressTable">
                @foreach (var item in Model)
                {
                    var expectedCompletion = item.StartDateTime.HasValue
                        ? item.StartDateTime.Value.AddHours(item.TestType.TurnaroundTimeHours)
                        : DateTime.Now;

                    var isOverdue = item.StartDateTime.HasValue &&
                                    DateTime.Now > expectedCompletion;

                    var initials = $"{item.TestRequest.Patient.Name?.FirstOrDefault()}{item.TestRequest.Patient.Surname?.FirstOrDefault()}";

                    <tr class="@(isOverdue ? "pg-row-overdue" : "")">

                        <td>
                            <div class="pg-patient">
                                <div class="pg-avatar">@initials</div>
                                <div>
                                    <strong>@item.TestRequest.Patient.Name @item.TestRequest.Patient.Surname</strong>
                                    <small>@item.TestRequest.Patient.IDNumber</small>
                                </div>
                            </div>
                        </td>

                        <td>
                            <strong>@item.TestType.Name</strong>
                            <small>@item.TestType.Category</small>
                        </td>

                        <td class="pg-mono">
                            @if (item.StartDateTime.HasValue)
                            {
                                @item.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>
                            @if (isOverdue)
                            {
                                <span class="pg-badge urgent"><i class="fa-solid fa-clock"></i> Overdue</span>
                            }
                            else
                            {
                                <span class="pg-badge routine">@item.TestType.TurnaroundTimeHours hrs</span>
                            }
                            <small class="pg-due @(isOverdue ? "pg-due-overdue" : "")">Due @expectedCompletion.ToString("dd MMM HH:mm")</small>
                        </td>

                        <td>
                            <span class="pg-badge pending">@item.Status</span>
                        </td>

                        <td>
                            <div class="pg-actions">
                                <a asp-action="ProcessTest" asp-route-id="@item.TestRequestItemId" class="pg-btn pg-btn-outline">
                                    <i class="fa-solid fa-eye"></i> Continue
                                </a>
                                <a asp-controller="CaptureResults" asp-action="Create" asp-route-id="@item.TestRequestItemId" class="pg-btn pg-btn-solid">
                                    <i class="fa-solid fa-vial-circle-check"></i> Results
                                </a>
                            </div>
                        </td>

                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr class="pg-empty-row">
                        <td colspan="6">
                            <div class="pg-empty">
                                <i class="fa-solid fa-circle-check"></i>
                                <h3>No active tests</h3>
                                <p>You currently have no laboratory tests in progress.</p>
                                <a asp-action="Index" class="pg-btn pg-btn-solid">
                                    <i class="fa-solid fa-flask"></i> View available tests
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --pg-paper: #F3F8F7;
        --pg-raised: #FFFFFF;
        --pg-ink: #14302C;
        --pg-ink-soft: #55716C;
        --pg-ink-faint: #90A9A4;
        --pg-line: #E3EEEC;
        --pg-line-strong: #CFE3DF;

        --pg-teal: #0E8C7F;
        --pg-teal-deep: #0A5850;
        --pg-teal-dim: #E5F4F1;
        --pg-teal-grad-start: #12988A;
        --pg-teal-grad-end: #0A5850;

        --pg-gold: #B4862A; --pg-gold-dim: #FBF1DA;
        --pg-red: #B0463F; --pg-red-dim: #F7E8E7;

        --pg-radius: 18px;
        --pg-radius-sm: 12px;
        --pg-shadow: 0 4px 18px rgba(10, 60, 55, 0.06);
        --pg-shadow-sm: 0 2px 8px rgba(10, 60, 55, 0.05);
    }

    .pg-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 0 60px; color: var(--pg-ink); font-family: 'Inter', sans-serif; }

    /* Banner header */
    .pg-banner {
        display: flex;
        align-items: center;
        gap: 20px;
        background: linear-gradient(120deg, var(--pg-teal-grad-start), var(--pg-teal-grad-end));
        border-radius: var(--pg-radius);
        padding: 26px 30px;
        margin-bottom: 26px;
        box-shadow: var(--pg-shadow);
    }
    .pg-banner-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
        border: 2px solid rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }
    .pg-banner-text { flex: 1; }
    .pg-banner h1 { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 26px; margin: 0 0 4px; color: #fff; letter-spacing: -.01em; }
    .pg-banner p { margin: 0; color: rgba(255, 255, 255, 0.85); font-size: 14.5px; }
    .pg-tab-link {
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px;
        text-decoration: none; color: #fff;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 999px;
        padding: 10px 20px;
        display: inline-flex; align-items: center; gap: 8px;
        transition: .15s; white-space: nowrap;
    }
    .pg-tab-link:hover { background: rgba(255, 255, 255, 0.26); }

    .pg-alert {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 18px; font-size: 14px;
        border-radius: var(--pg-radius-sm);
        margin-bottom: 20px;
    }
    .pg-alert-success { background: var(--pg-teal-dim); color: var(--pg-teal-deep); }
    .pg-alert-error { background: var(--pg-red-dim); color: #7A312C; }
    .pg-alert span { flex: 1; }
    .pg-alert-close { background: none; border: none; cursor: pointer; color: inherit; opacity: .6; font-size: 13px; }
    .pg-alert-close:hover { opacity: 1; }

    /* Stat cards */
    .pg-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 26px; }
    .pg-stat {
        background: var(--pg-raised);
        border-radius: var(--pg-radius);
        box-shadow: var(--pg-shadow-sm);
        padding: 20px 22px;
        display: flex; align-items: center; gap: 16px;
    }
    .pg-stat-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 19px; flex-shrink: 0;
    }
    .pg-stat-icon.c-teal { background: var(--pg-teal-dim); color: var(--pg-teal); }
    .pg-stat-icon.c-teal-deep { background: var(--pg-teal-dim); color: var(--pg-teal-deep); }
    .pg-stat-icon.c-red { background: var(--pg-red-dim); color: var(--pg-red); }
    .pg-stat small { display: block; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--pg-ink-faint); margin-bottom: 4px; }
    .pg-stat .num { font-family: 'Poppins', sans-serif; font-size: 26px; font-weight: 700; color: var(--pg-ink); }

    /* Search */
    .pg-search-row { margin-bottom: 22px; position: relative; }
    .pg-search-row i { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--pg-ink-faint); font-size: 14px; }
    .pg-search {
        width: 100%; padding: 14px 18px 14px 44px;
        border: 1px solid var(--pg-line-strong);
        border-radius: 999px;
        background: var(--pg-raised);
        font-family: 'Inter', sans-serif; font-size: 14px; color: var(--pg-ink);
        outline: none; transition: border-color .15s, box-shadow .15s;
        box-shadow: var(--pg-shadow-sm);
    }
    .pg-search::placeholder { color: var(--pg-ink-faint); }
    .pg-search:focus { border-color: var(--pg-teal); box-shadow: 0 0 0 4px var(--pg-teal-dim); }

    .pg-panel-label { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: .02em; color: var(--pg-teal-deep); margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
    .pg-count { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px; color: var(--pg-teal-deep); background: var(--pg-teal-dim); padding: 4px 11px; border-radius: 999px; }

    /* Table */
    .pg-table-wrap { background: var(--pg-raised); border-radius: var(--pg-radius); box-shadow: var(--pg-shadow); overflow: hidden; overflow-x: auto; }
    .pg-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .pg-table thead th { text-align: left; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--pg-ink-faint); padding: 16px 20px; background: var(--pg-teal-dim); white-space: nowrap; }
    .pg-table thead th:first-child { border-top-left-radius: var(--pg-radius); }
    .pg-table thead th:last-child { border-top-right-radius: var(--pg-radius); }
    .pg-table tbody td { padding: 16px 20px; border-bottom: 1px solid var(--pg-line); vertical-align: middle; }
    .pg-table tbody tr { transition: background .12s; }
    .pg-table tbody tr:hover { background: var(--pg-teal-dim); }
    .pg-table tbody tr:last-child td { border-bottom: none; }
    .pg-table strong { display: block; font-size: 14px; color: var(--pg-ink); font-weight: 600; }
    .pg-table small { display: block; font-size: 12px; color: var(--pg-ink-faint); margin-top: 2px; }
    .pg-mono { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--pg-ink-soft); }

    .pg-patient { display: flex; align-items: center; gap: 12px; }
    .pg-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--pg-teal), var(--pg-teal-deep)); color: #fff; display: flex; align-items: center; justify-content: center; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px; flex-shrink: 0; text-transform: uppercase; }

    .pg-badge { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px; letter-spacing: .02em; padding: 6px 13px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; }
    .pg-badge.urgent { background: var(--pg-red-dim); color: var(--pg-red); }
    .pg-badge.routine { background: var(--pg-teal-dim); color: var(--pg-teal-deep); }
    .pg-badge.pending { background: var(--pg-gold-dim); color: var(--pg-gold); }
    .pg-due { display: block; margin-top: 6px; font-family: 'Inter', sans-serif; font-size: 11.5px; color: var(--pg-ink-faint); }
    .pg-due-overdue { color: var(--pg-red); font-weight: 600; }

    .pg-row-overdue { background: var(--pg-red-dim); }
    .pg-row-overdue:hover { background: var(--pg-red-dim) !important; }

    .pg-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .pg-btn { font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; padding: 9px 16px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: .15s; white-space: nowrap; border-radius: 999px; }
    .pg-btn-outline { border: 1px solid var(--pg-teal); background: transparent; color: var(--pg-teal-deep); }
    .pg-btn-outline:hover { background: var(--pg-teal-dim); }
    .pg-btn-solid { border: 1px solid var(--pg-teal); background: var(--pg-teal); color: #fff; }
    .pg-btn-solid:hover { background: var(--pg-teal-deep); border-color: var(--pg-teal-deep); }

    .pg-empty { padding: 60px 24px; text-align: center; color: var(--pg-ink-faint); }
    .pg-empty i { font-size: 32px; margin-bottom: 12px; display: block; color: var(--pg-teal); }
    .pg-empty h3 { font-family: 'Poppins', sans-serif; color: var(--pg-ink); margin: 0 0 6px; }
    .pg-empty p { margin: 0 0 18px; }
    .pg-empty .pg-btn { display: inline-flex; }

    @@media (max-width: 900px) {
        .pg-banner { flex-direction: column; align-items: flex-start; gap: 16px; }
        .pg-stats { grid-template-columns: 1fr; }
        .pg-actions { flex-direction: column; }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const searchBox = document.getElementById("searchInput");
            searchBox.addEventListener("keyup", function () {
                const value = this.value.toLowerCase();
                const rows = document.querySelectorAll("#progressTable tr");
                rows.forEach(function (row) {
                    const text = row.innerText.toLowerCase();
                    row.style.display = text.indexOf(value) > -1 ? "" : "none";
                });
            });
        });
    </script>
}

