</style>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* =====================================================
               SEARCH
               ===================================================== */

            const searchInput =
                document.getElementById("searchInput");

            const clearSearch =
                document.getElementById("clearSearch");

            const resetSearch =
                document.getElementById("resetSearch");

            const table =
                document.getElementById("progressTable");

            const noSearchResults =
                document.getElementById("noSearchResults");


            function performSearch() {

                if (!searchInput || !table) {
                    return;
                }

                const searchValue =
                    searchInput.value
                        .trim()
                        .toLowerCase();

                const rows =
                    table.querySelectorAll(
                        "tr:not(.empty-row)"
                    );

                let visibleRows = 0;

                rows.forEach(function (row) {

                    const searchText =
                        (
                            row.getAttribute("data-search") ||
                            row.innerText ||
                            ""
                        ).toLowerCase();

                    const matches =
                        searchText.includes(searchValue);

                    row.style.display =
                        matches ? "" : "none";

                    if (matches) {
                        visibleRows++;
                    }

                });

                if (clearSearch) {
                    clearSearch.style.display =
                        searchValue.length > 0 ? "block" : "none";
                }

                if (noSearchResults) {
                    noSearchResults.style.display =
                        searchValue.length > 0 && visibleRows === 0
                            ? "block"
                            : "none";
                }

            }

            if (searchInput) {
                searchInput.addEventListener("input", performSearch);
            }

            function clearSearchBox() {

                if (searchInput) {
                    searchInput.value = "";
                    performSearch();
                    searchInput.focus();
                }

            }

            if (clearSearch) {
                clearSearch.addEventListener("click", clearSearchBox);
            }

            if (resetSearch) {
                resetSearch.addEventListener("click", clearSearchBox);
            }


            /* =====================================================
               LIVE COUNTDOWN (total minutes + seconds, no hours/days)
               ===================================================== */

            const countdown =
                document.getElementById("currentCountdown");

            if (countdown) {

                const startValue =
                    countdown.dataset.start;

                const turnaroundMinutes =
                    parseInt(countdown.dataset.turnaround, 10);

                if (startValue && !isNaN(turnaroundMinutes)) {

                    // The server sends the start time. The expected
                    // completion time is start + turnaround period.
                    const startTime =
                        new Date(startValue);

                    const completionTime =
                        new Date(
                            startTime.getTime() +
                            (turnaroundMinutes * 60 * 1000)
                        );

                    function updateCountdown() {

                        const remaining =
                            completionTime.getTime() - Date.now();

                        // OVERDUE
                        if (remaining <= 0) {

                            countdown.textContent = "OVERDUE";

                            countdown.classList.remove("warning", "danger");
                            countdown.classList.add("overdue");

                            return;
                        }

                        const totalSeconds =
                            Math.floor(remaining / 1000);

                        // Everything is expressed in minutes: 166m 05s
                        const minutes =
                            Math.floor(totalSeconds / 60);

                        const seconds =
                            totalSeconds % 60;

                        countdown.textContent =
                            minutes + "m " +
                            String(seconds).padStart(2, "0") + "s";

                        countdown.classList.remove(
                            "warning",
                            "danger",
                            "overdue"
                        );

                        const totalMinutes = remaining / 60000;

                        if (totalMinutes <= 10) {
                            countdown.classList.add("danger");
                        }
                        else if (totalMinutes <= 30) {
                            countdown.classList.add("warning");
                        }

                    }

                    updateCountdown();

                    setInterval(updateCountdown, 1000);

                }

            }

        });

    </script>

}