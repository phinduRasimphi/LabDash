@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Tests In Progress";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var tests = Model?.ToList() ?? new List<LabDash.Models.TestRequestItem>();

    var totalTests = tests.Count;

    var overdueTests = tests.Count(item =>
        item.StartDateTime.HasValue &&
        DateTime.Now >
        item.StartDateTime.Value.AddMinutes(item.TestType?.TurnaroundTimeMinutes ?? 0)
    );

    var onScheduleTests = totalTests - overdueTests;

    var currentTest = tests
        .FirstOrDefault(x => x.Status == "In Progress")
        ?? tests.FirstOrDefault();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="progress-page">

    <!-- =========================================================
         BANNER
         ========================================================= -->

    <div class="banner">

        <div class="banner-left">

            <div class="banner-icon">
                <i class="fa-solid fa-hourglass-half"></i>
            </div>

            <div>
                <h1>Tests in Progress</h1>
                <p>Monitor and continue laboratory tests currently assigned to you.</p>
            </div>

        </div>

        <div class="banner-stats">

            <div class="banner-stat">
                <strong>@totalTests</strong>
                <span>Active</span>
            </div>

            <div class="banner-stat">
                <strong>@overdueTests</strong>
                <span>Overdue</span>
            </div>

            <div class="banner-stat">
                <strong>@onScheduleTests</strong>
                <span>On schedule</span>
            </div>

            <a asp-action="Index" class="banner-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Available tests
            </a>

        </div>

    </div>


    <!-- =========================================================
         ALERTS
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="progress-alert success-alert" role="status">

            <div class="alert-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="alert-content">
                <strong>Success</strong>
                <span>@TempData["Success"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    aria-label="Dismiss"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="progress-alert error-alert" role="alert">

            <div class="alert-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="alert-content">
                <strong>Attention</strong>
                <span>@TempData["Error"]</span>
            </div>

            <button type="button"
                    class="alert-close"
                    aria-label="Dismiss"
                    onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>

        </div>
    }


    <!-- =========================================================
         CURRENT TEST
         ========================================================= -->
    @if (currentTest != null)
    {
        var currentPatient =
            currentTest.TestRequest?.Patient;

        var currentTestType =
            currentTest.TestType;

        var currentPatientName =
            $"{currentPatient?.Name} {currentPatient?.Surname}".Trim();

        if (string.IsNullOrWhiteSpace(currentPatientName))
        {
            currentPatientName = "Patient";
        }

        <section class="panel current-panel">

            <div class="panel-head">

                <div class="current-title">

                    <div class="current-flask">
                        <span class="flask-pulse"></span>
                        <i class="fa-solid fa-flask"></i>
                    </div>

                    <div>
                        <span class="eyebrow">
                            <span class="live-dot"></span>
                            Current test being processed
                        </span>

                        <h2>@(currentTestType?.Name ?? "Laboratory Test")</h2>
                    </div>

                </div>

                <span class="status-badge progress-badge">
                    <span class="mini-live-dot"></span>
                    In progress
                </span>

            </div>

            <div class="current-details">

                <div class="current-detail">
                    <div class="detail-icon"><i class="fa-solid fa-layer-group"></i></div>
                    <div class="detail-content">
                        <span>Category</span>
                        <strong>@(currentTestType?.Category ?? "Laboratory")</strong>
                    </div>
                </div>

                <div class="current-detail">
                    <div class="detail-icon"><i class="fa-solid fa-vial"></i></div>
                    <div class="detail-content">
                        <span>Sample</span>
                        <strong>@(currentTestType?.RequiredSampleType ?? "Not specified")</strong>
                    </div>
                </div>

                <div class="current-detail">
                    <div class="detail-icon"><i class="fa-solid fa-user"></i></div>
                    <div class="detail-content">
                        <span>Patient</span>
                        <strong>@currentPatientName</strong>
                    </div>
                </div>

                <div class="current-detail">
                    <div class="detail-icon"><i class="fa-solid fa-play"></i></div>
                    <div class="detail-content">
                        <span>Started</span>
                        <strong>
                            @(currentTest.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not started")
                        </strong>
                    </div>
                </div>

                <div class="current-detail countdown-detail">
                    <div class="detail-icon"><i class="fa-solid fa-stopwatch"></i></div>
                    <div class="detail-content">
                        <span>Time remaining</span>

                        @if (currentTest.StartDateTime.HasValue &&
                             currentTestType != null)
                        {
                            <strong id="currentCountdown"
                                    class="countdown-display"
                                    data-start="@currentTest.StartDateTime.Value.ToString("yyyy-MM-ddTHH:mm:ss")"
                                    data-turnaround="@currentTestType.TurnaroundTimeMinutes">
                                Calculating...
                            </strong>
                        }
                        else
                        {
                            <strong class="countdown-display">Not started</strong>
                        }
                    </div>
                </div>

            </div>

            <div class="current-footer">

                <div class="current-message">

                    <div class="message-icon">
                        <i class="fa-solid fa-info"></i>
                    </div>

                    <div>
                        <strong>Test currently assigned to you</strong>
                        <span>Continue processing this test or capture its results when ready.</span>
                    </div>

                </div>

                <a asp-action="ProcessTest"
                   asp-route-id="@currentTest.TestRequestItemId"
                   class="primary-btn">
                    Continue test
                    <i class="fa-solid fa-arrow-right"></i>
                </a>

            </div>

        </section>
    }


    <!-- =========================================================
         ACTIVE TESTS TABLE
         ========================================================= -->

    <section class="panel">

        <div class="panel-head">

            <h2 class="panel-title">
                <i class="fa-solid fa-list-check"></i>
                Active laboratory tests
            </h2>

            <span class="count-pill">
                @totalTests @(totalTests == 1 ? "test" : "tests")
            </span>

        </div>

        <div class="panel-body">

            <div class="search-field">

                <i class="fa-solid fa-magnifying-glass"></i>

                <input type="text"
                       id="searchInput"
                       aria-label="Search active tests"
                       placeholder="Search patient, ID or laboratory test..."
                       autocomplete="off" />

                <button type="button"
                        id="clearSearch"
                        class="clear-search"
                        aria-label="Clear search">
                    <i class="fa-solid fa-xmark"></i>
                </button>

            </div>

            <div class="table-wrap">

                <table class="progress-table">

                    <thead>
                        <tr>
                            <th>Patient</th>
                            <th>Laboratory test</th>
                            <th>Started</th>
                            <th>Turnaround</th>
                            <th>Status</th>
                            <th class="actions-heading">Actions</th>
                        </tr>
                    </thead>

                    <tbody id="progressTable">

                        @foreach (var item in tests)
                        {
                            var testType = item.TestType;

                            var patient = item.TestRequest?.Patient;

                            var patientName =
                                $"{patient?.Name} {patient?.Surname}".Trim();

                            if (string.IsNullOrWhiteSpace(patientName))
                            {
                                patientName = "Unknown Patient";
                            }

                            var turnaround =
                                testType?.TurnaroundTimeMinutes ?? 0;

                            var expectedCompletion =
                                item.StartDateTime.HasValue
                                    ? item.StartDateTime.Value.AddMinutes(turnaround)
                                    : DateTime.Now;

                            var isOverdue =
                                item.StartDateTime.HasValue &&
                                DateTime.Now > expectedCompletion;

                            var isCurrent =
                                currentTest != null &&
                                item.TestRequestItemId ==
                                currentTest.TestRequestItemId;

                            var firstInitial =
                                patient?.Name?.FirstOrDefault() ?? 'P';

                            var secondInitial =
                                patient?.Surname?.FirstOrDefault() ?? 'A';

                            var initials =
                                $"{firstInitial}{secondInitial}".ToUpper();

                            var rowClass =
                                (isOverdue ? "overdue-row " : "") +
                                (isCurrent ? "current-row" : "");

                            var searchText =
                                $"{patientName} {patient?.IDNumber} {testType?.Name} {testType?.Category} {item.Status}";

                            <tr class="@rowClass.Trim()" data-search="@searchText">

                                <!-- PATIENT -->

                                <td>
                                    <div class="patient-cell">

                                        <div class="patient-avatar">@initials</div>

                                        <div class="patient-information">

                                            <strong>@patientName</strong>

                                            @if (!string.IsNullOrWhiteSpace(patient?.IDNumber))
                                            {
                                                <small>
                                                    <i class="fa-regular fa-id-card"></i>
                                                    @patient.IDNumber
                                                </small>
                                            }
                                            else
                                            {
                                                <small>Patient information</small>
                                            }

                                        </div>

                                    </div>
                                </td>


                                <!-- TEST -->

                                <td>
                                    <strong class="test-name">
                                        @(testType?.Name ?? "Unknown Test")
                                    </strong>

                                    <span class="category-tag">
                                        @(testType?.Category ?? "Laboratory")
                                    </span>
                                </td>


                                <!-- STARTED -->

                                <td>
                                    @if (item.StartDateTime.HasValue)
                                    {
                                        <span class="date-text">
                                            @item.StartDateTime.Value.ToString("dd MMM yyyy")
                                        </span>

                                        <small class="sub-text">
                                            @item.StartDateTime.Value.ToString("HH:mm")
                                        </small>
                                    }
                                    else
                                    {
                                        <span class="date-text">Not started</span>
                                    }
                                </td>


                                <!-- TURNAROUND -->

                                <td>
                                    @if (isOverdue)
                                    {
                                        <span class="status-badge overdue-badge">
                                            <i class="fa-solid fa-clock"></i>
                                            Overdue
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge turnaround-badge">
                                            <i class="fa-solid fa-stopwatch"></i>
                                            @turnaround min
                                        </span>
                                    }

                                    <small class="due-time @(isOverdue ? "due-overdue" : "")">
                                        Due @expectedCompletion.ToString("dd MMM HH:mm")
                                    </small>
                                </td>


                                <!-- STATUS -->

                                <td>
                                    @if (isCurrent)
                                    {
                                        <span class="status-badge progress-badge">
                                            <span class="mini-live-dot"></span>
                                            In progress
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-badge standard-status">
                                            <i class="fa-solid fa-circle"></i>
                                            @item.Status
                                        </span>
                                    }
                                </td>


                                <!-- ACTIONS -->

                                <td>
                                    <div class="action-buttons">

                                        <a asp-action="ProcessTest"
                                           asp-route-id="@item.TestRequestItemId"
                                           class="action-button continue-button">
                                            <i class="fa-solid fa-arrow-right"></i>
                                            Continue
                                        </a>

                                        <a asp-controller="CaptureResults"
                                           asp-action="Capture"
                                           asp-route-id="@item.TestRequestItemId"
                                           class="action-button results-button">
                                            <i class="fa-solid fa-vial-circle-check"></i>
                                            Results
                                        </a>

                                    </div>
                                </td>

                            </tr>
                        }


                        @if (!tests.Any())
                        {
                            <tr class="empty-row">
                                <td colspan="6">

                                    <div class="empty-state">

                                        <i class="fa-solid fa-circle-check"></i>

                                        <h3>No active tests</h3>

                                        <p>You currently have no laboratory tests in progress.</p>

                                        <a asp-action="Index" class="primary-btn">
                                            <i class="fa-solid fa-flask-vial"></i>
                                            View available tests
                                        </a>

                                    </div>

                                </td>
                            </tr>
                        }

                    </tbody>

                </table>

            </div>

            <!-- NO SEARCH RESULTS -->

            <div id="noSearchResults"
                 class="empty-state"
                 style="display:none;">

                <i class="fa-solid fa-magnifying-glass"></i>

                <h3>No matching tests</h3>

                <p>No active laboratory tests match your search.</p>

                <button type="button"
                        id="resetSearch"
                        class="primary-btn">
                    Clear search
                </button>

            </div>

        </div>

    </section>

</div>


<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b7a70;
        --teal-deep: #0a5f58;
        --teal-light: #e1f3f0;
        --teal-soft: #f2f8f7;
        --teal-border: #dbe9e7;
        --text: #12302f;
        --muted: #6f8584;
        --page-bg: #eaf1f1;
        --red: #a32626;
        --red-bg: #fde8e8;
        --red-border: #f5c6c6;
        --gold: #8f5a00;
        --gold-bg: #fff3dc;
        --gold-border: #f3d9a0;
        --green: #17814a;
        --green-bg: #e4f6ec;
        --blue: #22719a;
        --blue-bg: #e4f2f9;
    }

    .progress-page {
        width: 100%;
        padding: 28px 32px 48px;
        background: var(--page-bg);
        min-height: 100vh;
        overflow-x: hidden;
        color: var(--text);
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        -webkit-font-smoothing: antialiased;
    }

        .progress-page *,
        .progress-page *::before,
        .progress-page *::after {
            box-sizing: border-box;
        }


    /* BANNER */

    .banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
    }

    .banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .banner-stats {
        display: flex;
        align-items: center;
        gap: 32px;
        flex-wrap: wrap;
    }

    .banner-stat {
        text-align: center;
    }

        .banner-stat strong {
            display: block;
            font-size: 24px;
            font-weight: 800;
            line-height: 1.1;
        }

        .banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }

    .banner-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 14px;
        background: #fff;
        color: var(--teal-deep);
        font-size: 13.5px;
        font-weight: 800;
        text-decoration: none;
        white-space: nowrap;
        box-shadow: 0 6px 16px rgba(0, 0, 0, .12);
        transition: transform .15s ease;
    }

        .banner-btn:hover {
            color: var(--teal-deep);
            transform: translateY(-1px);
        }


    /* ALERTS */

    .progress-alert {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 14px 18px;
        margin-bottom: 22px;
        border-radius: 16px;
        border: 1px solid transparent;
    }

    .success-alert {
        background: var(--green-bg);
        color: var(--green);
        border-color: #bfe6cf;
    }

    .error-alert {
        background: var(--red-bg);
        color: var(--red);
        border-color: var(--red-border);
    }

    .alert-icon {
        width: 36px;
        height: 36px;
        border-radius: 11px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        background: rgba(255, 255, 255, .65);
    }

    .alert-content {
        flex: 1;
        display: flex;
        flex-direction: column;
        gap: 2px;
        font-size: 13.5px;
        font-weight: 500;
    }

        .alert-content strong {
            font-size: 13px;
            font-weight: 800;
        }

    .alert-close {
        border: 0;
        background: transparent;
        color: inherit;
        cursor: pointer;
        opacity: .6;
        padding: 6px;
    }

        .alert-close:hover {
            opacity: 1;
        }


    /* PANELS */

    .panel {
        min-width: 0;
        margin-bottom: 24px;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
        overflow: hidden;
    }

    .panel-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 32px;
        border-bottom: 1px solid var(--teal-border);
    }

    .panel-title {
        display: flex;
        align-items: center;
        gap: 14px;
        margin: 0;
        font-size: 17px;
        font-weight: 800;
        color: var(--text);
    }

        .panel-title i {
            color: var(--teal);
            font-size: 18px;
        }

    .count-pill {
        display: inline-flex;
        align-items: center;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .panel-body {
        padding: 22px 32px 12px;
    }


    /* CURRENT TEST */

    .current-panel {
        border-left: 5px solid var(--teal);
    }

    .current-title {
        display: flex;
        align-items: center;
        gap: 16px;
        min-width: 0;
    }

        .current-title h2 {
            margin: 4px 0 0;
            font-size: 20px;
            font-weight: 800;
            color: var(--teal-deep);
            overflow-wrap: anywhere;
        }

    .current-flask {
        position: relative;
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #129a8d, #0a5f58);
        color: #fff;
        font-size: 21px;
        box-shadow: 0 8px 18px rgba(10, 95, 88, .25);
    }

    .flask-pulse {
        position: absolute;
        inset: -5px;
        border-radius: 20px;
        border: 2px solid rgba(15, 148, 136, .35);
        animation: flaskPulse 2.2s infinite;
    }

    @@keyframes flaskPulse {

        0% {
            transform: scale(.94);
            opacity: .8;
        }

        70%, 100% {
            transform: scale(1.14);
            opacity: 0;
        }
    }

    .eyebrow {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .live-dot,
    .mini-live-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: var(--teal);
        box-shadow: 0 0 0 4px rgba(15, 148, 136, .14);
    }

    .live-dot {
        animation: livePulse 1.6s infinite;
    }

    @@keyframes livePulse {

        0%, 100% {
            opacity: 1;
        }

        50% {
            opacity: .35;
        }
    }

    .current-details {
        display: grid;
        grid-template-columns: repeat(5, minmax(0, 1fr));
        gap: 14px;
        padding: 24px 32px 8px;
    }

    .current-detail {
        display: flex;
        align-items: center;
        gap: 12px;
        min-width: 0;
        padding: 15px 16px;
        background: #fff;
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .detail-icon {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--teal);
        background: var(--teal-light);
        font-size: 15px;
    }

    .detail-content {
        min-width: 0;
    }

        .detail-content span {
            display: block;
            margin-bottom: 5px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .detail-content strong {
            display: block;
            overflow: hidden;
            text-overflow: ellipsis;
            white-space: nowrap;
            color: var(--text);
            font-size: 13.5px;
            font-weight: 700;
        }

    .countdown-detail {
        background: var(--teal-light);
        border-color: #c5e4df;
    }

        .countdown-detail .detail-icon {
            background: #fff;
        }

    .countdown-display {
        color: var(--teal-dark) !important;
        font-size: 15px !important;
        font-weight: 800 !important;
    }

        .countdown-display.warning {
            color: var(--gold) !important;
        }

        .countdown-display.danger,
        .countdown-display.overdue {
            color: var(--red) !important;
        }

    .current-footer {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        flex-wrap: wrap;
        padding: 20px 32px 26px;
    }

    .current-message {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .message-icon {
        width: 36px;
        height: 36px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        color: var(--teal-dark);
        background: var(--teal-light);
        font-size: 13px;
    }

    .current-message strong {
        display: block;
        color: var(--teal-deep);
        font-size: 13.5px;
        font-weight: 800;
    }

    .current-message span {
        display: block;
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 500;
        margin-top: 3px;
    }


