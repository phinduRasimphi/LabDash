@model LabDash.Models.TestRequestItem
@using LabDash.Models

@{
    ViewData["Title"] = "Laboratory Test Details";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;
    var verification = ViewBag.Verification as TestVerification;

    var patientName = $"{patient?.Name} {patient?.Surname}".Trim();

    var initials = $"{patient?.Name?.FirstOrDefault()}{patient?.Surname?.FirstOrDefault()}"
        .Trim();

    var isVerified = string.Equals(Model.Status, "Verified",
        StringComparison.OrdinalIgnoreCase);

    var isCompleted = string.Equals(Model.Status, "Completed",
        StringComparison.OrdinalIgnoreCase);

    // Full verification / review history (set in the controller).
    var verificationHistory = (ViewBag.VerificationHistory as IEnumerable<TestVerification>
        ?? Enumerable.Empty<TestVerification>()).ToList();

    // Every time the test was sent back for review, oldest first.
    var returnedEntries = verificationHistory
        .Where(v => string.Equals(v.Status, "To Be Reviewed", StringComparison.OrdinalIgnoreCase))
        .OrderBy(v => v.VerificationDate)
        .ToList();

    int? returnCount = verificationHistory.Any() ? returnedEntries.Count : (int?)null;

    // Determine abnormality from the numeric result and configured reference limits.
    // If the result cannot be evaluated numerically or the limits are unavailable,
    // retain the saved IsAbnormal flag rather than inventing a classification.
    bool? isAbnormal = result?.IsAbnormal;

    if (result != null &&
        !string.IsNullOrWhiteSpace(result.ResultValue))
    {
        decimal parsedValue;
        var valueText = result.ResultValue.Trim();

        var parsed =
            decimal.TryParse(
                valueText,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.InvariantCulture,
                out parsedValue)
            ||
            decimal.TryParse(
                valueText,
                System.Globalization.NumberStyles.Number,
                System.Globalization.CultureInfo.GetCultureInfo("en-ZA"),
                out parsedValue);

        var lowerLimit = Model.TestType?.ReferenceRangeLow;
        var upperLimit = Model.TestType?.ReferenceRangeHigh;

        if (parsed && (lowerLimit.HasValue || upperLimit.HasValue))
        {
            isAbnormal =
                (lowerLimit.HasValue && parsedValue < lowerLimit.Value)
                ||
                (upperLimit.HasValue && parsedValue > upperLimit.Value);
        }
    }

    var referenceRange = !string.IsNullOrWhiteSpace(result?.ReferenceRange)
        ? result.ReferenceRange
        : Model.TestType?.ReferenceRangeLow != null &&
          Model.TestType?.ReferenceRangeHigh != null
            ? $"{Model.TestType.ReferenceRangeLow} - {Model.TestType.ReferenceRangeHigh}"
            : "Not specified";

    var unit = !string.IsNullOrWhiteSpace(result?.Units)
        ? result.Units
        : Model.TestType?.UnitOfMeasurement ?? "Not specified";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="lab-details-page">

    <!-- BANNER -->

    <div class="banner">
        <div class="banner-left">
            <div class="banner-icon">
                <i class="fa-solid fa-vial"></i>
            </div>

            <div>
                <h1>@(Model.TestType?.Name ?? "Laboratory Test")</h1>
                <p>
                    Request TR-@Model.RequestId
                    @(string.IsNullOrWhiteSpace(patientName) ? "" : $"for {patientName}")
                </p>
            </div>
        </div>

        <div class="banner-stats">
            <div class="banner-stat">
                <strong>#@Model.TestRequestItemId</strong>
                <span>Test item</span>
            </div>

            @if (returnCount.HasValue)
            {
                <div class="banner-stat">
                    <strong>@returnCount.Value</strong>
                    <span>Returns</span>
                </div>
            }

            <div class="banner-stat">
                <strong>@Model.Status</strong>
                <span>Status</span>
            </div>

            <a asp-action="Completed" class="banner-btn">
                <i class="fa-solid fa-arrow-left"></i>
                Back
            </a>
        </div>
    </div>


    <!-- PATIENT AND TEST INFORMATION -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION: LEFT -->

        <section class="information-card">

            <div class="card-header">
                <h2><i class="fa-solid fa-user"></i> Patient information</h2>
            </div>

            <div class="card-body">

                @if (patient != null)
                {
                    <div class="patient-profile">

                        <div class="patient-avatar">
                            @(string.IsNullOrWhiteSpace(initials) ? "P" : initials.ToUpper())
                        </div>

                        <div class="patient-profile-text">
                            <span class="eyebrow">Patient</span>
                            <h3>@patientName</h3>
                        </div>

                    </div>

                    <div class="patient-detail-list">

                        <div class="patient-detail-row">
                            <span>ID number</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.IDNumber)
                                    ? "Not provided"
                                    : patient.IDNumber)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Email</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.Email)
                                    ? "Not provided"
                                    : patient.Email)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Cellphone</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.CellphoneNumber)
                                    ? "Not provided"
                                    : patient.CellphoneNumber)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Date of birth</span>
                            <strong>@patient.DOB.ToString("dd MMM yyyy")</strong>
                        </div>

                    </div>

                    <!-- CLINICAL INFORMATION -->

                    <div class="subsection-heading">
                        <i class="fa-solid fa-notes-medical"></i>
                        Clinical information
                    </div>

                    <div class="clinical-list">

                        <div class="clinical-item allergy">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <strong>Allergies</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.Allergies)
                                    ? "None recorded"
                                    : patient.Allergies)
                            </p>
                        </div>

                        <div class="clinical-item condition">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-heart-pulse"></i>
                                <strong>Medical conditions</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.MedicalConditions)
                                    ? "None recorded"
                                    : patient.MedicalConditions)
                            </p>
                        </div>

                        <div class="clinical-item medication">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-pills"></i>
                                <strong>Medication</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.Medication)
                                    ? "None recorded"
                                    : patient.Medication)
                            </p>
                        </div>

                    </div>
                }
                else
                {
                    <div class="empty-state">
                        Patient information is unavailable.
                    </div>
                }

                <!-- DOCTOR NOTES -->

                <div class="subsection-heading">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor clinical notes
                </div>

                <div class="doctor-notes">

                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided."
                            : Model.TestRequest.ClinicalNotes)
                    </p>

                </div>

            </div>

        </section>


        <!-- TEST INFORMATION: RIGHT -->

        <section class="information-card">

            <div class="card-header">
                <h2><i class="fa-solid fa-vials"></i> Test information</h2>
            </div>

            <div class="card-body">

                <div class="test-main">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-main-content">

                        <span class="eyebrow">Laboratory test</span>

                        <h3>
                            @(Model.TestType?.Name ?? "Laboratory Test")
                        </h3>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(Model.TestType?.Category ?? "Uncategorised")
                        </span>

                    </div>

                </div>


                <!-- SAMPLE TYPE AND CATEGORY -->

                <div class="sample-category-grid">

                    <div class="sample-category-item">
                        <span>
                            <i class="fa-solid fa-droplet"></i>
                            Sample type
                        </span>

                        <strong>
                            @(Model.TestType?.RequiredSampleType ?? "Not specified")
                        </strong>
                    </div>

                    <div class="sample-category-item">
                        <span>
                            <i class="fa-solid fa-flask"></i>
                            Test category
                        </span>

                        <strong>
                            @(Model.TestType?.Category ?? "Not specified")
                        </strong>
                    </div>

                </div>


                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail-item">
                        <span>Request number</span>
                        <strong>TR-@Model.RequestId</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Test item</span>
                        <strong>#@Model.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Unit of measurement</span>
                        <strong>@unit</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Reference range</span>
                        <strong>@referenceRange</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Turnaround time</span>
                        <strong>
                            @(Model.TestType?.TurnaroundTimeMinutes != null
                                ? $"{Model.TestType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Current status</span>

                        <strong>
                            @if (isVerified)
                            {
                                <span class="status-pill verified">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Verified
                                </span>
                            }
                            else if (isCompleted)
                            {
                                <span class="status-pill completed">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="status-pill review">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    @Model.Status
                                </span>
                            }
                        </strong>
                    </div>

                </div>


                <!-- RESULT CLASSIFICATION -->
                @if (result != null)
                {
                    <div class="classification-panel @(isAbnormal == true ? "abnormal-panel" : isAbnormal == false ? "normal-panel" : "unknown-panel")">

                        <span>Result classification</span>

                        @if (isAbnormal == true)
                        {
                            <strong>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal
                            </strong>
                        }
                        else if (isAbnormal == false)
                        {
                            <strong>
                                <i class="fa-solid fa-circle-check"></i>
                                Within expected range
                            </strong>
                        }
                        else
                        {
                            <strong>
                                <i class="fa-solid fa-circle-question"></i>
                                Classification not available
                            </strong>
                        }

                    </div>
                }


                <!-- TIMESTAMPS -->

                <div class="subsection-heading">
                    <i class="fa-solid fa-clock"></i>
                    Test timeline
                </div>

                <div class="timeline-grid">

                    <div>
                        <span>Start time</span>
                        <strong>
                            @(Model.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded")
                        </strong>
                    </div>

                    <div>
                        <span>Completion time</span>
                        <strong>
                            @(Model.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded")
                        </strong>
                    </div>

                </div>

            </div>

        </section>

    </div>


    <!-- LABORATORY RESULT -->

    <section class="information-card result-section">

        <div class="card-header">
            <h2><i class="fa-solid fa-microscope"></i> Laboratory result</h2>
        </div>

        <div class="card-body">

            @if (result != null)
            {
                <div class="result-grid">

                    <div class="result-box result-value-box @(isAbnormal == true ? "abnormal-result" : "")">

                        <span class="result-label">Result value</span>

                        <strong class="result-value">
                            @(string.IsNullOrWhiteSpace(result.ResultValue)
                                ? "Not recorded"
                                : result.ResultValue)
                        </strong>

                        @if (isAbnormal == true)
                        {
                            <span class="abnormal-indicator">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal result
                            </span>
                        }

                    </div>

                    <div class="result-box">
                        <span class="result-label">Units</span>

                        <strong class="result-standard-value">
                            @unit
                        </strong>
                    </div>

                    <div class="result-box">
                        <span class="result-label">Reference range</span>

                        <strong class="result-standard-value">
                            @referenceRange
                        </strong>
                    </div>

                </div>

                <div class="comments-box">
                    <div class="notes-heading">
                        <i class="fa-solid fa-comment-medical"></i>
                        Laboratory comments
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(result.Comments)
                            ? "No laboratory comments recorded."
                            : result.Comments)
                    </p>
                </div>

                <div class="capture-info">

                    <div>
                        <span>Captured by</span>
                        <strong>
                            @(result.CapturedByTechnician?.FullName
                                ?? result.CapturedByTechnician?.UserName
                                ?? "Unknown")
                        </strong>
                    </div>

                    <div>
                        <span>Date captured</span>
                        <strong>
                            @result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                        </strong>
                    </div>

                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-solid fa-file-circle-exclamation"></i>
                    <h3>No laboratory result found</h3>
                    <p>There is currently no result recorded for this test.</p>
                </div>
            }

        </div>

    </section>


    <!-- RETURN HISTORY -->
    @if (returnedEntries.Any())
    {
        <section class="information-card return-history-section">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-rotate-left"></i>
                    Return history
                    <span class="history-count">@returnedEntries.Count</span>
                </h2>
            </div>

            <div class="card-body">

                <div class="return-list">

                    @for (var i = 0; i < returnedEntries.Count; i++)
                    {
                        var entry = returnedEntries[i];

                        <div class="return-item">

                            <div class="return-item-head">
                                <strong>Return #@(i + 1)</strong>
                                <span>@entry.VerificationDate.ToString("dd MMM yyyy HH:mm")</span>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(entry.VerificationNotes)
                                    ? "No reason was provided."
                                    : entry.VerificationNotes)
                            </p>

                            <div class="return-item-by">
                                <i class="fa-solid fa-user-check"></i>
                                Returned by
                                @(entry.VerifiedByTechnician?.FullName
                                    ?? entry.VerifiedByTechnician?.UserName
                                    ?? "Unknown")
                            </div>

                        </div>
                    }

                </div>

            </div>

        </section>
    }


    <!-- VERIFICATION INFORMATION -->
    @if (verification != null || result?.VerifiedByTechnician != null)
    {
        <section class="information-card verification-section">

            <div class="card-header">
                <h2><i class="fa-solid fa-shield-halved"></i> Verification information</h2>
            </div>

            <div class="card-body">

                @if (verification != null)
                {
                    <div class="verification-grid">

                        <div class="verification-item">
                            <span>Decision</span>
                            <strong>@verification.Status</strong>
                        </div>

                        <div class="verification-item">
                            <span>Verified by</span>
                            <strong>
                                @(verification.VerifiedByTechnician?.FullName
                                    ?? verification.VerifiedByTechnician?.UserName
                                    ?? "Unknown")
                            </strong>
                        </div>

                        <div class="verification-item">
                            <span>Verification date</span>
                            <strong>
                                @verification.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(verification.VerificationNotes))
                    {
                        <div class="verification-note">
                            <strong>
                                <i class="fa-solid fa-clipboard-check"></i>
                                Verification notes
                            </strong>

                            <p>@verification.VerificationNotes</p>
                        </div>
                    }
                }
                else if (result?.VerifiedByTechnician != null)
                {
                    <div class="verification-grid">

                        <div class="verification-item">
                            <span>Verified by</span>
                            <strong>
                                @(result.VerifiedByTechnician.FullName
                                    ?? result.VerifiedByTechnician.UserName
                                    ?? "Unknown")
                            </strong>
                        </div>

                        <div class="verification-item">
                            <span>Verification date</span>
                            <strong>
                                @(result.VerificationDate?.ToString("dd MMM yyyy HH:mm")
                                    ?? "Not recorded")
                            </strong>
                        </div>

                    </div>
                }

            </div>

        </section>
    }


    <!-- ACTIONS -->

    <div class="bottom-actions">

        <a asp-action="Completed" class="action-btn secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to completed tests
        </a>

        <a asp-controller="CaptureResults"
           asp-action="Details"
           asp-route-id="@Model.TestRequestItemId"
           class="action-btn primary">
            <i class="fa-solid fa-file-medical"></i>
            View laboratory result
        </a>

    </div>

</div>


<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b7a70;
        --teal-deep: #0a5f58;
        --teal-light: #e1f3f0;
        --teal-soft: #f2f8f7;
        --teal-border: #dbe9e7;
        --text: #12302f;
        --muted: #6f8584;
        --page-bg: #eaf1f1;
        --white: #ffffff;
        --red: #a32626;
        --red-bg: #fde8e8;
        --red-border: #f5c6c6;
        --gold: #8f5a00;
        --gold-bg: #fff3dc;
        --gold-border: #f3d9a0;
        --green: #17814a;
        --green-bg: #e4f6ec;
        --shadow: 0 10px 30px rgba(8, 70, 66, .07);
    }

    .lab-details-page {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 28px 32px 48px;
        color: var(--text);
        font-family: 'Plus Jakarta Sans', 'Segoe UI', sans-serif;
        background: var(--page-bg);
        min-height: 100vh;
        box-sizing: border-box;
        -webkit-font-smoothing: antialiased;
    }

        .lab-details-page *,
        .lab-details-page *::before,
        .lab-details-page *::after {
            box-sizing: border-box;
        }

    /* BANNER */

    .banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
        overflow-wrap: anywhere;
    }

    .banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .banner-stats {
        display: flex;
        align-items: center;
        gap: 32px;
        flex-wrap: wrap;
    }

    .banner-stat {
        text-align: center;
    }

        .banner-stat strong {
            display: block;
            font-size: 20px;
            font-weight: 800;
            line-height: 1.2;
        }

        .banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }

    .banner-btn {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 14px;
        background: #fff;
        color: var(--teal-deep);
        font-size: 13.5px;
        font-weight: 800;
        text-decoration: none;
        box-shadow: 0 6px 16px rgba(0, 0, 0, .12);
        transition: transform .15s ease;
    }

        .banner-btn:hover {
            color: var(--teal-deep);
            transform: translateY(-1px);
        }

    /* LAYOUT */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 24px;
        align-items: stretch;
        margin-bottom: 24px;
    }

    .information-card {
        min-width: 0;
        overflow: hidden;
        background: var(--white);
        border-radius: 24px;
        box-shadow: var(--shadow);
    }

    .card-header {
        padding: 22px 32px;
        border-bottom: 1px solid var(--teal-border);
    }

        .card-header h2 {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--text);
        }

            .card-header h2 i {
                color: var(--teal);
                font-size: 18px;
            }

    .card-body {
        padding: 26px 32px 30px;
    }

    /* PATIENT PROFILE */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px;
        margin-bottom: 20px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 18px;
    }

    .patient-avatar {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff;
        border: 2px solid #d9c27a;
        color: var(--teal-deep);
        font-size: 16px;
        font-weight: 800;
    }

    .patient-profile-text {
        min-width: 0;
    }

    .eyebrow {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
    }

    .patient-profile h3,
    .test-main h3 {
        margin: 0;
        color: var(--teal-deep);
        font-size: 18px;
        line-height: 1.35;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .patient-detail-list {
        display: grid;
    }

    .patient-detail-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
