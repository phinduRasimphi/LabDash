@model LabDash.Models.TestRequestItem
@using LabDash.Models

@{
    ViewData["Title"] = "Laboratory Test Details";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;
    var verification = ViewBag.Verification as TestVerification;

    var patientName = $"{patient?.Name} {patient?.Surname}".Trim();

    var initials = $"{patient?.Name?.FirstOrDefault()}{patient?.Surname?.FirstOrDefault()}"
        .Trim();

    var isVerified = string.Equals(Model.Status, "Verified",
        StringComparison.OrdinalIgnoreCase);

    var isCompleted = string.Equals(Model.Status, "Completed",
        StringComparison.OrdinalIgnoreCase);

    var isAbnormal = result?.IsAbnormal == true;

    var referenceRange = !string.IsNullOrWhiteSpace(result?.ReferenceRange)
        ? result.ReferenceRange
        : Model.TestType?.ReferenceRangeLow != null &&
          Model.TestType?.ReferenceRangeHigh != null
            ? $"{Model.TestType.ReferenceRangeLow} - {Model.TestType.ReferenceRangeHigh}"
            : "Not specified";

    var unit = !string.IsNullOrWhiteSpace(result?.Units)
        ? result.Units
        : Model.TestType?.UnitOfMeasurement ?? "Not specified";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">

<div class="lab-details-page">

    <!-- PATIENT AND TEST INFORMATION -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION: LEFT -->

        <section class="information-card">

            <div class="card-header">
                <i class="fa-solid fa-user"></i>
                <span>Patient Information</span>
            </div>

            <div class="card-body">

                @if (patient != null)
                {
                    <div class="patient-profile">

                        <div class="patient-avatar">
                            @(string.IsNullOrWhiteSpace(initials) ? "P" : initials.ToUpper())
                        </div>

                        <div class="patient-profile-text">
                            <span class="eyebrow">Patient</span>

                            <h2>@patientName</h2>
                        </div>

                    </div>

                    <div class="patient-detail-list">

                        <div class="patient-detail-row">
                            <span>ID Number</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.IDNumber)
                                    ? "Not provided"
                                    : patient.IDNumber)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Email</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.Email)
                                    ? "Not provided"
                                    : patient.Email)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Cellphone</span>
                            <strong>
                                @(string.IsNullOrWhiteSpace(patient.CellphoneNumber)
                                    ? "Not provided"
                                    : patient.CellphoneNumber)
                            </strong>
                        </div>

                        <div class="patient-detail-row">
                            <span>Date of Birth</span>
                            <strong>@patient.DOB.ToString("dd MMM yyyy")</strong>
                        </div>

                    </div>

                    <!-- CLINICAL INFORMATION -->

                    <div class="subsection-heading">
                        <i class="fa-solid fa-notes-medical"></i>
                        Clinical Information
                    </div>

                    <div class="clinical-list">

                        <div class="clinical-item allergy">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <strong>Allergies</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.Allergies)
                                    ? "None recorded"
                                    : patient.Allergies)
                            </p>
                        </div>

                        <div class="clinical-item condition">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-heart-pulse"></i>
                                <strong>Medical Conditions</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.MedicalConditions)
                                    ? "None recorded"
                                    : patient.MedicalConditions)
                            </p>
                        </div>

                        <div class="clinical-item medication">
                            <div class="clinical-item-heading">
                                <i class="fa-solid fa-pills"></i>
                                <strong>Medication</strong>
                            </div>

                            <p>
                                @(string.IsNullOrWhiteSpace(patient.Medication)
                                    ? "None recorded"
                                    : patient.Medication)
                            </p>
                        </div>

                    </div>
                }
                else
                {
                    <div class="empty-state">
                        Patient information is unavailable.
                    </div>
                }

                <!-- DOCTOR NOTES -->

                <div class="subsection-heading">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor Clinical Notes
                </div>

                <div class="doctor-notes">

                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's Notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(Model.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided."
                            : Model.TestRequest.ClinicalNotes)
                    </p>

                </div>

            </div>

        </section>


        <!-- TEST INFORMATION: RIGHT -->

        <section class="information-card">

            <div class="card-header">
                <i class="fa-solid fa-vials"></i>
                <span>Test Information</span>
            </div>

            <div class="card-body">

                <div class="test-main">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-main-content">

                        <span class="eyebrow">Laboratory Test</span>

                        <h2>
                            @(Model.TestType?.Name ?? "Laboratory Test")
                        </h2>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(Model.TestType?.Category ?? "Uncategorised")
                        </span>

                    </div>

                </div>


                <!-- SAMPLE TYPE AND CATEGORY -->

                <div class="sample-category-grid">

                    <div class="sample-category-item">
                        <span>
                            <i class="fa-solid fa-droplet"></i>
                            Sample Type
                        </span>

                        <strong>
                            @(Model.TestType?.RequiredSampleType ?? "Not specified")
                        </strong>
                    </div>

                    <div class="sample-category-item">
                        <span>
                            <i class="fa-solid fa-flask"></i>
                            Test Category
                        </span>

                        <strong>
                            @(Model.TestType?.Category ?? "Not specified")
                        </strong>
                    </div>

                </div>


                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail-item">
                        <span>Request Number</span>
                        <strong>TR-@Model.RequestId</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Test Item</span>
                        <strong>#@Model.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Unit of Measurement</span>
                        <strong>@unit</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Reference Range</span>
                        <strong>@referenceRange</strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Turnaround Time</span>
                        <strong>
                            @(Model.TestType?.TurnaroundTimeMinutes != null
                                ? $"{Model.TestType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail-item">
                        <span>Current Status</span>

                        <strong>
                            @if (isVerified)
                            {
                                <span class="status-pill verified">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Verified
                                </span>
                            }
                            else if (isCompleted)
                            {
                                <span class="status-pill completed">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Completed
                                </span>
                            }
                            else
                            {
                                <span class="status-pill review">
                                    <i class="fa-solid fa-rotate-left"></i>
                                    @Model.Status
                                </span>
                            }
                        </strong>
                    </div>

                </div>


                <!-- RESULT CLASSIFICATION -->

                @if (result != null)
                {
                    <div class="classification-panel @(isAbnormal ? "abnormal-panel" : "normal-panel")">

                        <span>Result Classification</span>

                        @if (isAbnormal)
                        {
                            <strong>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal
                            </strong>
                        }
                        else
                        {
                            <strong>
                                <i class="fa-solid fa-circle-check"></i>
                                Within Expected Range
                            </strong>
                        }

                    </div>
                }


                <!-- TIMESTAMPS -->

                <div class="subsection-heading timeline-heading">
                    <i class="fa-solid fa-clock"></i>
                    Test Timeline
                </div>

                <div class="timeline-grid">

                    <div>
                        <span>Start Time</span>
                        <strong>
                            @(Model.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded")
                        </strong>
                    </div>

                    <div>
                        <span>Completion Time</span>
                        <strong>
                            @(Model.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "Not recorded")
                        </strong>
                    </div>

                </div>

            </div>

        </section>

    </div>


    <!-- LABORATORY RESULT -->

    <section class="information-card result-section">

        <div class="card-header">
            <i class="fa-solid fa-microscope"></i>
            <span>Laboratory Result</span>
        </div>

        <div class="card-body">

            @if (result != null)
            {
                <div class="result-grid">

                    <div class="result-box result-value-box @(isAbnormal ? "abnormal-result" : "")">

                        <span class="result-label">Result Value</span>

                        <strong class="result-value">
                            @(string.IsNullOrWhiteSpace(result.ResultValue)
                                ? "Not recorded"
                                : result.ResultValue)
                        </strong>

                        @if (isAbnormal)
                        {
                            <span class="abnormal-indicator">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal result
                            </span>
                        }

                    </div>

                    <div class="result-box">
                        <span class="result-label">Units</span>

                        <strong class="result-standard-value">
                            @(string.IsNullOrWhiteSpace(result.Units)
                                ? "Not specified"
                                : result.Units)
                        </strong>
                    </div>

                    <div class="result-box">
                        <span class="result-label">Reference Range</span>

                        <strong class="result-standard-value">
                            @(string.IsNullOrWhiteSpace(result.ReferenceRange)
                                ? "Not specified"
                                : result.ReferenceRange)
                        </strong>
                    </div>

                </div>

                <div class="comments-box">
                    <div class="notes-heading">
                        <i class="fa-solid fa-comment-medical"></i>
                        Laboratory Comments
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(result.Comments)
                            ? "No laboratory comments recorded."
                            : result.Comments)
                    </p>
                </div>

                <div class="capture-info">

                    <div>
                        <span>Captured By</span>
                        <strong>
                            @(result.CapturedByTechnician?.FullName
                                ?? result.CapturedByTechnician?.UserName
                                ?? "Unknown")
                        </strong>
                    </div>

                    <div>
                        <span>Date Captured</span>
                        <strong>
                            @result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                        </strong>
                    </div>

                </div>
            }
            else
            {
                <div class="empty-state">
                    <i class="fa-solid fa-file-circle-exclamation"></i>
                    <h3>No laboratory result found</h3>
                    <p>There is currently no result recorded for this test.</p>
                </div>
            }

        </div>

    </section>


    <!-- VERIFICATION INFORMATION -->

    @if (verification != null || result?.VerifiedByTechnician != null)
    {
        <section class="information-card verification-section">

            <div class="card-header">
                <i class="fa-solid fa-shield-halved"></i>
                <span>Verification Information</span>
            </div>

            <div class="card-body">

                @if (verification != null)
                {
                    <div class="verification-grid">

                        <div class="verification-item">
                            <span>Decision</span>
                            <strong>@verification.Status</strong>
                        </div>

                        <div class="verification-item">
                            <span>Verified By</span>
                            <strong>
                                @(verification.VerifiedByTechnician?.FullName
                                    ?? verification.VerifiedByTechnician?.UserName
                                    ?? "Unknown")
                            </strong>
                        </div>

                        <div class="verification-item">
                            <span>Verification Date</span>
                            <strong>
                                @verification.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            </strong>
                        </div>

                    </div>

                    @if (!string.IsNullOrWhiteSpace(verification.VerificationNotes))
                    {
                        <div class="verification-note">
                            <strong>
                                <i class="fa-solid fa-clipboard-check"></i>
                                Verification Notes
                            </strong>

                            <p>@verification.VerificationNotes</p>
                        </div>
                    }
                }
                else if (result?.VerifiedByTechnician != null)
                {
                    <div class="verification-grid">

                        <div class="verification-item">
                            <span>Verified By</span>
                            <strong>
                                @(result.VerifiedByTechnician.FullName
                                    ?? result.VerifiedByTechnician.UserName
                                    ?? "Unknown")
                            </strong>
                        </div>

                        <div class="verification-item">
                            <span>Verification Date</span>
                            <strong>
                                @(result.VerificationDate?.ToString("dd MMM yyyy HH:mm")
                                    ?? "Not recorded")
                            </strong>
                        </div>

                    </div>
                }

            </div>

        </section>
    }


    <!-- ACTIONS -->

    <div class="bottom-actions">

        <a asp-action="Completed" class="action-btn secondary">
            <i class="fa-solid fa-arrow-left"></i>
            Back to Completed Tests
        </a>

        <a asp-controller="CaptureResults"
           asp-action="Details"
           asp-route-id="@Model.TestRequestItemId"
           class="action-btn primary">
            <i class="fa-solid fa-file-medical"></i>
            View Laboratory Result
        </a>

    </div>

</div>


<style>
    :root {
        --teal: #008f83;
        --teal-dark: #006f67;
        --teal-deep: #005c55;
        --teal-light: #e8f7f5;
        --teal-soft: #f1faf8;
        --teal-border: #ccebe7;
        --teal-bright: #00a99a;

        --text: #173a3a;
        --muted: #718785;
        --border: #dfedeb;
        --page-bg: #f3faf9;
        --white: #ffffff;

        --red: #b8323c;
        --red-bg: #fdebec;
        --red-border: #f5c9cd;

        --gold: #91651a;
        --gold-bg: #fff4dc;
        --gold-border: #f2dfb0;

        --green: #168653;
        --green-bg: #e8f7ef;

        --shadow: 0 5px 22px rgba(0, 79, 72, .06);
    }

    .lab-details-page {
        width: 100%;
        max-width: 1450px;
        margin: 0 auto;
        padding: 18px 22px 42px;
        color: var(--text);
        font-family: 'Inter', sans-serif;
        box-sizing: border-box;
    }

    .lab-details-page *,
    .lab-details-page *::before,
    .lab-details-page *::after {
        box-sizing: border-box;
    }

    /* INFORMATION LAYOUT */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        align-items: stretch;
        margin-bottom: 20px;
    }

    .information-card {
        min-width: 0;
        overflow: hidden;
        background: var(--white);
        border: 1px solid var(--border);
        border-radius: 17px;
        box-shadow: var(--shadow);
    }

    .card-header {
        min-height: 47px;
        padding: 14px 19px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--teal);
        color: white;
        font-size: 13px;
        font-weight: 800;
    }

    .card-header i {
        font-size: 14px;
    }

    .card-body {
        padding: 18px;
    }

    /* PATIENT PROFILE */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        margin-bottom: 17px;
        background: linear-gradient(120deg, var(--teal-soft), #f8fcfb);
        border: 1px solid var(--teal-border);
        border-radius: 13px;
    }

    .patient-avatar {
        width: 48px;
        height: 48px;
        flex: 0 0 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #d8f1ed;
        color: var(--teal-dark);
        font-size: 16px;
        font-weight: 800;
    }

    .patient-profile-text {
        min-width: 0;
    }

    .eyebrow {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .patient-profile h2,
    .test-main h2 {
        margin: 0;
        color: var(--teal-deep);
        font-family: 'Poppins', sans-serif;
        font-size: 16px;
        line-height: 1.45;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .patient-detail-list {
        display: grid;
        gap: 0;
    }

    .patient-detail-row {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 15px;
        padding: 10px 2px;
        border-bottom: 1px solid #e8f0ef;
    }

    .patient-detail-row span {
        color: #496663;
        font-size: 11px;
        flex-shrink: 0;
    }

    .patient-detail-row strong {
        max-width: 65%;
        color: var(--text);
        font-size: 11px;
        text-align: right;
        overflow-wrap: anywhere;
    }

    /* SECTION HEADINGS */

    .subsection-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 19px 0 11px;
        color: var(--teal-dark);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .subsection-heading i {
        color: var(--teal);
    }

    /* CLINICAL INFORMATION */

    .clinical-list {
        display: grid;
        gap: 9px;
    }

    .clinical-item {
        padding: 11px 12px;
        border: 1px solid transparent;
        border-radius: 11px;
    }

    .clinical-item.allergy {
        color: #a62e39;
        background: var(--red-bg);
        border-color: var(--red-border);
    }

    .clinical-item.condition {
        color: #875d12;
        background: var(--gold-bg);
        border-color: var(--gold-border);
    }

    .clinical-item.medication {
        color: var(--teal-dark);
        background: #e2f5f2;
        border-color: #c5e9e4;
    }

    .clinical-item-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 10px;
    }

    .clinical-item p {
        margin: 5px 0 0;
        font-size: 11px;
        line-height: 1.55;
        overflow-wrap: anywhere;
    }

    /* DOCTOR NOTES */

    .doctor-notes {
        padding: 13px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 11px;
    }

    .notes-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .doctor-notes p,
    .comments-box p {
        margin: 8px 0 0;
        font-size: 11px;
        line-height: 1.7;
        overflow-wrap: anywhere;
    }

    /* TEST PROFILE */

    .test-main {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px;
        margin-bottom: 12px;
        background: linear-gradient(120deg, #edf9f7, #f8fcfb);
        border: 2px solid #b6e2dc;
        border-radius: 14px;
    }

    .test-icon {
        width: 50px;
        height: 50px;
        flex: 0 0 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #d5efeb;
        color: var(--teal-dark);
        font-size: 21px;
    }

    .test-main-content {
        min-width: 0;
    }

    .test-main h2 {
        margin-bottom: 6px;
        font-size: 15px;
    }

    .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 9px;
        border: 1px solid var(--teal-border);
        border-radius: 20px;
        background: white;
        color: var(--teal-dark);
        font-size: 9px;
        font-weight: 700;
    }

    /* SAMPLE AND CATEGORY */

    .sample-category-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

    .sample-category-item {
        min-width: 0;
        padding: 11px 12px;
        background: var(--teal-soft);
        border: 1px solid #c6e7e2;
        border-left: 4px solid var(--teal);
        border-radius: 11px;
    }

    .sample-category-item span {
        display: block;
        margin-bottom: 5px;
        color: #55716e;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .sample-category-item span i {
        margin-right: 4px;
    }

    .sample-category-item strong {
        display: block;
        color: var(--teal-deep);
        font-size: 11px;
        overflow-wrap: anywhere;
    }

    /* TEST DETAILS */

    .test-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .test-detail-item {
        min-width: 0;
        min-height: 57px;
        padding: 10px;
        background: #f7fbfa;
        border: 1px solid var(--border);
        border-radius: 11px;
    }

    .test-detail-item > span {
        display: block;
        margin-bottom: 6px;
        color: #65807c;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .test-detail-item > strong {
        display: block;
        color: var(--teal-deep);
        font-size: 11px;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    /* STATUS PILLS */

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        width: fit-content;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
    }

    .status-pill.verified {
        color: var(--green);
        background: var(--green-bg);
    }

    .status-pill.completed {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .status-pill.review {
        color: var(--gold);
        background: var(--gold-bg);
    }

    /* CLASSIFICATION */

    .classification-panel {
        display: flex;
        flex-direction: column;
        gap: 7px;
        margin-top: 12px;
        padding: 13px;
        border: 1px solid var(--teal-border);
        border-radius: 11px;
        background: #edf8f6;
    }

    .classification-panel > span {
        color: #52716d;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .classification-panel strong {
        font-size: 12px;
    }

    .classification-panel.normal-panel strong {
        color: var(--green);
    }

    .classification-panel.abnormal-panel {
