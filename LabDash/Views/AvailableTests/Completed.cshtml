@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Completed Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var completedToday = Model.Count(x =>
        x.CompletionDateTime.HasValue &&
        x.CompletionDateTime.Value.Date == DateTime.Today);

    var totalCompleted = Model.Count();

    double averageHours = 0;

    var completedWithDates = Model
        .Where(x => x.StartDateTime.HasValue && x.CompletionDateTime.HasValue)
        .ToList();

    if (completedWithDates.Any())
    {
        averageHours = completedWithDates
            .Average(x => (x.CompletionDateTime.Value - x.StartDateTime.Value).TotalHours);
    }
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<style>

    body {
        background: #eef7f8;
        font-family: 'Segoe UI',sans-serif;
    }

    .page-container {
        max-width: 1450px;
        margin: 35px auto;
    }

    .page-header {
        background: linear-gradient(135deg,#009688,#00796B);
        color: white;
        border-radius: 18px;
        padding: 30px 35px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 30px;
        box-shadow: 0 12px 30px rgba(0,0,0,.10);
    }

        .page-header h2 {
            margin: 0;
            font-size: 34px;
            font-weight: 700;
        }

        .page-header p {
            margin-top: 8px;
            opacity: .92;
        }

    .header-icon {
        width: 80px;
        height: 80px;
        border-radius: 20px;
        background: rgba(255,255,255,.15);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 34px;
    }

    .stats {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 20px;
        margin-bottom: 30px;
    }

    .stat-card {
        background: white;
        border-radius: 16px;
        padding: 22px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        box-shadow: 0 8px 22px rgba(0,0,0,.08);
        transition: .25s;
    }

        .stat-card:hover {
            transform: translateY(-4px);
        }

        .stat-card h6 {
            color: #666;
            margin-bottom: 8px;
            font-size: 15px;
        }

        .stat-card h3 {
            margin: 0;
            color: #009688;
            font-size: 32px;
            font-weight: bold;
        }

    .stat-icon {
        width: 60px;
        height: 60px;
        border-radius: 15px;
        background: rgba(0,150,136,.12);
        display: flex;
        justify-content: center;
        align-items: center;
        color: #009688;
        font-size: 24px;
    }

    .table-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        box-shadow: 0 10px 25px rgba(0,0,0,.08);
    }

    .table-toolbar {
        padding: 22px 25px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #ececec;
    }

        .table-toolbar h4 {
            margin: 0;
            color: #009688;
            font-weight: 700;
        }

    .search-box {
        width: 350px;
        position: relative;
    }

        .search-box i {
            position: absolute;
            left: 15px;
            top: 15px;
            color: gray;
        }

        .search-box input {
            border-radius: 30px;
            padding-left: 42px;
            height: 46px;
        }

    .table {
        margin-bottom: 0;
    }

        .table thead {
            background: #00897B;
            color: white;
        }

        .table th {
            text-align: center;
            padding: 16px;
            border: none;
        }

        .table td {
            text-align: center;
            vertical-align: middle;
            padding: 18px;
        }

        .table tbody tr:hover {
            background: #f5fbfb;
        }

    .badge-complete {
        background: #009688;
        color: white;
        padding: 8px 16px;
        border-radius: 30px;
        font-size: 13px;
        font-weight: 600;
    }

    .empty-state {
        padding: 70px;
        text-align: center;
    }

        .empty-state i {
            font-size: 70px;
            color: #009688;
            margin-bottom: 20px;
        }

        .empty-state h3 {
            color: #444;
        }

        .empty-state p {
            color: gray;
        }

    @@media(max-width:992px) {

        .stats {
            grid-template-columns: 1fr;
        }

        .page-header {
            flex-direction: column;
            text-align: center;
            gap: 20px;
        }

        .table-toolbar {
            flex-direction: column;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }
    }

</style>

<div class="page-container">

    <div class="page-header">

        <div>

            <h2>

                <i class="fa-solid fa-circle-check"></i>

                Completed Tests

            </h2>

            <p>

                View all laboratory tests that you have successfully completed.

            </p>

        </div>

        <div class="header-icon">

            <i class="fa-solid fa-award"></i>

        </div>

    </div>

    <div class="stats">

        <div class="stat-card">

            <div>

                <h6>Total Completed</h6>

                <h3>@totalCompleted</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-vials"></i>

            </div>

        </div>

        <div class="stat-card">

            <div>

                <h6>Completed Today</h6>

                <h3>@completedToday</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-calendar-check"></i>

            </div>

        </div>

        <div class="stat-card">

            <div>

                <h6>Average Turnaround</h6>

                <h3>@averageHours.ToString("0.0") h</h3>

            </div>

            <div class="stat-icon">

                <i class="fa-solid fa-clock"></i>

            </div>

        </div>

    </div>

    <div class="table-card">

        <div class="table-toolbar">

            <h4>

                <i class="fa-solid fa-list-check"></i>

                Completed Laboratory Tests

            </h4>

            <div class="search-box">

                <i class="fa-solid fa-search"></i>

                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search completed tests..." />

            </div>

        </div>
        @if (!Model.Any())
        {
            <div class="empty-state">

                <i class="fa-solid fa-circle-check"></i>

                <h3>No Completed Tests</h3>

                <p>

                    You have not completed any laboratory tests yet.

                </p>

            </div>
        }
        else
        {

            <table class="table table-hover">

                <thead>

                    <tr>

                        <th>Request</th>

                        <th>Test Type</th>

                        <th>Category</th>

                        <th>Started</th>

                        <th>Completed</th>

                        <th>Turnaround Time</th>

                        <th>Status</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        TimeSpan? turnaround = null;

                        if (item.StartDateTime.HasValue &&
                            item.CompletionDateTime.HasValue)
                        {
                            turnaround =
                                item.CompletionDateTime.Value -
                                item.StartDateTime.Value;
                        }

                        <tr>

                            <td>

                                <strong>TR-@item.RequestId</strong>

                            </td>

                            <td>

                                @item.TestType.Name

                            </td>

                            <td>

                                @item.TestType.Category

                            </td>

                            <td>

                                @item.StartDateTime?.ToString("dd MMM yyyy HH:mm")

                            </td>

                            <td>

                                @item.CompletionDateTime?.ToString("dd MMM yyyy HH:mm")

                            </td>

                            <td>

                                @if (turnaround != null)
                                {
                                    <span class="text-success fw-semibold">

                                        <i class="fa-solid fa-clock"></i>

                                        @turnaround.Value.Days d
                                        @turnaround.Value.Hours h
                                        @turnaround.Value.Minutes m

                                    </span>
                                }
                                else
                                {
                                    <span class="text-muted">

                                        -

                                    </span>
                                }

                            </td>

                            <td>

                                <span class="badge-complete">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Completed

                                </span>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        }

    </div>

</div>

@section Scripts
{

    <script>

        document.getElementById("searchInput").addEventListener("keyup", function () {

            var value = this.value.toLowerCase();

            document.querySelectorAll("tbody tr").forEach(function (row) {

                row.style.display =
                    row.innerText.toLowerCase().includes(value)
                    ? ""
                    : "none";

            });

        });

    </script>

}