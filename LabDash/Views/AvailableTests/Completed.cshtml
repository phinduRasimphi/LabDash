@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Completed Laboratory Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600&family=IBM+Plex+Mono:wght@400;500;600&display=swap" rel="stylesheet">

<div class="cp-wrap">

    <div class="cp-header">
        <div>
            <p class="cp-eyebrow"><i class="fa-solid fa-circle-check"></i> Laboratory · work queue</p>
            <h1>Completed laboratory tests</h1>
            <p class="cp-sub">Review completed, verified and returned laboratory tests assigned to you.</p>
        </div>
        <a asp-action="InProgress" class="cp-tab-link">
            <i class="fa-solid fa-arrow-left"></i> Back to in progress
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="cp-alert cp-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="cp-alert-close" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <div class="cp-stats">
        <div class="cp-stat c-teal">
            <i class="fa-solid fa-vial-circle-check"></i>
            <div>
                <small>Completed</small>
                <div class="num">@ViewBag.TotalCompleted</div>
            </div>
        </div>
        <div class="cp-stat c-teal-deep">
            <i class="fa-solid fa-shield-check"></i>
            <div>
                <small>Verified</small>
                <div class="num">@ViewBag.TotalVerified</div>
            </div>
        </div>
        <div class="cp-stat c-gold">
            <i class="fa-solid fa-rotate-left"></i>
            <div>
                <small>Returned for review</small>
                <div class="num">@ViewBag.Returned</div>
            </div>
        </div>
    </div>

    <div class="cp-search-row">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" class="cp-search" placeholder="search patient or laboratory test..." />
    </div>

    <div class="cp-panel-label">Laboratory test history <span class="cp-count">@Model.Count() tests</span></div>

    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Test</th>
                    <th>Completed</th>
                    <th>Status</th>
                    <th>Technician</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="completedTable">
                @foreach (var item in Model)
                {
                    var initials = $"{item.TestRequest.Patient.Name?.FirstOrDefault()}{item.TestRequest.Patient.Surname?.FirstOrDefault()}";

                    <tr>
                        <td>
                            <div class="cp-patient">
                                <div class="cp-avatar">@initials</div>
                                <div>
                                    <strong>@item.TestRequest.Patient.Name @item.TestRequest.Patient.Surname</strong>
                                    <small>@item.TestRequest.Patient.IDNumber</small>
                                </div>
                            </div>
                        </td>

                        <td>
                            <strong>@item.TestType.Name</strong>
                            <small>@item.TestType.Category</small>
                        </td>

                        <td class="cp-mono">
                            @if (item.CompletionDateTime.HasValue)
                            {
                                @item.CompletionDateTime.Value.ToString("dd MMM yyyy HH:mm")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>
                            @if (item.Status == "Verified")
                            {
                                <span class="cp-badge verified"><i class="fa-solid fa-shield-check"></i> Verified</span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="cp-badge completed"><i class="fa-solid fa-circle-check"></i> Completed</span>
                            }
                            else
                            {
                                <span class="cp-badge review"><i class="fa-solid fa-rotate-left"></i> To be reviewed</span>
                            }
                        </td>

                        <td>@(item.AssignedTechnician?.FullName ?? item.AssignedTechnician?.UserName)</td>

                        <td>
                            <div class="cp-actions">
                                <a asp-action="ProcessTest" asp-route-id="@item.TestRequestItemId" class="cp-btn cp-btn-outline">
                                    <i class="fa-solid fa-eye"></i> View
                                </a>
                                <a asp-controller="CaptureResults" asp-action="Details" asp-route-id="@item.TestRequestItemId" class="cp-btn cp-btn-solid">
                                    <i class="fa-solid fa-file-medical"></i> Results
                                </a>
                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr class="cp-empty-row">
                        <td colspan="6">
                            <div class="cp-empty">
                                <i class="fa-solid fa-folder-open"></i>
                                <h3>No completed tests</h3>
                                <p>You have not completed, verified, or received any laboratory tests for review yet.</p>
                                <a asp-action="InProgress" class="cp-btn cp-btn-solid">
                                    <i class="fa-solid fa-flask"></i> Return to in progress
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --cp-paper: #F3F8F7;
        --cp-raised: #FFFFFF;
        --cp-ink: #14302C;
        --cp-ink-soft: #4B6864;
        --cp-ink-faint: #86A19C;
        --cp-line: #D6E6E3;
        --cp-line-strong: #A9C9C3;

        --cp-teal: #0E7C72;
        --cp-teal-deep: #0A5850;
        --cp-teal-dim: #E1F3F0;

        --cp-gold: #A9822A; --cp-gold-dim: #F6EFDC;
        --cp-red: #B0463F; --cp-red-dim: #F7E8E7;
    }

    .cp-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 0 60px; color: var(--cp-ink); font-family: 'Inter', sans-serif; }

    .cp-eyebrow { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; letter-spacing: .12em; text-transform: uppercase; color: var(--cp-teal); margin: 0 0 8px; display: flex; align-items: center; gap: 8px; }
    .cp-header { display: flex; justify-content: space-between; align-items: flex-end; border-bottom: 2px solid var(--cp-teal); padding-bottom: 22px; margin-bottom: 24px; }
    .cp-header h1 { font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 30px; margin: 0 0 6px; letter-spacing: -.01em; }
    .cp-sub { margin: 0; color: var(--cp-ink-soft); font-size: 15px; max-width: 480px; }
    .cp-tab-link { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; letter-spacing: .04em; text-decoration: none; color: var(--cp-teal); border: 1px solid var(--cp-teal); padding: 10px 18px; display: inline-flex; align-items: center; gap: 8px; transition: .15s; background: var(--cp-raised); white-space: nowrap; }
    .cp-tab-link:hover { background: var(--cp-teal); color: #fff; }

    .cp-alert { display: flex; align-items: center; gap: 10px; padding: 13px 16px; font-size: 14px; border: 1px solid var(--cp-line-strong); border-left: 3px solid var(--cp-teal); margin-bottom: 18px; }
    .cp-alert-success { background: var(--cp-teal-dim); color: var(--cp-teal-deep); border-left-color: var(--cp-teal); }
    .cp-alert span { flex: 1; }
    .cp-alert-close { background: none; border: none; cursor: pointer; color: inherit; opacity: .6; font-size: 13px; }
    .cp-alert-close:hover { opacity: 1; }

    .cp-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1px; background: var(--cp-line-strong); border: 1px solid var(--cp-line-strong); margin-bottom: 26px; }
    .cp-stat { background: var(--cp-raised); padding: 18px 20px; border-top: 3px solid var(--cp-teal); display: flex; align-items: center; gap: 16px; }
    .cp-stat.c-teal { border-top-color: var(--cp-teal); }
    .cp-stat.c-teal-deep { border-top-color: var(--cp-teal-deep); }
    .cp-stat.c-gold { border-top-color: var(--cp-gold); }
    .cp-stat i { font-size: 22px; color: var(--cp-teal); opacity: .5; }
    .cp-stat.c-gold i { color: var(--cp-gold); }
    .cp-stat small { display: block; font-family: 'IBM Plex Mono', monospace; font-size: 11px; letter-spacing: .1em; text-transform: uppercase; color: var(--cp-ink-faint); margin-bottom: 6px; }
    .cp-stat .num { font-family: 'Space Grotesk', sans-serif; font-size: 28px; font-weight: 700; color: var(--cp-ink); }

    .cp-search-row { margin-bottom: 22px; position: relative; }
    .cp-search-row i { position: absolute; left: 16px; top: 50%; transform: translateY(-50%); color: var(--cp-ink-faint); font-size: 14px; }
    .cp-search { width: 100%; padding: 13px 16px 13px 42px; border: 1px solid var(--cp-line-strong); background: var(--cp-raised); font-family: 'IBM Plex Mono', monospace; font-size: 13.5px; color: var(--cp-ink); outline: none; transition: border-color .15s, box-shadow .15s; }
    .cp-search::placeholder { color: var(--cp-ink-faint); }
    .cp-search:focus { border-color: var(--cp-teal); box-shadow: 0 0 0 3px var(--cp-teal-dim); }

    .cp-panel-label { font-family: 'IBM Plex Mono', monospace; font-size: 12px; letter-spacing: .1em; text-transform: uppercase; color: var(--cp-teal-deep); margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
    .cp-count { font-family: 'IBM Plex Mono', monospace; font-size: 11px; color: var(--cp-ink-faint); text-transform: none; letter-spacing: normal; background: var(--cp-teal-dim); padding: 3px 9px; }

    .cp-table-wrap { background: var(--cp-raised); border: 1px solid var(--cp-line); overflow-x: auto; }
    .cp-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .cp-table thead th { text-align: left; font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: .08em; text-transform: uppercase; color: var(--cp-ink-faint); padding: 14px 18px; border-bottom: 2px solid var(--cp-teal); white-space: nowrap; }
    .cp-table tbody td { padding: 16px 18px; border-bottom: 1px dashed var(--cp-line); vertical-align: middle; }
    .cp-table tbody tr:hover { background: var(--cp-teal-dim); }
    .cp-table tbody tr:last-child td { border-bottom: none; }
    .cp-table strong { display: block; font-size: 14px; color: var(--cp-ink); font-weight: 600; }
    .cp-table small { display: block; font-size: 12px; color: var(--cp-ink-faint); margin-top: 2px; }
    .cp-mono { font-family: 'IBM Plex Mono', monospace; font-size: 12.5px; color: var(--cp-ink-soft); }

    .cp-patient { display: flex; align-items: center; gap: 12px; }
    .cp-avatar { width: 38px; height: 38px; border-radius: 50%; background: var(--cp-teal-deep); color: #fff; display: flex; align-items: center; justify-content: center; font-family: 'Space Grotesk', sans-serif; font-weight: 700; font-size: 13px; flex-shrink: 0; text-transform: uppercase; }

    .cp-badge { font-family: 'IBM Plex Mono', monospace; font-size: 10.5px; letter-spacing: .06em; text-transform: uppercase; padding: 5px 10px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; }
    .cp-badge.verified { background: var(--cp-teal-dim); color: var(--cp-teal-deep); }
    .cp-badge.completed { background: var(--cp-line); color: var(--cp-ink-soft); }
    .cp-badge.review { background: var(--cp-gold-dim); color: var(--cp-gold); }

    .cp-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .cp-btn { font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; padding: 8px 14px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: .15s; white-space: nowrap; }
    .cp-btn-outline { border: 1px solid var(--cp-teal); background: transparent; color: var(--cp-teal-deep); }
    .cp-btn-outline:hover { background: var(--cp-teal); color: #fff; }
    .cp-btn-solid { border: 1px solid var(--cp-teal); background: var(--cp-teal); color: #fff; }
    .cp-btn-solid:hover { background: var(--cp-teal-deep); border-color: var(--cp-teal-deep); }

    .cp-empty { padding: 60px 24px; text-align: center; color: var(--cp-ink-faint); }
    .cp-empty i { font-size: 32px; margin-bottom: 12px; display: block; color: var(--cp-teal); }
    .cp-empty h3 { font-family: 'Space Grotesk', sans-serif; color: var(--cp-ink); margin: 0 0 6px; }
    .cp-empty p { margin: 0 0 18px; }
    .cp-empty .cp-btn { display: inline-flex; }

    @@media (max-width: 900px) {
        .cp-header { flex-direction: column; align-items: flex-start; gap: 14px; }
        .cp-stats { grid-template-columns: 1fr; }
        .cp-actions { flex-direction: column; }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const search = document.getElementById("searchInput");
            if (search) {
                search.addEventListener("keyup", function () {
                    const value = this.value.toLowerCase();
                    const rows = document.querySelectorAll("#completedTable tr");
                    rows.forEach(function (row) {
                        const text = row.innerText.toLowerCase();
                        row.style.display = text.includes(value) ? "" : "none";
                    });
                });
            }
        });
    </script>
}
