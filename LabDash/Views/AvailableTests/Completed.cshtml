@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Completed Laboratory Tests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="cp-wrap">

    <div class="cp-banner">
        <div class="cp-banner-icon"><i class="fa-solid fa-vial-circle-check"></i></div>
        <div class="cp-banner-text">
            <h1>Completed laboratory tests</h1>
            <p>Review completed, verified and returned laboratory tests assigned to you.</p>
        </div>
        <a asp-action="InProgress" class="cp-tab-link">
            <i class="fa-solid fa-arrow-left"></i> Back to in progress
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="cp-alert cp-alert-success">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
            <button type="button" class="cp-alert-close" onclick="this.parentElement.remove()">
                <i class="fa-solid fa-xmark"></i>
            </button>
        </div>
    }

    <div class="cp-stats">
        <div class="cp-stat">
            <div class="cp-stat-icon c-teal"><i class="fa-solid fa-vial-circle-check"></i></div>
            <div>
                <small>Completed</small>
                <div class="num">@ViewBag.TotalCompleted</div>
            </div>
        </div>
        <div class="cp-stat">
            <div class="cp-stat-icon c-teal-deep"><i class="fa-solid fa-shield-check"></i></div>
            <div>
                <small>Verified</small>
                <div class="num">@ViewBag.TotalVerified</div>
            </div>
        </div>
        <div class="cp-stat">
            <div class="cp-stat-icon c-gold"><i class="fa-solid fa-rotate-left"></i></div>
            <div>
                <small>Returned for review</small>
                <div class="num">@ViewBag.Returned</div>
            </div>
        </div>
    </div>

    <div class="cp-search-row">
        <i class="fa-solid fa-magnifying-glass"></i>
        <input type="text" id="searchInput" class="cp-search" placeholder="Search patient or laboratory test..." />
    </div>

    <div class="cp-panel-label">Laboratory test history <span class="cp-count">@Model.Count() tests</span></div>

    <div class="cp-table-wrap">
        <table class="cp-table">
            <thead>
                <tr>
                    <th>Patient</th>
                    <th>Test</th>
                    <th>Completed</th>
                    <th>Status</th>
                    <th>Technician</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody id="completedTable">
                @foreach (var item in Model)
                {
                    var initials = $"{item.TestRequest.Patient.Name?.FirstOrDefault()}{item.TestRequest.Patient.Surname?.FirstOrDefault()}";

                    <tr>
                        <td>
                            <div class="cp-patient">
                                <div class="cp-avatar">@initials</div>
                                <div>
                                    <strong>@item.TestRequest.Patient.Name @item.TestRequest.Patient.Surname</strong>
                                    <small>@item.TestRequest.Patient.IDNumber</small>
                                </div>
                            </div>
                        </td>

                        <td>
                            <strong>@item.TestType.Name</strong>
                            <small>@item.TestType.Category</small>
                        </td>

                        <td class="cp-mono">
                            @if (item.CompletionDateTime.HasValue)
                            {
                                @item.CompletionDateTime.Value.ToString("dd MMM yyyy HH:mm")
                            }
                            else
                            {
                                <span>—</span>
                            }
                        </td>

                        <td>
                            @if (item.Status == "Verified")
                            {
                                <span class="cp-badge verified"><i class="fa-solid fa-shield-check"></i> Verified</span>
                            }
                            else if (item.Status == "Completed")
                            {
                                <span class="cp-badge completed"><i class="fa-solid fa-circle-check"></i> Completed</span>
                            }
                            else
                            {
                                <span class="cp-badge review"><i class="fa-solid fa-rotate-left"></i> To be reviewed</span>
                            }
                        </td>

                        <td>@(item.AssignedTechnician?.FullName ?? item.AssignedTechnician?.UserName)</td>

                        <td>
                            <div class="cp-actions">

                                <!-- VIEW DETAILS -->
                                <a asp-action="CompletedDetails"
                                   asp-route-id="@item.TestRequestItemId"
                                   class="cp-btn cp-btn-outline">
                                    <i class="fa-solid fa-eye"></i>
                                    View
                                </a>

                                <!-- VIEW RESULT -->
                                <a asp-controller="CaptureResults"
                                   asp-action="Details"
                                   asp-route-id="@item.TestRequestItemId"
                                   class="cp-btn cp-btn-solid">
                                    <i class="fa-solid fa-file-medical"></i>
                                    Results
                                </a>

                            </div>
                        </td>
                    </tr>
                }

                @if (!Model.Any())
                {
                    <tr class="cp-empty-row">
                        <td colspan="6">
                            <div class="cp-empty">
                                <i class="fa-solid fa-folder-open"></i>
                                <h3>No completed tests</h3>
                                <p>You have not completed, verified, or received any laboratory tests for review yet.</p>
                                <a asp-action="InProgress" class="cp-btn cp-btn-solid">
                                    <i class="fa-solid fa-flask"></i> Return to in progress
                                </a>
                            </div>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<style>
    :root {
        --cp-paper: #F3F8F7;
        --cp-raised: #FFFFFF;
        --cp-ink: #14302C;
        --cp-ink-soft: #55716C;
        --cp-ink-faint: #90A9A4;
        --cp-line: #E3EEEC;
        --cp-line-strong: #CFE3DF;

        --cp-teal: #0E8C7F;
        --cp-teal-deep: #0A5850;
        --cp-teal-dim: #E5F4F1;
        --cp-teal-grad-start: #12988A;
        --cp-teal-grad-end: #0A5850;

        --cp-gold: #B4862A; --cp-gold-dim: #FBF1DA;
        --cp-red: #B0463F; --cp-red-dim: #F7E8E7;

        --cp-radius: 18px;
        --cp-radius-sm: 12px;
        --cp-shadow: 0 4px 18px rgba(10, 60, 55, 0.06);
        --cp-shadow-sm: 0 2px 8px rgba(10, 60, 55, 0.05);
    }

    .cp-wrap { max-width: 1180px; margin: 0 auto; padding: 24px 0 60px; color: var(--cp-ink); font-family: 'Inter', sans-serif; }

    /* Banner header */
    .cp-banner {
        display: flex;
        align-items: center;
        gap: 20px;
        background: linear-gradient(120deg, var(--cp-teal-grad-start), var(--cp-teal-grad-end));
        border-radius: var(--cp-radius);
        padding: 26px 30px;
        margin-bottom: 26px;
        box-shadow: var(--cp-shadow);
    }
    .cp-banner-icon {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.16);
        border: 2px solid rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }
    .cp-banner-text { flex: 1; }
    .cp-banner h1 { font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 26px; margin: 0 0 4px; color: #fff; letter-spacing: -.01em; }
    .cp-banner p { margin: 0; color: rgba(255, 255, 255, 0.85); font-size: 14.5px; }
    .cp-tab-link {
        font-family: 'Inter', sans-serif; font-weight: 600; font-size: 13.5px;
        text-decoration: none; color: #fff;
        background: rgba(255, 255, 255, 0.14);
        border: 1px solid rgba(255, 255, 255, 0.4);
        border-radius: 999px;
        padding: 10px 20px;
        display: inline-flex; align-items: center; gap: 8px;
        transition: .15s; white-space: nowrap;
    }
    .cp-tab-link:hover { background: rgba(255, 255, 255, 0.26); }

    .cp-alert {
        display: flex; align-items: center; gap: 10px;
        padding: 14px 18px; font-size: 14px;
        background: var(--cp-teal-dim); color: var(--cp-teal-deep);
        border-radius: var(--cp-radius-sm);
        margin-bottom: 20px;
    }
    .cp-alert span { flex: 1; }
    .cp-alert-close { background: none; border: none; cursor: pointer; color: inherit; opacity: .6; font-size: 13px; }
    .cp-alert-close:hover { opacity: 1; }

    /* Stat cards */
    .cp-stats { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 26px; }
    .cp-stat {
        background: var(--cp-raised);
        border-radius: var(--cp-radius);
        box-shadow: var(--cp-shadow-sm);
        padding: 20px 22px;
        display: flex; align-items: center; gap: 16px;
    }
    .cp-stat-icon {
        width: 48px; height: 48px; border-radius: 14px;
        display: flex; align-items: center; justify-content: center;
        font-size: 19px; flex-shrink: 0;
    }
    .cp-stat-icon.c-teal { background: var(--cp-teal-dim); color: var(--cp-teal); }
    .cp-stat-icon.c-teal-deep { background: var(--cp-teal-dim); color: var(--cp-teal-deep); }
    .cp-stat-icon.c-gold { background: var(--cp-gold-dim); color: var(--cp-gold); }
    .cp-stat small { display: block; font-family: 'Inter', sans-serif; font-size: 12px; font-weight: 600; letter-spacing: .03em; text-transform: uppercase; color: var(--cp-ink-faint); margin-bottom: 4px; }
    .cp-stat .num { font-family: 'Poppins', sans-serif; font-size: 26px; font-weight: 700; color: var(--cp-ink); }

    /* Search */
    .cp-search-row { margin-bottom: 22px; position: relative; }
    .cp-search-row i { position: absolute; left: 18px; top: 50%; transform: translateY(-50%); color: var(--cp-ink-faint); font-size: 14px; }
    .cp-search {
        width: 100%; padding: 14px 18px 14px 44px;
        border: 1px solid var(--cp-line-strong);
        border-radius: 999px;
        background: var(--cp-raised);
        font-family: 'Inter', sans-serif; font-size: 14px; color: var(--cp-ink);
        outline: none; transition: border-color .15s, box-shadow .15s;
        box-shadow: var(--cp-shadow-sm);
    }
    .cp-search::placeholder { color: var(--cp-ink-faint); }
    .cp-search:focus { border-color: var(--cp-teal); box-shadow: 0 0 0 4px var(--cp-teal-dim); }

    .cp-panel-label { font-family: 'Inter', sans-serif; font-weight: 700; font-size: 13px; letter-spacing: .02em; color: var(--cp-teal-deep); margin: 0 0 14px; display: flex; align-items: center; gap: 10px; }
    .cp-count { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px; color: var(--cp-teal-deep); background: var(--cp-teal-dim); padding: 4px 11px; border-radius: 999px; }

    /* Table */
    .cp-table-wrap { background: var(--cp-raised); border-radius: var(--cp-radius); box-shadow: var(--cp-shadow); overflow: hidden; overflow-x: auto; }
    .cp-table { width: 100%; border-collapse: collapse; font-size: 14px; }
    .cp-table thead th { text-align: left; font-family: 'Inter', sans-serif; font-weight: 700; font-size: 11.5px; letter-spacing: .04em; text-transform: uppercase; color: var(--cp-ink-faint); padding: 16px 20px; background: var(--cp-teal-dim); white-space: nowrap; }
    .cp-table thead th:first-child { border-top-left-radius: var(--cp-radius); }
    .cp-table thead th:last-child { border-top-right-radius: var(--cp-radius); }
    .cp-table tbody td { padding: 16px 20px; border-bottom: 1px solid var(--cp-line); vertical-align: middle; }
    .cp-table tbody tr { transition: background .12s; }
    .cp-table tbody tr:hover { background: var(--cp-teal-dim); }
    .cp-table tbody tr:last-child td { border-bottom: none; }
    .cp-table strong { display: block; font-size: 14px; color: var(--cp-ink); font-weight: 600; }
    .cp-table small { display: block; font-size: 12px; color: var(--cp-ink-faint); margin-top: 2px; }
    .cp-mono { font-family: 'Inter', sans-serif; font-size: 13px; color: var(--cp-ink-soft); }

    .cp-patient { display: flex; align-items: center; gap: 12px; }
    .cp-avatar { width: 40px; height: 40px; border-radius: 50%; background: linear-gradient(135deg, var(--cp-teal), var(--cp-teal-deep)); color: #fff; display: flex; align-items: center; justify-content: center; font-family: 'Poppins', sans-serif; font-weight: 700; font-size: 13px; flex-shrink: 0; text-transform: uppercase; }

    .cp-badge { font-family: 'Inter', sans-serif; font-weight: 600; font-size: 11.5px; letter-spacing: .02em; padding: 6px 13px; white-space: nowrap; display: inline-flex; align-items: center; gap: 6px; border-radius: 999px; }
    .cp-badge.verified { background: var(--cp-teal-dim); color: var(--cp-teal-deep); }
    .cp-badge.completed { background: var(--cp-line); color: var(--cp-ink-soft); }
    .cp-badge.review { background: var(--cp-gold-dim); color: var(--cp-gold); }

    .cp-actions { display: flex; gap: 8px; flex-wrap: wrap; }
    .cp-btn { font-family: 'Inter', sans-serif; font-size: 12.5px; font-weight: 600; padding: 9px 16px; cursor: pointer; display: inline-flex; align-items: center; gap: 6px; text-decoration: none; transition: .15s; white-space: nowrap; border-radius: 999px; }
    .cp-btn-outline { border: 1px solid var(--cp-teal); background: transparent; color: var(--cp-teal-deep); }
    .cp-btn-outline:hover { background: var(--cp-teal-dim); }
    .cp-btn-solid { border: 1px solid var(--cp-teal); background: var(--cp-teal); color: #fff; }
    .cp-btn-solid:hover { background: var(--cp-teal-deep); border-color: var(--cp-teal-deep); }

    .cp-empty { padding: 60px 24px; text-align: center; color: var(--cp-ink-faint); }
    .cp-empty i { font-size: 32px; margin-bottom: 12px; display: block; color: var(--cp-teal); }
    .cp-empty h3 { font-family: 'Poppins', sans-serif; color: var(--cp-ink); margin: 0 0 6px; }
    .cp-empty p { margin: 0 0 18px; }
    .cp-empty .cp-btn { display: inline-flex; }

    @@media (max-width: 900px) {
        .cp-banner { flex-direction: column; align-items: flex-start; gap: 16px; }
        .cp-stats { grid-template-columns: 1fr; }
        .cp-actions { flex-direction: column; }
    }
</style>

@section Scripts {
    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const search = document.getElementById("searchInput");
            if (search) {
                search.addEventListener("keyup", function () {
                    const value = this.value.toLowerCase();
                    const rows = document.querySelectorAll("#completedTable tr");
                    rows.forEach(function (row) {
                        const text = row.innerText.toLowerCase();
                        row.style.display = text.includes(value) ? "" : "none";
                    });
                });
            }
        });
    </script>
}

