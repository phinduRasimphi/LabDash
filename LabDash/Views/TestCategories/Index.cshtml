```cshtml
@model IEnumerable<LabDash.Models.TestCategory>

@{
    ViewData["Title"] = "Test Categories";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    .page-container {
        padding: 30px;
        background: #f5f7fa;
        min-height: calc(100vh - 70px);
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

    .page-title h1 {
        margin: 0;
        font-size: 28px;
        font-weight: 700;
        color: #172b4d;
    }

    .page-title p {
        margin: 6px 0 0;
        color: #718096;
        font-size: 14px;
    }

    .btn-add {
        background: #0f766e;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-size: 14px;
        font-weight: 600;
        transition: 0.2s;
    }

        .btn-add:hover {
            background: #0d5f59;
            color: white;
            transform: translateY(-1px);
        }

    .content-card {
        background: white;
        border-radius: 14px;
        padding: 22px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        border: 1px solid #edf1f5;
    }

    .toolbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 20px;
    }

    .search-box {
        position: relative;
        width: 320px;
    }

        .search-box i {
            position: absolute;
            left: 13px;
            top: 12px;
            color: #94a3b8;
        }

        .search-box input {
            width: 100%;
            padding: 10px 12px 10px 38px;
            border: 1px solid #dbe2ea;
            border-radius: 8px;
            outline: none;
            font-size: 13px;
        }

            .search-box input:focus {
                border-color: #0f766e;
                box-shadow: 0 0 0 3px rgba(15,118,110,0.08);
            }

    .category-count {
        color: #64748b;
        font-size: 13px;
    }

    .table-container {
        overflow-x: auto;
    }

    .category-table {
        width: 100%;
        border-collapse: collapse;
    }

        .category-table thead {
            background: #f8fafc;
        }

        .category-table th {
            text-align: left;
            padding: 14px;
            color: #64748b;
            font-size: 12px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .3px;
        }

        .category-table td {
            padding: 15px 14px;
            border-bottom: 1px solid #edf1f5;
            color: #475569;
            font-size: 13px;
            vertical-align: middle;
        }

        .category-table tbody tr:hover {
            background: #f8fafc;
        }

    .category-name {
        font-weight: 700;
        color: #172b4d;
    }

    .category-description {
        color: #64748b;
        max-width: 450px;
    }

    .test-count {
        display: inline-block;
        background: #e8f1ff;
        color: #2563eb;
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .action-buttons {
        display: flex;
        gap: 7px;
    }

    .action-btn {
        width: 34px;
        height: 34px;
        border-radius: 7px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        text-decoration: none;
        transition: .2s;
    }

    .btn-view {
        background: #e8f1ff;
        color: #2563eb;
    }

    .btn-edit {
        background: #fff3df;
        color: #d97706;
    }

    .btn-delete {
        background: #fee2e2;
        color: #dc2626;
    }

    .action-btn:hover {
        transform: translateY(-2px);
    }

    .alert {
        padding: 13px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
        font-size: 13px;
    }

    .alert-success {
        background: #dcfce7;
        color: #166534;
    }

    .alert-danger {
        background: #fee2e2;
        color: #991b1b;
    }

    .empty-state {
        text-align: center;
        padding: 60px 20px;
    }

        .empty-state i {
            font-size: 45px;
            color: #cbd5e1;
            margin-bottom: 15px;
        }

        .empty-state h3 {
            color: #475569;
            margin-bottom: 7px;
        }

        .empty-state p {
            color: #94a3b8;
            font-size: 13px;
        }

    @@media(max-width: 700px) {
        .page-container {
            padding: 15px;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .toolbar {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }

        .search-box {
            width: 100%;
        }
    }
</style>

<div class="page-container">

    <div class="page-header">

        <div class="page-title">
            <h1>
                <i class="fa-solid fa-layer-group"></i>
                Test Categories
            </h1>

            <p>
                Create and manage laboratory test categories.
            </p>
        </div>

        <a asp-action="Create" class="btn-add">
            <i class="fa-solid fa-plus"></i>
            Add Category
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            <i class="fa-solid fa-circle-exclamation"></i>
            @TempData["Error"]
        </div>
    }


    <div class="content-card">

        <div class="toolbar">

            <div class="search-box">

                <i class="fa-solid fa-search"></i>

                <input type="text"
                       id="categorySearch"
                       placeholder="Search categories..." />

            </div>

            <div class="category-count">
                Total Categories:
                <strong>@Model.Count()</strong>
            </div>

        </div>


        @if (Model.Any())
        {
            <div class="table-container">

                <table class="category-table" id="categoryTable">

                    <thead>
                        <tr>
                            <th>#</th>
                            <th>Category Name</th>
                            <th>Description</th>
                            <th>Test Types</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @{
                            int number = 1;
                        }

                        @foreach (var category in Model)
                        {
                            <tr>

                                <td>
                                    @number
                                </td>

                                <td>
                                    <span class="category-name">
                                        @category.CategoryName
                                    </span>
                                </td>

                                <td>
                                    <span class="category-description">
                                        @(string.IsNullOrWhiteSpace(category.Description)
                                            ? "No description provided"
                                            : category.Description)
                                    </span>
                                </td>

                                <td>
                                    <span class="test-count">
                                        @(category.TestTypes?.Count ?? 0) Tests
                                    </span>
                                </td>

                                <td>

                                    <div class="action-buttons">

                                        <a asp-action="Details"
                                           asp-route-id="@category.TestCategoryId"
                                           class="action-btn btn-view"
                                           title="View Details">

                                            <i class="fa-solid fa-eye"></i>

                                        </a>


                                        <a asp-action="Edit"
                                           asp-route-id="@category.TestCategoryId"
                                           class="action-btn btn-edit"
                                           title="Edit">

                                            <i class="fa-solid fa-pen"></i>

                                        </a>


                                        <a asp-action="Delete"
                                           asp-route-id="@category.TestCategoryId"
                                           class="action-btn btn-delete"
                                           title="Delete">

                                            <i class="fa-solid fa-trash"></i>

                                        </a>

                                    </div>

                                </td>

                            </tr>

                            number++;
                        }

                    </tbody>

                </table>

            </div>
        }
        else
        {
            <div class="empty-state">

                <i class="fa-solid fa-layer-group"></i>

                <h3>No Test Categories</h3>

                <p>
                    You have not created any test categories yet.
                </p>

                <a asp-action="Create" class="btn-add">
                    <i class="fa-solid fa-plus"></i>
                    Create First Category
                </a>

            </div>
        }

    </div>

</div>


<script>

    document
        .getElementById("categorySearch")
        .addEventListener("keyup", function() {

            const searchValue =
                this.value.toLowerCase();

            const rows =
                document.querySelectorAll("#categoryTable tbody tr");

            rows.forEach(function(row) {

                const text =
                    row.innerText.toLowerCase();

                row.style.display =
                    text.includes(searchValue)
                        ? ""
                        : "none";

            });

        });

</script>
