@model LabDash.Models.TestCategory

@{
    ViewData["Title"] = "Delete Test Category";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    .page-container {
        padding: 30px;
        background: #f5f7fa;
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .delete-card {
        width: 100%;
        max-width: 600px;
        background: white;
        border-radius: 14px;
        padding: 35px;
        text-align: center;
        box-shadow: 0 5px 20px rgba(0,0,0,.08);
    }

    .warning-icon {
        width: 70px;
        height: 70px;
        margin: 0 auto 20px;
        border-radius: 50%;
        background: #fee2e2;
        color: #dc2626;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
    }

    .delete-card h1 {
        margin: 0;
        color: #172b4d;
        font-size: 24px;
    }

    .delete-card p {
        color: #64748b;
        font-size: 14px;
        line-height: 1.6;
        margin: 12px 0 25px;
    }

    .category-preview {
        background: #f8fafc;
        border-radius: 10px;
        padding: 18px;
        text-align: left;
        margin-bottom: 25px;
    }

        .category-preview strong {
            display: block;
            color: #172b4d;
            margin-bottom: 5px;
        }

        .category-preview span {
            color: #64748b;
            font-size: 13px;
        }

    .warning-message {
        background: #fff7ed;
        border: 1px solid #fed7aa;
        color: #9a3412;
        padding: 12px;
        border-radius: 8px;
        font-size: 12px;
        margin-bottom: 25px;
    }

    .actions {
        display: flex;
        justify-content: center;
        gap: 10px;
    }

    .btn {
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        border: none;
        cursor: pointer;
        font-size: 13px;
        font-weight: 600;
    }

    .btn-cancel {
        background: #e2e8f0;
        color: #475569;
    }

    .btn-delete {
        background: #dc2626;
        color: white;
    }

        .btn-delete:hover {
            background: #b91c1c;
        }
</style>


<div class="page-container">

    <div class="delete-card">

        <div class="warning-icon">

            <i class="fa-solid fa-trash"></i>

        </div>


        <h1>
            Delete Test Category?
        </h1>


        <p>
            Are you sure you want to delete this test category?
            This action cannot be undone.
        </p>


        <div class="category-preview">

            <strong>
                @Model.CategoryName
            </strong>

            <span>

                @(string.IsNullOrWhiteSpace(Model.Description)
                    ? "No description provided."
                    : Model.Description)

            </span>

        </div>


        @if (Model.TestTypes != null &&
             Model.TestTypes.Any())
        {
            <div class="warning-message">

                <i class="fa-solid fa-triangle-exclamation"></i>

                This category currently has
                <strong>@Model.TestTypes.Count</strong>
                test type(s) assigned to it.

                You cannot delete this category until
                those test types have been reassigned or removed.

            </div>
        }


        <form asp-action="Delete" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="TestCategoryId" />


            <div class="actions">

                <a asp-action="Index"
                   class="btn btn-cancel">

                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel

                </a>


                @if (Model.TestTypes == null ||
                     !Model.TestTypes.Any())
                {
                    <button type="submit"
                            class="btn btn-delete">

                        <i class="fa-solid fa-trash"></i>
                        Delete Category

                    </button>
                }

            </div>

        </form>

    </div>

</div>