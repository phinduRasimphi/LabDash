```cshtml
@model LabDash.Models.TestCategory

@{
    ViewData["Title"] = "Edit Test Category";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    .page-container {
        padding: 30px;
        background: #f5f7fa;
        min-height: calc(100vh - 70px);
    }

    .form-card {
        max-width: 800px;
        margin: 0 auto;
        background: white;
        border-radius: 14px;
        padding: 30px;
        box-shadow: 0 4px 15px rgba(0,0,0,.06);
    }

    .form-header {
        border-bottom: 1px solid #edf1f5;
        padding-bottom: 20px;
        margin-bottom: 25px;
    }

        .form-header h1 {
            margin: 0;
            color: #172b4d;
            font-size: 25px;
        }

        .form-header p {
            color: #718096;
            font-size: 13px;
        }

    .form-group {
        margin-bottom: 22px;
    }

        .form-group label {
            display: block;
            margin-bottom: 8px;
            font-size: 13px;
            font-weight: 700;
            color: #334155;
        }

    .required {
        color: #dc2626;
    }

    .form-control {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 13px;
        border: 1px solid #dbe2ea;
        border-radius: 8px;
        outline: none;
        font-size: 14px;
    }

        .form-control:focus {
            border-color: #0f766e;
            box-shadow: 0 0 0 3px rgba(15,118,110,.08);
        }

    textarea.form-control {
        min-height: 130px;
        resize: vertical;
    }

    .text-danger {
        display: block;
        color: #dc2626;
        font-size: 12px;
        margin-top: 6px;
    }

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        border-top: 1px solid #edf1f5;
        margin-top: 30px;
    }

    .btn {
        padding: 11px 18px;
        border-radius: 8px;
        border: none;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .btn-primary {
        background: #0f766e;
        color: white;
    }

        .btn-primary:hover {
            background: #0d5f59;
        }

    .btn-secondary {
        background: #e2e8f0;
        color: #475569;
    }
</style>


<div class="page-container">

    <div class="form-card">

        <div class="form-header">

            <h1>
                <i class="fa-solid fa-pen"></i>
                Edit Test Category
            </h1>

            <p>
                Update the category information below.
            </p>

        </div>


        <form asp-action="Edit" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   asp-for="TestCategoryId" />


            <div class="form-group">

                <label asp-for="CategoryName">
                    Category Name
                    <span class="required">*</span>
                </label>

                <input asp-for="CategoryName"
                       class="form-control"
                       autocomplete="off" />

                <span asp-validation-for="CategoryName"
                      class="text-danger">
                </span>

            </div>


            <div class="form-group">

                <label asp-for="Description">
                    Description
                </label>

                <textarea asp-for="Description"
                          class="form-control">
                </textarea>

                <span asp-validation-for="Description"
                      class="text-danger">
                </span>

            </div>


            <div class="form-actions">

                <a asp-action="Index"
                   class="btn btn-secondary">

                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel

                </a>

                <button type="submit"
                        class="btn btn-primary">

                    <i class="fa-solid fa-floppy-disk"></i>
                    Save Changes

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}