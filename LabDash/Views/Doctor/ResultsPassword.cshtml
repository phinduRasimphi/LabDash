@{
    ViewData["Title"] = "Access Results";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    ViewData["ActivePage"] = "SharedWithMe";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .pw-page {
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 70vh;
        font-family: 'Inter', sans-serif;
    }

    .pw-card {
        background: #ffffff;
        border-radius: 20px;
        padding: 40px;
        width: 100%;
        max-width: 440px;
        box-shadow: 0 12px 40px rgba(10, 60, 55, 0.12);
        border-top: 5px solid #0E8C7F;
        text-align: center;
        animation: pwFadeIn .3s ease;
    }

    @@keyframes pwFadeIn {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .pw-icon {
        width: 72px;
        height: 72px;
        border-radius: 50%;
        background: #E3F4F1;
        color: #0A5850;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        margin: 0 auto 20px;
        box-shadow: 0 4px 12px rgba(14, 140, 127, 0.15);
    }

    .pw-card h2 {
        font-family: 'Poppins', sans-serif;
        font-size: 22px;
        font-weight: 700;
        color: #102C27;
        margin: 0 0 8px;
    }

    .pw-card p {
        color: #52716C;
        font-size: 14px;
        margin: 0 0 28px;
        line-height: 1.5;
    }

    .pw-input-wrap {
        position: relative;
        margin-bottom: 24px;
    }

        .pw-input-wrap input {
            width: 100%;
            padding: 14px 16px 14px 44px;
            border: 1.5px solid #CCE3DF;
            border-radius: 12px;
            font-size: 15px;
            background: #F8FBFB;
            color: #102C27;
            outline: none;
            transition: all .2s;
        }

            .pw-input-wrap input:focus {
                border-color: #0E8C7F;
                background: #ffffff;
                box-shadow: 0 0 0 4px rgba(14, 140, 127, 0.1);
            }

        .pw-input-wrap i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #8FA9A3;
            font-size: 16px;
        }

    .pw-btn {
        width: 100%;
        padding: 14px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(120deg, #12A392, #0A4F48);
        color: #ffffff;
        font-family: 'Poppins', sans-serif;
        font-size: 15px;
        font-weight: 600;
        cursor: pointer;
        transition: all .2s;
        box-shadow: 0 6px 16px rgba(10, 90, 80, 0.2);
    }

        .pw-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(10, 90, 80, 0.3);
        }

    .pw-error {
        background: #FBECEA;
        color: #B0463F;
        padding: 12px;
        border-radius: 10px;
        font-size: 13px;
        font-weight: 500;
        margin-bottom: 20px;
        border-left: 4px solid #B0463F;
        text-align: left;
        display: flex;
        align-items: center;
        gap: 8px;
    }
</style>

<div class="pw-page">
    <div class="pw-card">

        <div class="pw-icon">
            <i class="fa-solid fa-lock"></i>
        </div>

        <h2>Protected Results</h2>
        <p>Please enter the security password to unlock these medical records.</p>

        <form asp-action="ResultsAccess" method="post">
            @Html.AntiForgeryToken()

            <!-- CRITICAL: These keep the redirect working -->
            <input type="hidden" name="returnUrl" value="@ViewBag.ReturnUrl" />
            <input type="hidden" name="requestId" value="@ViewBag.RequestId" />

            @if (!ViewData.ModelState.IsValid)
            {
                <div class="pw-error">
                    <i class="fa-solid fa-circle-exclamation"></i>
                    <div asp-validation-summary="ModelOnly"></div>
                </div>
            }

            <div class="pw-input-wrap">
                <i class="fa-solid fa-key"></i>
                <input type="password" name="password" placeholder="Enter password..." required autofocus />
            </div>

            <button type="submit" class="pw-btn">
                Unlock Results
            </button>
        </form>

    </div>
</div>