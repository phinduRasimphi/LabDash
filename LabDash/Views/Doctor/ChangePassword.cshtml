@{
    ViewData["Title"] = "Change Password";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    .cp-page {
        padding: 8px 10px 40px;
        max-width: 640px;
        margin: 0 auto;
    }

    .cp-heading {
        position: relative;
        overflow: hidden;
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 22px 26px;
        margin-bottom: 22px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        box-shadow: 0 8px 22px rgba(13, 107, 99, .14);
    }

    .cp-heading-icon {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.20);
        color: #fff;
        font-size: 20px;
    }

    .cp-heading-text h1 {
        margin: 0;
        color: #fff;
        font-size: 20px;
        font-weight: 750;
    }

    .cp-heading-text p {
        margin: 4px 0 0;
        color: rgba(255,255,255,.85);
        font-size: 11px;
    }

    .cp-card {
        background: #fff;
        border: 1px solid #dfeae7;
        border-radius: 17px;
        box-shadow: 0 4px 16px rgba(31,78,72,.055);
        padding: 26px;
    }

    .alert {
        padding: 12px 16px;
        border-radius: 11px;
        margin-bottom: 18px;
        font-size: 12px;
        font-weight: 650;
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .alert-danger {
        background: #fff3f3;
        color: #a44444;
        border: 1px solid #f0cccc;
    }

    .alert-success {
        background: #edf9f1;
        color: #21794e;
        border: 1px solid #c6e8d2;
    }

    .form-group {
        margin-bottom: 16px;
    }

    .form-label {
        display: block;
        margin-bottom: 6px;
        color: #49645f;
        font-size: 10px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .form-input {
        width: 100%;
        padding: 11px 14px;
        border: 1px solid #dfeae7;
        border-radius: 10px;
        background: #fbfdfc;
        color: #294b45;
        font-size: 13px;
        font-family: inherit;
        transition: all .18s ease;
        box-sizing: border-box;
    }

        .form-input:focus {
            outline: none;
            border-color: #1a8c82;
            background: #fff;
            box-shadow: 0 0 0 3px rgba(26,140,130,.12);
        }

    .form-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
        padding-top: 6px;
    }

    .btn-primary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 20px;
        border: none;
        border-radius: 10px;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: #fff;
        font-size: 12px;
        font-weight: 750;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s ease;
    }

        .btn-primary-custom:hover {
            transform: translateY(-1px);
            box-shadow: 0 8px 18px rgba(13,107,99,.22);
            color: #fff;
        }

    .btn-secondary-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 7px;
        padding: 11px 20px;
        border: 1px solid #dfeae7;
        border-radius: 10px;
        background: #fff;
        color: #49645f;
        font-size: 12px;
        font-weight: 750;
        text-decoration: none;
        transition: all .2s ease;
    }

        .btn-secondary-custom:hover {
            border-color: #1a8c82;
            color: #0d6b63;
        }
</style>

<div class="cp-page">

    <div class="cp-heading">
        <div class="cp-heading-icon">
            <i class="fas fa-key"></i>
        </div>
        <div class="cp-heading-text">
            <h1>Change Password</h1>
            <p>Update your account password</p>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">
            <i class="fas fa-circle-exclamation"></i>
            <div asp-validation-summary="ModelOnly"></div>
        </div>
    }

    <div class="cp-card">

        <form asp-action="ChangePassword" method="post">
            @Html.AntiForgeryToken()

            <div class="form-group">
                <label class="form-label">Current Password</label>
                <input type="password" name="currentPassword" class="form-input" required />
            </div>

            <div class="form-group">
                <label class="form-label">New Password</label>
                <input type="password" name="newPassword" class="form-input" required />
            </div>

            <div class="form-group">
                <label class="form-label">Confirm New Password</label>
                <input type="password" name="confirmPassword" class="form-input" required />
            </div>

            <div class="form-actions">
                <a asp-action="Profile" class="btn-secondary-custom">
                    <i class="fas fa-arrow-left"></i>
                    Cancel
                </a>
                <button type="submit" class="btn-primary-custom">
                    <i class="fas fa-floppy-disk"></i>
                    Change Password
                </button>
            </div>

        </form>

    </div>

</div>