```cshtml
@{
    ViewData["Title"] = "Patient Access";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>

    /* =========================================================
           NMB LAB PATIENT ACCESS PAGE
           ========================================================= */

    .patient-access-page {
        min-height: calc(100vh - 70px);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 40px 20px;
        background: radial-gradient( circle at top left, rgba(18, 107, 101, 0.10), transparent 35% ), linear-gradient( 135deg, #f4fbfa 0%, #eef8f6 50%, #f8fcfb 100% );
    }


    /* =========================================================
           ACCESS CARD
           ========================================================= */

    .patient-access-card {
        width: 100%;
        max-width: 500px;
        background: #ffffff;
        border-radius: 28px;
        padding: 42px 42px 38px;
        box-shadow: 0 20px 60px rgba(13, 107, 99, 0.13), 0 4px 15px rgba(0, 0, 0, 0.04);
        border: 1px solid rgba(13, 107, 99, 0.08);
        text-align: center;
        position: relative;
        overflow: hidden;
        animation: accessCardAppear 0.45s ease;
    }


        .patient-access-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 6px;
            background: linear-gradient( 90deg, #0d6b63, #1a8c82, #39a99d );
        }


    /* =========================================================
           ICON
           ========================================================= */

    .access-icon-wrapper {
        width: 82px;
        height: 82px;
        margin: 8px auto 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 145deg, #e1f4f1, #ccebe7 );
        color: #0d6b63;
        box-shadow: 0 10px 25px rgba(13, 107, 99, 0.12);
    }


        .access-icon-wrapper i {
            font-size: 34px;
        }


    /* =========================================================
           HEADING
           ========================================================= */

    .access-title {
        margin: 0;
        color: #123f3b;
        font-size: 27px;
        font-weight: 750;
        letter-spacing: -0.4px;
    }


    .access-subtitle {
        margin: 10px auto 28px;
        max-width: 390px;
        color: #718582;
        font-size: 14px;
        line-height: 1.7;
    }


    /* =========================================================
           SECURITY NOTICE
           ========================================================= */

    .security-notice {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        text-align: left;
        padding: 14px 16px;
        margin-bottom: 24px;
        background: #f0f9f7;
        border: 1px solid #d5eeea;
        border-radius: 14px;
        color: #3f625e;
        font-size: 13px;
        line-height: 1.55;
    }


        .security-notice i {
            color: #0d6b63;
            font-size: 17px;
            margin-top: 2px;
            flex-shrink: 0;
        }


    /* =========================================================
           ERROR MESSAGE
           ========================================================= */

    .access-error {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        text-align: left;
        padding: 13px 15px;
        margin-bottom: 20px;
        border-radius: 13px;
        background: #fff1f1;
        border: 1px solid #f3caca;
        color: #b42318;
        font-size: 13px;
        line-height: 1.5;
    }


        .access-error i {
            margin-top: 2px;
            font-size: 16px;
            flex-shrink: 0;
        }


    /* =========================================================
           PASSWORD LABEL
           ========================================================= */

    .password-label {
        display: block;
        text-align: left;
        margin-bottom: 8px;
        color: #244b47;
        font-size: 13px;
        font-weight: 700;
    }


    /* =========================================================
           PASSWORD BOX
           ========================================================= */

    .password-wrapper {
        position: relative;
        margin-bottom: 22px;
    }


        .password-wrapper .password-icon {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #7a9692;
            font-size: 16px;
            pointer-events: none;
        }


    .password-input {
        width: 100%;
        height: 54px;
        padding: 0 52px 0 46px;
        border: 1.5px solid #d6e5e2;
        border-radius: 15px;
        background: #fbfdfd;
        color: #183f3b;
        font-size: 15px;
        outline: none;
        transition: all 0.2s ease;
        box-sizing: border-box;
    }


        .password-input::placeholder {
            color: #a2b4b1;
        }


        .password-input:focus {
            border-color: #159187;
            background: #ffffff;
            box-shadow: 0 0 0 4px rgba(21, 145, 135, 0.10);
        }


    /* =========================================================
           SHOW / HIDE BUTTON
           ========================================================= */

    .toggle-password {
        position: absolute;
        right: 5px;
        top: 5px;
        width: 44px;
        height: 44px;
        border: none;
        border-radius: 11px;
        background: transparent;
        color: #64817d;
        cursor: pointer;
        transition: all 0.2s ease;
    }


        .toggle-password:hover {
            background: #eaf6f4;
            color: #0d6b63;
        }


        .toggle-password:focus {
            outline: none;
            box-shadow: 0 0 0 3px rgba(13, 107, 99, 0.12);
        }


    /* =========================================================
           CONTINUE BUTTON
           ========================================================= */

    .access-button {
        width: 100%;
        height: 54px;
        border: none;
        border-radius: 15px;
        background: linear-gradient( 135deg, #0d6b63, #16877e );
        color: #ffffff;
        font-size: 15px;
        font-weight: 700;
        letter-spacing: 0.1px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(13, 107, 99, 0.20);
        transition: transform 0.2s ease, box-shadow 0.2s ease, background 0.2s ease;
    }


        .access-button:hover {
            background: linear-gradient( 135deg, #095b55, #11786f );
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(13, 107, 99, 0.25);
        }


        .access-button:active {
            transform: translateY(0);
        }


        .access-button i {
            margin-right: 8px;
        }


    /* =========================================================
           BACK LINK
           ========================================================= */

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        margin-top: 22px;
        color: #6f8784;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        transition: color 0.2s ease;
    }


        .back-link:hover {
            color: #0d6b63;
        }


    /* =========================================================
           FOOTER SECURITY TEXT
           ========================================================= */

    .access-footer {
        margin-top: 28px;
        padding-top: 20px;
        border-top: 1px solid #edf2f1;
        color: #9aaba8;
        font-size: 11px;
        line-height: 1.6;
    }


        .access-footer i {
            color: #0d6b63;
            margin-right: 4px;
        }


    /* =========================================================
           ANIMATION
           ========================================================= */

    @@keyframes accessCardAppear {
        from {
            opacity: 0;
            transform: translateY(18px) scale(0.98);
        }

        to {
            opacity: 1;
            transform: translateY(0) scale(1);
        }
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 600px) {

        .patient-access-page {
            padding: 25px 15px;
        }

        .patient-access-card {
            padding: 36px 24px 30px;
            border-radius: 23px;
        }

        .access-title {
            font-size: 23px;
        }

        .access-icon-wrapper {
            width: 72px;
            height: 72px;
        }

            .access-icon-wrapper i {
                font-size: 29px;
            }
    }


    @@media (max-width: 400px) {

        .patient-access-card {
            padding: 32px 18px 27px;
        }

        .access-title {
            font-size: 21px;
        }

        .security-notice {
            font-size: 12px;
        }
    }

</style>


<div class="patient-access-page">

    <div class="patient-access-card">

        <!-- =====================================================
             LOCK ICON
        ====================================================== -->

        <div class="access-icon-wrapper">
            <i class="fas fa-lock"></i>
        </div>


        <!-- =====================================================
             TITLE
        ====================================================== -->

        <h1 class="access-title">
            Patient Records
        </h1>

        <p class="access-subtitle">
            This area contains confidential patient information.
            Please enter your access password to continue.
        </p>


        <!-- =====================================================
             SECURITY NOTICE
        ====================================================== -->

        <div class="security-notice">

            <i class="fas fa-shield-alt"></i>

            <div>
                <strong>Secure Access</strong><br />

                Patient information is protected and can only
                be accessed by authorised laboratory staff.
            </div>

        </div>


        <!-- =====================================================
             ERROR MESSAGE
        ====================================================== -->
        @if (!ViewData.ModelState.IsValid)
        {
            <div class="access-error">

                <i class="fas fa-exclamation-circle"></i>

                <div>
                    @foreach (
                        var error
                        in ViewData.ModelState.Values
                            .SelectMany(v => v.Errors))
                    {
                        <div>
                            @error.ErrorMessage
                        </div>
                    }
                </div>

            </div>
        }


        <!-- =====================================================
             PASSWORD FORM
        ====================================================== -->

        <form asp-controller="Doctor"
              asp-action="MyPatientsAccess"
              method="post">

            @Html.AntiForgeryToken()


            <label for="password"
                   class="password-label">

                Access Password

            </label>


            <div class="password-wrapper">

                <i class="fas fa-key password-icon"></i>

                <input type="password"
                       id="password"
                       name="password"
                       class="password-input"
                       placeholder="Enter access password"
                       autocomplete="off"
                       required />

                <button type="button"
                        class="toggle-password"
                        id="togglePassword"
                        aria-label="Show password"
                        title="Show password">

                    <i class="fas fa-eye"
                       id="togglePasswordIcon">
                    </i>

                </button>

            </div>


            <!-- =================================================
                 CONTINUE BUTTON
            ================================================== -->

            <button type="submit"
                    class="access-button">

                <i class="fas fa-unlock-alt"></i>

                Continue to My Patients

            </button>

        </form>


        <!-- =====================================================
             BACK
        ====================================================== -->

        <a href="@Url.Action("ManagePatients", "Doctor")"
           class="back-link">

            <i class="fas fa-arrow-left"></i>

            Back to Manage Patients

        </a>


        <!-- =====================================================
             FOOTER
        ====================================================== -->

        <div class="access-footer">

            <i class="fas fa-lock"></i>

            NMB LAB • Confidential Patient Information

        </div>

    </div>

</div>


<script>

    // =========================================================
    // SHOW / HIDE PASSWORD
    // =========================================================

    document.addEventListener("DOMContentLoaded", function () {

        const passwordInput =
            document.getElementById("password");

        const togglePassword =
            document.getElementById("togglePassword");

        const togglePasswordIcon =
            document.getElementById("togglePasswordIcon");


        if (
            passwordInput &&
            togglePassword &&
            togglePasswordIcon
        ) {

            togglePassword.addEventListener(
                "click",
                function () {

                    if (
                        passwordInput.type === "password"
                    ) {

                        passwordInput.type = "text";

                        togglePasswordIcon.classList.remove(
                            "fa-eye"
                        );

                        togglePasswordIcon.classList.add(
                            "fa-eye-slash"
                        );

                        togglePassword.setAttribute(
                            "aria-label",
                            "Hide password"
                        );

                        togglePassword.setAttribute(
                            "title",
                            "Hide password"
                        );

                    }
                    else {

                        passwordInput.type =
                            "password";

                        togglePasswordIcon.classList.remove(
                            "fa-eye-slash"
                        );

                        togglePasswordIcon.classList.add(
                            "fa-eye"
                        );

                        togglePassword.setAttribute(
                            "aria-label",
                            "Show password"
                        );

                        togglePassword.setAttribute(
                            "title",
                            "Show password"
                        );
                    }

                }
            );

        }

    });

</script>
