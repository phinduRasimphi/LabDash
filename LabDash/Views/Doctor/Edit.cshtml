@model LabDash.ViewModels.PatientCreateViewModel

@{
    ViewData["Title"] = "Edit Patient";
    ViewData["ActivePage"] = "ManagePatients";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    .np-shell {
        width: 100%;
        max-width: 1080px;
        margin: 0 auto;
        padding: 28px 20px 60px;
        font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
        color: #1e293b;
    }

    .np-hero {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, #0b5f58 0%, #0d6b63 55%, #159d91 100%);
        color: #fff;
        border-radius: 20px;
        padding: 28px 36px;
        margin-bottom: 26px;
        box-shadow: 0 12px 32px rgba(11, 95, 88, .22);
    }

    .np-hero-inner {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .np-hero-icon {
        width: 60px;
        height: 60px;
        min-width: 60px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        border: 1px solid rgba(255,255,255,.28);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .np-hero-eyebrow {
        margin: 0 0 4px;
        font-size: 11.5px;
        font-weight: 600;
        letter-spacing: 1.2px;
        text-transform: uppercase;
        color: rgba(255,255,255,.72);
    }

    .np-hero-title {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.4px;
        line-height: 1.2;
    }

    .np-hero-sub {
        margin: 8px 0 0;
        font-size: 13.5px;
        line-height: 1.6;
        color: rgba(255,255,255,.82);
    }

    .np-section {
        background: #fff;
        border: 1px solid #e8edf2;
        border-radius: 16px;
        margin-bottom: 20px;
        box-shadow: 0 4px 16px rgba(15, 23, 42, .045);
        overflow: hidden;
    }

    .np-section-head {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px 24px;
        background: #f8fbfa;
        border-bottom: 1px solid #edf3f2;
    }

    .np-step {
        width: 34px;
        height: 34px;
        min-width: 34px;
        border-radius: 10px;
        background: linear-gradient(135deg, #0d6b63, #159d91);
        color: #fff;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
        font-weight: 700;
    }

    .np-section-title {
        flex: 1;
        min-width: 0;
    }

        .np-section-title h3 {
            margin: 0;
            font-size: 15px;
            font-weight: 700;
            color: #172b4d;
        }

        .np-section-title p {
            margin: 3px 0 0;
            font-size: 11.5px;
            color: #8795a8;
            line-height: 1.5;
        }

    .np-section-flag {
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .5px;
        text-transform: uppercase;
        padding: 4px 10px;
        border-radius: 99px;
        white-space: nowrap;
    }

    .np-flag-required {
        color: #b42318;
        background: #fff1f0;
        border: 1px solid #fecdc9;
    }

    .np-flag-optional {
        color: #4a5b70;
        background: #eef3f2;
        border: 1px solid #dbe6e4;
    }

    .np-section-body {
        padding: 24px;
    }

    .np-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px 20px;
    }

    .np-field {
        min-width: 0;
    }

        .np-field label {
            display: flex;
            align-items: center;
            gap: 4px;
            font-weight: 600;
            font-size: 12.5px;
            margin-bottom: 7px;
            color: #344b49;
        }

            .np-field label .req {
                color: #d92d20;
                font-weight: 700;
                font-size: 13px;
            }

        .np-field input, .np-field select {
            width: 100%;
            border: 1.5px solid #d9e3e1;
            border-radius: 10px;
            padding: 12px 14px;
            background: #fbfdfd;
            color: #1e293b;
            font-family: inherit;
            font-size: 14px;
            line-height: 1.3;
            transition: border-color .15s ease, box-shadow .15s ease;
            box-sizing: border-box;
            appearance: none;
        }

        .np-field select {
            background-image: url("data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 16 16' fill='%234a5b70'><path d='M8 11L3 6h10z'/></svg>");
            background-repeat: no-repeat;
            background-position: right 14px center;
            padding-right: 38px;
            cursor: pointer;
        }

            .np-field input:focus, .np-field select:focus {
                border-color: #0d6b63;
                background-color: #fff;
                outline: none;
                box-shadow: 0 0 0 4px rgba(13, 107, 99, .10);
            }

            .np-field select:disabled {
                background-color: #f1f5f4;
                color: #97a4b1;
                cursor: not-allowed;
            }

        .np-field input[readonly] {
            background: #f1f5f4;
            color: #6b7a8c;
            cursor: not-allowed;
        }

        .np-field input.is-invalid, .np-field select.is-invalid, .np-field .input-validation-error {
            border-color: #d92d20;
            background-color: #fffbfa;
        }

    .np-help {
        display: block;
        font-size: 11.5px;
        color: #8795a8;
        margin-top: 6px;
        line-height: 1.5;
    }

    .np-error {
        display: block;
        font-size: 12px;
        color: #b42318;
        font-weight: 500;
        margin-top: 6px;
        min-height: 15px;
    }

    .np-summary {
        background: #fff6f5;
        border: 1px solid #fecdc9;
        border-left: 4px solid #d92d20;
        border-radius: 12px;
        padding: 16px 20px;
        margin-bottom: 22px;
        color: #7a2e28;
    }

        .np-summary ul {
            margin: 0;
            padding-left: 20px;
            font-size: 12.5px;
            line-height: 1.7;
        }

        .np-summary.validation-summary-valid {
            display: none;
        }

    .np-actions {
        position: sticky;
        bottom: 0;
        margin-top: 24px;
        padding: 18px 22px;
        background: rgba(255,255,255,.96);
        backdrop-filter: blur(10px);
        border: 1px solid #e8edf2;
        border-radius: 16px;
        box-shadow: 0 -6px 22px rgba(15, 23, 42, .06);
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        flex-wrap: wrap;
    }

    .np-actions-hint {
        font-size: 12.5px;
        color: #8795a8;
    }

    .np-actions-group {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .np-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 11px 22px;
        border-radius: 10px;
        border: 1px solid transparent;
        font-weight: 650;
        font-size: 13.5px;
        text-decoration: none;
        cursor: pointer;
        white-space: nowrap;
    }

    .np-btn-primary {
        background: linear-gradient(135deg, #0d6b63, #159d91);
        color: #fff;
        box-shadow: 0 5px 14px rgba(13, 107, 99, .22);
    }

        .np-btn-primary:hover {
            background: linear-gradient(135deg, #09564f, #118c81);
        }

    .np-btn-ghost {
        background: #fff;
        color: #4a5b70;
        border-color: #d9e3e1;
    }

        .np-btn-ghost:hover {
            background: #f4f8f7;
            color: #26384d;
        }

    @@media (max-width: 760px) {
        .np-shell {
            padding: 18px 14px 40px;
        }

        .np-hero {
            padding: 22px;
        }

        .np-grid {
            grid-template-columns: 1fr;
        }

        .np-actions {
            flex-direction: column;
            align-items: stretch;
        }

        .np-actions-group .np-btn {
            flex: 1;
        }
    }
</style>

<div class="np-shell">

    <div class="np-hero">
        <div class="np-hero-inner">
            <div class="np-hero-icon"><i class="fas fa-user-edit"></i></div>
            <div>
                <p class="np-hero-eyebrow">Patient Records</p>
                <h1 class="np-hero-title">Edit Patient</h1>
                <p class="np-hero-sub">Update this patient's details. The ID number identifies the record and cannot be changed.</p>
            </div>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }
    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <form asp-action="EditPatient" method="post" id="editPatientForm" novalidate>

        @* "All" (not "ModelOnly") so errors on fields that are not on this form still show up *@
        <div asp-validation-summary="All" class="np-summary"></div>

        <!-- PERSONAL INFORMATION -->
        <section class="np-section">
            <header class="np-section-head">
                <div class="np-step">1</div>
                <div class="np-section-title">
                    <h3>Personal Information</h3>
                    <p>Legal identity details as they appear on the patient's ID document.</p>
                </div>
                <span class="np-section-flag np-flag-required">All required</span>
            </header>
            <div class="np-section-body">
                <div class="np-grid">

                    <div class="np-field">
                        <label asp-for="Name">First Name <span class="req">*</span></label>
                        <input asp-for="Name" autocomplete="given-name" maxlength="50" />
                        <span asp-validation-for="Name" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="Surname">Surname <span class="req">*</span></label>
                        <input asp-for="Surname" autocomplete="family-name" maxlength="50" />
                        <span asp-validation-for="Surname" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="IDNumber">South African ID Number</label>
                        @* Single binding: readonly still posts, so no separate hidden field is needed *@
                        <input asp-for="IDNumber" maxlength="13" readonly />
                        <span class="np-help">The ID number cannot be edited.</span>
                        <span asp-validation-for="IDNumber" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="DOB">Date of Birth <span class="req">*</span></label>
                        <input asp-for="DOB" type="date" />
                        <span asp-validation-for="DOB" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="CellphoneNumber">Cellphone Number <span class="req">*</span></label>
                        <input asp-for="CellphoneNumber" type="tel" inputmode="numeric" maxlength="10" autocomplete="tel" />
                        <span class="np-help">10-digit South African mobile number.</span>
                        <span asp-validation-for="CellphoneNumber" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="Email">Email Address <span class="req">*</span></label>
                        <input asp-for="Email" type="email" autocomplete="email" />
                        <span asp-validation-for="Email" class="np-error"></span>
                    </div>

                </div>
            </div>
        </section>

        <!-- ADDRESS -->
        <section class="np-section">
            <header class="np-section-head">
                <div class="np-step">2</div>
                <div class="np-section-title">
                    <h3>Residential Address</h3>
                    <p>Change the province to reload the city, suburb and postal code lists.</p>
                </div>
                <span class="np-section-flag np-flag-required">All required</span>
            </header>
            <div class="np-section-body">
                <div class="np-grid">

                    <div class="np-field">
                        <label asp-for="Province">Province <span class="req">*</span></label>
                        <select asp-for="Province" id="Province">
                            <option value="">Select Province</option>
                            @foreach (var province in Model.Provinces)
                            {
                                <option value="@province.Value" selected="@(province.Value == Model.Province)">@province.Text</option>
                            }
                        </select>
                        <span asp-validation-for="Province" class="np-error"></span>
                    </div>

                    @* Current value is rendered as a selected option so it posts back even if the cascade script has not run *@
                    <div class="np-field">
                        <label asp-for="City">City / Town <span class="req">*</span></label>
                        <select asp-for="City" id="City">
                            <option value="">Select City / Town</option>
                            @if (!string.IsNullOrEmpty(Model.City))
                            {
                                <option value="@Model.City" selected>@Model.City</option>
                            }
                        </select>
                        <span asp-validation-for="City" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="Suburb">Suburb <span class="req">*</span></label>
                        <select asp-for="Suburb" id="Suburb">
                            <option value="">Select Suburb</option>
                            @if (!string.IsNullOrEmpty(Model.Suburb))
                            {
                                <option value="@Model.Suburb" selected>@Model.Suburb</option>
                            }
                        </select>
                        <span asp-validation-for="Suburb" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="PostalCode">Postal Code <span class="req">*</span></label>
                        <select asp-for="PostalCode" id="PostalCode">
                            <option value="">Select Postal Code</option>
                            @if (!string.IsNullOrEmpty(Model.PostalCode))
                            {
                                <option value="@Model.PostalCode" selected>@Model.PostalCode</option>
                            }
                        </select>
                        <span asp-validation-for="PostalCode" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="AddressLine1">Address Line 1 <span class="req">*</span></label>
                        <input asp-for="AddressLine1" placeholder="House number and street name" />
                        <span asp-validation-for="AddressLine1" class="np-error"></span>
                    </div>

                    <div class="np-field">
                        <label asp-for="AddressLine2">Address Line 2</label>
                        <input asp-for="AddressLine2" placeholder="Building, complex or additional details" />
                        <span asp-validation-for="AddressLine2" class="np-error"></span>
                    </div>

                </div>
            </div>
        </section>

        <!-- MEDICAL INFORMATION -->
        <section class="np-section">
            <header class="np-section-head">
                <div class="np-step">3</div>
                <div class="np-section-title">
                    <h3>Medical Information</h3>
                    <p>Record any known conditions, allergies and current medication.</p>
                </div>
                <span class="np-section-flag np-flag-optional">Optional</span>
            </header>
            <div class="np-section-body">
                <div class="np-grid">

                    <div class="np-field">
                        <label asp-for="SelectedMedicalConditionCategory">Medical Condition Category</label>
                        <select asp-for="SelectedMedicalConditionCategory" id="conditionCategory">
                            <option value="">Select Category</option>
                            @foreach (var category in Model.MedicalConditionCategories)
                            {
                                <option value="@category" selected="@(category == Model.SelectedMedicalConditionCategory)">@category</option>
                            }
                        </select>
                    </div>

                    <div class="np-field">
                        <label asp-for="SelectedMedicalConditionId">Medical Condition</label>
                        <select asp-for="SelectedMedicalConditionId" id="conditionItem">
                            <option value="">Select Medical Condition</option>
                            @foreach (var item in Model.MedicalConditionOptions)
                            {
                                <option value="@item.Id" data-category="@item.Category" selected="@(item.Id == Model.SelectedMedicalConditionId)">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div class="np-field">
                        <label asp-for="SelectedAllergyCategory">Allergy Category</label>
                        <select asp-for="SelectedAllergyCategory" id="allergyCategory">
                            <option value="">Select Category</option>
                            @foreach (var category in Model.AllergyCategories)
                            {
                                <option value="@category" selected="@(category == Model.SelectedAllergyCategory)">@category</option>
                            }
                        </select>
                    </div>

                    <div class="np-field">
                        <label asp-for="SelectedAllergyId">Allergy</label>
                        <select asp-for="SelectedAllergyId" id="allergyItem">
                            <option value="">Select Allergy</option>
                            @foreach (var item in Model.AllergyOptions)
                            {
                                <option value="@item.Id" data-category="@item.Category" selected="@(item.Id == Model.SelectedAllergyId)">@item.Name</option>
                            }
                        </select>
                    </div>

                    <div class="np-field">
                        <label asp-for="SelectedMedicationCategory">Medication Category</label>
                        <select asp-for="SelectedMedicationCategory" id="medicationCategory">
                            <option value="">Select Category</option>
                            @foreach (var category in Model.MedicationCategories)
                            {
                                <option value="@category" selected="@(category == Model.SelectedMedicationCategory)">@category</option>
                            }
                        </select>
                    </div>

                    <div class="np-field">
                        <label asp-for="SelectedMedicationId">Medication</label>
                        <select asp-for="SelectedMedicationId" id="medicationItem">
                            <option value="">Select Medication</option>
                            @foreach (var item in Model.MedicationOptions)
                            {
                                <option value="@item.Id" data-category="@item.Category" selected="@(item.Id == Model.SelectedMedicationId)">@item.Name</option>
                            }
                        </select>
                    </div>

                </div>
            </div>
        </section>

        <div class="np-actions">
            <div class="np-actions-hint">Fields marked <strong style="color:#d92d20;">*</strong> are required.</div>
            <div class="np-actions-group">
                <a asp-action="ManagePatients" class="np-btn np-btn-ghost">Cancel</a>
                <button type="submit" class="np-btn np-btn-primary">
                    <i class="fas fa-save"></i> Save changes
                </button>
            </div>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        window.labDashUrls = {
            getCities: '@Url.Action("GetCities", "Doctor")',
            getSuburbs: '@Url.Action("GetSuburbs", "Doctor")',
            getPostalCodes: '@Url.Action("GetPostalCodes", "Doctor")'
        };
    </script>
    <script src="~/js/patient-create.js" asp-append-version="true"></script>
}
