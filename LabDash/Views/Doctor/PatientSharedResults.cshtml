@model LabDash.ViewModels.PatientSharedResultsViewModel

@{
    ViewData["Title"] = "Patient Shared Results";
    ViewData["ActivePage"] = "SharedWithMe";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<style>
    .psr-wrap {
        font-family: 'Inter', sans-serif;
        color: #102C27;
    }

    .psr-back {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: #0E8C7F;
        text-decoration: none;
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 18px;
    }

        .psr-back:hover {
            color: #0A5850;
            text-decoration: none;
        }

    .psr-header {
        background: #FFFFFF;
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        border-top: 4px solid #0E8C7F;
        margin-bottom: 22px;
    }

        .psr-header h1 {
            font-family: 'Poppins', sans-serif;
            font-size: 22px;
            font-weight: 700;
            margin: 0 0 8px;
        }

        .psr-header .psr-meta {
            display: flex;
            flex-wrap: wrap;
            gap: 22px;
            color: #52716C;
            font-size: 13px;
        }

            .psr-header .psr-meta span {
                display: inline-flex;
                align-items: center;
                gap: 6px;
            }

            .psr-header .psr-meta i {
                color: #0E8C7F;
            }

    .psr-summary {
        display: flex;
        gap: 14px;
        margin-bottom: 22px;
        flex-wrap: wrap;
    }

    .psr-stat {
        background: #FFFFFF;
        border-radius: 14px;
        padding: 16px 20px;
        box-shadow: 0 6px 24px rgba(10, 60, 55, 0.06);
        border-left: 4px solid #0E8C7F;
        min-width: 160px;
    }

        .psr-stat.abnormal {
            border-left-color: #D9534F;
        }

        .psr-stat .label {
            font-size: 11px;
            color: #8FA9A3;
            text-transform: uppercase;
            letter-spacing: .6px;
            font-weight: 700;
        }

        .psr-stat .value {
            font-family: 'Poppins', sans-serif;
            font-size: 24px;
            font-weight: 700;
            margin-top: 4px;
        }

    .psr-empty {
        background: #FFFFFF;
        border-radius: 18px;
        padding: 50px 30px;
        text-align: center;
        color: #52716C;
        box-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
    }

        .psr-empty i {
            font-size: 46px;
            color: #CCE3DF;
            margin-bottom: 12px;
            display: block;
        }

        .psr-empty h3 {
            font-family: 'Poppins', sans-serif;
            font-size: 18px;
            color: #102C27;
            margin: 0 0 6px;
        }

        .psr-empty p {
            margin: 0;
            font-size: 13.5px;
        }

    .psr-table-wrap {
        background: #FFFFFF;
        border-radius: 18px;
        box-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        overflow: hidden;
    }

    .psr-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

        .psr-table thead th {
            background: #F0F7F6;
            color: #0A5850;
            text-align: left;
            padding: 14px 18px;
            font-size: 11.5px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: .6px;
            border-bottom: 1px solid #E1EEEC;
        }

        .psr-table tbody td {
            padding: 14px 18px;
            border-bottom: 1px solid #E1EEEC;
            vertical-align: top;
        }

        .psr-table tbody tr:last-child td {
            border-bottom: none;
        }

        .psr-table tbody tr:hover {
            background: #FAFDFC;
        }

        .psr-table .row-abnormal {
            background: #FFF6F5;
        }

            .psr-table .row-abnormal:hover {
                background: #FFEFED;
            }

    .psr-flag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 3px 10px;
        border-radius: 999px;
        background: #E3F4F1;
        color: #0E8C7F;
        font-size: 11px;
        font-weight: 700;
    }

        .psr-flag.abn {
            background: #FDE3E1;
            color: #B6392F;
        }

    .psr-value {
        font-weight: 600;
    }

        .psr-value.abn {
            color: #B6392F;
        }

    .psr-notes {
        color: #8FA9A3;
        font-size: 12.5px;
        font-style: italic;
    }
</style>

<div class="psr-wrap">

    <a asp-controller="Doctor"
       asp-action="SharedWithMe"
       class="psr-back">
        <i class="fa-solid fa-arrow-left"></i>
        Back to Consented Patients
    </a>

    <div class="psr-header">

        <h1>@Model.FullName</h1>

        <div class="psr-meta">
            <span>
                <i class="fa-solid fa-id-card"></i>
                ID: @Model.IDNumber
            </span>
            <span>
                <i class="fa-solid fa-envelope"></i>
                @Model.Email
            </span>
        </div>

    </div>

    <div class="psr-summary">

        <div class="psr-stat">
            <div class="label">Total Results</div>
            <div class="value">@Model.TotalItems</div>
        </div>

        <div class="psr-stat abnormal">
            <div class="label">Abnormal</div>
            <div class="value">@Model.AbnormalCount</div>
        </div>

    </div>

    @if (Model.Results == null || Model.Results.Count == 0)
    {
        <div class="psr-empty">
            <i class="fa-solid fa-flask-vial"></i>
            <h3>No shared results yet</h3>
            <p>This patient has not shared any test results with you.</p>
        </div>
    }
    else
    {
        <div class="psr-table-wrap">

            <table class="psr-table">

                <thead>
                    <tr>
                        <th>Date</th>
                        <th>Test</th>
                        <th>Category</th>
                        <th>Result</th>
                        <th>Flag</th>
                        <th>Notes</th>
                    </tr>
                </thead>

                <tbody>
                    @foreach (var r in Model.Results)
                    {
                        <tr class="@(r.IsAbnormal ? "row-abnormal" : "")">

                            <td>@r.RequestDate.ToString("dd MMM yyyy")</td>

                            <td>@r.TestName</td>

                            <td>@r.Category</td>

                            <td>
                                <span class="psr-value @(r.IsAbnormal ? "abn" : "")">
                                    @(r.HasResult? r.ResultValue: "Pending")
                                    @if (r.HasResult && !string.IsNullOrWhiteSpace(r.Unit))
                                    {
                                        <text>@r.Unit</text>
                                    }
                                </span>
                            </td>

                            <td>
                                @if (r.IsAbnormal)
                                {
                                    <span class="psr-flag abn">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        Abnormal
                                    </span>
                                }
                                else if (r.HasResult)
                                {
                                    <span class="psr-flag">
                                        <i class="fa-solid fa-check"></i>
                                        Normal
                                    </span>
                                }
                                else
                                {
                                    <span class="psr-flag" style="background:#F0F0F0;color:#8FA9A3;">
                                        <i class="fa-solid fa-clock"></i>
                                        Pending
                                    </span>
                                }
                            </td>

                            <td class="psr-notes">
                                @r.TechnicianNotes
                            </td>

                        </tr>
                    }
                </tbody>

            </table>

        </div>
    }

</div>