@model LabDash.Areas.Identity.Data.LabUser

@{
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = "DoctorProfile";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var fullName = $"{Model.FirstName} {Model.LastName}".Trim();

    var initials = (
        (!string.IsNullOrWhiteSpace(Model.FirstName) ? Model.FirstName.Substring(0, 1) : "D") +
        (!string.IsNullOrWhiteSpace(Model.LastName) ? Model.LastName.Substring(0, 1) : "")
    ).ToUpper();

    var isEditMode = (ViewBag.EditMode == true);
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="p-wrap">

    <!-- =========================================================
         BANNER
         ========================================================= -->
    <div class="p-banner">
        <div class="p-banner-pattern"></div>

        <div class="p-banner-left">
            <div class="p-banner-avatar">
                <span class="p-icon-ring"></span>
                @initials
            </div>

            <div class="p-banner-text">
                <h1>My Profile</h1>
                <p>Manage your personal information and keep your account secure.</p>

                <div class="p-pills">
                    <span class="p-pill">
                        <i class="fas fa-user"></i>
                        @fullName
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.HPCSANumber))
                    {
                        <span class="p-pill">
                            <i class="fas fa-id-badge"></i>
                            HPCSA: @Model.HPCSANumber
                        </span>
                    }

                    <span class="p-pill">
                        <i class="fas fa-user-doctor"></i>
                        Doctor
                    </span>

                    @if (Model.Timestamp_AccountCreated != default)
                    {
                        <span class="p-pill">
                            <i class="fas fa-calendar-day"></i>
                            Member since @Model.Timestamp_AccountCreated.ToString("MMM yyyy")
                        </span>
                    }
                </div>
            </div>
        </div>

        <a href="@Url.Action("ChangePassword", "Account")"
           class="p-banner-cta">
            <i class="fas fa-key"></i>
            Change Password
        </a>
    </div>


    <!-- =========================================================
         MESSAGES
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="p-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (isEditMode && !ViewData.ModelState.IsValid)
    {
        <div class="p-toast p-toast-error p-toast-block">
            <i class="fas fa-circle-exclamation"></i>
            <div asp-validation-summary="All" class="p-validation-list"></div>
        </div>
    }


    <!-- =========================================================
         LOCKED INFORMATION NOTICE
         ========================================================= -->
    <div class="p-status-strip">
        <div class="p-status-left">
            <span class="p-status-dot"></span>
            <span>
                <strong>Locked fields</strong>
                &middot;
                HPCSA number, employee number, ID number, gender and account creation date are managed by a system administrator.
            </span>
        </div>

        <i class="fas fa-lock"></i>
    </div>


    <!-- =========================================================
         PERSONAL INFORMATION
         ========================================================= -->
    @if (!isEditMode)
    {
        <!-- ============ VIEW MODE ============ -->
        <div class="p-panel">
            <div class="p-panel-head">
                <span>
                    <i class="fa-solid fa-address-card"></i>
                    Personal Information
                </span>

                <a asp-action="DoctorProfile"
                   asp-route-edit="true"
                   class="p-panel-tag p-panel-tag-link">
                    <i class="fa-solid fa-pen"></i>
                    Edit
                </a>
            </div>

            <div class="p-panel-body">

                <div class="p-grid-2">
                    <div class="p-info">
                        <span class="p-info-label">First Name</span>
                        <span class="p-info-value">@Model.FirstName</span>
                    </div>

                    <div class="p-info">
                        <span class="p-info-label">Last Name</span>
                        <span class="p-info-value">@Model.LastName</span>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-info">
                        <span class="p-info-label">E-mail</span>
                        <span class="p-info-value">@Model.Email</span>
                    </div>

                    <div class="p-info">
                        <span class="p-info-label">Phone Number</span>
                        <span class="p-info-value @(string.IsNullOrWhiteSpace(Model.PhoneNumb) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.PhoneNumb) ? "Not set" : Model.PhoneNumb)
                        </span>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-info">
                        <span class="p-info-label">
                            Gender
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value @(string.IsNullOrWhiteSpace(Model.Gender) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.Gender) ? "Not set" : Model.Gender)
                        </span>
                    </div>

                    <div class="p-info">
                        <span class="p-info-label">
                            Role
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value">Doctor</span>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-info">
                        <span class="p-info-label">
                            HPCSA Number
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value @(string.IsNullOrWhiteSpace(Model.HPCSANumber) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.HPCSANumber) ? "Not set" : Model.HPCSANumber)
                        </span>
                    </div>

                    <div class="p-info">
                        <span class="p-info-label">
                            Employee Number
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value @(string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? "Not set" : Model.EmployeeNumber)
                        </span>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-info">
                        <span class="p-info-label">
                            South African ID
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value @(string.IsNullOrWhiteSpace(Model.SouthAfricanID) ? "muted" : "")">
                            @(string.IsNullOrWhiteSpace(Model.SouthAfricanID) ? "Not set" : Model.SouthAfricanID)
                        </span>
                    </div>

                    <div class="p-info">
                        <span class="p-info-label">
                            Account Created
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </span>
                        <span class="p-info-value">
                            @Model.Timestamp_AccountCreated.ToString("dd MMMM yyyy")
                        </span>
                    </div>
                </div>

            </div>
        </div>
    }
        else
    {
        <!-- ============ EDIT MODE ============ -->
        <form asp-action="DoctorProfile" method="post" id="doctorProfileForm">

            @Html.AntiForgeryToken()

            <div class="p-panel">
                <div class="p-panel-head">
                    <span>
                        <i class="fa-solid fa-address-card"></i>
                        Edit Personal Information
                    </span>

                    <span class="p-panel-tag">Editable</span>
                </div>

                <div class="p-panel-body">

                    <div class="p-grid-2">
                        <div class="p-field">
                            <label for="FirstName">First Name</label>
                            <div class="p-input-wrap">
                                <i class="fa-solid fa-user"></i>
                                <input id="FirstName"
                                       name="FirstName"
                                       value="@Model.FirstName"
                                       class="p-input"
                                       placeholder="Enter your first name"
                                       maxlength="100"
                                       pattern="[A-Za-z]+"
                                       title="First name can only contain letters."
                                       autocomplete="given-name"
                                       required />
                            </div>
                            <span class="p-field-error">@Html.ValidationMessage("FirstName")</span>
                        </div>

                        <div class="p-field">
                            <label for="LastName">Last Name</label>
                            <div class="p-input-wrap">
                                <i class="fa-solid fa-user"></i>
                                <input id="LastName"
                                       name="LastName"
                                       value="@Model.LastName"
                                       class="p-input"
                                       placeholder="Enter your last name"
                                       maxlength="100"
                                       pattern="[A-Za-z]+"
                                       title="Last name can only contain letters."
                                       autocomplete="family-name"
                                       required />
                            </div>
                            <span class="p-field-error">@Html.ValidationMessage("LastName")</span>
                        </div>
                    </div>

                    <div class="p-grid-2">
                        <div class="p-field">
                            <label for="Email">E-mail</label>
                            <div class="p-input-wrap">
                                <i class="fa-solid fa-envelope"></i>
                                <input id="Email"
                                       name="Email"
                                       type="email"
                                       value="@Model.Email"
                                       class="p-input"
                                       placeholder="Enter your email address"
                                       maxlength="200"
                                       required />
                            </div>
                            <span class="p-field-error">@Html.ValidationMessage("Email")</span>
                        </div>

                        <div class="p-field">
                            <label for="PhoneNumb">Phone Number</label>
                            <div class="p-input-wrap">
                                <i class="fa-solid fa-mobile-screen"></i>
                                <input id="PhoneNumb"
                                       name="PhoneNumb"
                                       type="tel"
                                       value="@Model.PhoneNumb"
                                       class="p-input"
                                       placeholder="e.g. 0821234567"
                                       maxlength="10"
                                       inputmode="numeric"
                                       pattern="0[0-9]{9}"
                                       title="Phone number must be 10 digits and start with 0."
                                       autocomplete="tel"
                                       required />
                            </div>
                            <span class="p-field-error">@Html.ValidationMessage("PhoneNumb")</span>
                        </div>
                    </div>

                    <div class="p-grid-2">
                        <div class="p-field">
                            <label>
                                HPCSA Number
                                <i class="fa-solid fa-lock p-lock-icon"></i>
                            </label>
                            <div class="p-input-wrap p-input-wrap-locked">
                                <i class="fa-solid fa-id-badge"></i>
                                <input class="p-input p-input-locked"
                                       value="@(string.IsNullOrWhiteSpace(Model.HPCSANumber) ? "Not set" : Model.HPCSANumber)"
                                       readonly
                                       tabindex="-1" />
                            </div>
                        </div>

                        <div class="p-field">
                            <label>
                                Employee Number
                                <i class="fa-solid fa-lock p-lock-icon"></i>
                            </label>
                            <div class="p-input-wrap p-input-wrap-locked">
                                <i class="fa-solid fa-id-card"></i>
                                <input class="p-input p-input-locked"
                                       value="@(string.IsNullOrWhiteSpace(Model.EmployeeNumber) ? "Not set" : Model.EmployeeNumber)"
                                       readonly
                                       tabindex="-1" />
                            </div>
                        </div>
                    </div>

                    <div class="p-grid-2">
                        <div class="p-field">
                            <label>
                                Gender
                                <i class="fa-solid fa-lock p-lock-icon"></i>
                            </label>
                            <div class="p-input-wrap p-input-wrap-locked">
                                <i class="fa-solid fa-venus-mars"></i>
                                <input class="p-input p-input-locked"
                                       value="@(string.IsNullOrWhiteSpace(Model.Gender) ? "Not set" : Model.Gender)"
                                       readonly />
                            </div>
                        </div>

                        <div class="p-field">
                            <label>
                                South African ID
                                <i class="fa-solid fa-lock p-lock-icon"></i>
                            </label>
                            <div class="p-input-wrap p-input-wrap-locked">
                                <i class="fa-solid fa-fingerprint"></i>
                                <input class="p-input p-input-locked"
                                       value="@(string.IsNullOrWhiteSpace(Model.SouthAfricanID) ? "Not set" : Model.SouthAfricanID)"
                                       readonly />
                            </div>
                        </div>
                    </div>

                    <div class="p-grid-2">
                        <div class="p-field">
                            <label>
                                Account Created
                                <i class="fa-solid fa-lock p-lock-icon"></i>
                            </label>
                            <div class="p-input-wrap p-input-wrap-locked">
                                <i class="fa-solid fa-calendar-day"></i>
                                <input class="p-input p-input-locked"
                                       value="@Model.Timestamp_AccountCreated.ToString("dd MMMM yyyy")"
                                       readonly />
                            </div>
                        </div>
                    </div>

                    <div class="p-form-actions">
                        <a asp-action="DoctorProfile" class="p-btn-ghost">
                            <i class="fas fa-times"></i>
                            Cancel
                        </a>
                        <button type="submit" class="p-btn-save">
                            <i class="fas fa-floppy-disk"></i>
                            Save Changes
                        </button>
                    </div>

                </div>
            </div>
        </form>
    }

    <!-- =========================================================
         CHANGE PASSWORD
         ========================================================= -->
    <div class="p-panel p-section-panel" id="change-password">

        <div class="p-panel-head">
            <span>
                <i class="fa-solid fa-lock"></i>
                Change Password
            </span>

            <span class="p-panel-tag">Security</span>
        </div>

        <div class="p-panel-body">

            <div class="p-info-note">
                <i class="fa-solid fa-circle-info"></i>
                <span>
                    Use this to change the password you use to sign in to LabDash.
                    Your new password must meet the requirements below.
                </span>
            </div>

            <form asp-controller="Account"
                  asp-action="ChangePassword"
                  method="post"
                  id="changePasswordForm">

                @Html.AntiForgeryToken()

                <div class="p-field p-field-spaced">
                    <label for="CurrentPassword">Current Password</label>

                    <div class="p-input-wrap">
                        <i class="fa-solid fa-key"></i>
                        <input id="CurrentPassword"
                               name="CurrentPassword"
                               type="password"
                               class="p-input"
                               autocomplete="current-password"
                               placeholder="Enter your current password"
                               required />
                        <button type="button"
                                class="p-eye"
                                data-toggle-pw="CurrentPassword"
                                title="Show / hide password">
                            <i class="fa-solid fa-eye"></i>
                        </button>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-field">
                        <label for="NewPassword">New Password</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-lock"></i>
                            <input id="NewPassword"
                                   name="NewPassword"
                                   type="password"
                                   class="p-input"
                                   autocomplete="new-password"
                                   placeholder="Enter a new password"
                                   required />
                            <button type="button"
                                    class="p-eye"
                                    data-toggle-pw="NewPassword"
                                    title="Show / hide password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <div class="p-strength" aria-hidden="true">
                            <span></span><span></span><span></span><span></span>
                        </div>
                        <div class="p-strength-label" id="pwStrengthLabel">Enter a password to see its strength</div>
                    </div>

                    <div class="p-field">
                        <label for="ConfirmPassword">Confirm New Password</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-lock"></i>
                            <input id="ConfirmPassword"
                                   name="ConfirmPassword"
                                   type="password"
                                   class="p-input"
                                   autocomplete="new-password"
                                   placeholder="Re-enter the new password"
                                   required />
                            <button type="button"
                                    class="p-eye"
                                    data-toggle-pw="ConfirmPassword"
                                    title="Show / hide password">
                                <i class="fa-solid fa-eye"></i>
                            </button>
                        </div>

                        <div class="p-strength-label" id="pwMatchLabel"></div>
                    </div>
                </div>

                <ul class="p-pw-rules" id="pwRules">
                    <li data-rule="len"><i class="fa-solid fa-circle"></i> At least 8 characters</li>
                    <li data-rule="upper"><i class="fa-solid fa-circle"></i> One uppercase letter</li>
                    <li data-rule="lower"><i class="fa-solid fa-circle"></i> One lowercase letter</li>
                    <li data-rule="num"><i class="fa-solid fa-circle"></i> One number</li>
                    <li data-rule="sym"><i class="fa-solid fa-circle"></i> One special character</li>
                </ul>

                <button type="submit" class="p-submit">
                    <i class="fas fa-key"></i>
                    Change Password
                </button>
            </form>

        </div>
    </div>


    <!-- =========================================================
         FOOTER
         ========================================================= -->
    <div class="p-footer">
        <hr />
        <div class="p-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="p-footer-divider">|</span>
            <span>Doctor Portal</span>
            <span class="p-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </div>

</div>


<!-- =============================================================
     STYLES
     ============================================================= -->
<style>

    :root {
        --p-paper: #F0F7F6;
        --p-raised: #FFFFFF;
        --p-ink: #102C27;
        --p-ink-soft: #52716C;
        --p-ink-faint: #8FA9A3;
        --p-line: #E1EEEC;
        --p-line-strong: #CCE3DF;
        --p-teal: #0E8C7F;
        --p-teal-deep: #0A5850;
        --p-teal-dim: #E3F4F1;
        --p-teal-grad-start: #12A392;
        --p-teal-grad-end: #0A4F48;
        --p-danger: #B0463F;
        --p-danger-dim: #FBECEA;
        --p-radius: 20px;
        --p-radius-sm: 13px;
        --p-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --p-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    html {
        scroll-behavior: smooth;
    }

    .p-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--p-ink);
        font-family: 'Inter', sans-serif;
        animation: pFadeIn .5s ease;
    }

    @@keyframes pFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .p-wrap, .p-icon-ring {
            animation: none;
        }
    }

    /* ===== BANNER ===== */

    .p-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        border-radius: var(--p-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }

    .p-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .p-banner-left {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .p-banner-avatar {
        position: relative;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 24px;
        flex-shrink: 0;
    }

    .p-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: pRingPulse 2.4s ease-out infinite;
    }

    @@keyframes pRingPulse {
        0% {
            transform: scale(0.9);
            opacity: .8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .p-banner-text {
        position: relative;
        z-index: 1;
    }

        .p-banner-text h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin: 0 0 4px;
            color: #fff;
            letter-spacing: -.01em;
        }

        .p-banner-text p {
            margin: 0 0 14px;
            color: rgba(255,255,255,.85);
            font-size: 14.5px;
        }

    .p-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .p-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
    }

    .p-banner-cta {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 13.5px;
        padding: 12px 20px;
        border-radius: 999px;
        transition: background .2s, transform .2s;
    }

        .p-banner-cta:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* ===== TOAST + STATUS ===== */

    .p-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 15px 20px;
        border-radius: var(--p-radius-sm);
        margin-bottom: 20px;
        border-left: 4px solid var(--p-teal);
        font-size: 14px;
        font-weight: 500;
    }

    .p-toast-error {
        background: var(--p-danger-dim);
        color: var(--p-danger);
        border-left-color: var(--p-danger);
    }

    .p-toast-block {
        align-items: flex-start;
    }

        .p-toast-block i {
            margin-top: 3px;
        }

    .p-validation-list ul {
        margin: 0;
        padding-left: 18px;
    }

    .p-status-strip {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow-sm);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        border-left: 4px solid var(--p-teal);
    }

    .p-status-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13.5px;
        color: var(--p-ink);
    }

        .p-status-left strong {
            color: var(--p-teal-deep);
        }

    .p-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--p-teal);
        flex-shrink: 0;
        box-shadow: 0 0 0 4px var(--p-teal-dim);
    }

    .p-status-strip > i {
        color: var(--p-ink-faint);
        font-size: 15px;
    }

    /* ===== PANELS ===== */

    .p-panel {
        background: var(--p-raised);
