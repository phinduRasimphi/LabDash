@section Scripts {

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            /* ---------- first name + last name: letters only ---------- */

            ["FirstName", "LastName"].forEach(function (id) {
                var el = document.getElementById(id);
                if (!el) return;
                el.addEventListener("input", function () {
                    this.value = this.value.replace(/[^A-Za-z]/g, "");
                });
            });

            /* ---------- phone: digits only, max 10 ---------- */

            var phone = document.getElementById("PhoneNumb");
            if (phone) {
                phone.addEventListener("input", function () {
                    this.value = this.value.replace(/\D/g, "").slice(0, 10);
                });
            }

            /* ---------- show / hide password ---------- */

            document.querySelectorAll("[data-toggle-pw]").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    const input = document.getElementById(this.dataset.togglePw);
                    if (!input) return;

                    const show = input.type === "password";
                    input.type = show ? "text" : "password";

                    const icon = this.querySelector("i");
                    icon.classList.toggle("fa-eye", !show);
                    icon.classList.toggle("fa-eye-slash", show);
                });
            });

            /* ---------- password strength, rules and match ---------- */

            const newPw = document.getElementById("NewPassword");
            const confirmPw = document.getElementById("ConfirmPassword");
            const meter = document.querySelector(".p-strength");
            const strengthLabel = document.getElementById("pwStrengthLabel");
            const matchLabel = document.getElementById("pwMatchLabel");
            const rules = document.getElementById("pwRules");

            function evaluate() {

                if (!newPw || !meter) return;

                const v = newPw.value;

                const checks = {
                    len: v.length >= 8,
                    upper: /[A-Z]/.test(v),
                    lower: /[a-z]/.test(v),
                    num: /\d/.test(v),
                    sym: /[^A-Za-z0-9]/.test(v)
                };

                Object.keys(checks).forEach(function (key) {
                    const li = rules.querySelector('[data-rule="' + key + '"]');
                    if (li) li.classList.toggle("met", checks[key]);
                });

                const score = Object.values(checks).filter(Boolean).length;
                const level = v.length === 0 ? 0 : score <= 2 ? 1 : score === 3 ? 2 : score === 4 ? 3 : 4;
                const names = ["", "Weak", "Fair", "Good", "Strong"];

                meter.dataset.level = level;
                strengthLabel.textContent = v.length === 0
                    ? "Enter a password to see its strength"
                    : "Strength: " + names[level];

                if (confirmPw && confirmPw.value.length > 0) {
                    const same = confirmPw.value === v;
                    matchLabel.textContent = same ? "Passwords match" : "Passwords do not match";
                    matchLabel.className = "p-strength-label " + (same ? "ok" : "bad");
                } else if (matchLabel) {
                    matchLabel.textContent = "";
                }
            }

            if (newPw) newPw.addEventListener("input", evaluate);
            if (confirmPw) confirmPw.addEventListener("input", evaluate);

            evaluate();
        });
    </script>

}