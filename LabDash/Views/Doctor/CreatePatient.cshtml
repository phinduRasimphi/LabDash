@model LabDash.ViewModels.PatientCreateViewModel

@{
    ViewData["Title"] = "Create New Patient";
    ViewData["ActivePage"] = "ManagePatients";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .patient-page {
        width: 100%;
        max-width: 1100px;
        margin: 0 auto;
        padding: 24px;
    }

    .patient-header {
        margin-bottom: 24px;
    }

        .patient-header h2 {
            color: #174c49;
            font-weight: 700;
            margin-bottom: 6px;
        }

        .patient-header p {
            color: #687779;
            margin: 0;
        }

    .patient-section {
        background: #fff;
        border: 1px solid #e1e9e8;
        border-radius: 16px;
        padding: 24px;
        margin-bottom: 22px;
        box-shadow: 0 4px 15px rgba(20, 70, 65, .04);
    }

        .patient-section h4 {
            color: #176b63;
            font-size: 17px;
            font-weight: 700;
            margin-bottom: 20px;
            padding-bottom: 12px;
            border-bottom: 1px solid #e5eeec;
        }

    .patient-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .patient-field {
        min-width: 0;
    }

        .patient-field label {
            display: block;
            font-weight: 600;
            font-size: 13px;
            margin-bottom: 7px;
            color: #344b49;
        }

        .patient-field input,
        .patient-field select {
            width: 100%;
            border: 1px solid #cedbd9;
            border-radius: 9px;
            padding: 11px 12px;
            background: #fff;
            color: #263b39;
        }

            .patient-field input:focus,
            .patient-field select:focus {
                border-color: #168277;
                outline: none;
                box-shadow: 0 0 0 3px rgba(22, 130, 119, .10);
            }

            .patient-field select:disabled {
                background: #f1f5f4;
                cursor: not-allowed;
            }

    .field-validation {
        display: block;
        color: #b42318;
        font-size: 12px;
        margin-top: 5px;
    }

    .medical-help {
        color: #6b7d7a;
        font-size: 12px;
        margin-top: 6px;
    }

    .patient-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
        margin: 20px 0;
    }

    .patient-btn {
        display: inline-block;
        padding: 11px 20px;
        border-radius: 9px;
        border: none;
        text-decoration: none;
        font-weight: 600;
        cursor: pointer;
    }

    .patient-btn-primary {
        background: #0d6b63;
        color: #fff;
    }

        .patient-btn-primary:hover {
            background: #09564f;
            color: #fff;
        }

    .patient-btn-secondary {
        background: #edf3f2;
        color: #36514e;
    }

    @@media (max-width: 700px) {
        .patient-page {
            padding: 14px;
        }

        .patient-section {
            padding: 17px;
        }

        .patient-grid {
            grid-template-columns: 1fr;
        }
    }
</style>

<div class="patient-page">
    <div class="patient-header">
        <h2>Create New Patient</h2>
        <p>Register a patient and record their address and medical information.</p>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Warning"] != null)
    {
        <div class="alert alert-warning">@TempData["Warning"]</div>
    }

    <form asp-controller="Doctor"
          asp-action="CreatePatient"
          method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="alert alert-danger"></div>

        <!-- ============================================================
             PERSONAL INFORMATION
             ============================================================ -->
        <section class="patient-section">
            <h4>Personal Information</h4>

            <div class="patient-grid">

                <!-- Row 1: Name | Surname -->
                <div class="patient-field">
                    <label asp-for="Name">First Name</label>
                    <input asp-for="Name" autocomplete="given-name" />
                    <span asp-validation-for="Name" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="Surname">Surname</label>
                    <input asp-for="Surname" autocomplete="family-name" />
                    <span asp-validation-for="Surname" class="field-validation"></span>
                </div>

                <!-- Row 2: ID Number | Date of Birth -->
                <div class="patient-field">
                    <label asp-for="IDNumber">South African ID Number</label>
                    <input asp-for="IDNumber" maxlength="13" inputmode="numeric" />
                    <span asp-validation-for="IDNumber" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="DOB">Date of Birth</label>
                    <input asp-for="DOB" type="date" />
                    <span asp-validation-for="DOB" class="field-validation"></span>
                </div>

                <!-- Row 3: Cellphone | Email -->
                <div class="patient-field">
                    <label asp-for="CellphoneNumber">Cellphone Number</label>
                    <input asp-for="CellphoneNumber" type="tel" autocomplete="tel" />
                    <span asp-validation-for="CellphoneNumber" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="Email">Email Address</label>
                    <input asp-for="Email" type="email" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation"></span>
                </div>

            </div>
        </section>

        <!-- ============================================================
             ADDRESS INFORMATION
             Location dropdowns first, then the two text address lines.
             ============================================================ -->
        <section class="patient-section">
            <h4>Address Information</h4>

            <div class="patient-grid">

                <!-- Row 1: Province | City -->
                <div class="patient-field">
                    <label asp-for="Province">Province</label>
                    <select asp-for="Province" id="Province">
                        <option value="">Select Province</option>
                        @foreach (var province in Model.Provinces)
                        {
                            <option value="@province.Value"
                                    selected="@province.Selected">
                                @province.Text
                            </option>
                        }
                    </select>
                    <span asp-validation-for="Province" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="City">City / Town</label>
                    <select asp-for="City" id="City" disabled>
                        <option value="">Select City / Town</option>
                    </select>
                    <span asp-validation-for="City" class="field-validation"></span>
                </div>

                <!-- Row 2: Suburb | Postal Code -->
                <div class="patient-field">
                    <label asp-for="Suburb">Suburb</label>
                    <select asp-for="Suburb" id="Suburb" disabled>
                        <option value="">Select Suburb</option>
                    </select>
                    <span asp-validation-for="Suburb" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="PostalCode">Postal Code</label>
                    <select asp-for="PostalCode" id="PostalCode" disabled>
                        <option value="">Select Postal Code</option>
                    </select>
                    <span asp-validation-for="PostalCode" class="field-validation"></span>
                </div>

                <!-- Row 3: Address Line 1 | Address Line 2 -->
                <div class="patient-field">
                    <label asp-for="AddressLine1">Address Line 1</label>
                    <input asp-for="AddressLine1"
                           placeholder="House number and street name" />
                    <span asp-validation-for="AddressLine1" class="field-validation"></span>
                </div>

                <div class="patient-field">
                    <label asp-for="AddressLine2">Address Line 2 (Optional)</label>
                    <input asp-for="AddressLine2"
                           placeholder="Building, complex or additional details" />
                    <span asp-validation-for="AddressLine2" class="field-validation"></span>
                </div>

            </div>
        </section>

        <!-- ============================================================
             MEDICAL INFORMATION
             Three category/item pairs: Condition, Allergy, Medication.
             ============================================================ -->
        <section class="patient-section">
            <h4>Medical Information</h4>

            <div class="patient-grid">

                <!-- ---------- Medical Condition: Category | Item ---------- -->
                <div class="patient-field">
                    <label asp-for="SelectedMedicalConditionCategory">
                        Medical Condition Category
                    </label>

                    <select asp-for="SelectedMedicalConditionCategory"
                            id="conditionCategory">
                        <option value="">Select Category</option>
                        @foreach (var category in Model.MedicalConditionCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="patient-field">
                    <label asp-for="SelectedMedicalConditionId">
                        Medical Condition
                    </label>

                    <select asp-for="SelectedMedicalConditionId"
                            id="conditionItem"
                            disabled>
                        <option value="">Select Medical Condition</option>
                        @foreach (var item in Model.MedicalConditionOptions)
                        {
                            <option value="@item.Id"
                                    data-category="@item.Category">
                                @item.Name
                            </option>
                        }
                    </select>

                    <div class="medical-help">
                        Select a category first. Leave the selection empty if none applies.
                    </div>
                </div>

                <!-- ---------- Allergy: Category | Item ---------- -->
                <div class="patient-field">
                    <label asp-for="SelectedAllergyCategory">
                        Allergy Category
                    </label>

                    <select asp-for="SelectedAllergyCategory"
                            id="allergyCategory">
                        <option value="">Select Category</option>
                        @foreach (var category in Model.AllergyCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="patient-field">
                    <label asp-for="SelectedAllergyId">Allergy</label>

                    <select asp-for="SelectedAllergyId"
                            id="allergyItem"
                            disabled>
                        <option value="">Select Allergy</option>
                        @foreach (var item in Model.AllergyOptions)
                        {
                            <option value="@item.Id"
                                    data-category="@item.Category">
                                @item.Name
                            </option>
                        }
                    </select>

                    <div class="medical-help">
                        Select a category to view matching allergies.
                    </div>
                </div>

                <!-- ---------- Medication: Category | Item ---------- -->
                <div class="patient-field">
                    <label asp-for="SelectedMedicationCategory">
                        Medication Category
                    </label>

                    <select asp-for="SelectedMedicationCategory"
                            id="medicationCategory">
                        <option value="">Select Category</option>
                        @foreach (var category in Model.MedicationCategories)
                        {
                            <option value="@category">@category</option>
                        }
                    </select>
                </div>

                <div class="patient-field">
                    <label asp-for="SelectedMedicationId">Medication</label>

                    <select asp-for="SelectedMedicationId"
                            id="medicationItem"
                            disabled>
                        <option value="">Select Medication</option>
                        @foreach (var item in Model.MedicationOptions)
                        {
                            <option value="@item.Id"
                                    data-category="@item.Category">
                                @item.Name
                            </option>
                        }
                    </select>

                    <div class="medical-help">
                        Select a category to view matching medications.
                    </div>
                </div>

            </div>
        </section>

        <div class="patient-actions">
            <a asp-controller="Doctor"
               asp-action="ManagePatients"
               class="patient-btn patient-btn-secondary">
                Cancel
            </a>

            <button type="submit" class="patient-btn patient-btn-primary">
                Register Patient
            </button>
        </div>
    </form>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script src="~/js/patient-create.js" asp-append-version="true"></script>
}