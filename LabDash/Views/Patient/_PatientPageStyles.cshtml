<link rel="preconnect" href="https://fonts.googleapis.com" />
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet" />

<style>
    .pp-wrap { --pt: #0E8C7F; --pt-deep: #0A5850; --pt-dim: #E3F4F1; --bl: #2C6E9E; --or: #B76A2C; --or-dim: #FBEEE1; --rd: #B0463F; --rd-dim: #F7E8E7; --gn: #2F855A; --gn-dim: #F0F9F4; --ink: #102C27; --ink-s: #52716C; --ln: #E1EEEC; --r: 20px; --sh: 0 6px 24px rgba(10,60,55,.08); --sh-sm: 0 3px 10px rgba(10,60,55,.06); max-width: 1100px; margin: 0 auto; padding: 26px 24px 60px; color: var(--ink); font-family: 'Inter',sans-serif }
    .pp-crumb { display: flex; align-items: center; gap: 10px; font-size: 13px; color: var(--ink-s); margin-bottom: 18px }
    .pp-crumb a { color: var(--pt-deep); text-decoration: none; font-weight: 600 }
    .pp-crumb a:hover { text-decoration: underline }
    .pp-crumb i { font-size: 10px; color: #8FA9A3 }
    .pp-crumb strong { color: var(--ink) }

    .pp-banner { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; background: linear-gradient(125deg,#12A392,#0A4F48); border-radius: var(--r); padding: 28px 34px; margin-bottom: 22px; color: #fff; box-shadow: 0 18px 40px rgba(10,90,80,.2) }
    .pp-banner h1 { margin: 0 0 4px; font: 700 24px 'Poppins',sans-serif; color: #fff }
    .pp-banner p { margin: 0; color: rgba(255,255,255,.85); font-size: 14px }

    .pp-panel { background: #fff; border-radius: var(--r); box-shadow: var(--sh); overflow: hidden; margin-bottom: 18px }
    .pp-panel-head { display: flex; justify-content: space-between; align-items: center; gap: 12px; flex-wrap: wrap; padding: 18px 26px; border-bottom: 1px solid var(--ln); font: 700 15.5px 'Poppins',sans-serif }
    .pp-panel-head i { color: var(--pt); margin-right: 8px }
    .pp-body { padding: 22px 26px 26px }

    .pp-track { display: flex }
    .pp-tstep { flex: 1; display: flex; flex-direction: column; align-items: center; gap: 8px; position: relative; text-align: center }
    .pp-tstep::before { content: ""; position: absolute; top: 15px; right: 50%; width: 100%; height: 3px; background: var(--ln) }
    .pp-tstep:first-child::before { display: none }
    .pp-tstep.done::before, .pp-tstep.current::before { background: var(--pt) }
    .pp-tdot { position: relative; z-index: 1; width: 32px; height: 32px; border-radius: 50%; display: flex; align-items: center; justify-content: center; background: #fff; border: 2px solid var(--ln); color: var(--ink-s); font: 700 12px 'Inter',sans-serif }
    .pp-tstep.done .pp-tdot { background: var(--pt); border-color: var(--pt); color: #fff }
    .pp-tstep.current .pp-tdot { border-color: var(--pt); color: var(--pt-deep); box-shadow: 0 0 0 4px var(--pt-dim) }
    .pp-tlabel { font-size: 11.5px; font-weight: 600; color: var(--ink-s) }
    .pp-tstep.done .pp-tlabel, .pp-tstep.current .pp-tlabel { color: var(--ink) }

    .pp-facts { display: grid; grid-template-columns: repeat(4,1fr); gap: 12px; margin-top: 22px }
    .pp-facts > div { display: flex; flex-direction: column; gap: 4px; align-items: flex-start; border: 1px solid var(--ln); border-radius: 12px; padding: 11px 13px }
    .pp-facts small { font-size: 11px; font-weight: 600; color: var(--ink-s); text-transform: uppercase; letter-spacing: .03em }
    .pp-facts strong { font-size: 14px }

    .pp-note { display: flex; gap: 10px; padding: 14px 18px; border-radius: 14px; background: var(--pt-dim); color: var(--pt-deep); font-size: 13.5px; line-height: 1.55; margin-bottom: 18px }
    .pp-note.warn { background: var(--or-dim); color: #924E18 }

    .pp-table-wrap { overflow-x: auto }
    .pp-table { width: 100%; border-collapse: collapse }
    .pp-table th { background: #F0F7F6; text-align: left; padding: 12px 22px; font-size: 12px; text-transform: uppercase; color: var(--ink-s); border-bottom: 1px solid var(--ln); white-space: nowrap }
    .pp-table td { padding: 14px 22px; border-bottom: 1px solid var(--ln); font-size: 14px; vertical-align: top }
    .pp-table tr:last-child td { border-bottom: 0 }
    .pp-table tr.is-abnormal td { background: var(--or-dim) }
    .pp-empty { text-align: center; color: var(--ink-s); padding: 44px 26px; font-size: 14px }
    .pp-empty i { display: block; font-size: 26px; color: var(--pt); margin-bottom: 10px }

    .pp-urgency, .pp-status, .pp-flag { display: inline-block; padding: 3px 10px; border-radius: 999px; font-size: 11.5px; font-weight: 600 }
    .pp-urgency.routine { background: var(--pt-dim); color: var(--pt-deep) }
    .pp-urgency.urgent { background: var(--or-dim); color: #924E18 }
    .pp-urgency.stat { background: var(--rd-dim); color: #942F28 }
    .pp-status.submitted { background: #F0F4F8; color: #3C5770 }
    .pp-status.inprogress { background: var(--or-dim); color: #924E18 }
    .pp-status.completed { background: var(--gn-dim); color: var(--gn) }
    .pp-status.released { background: var(--pt-dim); color: var(--pt-deep) }
    .pp-flag.normal { background: var(--gn-dim); color: var(--gn) }
    .pp-flag.abnormal { background: var(--or-dim); color: #924E18 }

    .pp-actions { display: flex; flex-wrap: wrap; gap: 10px }
    .pp-btn { display: inline-flex; align-items: center; gap: 8px; border: 1px solid var(--ln); background: #fff; color: var(--pt-deep); font: 600 13px 'Inter',sans-serif; padding: 9px 16px; border-radius: 999px; cursor: pointer; text-decoration: none }
    .pp-btn:hover { background: var(--pt-dim); color: var(--pt-deep); text-decoration: none }
    .pp-btn.primary { background: var(--pt); border-color: var(--pt); color: #fff }
    .pp-btn.primary:hover { background: var(--pt-deep); border-color: var(--pt-deep); color: #fff }
    .pp-btn.is-disabled { opacity: .5; cursor: not-allowed }

    .pp-chips { display: flex; gap: 8px; flex-wrap: wrap }
    .pp-chip { display: inline-flex; gap: 7px; align-items: center; border: 1px solid var(--ln); color: var(--ink-s); font: 600 12px 'Inter',sans-serif; padding: 6px 13px; border-radius: 999px; text-decoration: none; background: #fff }
    .pp-chip b { background: #F0F4F8; color: #3C5770; border-radius: 999px; padding: 1px 8px; font-size: 11px }
    .pp-chip:hover { background: var(--pt-dim); text-decoration: none; color: var(--ink-s) }
    .pp-chip.is-active { background: var(--pt); border-color: var(--pt); color: #fff }
    .pp-chip.is-active b { background: rgba(255,255,255,.22); color: #fff }

    @@media (max-width: 800px) {
        .pp-facts { grid-template-columns: repeat(2,1fr) }
        .pp-wrap { padding: 20px 16px 50px }
        .pp-tlabel { font-size: 10.5px }
    }
</style>
