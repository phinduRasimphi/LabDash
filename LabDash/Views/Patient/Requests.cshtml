        }

        .rq-dock-btn {
            padding: 11px 13px;
        }

        .rq-donut-row {
            flex-direction: column;
            align-items: flex-start;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .rq-wrap *, .rq-wrap *::before, .rq-wrap *::after {
            animation: none !important;
            transition: none !important;
        }
    }

    /* ============ PRINT ============ */
    @@media print {
        aside, nav, .sidebar, .navbar, #sidebar, .side-nav, .topbar, .app-sidebar {
            display: none !important;
        }

        .rq-theme, .rq-progress, .rq-dock, .rq-toast, .rq-modal, .rq-toolbar, .rq-sticky, .rq-resultbar, .rq-spot, .rq-since,
        .rq-ticker, .rq-more-wrap, .rq-sentinel, .rq-no-matches, .rq-guide, .rq-insights, .rq-top-sentinel,
        .rq-stub-tools, .rq-cancel-btn, .rq-drawer-tools, .rq-details-btn, .rq-tests-toggle {
            display: none !important;
        }

        .rq-wrap {
            max-width: none;
            padding: 0;
            background: #fff;
        }

        .rq-card {
            break-inside: avoid;
            box-shadow: none !important;
            border: 1px solid #ccc;
            transform: none !important;
            animation: none !important;
        }

            .rq-card .rq-test-extra {
                display: inline-flex !important;
            }

        .rq-drawer {
            grid-template-rows: 1fr !important;
        }

        .rq-list.rq-grid {
            display: flex;
        }

        body.rq-print-one .rq-wrap > *:not(.rq-list) {
            display: none !important;
        }

        body.rq-print-one .rq-list > *:not(.rq-print-target) {
            display: none !important;
        }

        body.rq-print-one .rq-print-target .rq-drawer-tools {
            display: none !important;
        }
    }
</style>

<script>
    (function() {
        var wrap = document.getElementById('rqWrap');
        var root = document.documentElement;
        var reduce = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;
        var preview = @(preview ? "true" : "false");
        var NS = preview ? 'rqPv_' : 'rq_';

        function store(k, v) { try { localStorage.setItem(k, v); } catch (e) { } }
        function read(k) { try { return localStorage.getItem(k); } catch (e) { return null; } }
        function readJson(k, fallback) { try { var v = JSON.parse(localStorage.getItem(k)); return v === null || v === undefined ? fallback : v; } catch (e) { return fallback; } }
        function pad(n, len) { var s = String(n); while (s.length < len) { s = '0' + s; } return s; }

        var toastEl = document.getElementById('rqToast');
        var toastTimer;
        function toast(msg) {
            if (!toastEl) { return; }
            toastEl.textContent = msg;
            toastEl.classList.add('rq-show');
            clearTimeout(toastTimer);
            toastTimer = setTimeout(function() { toastEl.classList.remove('rq-show'); }, 2000);
        }

        // ---------------------------------------------
        // Light / dark mode (whole page, remembered, follows the device until you choose)
        // ---------------------------------------------
        var themeBtn = document.getElementById('rqTheme');
        function setTheme(t) {
            wrap.setAttribute('data-theme', t);
            root.classList.toggle('rq-dark', t === 'dark');
            if (themeBtn) { themeBtn.firstElementChild.className = t === 'dark' ? 'fa-solid fa-sun' : 'fa-solid fa-moon'; }
        }
        var savedTheme = read('rqTheme');
        var sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
        setTheme(savedTheme ? (savedTheme === 'dark' ? 'dark' : 'light') : (sysDark ? 'dark' : 'light'));
        function toggleTheme() {
            var next = wrap.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
            setTheme(next);
            store('rqTheme', next);
        }
        if (themeBtn) { themeBtn.addEventListener('click', toggleTheme); }

        // Always print in light mode
        var themeBeforePrint = null;
        window.addEventListener('beforeprint', function() { themeBeforePrint = wrap.getAttribute('data-theme'); setTheme('light'); });
        window.addEventListener('afterprint', function() {
            if (themeBeforePrint) { setTheme(themeBeforePrint); themeBeforePrint = null; }
            document.body.classList.remove('rq-print-one');
            document.querySelectorAll('.rq-print-target').forEach(function(c) { c.classList.remove('rq-print-target'); });
        });

        // ---------------------------------------------
        // Find a fixed/sticky site header so our sticky bits sit under it
        // ---------------------------------------------
        var topOffset = 0;
        function detectTop() {
            var h = 0;
            document.querySelectorAll('header, nav, .navbar, .topbar, .top-bar, .app-header').forEach(function(el) {
                if (wrap.contains(el)) { return; }
                var cs = getComputedStyle(el);
                var r = el.getBoundingClientRect();
                if ((cs.position === 'fixed' || cs.position === 'sticky') && r.top <= 1 && r.height > 0 && r.height < 200 && r.width > window.innerWidth * 0.5) {
                    h = Math.max(h, r.bottom);
                }
            });
            topOffset = Math.round(h);
            wrap.style.setProperty('--rq-top', topOffset + 'px');
        }
        detectTop();
        window.addEventListener('resize', detectTop);

        // ---------------------------------------------
        // Banner count-up and ring fill (the one load-time moment)
        // ---------------------------------------------
        function countUp(el, target, len, dec, dur) {
            var start = null;
            function step(ts) {
                if (start === null) { start = ts; }
                var p = Math.min((ts - start) / dur, 1);
                var v = target * (1 - Math.pow(1 - p, 3));
                el.textContent = dec ? v.toFixed(dec) : pad(Math.round(v), len);
                if (p < 1) { requestAnimationFrame(step); }
            }
            requestAnimationFrame(step);
        }

        if (!reduce) {
            document.querySelectorAll('.rq-count').forEach(function(el) {
                var target = parseInt(el.dataset.count, 10) || 0;
                var len = parseInt(el.dataset.pad, 10) || 1;
                el.textContent = pad(0, len);
                countUp(el, target, len, 0, 800);
            });

            var ring = document.getElementById('rqRing');
            if (ring) {
                var pct = parseFloat(ring.dataset.pct) || 0;
                var rs = null;
                ring.style.setProperty('--rq-pct', 0);
                requestAnimationFrame(function tick(ts) {
                    if (rs === null) { rs = ts; }
                    var p = Math.min((ts - rs) / 900, 1);
                    ring.style.setProperty('--rq-pct', pct * (1 - Math.pow(1 - p, 3)));
                    if (p < 1) { requestAnimationFrame(tick); }
                });
            }
        }

        // ---------------------------------------------
        // Copy helper + copy request number
        // ---------------------------------------------
        function copyText(text, done) {
            if (navigator.clipboard && navigator.clipboard.writeText) {
                navigator.clipboard.writeText(text).then(done).catch(function() { });
            } else {
                var ta = document.createElement('textarea');
                ta.value = text;
                ta.style.position = 'fixed';
                ta.style.opacity = '0';
                document.body.appendChild(ta);
                ta.select();
                try { document.execCommand('copy'); done(); } catch (e) { }
                document.body.removeChild(ta);
            }
        }

        document.querySelectorAll('.rq-copy-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var text = btn.getAttribute('data-copy');
                var icon = btn.querySelector('i');
                copyText(text, function() {
                    icon.classList.remove('fa-copy');
                    icon.classList.add('fa-check');
                    btn.classList.add('rq-copied');
                    toast('Copied ' + text);
                    setTimeout(function() {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-copy');
                        btn.classList.remove('rq-copied');
                    }, 1500);
                });
            });
        });

        // ---------------------------------------------
        // Expand / collapse test chips
        // ---------------------------------------------
        document.querySelectorAll('.rq-tests-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var target = document.getElementById(btn.getAttribute('data-target'));
                if (!target) { return; }
                var expanded = target.classList.toggle('rq-expanded');
                btn.classList.toggle('rq-open', expanded);
                var label = btn.querySelector('.rq-tests-toggle-label');
                var extraCount = target.querySelectorAll('.rq-test-extra').length;
                if (label) { label.textContent = expanded ? 'Show less' : ('+' + extraCount + ' more'); }
            });
        });

        // ---------------------------------------------
        // Pins, "updated since last visit" flags, unread results, private notes
        // ---------------------------------------------
        var allCards = Array.prototype.slice.call(document.querySelectorAll('.rq-card'));
        var pins = readJson(NS + 'pins', []);
        var seen = readJson(NS + 'seen', []);
        var snap = readJson(NS + 'snap', null);
        var flags = readJson(NS + 'flags', {});
        var STATUS_NAME = { submitted: 'Submitted', received: 'Sample received', inprogress: 'In progress', completed: 'Completed', released: 'Results ready', cancelled: 'Cancelled' };

        function saveAll() {
            store(NS + 'pins', JSON.stringify(pins));
            store(NS + 'seen', JSON.stringify(seen));
            store(NS + 'flags', JSON.stringify(flags));
        }

        function markSeen(id) {
            if (seen.indexOf(id) === -1) { seen.push(id); }
            delete flags[id];
            saveAll();
        }

        // work out what changed since the last visit
        var firstVisit = snap === null;
        var newSnap = {};
        allCards.forEach(function(card) {
            var id = card.dataset.id;
            var st = card.dataset.status;
            newSnap[id] = st;
            if (!firstVisit) {
                if (!(id in snap)) { flags[id] = { t: 'new' }; }
                else if (snap[id] !== st) { flags[id] = { t: 'updated', from: snap[id] }; }
            }
        });
        // drop flags for requests that no longer exist
        Object.keys(flags).forEach(function(id) { if (!(id in newSnap)) { delete flags[id]; } });
        store(NS + 'snap', JSON.stringify(newSnap));
        saveAll();

        function paintCard(card) {
            var id = card.dataset.id;
            var pinned = pins.indexOf(id) !== -1;
            var f = flags[id];
            var unread = card.dataset.status === 'released' && seen.indexOf(id) === -1 && Number(card.dataset.relDays) <= 14;

            card.dataset.pinned = pinned ? 'true' : 'false';
            card.dataset.flag = f ? f.t : '';
            card.dataset.unread = unread ? 'true' : 'false';

            var pb = card.querySelector('.rq-pin-btn');
            pb.setAttribute('aria-pressed', pinned ? 'true' : 'false');
            pb.title = pinned ? 'Unpin this request' : 'Pin this request';
            pb.firstElementChild.className = pinned ? 'fa-solid fa-star' : 'fa-regular fa-star';

            var box = card.querySelector('.rq-badges');
            box.innerHTML = '';
            function badge(cls, icon, text, title) {
                var b = document.createElement('span');
                b.className = 'rq-badge ' + cls;
                if (title) { b.title = title; }
                var i = document.createElement('i');
                i.className = 'fa-solid ' + icon;
                b.appendChild(i);
                b.appendChild(document.createTextNode(' ' + text));
                box.appendChild(b);
            }
            if (f && f.t === 'updated') { badge('rq-badge-updated', 'fa-arrows-rotate', 'Updated', 'Was: ' + (STATUS_NAME[f.from] || f.from)); }
            if (f && f.t === 'new') { badge('rq-badge-new', 'fa-circle-plus', 'New'); }
            if (unread) { badge('rq-badge-unread', 'fa-envelope-open-text', 'Results not opened yet'); }

            var note = readJson(NS + 'note_' + id, '');
            card.querySelector('.rq-note-ind').classList.toggle('rq-hidden', !note);
        }

        function refreshFlagCounts() {
            var p = 0, u = 0;
            allCards.forEach(function(c) {
                if (c.dataset.pinned === 'true') { p++; }
                if (c.dataset.flag || c.dataset.unread === 'true') { u++; }
            });
            var pe = document.querySelector('[data-flag-filter="pinned"] em');
            var ue = document.querySelector('[data-flag-filter="updated"] em');
            if (pe) { pe.textContent = p; }
            if (ue) { ue.textContent = u; }
        }

        function dismissFlag(card) {
            var id = card.dataset.id;
            if (flags[id]) { delete flags[id]; saveAll(); paintCard(card); refreshFlagCounts(); }
        }

        // since-last-visit strip
        var sinceEl = document.getElementById('rqSince');
        function showSince() {
            var ids = Object.keys(flags);
            var upd = ids.filter(function(i) { return flags[i].t === 'updated'; }).length;
            var nw = ids.filter(function(i) { return flags[i].t === 'new'; }).length;
            if (!sinceEl || (upd + nw) === 0) { return; }
            var parts = [];
            if (upd) { parts.push(upd + ' request' + (upd === 1 ? '' : 's') + ' moved to a new stage'); }
            if (nw) { parts.push(nw + ' new request' + (nw === 1 ? '' : 's') + ' added'); }
            document.getElementById('rqSinceTitle').textContent = 'Since your last visit';
            document.getElementById('rqSinceText').textContent = parts.join(' and ') + '.';
            sinceEl.classList.remove('rq-hidden');
        }

        // private notes
        document.querySelectorAll('textarea[data-note]').forEach(function(ta) {
            var id = ta.getAttribute('data-note');
            ta.value = readJson(NS + 'note_' + id, '');
            var t;
            ta.addEventListener('input', function() {
                clearTimeout(t);
                t = setTimeout(function() {
                    store(NS + 'note_' + id, JSON.stringify(ta.value));
                    var card = ta.closest('.rq-card');
                    card.querySelector('.rq-note-ind').classList.toggle('rq-hidden', !ta.value.trim());
                }, 300);
            });
        });

        function togglePin(card) {
            var id = card.dataset.id;
            var ix = pins.indexOf(id);
            if (ix === -1) { pins.push(id); toast('Pinned #' + id); } else { pins.splice(ix, 1); toast('Unpinned #' + id); }
            saveAll();
            paintCard(card);
            refreshFlagCounts();
            if (typeof render === 'function' && (state.flag === 'pinned' || sortSelect.value === 'pinned')) {
                if (sortSelect.value === 'pinned') { applySort(); }
                render();
            }
        }
        document.querySelectorAll('.rq-pin-btn').forEach(function(b) {
            b.addEventListener('click', function(e) { e.stopPropagation(); togglePin(b.closest('.rq-card')); });
        });

        // ---------------------------------------------
        // Details drawer
        // ---------------------------------------------
        function setOpen(card, open) {
            card.classList.toggle('rq-open', open);
            var btn = card.querySelector('.rq-details-btn');
            btn.setAttribute('aria-expanded', open ? 'true' : 'false');
            btn.querySelector('.rq-details-label').textContent = open ? 'Hide details' : 'Details';
            if (open) { dismissFlag(card); }
        }
        document.querySelectorAll('.rq-details-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var card = btn.closest('.rq-card');
                setOpen(card, !card.classList.contains('rq-open'));
            });
        });

        // Released card opens its results (links, buttons and the drawer keep their own behaviour)
        document.querySelectorAll('.rq-card[data-href]').forEach(function(card) {
            if (!card.dataset.href) { return; }
            card.addEventListener('click', function(e) {
                if (e.target.closest('a, button, .rq-drawer, textarea, label')) { return; }
                markSeen(card.dataset.id);
                window.location.href = card.dataset.href;
            });
        });
        document.querySelectorAll('.rq-view, .rq-tool-go').forEach(function(a) {
            a.addEventListener('click', function() { markSeen(a.closest('.rq-card').dataset.id); });
        });

        // ---------------------------------------------
        // Drawer tools: print slip, copy summary, calendar reminder
        // ---------------------------------------------
        function summaryOf(card) {
            var tests = (card.dataset.tests || '').split('|').filter(Boolean).join(', ') || 'None listed';
            var lines = [
                'Test request #' + card.dataset.id,
                'Doctor: Dr. ' + card.dataset.doctor,
                'Requested: ' + card.dataset.reqLabel,
                'Status: ' + card.dataset.statusLabel,
                'Priority: ' + card.dataset.urgency,
                'Tests: ' + tests
            ];
            if (card.dataset.expected) { lines.push('Expected around: ' + card.dataset.expected); }
            return lines.join('\n');
        }

        function icsDate(iso) { return iso.replace(/-/g, ''); }
        function addDays(iso, n) {
            var p = iso.split('-');
            var d = new Date(Number(p[0]), Number(p[1]) - 1, Number(p[2]) + n);
            return d.getFullYear() + '-' + pad(d.getMonth() + 1, 2) + '-' + pad(d.getDate(), 2);
        }
        function todayIso() {
            var d = new Date();
            return d.getFullYear() + '-' + pad(d.getMonth() + 1, 2) + '-' + pad(d.getDate(), 2);
        }
        function downloadFile(name, mime, text) {
            var blob = new Blob([text], { type: mime });
            var url = URL.createObjectURL(blob);
            var a = document.createElement('a');
            a.href = url;
            a.download = name;
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);
            URL.revokeObjectURL(url);
        }

        function remind(card) {
            var day = card.dataset.expected && card.dataset.expected >= todayIso() ? card.dataset.expected : addDays(todayIso(), 1);
            var tests = (card.dataset.tests || '').split('|').filter(Boolean).join(', ');
            var ics = [
                'BEGIN:VCALENDAR',
                'VERSION:2.0',
                'PRODID:-//LabDash//Patient Portal//EN',
                'BEGIN:VEVENT',
                'UID:rq-' + card.dataset.id + '-' + Date.now() + '@@labdash',
                'DTSTAMP:' + new Date().toISOString().replace(/[-:]/g, '').split('.')[0] + 'Z',
                'DTSTART;VALUE=DATE:' + icsDate(day),
                'DTEND;VALUE=DATE:' + icsDate(addDays(day, 1)),
                'SUMMARY:Check lab request #' + card.dataset.id,
                'DESCRIPTION:Check the status of your test request' + (tests ? ' (' + tests + ')' : '') + ' in the patient portal.',
                'END:VEVENT',
                'END:VCALENDAR'
            ].join('\r\n');
            downloadFile('lab-request-' + card.dataset.id + '.ics', 'text/calendar;charset=utf-8;', ics);
            toast('Reminder saved for ' + day);
        }

        function printCard(card) {
            setOpen(card, true);
            card.classList.add('rq-print-target');
            document.body.classList.add('rq-print-one');
            setTimeout(function() { window.print(); }, 80);
        }

        document.querySelectorAll('.rq-tool[data-act]').forEach(function(b) {
            b.addEventListener('click', function() {
                var card = b.closest('.rq-card');
                var act = b.getAttribute('data-act');
                if (act === 'print') { printCard(card); }
                else if (act === 'summary') { copyText(summaryOf(card), function() { toast('Summary copied'); }); }
                else if (act === 'remind') { remind(card); }
            });
        });

        // ---------------------------------------------
        // Dialogs: cancel + shortcuts
        // ---------------------------------------------
        var modal = document.getElementById('rqModal');
        var cancelForm = document.getElementById('rqCancelForm');
        var reasonText = document.getElementById('rqReasonText');
        var reasonChips = document.querySelectorAll('.rq-reason');
        var helpModal = document.getElementById('rqHelp');
        var lastFocus = null;

        function openModal(id) {
            lastFocus = document.activeElement;
            document.getElementById('rqCancelId').value = id;
            document.getElementById('rqModalRef').textContent = '#' + id;
            reasonText.value = '';
            reasonChips.forEach(function(c) { c.classList.remove('active'); });
            modal.classList.add('rq-show');
            modal.setAttribute('aria-hidden', 'false');
            if (reasonChips[0]) { reasonChips[0].focus(); }
        }
        function closeModal() {
            modal.classList.remove('rq-show');
            modal.setAttribute('aria-hidden', 'true');
            if (lastFocus && lastFocus.focus) { lastFocus.focus(); }
        }
        function openHelp() { lastFocus = document.activeElement; helpModal.classList.add('rq-show'); helpModal.setAttribute('aria-hidden', 'false'); document.getElementById('rqHelpClose').focus(); }
        function closeHelp() { helpModal.classList.remove('rq-show'); helpModal.setAttribute('aria-hidden', 'true'); if (lastFocus && lastFocus.focus) { lastFocus.focus(); } }

        if (modal) {
            document.querySelectorAll('.rq-cancel-btn').forEach(function(btn) {
                btn.addEventListener('click', function() { openModal(btn.getAttribute('data-cancel-id')); });
            });
            reasonChips.forEach(function(chip) {
                chip.addEventListener('click', function() {
                    var was = chip.classList.contains('active');
                    reasonChips.forEach(function(c) { c.classList.remove('active'); });
                    if (!was) { chip.classList.add('active'); }
                });
            });
            document.getElementById('rqModalKeep').addEventListener('click', closeModal);
            modal.addEventListener('click', function(e) { if (e.target === modal) { closeModal(); } });
            cancelForm.addEventListener('submit', function() {
                var chosen = document.querySelector('.rq-reason.active');
                var parts = [];
                if (chosen) { parts.push(chosen.getAttribute('data-reason')); }
                if (reasonText.value.trim()) { parts.push(reasonText.value.trim()); }
                document.getElementById('rqCancelReason').value = parts.join(': ');
            });
        }
        if (helpModal) {
            document.getElementById('rqHelpClose').addEventListener('click', closeHelp);
            helpModal.addEventListener('click', function(e) { if (e.target === helpModal) { closeHelp(); } });
        }
        var helpBtn = document.getElementById('rqHelpBtn');
        if (helpBtn) { helpBtn.addEventListener('click', openHelp); }

        // ---------------------------------------------
        // Scroll features (work with window scroll or a scrolling layout container)
        // ---------------------------------------------
        var progressBar = document.querySelector('#rqProgress span');
        var dock = document.getElementById('rqDock');

        function onScroll() {
            var r = wrap.getBoundingClientRect();
            var scrollable = r.height - window.innerHeight;
            var p = scrollable > 0 ? Math.min(Math.max(-r.top / scrollable, 0), 1) : 0;
            if (progressBar) { progressBar.style.transform = 'scaleX(' + p + ')'; }
            if (dock) { dock.classList.toggle('rq-show', r.top < -260); }
        }
        var ticking = false;
        document.addEventListener('scroll', function() {
            if (ticking) { return; }
            ticking = true;
            requestAnimationFrame(function() { onScroll(); ticking = false; });
        }, true);
        window.addEventListener('resize', onScroll);
        onScroll();

        var topBtn = document.getElementById('rqTop');
        if (topBtn) {
            topBtn.addEventListener('click', function() {
                wrap.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            });
        }

        // Insights fill in when scrolled into view
        document.querySelectorAll('.rq-reveal').forEach(function(sec) {
            function reveal() {
                sec.classList.add('rq-in');
                sec.querySelectorAll('[data-countup]').forEach(function(el) {
                    var v = parseFloat(el.dataset.value) || 0;
                    var dec = parseInt(el.dataset.dec, 10) || 0;
                    if (!reduce) { countUp(el, v, 1, dec, 900); }
                });
            }
            if ('IntersectionObserver' in window) {
                var rio = new IntersectionObserver(function(es) {
                    if (es[0].isIntersecting) { reveal(); rio.disconnect(); }
                }, { threshold: 0.25 });
                rio.observe(sec);
            } else { reveal(); }
        });

        // ---------------------------------------------
        // Filters, search, sort, range, views, paging
        // ---------------------------------------------
        var list = document.getElementById('rqList');
        if (!list) { return; }

        var PAGE = 6;
        var state = { search: '', status: 'all', urgentOnly: false, range: 'all', flag: '', doctor: '', test: '', limit: PAGE };

        var searchInput = document.getElementById('rqSearchInput');
        var searchBox = searchInput.closest('.rq-search');
        var sortSelect = document.getElementById('rqSortSelect');
        var rangeSelect = document.getElementById('rqRange');
        var doctorSel = document.getElementById('rqDoctorSel');
        var testSel = document.getElementById('rqTestSel');
        var statusChips = document.querySelectorAll('[data-status-filter]');
        var flagChips = document.querySelectorAll('[data-flag-filter]');
        var ticks = document.querySelectorAll('[data-tick-filter]');
        var urgentChip = document.querySelector('[data-urgent-filter]');
        var noMatches = document.getElementById('rqNoMatches');
        var moreBtn = document.getElementById('rqMore');
        var endEl = document.getElementById('rqEnd');
        var countEl = document.getElementById('rqCount');
        var resetInline = document.getElementById('rqResetInline');
        var sentinel = document.getElementById('rqSentinel');
        var sticky = document.getElementById('rqSticky');
        var chipsToggle = document.getElementById('rqChipsToggle');
        var io = null;

        function matches(card) {
            var haystack = ((card.dataset.doctor || '') + ' ' + (card.dataset.tests || '') + ' ' + (card.dataset.id || '')).toLowerCase();
            if (state.search && haystack.indexOf(state.search) === -1) { return false; }
            var st = card.dataset.status;
            if (state.status === 'open') { if (st === 'released' || st === 'cancelled') { return false; } }
            else if (state.status !== 'all' && st !== state.status) { return false; }
            if (state.urgentOnly && card.dataset.urgent !== 'true') { return false; }
            if (state.range !== 'all' && Number(card.dataset.days) > Number(state.range)) { return false; }
            if (state.flag === 'pinned' && card.dataset.pinned !== 'true') { return false; }
            if (state.flag === 'updated' && !(card.dataset.flag || card.dataset.unread === 'true')) { return false; }
            if (state.doctor && card.dataset.doctor !== state.doctor) { return false; }
            if (state.test && ('|' + (card.dataset.tests || '') + '|').indexOf('|' + state.test + '|') === -1) { return false; }
            return true;
        }

        function isFiltered() {
            return state.search !== '' || state.status !== 'all' || state.urgentOnly || state.range !== 'all' || state.flag !== '' || state.doctor !== '' || state.test !== '';
        }

        // highlight the search term inside doctor names and test chips
        function hl(el, term) {
            var t = el.getAttribute('data-orig');
            if (t === null) { t = el.textContent; el.setAttribute('data-orig', t); }
            var i = term ? t.toLowerCase().indexOf(term) : -1;
            if (i < 0) { if (el.childElementCount || el.textContent !== t) { el.textContent = t; } return; }
            el.textContent = '';
            el.appendChild(document.createTextNode(t.slice(0, i)));
            var m = document.createElement('mark');
            m.textContent = t.slice(i, i + term.length);
            el.appendChild(m);
            el.appendChild(document.createTextNode(t.slice(i + term.length)));
        }

        function buildMonthHeaders(cards) {
            list.querySelectorAll('.rq-month').forEach(function(h) { h.remove(); });
            if (sortSelect.value === 'urgent' || sortSelect.value === 'pinned') { return; }

            var counts = {};
            cards.forEach(function(c) {
                if (c.dataset.match === 'true') { counts[c.dataset.monthLabel] = (counts[c.dataset.monthLabel] || 0) + 1; }
            });

            var last = null;
            cards.forEach(function(c) {
                if (c.classList.contains('rq-hidden')) { return; }
                var m = c.dataset.monthLabel;
                if (m === last) { return; }
                last = m;
                var h = document.createElement('div');
                h.className = 'rq-month';
                var a = document.createElement('span');
                var b = document.createElement('em');
                a.textContent = m;
                b.textContent = counts[m] + ' request' + (counts[m] === 1 ? '' : 's');
                h.appendChild(a);
                h.appendChild(b);
                list.insertBefore(h, c);
            });
        }

        function render() {
            var cards = Array.prototype.slice.call(list.querySelectorAll('.rq-card'));
            var matched = 0, shown = 0;

            cards.forEach(function(card) {
                var ok = matches(card);
                card.dataset.match = ok ? 'true' : 'false';
                if (!ok) { card.classList.add('rq-hidden'); return; }
                matched++;
                var visible = shown < state.limit;
                card.classList.toggle('rq-hidden', !visible);
                if (visible) {
                    shown++;
                    card.querySelectorAll('.rq-hl, .rq-test-chip').forEach(function(el) { hl(el, state.search); });
                }
            });

            buildMonthHeaders(cards);

            noMatches.style.display = matched === 0 ? 'flex' : 'none';
            countEl.textContent = matched === 0 ? '' : ('Showing ' + shown + ' of ' + matched + ' request' + (matched === 1 ? '' : 's'));
            resetInline.classList.toggle('rq-hidden', !isFiltered());
            if (chipsToggle) { chipsToggle.classList.toggle('rq-has-filter', isFiltered()); }

            var remaining = matched - shown;
            moreBtn.classList.toggle('rq-hidden', remaining <= 0);
            moreBtn.textContent = 'Show ' + Math.min(remaining, PAGE) + ' more (' + remaining + ' left)';

            var allShown = matched > 0 && remaining <= 0 && matched > PAGE;
            endEl.classList.toggle('rq-hidden', !allShown);
            endEl.textContent = 'You have reached the end (' + matched + ' requests)';

            // Re-check the scroll sentinel so the next page loads if it is still in view
            if (io && remaining > 0) { io.unobserve(sentinel); io.observe(sentinel); }
        }

        function setStatus(val) {
            state.status = val;
            state.limit = PAGE;
            statusChips.forEach(function(c) { c.classList.toggle('active', c.getAttribute('data-status-filter') === val); });
            ticks.forEach(function(t) { t.classList.toggle('active', t.getAttribute('data-tick-filter') === val); });
            render();
        }

        function setFlag(val) {
            state.flag = state.flag === val ? '' : val;
            state.limit = PAGE;
            flagChips.forEach(function(c) {
                var on = c.getAttribute('data-flag-filter') === state.flag;
                c.classList.toggle('active', on);
                c.setAttribute('aria-pressed', on ? 'true' : 'false');
            });
            render();
        }

        function resetAll() {
            state = { search: '', status: 'all', urgentOnly: false, range: 'all', flag: '', doctor: '', test: '', limit: PAGE };
            searchInput.value = '';
            searchBox.classList.remove('has-text');
            rangeSelect.value = 'all';
            if (doctorSel) { doctorSel.value = ''; }
            if (testSel) { testSel.value = ''; }
            urgentChip.classList.remove('active');
            urgentChip.setAttribute('aria-pressed', 'false');
            flagChips.forEach(function(c) { c.classList.remove('active'); c.setAttribute('aria-pressed', 'false'); });
            setStatus('all');
        }

        // Infinite scroll: load the next page as the end of the list nears the screen
        if ('IntersectionObserver' in window) {
            io = new IntersectionObserver(function(es) {
                if (es[0].isIntersecting && !moreBtn.classList.contains('rq-hidden')) {
                    state.limit += PAGE;
                    render();
                }
            }, { rootMargin: '0px 0px 320px 0px' });
            io.observe(sentinel);
        }

        // Toolbar: detect when it is stuck, then fold the status chips into a toggle
        if (sticky && 'IntersectionObserver' in window) {
            var sentTop = document.getElementById('rqTopSentinel');
            var sio = new IntersectionObserver(function(es) {
                var e = es[0];
                var stuck = !e.isIntersecting && e.boundingClientRect.top < topOffset + 1;
                sticky.classList.toggle('rq-stuck', stuck);
                if (!stuck) { sticky.classList.remove('rq-chips-open'); if (chipsToggle) { chipsToggle.setAttribute('aria-expanded', 'false'); } }
            }, { rootMargin: '-' + (topOffset + 1) + 'px 0px 0px 0px', threshold: 0 });
            sio.observe(sentTop);
        }
        if (chipsToggle) {
            chipsToggle.addEventListener('click', function() {
                var open = sticky.classList.toggle('rq-chips-open');
                chipsToggle.setAttribute('aria-expanded', open ? 'true' : 'false');
            });
        }

        searchInput.addEventListener('input', function() {
            state.search = searchInput.value.trim().toLowerCase();
            state.limit = PAGE;
            searchBox.classList.toggle('has-text', searchInput.value.length > 0);
            render();
        });
        searchInput.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') { searchInput.value = ''; searchInput.dispatchEvent(new Event('input')); searchInput.blur(); }
        });
        document.getElementById('rqSearchClear').addEventListener('click', function() {
            searchInput.value = '';
            searchInput.dispatchEvent(new Event('input'));
            searchInput.focus();
        });

        statusChips.forEach(function(chip) { chip.addEventListener('click', function() { setStatus(chip.getAttribute('data-status-filter')); }); });
        ticks.forEach(function(t) { t.addEventListener('click', function() { setStatus(t.getAttribute('data-tick-filter')); }); });
        flagChips.forEach(function(c) { c.addEventListener('click', function() { setFlag(c.getAttribute('data-flag-filter')); }); });

        document.querySelectorAll('[data-spot-filter]').forEach(function(b) {
            b.addEventListener('click', function() {
                setStatus(b.getAttribute('data-spot-filter'));
                list.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
            });
        });

        urgentChip.addEventListener('click', function() {
            state.urgentOnly = !state.urgentOnly;
            state.limit = PAGE;
            urgentChip.classList.toggle('active', state.urgentOnly);
            urgentChip.setAttribute('aria-pressed', state.urgentOnly ? 'true' : 'false');
            render();
        });

        rangeSelect.addEventListener('change', function() { state.range = rangeSelect.value; state.limit = PAGE; render(); });
        if (doctorSel) { doctorSel.addEventListener('change', function() { state.doctor = doctorSel.value; state.limit = PAGE; render(); }); }
        if (testSel) { testSel.addEventListener('change', function() { state.test = testSel.value; state.limit = PAGE; render(); }); }

        document.getElementById('rqClearFilters').addEventListener('click', resetAll);
        resetInline.addEventListener('click', resetAll);
        moreBtn.addEventListener('click', function() { state.limit += PAGE; render(); });

        function applySort() {
            var value = sortSelect.value;
            var cards = Array.prototype.slice.call(list.querySelectorAll('.rq-card'));
            cards.sort(function(a, b) {
                if (value === 'urgent') {
                    var au = a.dataset.urgent === 'true', bu = b.dataset.urgent === 'true';
                    if (au !== bu) { return au ? -1 : 1; }
                    return b.dataset.date.localeCompare(a.dataset.date);
                }
                if (value === 'pinned') {
                    var ap = a.dataset.pinned === 'true', bp = b.dataset.pinned === 'true';
                    if (ap !== bp) { return ap ? -1 : 1; }
                    return b.dataset.date.localeCompare(a.dataset.date);
                }
                if (value === 'oldest') { return a.dataset.date.localeCompare(b.dataset.date); }
                return b.dataset.date.localeCompare(a.dataset.date);
            });
            cards.forEach(function(c) { list.appendChild(c); });
        }
        sortSelect.addEventListener('change', function() {
            store('rqSort', sortSelect.value);
            applySort();
            render();
        });

        // Compact + two-column views (remembered)
        var densityBtn = document.getElementById('rqDensity');
        var gridBtn = document.getElementById('rqGrid');
        function setDensity(compact) {
            list.classList.toggle('rq-compact', compact);
            densityBtn.setAttribute('aria-pressed', compact ? 'true' : 'false');
            densityBtn.firstElementChild.className = compact ? 'fa-solid fa-table-list' : 'fa-solid fa-bars';
        }
        function setGrid(on) {
            list.classList.toggle('rq-grid', on);
            gridBtn.setAttribute('aria-pressed', on ? 'true' : 'false');
        }
        function toggleDensity() {
            var compact = !list.classList.contains('rq-compact');
            setDensity(compact);
            store('rqCompact', compact ? '1' : '0');
            toast(compact ? 'Compact view' : 'Full view');
        }
        function toggleGrid() {
            var on = !list.classList.contains('rq-grid');
            setGrid(on);
            store('rqGridView', on ? '1' : '0');
            toast(on ? 'Two column view' : 'Single column view');
        }
        setDensity(read('rqCompact') === '1');
        setGrid(read('rqGridView') === '1');
        densityBtn.addEventListener('click', toggleDensity);
        gridBtn.addEventListener('click', toggleGrid);

        // Print the whole (filtered) list
        document.getElementById('rqPrintBtn').addEventListener('click', function() {
            var hidden = list.querySelectorAll('.rq-card[data-match="true"].rq-hidden');
            hidden.forEach(function(c) { c.classList.remove('rq-hidden'); c.dataset.printTemp = '1'; });
            window.addEventListener('afterprint', function() {
                list.querySelectorAll('[data-print-temp]').forEach(function(c) { c.classList.add('rq-hidden'); c.removeAttribute('data-print-temp'); });
            }, { once: true });
            setTimeout(function() { window.print(); }, 60);
        });

        // ---------------------------------------------
        // Dock: jump to next ready result, expand/collapse every ticket
        // ---------------------------------------------
        var readyIdx = -1;
        var nextBtn = document.getElementById('rqNextReady');
        if (nextBtn) {
            nextBtn.addEventListener('click', function() {
                function visibleReady() {
                    return Array.prototype.slice.call(list.querySelectorAll('.rq-card[data-status="released"]:not(.rq-hidden)'));
                }
                var vis = visibleReady();
                if (!vis.length) { resetAll(); setStatus('released'); vis = visibleReady(); }
                if (!vis.length) { return; }
                readyIdx = (readyIdx + 1) % vis.length;
                var c = vis[readyIdx];
                c.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
                c.classList.remove('rq-flash');
                void c.offsetWidth;
                c.classList.add('rq-flash');
                setTimeout(function() { c.classList.remove('rq-flash'); }, 1600);
                toast('Result ' + (readyIdx + 1) + ' of ' + vis.length);
            });
        }

        var expandBtn = document.getElementById('rqExpandAll');
        var allOpen = false;
        if (expandBtn) {
            expandBtn.addEventListener('click', function() {
                allOpen = !allOpen;
                list.querySelectorAll('.rq-card:not(.rq-hidden)').forEach(function(c) { setOpen(c, allOpen); });
                expandBtn.querySelector('span').textContent = allOpen ? 'Collapse all' : 'Expand all';
                expandBtn.querySelector('i').className = allOpen ? 'fa-solid fa-angles-up' : 'fa-solid fa-angles-down';
            });
        }

        // CSV export (every request that matches the filters, not just the visible page)
        document.getElementById('rqExportBtn').addEventListener('click', function() {
            var rows = [['Request ID', 'Doctor', 'Date', 'Status', 'Urgent', 'Tests']];
            list.querySelectorAll('.rq-card').forEach(function(card) {
                if (card.dataset.match === 'false') { return; }
                rows.push([
                    card.dataset.id || '',
                    card.dataset.doctor || '',
                    card.dataset.date || '',
                    card.dataset.statusLabel || '',
                    card.dataset.urgent === 'true' ? 'Yes' : 'No',
                    (card.dataset.tests || '').split('|').join('; ')
                ]);
            });

            var csv = rows.map(function(row) {
                return row.map(function(field) { return '"' + String(field).replace(/"/g, '""') + '"'; }).join(',');
            }).join('\n');

            downloadFile('test-requests.csv', 'text/csv;charset=utf-8;', csv);
            toast('Exported ' + (rows.length - 1) + ' request' + (rows.length === 2 ? '' : 's'));
        });

        // ---------------------------------------------
        // Keyboard shortcuts
        // ---------------------------------------------
        var kIdx = -1;
        function visibleCards() { return Array.prototype.slice.call(list.querySelectorAll('.rq-card:not(.rq-hidden)')); }
        function focusCard(i) {
            var vis = visibleCards();
            if (!vis.length) { return; }
            kIdx = Math.max(0, Math.min(vis.length - 1, i));
            list.querySelectorAll('.rq-kfocus').forEach(function(c) { c.classList.remove('rq-kfocus'); });
            vis[kIdx].classList.add('rq-kfocus');
            vis[kIdx].scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'center' });
        }
        function focused() { return list.querySelector('.rq-kfocus'); }

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                if (modal && modal.classList.contains('rq-show')) { closeModal(); return; }
                if (helpModal && helpModal.classList.contains('rq-show')) { closeHelp(); return; }
                var kf = focused(); if (kf) { kf.classList.remove('rq-kfocus'); }
                return;
            }
            if (e.ctrlKey || e.metaKey || e.altKey) { return; }
            var tag = (document.activeElement && document.activeElement.tagName) || '';
            if (tag === 'INPUT' || tag === 'TEXTAREA' || tag === 'SELECT') { return; }
            if ((modal && modal.classList.contains('rq-show')) || (helpModal && helpModal.classList.contains('rq-show'))) { return; }

            var k = e.key;
            if (k === '/') { e.preventDefault(); searchInput.focus(); }
            else if (k === '?') { e.preventDefault(); openHelp(); }
            else if (k === 'j' || k === 'J') { focusCard(kIdx + 1); }
            else if (k === 'k' || k === 'K') { focusCard(kIdx - 1); }
            else if (k === 't' || k === 'T') { toggleTheme(); }
            else if (k === 'g' || k === 'G') { if (window.innerWidth > 760) { toggleGrid(); } }
            else if (k === 'c' || k === 'C') { toggleDensity(); }
            else {
                var f = focused();
                if (!f) { return; }
                if (k === 'e' || k === 'E') { setOpen(f, !f.classList.contains('rq-open')); }
                else if (k === 'p' || k === 'P') { togglePin(f); }
                else if (k === 'Enter' && tag !== 'BUTTON' && tag !== 'A') {
                    if (f.dataset.href) { markSeen(f.dataset.id); window.location.href = f.dataset.href; }
                    else { setOpen(f, !f.classList.contains('rq-open')); }
                }
            }
        });

        // ---------------------------------------------
        // First paint of the new features
        // ---------------------------------------------
        allCards.forEach(paintCard);
        refreshFlagCounts();
        showSince();

        document.getElementById('rqSinceDismiss').addEventListener('click', function() { sinceEl.classList.add('rq-hidden'); });
        document.getElementById('rqSinceShow').addEventListener('click', function() {
            sinceEl.classList.add('rq-hidden');
            resetAll();
            setFlag('updated');
            list.scrollIntoView({ behavior: reduce ? 'auto' : 'smooth', block: 'start' });
        });

        var savedSort = read('rqSort');
        if (savedSort && sortSelect.querySelector('option[value="' + savedSort + '"]')) { sortSelect.value = savedSort; applySort(); }

        render();
    })();
</script>
