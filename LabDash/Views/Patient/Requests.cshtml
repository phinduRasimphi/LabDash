    .rq-toast {
        position: fixed;
        left: 50%;
        bottom: 28px;
        transform: translate(-50%, 20px);
        opacity: 0;
        pointer-events: none;
        z-index: 1100;
        background: #172019;
        color: #F5F7F6;
        border: 1px solid #34403A;
        border-radius: 999px;
        padding: 10px 18px;
        font-size: 13px;
        font-weight: 600;
        box-shadow: 0 10px 30px rgba(0,0,0,.3);
        transition: opacity .2s ease, transform .2s ease;
    }

        .rq-toast.rq-show {
            opacity: 1;
            transform: translate(-50%, 0);
        }

    /* ============ FOOTER ============ */
    .rq-footer {
        margin-top: 36px;
        text-align: center;
    }

        .rq-footer hr {
            border: none;
            border-top: 1px solid var(--rq-line);
            margin-bottom: 20px;
        }

    .rq-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--rq-ink-faint);
