        .rq-btn-danger:hover {
            filter: brightness(1.1);
        }

    .rq-keys {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .rq-keys li {
            display: flex;
            align-items: center;
            gap: 6px;
            padding: 7px 0;
            border-bottom: 1px dashed var(--rq-line-strong);
            font-size: 13px;
        }

            .rq-keys li:last-child {
                border-bottom: none;
            }

            .rq-keys li span {
                margin-left: auto;
                color: var(--rq-ink-soft);
            }

        .rq-keys kbd {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11px;
            font-weight: 600;
