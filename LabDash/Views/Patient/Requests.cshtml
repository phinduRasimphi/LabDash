        font-size: 13.5px;
        color: var(--rq-ink-soft);
        line-height: 1.6;
    }

    /* ============ FOOTER ============ */
    .rq-footer {
        margin-top: 36px;
        text-align: center;
    }

        .rq-footer hr {
            border: none;
            border-top: 1px solid var(--rq-line);
            margin-bottom: 20px;
        }

    .rq-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--rq-ink-faint);
        font-size: 12.5px;
        font-family: 'IBM Plex Mono', monospace;
    }

        .rq-footer-content i {
            color: var(--rq-teal);
        }

    .rq-footer-divider {
        color: var(--rq-line-strong);
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 700px) {
        .rq-ticker {
            grid-template-columns: repeat(2, 1fr);
        }

        .rq-console {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

        .rq-console-right {
