    @@keyframes rqPop {
        from {
            opacity: 0;
            transform: translateY(10px) scale(.97);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    .rq-modal-card h3 {
        margin: 0 0 6px;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 18px;
    }

        .rq-modal-card h3 span {
            color: var(--rq-ink-faint);
            font-family: 'IBM Plex Mono', monospace;
            font-size: 15px;
        }

    .rq-modal-sub {
        margin: 0 0 16px;
        font-size: 13px;
        color: var(--rq-ink-soft);
        line-height: 1.5;
    }

    .rq-reasons {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 14px;
    }

    .rq-reason {
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
    }

        .rq-reason:hover {
            border-color: var(--rq-teal);
        }

        .rq-reason.active {
            background: var(--rq-ink);
            border-color: var(--rq-ink);
            color: var(--rq-raised);
        }

    .rq-modal-label {
        display: block;
        font-size: 12px;
        font-weight: 600;
        margin-bottom: 6px;
        color: var(--rq-ink-soft);
    }

    .rq-modal-card textarea {
        width: 100%;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink);
        border-radius: 10px;
        padding: 9px 12px;
        font-size: 13px;
        resize: vertical;
    }

    .rq-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 18px;
    }

    .rq-btn-ghost, .rq-btn-danger {
        border-radius: 999px;
        padding: 9px 18px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

    .rq-btn-ghost {
        border: 1px solid var(--rq-line-strong);
        background: transparent;
        color: var(--rq-ink);
    }

    .rq-btn-danger {
        border: none;
        background: var(--rq-red);
