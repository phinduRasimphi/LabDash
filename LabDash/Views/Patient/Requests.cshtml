    @@media (max-width: 560px) {
        .rq-wrap {
            padding: 20px 14px 50px;
        }

        .rq-stub {
            width: 60px;
        }

        .rq-stub-id {
            font-size: 10px;
        }

        .rq-step-label {
            display: none;
        }

        .rq-console-ring {
            width: 56px;
            height: 56px;
        }

        .rq-ring-inner {
            width: 42px;
            height: 42px;
        }

            .rq-ring-inner span {
                font-size: 11px;
            }

        .rq-search kbd {
            display: none;
        }

        .rq-dock {
            right: 14px;
            bottom: 16px;
        }

        .rq-dock-btn:not(.rq-dock-icon) span {
