@model List<LabDash.Models.TestRequestViewModel>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Test Requests";
    ViewData["ActivePage"] = "Requests";

    // The 5 stages a request moves through (cancelled sits outside the flow)
    var stages = new[] { "Submitted", "Sample received", "In progress", "Completed", "Released" };

    // Works whatever exact text is stored in the DB ("Samples Received", "Released by doctor", ...)
    string StatusKey(string? raw)
    {
        var s = (raw ?? "").Trim().ToLowerInvariant();
        if (s.Contains("cancel")) return "cancelled";
        if (s.Contains("release")) return "released";
        if (s.Contains("complete")) return "completed";
        if (s.Contains("progress") || s.Contains("process")) return "inprogress";
        if (s.Contains("sample") || s.Contains("received") || s.Contains("collect")) return "received";
        return "submitted";
    }

    var stageOf = new Dictionary<string, int>
    {
        ["submitted"] = 0,
        ["received"] = 1,
        ["inprogress"] = 2,
        ["completed"] = 3,
        ["released"] = 4
    };

    var labelOf = new Dictionary<string, string>
    {
        ["submitted"] = "Submitted",
        ["received"] = "Sample received",
        ["inprogress"] = "In progress",
        ["completed"] = "Completed",
        ["released"] = "Results ready",
        ["cancelled"] = "Cancelled"
    };

    var noteOf = new Dictionary<string, string>
    {
        ["submitted"] = "Your request has been sent to the lab. We are waiting for your sample to arrive.",
        ["received"] = "The lab has received your sample. Testing will start soon.",
        ["inprogress"] = "Your sample is being tested.",
        ["completed"] = "Testing is finished. Your doctor is reviewing the results before releasing them to you.",
        ["released"] = "Your results are ready. Open this request to view them."
    };

    var iconOf = new Dictionary<string, string>
    {
        ["submitted"] = "fa-paper-plane",
        ["received"] = "fa-vial",
        ["inprogress"] = "fa-flask",
        ["completed"] = "fa-user-doctor",
        ["released"] = "fa-circle-check"
    };

    bool IsUrgentOpen(LabDash.Models.TestRequestViewModel x)
    {
        var k = StatusKey(x.Status);
        if (k == "cancelled" || k == "released") return false;
        var u = (x.Urgency ?? "").ToLowerInvariant();
        return u == "high" || u == "urgent";
    }

    // PREVIEW MODE (development only): open /Patient/Requests?preview=1 to see one sample card per status
    List<LabDash.Models.TestRequestViewModel> SampleRequests()
    {
        var now = DateTime.Now;
        LabDash.Models.TestRequestViewModel M(int id, string status, string urgency, int daysAgo, params string[] tests) =>
            new LabDash.Models.TestRequestViewModel
            {
                RequestID = id.ToString(),
                RequestDate = now.AddDays(-daysAgo),
                DoctorName = "Kamogelo Makuwa",
                Tests = tests.ToList(),
                Urgency = urgency,
                Status = status
            };

        var list = new List<LabDash.Models.TestRequestViewModel>
        {
            M(9001, "Submitted", "Routine", 1, "Full Blood Count"),
            M(9002, "Samples Received", "Urgent", 2, "Glucose", "Cholesterol"),
            M(9003, "In progress", "Routine", 3, "Full Blood Count", "Glucose", "Cholesterol", "Ferritin"),
            M(9004, "Completed", "Routine", 4, "Full Blood Count"),
            M(9005, "Released by doctor", "Routine", 5, "Glucose"),
            M(9006, "Cancelled", "Routine", 6, "Cholesterol")
        };
        list[4].ReleaseDate = now.AddDays(-4);
        list[5].CancelReason = "Sample could not be collected";
        return list;
    }

    var preview = Env.EnvironmentName == "Development" && Context.Request.Query.ContainsKey("preview");
    var items = preview ? SampleRequests() : (Model ?? new List<LabDash.Models.TestRequestViewModel>());
    var total = items.Count;
    var released = items.Count(x => StatusKey(x.Status) == "released");
    var cancelled = items.Count(x => StatusKey(x.Status) == "cancelled");
    var open = total - released - cancelled;           // submitted + received + in progress + completed
    var urgentOpen = items.Count(IsUrgentOpen);
    var activeTotal = total - cancelled;
    var readyPercent = activeTotal > 0 ? Math.Round((double)released / activeTotal * 100) : 0;

    var presentKeys = new[] { "submitted", "received", "inprogress", "completed", "released", "cancelled" }
        .Where(k => items.Any(x => StatusKey(x.Status) == k))
        .ToList();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

<div class="rq-wrap">

    <!-- ==========================================
        CONSOLE HEADER
    =========================================== -->
    <div class="rq-console">
        <div class="rq-console-scan"></div>
        <div class="rq-console-left">
            <div class="rq-console-eyebrow">Patient Portal &middot; Specimen Tracking</div>
            <h1>My Test Requests</h1>
            <p>Every order, from draw to result. Open a request once its results are ready.</p>
        </div>

        <div class="rq-console-right">
            @if (activeTotal > 0)
            {
                <div class="rq-console-ring" style="--rq-pct: @readyPercent">
                    <div class="rq-ring-inner">
                        <span>@readyPercent.ToString("0")%</span>
                        <small>Ready</small>
                    </div>
                </div>
            }
            <div class="rq-console-readout">
                <span class="rq-readout-label">Total on file</span>
                <span class="rq-readout-num">@total.ToString("D3")</span>
            </div>
        </div>
    </div>

    @if (preview)
    {
        <div style="margin:0 0 16px;padding:10px 14px;border-radius:10px;background:#FBF0DC;color:#7A5410;font-size:12.5px;font-weight:600">
            Preview mode &mdash; sample data, one card per status. Remove <code>?preview=1</code> from the address to see your real requests.
        </div>
    }

    <!-- ==========================================
        SUMMARY TICKER (Ready + In progress + Cancelled = Total)
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-ticker">
            <div class="rq-tick">
                <span class="rq-tick-bar rq-bar-ink"></span>
                <span class="rq-tick-num">@total.ToString("D2")</span>
                <span class="rq-tick-label">Total requests</span>
            </div>
            <div class="rq-tick">
                <span class="rq-tick-bar rq-bar-green"></span>
                <span class="rq-tick-num">@released.ToString("D2")</span>
                <span class="rq-tick-label">Results ready</span>
            </div>
            <div class="rq-tick">
                <span class="rq-tick-bar rq-bar-amber"></span>
                <span class="rq-tick-num">@open.ToString("D2")</span>
                <span class="rq-tick-label">In progress</span>
            </div>
            <div class="rq-tick">
                <span class="rq-tick-bar rq-bar-red"></span>
                <span class="rq-tick-num">@cancelled.ToString("D2")</span>
                <span class="rq-tick-label">Cancelled</span>
            </div>
        </div>
    }

    <!-- ==========================================
        TOOLBAR — search, status filter, sort, export
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-toolbar">

            <div class="rq-search">
                <i class="fa-solid fa-magnifying-glass"></i>
                <input type="text" id="rqSearchInput" placeholder="Search by doctor or test..." aria-label="Search test requests">
            </div>

            <div class="rq-filter-chips" role="tablist" aria-label="Filter by status">
                <button type="button" class="rq-chip active" data-status-filter="all">All</button>
                @foreach (var k in presentKeys)
                {
                    <button type="button" class="rq-chip" data-status-filter="@k">@labelOf[k]</button>
                }
                <button type="button" class="rq-chip rq-chip-urgent" data-urgent-filter="true" title="Urgent requests that are still open">
                    <i class="fa-solid fa-bolt"></i> Urgent only (@urgentOpen)
                </button>
            </div>

            <div class="rq-toolbar-actions">
                <select id="rqSortSelect" class="rq-sort" aria-label="Sort requests">
                    <option value="newest">Newest first</option>
                    <option value="oldest">Oldest first</option>
                    <option value="urgent">Urgent first</option>
                </select>
                <button type="button" id="rqExportBtn" class="rq-export">
                    <i class="fa-solid fa-file-arrow-down"></i> Export CSV
                </button>
            </div>

        </div>
    }

    <!-- ==========================================
        REQUISITION TICKETS
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-list" id="rqList">
            @foreach (var r in items.OrderByDescending(x => x.RequestDate))
            {
                var key = StatusKey(r.Status);
                var isCancelled = key == "cancelled";
                var isReleased = key == "released";
                var stageIndex = stageOf.ContainsKey(key) ? stageOf[key] : 0;
                var isUrgent = IsUrgentOpen(r);
                var resultsUrl = isReleased
                    ? Url.Action("Results", "Patient", new { requestId = r.RequestID })
                    : null;

                var testsList = r.Tests ?? new List<string>();
                var visibleTestCount = 3;

                <div class="rq-card @(isCancelled ? "rq-card-cancelled" : "") @(isUrgent ? "rq-card-urgent" : "") @(isReleased ? "rq-card-clickable" : "")"
                     data-id="@r.RequestID"
                     data-doctor="@r.DoctorName"
                     data-date="@r.RequestDate.ToString("yyyy-MM-dd")"
                     data-status="@key"
                     data-status-label="@labelOf[key]"
                     data-urgent="@isUrgent.ToString().ToLower()"
                     data-tests="@string.Join("|", testsList)"
                     data-href="@resultsUrl">

                    @if (isUrgent)
                    {
                        <div class="rq-flag">Urgent</div>
                    }

                    <div class="rq-stub">
                        <div class="rq-barcode" aria-hidden="true"></div>
                        <div class="rq-stub-id">#@r.RequestID</div>
                        <button type="button" class="rq-copy-btn" data-copy="#@r.RequestID" title="Copy request ID" aria-label="Copy request ID">
                            <i class="fa-solid fa-copy"></i>
                        </button>
                    </div>

                    <div class="rq-perf"></div>

                    <div class="rq-body">
                        <div class="rq-row-top">
                            <div>
                                <div class="rq-doctor"><i class="fa-solid fa-user-doctor"></i> Dr. @r.DoctorName</div>
                                <div class="rq-date">Requested @r.RequestDate.ToString("dd MMM yyyy")</div>
                            </div>

                            @if (isReleased)
                            {
                                <a href="@resultsUrl" class="rq-view">
                                    View results <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            }
                            else
                            {
                                <div class="rq-actions">
                                    <span class="rq-pill rq-pill-@key">@labelOf[key]</span>

                                    @if (!preview && (key == "submitted" || key == "received"))
                                    {
                                        <form asp-action="CancelRequest" asp-controller="Patient" method="post" class="rq-cancel-form">
                                            <input type="hidden" name="requestId" value="@r.RequestID" />
                                            <input type="hidden" name="reason" value="" />
                                            <button type="button" class="rq-cancel-btn">
                                                <i class="fa-solid fa-xmark"></i> Cancel request
                                            </button>
                                        </form>
                                    }
                                </div>
                            }
                        </div>

                        <div class="rq-tests-wrap">
                            <div class="rq-tests-chips" id="tests-@r.RequestID">
                                @if (testsList.Count == 0)
                                {
                                    <span class="rq-test-chip">No tests listed</span>
                                }
                                @for (int t = 0; t < testsList.Count; t++)
                                {
                                    <span class="rq-test-chip @(t >= visibleTestCount ? "rq-test-extra" : "")">@testsList[t]</span>
                                }
                            </div>
                            @if (testsList.Count > visibleTestCount)
                            {
                                <button type="button" class="rq-tests-toggle" data-target="tests-@r.RequestID">
                                    <span class="rq-tests-toggle-label">+@(testsList.Count - visibleTestCount) more</span>
                                    <i class="fa-solid fa-chevron-down"></i>
                                </button>
                            }
                        </div>

                        @if (isCancelled)
                        {
                            <div class="rq-cancelled-rail">
                                <i class="fa-solid fa-circle-xmark"></i>
                                <span>
                                    Request cancelled &mdash; no further processing.
                                    @if (!string.IsNullOrWhiteSpace(r.CancelReason))
                                    {
                                        <text> Reason: @r.CancelReason</text>
                                    }
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="rq-note rq-note-@key">
                                <i class="fa-solid @iconOf[key]"></i>
                                <span>
                                    @noteOf[key]
                                    @if (isReleased && r.ReleaseDate.HasValue)
                                    {
                                        <text> Released on @r.ReleaseDate.Value.ToString("dd MMM yyyy").</text>
                                    }
                                </span>
                            </div>

                            <div class="rq-rail">
                                @for (int i = 0; i < stages.Length; i++)
                                {
                                    var filled = i <= stageIndex;
                                    var active = i == stageIndex && !isReleased;
                                    <div class="rq-step @(filled ? "rq-filled" : "") @(active ? "rq-active" : "") @(i == stages.Length - 1 && filled ? "rq-done" : "")">
                                        @if (i > 0)
                                        {
                                            <span class="rq-step-line @(filled ? "rq-filled" : "")"></span>
                                        }
                                        <span class="rq-step-dot"></span>
                                        <span class="rq-step-label">@stages[i]</span>
                                    </div>
                                }
                            </div>
                        }
                    </div>
                </div>
            }
        </div>

        <div class="rq-no-matches" id="rqNoMatches">
            <i class="fa-solid fa-filter-circle-xmark"></i>
            <p>No requests match your filters.</p>
            <button type="button" id="rqClearFilters">Clear filters</button>
        </div>
    }
    else
    {
        <div class="rq-empty">
            <div class="rq-empty-barcode"></div>
            <h5>No specimens on file</h5>
            <p>You currently have no laboratory or diagnostic test requests. New orders from your doctor will appear here.</p>
        </div>
    }

    <!-- ==========================================
        FOOTER
    =========================================== -->
    <div class="rq-footer">
        <hr />
        <div class="rq-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="rq-footer-divider">|</span>
            <span>Patient Portal</span>
            <span class="rq-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </div>

</div>

<style>
    :root {
        --rq-paper: #F5F3ED;
        --rq-raised: #FFFFFF;
        --rq-ink: #191D1B;
        --rq-ink-soft: #5C6560;
        --rq-ink-faint: #98A19B;
        --rq-line: #E4E0D3;
        --rq-line-strong: #D3CDBB;
        --rq-console-a: #14201C;
        --rq-console-b: #0A1210;
        --rq-teal: #0EA39A;
        --rq-teal-deep: #0B7F78;
        --rq-teal-dim: #E0F3F1;
        --rq-green: #3F8F5F;
        --rq-green-dim: #E5F3EA;
        --rq-amber: #C98A2A;
        --rq-amber-dim: #FBF0DC;
        --rq-red: #B0463F;
        --rq-red-dim: #F7E8E6;
        --rq-radius: 16px;
        --rq-shadow: 0 8px 26px rgba(20, 25, 22, 0.07);
        --rq-shadow-sm: 0 3px 10px rgba(20, 25, 22, 0.05);
    }

    .rq-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--rq-ink);
        font-family: 'Inter', sans-serif;
        background: var(--rq-paper);
    }

    /* ============ CONSOLE HEADER ============ */
    .rq-console {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(155deg, var(--rq-console-a), var(--rq-console-b));
        border-radius: var(--rq-radius);
        padding: 30px 34px;
        margin-bottom: 20px;
        overflow: hidden;
        box-shadow: 0 16px 34px rgba(10, 18, 16, 0.28);
    }

    .rq-console-scan {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(90deg, rgba(14,163,154,.05) 0 2px, transparent 2px 14px);
        pointer-events: none;
    }

    .rq-console-left {
        position: relative;
        z-index: 1;
    }

    .rq-console-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .1em;
        text-transform: uppercase;
        color: var(--rq-teal);
        margin-bottom: 10px;
    }

    .rq-console-left h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 27px;
        color: #F5F7F6;
        margin: 0 0 6px;
        letter-spacing: -.01em;
    }

    .rq-console-left p {
        margin: 0;
        color: rgba(245,247,246,.62);
        font-size: 13.5px;
        max-width: 380px;
    }

    .rq-console-right {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 22px;
        flex-shrink: 0;
        border-left: 1px solid rgba(255,255,255,.14);
        padding-left: 26px;
    }

    .rq-console-ring {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: conic-gradient(var(--rq-teal) calc(var(--rq-pct) * 1%), rgba(255,255,255,.12) 0);
    }

    .rq-ring-inner {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--rq-console-b);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .rq-ring-inner span {
            font-family: 'IBM Plex Mono', monospace;
            font-weight: 700;
            color: #F5F7F6;
            font-size: 14px;
            line-height: 1;
        }

        .rq-ring-inner small {
            margin-top: 3px;
            font-size: 7px;
            color: rgba(245,247,246,.5);
            text-transform: uppercase;
            letter-spacing: .05em;
        }

    .rq-console-readout {
        text-align: right;
    }

    .rq-readout-label {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10px;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(245,247,246,.5);
        margin-bottom: 6px;
    }

    .rq-readout-num {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 34px;
        font-weight: 700;
        color: var(--rq-teal);
        letter-spacing: .04em;
        text-shadow: 0 0 18px rgba(14, 163, 154, 0.55);
    }

    /* ============ TICKER ============ */
    .rq-ticker {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 18px;
    }

    .rq-tick {
        background: var(--rq-raised);
        border-radius: 12px;
        box-shadow: var(--rq-shadow-sm);
        padding: 14px 16px 12px;
        position: relative;
        overflow: hidden;
    }

    .rq-tick-bar {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
    }

    .rq-bar-ink {
        background: var(--rq-ink);
    }

    .rq-bar-green {
        background: var(--rq-green);
    }

    .rq-bar-amber {
        background: var(--rq-amber);
    }

    .rq-bar-red {
        background: var(--rq-red);
    }

    .rq-tick-num {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 22px;
        font-weight: 700;
        color: var(--rq-ink);
        margin-top: 4px;
    }

    .rq-tick-label {
        display: block;
        font-size: 11px;
        color: var(--rq-ink-soft);
        margin-top: 2px;
        font-weight: 500;
    }

    /* ============ TOOLBAR ============ */
    .rq-toolbar {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
        margin-bottom: 18px;
        background: var(--rq-raised);
        border-radius: 12px;
        box-shadow: var(--rq-shadow-sm);
        padding: 12px 16px;
    }

    .rq-search {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--rq-paper);
        border: 1px solid var(--rq-line);
        border-radius: 999px;
        padding: 8px 14px;
        flex: 1;
        min-width: 200px;
    }

        .rq-search i {
            color: var(--rq-ink-faint);
            font-size: 12px;
        }

        .rq-search input {
            border: none;
            background: transparent;
            outline: none;
            font-family: 'Inter', sans-serif;
            font-size: 13px;
            color: var(--rq-ink);
            width: 100%;
        }

            .rq-search input::placeholder {
                color: var(--rq-ink-faint);
            }

    .rq-filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .rq-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 11px;
        font-weight: 600;
        font-family: 'Inter', sans-serif;
        cursor: pointer;
        transition: all .15s ease;
    }

        .rq-chip:hover {
            border-color: var(--rq-teal);
            color: var(--rq-teal-deep);
        }

        .rq-chip.active {
            background: var(--rq-ink);
            border-color: var(--rq-ink);
            color: #fff;
        }

    .rq-chip-urgent.active {
        background: var(--rq-red);
        border-color: var(--rq-red);
        color: #fff;
    }

    .rq-toolbar-actions {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-left: auto;
    }

    .rq-sort {
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 7px 12px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
    }

    .rq-export {
        display: flex;
        align-items: center;
        gap: 7px;
        border: none;
        background: var(--rq-ink);
        color: #fff;
        border-radius: 999px;
        padding: 8px 14px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s ease;
    }

        .rq-export:hover {
            background: var(--rq-teal-deep);
        }

    /* ============ TICKET LIST ============ */
    .rq-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .rq-hidden {
        display: none !important;
    }

    .rq-card {
        position: relative;
        display: flex;
        background: var(--rq-raised);
        border-radius: var(--rq-radius);
        box-shadow: var(--rq-shadow-sm);
        overflow: hidden;
        transition: box-shadow .2s, transform .2s;
    }

        .rq-card:hover {
            box-shadow: var(--rq-shadow);
            transform: translateY(-2px);
        }

    .rq-card-cancelled {
        opacity: .72;
    }

    .rq-card-urgent {
        animation: rqUrgentGlow 2.4s ease-in-out infinite;
    }

    @@keyframes rqUrgentGlow {
        0%, 100% {
            box-shadow: var(--rq-shadow-sm), 0 0 0 1.5px rgba(176,70,63,.18);
        }

        50% {
            box-shadow: var(--rq-shadow-sm), 0 0 0 3.5px rgba(176,70,63,.32);
