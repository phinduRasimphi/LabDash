@model List<LabDash.Models.TestRequestViewModel>
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment Env

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Test Requests";
    ViewData["ActivePage"] = "Requests";

    var inv = System.Globalization.CultureInfo.InvariantCulture;

    // The 5 stages a request moves through (cancelled sits outside the flow)
    var stages = new[] { "Submitted", "Sample received", "In progress", "Completed", "Released" };
    var stageKeys = new[] { "submitted", "received", "inprogress", "completed", "released" };

    // Works whatever exact text is stored in the DB ("Samples Received", "Released by doctor", ...)
    string StatusKey(string? raw)
    {
        var s = (raw ?? "").Trim().ToLowerInvariant();
        if (s.Contains("cancel")) return "cancelled";
        if (s.Contains("release")) return "released";
        if (s.Contains("complete")) return "completed";
        if (s.Contains("progress") || s.Contains("process")) return "inprogress";
        if (s.Contains("sample") || s.Contains("received") || s.Contains("collect")) return "received";
        return "submitted";
    }

    var stageOf = new Dictionary<string, int>
    {
        ["submitted"] = 0,
        ["received"] = 1,
        ["inprogress"] = 2,
        ["completed"] = 3,
        ["released"] = 4
    };

    var labelOf = new Dictionary<string, string>
    {
        ["submitted"] = "Submitted",
        ["received"] = "Sample received",
        ["inprogress"] = "In progress",
        ["completed"] = "Completed",
        ["released"] = "Results ready",
        ["cancelled"] = "Cancelled"
    };

    var noteOf = new Dictionary<string, string>
    {
        ["submitted"] = "Your request has been sent to the lab. We are waiting for your sample to arrive.",
        ["received"] = "The lab has received your sample. Testing will start soon.",
        ["inprogress"] = "Your sample is being tested.",
        ["completed"] = "Testing is finished. Your doctor is reviewing the results before releasing them to you.",
        ["released"] = "Your results are ready. Open this request to view them."
    };

    var iconOf = new Dictionary<string, string>
    {
        ["submitted"] = "fa-paper-plane",
        ["received"] = "fa-vial",
        ["inprogress"] = "fa-flask",
        ["completed"] = "fa-user-doctor",
        ["released"] = "fa-circle-check"
    };

    bool IsUrgentOpen(LabDash.Models.TestRequestViewModel x)
    {
        var k = StatusKey(x.Status);
        if (k == "cancelled" || k == "released") return false;
        var u = (x.Urgency ?? "").ToLowerInvariant();
        return u == "high" || u == "urgent" || u == "stat";
    }

    string AgeText(int days)
    {
        if (days <= 0) return "today";
        if (days == 1) return "yesterday";
        if (days < 30) return days + " days ago";
        if (days < 60) return "1 month ago";
        return (days / 30) + " months ago";
    }

    // PREVIEW MODE (development only): open /Patient/Requests?preview=1 to see sample cards
    List<LabDash.Models.TestRequestViewModel> SampleRequests()
    {
        var now = DateTime.Now;
        LabDash.Models.TestRequestViewModel M(int id, string status, string urgency, int daysAgo, params string[] tests) =>
            new LabDash.Models.TestRequestViewModel
            {
                RequestID = id.ToString(),
                RequestDate = now.AddDays(-daysAgo),
                DoctorName = "Kamogelo Makuwa",
                Tests = tests.ToList(),
                Urgency = urgency,
                Status = status
            };

        var list = new List<LabDash.Models.TestRequestViewModel>
        {
            M(9001, "Submitted", "Routine", 1, "Full Blood Count"),
            M(9002, "Samples Received", "Urgent", 2, "Glucose", "Cholesterol"),
            M(9003, "In progress", "Routine", 3, "Full Blood Count", "Glucose", "Cholesterol", "Ferritin"),
            M(9004, "Completed", "Routine", 4, "Full Blood Count"),
            M(9005, "Released by doctor", "Routine", 5, "Glucose"),
            M(9006, "Cancelled", "Routine", 6, "Cholesterol"),
            M(9007, "Released by doctor", "Routine", 20, "Glucose", "Full Blood Count"),
            M(9008, "Released by doctor", "Routine", 41, "Cholesterol"),
            M(9009, "Released by doctor", "Routine", 75, "Ferritin", "Glucose"),
            M(9010, "Cancelled", "Routine", 100, "Full Blood Count"),
            M(9011, "Released by doctor", "Routine", 130, "Cholesterol", "Glucose")
        };
        list[4].ReleaseDate = now.AddDays(-4);
        list[5].CancelReason = "Sample could not be collected";
        list[6].ReleaseDate = now.AddDays(-17);
        list[7].ReleaseDate = now.AddDays(-37);
        list[8].ReleaseDate = now.AddDays(-70);
        list[9].CancelReason = "I no longer need these tests";
        list[10].ReleaseDate = now.AddDays(-124);
        return list;
    }

    var preview = Env.EnvironmentName == "Development" && Context.Request.Query.ContainsKey("preview");
    var items = preview ? SampleRequests() : (Model ?? new List<LabDash.Models.TestRequestViewModel>());
    var total = items.Count;
    var released = items.Count(x => StatusKey(x.Status) == "released");
    var cancelled = items.Count(x => StatusKey(x.Status) == "cancelled");
    var open = total - released - cancelled;           // submitted + received + in progress + completed
    var urgentOpen = items.Count(IsUrgentOpen);
    var activeTotal = total - cancelled;
    var readyPercent = activeTotal > 0 ? Math.Round((double)released / activeTotal * 100) : 0;

    var presentKeys = new[] { "submitted", "received", "inprogress", "completed", "released", "cancelled" }
        .Where(k => items.Any(x => StatusKey(x.Status) == k))
        .ToList();

    // "What needs my attention" strip
    string spotTitle = "", spotText = "", spotBtn = "", spotFilter = "", spotIcon = "", spotTone = "";
    if (released > 0)
    {
        spotTone = "green"; spotIcon = "fa-circle-check"; spotFilter = "released";
        spotTitle = released == 1 ? "1 result is ready for you" : released + " results are ready for you";
        spotText = "Your doctor has reviewed and released them.";
        spotBtn = "Show ready results";
    }
    else if (open > 0)
    {
        var latest = items.Where(x => StatusKey(x.Status) != "cancelled").OrderByDescending(x => x.RequestDate).First();
        var lk = StatusKey(latest.Status);
        spotTone = "teal"; spotIcon = iconOf[lk]; spotFilter = "open";
        spotTitle = "Your latest request is " + labelOf[lk].ToLower();
        spotText = noteOf[lk];
        spotBtn = "Show open requests";
    }

    // ---- Activity insights (all requests, not affected by filters) ----
    var turnDays = items
        .Where(x => StatusKey(x.Status) == "released" && x.ReleaseDate.HasValue)
        .Select(x => Math.Max(0, (x.ReleaseDate.Value.Date - x.RequestDate.Date).Days))
        .ToList();
    double avgTurn = turnDays.Count > 0 ? Math.Round(turnDays.Average(), 1) : -1;
    var fastestTurn = turnDays.Count > 0 ? turnDays.Min() : -1;
    var slowestTurn = turnDays.Count > 0 ? turnDays.Max() : -1;

    var docGroup = items
        .GroupBy(x => x.DoctorName ?? "Unknown")
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key)
        .FirstOrDefault();

    var topTests = items
        .SelectMany(x => x.Tests ?? new List<string>())
        .GroupBy(n => n)
        .OrderByDescending(g => g.Count())
        .ThenBy(g => g.Key)
        .Take(5)
        .Select(g => (Name: g.Key, Count: g.Count()))
        .ToList();
    var maxTest = topTests.Count > 0 ? topTests.Max(z => z.Count) : 1;

    var nowD = DateTime.Now;
    var monthBars = Enumerable.Range(0, 6)
        .Select(i => nowD.AddMonths(i - 5))
        .Select(d => (Label: d.ToString("MMM"), Count: items.Count(x => x.RequestDate.Year == d.Year && x.RequestDate.Month == d.Month)))
        .ToList();
    var maxMonth = Math.Max(1, monthBars.Max(z => z.Count));

    // ---- Extra insights ----
    var busiest = items
        .GroupBy(x => new { x.RequestDate.Year, x.RequestDate.Month })
        .OrderByDescending(g => g.Count())
        .ThenByDescending(g => g.Key.Year)
        .ThenByDescending(g => g.Key.Month)
        .FirstOrDefault();
    var openItems = items.Where(x => { var k = StatusKey(x.Status); return k != "cancelled" && k != "released"; }).ToList();
    var oldestOpenDays = openItems.Count > 0 ? openItems.Max(x => Math.Max(0, (DateTime.Now.Date - x.RequestDate.Date).Days)) : -1;
    var testsTotal = items.Where(x => StatusKey(x.Status) != "cancelled").Sum(x => (x.Tests ?? new List<string>()).Count);

    // status donut (green = ready, amber = in progress, red = cancelled)
    var pRel = total > 0 ? (double)released / total * 100 : 0;
    var pOpen = total > 0 ? (double)open / total * 100 : 0;
    var cutA = pRel;
    var cutB = pRel + pOpen;
    var donutStyle = "conic-gradient(var(--rq-green) 0 " + cutA.ToString("0.##", inv) + "%, var(--rq-amber) " + cutA.ToString("0.##", inv) + "% " + cutB.ToString("0.##", inv) + "%, var(--rq-red) " + cutB.ToString("0.##", inv) + "% 100%)";

    // filter dropdown sources
    var doctorList = items.Select(x => x.DoctorName ?? "Unknown").Distinct().OrderBy(n => n).ToList();
    var testList = items.SelectMany(x => x.Tests ?? new List<string>()).Distinct().OrderBy(n => n).ToList();

    // Expected-ready date for open requests, based on this patient's own past waits
    DateTime? ExpectedFor(LabDash.Models.TestRequestViewModel x)
    {
        var k = StatusKey(x.Status);
        if (k == "cancelled" || k == "released" || avgTurn < 0) return null;
        return x.RequestDate.Date.AddDays(Math.Ceiling(avgTurn));
    }
}

<script>
    // Runs before the page paints: no flash of the wrong theme
    (function() {
        try {
            document.documentElement.classList.add('rq-js');
            var t = localStorage.getItem('rqTheme');
            var sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (t === 'dark' || (t === null && sysDark)) { document.documentElement.classList.add('rq-dark'); }
        } catch (e) { }
    })();
</script>

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@500;600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

<div class="rq-wrap" id="rqWrap" data-theme="light">

    <div class="rq-progress" id="rqProgress" aria-hidden="true"><span></span></div>

    <!-- ==========================================
        CONSOLE HEADER (banner)
    =========================================== -->
    <div class="rq-console">
        <div class="rq-console-scan"></div>

        <button type="button" id="rqTheme" class="rq-theme" aria-label="Switch between light and dark mode" title="Light / dark mode">
            <i class="fa-solid fa-moon"></i>
        </button>

        <div class="rq-console-left">
            <div class="rq-console-eyebrow">Patient Portal &middot; Specimen Tracking</div>
            <h1>My Test Requests</h1>
            <p>Every order, from draw to result. Open a request once its results are ready.</p>
        </div>

        <div class="rq-console-right">
            @if (activeTotal > 0)
            {
                <div class="rq-console-ring" id="rqRing" data-pct="@readyPercent" style="--rq-pct: @readyPercent">
                    <div class="rq-ring-inner">
                        <span>@readyPercent.ToString("0")%</span>
                        <small>Ready</small>
                    </div>
                </div>
            }
            <div class="rq-console-readout">
                <span class="rq-readout-label">Total on file</span>
                <span class="rq-readout-num rq-count" data-count="@total" data-pad="3">@total.ToString("D3")</span>
            </div>
        </div>
    </div>

    @if (preview)
    {
        <div class="rq-preview-note">
            Preview mode &mdash; sample data. Remove <code>?preview=1</code> from the address to see your real requests.
        </div>
    }

    <!-- ==========================================
        WHAT NEEDS YOUR ATTENTION
    =========================================== -->
    @if (!string.IsNullOrEmpty(spotTitle))
    {
        <div class="rq-spot rq-spot-@spotTone">
            <i class="fa-solid @spotIcon"></i>
            <div class="rq-spot-text">
                <strong>@spotTitle</strong>
                <span>@spotText</span>
            </div>
            <button type="button" class="rq-spot-btn" data-spot-filter="@spotFilter">@spotBtn</button>
        </div>
    }

    <!-- "Since your last visit" strip (filled in by script when something changed) -->
    <div class="rq-since rq-hidden" id="rqSince" role="status">
        <i class="fa-solid fa-bell"></i>
        <div class="rq-since-text"><strong id="rqSinceTitle"></strong><span id="rqSinceText"></span></div>
        <button type="button" class="rq-since-btn" id="rqSinceShow">Show them</button>
        <button type="button" class="rq-since-x" id="rqSinceDismiss" aria-label="Dismiss"><i class="fa-solid fa-xmark"></i></button>
    </div>

    <!-- ==========================================
        SUMMARY TICKER (click a tile to filter)
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-ticker">
            <button type="button" class="rq-tick active" data-tick-filter="all">
                <span class="rq-tick-bar rq-bar-ink"></span>
                <span class="rq-tick-num rq-count" data-count="@total" data-pad="2">@total.ToString("D2")</span>
                <span class="rq-tick-label">Total requests</span>
            </button>
            <button type="button" class="rq-tick" data-tick-filter="released">
                <span class="rq-tick-bar rq-bar-green"></span>
                <span class="rq-tick-num rq-count" data-count="@released" data-pad="2">@released.ToString("D2")</span>
                <span class="rq-tick-label">Results ready</span>
            </button>
            <button type="button" class="rq-tick" data-tick-filter="open">
                <span class="rq-tick-bar rq-bar-amber"></span>
                <span class="rq-tick-num rq-count" data-count="@open" data-pad="2">@open.ToString("D2")</span>
                <span class="rq-tick-label">In progress</span>
            </button>
            <button type="button" class="rq-tick" data-tick-filter="cancelled">
                <span class="rq-tick-bar rq-bar-red"></span>
                <span class="rq-tick-num rq-count" data-count="@cancelled" data-pad="2">@cancelled.ToString("D2")</span>
                <span class="rq-tick-label">Cancelled</span>
            </button>
        </div>
    }

    <!-- ==========================================
        TOOLBAR (sticks to the top while you scroll, then folds its status chips away)
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-top-sentinel" id="rqTopSentinel"></div>

        <div class="rq-sticky" id="rqSticky">
            <div class="rq-toolbar">

                <div class="rq-toolbar-row">
                    <div class="rq-search">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <input type="text" id="rqSearchInput" placeholder="Search by doctor, test or request number" aria-label="Search test requests" autocomplete="off">
                        <kbd id="rqKbd" title="Press / to search">/</kbd>
                        <button type="button" id="rqSearchClear" class="rq-search-clear" aria-label="Clear search"><i class="fa-solid fa-xmark"></i></button>
                    </div>

                    <div class="rq-toolbar-actions">
                        <button type="button" id="rqChipsToggle" class="rq-icon-btn rq-chips-toggle" aria-expanded="false" title="Show or hide status filters" aria-label="Show or hide status filters">
                            <i class="fa-solid fa-sliders"></i><span class="rq-dot"></span>
                        </button>
                        <select id="rqRange" class="rq-select" aria-label="Filter by date">
                            <option value="all">All time</option>
                            <option value="30">Last 30 days</option>
                            <option value="90">Last 3 months</option>
                            <option value="365">Last 12 months</option>
                        </select>
                        <select id="rqSortSelect" class="rq-select" aria-label="Sort requests">
                            <option value="newest">Newest first</option>
                            <option value="oldest">Oldest first</option>
                            <option value="urgent">Urgent first</option>
                            <option value="pinned">Pinned first</option>
                        </select>
                        <button type="button" id="rqDensity" class="rq-icon-btn" aria-pressed="false" title="Switch between full and compact tickets" aria-label="Compact view">
                            <i class="fa-solid fa-bars"></i>
                        </button>
                        <button type="button" id="rqGrid" class="rq-icon-btn rq-grid-btn" aria-pressed="false" title="Show tickets in two columns" aria-label="Two column view">
                            <i class="fa-solid fa-table-cells-large"></i>
                        </button>
                        <button type="button" id="rqPrintBtn" class="rq-icon-btn" title="Print this list" aria-label="Print this list">
                            <i class="fa-solid fa-print"></i>
                        </button>
                        <button type="button" id="rqExportBtn" class="rq-export">
                            <i class="fa-solid fa-file-arrow-down"></i> Export CSV
                        </button>
                    </div>
                </div>

                <div class="rq-chips-row">
                    <div class="rq-filter-chips" role="group" aria-label="Filter by status">
                        <button type="button" class="rq-chip active" data-status-filter="all">All <em>@total</em></button>
                        @foreach (var k in presentKeys)
                        {
                            <button type="button" class="rq-chip" data-status-filter="@k">@labelOf[k] <em>@items.Count(x => StatusKey(x.Status) == k)</em></button>
                        }
                        <button type="button" class="rq-chip rq-chip-urgent" data-urgent-filter="true" title="Urgent requests that are still open" aria-pressed="false">
                            <i class="fa-solid fa-bolt"></i> Urgent only <em>@urgentOpen</em>
                        </button>
                        <button type="button" class="rq-chip rq-chip-pin" data-flag-filter="pinned" title="Requests you starred" aria-pressed="false">
                            <i class="fa-solid fa-star"></i> Pinned <em>0</em>
                        </button>
                        <button type="button" class="rq-chip rq-chip-upd" data-flag-filter="updated" title="New, changed or unopened since your last visit" aria-pressed="false">
                            <i class="fa-solid fa-bell"></i> Updated <em>0</em>
                        </button>
                    </div>

                    @if (doctorList.Count > 1 || testList.Count > 1)
                    {
                        <div class="rq-extra-filters">
                            @if (doctorList.Count > 1)
                            {
                                <select id="rqDoctorSel" class="rq-select" aria-label="Filter by doctor">
                                    <option value="">All doctors</option>
                                    @foreach (var dn in doctorList)
                                    {
                                        <option value="@dn">Dr. @dn</option>
                                    }
                                </select>
                            }
                            @if (testList.Count > 1)
                            {
                                <select id="rqTestSel" class="rq-select" aria-label="Filter by test">
                                    <option value="">All tests</option>
                                    @foreach (var tn in testList)
                                    {
                                        <option value="@tn">@tn</option>
                                    }
                                </select>
                            }
                        </div>
                    }
                </div>

            </div>
        </div>

        <div class="rq-resultbar" aria-live="polite">
            <span id="rqCount"></span>
            <button type="button" id="rqResetInline" class="rq-linkbtn rq-hidden">Reset filters</button>
        </div>
    }

    <!-- ==========================================
        REQUISITION TICKETS
    =========================================== -->
    @if (total > 0)
    {
        <div class="rq-list" id="rqList">
            @foreach (var r in items.OrderByDescending(x => x.RequestDate))
            {
                var key = StatusKey(r.Status);
                var isCancelled = key == "cancelled";
                var isReleased = key == "released";
                var stageIndex = stageOf.ContainsKey(key) ? stageOf[key] : 0;
                var isUrgent = IsUrgentOpen(r);
                var resultsUrl = isReleased
                    ? Url.Action("Results", "Patient", new { requestId = r.RequestID })
                    : null;

                var testsList = r.Tests ?? new List<string>();
                var visibleTestCount = 3;
                var daysAgo = Math.Max(0, (DateTime.Now.Date - r.RequestDate.Date).Days);
                var daysOpen = isReleased && r.ReleaseDate.HasValue
                    ? Math.Max(0, (r.ReleaseDate.Value.Date - r.RequestDate.Date).Days)
                    : daysAgo;
                var urgencyText = string.IsNullOrWhiteSpace(r.Urgency) ? "Routine" : r.Urgency;
                var doctorKey = r.DoctorName ?? "Unknown";
                var expDate = ExpectedFor(r);
                var expIso = expDate.HasValue ? expDate.Value.ToString("yyyy-MM-dd") : "";
                var expLate = expDate.HasValue && expDate.Value < DateTime.Now.Date;
                var relDays = isReleased && r.ReleaseDate.HasValue
                    ? Math.Max(0, (DateTime.Now.Date - r.ReleaseDate.Value.Date).Days)
                    : 9999;

                <article class="rq-card @(isCancelled ? "rq-card-cancelled" : "") @(isUrgent ? "rq-card-urgent" : "") @(isReleased ? "rq-card-clickable" : "")"
                         data-id="@r.RequestID"
                         data-doctor="@doctorKey"
                         data-date="@r.RequestDate.ToString("yyyy-MM-dd")"
                         data-req-label="@r.RequestDate.ToString("dd MMM yyyy")"
                         data-month-label="@r.RequestDate.ToString("MMMM yyyy")"
                         data-days="@daysAgo"
                         data-status="@key"
                         data-status-label="@labelOf[key]"
                         data-urgent="@isUrgent.ToString().ToLower()"
                         data-urgency="@urgencyText"
                         data-expected="@expIso"
                         data-rel-days="@relDays"
                         data-tests="@string.Join("|", testsList)"
                         data-href="@resultsUrl">

                    @if (isUrgent)
                    {
                        <div class="rq-flag">Urgent</div>
                    }

                    <div class="rq-stub">
                        <div class="rq-barcode" aria-hidden="true"></div>
                        <div class="rq-stub-id">@r.RequestID</div>
                        <div class="rq-stub-tools">
                            <button type="button" class="rq-copy-btn" data-copy="#@r.RequestID" title="Copy request number" aria-label="Copy request number">
                                <i class="fa-solid fa-copy"></i>
                            </button>
                            <button type="button" class="rq-pin-btn" data-pin="@r.RequestID" aria-pressed="false" title="Pin this request" aria-label="Pin this request">
                                <i class="fa-regular fa-star"></i>
                            </button>
                        </div>
                    </div>

                    <div class="rq-perf"></div>

                    <div class="rq-body">
                        <div class="rq-row-top">
                            <div>
                                <div class="rq-doctor"><i class="fa-solid fa-user-doctor"></i> <span>Dr. <span class="rq-hl">@r.DoctorName</span></span></div>
                                <div class="rq-date">Requested @r.RequestDate.ToString("dd MMM yyyy") (@AgeText(daysAgo))</div>
                                <div class="rq-badges"></div>
                            </div>

                            @if (isReleased)
                            {
                                <a href="@resultsUrl" class="rq-view">
                                    View results <i class="fa-solid fa-arrow-right"></i>
                                </a>
                            }
                            else
                            {
                                <div class="rq-actions">
                                    <span class="rq-pill rq-pill-@key">@labelOf[key]</span>
                                    @if (!isCancelled)
                                    {
                                        <span class="rq-stepcount">Step @(stageIndex + 1) of @stages.Length</span>
                                    }

                                    @if (!preview && (key == "submitted" || key == "received"))
                                    {
                                        <button type="button" class="rq-cancel-btn" data-cancel-id="@r.RequestID">
                                            <i class="fa-solid fa-xmark"></i> Cancel request
                                        </button>
                                    }
                                </div>
                            }
                        </div>

                        <div class="rq-tests-wrap">
                            <div class="rq-tests-chips" id="tests-@r.RequestID">
                                @if (testsList.Count == 0)
                                {
                                    <span class="rq-test-chip">No tests listed</span>
                                }
                                @for (int t = 0; t < testsList.Count; t++)
                                {
                                    <span class="rq-test-chip @(t >= visibleTestCount ? "rq-test-extra" : "")">@testsList[t]</span>
                                }
                            </div>
                            @if (testsList.Count > visibleTestCount)
                            {
                                <button type="button" class="rq-tests-toggle" data-target="tests-@r.RequestID">
                                    <span class="rq-tests-toggle-label">+@(testsList.Count - visibleTestCount) more</span>
                                    <i class="fa-solid fa-chevron-down"></i>
                                </button>
                            }
                        </div>

                        @if (isCancelled)
                        {
                            <div class="rq-cancelled-rail">
                                <i class="fa-solid fa-circle-xmark"></i>
                                <span>
                                    Request cancelled. No further processing.
                                    @if (!string.IsNullOrWhiteSpace(r.CancelReason))
                                    {
                                        <text> Reason: @r.CancelReason</text>
                                    }
                                </span>
                            </div>
                        }
                        else
                        {
                            <div class="rq-note rq-note-@key">
                                <i class="fa-solid @iconOf[key]"></i>
                                <span>
                                    @noteOf[key]
                                    @if (isReleased && r.ReleaseDate.HasValue)
                                    {
                                        <text> Released on @r.ReleaseDate.Value.ToString("dd MMM yyyy").</text>
                                    }
                                    @if (expDate.HasValue)
                                    {
                                        if (expLate)
                                        {
                                            <text> This is taking a little longer than your usual wait.</text>
                                        }
                                        else
                                        {
                                            <text> Usually ready around @expDate.Value.ToString("dd MMM").</text>
                                        }
                                    }
                                </span>
                            </div>

                            <div class="rq-rail">
                                @for (int i = 0; i < stages.Length; i++)
                                {
                                    var filled = i <= stageIndex;
                                    var active = i == stageIndex && !isReleased;
                                    <div class="rq-step @(filled ? "rq-filled" : "") @(active ? "rq-active" : "") @(i == stages.Length - 1 && filled ? "rq-done" : "")">
                                        @if (i > 0)
                                        {
                                            <span class="rq-step-line @(filled ? "rq-filled" : "")"></span>
                                        }
                                        <span class="rq-step-dot"></span>
                                        <span class="rq-step-label">@stages[i]</span>
                                    </div>
                                }
                            </div>
                        }

                        <div class="rq-foot">
                            <button type="button" class="rq-details-btn" aria-expanded="false" aria-controls="dr-@r.RequestID">
                                <span class="rq-details-label">Details</span>
                                <i class="fa-solid fa-chevron-down"></i>
                            </button>
                            <span class="rq-note-ind rq-hidden" title="You have a private note on this request"><i class="fa-solid fa-note-sticky"></i> Note</span>
                        </div>

                        <!-- Expandable details drawer -->
                        <div class="rq-drawer" id="dr-@r.RequestID">
                            <div class="rq-drawer-inner">
                                <div class="rq-drawer-grid">

                                    <dl class="rq-facts">
                                        <div><dt>Request number</dt><dd>#@r.RequestID</dd></div>
                                        <div><dt>Doctor</dt><dd>Dr. @r.DoctorName</dd></div>
                                        <div><dt>Requested</dt><dd>@r.RequestDate.ToString("dd MMM yyyy")</dd></div>
                                        <div><dt>Priority</dt><dd>@urgencyText</dd></div>
                                        @if (isReleased && r.ReleaseDate.HasValue)
                                        {
                                            <div><dt>Released</dt><dd>@r.ReleaseDate.Value.ToString("dd MMM yyyy") (after @daysOpen day@(daysOpen == 1 ? "" : "s"))</dd></div>
                                        }
                                        else if (!isCancelled)
                                        {
                                            <div><dt>Open for</dt><dd>@daysAgo day@(daysAgo == 1 ? "" : "s")</dd></div>
                                        }
                                        @if (expDate.HasValue)
                                        {
                                            <div><dt>Expected around</dt><dd>@expDate.Value.ToString("dd MMM yyyy")</dd></div>
                                        }
                                        <div class="rq-facts-wide">
                                            <dt>Tests (@testsList.Count)</dt>
                                            <dd>
                                                @if (testsList.Count == 0)
                                                {
                                                    <span>None listed</span>
                                                }
                                                else
                                                {
                                                    <ul>@foreach (var tn in testsList) {
                                                        <li>@tn</li>
                                                    }
                                                </ul>
                                            }
                                        </dd>
                                    </div>
                                </dl>

                                @if (isCancelled)
                                {
                                    <div class="rq-why">
                                        <h6>Why was it cancelled?</h6>
                                        <p>@(string.IsNullOrWhiteSpace(r.CancelReason) ? "No reason was recorded." : r.CancelReason)</p>
                                        <p class="rq-why-hint">Need these tests done? Ask your doctor to create a new request.</p>
                                    </div>
                                }
                                else
                                {
                                    <ol class="rq-timeline">
                                        @for (int i = 0; i < stageKeys.Length; i++)
                                        {
                                            var tlState = i < stageIndex || (i == stageIndex && isReleased) ? "done" : (i == stageIndex ? "now" : "todo");
                                            <li class="rq-tl-@tlState">
                                                <span class="rq-tl-dot"></span>
                                                <div>
                                                    <strong>@stages[i]</strong>
                                                    <span>@noteOf[stageKeys[i]]</span>
                                                </div>
                                            </li>
                                        }
                                    </ol>
                                }
                            </div>

                            <!-- Tools: print, copy, remind, private note -->
                            <div class="rq-drawer-tools">
                                <div class="rq-tool-row">
                                    <button type="button" class="rq-tool" data-act="print"><i class="fa-solid fa-print"></i> Print slip</button>
                                    <button type="button" class="rq-tool" data-act="summary"><i class="fa-solid fa-clipboard"></i> Copy summary</button>
                                    @if (!isCancelled && !isReleased)
                                    {
                                        <button type="button" class="rq-tool" data-act="remind"><i class="fa-solid fa-calendar-plus"></i> Remind me</button>
                                    }
                                    @if (isReleased)
                                    {
                                        <a href="@resultsUrl" class="rq-tool rq-tool-go"><i class="fa-solid fa-flask-vial"></i> Open results</a>
                                    }
                                </div>
                                <label class="rq-notebox">
                                    <span>Private note <small>(saved on this device only, your doctor cannot see it)</small></span>
                                    <textarea rows="2" maxlength="400" data-note="@r.RequestID" placeholder="e.g. Fasting needed, bring ID, ask about the cholesterol result"></textarea>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>
            </article>
        }
    </div>

    <div class="rq-sentinel" id="rqSentinel"></div>

    <div class="rq-more-wrap">
        <button type="button" id="rqMore" class="rq-more rq-hidden"></button>
        <div id="rqEnd" class="rq-end rq-hidden"></div>
    </div>

    <div class="rq-no-matches" id="rqNoMatches">
        <i class="fa-solid fa-filter-circle-xmark"></i>
        <p>No requests match your filters.</p>
        <button type="button" id="rqClearFilters">Clear filters</button>
    </div>

    <!-- ==========================================
            YOUR ACTIVITY (fills in as you scroll to it)
        =========================================== -->
    <section class="rq-insights rq-reveal" aria-label="Your activity">
        <div class="rq-sec-head">
            <h2>Your activity</h2>
            <p>A summary of every request on your account.</p>
        </div>

        <div class="rq-ins-grid">

            <div class="rq-ins-card">
                <span class="rq-ins-label">Average wait for results</span>
                @if (avgTurn >= 0)
                {
                    <div class="rq-ins-big"><span data-countup data-value="@avgTurn.ToString(inv)" data-dec="1">@avgTurn.ToString("0.#", inv)</span> <small>day@(avgTurn == 1 ? "" : "s")</small></div>
                    <p>From request to release, across @turnDays.Count released request@(turnDays.Count == 1 ? "" : "s").</p>
                }
                else
                {
                    <div class="rq-ins-big rq-ins-none">Not enough data yet</div>
                    <p>This appears once your first results are released.</p>
                }
            </div>

            <div class="rq-ins-card">
                <span class="rq-ins-label">Doctor you see most</span>
                @if (docGroup != null)
                {
                    <div class="rq-ins-big rq-ins-name">Dr. @docGroup.Key</div>
                    <p>@docGroup.Count() request@(docGroup.Count() == 1 ? "" : "s") on your account.</p>
                }
            </div>

            <div class="rq-ins-card">
                <span class="rq-ins-label">Requests per month</span>
                <div class="rq-vbars">
                    @foreach (var mb in monthBars)
                    {
                        var vh = (int)Math.Round(mb.Count * 100.0 / maxMonth);
                        <div class="rq-vbar">
                            <span class="rq-vbar-n">@mb.Count</span>
                            <div class="rq-vbar-track"><div class="rq-bar rq-bar-v" style="height:@(vh)%"></div></div>
                            <span class="rq-vbar-l">@mb.Label</span>
                        </div>
                    }
                </div>
            </div>

            <div class="rq-ins-card">
                <span class="rq-ins-label">Tests you have had most</span>
                @if (topTests.Count == 0)
                {
                    <p>No tests recorded yet.</p>
                }
                else
                {
                    <ul class="rq-hbars">
                        @foreach (var tt in topTests)
                        {
                            var hw = (int)Math.Round(tt.Count * 100.0 / maxTest);
                            <li>
                                <div class="rq-hrow"><span>@tt.Name</span><b>@tt.Count</b></div>
                                <div class="rq-hbar"><div class="rq-bar rq-bar-h" style="width:@(hw)%"></div></div>
                            </li>
                        }
                    </ul>
                }
            </div>

            <div class="rq-ins-card">
                <span class="rq-ins-label">Where your requests stand</span>
                <div class="rq-donut-row">
                    <div class="rq-donut" style="background:@donutStyle">
                        <div class="rq-donut-hole"><b>@total</b><small>total</small></div>
                    </div>
                    <ul class="rq-legend">
                        <li><i class="rq-lg rq-lg-green"></i> Results ready <b>@released</b></li>
                        <li><i class="rq-lg rq-lg-amber"></i> In progress <b>@open</b></li>
                        <li><i class="rq-lg rq-lg-red"></i> Cancelled <b>@cancelled</b></li>
                    </ul>
                </div>
            </div>

            <div class="rq-ins-card">
                <span class="rq-ins-label">Highlights</span>
                <ul class="rq-facts-list">
                    <li><span>Fastest result</span><b>@(fastestTurn >= 0 ? fastestTurn + " day" + (fastestTurn == 1 ? "" : "s") : "n/a")</b></li>
                    <li><span>Slowest result</span><b>@(slowestTurn >= 0 ? slowestTurn + " day" + (slowestTurn == 1 ? "" : "s") : "n/a")</b></li>
                    <li><span>Busiest month</span><b>@(busiest != null ? new DateTime(busiest.Key.Year, busiest.Key.Month, 1).ToString("MMM yyyy") + " (" + busiest.Count() + ")" : "n/a")</b></li>
                    <li><span>Longest open request</span><b>@(oldestOpenDays >= 0 ? oldestOpenDays + " day" + (oldestOpenDays == 1 ? "" : "s") : "none open")</b></li>
                    <li><span>Tests ordered (not cancelled)</span><b>@testsTotal</b></li>
                </ul>
            </div>

        </div>
    </section>

    <!-- ==========================================
            STATUS GUIDE
        =========================================== -->
    <details class="rq-guide">
        <summary><i class="fa-solid fa-circle-question"></i> What do the statuses mean?</summary>
        <ol>
            @for (int gi = 0; gi < stageKeys.Length; gi++)
            {
                <li>
                    <i class="fa-solid @iconOf[stageKeys[gi]]"></i>
                    <div><strong>@labelOf[stageKeys[gi]]</strong><span>@noteOf[stageKeys[gi]]</span></div>
                </li>
            }
            <li>
                <i class="fa-solid fa-circle-xmark"></i>
                <div><strong>Cancelled</strong><span>The request was stopped and no further testing will happen. You can cancel a request until the lab starts testing.</span></div>
            </li>
        </ol>
    </details>

    <!-- Quick-action dock (appears once you scroll) -->
    <div class="rq-dock" id="rqDock">
        @if (released > 0)
        {
            <button type="button" id="rqNextReady" class="rq-dock-btn rq-dock-ready" title="Jump to the next ready result">
                <i class="fa-solid fa-circle-check"></i><span>Next result</span><b>@released</b>
            </button>
        }
        <button type="button" id="rqExpandAll" class="rq-dock-btn" title="Open or close the details of every ticket">
            <i class="fa-solid fa-angles-down"></i><span>Expand all</span>
        </button>
        <button type="button" id="rqHelpBtn" class="rq-dock-btn rq-dock-icon rq-dock-help" aria-label="Keyboard shortcuts" title="Keyboard shortcuts (?)">
            <i class="fa-solid fa-keyboard"></i>
        </button>
        <button type="button" id="rqTop" class="rq-dock-btn rq-dock-icon" aria-label="Back to top" title="Back to top">
            <i class="fa-solid fa-arrow-up"></i>
        </button>
    </div>
}
    else
{
    <div class="rq-empty">
        <div class="rq-empty-barcode"></div>
        <h5>No requests yet</h5>
        <p>When your doctor sends a test request to the lab, it will appear here and you can follow it from sample to result.</p>
    </div>
}

<!-- ==========================================
        FOOTER
    =========================================== -->
<div class="rq-footer">
    <hr />
    <div class="rq-footer-content">
        <i class="fa-solid fa-shield-halved"></i>
        <span>Laboratory Information Management System</span>
        <span class="rq-footer-divider">|</span>
        <span>Patient Portal</span>
        <span class="rq-footer-divider">|</span>
        <span>@DateTime.Now.Year</span>
    </div>
</div>

<!-- ==========================================
        CANCEL DIALOG
    =========================================== -->
<div class="rq-modal" id="rqModal" aria-hidden="true">
    <div class="rq-modal-card" role="dialog" aria-modal="true" aria-labelledby="rqModalTitle">
        <form asp-action="CancelRequest" asp-controller="Patient" method="post" id="rqCancelForm">
            <input type="hidden" name="requestId" id="rqCancelId" value="" />
            <input type="hidden" name="reason" id="rqCancelReason" value="" />

            <h3 id="rqModalTitle">Cancel request <span id="rqModalRef"></span>?</h3>
            <p class="rq-modal-sub">The lab will stop work on this request and your doctor will be told. This cannot be undone.</p>

            <div class="rq-reasons" role="group" aria-label="Reason for cancelling">
                <button type="button" class="rq-reason" data-reason="I no longer need these tests">I no longer need these tests</button>
                <button type="button" class="rq-reason" data-reason="I could not give a sample">I could not give a sample</button>
                <button type="button" class="rq-reason" data-reason="The request was made by mistake">Made by mistake</button>
                <button type="button" class="rq-reason" data-reason="I will use another lab">I will use another lab</button>
            </div>

            <label class="rq-modal-label" for="rqReasonText">Anything else to add? (optional)</label>
            <textarea id="rqReasonText" rows="2" maxlength="250" placeholder="Add a short note for your doctor"></textarea>

            <div class="rq-modal-actions">
                <button type="button" class="rq-btn-ghost" id="rqModalKeep">Keep request</button>
                <button type="submit" class="rq-btn-danger">Cancel request</button>
            </div>
        </form>
    </div>
</div>

<!-- ==========================================
        SHORTCUTS DIALOG
    =========================================== -->
<div class="rq-modal" id="rqHelp" aria-hidden="true">
    <div class="rq-modal-card" role="dialog" aria-modal="true" aria-labelledby="rqHelpTitle">
        <h3 id="rqHelpTitle">Keyboard shortcuts</h3>
        <p class="rq-modal-sub">Move around your requests without the mouse.</p>
        <ul class="rq-keys">
            <li><kbd>/</kbd><span>Search</span></li>
            <li><kbd>J</kbd> <kbd>K</kbd><span>Next / previous request</span></li>
            <li><kbd>Enter</kbd><span>Open results (or details)</span></li>
            <li><kbd>E</kbd><span>Show or hide details</span></li>
            <li><kbd>P</kbd><span>Pin or unpin the request</span></li>
            <li><kbd>G</kbd><span>Two column view</span></li>
            <li><kbd>C</kbd><span>Compact view</span></li>
            <li><kbd>T</kbd><span>Light / dark mode</span></li>
            <li><kbd>?</kbd><span>Show this list</span></li>
            <li><kbd>Esc</kbd><span>Close a dialog or clear search</span></li>
        </ul>
        <div class="rq-modal-actions">
            <button type="button" class="rq-btn-ghost" id="rqHelpClose">Close</button>
        </div>
    </div>
</div>

<div class="rq-toast" id="rqToast" role="status" aria-live="polite"></div>

</div>

<style>
    /* =====================================================
           PAGE-WIDE DARK MODE
           Paints the layout around the view too (sides, header,
           sidebar, footer), not only the .rq-wrap block.
           ===================================================== */
    html.rq-dark {
        color-scheme: dark;
        background: #0E1412 !important;
    }

        html.rq-dark body {
            background: #0E1412 !important;
            color: #E8EEEB !important;
        }

        html.rq-dark :is(body > *, body > * > *, body > * > * > *):where(:not(.rq-wrap, .rq-wrap *, script, style, link, img, svg, i, button, a, input, select, textarea, label, .modal-backdrop, .rq-modal)) {
            background-color: #0E1412 !important;
            color: #E8EEEB !important;
            border-color: #26302B !important;
        }

        html.rq-dark :is(header, nav, aside, footer, .sidebar, .navbar, .topbar, .top-bar, #sidebar, .side-nav, .app-sidebar, .app-header, .navbar-collapse):where(:not(.rq-wrap *)) {
            background-color: #121A17 !important;
            background-image: none !important;
            color: #CBD5D0 !important;
            border-color: #26302B !important;
        }

        html.rq-dark :is(main, .main, .main-content, .content, .content-wrapper, .page-content, .page-wrapper, .wrapper, .container, .container-fluid, #content, #main, .card, .dropdown-menu, .modal-content, .list-group-item, .offcanvas):where(:not(.rq-wrap *)) {
            background-color: #0E1412 !important;
            color: #E8EEEB !important;
            border-color: #26302B !important;
        }

        html.rq-dark :is(nav, aside, header, .sidebar, .navbar, #sidebar, .side-nav) :is(a, span, i, li, small, p):where(:not(.rq-wrap *)) {
            color: #CBD5D0 !important;
        }

        html.rq-dark :is(hr, .dropdown-divider):where(:not(.rq-wrap *)) {
            border-color: #26302B !important;
        }

    /* =====================================================
           VIEW STYLES
           ===================================================== */
    .rq-wrap {
        --rq-top: 0px;
        --rq-paper: #F5F3ED;
        --rq-raised: #FFFFFF;
        --rq-ink: #191D1B;
        --rq-ink-soft: #5C6560;
        --rq-ink-faint: #7E8882;
        --rq-line: #E4E0D3;
        --rq-line-strong: #D3CDBB;
        --rq-console-a: #14201C;
        --rq-console-b: #0A1210;
        --rq-teal: #0EA39A;
        --rq-teal-deep: #0B7F78;
        --rq-teal-dim: #E0F3F1;
        --rq-green: #3F8F5F;
        --rq-green-dim: #E5F3EA;
        --rq-amber: #B87A1E;
        --rq-amber-dim: #FBF0DC;
        --rq-red: #B0463F;
        --rq-red-dim: #F7E8E6;
        --rq-radius: 16px;
        --rq-shadow: 0 8px 26px rgba(20, 25, 22, 0.09);
        --rq-shadow-sm: 0 3px 10px rgba(20, 25, 22, 0.05);
    }

        .rq-wrap[data-theme="dark"], html.rq-dark .rq-wrap {
            --rq-paper: #0E1412;
            --rq-raised: #172019;
            --rq-ink: #E8EEEB;
            --rq-ink-soft: #A5B0AA;
            --rq-ink-faint: #7F8B85;
            --rq-line: #26302B;
            --rq-line-strong: #34403A;
            --rq-teal: #2CC4BA;
            --rq-teal-deep: #4FD6CC;
            --rq-teal-dim: #12302D;
            --rq-green: #5CBB82;
            --rq-green-dim: #13301F;
            --rq-amber: #E0A540;
            --rq-amber-dim: #33280F;
            --rq-red: #E1736B;
            --rq-red-dim: #3A1B18;
            --rq-shadow: 0 8px 26px rgba(0, 0, 0, 0.45);
            --rq-shadow-sm: 0 3px 10px rgba(0, 0, 0, 0.3);
        }

    .rq-wrap {
        max-width: 980px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--rq-ink);
        font-family: 'Inter', sans-serif;
        background: var(--rq-paper);
        transition: background .25s ease, color .25s ease;
        position: relative;
    }

        .rq-wrap button, .rq-wrap select, .rq-wrap textarea, .rq-wrap input {
            font-family: 'Inter', sans-serif;
        }

            .rq-wrap button:focus-visible, .rq-wrap select:focus-visible, .rq-wrap textarea:focus-visible, .rq-wrap a:focus-visible, .rq-wrap summary:focus-visible {
                outline: 2px solid var(--rq-teal);
                outline-offset: 2px;
            }

    .rq-hidden {
        display: none !important;
    }

    .rq-wrap mark {
        background: var(--rq-amber-dim);
        color: var(--rq-amber);
        border-radius: 3px;
        padding: 0 2px;
    }

    /* ============ SCROLL PROGRESS ============ */
    .rq-progress {
        position: fixed;
        left: 0;
        right: 0;
        top: var(--rq-top);
        height: 3px;
        z-index: 1040;
        pointer-events: none;
    }

        .rq-progress span {
            display: block;
            height: 100%;
            width: 100%;
            background: var(--rq-teal);
            transform: scaleX(0);
            transform-origin: left;
        }

    /* ============ CONSOLE HEADER ============ */
    .rq-console {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(155deg, var(--rq-console-a), var(--rq-console-b));
        border-radius: var(--rq-radius);
        padding: 30px 34px;
        margin-bottom: 18px;
        overflow: hidden;
        box-shadow: 0 16px 34px rgba(10, 18, 16, 0.28);
    }

    .rq-console-scan {
        position: absolute;
        inset: 0;
        background-image: repeating-linear-gradient(90deg, rgba(14,163,154,.05) 0 2px, transparent 2px 14px);
        pointer-events: none;
    }

    .rq-theme {
        position: absolute;
        top: 12px;
        right: 12px;
        z-index: 3;
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid rgba(255,255,255,.18);
        background: rgba(255,255,255,.06);
        color: rgba(245,247,246,.8);
        cursor: pointer;
        font-size: 13px;
        transition: background .15s ease, transform .3s ease;
    }

        .rq-theme:hover {
            background: rgba(255,255,255,.14);
            transform: rotate(18deg);
        }

    .rq-console-left {
        position: relative;
        z-index: 1;
    }

    .rq-console-eyebrow {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .08em;
        color: #2CC4BA;
        margin-bottom: 10px;
    }

    .rq-console-left h1 {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 28px;
        color: #F5F7F6;
        margin: 0 0 6px;
        letter-spacing: -.01em;
    }

    .rq-console-left p {
        margin: 0;
        color: rgba(245,247,246,.7);
        font-size: 13.5px;
        max-width: 380px;
    }

    .rq-console-right {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 22px;
        flex-shrink: 0;
        border-left: 1px solid rgba(255,255,255,.14);
        padding-left: 26px;
    }

    .rq-console-ring {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        background: conic-gradient(#2CC4BA calc(var(--rq-pct) * 1%), rgba(255,255,255,.12) 0);
    }

    .rq-ring-inner {
        width: 56px;
        height: 56px;
        border-radius: 50%;
        background: var(--rq-console-b);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .rq-ring-inner span {
            font-family: 'IBM Plex Mono', monospace;
            font-weight: 700;
            color: #F5F7F6;
            font-size: 14px;
            line-height: 1;
        }

        .rq-ring-inner small {
            margin-top: 3px;
            font-size: 8px;
            color: rgba(245,247,246,.6);
            letter-spacing: .04em;
        }

    .rq-console-readout {
        text-align: right;
    }

    .rq-readout-label {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10.5px;
        color: rgba(245,247,246,.6);
        margin-bottom: 6px;
    }

    .rq-readout-num {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 34px;
        font-weight: 700;
        color: #2CC4BA;
        letter-spacing: .04em;
        text-shadow: 0 0 18px rgba(14, 163, 154, 0.55);
    }

    .rq-preview-note {
        margin: 0 0 16px;
        padding: 10px 14px;
        border-radius: 10px;
        background: var(--rq-amber-dim);
        color: var(--rq-amber);
        font-size: 12.5px;
        font-weight: 600;
    }

    /* ============ ATTENTION STRIP ============ */
    .rq-spot {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 13px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        background: var(--rq-raised);
        box-shadow: var(--rq-shadow-sm);
        border-left: 4px solid var(--rq-teal);
    }

    .rq-spot-green {
        border-left-color: var(--rq-green);
    }

    .rq-spot > i {
        font-size: 18px;
        color: var(--rq-teal);
    }

    .rq-spot-green > i {
        color: var(--rq-green);
    }

    .rq-spot-text {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .rq-spot-text strong {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 14.5px;
        }

        .rq-spot-text span {
            font-size: 12.5px;
            color: var(--rq-ink-soft);
        }

    .rq-spot-btn {
        border: none;
        background: var(--rq-ink);
        color: var(--rq-raised);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: transform .15s ease;
    }

        .rq-spot-btn:hover {
            transform: translateY(-1px);
        }

    /* ---- Since your last visit ---- */
    .rq-since {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 12px 14px 12px 16px;
        border-radius: 12px;
        margin-bottom: 16px;
        background: var(--rq-amber-dim);
        border-left: 4px solid var(--rq-amber);
    }

        .rq-since > i {
            color: var(--rq-amber);
            font-size: 16px;
        }

    .rq-since-text {
        flex: 1;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 2px;
    }

        .rq-since-text strong {
            font-family: 'Space Grotesk', sans-serif;
            font-size: 14px;
            color: var(--rq-ink);
        }

        .rq-since-text span {
            font-size: 12.5px;
            color: var(--rq-ink-soft);
        }

    .rq-since-btn {
        border: none;
        background: var(--rq-amber);
        color: #fff;
        border-radius: 999px;
        padding: 7px 13px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
    }

    .rq-since-x {
        border: none;
        background: none;
        color: var(--rq-ink-faint);
        cursor: pointer;
        padding: 4px 6px;
    }

        .rq-since-x:hover {
            color: var(--rq-ink);
        }

    /* ============ TICKER (filter tiles) ============ */
    .rq-ticker {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 14px;
        margin-bottom: 16px;
    }

    .rq-tick {
        background: var(--rq-raised);
        border: 2px solid transparent;
        border-radius: 12px;
        box-shadow: var(--rq-shadow-sm);
        padding: 14px 16px 12px;
        position: relative;
        overflow: hidden;
        text-align: left;
        cursor: pointer;
        color: inherit;
        transition: border-color .15s ease, transform .15s ease, box-shadow .15s ease;
    }

        .rq-tick:hover {
            transform: translateY(-2px);
            box-shadow: var(--rq-shadow);
        }

        .rq-tick.active {
            border-color: var(--rq-ink);
        }

    .rq-tick-bar {
        position: absolute;
        top: 0;
        left: 0;
        width: 100%;
        height: 3px;
    }

    .rq-bar-ink {
        background: var(--rq-ink);
    }

    .rq-bar-green {
        background: var(--rq-green);
    }

    .rq-bar-amber {
        background: var(--rq-amber);
    }

    .rq-bar-red {
        background: var(--rq-red);
    }

    .rq-tick-num {
        display: block;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 22px;
        font-weight: 700;
        margin-top: 4px;
    }

    .rq-tick-label {
        display: block;
        font-size: 11.5px;
        color: var(--rq-ink-soft);
        margin-top: 2px;
        font-weight: 500;
    }

    /* ============ STICKY TOOLBAR ============ */
    .rq-top-sentinel {
        height: 1px;
        margin-bottom: -1px;
    }

    .rq-sticky {
        position: sticky;
        top: var(--rq-top);
        z-index: 30;
        padding: 6px 0;
        background: var(--rq-paper);
        transition: background .25s ease;
    }

    .rq-toolbar {
        background: var(--rq-raised);
        border-radius: 12px;
        box-shadow: var(--rq-shadow-sm);
        padding: 12px 16px;
        transition: box-shadow .2s ease;
    }

    .rq-sticky.rq-stuck .rq-toolbar {
        box-shadow: 0 12px 30px rgba(0,0,0,.18);
    }

    .rq-toolbar-row {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 12px;
    }

    .rq-chips-row > .rq-filter-chips {
        padding-top: 12px;
    }

    .rq-extra-filters {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        padding-top: 10px;
    }

    .rq-sticky.rq-stuck:not(.rq-chips-open) .rq-chips-row {
        display: none;
    }

    .rq-chips-toggle {
        display: none;
        position: relative;
    }

    .rq-sticky.rq-stuck .rq-chips-toggle {
        display: inline-block;
    }

    .rq-chips-toggle[aria-expanded="true"] {
        background: var(--rq-ink);
        border-color: var(--rq-ink);
        color: var(--rq-raised);
    }

    .rq-dot {
        display: none;
        position: absolute;
        top: 3px;
        right: 3px;
        width: 8px;
        height: 8px;
        border-radius: 50%;
        background: var(--rq-red);
        border: 2px solid var(--rq-raised);
    }

    .rq-chips-toggle.rq-has-filter .rq-dot {
        display: block;
    }

    .rq-search {
        display: flex;
        align-items: center;
        gap: 8px;
        background: var(--rq-paper);
        border: 1px solid var(--rq-line);
        border-radius: 999px;
        padding: 8px 14px;
        flex: 1;
        min-width: 220px;
        transition: border-color .15s ease, box-shadow .15s ease;
    }

        .rq-search:focus-within {
            border-color: var(--rq-teal);
            box-shadow: 0 0 0 3px var(--rq-teal-dim);
        }

        .rq-search i {
            color: var(--rq-ink-faint);
            font-size: 12px;
        }

        .rq-search input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            color: var(--rq-ink);
            width: 100%;
        }

            .rq-search input::placeholder {
                color: var(--rq-ink-faint);
            }

        .rq-search kbd {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 10.5px;
            color: var(--rq-ink-faint);
            border: 1px solid var(--rq-line-strong);
            border-radius: 5px;
            padding: 0 6px;
            line-height: 18px;
            background: transparent;
            box-shadow: none;
        }

    .rq-search-clear {
        display: none;
        border: none;
        background: none;
        color: var(--rq-ink-faint);
        cursor: pointer;
        padding: 0 2px;
    }

    .rq-search.has-text kbd {
        display: none;
    }

    .rq-search.has-text .rq-search-clear {
        display: block;
    }

    .rq-toolbar-actions {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
        margin-left: auto;
    }

    .rq-select {
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 7px 12px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        max-width: 220px;
    }

    .rq-icon-btn {
        width: 32px;
        height: 32px;
        border-radius: 50%;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        cursor: pointer;
        font-size: 12px;
        transition: all .15s ease;
    }

        .rq-icon-btn:hover {
            border-color: var(--rq-teal);
            color: var(--rq-teal-deep);
        }

        .rq-icon-btn[aria-pressed="true"] {
            background: var(--rq-ink);
            border-color: var(--rq-ink);
            color: var(--rq-raised);
        }

    .rq-export {
        display: flex;
        align-items: center;
        gap: 7px;
        border: none;
        background: var(--rq-ink);
        color: var(--rq-raised);
        border-radius: 999px;
        padding: 8px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        transition: background .15s ease;
    }

        .rq-export:hover {
            background: var(--rq-teal-deep);
            color: #fff;
        }

    .rq-filter-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .rq-chip {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 6px 12px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
    }

        .rq-chip em {
            font-style: normal;
            font-family: 'IBM Plex Mono', monospace;
            font-size: 10.5px;
            opacity: .7;
        }

        .rq-chip:hover {
            border-color: var(--rq-teal);
            color: var(--rq-teal-deep);
        }

        .rq-chip.active {
            background: var(--rq-ink);
            border-color: var(--rq-ink);
            color: var(--rq-raised);
        }

    .rq-chip-urgent.active {
        background: var(--rq-red);
        border-color: var(--rq-red);
        color: #fff;
    }

    .rq-chip-pin.active {
        background: var(--rq-amber);
        border-color: var(--rq-amber);
        color: #fff;
    }

    .rq-chip-upd.active {
        background: var(--rq-teal-deep);
        border-color: var(--rq-teal-deep);
        color: #fff;
    }

    .rq-resultbar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 8px 4px 12px;
        font-size: 12px;
        color: var(--rq-ink-faint);
    }

    .rq-linkbtn {
        border: none;
        background: none;
        color: var(--rq-teal-deep);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: underline;
    }

    /* ============ MONTH GROUP HEADERS ============ */
    .rq-list {
        display: flex;
        flex-direction: column;
        gap: 14px;
    }

    .rq-month {
        display: flex;
        align-items: baseline;
        justify-content: space-between;
        gap: 12px;
        padding: 10px 2px 0;
        border-bottom: 1px solid var(--rq-line);
        margin-bottom: -2px;
    }

        .rq-month:first-child {
            padding-top: 0;
        }

        .rq-month span {
            font-family: 'Space Grotesk', sans-serif;
            font-weight: 700;
            font-size: 15px;
        }

        .rq-month em {
            font-style: normal;
            font-size: 12px;
            color: var(--rq-ink-faint);
            padding-bottom: 6px;
        }

    /* ============ TICKETS ============ */
    .rq-card {
        position: relative;
        display: flex;
        background: var(--rq-raised);
        border-radius: var(--rq-radius);
        box-shadow: var(--rq-shadow-sm);
        overflow: hidden;
        transition: box-shadow .2s, transform .2s;
    }

        .rq-card:hover {
            box-shadow: var(--rq-shadow);
            transform: translateY(-2px);
        }

        .rq-card.rq-open {
            box-shadow: var(--rq-shadow);
        }

    .rq-card-cancelled {
        opacity: .78;
    }

    .rq-card-urgent {
        animation: rqUrgentGlow 2.4s ease-in-out infinite;
    }

    .rq-card.rq-flash {
        animation: rqFlash 1.5s ease-out;
    }

    .rq-card.rq-kfocus {
        outline: 2px solid var(--rq-teal);
        outline-offset: 3px;
    }

    @@keyframes rqUrgentGlow {
        0%, 100% {
            box-shadow: var(--rq-shadow-sm), 0 0 0 1.5px rgba(176,70,63,.18);
        }

        50% {
            box-shadow: var(--rq-shadow-sm), 0 0 0 3.5px rgba(176,70,63,.32);
        }
    }

    @@keyframes rqFlash {
        0% {
            box-shadow: 0 0 0 0 rgba(63,143,95,.6);
        }

        30% {
            box-shadow: 0 0 0 7px rgba(63,143,95,.35);
        }

        100% {
            box-shadow: var(--rq-shadow-sm), 0 0 0 0 rgba(63,143,95,0);
        }
    }

    .rq-flag {
        position: absolute;
        top: 14px;
        right: -1px;
        background: var(--rq-amber);
        color: #fff;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10.5px;
        font-weight: 700;
        padding: 5px 14px 5px 18px;
        clip-path: polygon(12px 0, 100% 0, 100% 100%, 12px 100%, 0 50%);
        z-index: 2;
    }

    .rq-stub {
        width: 88px;
        flex-shrink: 0;
        background: var(--rq-paper);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 18px 8px;
    }

    .rq-barcode {
        width: 20px;
        height: 46px;
        background-image: repeating-linear-gradient(90deg, var(--rq-ink) 0px, var(--rq-ink) 2px, transparent 2px, transparent 3px, var(--rq-ink) 3px, var(--rq-ink) 4px, transparent 4px, transparent 6px, var(--rq-ink) 6px, var(--rq-ink) 7px, transparent 7px, transparent 10px);
        opacity: .78;
    }

    .rq-stub-id {
        writing-mode: vertical-rl;
        transform: rotate(180deg);
        font-family: 'IBM Plex Mono', monospace;
        font-size: 12px;
        font-weight: 600;
        letter-spacing: .06em;
        color: var(--rq-ink-soft);
    }

    .rq-stub-tools {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
    }

    .rq-copy-btn, .rq-pin-btn {
        border: none;
        background: rgba(128,128,128,.14);
        color: var(--rq-ink-faint);
        width: 24px;
        height: 24px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        cursor: pointer;
        font-size: 10px;
        transition: all .15s ease;
    }

        .rq-copy-btn:hover {
            background: var(--rq-teal-dim);
            color: var(--rq-teal-deep);
        }

        .rq-copy-btn.rq-copied {
            background: var(--rq-green-dim);
            color: var(--rq-green);
        }

        .rq-pin-btn:hover {
            background: var(--rq-amber-dim);
            color: var(--rq-amber);
        }

        .rq-pin-btn[aria-pressed="true"] {
            background: var(--rq-amber-dim);
            color: var(--rq-amber);
        }

    .rq-perf {
        position: relative;
        width: 0;
        border-left: 2px dashed var(--rq-line-strong);
        flex-shrink: 0;
    }

        .rq-perf::before, .rq-perf::after {
            content: "";
            position: absolute;
            left: -8px;
            width: 16px;
            height: 16px;
            border-radius: 50%;
            background: var(--rq-paper);
        }

        .rq-perf::before {
            top: -8px;
        }

        .rq-perf::after {
            bottom: -8px;
        }

    .rq-body {
        flex: 1;
        padding: 18px 22px 14px;
        display: flex;
        flex-direction: column;
        gap: 14px;
        min-width: 0;
    }

    .rq-row-top {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        gap: 14px;
        flex-wrap: wrap;
    }

    .rq-doctor {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 600;
        font-size: 15px;
        display: flex;
        align-items: center;
        gap: 8px;
    }

        .rq-doctor i {
            color: var(--rq-teal);
            font-size: 13px;
        }

    .rq-date {
        font-size: 12px;
        color: var(--rq-ink-faint);
        margin-top: 3px;
    }

    .rq-badges {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

        .rq-badges:not(:empty) {
            margin-top: 7px;
        }

    .rq-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        font-size: 10.5px;
        font-weight: 700;
        padding: 3px 9px;
        border-radius: 999px;
    }

    .rq-badge-updated {
        background: var(--rq-teal-dim);
        color: var(--rq-teal-deep);
    }

    .rq-badge-new {
        background: var(--rq-amber-dim);
        color: var(--rq-amber);
    }

    .rq-badge-unread {
        background: var(--rq-green-dim);
        color: var(--rq-green);
    }

    .rq-view {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        font-size: 13px;
        font-weight: 700;
        color: #fff;
        background: var(--rq-green);
        text-decoration: none;
        padding: 8px 16px;
        border-radius: 999px;
        transition: gap .2s, filter .2s;
        margin-right: 70px;
    }

        .rq-view:hover {
            color: #fff;
            text-decoration: none;
            gap: 11px;
            filter: brightness(1.08);
        }

    .rq-pill {
        display: inline-flex;
        align-items: center;
        font-size: 11px;
        font-weight: 700;
        padding: 5px 11px;
        border-radius: 999px;
        white-space: nowrap;
    }

    .rq-pill-submitted {
        background: var(--rq-line);
        color: var(--rq-ink-soft);
    }

    .rq-pill-received {
        background: var(--rq-teal-dim);
        color: var(--rq-teal-deep);
    }

    .rq-pill-inprogress, .rq-pill-completed {
        background: var(--rq-amber-dim);
        color: var(--rq-amber);
    }

    .rq-pill-cancelled {
        background: var(--rq-red-dim);
        color: var(--rq-red);
    }

    .rq-actions {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
    }

    .rq-stepcount {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 10.5px;
        color: var(--rq-ink-faint);
        margin-top: -3px;
    }

    .rq-cancel-btn {
        border: 1px solid var(--rq-red);
        background: transparent;
        color: var(--rq-red);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        transition: all .15s ease;
    }

        .rq-cancel-btn:hover {
            background: var(--rq-red);
            color: #fff;
        }

    .rq-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        font-size: 12.5px;
        line-height: 1.5;
        color: var(--rq-ink-soft);
        background: var(--rq-paper);
        border-radius: 10px;
        padding: 9px 12px;
    }

        .rq-note i {
            margin-top: 2px;
            color: var(--rq-teal);
            font-size: 12px;
        }

    .rq-note-completed i {
        color: var(--rq-amber);
    }

    .rq-note-released {
        background: var(--rq-green-dim);
        color: var(--rq-ink);
    }

        .rq-note-released i {
            color: var(--rq-green);
        }

    .rq-card-clickable {
        cursor: pointer;
    }

    .rq-tests-wrap {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

    .rq-tests-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .rq-test-chip {
        background: var(--rq-teal-dim);
        color: var(--rq-teal-deep);
        border-radius: 8px;
        padding: 4px 10px;
        font-size: 12px;
        font-weight: 600;
    }

    .rq-test-extra {
        display: none;
    }

    .rq-tests-chips.rq-expanded .rq-test-extra {
        display: inline-flex;
    }

    .rq-tests-toggle {
        align-self: flex-start;
        display: flex;
        align-items: center;
        gap: 6px;
        border: none;
        background: none;
        color: var(--rq-ink-faint);
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        padding: 0;
    }

        .rq-tests-toggle:hover {
            color: var(--rq-teal-deep);
        }

        .rq-tests-toggle i {
            font-size: 9px;
            transition: transform .2s ease;
        }

        .rq-tests-toggle.rq-open i {
            transform: rotate(180deg);
        }

    .rq-rail {
        display: flex;
        margin-top: 2px;
        padding-top: 6px;
    }

    .rq-step {
        position: relative;
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        text-align: center;
    }

    .rq-step-line {
        position: absolute;
        top: 5px;
        right: 50%;
        width: 100%;
        height: 2px;
        background: var(--rq-line-strong);
        z-index: 0;
    }

        .rq-step-line.rq-filled {
            background: var(--rq-teal);
            transform-origin: left;
            animation: rqGrow .7s ease-out;
        }

    @@keyframes rqGrow {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    .rq-step-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
        background: var(--rq-line-strong);
        border: 2px solid var(--rq-raised);
        z-index: 1;
        margin-bottom: 6px;
    }

    .rq-step.rq-filled .rq-step-dot {
        background: var(--rq-teal);
    }

    .rq-step.rq-done .rq-step-dot {
        background: var(--rq-green);
        box-shadow: 0 0 0 4px var(--rq-green-dim);
    }

    .rq-step.rq-active .rq-step-dot {
        background: var(--rq-teal);
        box-shadow: 0 0 0 4px var(--rq-teal-dim);
        animation: rqPulse 1.8s ease-in-out infinite;
    }

    @@keyframes rqPulse {
        0%, 100% {
            box-shadow: 0 0 0 4px var(--rq-teal-dim);
        }

        50% {
            box-shadow: 0 0 0 7px var(--rq-teal-dim);
        }
    }

    .rq-step-label {
        font-size: 11px;
        color: var(--rq-ink-faint);
    }

    .rq-step.rq-filled .rq-step-label {
        color: var(--rq-ink-soft);
    }

    .rq-step.rq-active .rq-step-label {
        color: var(--rq-teal-deep);
        font-weight: 700;
    }

    .rq-step.rq-done .rq-step-label {
        color: var(--rq-green);
        font-weight: 700;
    }

    .rq-cancelled-rail {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        font-size: 12.5px;
        color: var(--rq-red);
        padding-top: 8px;
        border-top: 1px dashed var(--rq-line-strong);
    }

        .rq-cancelled-rail i {
            margin-top: 2px;
        }

    /* ============ DETAILS DRAWER ============ */
    .rq-foot {
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-top: 1px solid var(--rq-line);
        padding-top: 8px;
    }

    .rq-note-ind {
        font-size: 11px;
        font-weight: 600;
        color: var(--rq-amber);
        display: inline-flex;
        align-items: center;
        gap: 5px;
    }

    .rq-details-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: none;
        background: none;
        color: var(--rq-ink-soft);
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        padding: 4px 0;
    }

        .rq-details-btn:hover {
            color: var(--rq-teal-deep);
        }

        .rq-details-btn i {
            font-size: 10px;
            transition: transform .25s ease;
        }

    .rq-card.rq-open .rq-details-btn i {
        transform: rotate(180deg);
    }

    .rq-drawer {
        display: grid;
        grid-template-rows: 0fr;
        transition: grid-template-rows .3s ease;
    }

    .rq-card.rq-open .rq-drawer {
        grid-template-rows: 1fr;
    }

    .rq-drawer-inner {
        overflow: hidden;
        min-height: 0;
    }

    .rq-drawer-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 22px;
        padding: 6px 0 6px;
    }

    .rq-facts {
        margin: 0;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px 16px;
        align-content: start;
    }

        .rq-facts dt {
            font-size: 11px;
            color: var(--rq-ink-faint);
            font-weight: 600;
            margin-bottom: 2px;
        }

        .rq-facts dd {
            margin: 0;
            font-size: 13px;
            font-weight: 600;
        }

    .rq-facts-wide {
        grid-column: 1 / -1;
    }

    .rq-facts ul {
        margin: 4px 0 0;
        padding-left: 18px;
        font-weight: 500;
        font-size: 12.5px;
        line-height: 1.7;
    }

    .rq-timeline {
        list-style: none;
        margin: 0;
        padding: 0;
        position: relative;
    }

        .rq-timeline li {
            display: flex;
            gap: 12px;
            padding-bottom: 14px;
            position: relative;
        }

            .rq-timeline li:last-child {
                padding-bottom: 0;
            }

            .rq-timeline li::before {
                content: "";
                position: absolute;
                left: 5px;
                top: 14px;
                bottom: -2px;
                width: 2px;
                background: var(--rq-line-strong);
            }

            .rq-timeline li:last-child::before {
                display: none;
            }

    .rq-tl-done::before {
        background: var(--rq-teal) !important;
    }

    .rq-tl-dot {
        width: 12px;
        height: 12px;
        border-radius: 50%;
        background: var(--rq-line-strong);
        flex-shrink: 0;
        margin-top: 3px;
        z-index: 1;
    }

    .rq-tl-done .rq-tl-dot {
        background: var(--rq-teal);
    }

    .rq-tl-now .rq-tl-dot {
        background: var(--rq-teal);
        box-shadow: 0 0 0 4px var(--rq-teal-dim);
    }

    .rq-timeline strong {
        display: block;
        font-size: 12.5px;
    }

    .rq-timeline span {
        font-size: 12px;
        color: var(--rq-ink-soft);
        line-height: 1.45;
    }

    .rq-tl-todo strong, .rq-tl-todo span {
        opacity: .55;
    }

    .rq-why h6 {
        margin: 0 0 6px;
        font-size: 13px;
        font-family: 'Space Grotesk', sans-serif;
    }

    .rq-why p {
        margin: 0 0 8px;
        font-size: 12.5px;
        color: var(--rq-ink-soft);
        line-height: 1.5;
    }

    .rq-why-hint {
        color: var(--rq-ink-faint) !important;
    }

    /* ---- Drawer tools ---- */
    .rq-drawer-tools {
        padding: 14px 0 6px;
        margin-top: 8px;
        border-top: 1px dashed var(--rq-line-strong);
        display: flex;
        flex-direction: column;
        gap: 12px;
    }

    .rq-tool-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
    }

    .rq-tool {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-paper);
        color: var(--rq-ink-soft);
        border-radius: 999px;
        padding: 6px 13px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        text-decoration: none;
        transition: all .15s ease;
    }

        .rq-tool:hover {
            border-color: var(--rq-teal);
            color: var(--rq-teal-deep);
            text-decoration: none;
        }

    .rq-tool-go {
        background: var(--rq-green);
        border-color: var(--rq-green);
        color: #fff;
    }

        .rq-tool-go:hover {
            color: #fff;
            filter: brightness(1.08);
            border-color: var(--rq-green);
        }

    .rq-notebox {
        display: flex;
        flex-direction: column;
        gap: 6px;
        font-size: 12px;
        font-weight: 600;
        color: var(--rq-ink-soft);
    }

        .rq-notebox small {
            font-weight: 500;
            color: var(--rq-ink-faint);
        }

        .rq-notebox textarea {
            width: 100%;
            border: 1px solid var(--rq-line-strong);
            background: var(--rq-paper);
            color: var(--rq-ink);
            border-radius: 10px;
            padding: 8px 12px;
            font-size: 12.5px;
            resize: vertical;
        }

    /* ============ COMPACT VIEW ============ */
    .rq-list.rq-compact {
        gap: 10px;
    }

    .rq-compact .rq-note, .rq-compact .rq-rail, .rq-compact .rq-tests-toggle {
        display: none;
    }

    .rq-compact .rq-test-extra {
        display: none !important;
    }

    .rq-compact .rq-body {
        padding: 12px 18px 8px;
        gap: 10px;
    }

    .rq-compact .rq-stub {
        width: 66px;
        padding: 10px 6px;
    }

    .rq-compact .rq-barcode {
        height: 28px;
    }

    .rq-compact .rq-cancelled-rail {
        display: none;
    }

    /* ============ TWO COLUMN VIEW ============ */
    .rq-list.rq-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        align-items: start;
    }

    .rq-grid .rq-month {
        grid-column: 1 / -1;
    }

    .rq-grid .rq-stub {
        width: 66px;
        padding: 14px 6px;
    }

    .rq-grid .rq-barcode {
        height: 32px;
    }

    .rq-grid .rq-step-label {
        display: none;
    }

    .rq-grid .rq-body {
        padding: 16px 16px 12px;
    }

    .rq-grid .rq-view {
        margin-right: 0;
    }

    .rq-grid .rq-drawer-grid {
        grid-template-columns: 1fr;
    }

    .rq-grid .rq-actions {
        align-items: flex-start;
    }

    /* ============ PAGING ============ */
    .rq-sentinel {
        height: 1px;
    }

    .rq-more-wrap {
        display: flex;
        justify-content: center;
        margin-top: 18px;
    }

    .rq-more {
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-raised);
        color: var(--rq-ink);
        border-radius: 999px;
        padding: 10px 22px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: border-color .15s ease, transform .15s ease;
    }

        .rq-more:hover {
            border-color: var(--rq-teal);
            transform: translateY(-1px);
        }

    .rq-end {
        font-size: 12.5px;
        color: var(--rq-ink-faint);
        display: flex;
        align-items: center;
        gap: 12px;
        width: 100%;
    }

        .rq-end::before, .rq-end::after {
            content: "";
            flex: 1;
            height: 1px;
            background: var(--rq-line);
        }

    .rq-no-matches {
        display: none;
        flex-direction: column;
        align-items: center;
        gap: 8px;
        text-align: center;
        padding: 40px 20px;
        background: var(--rq-raised);
        border-radius: var(--rq-radius);
        box-shadow: var(--rq-shadow-sm);
        color: var(--rq-ink-soft);
    }

        .rq-no-matches i {
            font-size: 22px;
            color: var(--rq-ink-faint);
        }

        .rq-no-matches button {
            margin-top: 6px;
            border: 1px solid var(--rq-line-strong);
            background: var(--rq-paper);
            border-radius: 999px;
            padding: 7px 16px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            color: var(--rq-ink-soft);
        }

            .rq-no-matches button:hover {
                border-color: var(--rq-teal);
                color: var(--rq-teal-deep);
            }

    .rq-empty {
        background: var(--rq-raised);
        border-radius: var(--rq-radius);
        box-shadow: var(--rq-shadow-sm);
        text-align: center;
        padding: 60px 30px;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 8px;
    }

    .rq-empty-barcode {
        width: 90px;
        height: 40px;
        margin-bottom: 10px;
        background-image: repeating-linear-gradient(90deg, var(--rq-ink-faint) 0px, var(--rq-ink-faint) 2px, transparent 2px, transparent 4px, var(--rq-ink-faint) 4px, var(--rq-ink-faint) 5px, transparent 5px, transparent 9px, var(--rq-ink-faint) 9px, var(--rq-ink-faint) 10px, transparent 10px, transparent 13px);
        opacity: .5;
    }

    .rq-empty h5 {
        margin: 0;
        font-family: 'Space Grotesk', sans-serif;
        font-size: 16px;
        font-weight: 700;
    }

    .rq-empty p {
        margin: 0;
        max-width: 360px;
        font-size: 13.5px;
        color: var(--rq-ink-soft);
        line-height: 1.6;
    }

    /* ============ INSIGHTS ============ */
    .rq-insights {
        margin-top: 44px;
    }

    .rq-sec-head {
        margin-bottom: 14px;
    }

        .rq-sec-head h2 {
            margin: 0;
            font-family: 'Space Grotesk', sans-serif;
            font-size: 20px;
            font-weight: 700;
        }

        .rq-sec-head p {
            margin: 4px 0 0;
            font-size: 13px;
            color: var(--rq-ink-soft);
        }

    .rq-ins-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
    }

    .rq-ins-card {
        background: var(--rq-raised);
        border-radius: 14px;
        box-shadow: var(--rq-shadow-sm);
        padding: 18px 20px;
        display: flex;
        flex-direction: column;
        gap: 8px;
        min-width: 0;
    }

    .rq-ins-label {
        font-size: 12px;
        font-weight: 600;
        color: var(--rq-ink-soft);
    }

    .rq-ins-big {
        font-family: 'Space Grotesk', sans-serif;
        font-weight: 700;
        font-size: 34px;
        line-height: 1.1;
    }

        .rq-ins-big small {
            font-size: 14px;
            font-weight: 600;
            color: var(--rq-ink-soft);
        }

    .rq-ins-name {
        font-size: 22px;
        padding-top: 6px;
        overflow-wrap: anywhere;
    }

    .rq-ins-none {
        font-size: 18px;
        color: var(--rq-ink-soft);
        padding-top: 6px;
    }

    .rq-ins-card p {
        margin: 0;
        font-size: 12.5px;
        color: var(--rq-ink-faint);
        line-height: 1.5;
    }

    .rq-vbars {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 10px;
        height: 130px;
        padding-top: 6px;
    }

    .rq-vbar {
        flex: 1;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 4px;
        height: 100%;
    }

    .rq-vbar-track {
        flex: 1;
        width: 100%;
        max-width: 34px;
        display: flex;
        align-items: flex-end;
        background: var(--rq-paper);
        border-radius: 8px;
        overflow: hidden;
    }

    .rq-vbar-n {
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        font-weight: 600;
    }

    .rq-vbar-l {
        font-size: 11px;
        color: var(--rq-ink-faint);
    }

    .rq-bar {
        background: var(--rq-teal);
        border-radius: 6px;
    }

    .rq-bar-v {
        width: 100%;
        min-height: 3px;
        transform-origin: bottom;
    }

    .rq-bar-h {
        height: 100%;
        transform-origin: left;
    }

    .rq-hbars {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .rq-hrow {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12.5px;
        margin-bottom: 4px;
    }

        .rq-hrow b {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11.5px;
        }

    .rq-hbar {
        height: 8px;
        background: var(--rq-paper);
        border-radius: 999px;
        overflow: hidden;
    }

    /* donut + highlights */
    .rq-donut-row {
        display: flex;
        align-items: center;
        gap: 22px;
        padding-top: 6px;
    }

    .rq-donut {
        width: 112px;
        height: 112px;
        border-radius: 50%;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rq-donut-hole {
        width: 74px;
        height: 74px;
        border-radius: 50%;
        background: var(--rq-raised);
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
    }

        .rq-donut-hole b {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 20px;
            line-height: 1;
        }

        .rq-donut-hole small {
            font-size: 10px;
            color: var(--rq-ink-faint);
            margin-top: 3px;
        }

    .rq-legend {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
        gap: 9px;
        flex: 1;
    }

        .rq-legend li {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12.5px;
            color: var(--rq-ink-soft);
        }

            .rq-legend li b {
                margin-left: auto;
                font-family: 'IBM Plex Mono', monospace;
                font-size: 12px;
                color: var(--rq-ink);
            }

    .rq-lg {
        width: 10px;
        height: 10px;
        border-radius: 3px;
        display: inline-block;
    }

    .rq-lg-green {
        background: var(--rq-green);
    }

    .rq-lg-amber {
        background: var(--rq-amber);
    }

    .rq-lg-red {
        background: var(--rq-red);
    }

    .rq-facts-list {
        list-style: none;
        margin: 0;
        padding: 0;
        display: flex;
        flex-direction: column;
    }

        .rq-facts-list li {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            font-size: 12.5px;
            padding: 9px 0;
            border-bottom: 1px dashed var(--rq-line-strong);
            color: var(--rq-ink-soft);
        }

            .rq-facts-list li:last-child {
                border-bottom: none;
            }

        .rq-facts-list b {
            color: var(--rq-ink);
            font-family: 'IBM Plex Mono', monospace;
            font-size: 12px;
            text-align: right;
        }

    .rq-js .rq-reveal .rq-bar-v {
        transform: scaleY(0);
        transition: transform .8s cubic-bezier(.2,.8,.2,1);
    }

    .rq-js .rq-reveal .rq-bar-h {
        transform: scaleX(0);
        transition: transform .8s cubic-bezier(.2,.8,.2,1);
    }

    .rq-js .rq-reveal.rq-in .rq-bar-v {
        transform: scaleY(1);
    }

    .rq-js .rq-reveal.rq-in .rq-bar-h {
        transform: scaleX(1);
    }

    /* ============ STATUS GUIDE ============ */
    .rq-guide {
        margin-top: 18px;
        background: var(--rq-raised);
        border-radius: 14px;
        box-shadow: var(--rq-shadow-sm);
        padding: 4px 20px;
    }

        .rq-guide summary {
            cursor: pointer;
            list-style: none;
            padding: 14px 0;
            font-size: 13.5px;
            font-weight: 600;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .rq-guide summary::-webkit-details-marker {
                display: none;
            }

            .rq-guide summary i {
                color: var(--rq-teal);
            }

            .rq-guide summary::after {
                content: "\f078";
                font-family: "Font Awesome 6 Free", "Font Awesome 5 Free", sans-serif;
                font-weight: 900;
                font-size: 10px;
                margin-left: auto;
                color: var(--rq-ink-faint);
                transition: transform .2s ease;
            }

        .rq-guide[open] summary::after {
            transform: rotate(180deg);
        }

        .rq-guide ol {
            list-style: none;
            margin: 0;
            padding: 0 0 16px;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 14px 24px;
        }

        .rq-guide li {
            display: flex;
            gap: 12px;
        }

            .rq-guide li > i {
                color: var(--rq-teal);
                margin-top: 3px;
                width: 16px;
                text-align: center;
            }

            .rq-guide li strong {
                display: block;
                font-size: 13px;
            }

            .rq-guide li span {
                font-size: 12.5px;
                color: var(--rq-ink-soft);
                line-height: 1.5;
            }

    /* ============ QUICK-ACTION DOCK ============ */
    .rq-dock {
        position: fixed;
        right: 22px;
        bottom: 24px;
        z-index: 1045;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 8px;
        opacity: 0;
        transform: translateY(14px);
        pointer-events: none;
        transition: opacity .2s ease, transform .2s ease;
    }

        .rq-dock.rq-show {
            opacity: 1;
            transform: none;
            pointer-events: auto;
        }

    .rq-dock-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: 1px solid var(--rq-line-strong);
        background: var(--rq-raised);
        color: var(--rq-ink);
        border-radius: 999px;
        padding: 9px 14px;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
        box-shadow: var(--rq-shadow);
        transition: transform .15s ease, border-color .15s ease;
    }

        .rq-dock-btn:hover {
            transform: translateY(-2px);
            border-color: var(--rq-teal);
        }

    .rq-dock-ready {
        background: var(--rq-green);
        border-color: var(--rq-green);
        color: #fff;
    }

        .rq-dock-ready b {
            background: rgba(255,255,255,.25);
            border-radius: 999px;
            padding: 0 7px;
            font-size: 11px;
        }

    .rq-dock-icon {
        width: 42px;
        height: 42px;
        padding: 0;
        justify-content: center;
        background: var(--rq-ink);
        color: var(--rq-raised);
        border-color: var(--rq-ink);
    }

    .rq-dock-help {
        background: var(--rq-raised);
        color: var(--rq-ink-soft);
        border-color: var(--rq-line-strong);
    }

    /* ============ MODAL + TOAST ============ */
    .rq-modal {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(8, 14, 12, .55);
        backdrop-filter: blur(3px);
