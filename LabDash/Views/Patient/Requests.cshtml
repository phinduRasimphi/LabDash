    }

        .rq-footer-content i {
            color: var(--rq-teal);
        }

    .rq-footer-divider {
        color: var(--rq-line-strong);
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 760px) {
        .rq-ticker {
            grid-template-columns: repeat(2, 1fr);
        }

        .rq-console {
            flex-direction: column;
            align-items: flex-start;
            gap: 18px;
        }

        .rq-console-right {
            border-left: none;
            border-top: 1px solid rgba(255,255,255,.14);
            padding-left: 0;
            padding-top: 16px;
            width: 100%;
            justify-content: space-between;
        }

        .rq-toolbar-actions {
            margin-left: 0;
            width: 100%;
        }

        .rq-drawer-grid {
            grid-template-columns: 1fr;
        }

        .rq-spot, .rq-since {
            flex-wrap: wrap;
        }

        .rq-view {
            margin-right: 0;
        }

        .rq-ins-grid, .rq-guide ol {
            grid-template-columns: 1fr;
        }

        .rq-sticky {
            position: static;
        }

        .rq-chips-toggle {
            display: none !important;
        }

        .rq-sticky.rq-stuck:not(.rq-chips-open) .rq-chips-row {
