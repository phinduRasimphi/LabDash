            justify-content: space-between;
        }

        .rq-toolbar {
            flex-direction: column;
            align-items: stretch;
        }

        .rq-toolbar-actions {
            margin-left: 0;
            justify-content: space-between;
        }
    }

    @@media (max-width: 560px) {
        .rq-wrap {
            padding: 20px 14px 50px;
        }

        .rq-stub {
            width: 60px;
        }

        .rq-stub-id {
            font-size: 10px;
        }

        .rq-step-label {
            display: none;
        }

        .rq-console-ring {
            width: 56px;
            height: 56px;
        }

        .rq-ring-inner {
            width: 42px;
            height: 42px;
        }

            .rq-ring-inner span {
                font-size: 11px;
            }
    }
</style>

<script>
    (function() {
        // ---------------------------------------------
        // Copy request ID to clipboard
        // ---------------------------------------------
        document.querySelectorAll('.rq-copy-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var text = btn.getAttribute('data-copy');
                var icon = btn.querySelector('i');

                function showCopied() {
                    icon.classList.remove('fa-copy');
                    icon.classList.add('fa-check');
                    btn.classList.add('rq-copied');
                    setTimeout(function() {
                        icon.classList.remove('fa-check');
                        icon.classList.add('fa-copy');
                        btn.classList.remove('rq-copied');
                    }, 1500);
                }

                if (navigator.clipboard && navigator.clipboard.writeText) {
                    navigator.clipboard.writeText(text).then(showCopied).catch(function() { });
                } else {
                    var ta = document.createElement('textarea');
                    ta.value = text;
                    ta.style.position = 'fixed';
                    ta.style.opacity = '0';
                    document.body.appendChild(ta);
                    ta.select();
                    try { document.execCommand('copy'); showCopied(); } catch (e) { }
                    document.body.removeChild(ta);
                }
            });
        });

        // ---------------------------------------------
        // Expand/collapse test chips
        // ---------------------------------------------
        document.querySelectorAll('.rq-tests-toggle').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var target = document.getElementById(btn.getAttribute('data-target'));
                if (!target) return;
                var expanded = target.classList.toggle('rq-expanded');
                btn.classList.toggle('rq-open', expanded);
                var label = btn.querySelector('.rq-tests-toggle-label');
                var extraCount = target.querySelectorAll('.rq-test-extra').length;
                if (label) { label.textContent = expanded ? 'Show less' : ('+' + extraCount + ' more'); }
            });
        });

        // ---------------------------------------------
        // A released card opens that request's results
        // (links and buttons inside the card keep their own behaviour)
        // ---------------------------------------------
        document.querySelectorAll('.rq-card[data-href]').forEach(function(card) {
            card.addEventListener('click', function(e) {
                if (e.target.closest('a, button')) { return; }
                window.location.href = card.dataset.href;
            });
        });

        // ---------------------------------------------
        // Cancel a request (patient) - confirm, ask for an optional reason, then post
        // ---------------------------------------------
        document.querySelectorAll('.rq-cancel-btn').forEach(function(btn) {
            btn.addEventListener('click', function() {
                var form = btn.closest('form');
                if (!confirm('Cancel this request? This cannot be undone.')) { return; }
                var reason = prompt('Reason for cancelling (optional):', '');
                if (reason === null) { return; }          // pressed Cancel on the prompt
                form.querySelector('input[name="reason"]').value = reason;
                form.submit();
            });
        });

        // ---------------------------------------------
        // Search + status filter + urgent toggle + sort
        // ---------------------------------------------
        var list = document.getElementById('rqList');
        if (!list) { return; }

        var searchInput = document.getElementById('rqSearchInput');
        var sortSelect = document.getElementById('rqSortSelect');
        var statusChips = document.querySelectorAll('[data-status-filter]');
        var urgentChip = document.querySelector('[data-urgent-filter]');
        var noMatches = document.getElementById('rqNoMatches');
        var clearBtn = document.getElementById('rqClearFilters');

        var state = { search: '', status: 'all', urgentOnly: false };

        function applyFilters() {
            var cards = list.querySelectorAll('.rq-card');
            var visibleCount = 0;

            cards.forEach(function(card) {
                var haystack = ((card.dataset.doctor || '') + ' ' + (card.dataset.tests || '')).toLowerCase();
                var matchesSearch = state.search === '' || haystack.indexOf(state.search) !== -1;
                var matchesStatus = state.status === 'all' || card.dataset.status === state.status;
                var matchesUrgent = !state.urgentOnly || card.dataset.urgent === 'true';

                var visible = matchesSearch && matchesStatus && matchesUrgent;
                card.classList.toggle('rq-hidden', !visible);
                if (visible) { visibleCount++; }
            });

            if (noMatches) {
                noMatches.style.display = visibleCount === 0 ? 'flex' : 'none';
            }
        }

        if (searchInput) {
            searchInput.addEventListener('input', function() {
                state.search = searchInput.value.trim().toLowerCase();
                applyFilters();
            });
        }

        statusChips.forEach(function(chip) {
            chip.addEventListener('click', function() {
                statusChips.forEach(function(c) { c.classList.remove('active'); });
                chip.classList.add('active');
                state.status = chip.getAttribute('data-status-filter');
                applyFilters();
            });
        });

        if (urgentChip) {
            urgentChip.addEventListener('click', function() {
                state.urgentOnly = !state.urgentOnly;
                urgentChip.classList.toggle('active', state.urgentOnly);
                applyFilters();
            });
        }

        if (clearBtn) {
            clearBtn.addEventListener('click', function() {
                state = { search: '', status: 'all', urgentOnly: false };
                if (searchInput) { searchInput.value = ''; }
                statusChips.forEach(function(c) { c.classList.toggle('active', c.getAttribute('data-status-filter') === 'all'); });
                if (urgentChip) { urgentChip.classList.remove('active'); }
                applyFilters();
            });
        }

        if (sortSelect) {
            sortSelect.addEventListener('change', function() {
                var value = sortSelect.value;
                var cards = Array.prototype.slice.call(list.querySelectorAll('.rq-card'));

                cards.sort(function(a, b) {
                    if (value === 'urgent') {
                        var au = a.dataset.urgent === 'true', bu = b.dataset.urgent === 'true';
                        if (au !== bu) { return au ? -1 : 1; }
                        return b.dataset.date.localeCompare(a.dataset.date);
                    }
                    if (value === 'oldest') { return a.dataset.date.localeCompare(b.dataset.date); }
                    return b.dataset.date.localeCompare(a.dataset.date);
                });

                cards.forEach(function(c) { list.appendChild(c); });
            });
        }

        // ---------------------------------------------
        // CSV export (respects current filters)
        // ---------------------------------------------
        var exportBtn = document.getElementById('rqExportBtn');
        if (exportBtn) {
            exportBtn.addEventListener('click', function() {
                var rows = [['Request ID', 'Doctor', 'Date', 'Status', 'Urgent', 'Tests']];

                list.querySelectorAll('.rq-card:not(.rq-hidden)').forEach(function(card) {
                    rows.push([
                        card.dataset.id || '',
                        card.dataset.doctor || '',
                        card.dataset.date || '',
                        card.dataset.statusLabel || '',
                        card.dataset.urgent === 'true' ? 'Yes' : 'No',
                        (card.dataset.tests || '').split('|').join('; ')
                    ]);
                });

                var csv = rows.map(function(row) {
                    return row.map(function(field) {
                        return '"' + String(field).replace(/"/g, '""') + '"';
                    }).join(',');
                }).join('\n');

                var blob = new Blob([csv], { type: 'text/csv;charset=utf-8;' });
                var url = URL.createObjectURL(blob);
                var a = document.createElement('a');
                a.href = url;
                a.download = 'test-requests.csv';
                document.body.appendChild(a);
                a.click();
                document.body.removeChild(a);
                URL.revokeObjectURL(url);
            });
        }
    })();
</script>
