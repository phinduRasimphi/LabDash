        .rq-modal.rq-show {
            display: flex;
        }

    .rq-modal-card {
        width: 100%;
        max-width: 440px;
        background: var(--rq-raised);
        color: var(--rq-ink);
        border-radius: 18px;
        padding: 24px;
        box-shadow: 0 24px 60px rgba(0,0,0,.35);
        animation: rqPop .22s ease-out;
