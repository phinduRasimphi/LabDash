@model List<LabDash.Models.TestResultViewModel>
@using System.Text.Json
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    static bool TryNum(string s, out double v)
    {
        v = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        s = s.Trim();
        return double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out v)
            || double.TryParse(s, NumberStyles.Float, CultureInfo.CurrentCulture, out v);
    }

    // Handles "70-99", "-5 - 5", "0.5 to 1.2"
    static bool TryRange(string s, out double lo, out double hi)
    {
        lo = hi = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        var m = Regex.Match(s, @"^\s*(-?[\d.,]+)\s*(?:-|–|to)\s*(-?[\d.,]+)");
        return m.Success && TryNum(m.Groups[1].Value, out lo) && TryNum(m.Groups[2].Value, out hi) && hi > lo;
    }

    static string F(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);

    static string Doctor(string n)
    {
        n = n?.Trim();
        if (string.IsNullOrWhiteSpace(n)) return "Doctor not assigned";
        return n.StartsWith("Dr", StringComparison.OrdinalIgnoreCase) ? n : "Dr. " + n;
    }
}

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Results";
    ViewData["ActivePage"] = "Results";

    var results = Model ?? new List<LabDash.Models.TestResultViewModel>();
    var total = results.Count;
    var panels = results.Select(r => r.RequestID).Distinct().Count();
    var abnormal = results.Count(r => r.IsAbnormal);
    var normal = total - abnormal;
    var testTypes = results.Where(r => !string.IsNullOrWhiteSpace(r.TestName)).Select(r => r.TestName).Distinct().Count();
    var normalPct = total > 0 ? (double)normal / total * 100 : 0;
    var abnormalPct = total > 0 ? 100 - normalPct : 0;
    var normalDeg = F(normalPct * 3.6);

    var topTests = results.GroupBy(r => r.TestName).OrderByDescending(g => g.Count()).Take(6).ToList();

    // Numeric series per test, oldest -> newest
    var series = results
        .Where(r => !string.IsNullOrWhiteSpace(r.TestName) && TryNum(r.ResultValue, out _))
        .GroupBy(r => r.TestName)
        .OrderByDescending(g => g.Count()).ThenBy(g => g.Key)
        .ToList();

    var trend = series.ToDictionary(
        g => g.Key,
        g => g.OrderBy(r => r.ResultDate).ThenBy(r => r.RequestID).Select(r =>
        {
            TryNum(r.ResultValue, out var v);
            var hasRange = TryRange(r.NormalRange, out var lo, out var hi);
            return new
            {
                v,
                d = r.ResultDate != default(DateTime) ? r.ResultDate.ToString("yyyy-MM-dd") : "",
                r = r.RequestID,
                a = r.IsAbnormal,
                lo = hasRange ? lo : (double?)null,
                hi = hasRange ? hi : (double?)null
            };
        }).ToList());

    var trendJson = JsonSerializer.Serialize(trend);

    // Filter options
    var filterTests = results.Where(r => !string.IsNullOrWhiteSpace(r.TestName)).Select(r => r.TestName).Distinct().OrderBy(x => x).ToList();
    var filterDoctors = results.Select(r => Doctor(r.DoctorName)).Distinct().OrderBy(x => x).ToList();
    var filterCats = results.Where(r => !string.IsNullOrWhiteSpace(r.Category)).Select(r => r.Category).Distinct().OrderBy(x => x).ToList();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    .rx-wrap {
        --ink: #102C27;
        --soft: #52716C;
        --faint: #8FA9A3;
        --line: #E1EEEC;
        --line2: #CCE3DF;
        --teal: #0E8C7F;
        --deep: #0A5850;
        --tl: #E3F4F1;
        --g1: #12A392;
        --g2: #0A4F48;
        --green: #2E8B57;
        --gl: #E3F4EA;
        --red: #B0463F;
        --rl: #F7E8E7;
        --purple: #6D4EA8;
        --pl: #EEE8F9;
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        color: var(--ink);
        font-family: 'Inter',sans-serif;
        animation: rxFade .45s ease;
    }

        .rx-wrap *, .rx-wrap *::before, .rx-wrap *::after {
            box-sizing: border-box;
        }

        .rx-wrap h1, .rx-wrap h2, .rx-wrap h3 {
            font-family: 'Poppins',sans-serif;
            margin: 0;
        }

    @@keyframes rxFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes rxRotate {
        to {
            transform: rotate(360deg);
        }
    }

    .rx-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 8px 28px rgba(10,60,55,.08);
    }

    /* Hero */
    .rx-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 38px 42px;
        margin-bottom: 22px;
        border-radius: 24px;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(125deg,var(--g1),var(--g2));
        box-shadow: 0 18px 45px rgba(10,90,80,.20);
    }

        .rx-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 85% 15%,rgba(255,255,255,.13),transparent 35%),radial-gradient(circle at 100% 100%,rgba(255,255,255,.08),transparent 35%);
        }

        .rx-hero > * {
            position: relative;
        }

    .rx-hero-left {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .rx-hero-icon {
        width: 74px;
        height: 74px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        font-size: 28px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.3);
    }

    .rx-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(255,255,255,.75);
    }

    .rx-hero h1 {
        font-size: 31px;
        margin-bottom: 6px;
    }

    .rx-hero p {
        margin: 0;
        max-width: 620px;
        font-size: 15px;
        line-height: 1.55;
        color: rgba(255,255,255,.86);
    }

    .rx-hero-right {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .rx-status {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        white-space: nowrap;
    }

        .rx-status i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #79E1D2;
            box-shadow: 0 0 0 4px rgba(121,225,210,.14);
        }

    .rx-hero-num {
        padding-left: 24px;
        border-left: 1px solid rgba(255,255,255,.25);
    }

        .rx-hero-num strong {
            display: block;
            font: 700 36px/1 'Poppins',sans-serif;
        }

        .rx-hero-num small {
            display: block;
            margin-top: 6px;
            font-size: 11px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255,255,255,.7);
        }

    /* Stats */
    .rx-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 26px;
    }

    .rx-stat {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px;
        border-radius: 20px;
        transition: .2s ease;
    }

        .rx-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 32px rgba(10,60,55,.12);
        }

    .rx-ico {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 20px;
    }

        .rx-ico.teal {
            color: var(--teal);
            background: var(--tl);
        }

        .rx-ico.green {
            color: var(--green);
            background: var(--gl);
        }

        .rx-ico.red {
            color: var(--red);
            background: var(--rl);
        }

        .rx-ico.purple {
            color: var(--purple);
            background: var(--pl);
        }

    .rx-stat span {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--soft);
    }

    .rx-stat strong {
        display: block;
        margin-top: 2px;
        font: 700 28px/1.1 'Poppins',sans-serif;
    }

    .rx-stat small {
        display: block;
        margin-top: 3px;
        font-size: 11.5px;
        color: var(--faint);
    }

    /* Empty state */
    .rx-empty {
        display: flex;
        align-items: center;
        gap: 56px;
        padding: 56px;
    }

    .rx-empty-visual {
        position: relative;
        width: 200px;
        height: 200px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rx-empty-circle {
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 38px;
        color: var(--teal);
        background: var(--tl);
        box-shadow: 0 0 0 14px rgba(14,140,127,.05),0 0 0 28px rgba(14,140,127,.025);
    }

    .rx-orbit {
        position: absolute;
        border: 1px dashed var(--line2);
        border-radius: 50%;
    }

        .rx-orbit.o1 {
            width: 160px;
            height: 160px;
            animation: rxRotate 12s linear infinite;
        }

        .rx-orbit.o2 {
            width: 195px;
            height: 195px;
            animation: rxRotate 18s linear infinite reverse;
        }

    .rx-empty h2 {
        font-size: 25px;
        margin: 12px 0 8px;
    }

    .rx-empty p {
        margin: 0;
        max-width: 600px;
        font-size: 14px;
        line-height: 1.65;
        color: var(--soft);
    }

    .rx-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--deep);
        background: var(--tl);
    }

    .rx-steps {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 26px;
        font-size: 12px;
        font-weight: 600;
        color: var(--soft);
    }

        .rx-steps b {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 8px;
            border-radius: 9px;
            font-size: 11px;
            color: var(--teal);
            background: var(--tl);
        }

        .rx-steps i {
            width: 36px;
            height: 1px;
            background: var(--line2);
        }

    /* Tabs */
    .rx-tabs {
        display: flex;
        width: fit-content;
        gap: 5px;
        padding: 6px;
        margin-bottom: 22px;
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(10,60,55,.08);
    }

    .rx-tab, .rx-pill {
        border: none;
        border-radius: 999px;
        font-family: 'Inter',sans-serif;
        font-weight: 600;
        color: var(--soft);
        background: transparent;
        cursor: pointer;
    }

    .rx-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        font-size: 14px;
    }

        .rx-tab.active, .rx-pill.active {
            color: #fff;
            background: linear-gradient(120deg,var(--g1),var(--g2));
            box-shadow: 0 6px 15px rgba(10,90,80,.2);
        }

    /* Request panel */
    .rx-panel {
        margin-bottom: 24px;
        overflow: hidden;
    }

    .rx-ph {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 24px 28px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg,#F6FBFA,#fff);
    }

    .rx-ph-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .rx-ph-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 19px;
        color: var(--teal);
        background: var(--tl);
    }

    .rx-ph small {
        display: block;
        margin-bottom: 3px;
        font-size: 11px;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--faint);
    }

    .rx-ph h3 {
        font-size: 19px;
    }

    .rx-ph-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 20px;
        margin-top: 8px;
        font-size: 13px;
        color: var(--soft);
    }

        .rx-ph-meta i {
            margin-right: 7px;
            color: var(--teal);
        }
    /* Test ledger (request rows) */
    .rxl-chips {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rxl-chip {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: var(--green);
        background: var(--gl);
    }

        .rxl-chip.abn {
            color: var(--red);
            background: var(--rl);
        }

    .rxl-head, .rxl-main {
        display: grid;
        grid-template-columns: minmax(190px,1.4fr) minmax(120px,.8fr) minmax(220px,1.7fr) 120px;
        gap: 22px;
        align-items: center;
    }

    .rxl-head {
        padding: 14px 28px 14px 34px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--faint);
        background: #F6FAF9;
        border-bottom: 1px solid var(--line);
    }

    .rxl-row {
        position: relative;
        padding: 22px 28px 22px 34px;
        border-bottom: 1px solid var(--line);
        transition: background .15s ease;
    }

        .rxl-row:last-child {
            border-bottom: none;
        }

        .rxl-row::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--green);
        }

        .rxl-row.abn::before {
            background: var(--red);
        }

        .rxl-row.abn {
            background: #FFF9F8;
        }

        .rxl-row:hover {
            background: #F6FBFA;
        }

        .rxl-row.abn:hover {
            background: #FFF3F1;
        }

    .rxl-name {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .rxl-ico {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 17px;
        color: var(--teal);
        background: var(--tl);
    }

    .rxl-row.abn .rxl-ico {
        color: var(--red);
        background: var(--rl);
    }

    .rxl-name strong {
        font-size: 16.5px;
        line-height: 1.3;
    }

    .rxl-val b {
        font: 600 27px/1 'IBM Plex Mono',monospace;
        color: var(--deep);
        word-break: break-word;
    }

    .rxl-row.abn .rxl-val b {
        color: var(--red);
    }

    .rxl-val span {
        margin-left: 7px;
        font-size: 13px;
        color: var(--faint);
    }

    .rxl-line {
        position: relative;
        height: 9px;
        margin: 4px 0 10px;
        border-radius: 999px;
        background: var(--line2);
    }

        .rxl-line.flat {
            background: #BFE3D8;
        }

    .rxl-row.abn .rxl-line.flat {
        background: #EBC3BF;
    }

    .rxl-band {
        position: absolute;
        top: 0;
        height: 100%;
        border-radius: 999px;
        background: #8FD3BF;
    }

    .rxl-mark {
        position: absolute;
        top: 50%;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        transform: translate(-50%,-50%);
        background: var(--teal);
        border: 4px solid #fff;
        box-shadow: 0 0 0 1px var(--teal),0 2px 6px rgba(0,0,0,.15);
    }

    .rxl-row.abn .rxl-mark {
        background: var(--red);
        box-shadow: 0 0 0 1px var(--red),0 2px 6px rgba(0,0,0,.15);
    }

    .rxl-range small {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12.5px;
        color: var(--soft);
    }

        .rxl-range small b {
            color: var(--green);
        }

    .rxl-row.abn .rxl-range small b {
        color: var(--red);
    }

    .rxl-meta {
        display: grid;
        grid-template-columns: 190px 250px 1fr;
        gap: 14px 24px;
        margin-top: 16px;
        padding: 15px 20px;
        border-radius: 14px;
        background: #F3F9F8;
    }

        .rxl-meta small {
            display: block;
            margin-bottom: 5px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .rxl-meta span {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            font-size: 13.5px;
            font-weight: 600;
            line-height: 1.5;
            color: var(--ink);
        }

        .rxl-meta i {
            margin-top: 4px;
            font-size: 12px;
            color: var(--teal);
        }

        .rxl-meta .none {
            font-weight: 500;
            font-style: italic;
            color: var(--faint);
        }

    .rxl-note i {
        color: var(--purple);
    }

    .rxl-note span {
        font-weight: 500;
        color: var(--soft);
    }

    .rx-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--green);
        background: var(--gl);
    }

        .rx-badge.abn {
            color: var(--red);
            background: var(--rl);
        }

    @@media (max-width:1000px) {
        .rxl-head {
            display: none;
        }

        .rxl-main {
            grid-template-columns: 1fr auto;
            gap: 14px;
        }

        .rxl-name {
            order: 1;
        }

        .rxl-st {
            order: 2;
        }

        .rxl-val {
            order: 3;
        }

        .rxl-range {
            order: 4;
            grid-column: 1/-1;
        }

        .rxl-meta {
            grid-template-columns: 1fr 1fr;
        }

        .rxl-note {
            grid-column: 1/-1;
        }
    }

    @@media (max-width:600px) {
        .rxl-row {
            padding: 18px 16px 18px 24px;
        }

        .rxl-meta {
            grid-template-columns: 1fr;
        }
    }

    .rx-pf {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 28px;
        font-size: 12px;
        color: var(--faint);
        background: #F0F7F6;
        border-top: 1px solid var(--line);
    }

    .rx-btn {
        padding: 10px 18px;
        border: 1px solid var(--line2);
        border-radius: 999px;
        font: 600 12.5px 'Inter',sans-serif;
        color: var(--deep);
        background: #fff;
        cursor: pointer;
    }

        .rx-btn:hover {
            background: var(--tl);
            border-color: var(--teal);
        }

    /* Analytics */
    .rx-intro {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 30px;
        margin-bottom: 18px;
    }

        .rx-intro small {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--teal);
        }

        .rx-intro h2 {
            margin: 6px 0 4px;
            font-size: 22px;
        }

        .rx-intro p {
            margin: 0;
            font-size: 13.5px;
            color: var(--soft);
        }

    .rx-intro-num {
        padding-left: 28px;
        border-left: 1px solid var(--line);
        text-align: center;
    }

        .rx-intro-num strong {
            display: block;
            font: 700 32px 'Poppins',sans-serif;
            color: var(--deep);
        }

        .rx-intro-num span {
            font-size: 11px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--faint);
        }

    .rx-grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .rx-chart {
        padding: 28px;
    }

    .rx-chart-h {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .rx-chart-h small {
            font-size: 11px;
            letter-spacing: .05em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .rx-chart-h h3 {
            margin-top: 4px;
            font-size: 18px;
        }

        .rx-chart-h > i {
            font-size: 19px;
