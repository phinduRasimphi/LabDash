@model List<LabDash.Models.TestResultViewModel>
@using System.Text.Json
@using System.Globalization
@using System.Text.RegularExpressions

@functions {
    static bool TryNum(string s, out double v)
    {
        v = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        s = s.Trim();
        return double.TryParse(s, NumberStyles.Float, CultureInfo.InvariantCulture, out v)
            || double.TryParse(s, NumberStyles.Float, CultureInfo.CurrentCulture, out v);
    }

    // Handles "70-99", "-5 - 5", "0.5 to 1.2"
    static bool TryRange(string s, out double lo, out double hi)
    {
        lo = hi = 0;
        if (string.IsNullOrWhiteSpace(s)) return false;
        var m = Regex.Match(s, @"^\s*(-?[\d.,]+)\s*(?:-|–|to)\s*(-?[\d.,]+)");
        return m.Success && TryNum(m.Groups[1].Value, out lo) && TryNum(m.Groups[2].Value, out hi) && hi > lo;
    }

    static string F(double d) => d.ToString("0.##", CultureInfo.InvariantCulture);

    static string Doctor(string n)
    {
        n = n?.Trim();
        if (string.IsNullOrWhiteSpace(n)) return "Doctor not assigned";
        return n.StartsWith("Dr", StringComparison.OrdinalIgnoreCase) ? n : "Dr. " + n;
    }
}

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Results";
    ViewData["ActivePage"] = "Results";

    var results = Model ?? new List<LabDash.Models.TestResultViewModel>();

    // Set by PatientController.Results(requestId) when opened from a request card
    var reqFilter = ViewBag.RequestFilter as int?;
    var single = reqFilter.HasValue;

    var total = results.Count;
    var panels = results.Select(r => r.RequestID).Distinct().Count();
    var abnormal = results.Count(r => r.IsAbnormal);
    var normal = total - abnormal;
    var testTypes = results.Where(r => !string.IsNullOrWhiteSpace(r.TestName)).Select(r => r.TestName).Distinct().Count();
    var normalPct = total > 0 ? (double)normal / total * 100 : 0;
    var abnormalPct = total > 0 ? 100 - normalPct : 0;
    var normalDeg = F(normalPct * 3.6);

    var topTests = results.GroupBy(r => r.TestName).OrderByDescending(g => g.Count()).Take(6).ToList();

    // Numeric series per test, oldest -> newest
    var series = results
        .Where(r => !string.IsNullOrWhiteSpace(r.TestName) && TryNum(r.ResultValue, out _))
        .GroupBy(r => r.TestName)
        .OrderByDescending(g => g.Count()).ThenBy(g => g.Key)
        .ToList();

    var trend = series.ToDictionary(
        g => g.Key,
        g => g.OrderBy(r => r.ResultDate).ThenBy(r => r.RequestID).Select(r =>
        {
            TryNum(r.ResultValue, out var v);
            var hasRange = TryRange(r.NormalRange, out var lo, out var hi);
            return new
            {
                v,
                d = r.ResultDate != default(DateTime) ? r.ResultDate.ToString("yyyy-MM-dd") : "",
                r = r.RequestID,
                a = r.IsAbnormal,
                lo = hasRange ? lo : (double?)null,
                hi = hasRange ? hi : (double?)null
            };
        }).ToList());

    var trendJson = JsonSerializer.Serialize(trend);

    // Filter options
    var filterTests = results.Where(r => !string.IsNullOrWhiteSpace(r.TestName)).Select(r => r.TestName).Distinct().OrderBy(x => x).ToList();
    var filterDoctors = results.Select(r => Doctor(r.DoctorName)).Distinct().OrderBy(x => x).ToList();
    var filterCats = results.Where(r => !string.IsNullOrWhiteSpace(r.Category)).Select(r => r.Category).Distinct().OrderBy(x => x).ToList();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css">

<style>
    .rx-wrap {
        --ink: #102C27;
        --soft: #52716C;
        --faint: #8FA9A3;
        --line: #E1EEEC;
        --line2: #CCE3DF;
        --teal: #0E8C7F;
        --deep: #0A5850;
        --tl: #E3F4F1;
        --g1: #12A392;
        --g2: #0A4F48;
        --green: #2E8B57;
        --gl: #E3F4EA;
        --red: #B0463F;
        --rl: #F7E8E7;
        --purple: #6D4EA8;
        --pl: #EEE8F9;
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        color: var(--ink);
        font-family: 'Inter',sans-serif;
        animation: rxFade .45s ease;
    }

        .rx-wrap *, .rx-wrap *::before, .rx-wrap *::after {
            box-sizing: border-box;
        }

        .rx-wrap h1, .rx-wrap h2, .rx-wrap h3 {
            font-family: 'Poppins',sans-serif;
            margin: 0;
        }

    @@keyframes rxFade {
        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: none;
        }
    }

    @@keyframes rxRotate {
        to {
            transform: rotate(360deg);
        }
    }

    .rx-card {
        background: #fff;
        border: 1px solid var(--line);
        border-radius: 22px;
        box-shadow: 0 8px 28px rgba(10,60,55,.08);
    }

    /* Hero */
    .rx-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 38px 42px;
        margin-bottom: 22px;
        border-radius: 24px;
        overflow: hidden;
        color: #fff;
        background: linear-gradient(125deg,var(--g1),var(--g2));
        box-shadow: 0 18px 45px rgba(10,90,80,.20);
    }

        .rx-hero::before {
            content: "";
            position: absolute;
            inset: 0;
            background: radial-gradient(circle at 85% 15%,rgba(255,255,255,.13),transparent 35%),radial-gradient(circle at 100% 100%,rgba(255,255,255,.08),transparent 35%);
        }

        .rx-hero > * {
            position: relative;
        }

    .rx-hero-left {
        display: flex;
        align-items: center;
        gap: 22px;
    }

    .rx-hero-icon {
        width: 74px;
        height: 74px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 20px;
        font-size: 28px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.3);
    }

    .rx-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 6px;
        font-size: 12px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
        color: rgba(255,255,255,.75);
    }

    .rx-hero h1 {
        font-size: 31px;
        margin-bottom: 6px;
    }

    .rx-hero p {
        margin: 0;
        max-width: 620px;
        font-size: 15px;
        line-height: 1.55;
        color: rgba(255,255,255,.86);
    }

    .rx-hero-right {
        display: flex;
        align-items: center;
        gap: 24px;
    }

    .rx-status {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 10px 16px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
        white-space: nowrap;
    }

        .rx-status i {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            background: #79E1D2;
            box-shadow: 0 0 0 4px rgba(121,225,210,.14);
        }

    .rx-hero-num {
        padding-left: 24px;
        border-left: 1px solid rgba(255,255,255,.25);
    }

        .rx-hero-num strong {
            display: block;
            font: 700 36px/1 'Poppins',sans-serif;
        }

        .rx-hero-num small {
            display: block;
            margin-top: 6px;
            font-size: 11px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255,255,255,.7);
        }

    /* Stats */
    .rx-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 26px;
    }

    .rx-stat {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 22px;
