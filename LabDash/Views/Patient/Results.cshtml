</style>

<div class="rx-wrap">

    <section class="rx-hero">
        <div class="rx-hero-left">
            <div class="rx-hero-icon"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="rx-eyebrow"><i class="fas fa-flask"></i> Laboratory Results</div>
                <h1>My Test Results</h1>
                <p>Review your laboratory results, monitor abnormal values and follow your health information over time.</p>
            </div>
        </div>
        <div class="rx-hero-right">
            <span class="rx-status"><i></i> Results Portal</span>
            <div class="rx-hero-num"><strong>@panels</strong><small>Released Panels</small></div>
        </div>
    </section>

    <section class="rx-stats">
        <div class="rx-card rx-stat"><div class="rx-ico teal"><i class="fas fa-vial"></i></div><div><span>Total Results</span><strong>@total</strong><small>Laboratory values</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico green"><i class="fas fa-circle-check"></i></div><div><span>Normal</span><strong>@normal</strong><small>@normalPct.ToString("0")% of results</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico red"><i class="fas fa-triangle-exclamation"></i></div><div><span>Needs Attention</span><strong>@abnormal</strong><small>@abnormalPct.ToString("0")% of results</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico purple"><i class="fas fa-microscope"></i></div><div><span>Test Types</span><strong>@testTypes</strong><small>Different tests</small></div></div>
    </section>

    @if (!results.Any())
    {
        <section class="rx-card rx-empty">
            <div class="rx-empty-visual">
                <div class="rx-empty-circle"><i class="fas fa-flask-vial"></i></div>
                <span class="rx-orbit o1"></span><span class="rx-orbit o2"></span>
            </div>
            <div>
                <span class="rx-label"><i class="fas fa-info-circle"></i> No results available</span>
                <h2>Your laboratory results will appear here</h2>
                <p>You don't have any released results on your patient record yet. Once a test is completed and released, it appears on this page automatically.</p>
                <div class="rx-steps"><span><b>01</b>Test requested</span><i></i><span><b>02</b>Sample processed</span><i></i><span><b>03</b>Result released</span></div>
            </div>
        </section>
    }
    else
    {
        <div class="rx-tabs">
            <button class="rx-tab active" type="button" onclick="switchTab(this,'rx-all')"><i class="fas fa-list"></i> All results</button>
            <button class="rx-tab" type="button" onclick="switchTab(this,'rx-analytics')"><i class="fas fa-chart-line"></i> Health analytics</button>
        </div>

        <!-- ================= ALL RESULTS ================= -->
        <div id="rx-all">

            <div class="rx-card rxf" id="rxFilter">
                <div class="rxf-top">
                    <div class="rxf-search"><i class="fas fa-magnifying-glass"></i><input id="rxfQ" type="search" placeholder="Search test, doctor, request or note" autocomplete="off"></div>
                    @if (filterTests.Count > 1)
                    {
                        <select id="rxfTest" class="rx-sel"><option value="">All tests</option>@foreach (var t in filterTests) {
                            <option value="@t">@t</option>
                        }
                    </select>
                }
                @if (filterDoctors.Count > 1)
                {
                    <select id="rxfDoctor" class="rx-sel"><option value="">All doctors</option>@foreach (var d in filterDoctors) {
                        <option value="@d">@d</option>
                    }
                </select>
            }
            @if (filterCats.Count > 1)
            {
                <select id="rxfCat" class="rx-sel"><option value="">All categories</option>@foreach (var c in filterCats) {
                    <option value="@c">@c</option>
                }
            </select>
        }
    </div>
    <div class="rxf-bottom">
        <div class="rxf-group">
            <button type="button" class="rxf-btn active" data-status="all">All (@total)</button>
            <button type="button" class="rxf-btn" data-status="ok">Normal (@normal)</button>
            <button type="button" class="rxf-btn" data-status="abn">Needs attention (@abnormal)</button>
        </div>
        <div class="rxf-group">
            <button type="button" class="rxf-btn active" data-days="0">All time</button>
            <button type="button" class="rxf-btn" data-days="30">30 days</button>
            <button type="button" class="rxf-btn" data-days="180">6 months</button>
            <button type="button" class="rxf-btn" data-days="365">Year</button>
            <label>From <input type="date" id="rxfFrom"></label>
            <label>To <input type="date" id="rxfTo"></label>
        </div>
        <div class="rxf-meta"><span id="rxfCount"></span><button type="button" id="rxfClear" class="rxf-clear" hidden>Clear filters</button></div>
    </div>
</div>

<div class="rx-card rxf-none" id="rxfNone" hidden>
    <i class="fas fa-filter-circle-xmark"></i>
    <strong>No results match your filters</strong>
    <span>Try a different date range or clear the filters to see everything.</span>
</div>
@foreach (var group in results.GroupBy(r => r.RequestID).OrderByDescending(g => g.Key))
{
    var first = group.First();
    var reqDoctor = group.Select(r => r.DoctorName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
    var reqDate = group.Where(r => r.ResultDate != default(DateTime)).Select(r => r.ResultDate).DefaultIfEmpty().Max();

    <article class="rx-card rx-panel">
        <div class="rx-ph">
            <div class="rx-ph-left">
                <div class="rx-ph-icon"><i class="fas fa-flask"></i></div>
                <div>
                    <small>Laboratory request</small>
                    <h3>#@group.Key @(string.IsNullOrWhiteSpace(first.Category) ? "" : "· " + first.Category)</h3>
                    <div class="rx-ph-meta">
                        <span><i class="fas fa-calendar-day"></i>@(reqDate != default(DateTime) ? reqDate.ToString("dd MMM yyyy") : "Date not recorded")</span>
                        <span><i class="fas fa-user-doctor"></i>@Doctor(reqDoctor)</span>
                        <span><i class="fas fa-vials"></i><span class="rx-tc">@group.Count() @(group.Count() == 1 ? "test" : "tests")</span></span>
                    </div>
                </div>
            </div>
            <div class="rxl-chips">
                <span class="rxl-chip">@(group.Count(x => !x.IsAbnormal)) normal</span>
                @if (group.Any(x => x.IsAbnormal))
                {
                    <span class="rxl-chip abn">@(group.Count(x => x.IsAbnormal)) need attention</span>
                }
                <span class="rx-badge"><i class="fas fa-circle-check"></i> Released</span>
            </div>
        </div>

        <div class="rxl">
            <div class="rxl-head"><span>Test</span><span>Result</span><span>Reference range</span><span>Status</span></div>

            @foreach (var r in group)
            {
                double lo = 0, hi = 0, val = 0;
                var hasVal = TryNum(r.ResultValue, out val);
                var canGauge = hasVal && TryRange(r.NormalRange, out lo, out hi);
                double bandStart = 0, bandWidth = 0, marker = 50;
                var pos = "";
                if (canGauge)
                {
                    var span = hi - lo;
                    var pLo = lo - span * .4;
                    var pSpan = span * 1.8;
                    bandStart = (lo - pLo) / pSpan * 100;
                    bandWidth = span / pSpan * 100;
                    marker = Math.Clamp((val - pLo) / pSpan * 100, 2, 98);
                    pos = val < lo ? "Below range" : val > hi ? "Above range" : "Within range";
                }
                var unset = string.IsNullOrWhiteSpace(r.NormalRange)
                    || Regex.IsMatch(r.NormalRange, @"^\s*0+([.,]0+)?\s*(-|–|to)\s*0+([.,]0+)?(?![\d.,])");
                var refText = unset ? "No reference range" : r.NormalRange.Trim();
                if (!unset && !string.IsNullOrWhiteSpace(r.Unit)
                    && refText.IndexOf(r.Unit.Trim(), StringComparison.OrdinalIgnoreCase) < 0)
                {
                    refText += " " + r.Unit.Trim();
                }
                var cls = r.IsAbnormal ? "abn" : "ok";
                var note = r.TechnicianNotes?.Trim();
                var noDoc = string.IsNullOrWhiteSpace(r.DoctorName);
                var when = r.ResultDate == default(DateTime)
                    ? "Not recorded"
                    : r.ResultDate.ToString(r.ResultDate.TimeOfDay == TimeSpan.Zero ? "dd MMM yyyy" : "dd MMM yyyy, HH:mm");
                var dateKey = r.ResultDate == default(DateTime) ? "" : r.ResultDate.ToString("yyyy-MM-dd");
                var docLabel = Doctor(r.DoctorName);
                var searchKey = string.Join(" ", new[] { r.TestName, r.RequestID.ToString(), r.Category, r.TechnicianNotes, docLabel }).ToLowerInvariant();

                <div class="rxl-row @cls" data-status="@cls" data-test="@r.TestName" data-doctor="@docLabel" data-cat="@r.Category" data-date="@dateKey" data-search="@searchKey">
                    <div class="rxl-main">
                        <div class="rxl-name">
                            <span class="rxl-ico"><i class="fas fa-vial"></i></span>
                            <strong>@r.TestName</strong>
                        </div>
                        <div class="rxl-val"><b>@r.ResultValue</b><span>@r.Unit</span></div>
                        <div class="rxl-range">
                            <div class="rxl-line @(canGauge ? "" : "flat")">
                                @if (canGauge)
                                {
                                    <div class="rxl-band" style="left:@F(bandStart)%;width:@F(bandWidth)%"></div>
                                    <div class="rxl-mark" style="left:@F(marker)%"></div>
                                }
                            </div>
                            <small><span>@refText</span>@if (pos != "") {
                                <b>@pos</b>
                            }
                        </small>
                    </div>
                    <div class="rxl-st">
                        @if (r.IsAbnormal)
                        {
                            <span class="rx-badge abn"><i class="fas fa-triangle-exclamation"></i> Abnormal</span>
                        }
                        else
                        {

                            <span class="rx-badge"><i class="fas fa-check"></i> Normal</span>
                        }
                    </div>
                </div>

                <div class="rxl-meta">
                    <div><small>Date performed</small><span><i class="fas fa-calendar-day"></i>@when</span></div>
                    <div><small>Doctor</small><span class="@(noDoc ? "none" : "")"><i class="fas fa-user-doctor"></i>@Doctor(r.DoctorName)</span></div>
                    <div class="rxl-note"><small>Technician note</small><span class="@(string.IsNullOrWhiteSpace(note) ? "none" : "")"><i class="fas fa-note-sticky"></i>@(string.IsNullOrWhiteSpace(note) ? "No note recorded for this test" : note)</span></div>
                </div>
            </div>
        }
    </div>

    <div class="rx-pf">
        <span><i class="fas fa-clock"></i> Laboratory report</span>
        <button type="button" class="rx-btn" onclick="window.print()"><i class="fas fa-print"></i> Print report</button>
    </div>
</article>
            }
</div>

<!-- ================= ANALYTICS ================= -->
<div id="rx-analytics" style="display:none">

    <section class="rx-card rx-intro">
        <div>
            <small><i class="fas fa-chart-line"></i> Results overview</small>
            <h2>Your results at a glance</h2>
            <p>A summary of the laboratory information currently on your patient record.</p>
        </div>
        <div class="rx-intro-num"><strong>@total</strong><span>Total values</span></div>
    </section>

    <div class="rx-grid2">
        <div class="rx-card rx-chart">
            <div class="rx-chart-h"><div><small>Result status</small><h3>Normal vs attention</h3></div><i class="fas fa-chart-pie"></i></div>
            <div class="rx-donut-area">
                <div class="rx-donut" style="background:conic-gradient(#2E8B57 0deg @(normalDeg)deg, #B0463F @(normalDeg)deg 360deg)">
                    <div class="rx-donut-in"><strong>@normalPct.ToString("0")%</strong><span>Normal</span></div>
                </div>
                <div class="rx-legend">
                    <div><span class="rx-dot" style="background:#2E8B57"></span>Normal<strong>@normal</strong></div>
                    <div><span class="rx-dot" style="background:#B0463F"></span>Attention<strong>@abnormal</strong></div>
                </div>
            </div>
        </div>

        <div class="rx-card rx-chart">
            <div class="rx-chart-h"><div><small>Laboratory activity</small><h3>Tests performed</h3></div><i class="fas fa-vials"></i></div>
            @foreach (var t in topTests)
            {
                <div class="rx-bar">
                    <div><span>@t.Key</span><strong>@t.Count()</strong></div>
                    <div class="rx-track"><div class="rx-fill" style="width:@F((double)t.Count() / total * 100)%"></div></div>
                </div>
            }
        </div>
    </div>

    <div class="rx-card rx-trend">
        <div class="rx-thead">
            <div class="rx-thead-l"><div class="rx-thead-ico"><i class="fas fa-wave-square"></i></div><div><h3>Result trend</h3><p>Track repeated numeric measurements for the same test.</p></div></div>
            @if (series.Any())
            {
                <select id="trendSel" class="rx-sel" onchange="drawTrend()">
                    @foreach (var s in series)
                    {
                        <option value="@s.Key">@s.Key (@s.Count())</option>
                    }
                </select>
            }
        </div>

        @if (!series.Any())
        {
            <div class="rx-graph-empty">A trend appears once numeric measurements are recorded.</div>
        }
        else
        {
            <div class="rx-ranges">
                <button type="button" class="rx-pill active" data-days="0">All time</button>
                <button type="button" class="rx-pill" data-days="7">7 days</button>
                <button type="button" class="rx-pill" data-days="30">Month</button>
                <button type="button" class="rx-pill" data-days="180">6 months</button>
                <button type="button" class="rx-pill" data-days="365">Year</button>
            </div>
            <div class="rx-sum">
                <div><small>Latest</small><b id="sLatest">—</b></div>
                <div><small>Average</small><b id="sAvg">—</b></div>
                <div><small>Range</small><b id="sRange">—</b></div>
                <div><small>Direction</small><b id="sDir">—</b></div>
            </div>
            <div class="rx-graph"><div id="trendBox"></div></div>
            <div class="rx-insight">
                <i class="fas fa-lightbulb"></i>
                <div><strong id="insTitle">—</strong><span id="insText"></span></div>
            </div>
        }
    </div>

    <div class="rx-insight">
        <i class="fas fa-circle-info"></i>
        <div><strong>About your analytics</strong>These charts describe your recorded data statistically. A trend is not a diagnosis; discuss changes with your doctor.</div>
    </div>
</div>
    }

<footer class="rx-footer"><i class="fas fa-shield-halved"></i> Laboratory Information Management System · Patient Portal · @DateTime.Now.Year</footer>
</div>

@section Scripts {
    <script>
        var T = @Html.Raw(trendJson);
        var days = 0;

        function switchTab(btn, id) {
            document.querySelectorAll('.rx-tab').forEach(function(t) { t.classList.remove('active'); });
            btn.classList.add('active');
            document.getElementById('rx-all').style.display = id === 'rx-all' ? '' : 'none';
            document.getElementById('rx-analytics').style.display = id === 'rx-analytics' ? '' : 'none';
            if (id === 'rx-analytics') drawTrend();
        }

        document.querySelectorAll('.rx-pill').forEach(function(b) {
            b.addEventListener('click', function() {
                document.querySelectorAll('.rx-pill').forEach(function(x) { x.classList.remove('active'); });
                b.classList.add('active');
                days = parseInt(b.dataset.days, 10) || 0;
                drawTrend();
            });
        });

        /* ===== Filters (All results tab) ===== */
        var FLT = { status: 'all', test: '', doctor: '', cat: '', q: '', days: 0, from: '', to: '' };

        function applyFilters() {
            var cutoff = FLT.days ? new Date(Date.now() - FLT.days * 864e5).toISOString().slice(0, 10) : '';
            var from = FLT.from || cutoff, to = FLT.to;
            var shown = 0, all = 0;

            document.querySelectorAll('#rx-all .rx-panel').forEach(function(panel) {
                var rows = panel.querySelectorAll('.rxl-row'), vis = 0;
                rows.forEach(function(r) {
                    var d = r.dataset, ok = true;
                    if (FLT.status !== 'all' && d.status !== FLT.status) ok = false;
                    if (ok && FLT.test && d.test !== FLT.test) ok = false;
                    if (ok && FLT.doctor && d.doctor !== FLT.doctor) ok = false;
                    if (ok && FLT.cat && d.cat !== FLT.cat) ok = false;
                    if (ok && FLT.q && d.search.indexOf(FLT.q) < 0) ok = false;
                    if (ok && (from || to)) {
                        if (!d.date) ok = false;
                        else if ((from && d.date < from) || (to && d.date > to)) ok = false;
                    }
                    r.style.display = ok ? '' : 'none';
                    if (ok) vis++;
                });
                panel.style.display = vis ? '' : 'none';
                var tc = panel.querySelector('.rx-tc');
                if (tc) {
                    var nAll = rows.length;
                    tc.textContent = vis === nAll ? nAll + (nAll === 1 ? ' test' : ' tests') : vis + ' of ' + nAll + ' tests';
                }
                shown += vis; all += rows.length;
            });

            var active = FLT.status !== 'all' || FLT.test || FLT.doctor || FLT.cat || FLT.q || FLT.days || FLT.from || FLT.to;
            document.getElementById('rxfCount').textContent = 'Showing ' + shown + ' of ' + all + ' results';
            document.getElementById('rxfClear').hidden = !active;
            document.getElementById('rxfNone').hidden = shown !== 0;
        }

        (function() {
            var bar = document.getElementById('rxFilter');
            if (!bar) return;

            function mark(attr, btn) {
                bar.querySelectorAll('.rxf-btn[' + attr + ']').forEach(function(b) { b.classList.toggle('active', b === btn); });
            }

            bar.addEventListener('click', function(e) {
                var b = e.target.closest('.rxf-btn');
                if (b) {
                    if (b.hasAttribute('data-status')) { FLT.status = b.dataset.status; mark('data-status', b); }
                    else {
                        FLT.days = parseInt(b.dataset.days, 10) || 0; FLT.from = FLT.to = '';
                        document.getElementById('rxfFrom').value = ''; document.getElementById('rxfTo').value = '';
                        mark('data-days', b);
                    }
                    applyFilters();
                }
                if (e.target.id === 'rxfClear') {
                    FLT = { status: 'all', test: '', doctor: '', cat: '', q: '', days: 0, from: '', to: '' };
                    bar.querySelectorAll('input, select').forEach(function(el) { el.value = ''; });
                    mark('data-status', bar.querySelector('[data-status="all"]'));
                    mark('data-days', bar.querySelector('[data-days="0"]'));
                    applyFilters();
                }
            });

            bar.addEventListener('input', function(e) {
                var t = e.target, id = t.id;
                if (id === 'rxfQ') FLT.q = t.value.trim().toLowerCase();
                else if (id === 'rxfTest') FLT.test = t.value;
                else if (id === 'rxfDoctor') FLT.doctor = t.value;
                else if (id === 'rxfCat') FLT.cat = t.value;
                else if (id === 'rxfFrom' || id === 'rxfTo') {
                    FLT.from = document.getElementById('rxfFrom').value;
                    FLT.to = document.getElementById('rxfTo').value;
                    FLT.days = 0; mark('data-days', null);
                } else return;
                applyFilters();
            });

            applyFilters();
        })();
        function n(v) { return String(Math.round(v * 100) / 100); }
        function set(id, txt) { document.getElementById(id).textContent = txt; }

        function drawTrend() {
            var sel = document.getElementById('trendSel');
            if (!sel) return;
            var cutoff = Date.now() - days * 864e5;
            var pts = (T[sel.value] || []).filter(function(p) {
                return !days || !p.d || new Date(p.d).getTime() >= cutoff;
            });
            var box = document.getElementById('trendBox');
            var dir = document.getElementById('sDir');

            if (pts.length < 2) {
                box.innerHTML = '<div class="rx-graph-empty">Not enough results in this period to draw a trend.</div>';
                ['sLatest', 'sAvg', 'sRange'].forEach(function(i) { set(i, '—'); });
                dir.className = ''; dir.textContent = '—';
                set('insTitle', 'Not enough data');
                set('insText', 'A trend needs at least two measurements of the same test.');
                return;
            }

            var vals = pts.map(function(p) { return p.v; });
            var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);
            var avg = vals.reduce(function(a, b) { return a + b; }, 0) / vals.length;
            var diff = vals[vals.length - 1] - vals[0];
            var tol = Math.max(Math.abs(avg) * 0.02, 1e-6);
            var d = diff > tol ? 'up' : diff < -tol ? 'down' : 'stable';
            var label = { up: 'Trending upward', down: 'Trending downward', stable: 'Stable' }[d];
            var text = {
                up: 'The latest value is higher than the first value in this period.',
                down: 'The latest value is lower than the first value in this period.',
                stable: 'The first and latest values are close, so this series is stable.'
            }[d];

            set('sLatest', n(vals[vals.length - 1])); set('sAvg', n(avg)); set('sRange', n(min) + ' – ' + n(max));
            dir.className = d; dir.textContent = label;
            set('insTitle', label); set('insText', text);

            // Chart geometry
            var W = 900, H = 340, L = 50, R = 20, Tp = 20, B = 40, gw = W - L - R, gh = H - Tp - B;
            var ref = pts[0].lo != null ? { lo: pts[0].lo, hi: pts[0].hi } : null;
            var lo = min, hi = max, pad = (max - min || Math.abs(max) * 0.1 || 1) * 0.18;
            lo -= pad; hi += pad;
            if (ref) { lo = Math.min(lo, ref.lo); hi = Math.max(hi, ref.hi); }
            var X = function(i) { return L + i / (pts.length - 1) * gw; };
            var Y = function(v) { return Tp + (hi - v) / (hi - lo) * gh; };

            var s = '<svg viewBox="0 0 ' + W + ' ' + H + '">';
            for (var g = 0; g <= 5; g++) {
                var gy = Tp + g / 5 * gh;
                s += '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + gy + '" y2="' + gy + '" stroke="#E5EFED"/>' +
                    '<text x="' + (L - 8) + '" y="' + (gy + 3) + '" text-anchor="end">' + n(hi - g / 5 * (hi - lo)) + '</text>';
            }
            if (ref) {
                s += '<rect x="' + L + '" y="' + Y(ref.hi) + '" width="' + gw + '" height="' + (Y(ref.lo) - Y(ref.hi)) + '" fill="rgba(46,139,87,.10)"/>' +
                    '<text x="' + (L + 6) + '" y="' + (Y(ref.hi) + 12) + '" style="fill:#2E8B57">Normal range ' + n(ref.lo) + '–' + n(ref.hi) + '</text>';
            }
            s += '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + Y(max) + '" y2="' + Y(max) + '" stroke="#B0463F" stroke-dasharray="6 4"/>' +
                '<line x1="' + L + '" x2="' + (W - R) + '" y1="' + Y(min) + '" y2="' + Y(min) + '" stroke="#2B7FD1" stroke-dasharray="6 4"/>' +
                '<text x="' + (W - R - 4) + '" y="' + (Y(max) - 5) + '" text-anchor="end" style="fill:#B0463F">Max ' + n(max) + '</text>' +
                '<text x="' + (W - R - 4) + '" y="' + (Y(min) + (max === min ? -5 : 13)) + '" text-anchor="end" style="fill:#2B7FD1">Min ' + n(min) + '</text>';

            var line = pts.map(function(p, i) { return (i ? 'L' : 'M') + X(i) + ' ' + Y(p.v); }).join(' ');
            s += '<path d="' + line + ' L' + X(pts.length - 1) + ' ' + (Tp + gh) + ' L' + X(0) + ' ' + (Tp + gh) + ' Z" fill="rgba(14,140,127,.08)"/>' +
                '<path d="' + line + '" fill="none" stroke="#0E8C7F" stroke-width="3" stroke-linejoin="round"/>';

            pts.forEach(function(p, i) {
                s += '<circle cx="' + X(i) + '" cy="' + Y(p.v) + '" r="5.5" fill="#fff" stroke="' + (p.a ? '#B0463F' : '#0E8C7F') + '" stroke-width="3">' +
                    '<title>' + n(p.v) + ' · ' + (p.d || 'no date') + ' · Request #' + p.r + ' · ' + (p.a ? 'Attention' : 'Normal') + '</title></circle>';
            });

            var idx = pts.length <= 6 ? pts.map(function(_, i) { return i; }) : [0, Math.floor((pts.length - 1) / 2), pts.length - 1];
            idx.forEach(function(i) {
                s += '<text x="' + X(i) + '" y="' + (H - 12) + '" text-anchor="middle">' + (pts[i].d || 'Req #' + pts[i].r) + '</text>';
            });

            box.innerHTML = s + '</svg>';
        }

        window.addEventListener('resize', function() {
            if (document.getElementById('rx-analytics').style.display !== 'none') drawTrend();
        });
    </script>
}
