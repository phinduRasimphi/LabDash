            transform: translateY(-3px);
            box-shadow: 0 15px 32px rgba(10,60,55,.12);
        }

    .rx-ico {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 20px;
    }

        .rx-ico.teal {
            color: var(--teal);
            background: var(--tl);
        }

        .rx-ico.green {
            color: var(--green);
            background: var(--gl);
        }

        .rx-ico.red {
            color: var(--red);
            background: var(--rl);
        }

        .rx-ico.purple {
            color: var(--purple);
            background: var(--pl);
        }

    .rx-stat span {
        display: block;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--soft);
    }

    .rx-stat strong {
        display: block;
        margin-top: 2px;
        font: 700 28px/1.1 'Poppins',sans-serif;
    }

    .rx-stat small {
        display: block;
        margin-top: 3px;
        font-size: 11.5px;
        color: var(--faint);
    }

    /* Empty state */
    .rx-empty {
        display: flex;
        align-items: center;
        gap: 56px;
        padding: 56px;
    }

    .rx-empty-visual {
        position: relative;
        width: 200px;
        height: 200px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .rx-empty-circle {
        width: 120px;
        height: 120px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        font-size: 38px;
        color: var(--teal);
        background: var(--tl);
        box-shadow: 0 0 0 14px rgba(14,140,127,.05),0 0 0 28px rgba(14,140,127,.025);
    }

    .rx-orbit {
        position: absolute;
        border: 1px dashed var(--line2);
        border-radius: 50%;
    }

        .rx-orbit.o1 {
            width: 160px;
            height: 160px;
            animation: rxRotate 12s linear infinite;
        }

        .rx-orbit.o2 {
            width: 195px;
            height: 195px;
            animation: rxRotate 18s linear infinite reverse;
        }

    .rx-empty h2 {
        font-size: 25px;
        margin: 12px 0 8px;
    }

    .rx-empty p {
        margin: 0;
        max-width: 600px;
        font-size: 14px;
        line-height: 1.65;
        color: var(--soft);
    }

    .rx-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .05em;
        text-transform: uppercase;
        color: var(--deep);
        background: var(--tl);
    }

    .rx-steps {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
        margin-top: 26px;
        font-size: 12px;
        font-weight: 600;
        color: var(--soft);
    }

        .rx-steps b {
            width: 30px;
            height: 30px;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            margin-right: 8px;
            border-radius: 9px;
            font-size: 11px;
            color: var(--teal);
            background: var(--tl);
        }

        .rx-steps i {
            width: 36px;
            height: 1px;
            background: var(--line2);
        }

    /* Tabs */
    .rx-tabs {
        display: flex;
        width: fit-content;
        gap: 5px;
        padding: 6px;
        margin-bottom: 22px;
        border-radius: 999px;
        background: #fff;
        box-shadow: 0 8px 28px rgba(10,60,55,.08);
    }

    .rx-tab, .rx-pill {
        border: none;
        border-radius: 999px;
        font-family: 'Inter',sans-serif;
        font-weight: 600;
        color: var(--soft);
        background: transparent;
        cursor: pointer;
    }

    .rx-tab {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 12px 24px;
        font-size: 14px;
    }

        .rx-tab.active, .rx-pill.active {
            color: #fff;
            background: linear-gradient(120deg,var(--g1),var(--g2));
            box-shadow: 0 6px 15px rgba(10,90,80,.2);
        }

    /* Request panel */
    .rx-panel {
        margin-bottom: 24px;
        overflow: hidden;
    }

    .rx-ph {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 24px 28px;
        border-bottom: 1px solid var(--line);
        background: linear-gradient(180deg,#F6FBFA,#fff);
    }

    .rx-ph-left {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .rx-ph-icon {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        font-size: 19px;
        color: var(--teal);
        background: var(--tl);
    }

    .rx-ph small {
        display: block;
        margin-bottom: 3px;
        font-size: 11px;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--faint);
    }

    .rx-ph h3 {
        font-size: 19px;
    }

    .rx-ph-meta {
        display: flex;
        flex-wrap: wrap;
        gap: 6px 20px;
        margin-top: 8px;
        font-size: 13px;
        color: var(--soft);
    }

        .rx-ph-meta i {
            margin-right: 7px;
            color: var(--teal);
        }
    /* Test ledger (request rows) */
    .rxl-chips {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    .rxl-chip {
        padding: 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        color: var(--green);
        background: var(--gl);
    }

        .rxl-chip.abn {
            color: var(--red);
            background: var(--rl);
        }

    .rxl-head, .rxl-main {
        display: grid;
        grid-template-columns: minmax(190px,1.4fr) minmax(120px,.8fr) minmax(220px,1.7fr) 120px;
        gap: 22px;
        align-items: center;
    }

    .rxl-head {
        padding: 14px 28px 14px 34px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .06em;
        text-transform: uppercase;
        color: var(--faint);
        background: #F6FAF9;
        border-bottom: 1px solid var(--line);
    }

    .rxl-row {
        position: relative;
        padding: 22px 28px 22px 34px;
        border-bottom: 1px solid var(--line);
        transition: background .15s ease;
    }

        .rxl-row:last-child {
            border-bottom: none;
        }

        .rxl-row::before {
            content: "";
            position: absolute;
            left: 0;
            top: 0;
            bottom: 0;
            width: 5px;
            background: var(--green);
        }

        .rxl-row.abn::before {
            background: var(--red);
        }

        .rxl-row.abn {
            background: #FFF9F8;
        }

        .rxl-row:hover {
            background: #F6FBFA;
        }

        .rxl-row.abn:hover {
            background: #FFF3F1;
        }

    .rxl-name {
        display: flex;
        align-items: center;
        gap: 14px;
        min-width: 0;
    }

    .rxl-ico {
        width: 46px;
        height: 46px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 17px;
        color: var(--teal);
        background: var(--tl);
    }

    .rxl-row.abn .rxl-ico {
        color: var(--red);
        background: var(--rl);
    }

    .rxl-name strong {
        font-size: 16.5px;
        line-height: 1.3;
    }

    .rxl-val b {
        font: 600 27px/1 'IBM Plex Mono',monospace;
        color: var(--deep);
        word-break: break-word;
    }

    .rxl-row.abn .rxl-val b {
        color: var(--red);
    }

    .rxl-val span {
        margin-left: 7px;
        font-size: 13px;
        color: var(--faint);
    }

    .rxl-line {
        position: relative;
        height: 9px;
        margin: 4px 0 10px;
        border-radius: 999px;
        background: var(--line2);
    }

        .rxl-line.flat {
            background: #BFE3D8;
        }

    .rxl-row.abn .rxl-line.flat {
        background: #EBC3BF;
    }

    .rxl-band {
        position: absolute;
        top: 0;
        height: 100%;
        border-radius: 999px;
        background: #8FD3BF;
    }

    .rxl-mark {
        position: absolute;
        top: 50%;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        transform: translate(-50%,-50%);
        background: var(--teal);
        border: 4px solid #fff;
        box-shadow: 0 0 0 1px var(--teal),0 2px 6px rgba(0,0,0,.15);
    }

    .rxl-row.abn .rxl-mark {
        background: var(--red);
        box-shadow: 0 0 0 1px var(--red),0 2px 6px rgba(0,0,0,.15);
    }

    .rxl-range small {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 12.5px;
        color: var(--soft);
    }

        .rxl-range small b {
            color: var(--green);
        }

    .rxl-row.abn .rxl-range small b {
        color: var(--red);
    }

    .rxl-meta {
        display: grid;
        grid-template-columns: 190px 250px 1fr;
        gap: 14px 24px;
        margin-top: 16px;
        padding: 15px 20px;
        border-radius: 14px;
        background: #F3F9F8;
    }

        .rxl-meta small {
            display: block;
            margin-bottom: 5px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .rxl-meta span {
            display: flex;
            align-items: flex-start;
            gap: 9px;
            font-size: 13.5px;
            font-weight: 600;
            line-height: 1.5;
            color: var(--ink);
        }

        .rxl-meta i {
            margin-top: 4px;
            font-size: 12px;
            color: var(--teal);
        }

        .rxl-meta .none {
            font-weight: 500;
            font-style: italic;
            color: var(--faint);
        }

    .rxl-note i {
        color: var(--purple);
    }

    .rxl-note span {
        font-weight: 500;
        color: var(--soft);
    }

    .rx-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 8px 13px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        white-space: nowrap;
        color: var(--green);
        background: var(--gl);
    }

        .rx-badge.abn {
            color: var(--red);
            background: var(--rl);
        }

    @@media (max-width:1000px) {
        .rxl-head {
            display: none;
        }

        .rxl-main {
            grid-template-columns: 1fr auto;
            gap: 14px;
        }

        .rxl-name {
            order: 1;
        }

        .rxl-st {
            order: 2;
        }

        .rxl-val {
            order: 3;
        }

        .rxl-range {
            order: 4;
            grid-column: 1/-1;
        }

        .rxl-meta {
            grid-template-columns: 1fr 1fr;
        }

        .rxl-note {
            grid-column: 1/-1;
        }
    }

    @@media (max-width:600px) {
        .rxl-row {
            padding: 18px 16px 18px 24px;
        }

        .rxl-meta {
            grid-template-columns: 1fr;
        }
    }

    .rx-pf {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 16px 28px;
        font-size: 12px;
        color: var(--faint);
        background: #F0F7F6;
        border-top: 1px solid var(--line);
    }

    .rx-btn {
        padding: 10px 18px;
        border: 1px solid var(--line2);
        border-radius: 999px;
        font: 600 12.5px 'Inter',sans-serif;
        color: var(--deep);
        background: #fff;
        cursor: pointer;
    }

        .rx-btn:hover {
            background: var(--tl);
            border-color: var(--teal);
        }

    /* Link-style button (Download PDF / back links) */
    a.rx-btn {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        text-decoration: none;
    }

    /* Analytics */
    .rx-intro {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 28px 30px;
        margin-bottom: 18px;
    }

        .rx-intro small {
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--teal);
        }

        .rx-intro h2 {
            margin: 6px 0 4px;
            font-size: 22px;
        }

        .rx-intro p {
            margin: 0;
            font-size: 13.5px;
            color: var(--soft);
        }

    .rx-intro-num {
        padding-left: 28px;
        border-left: 1px solid var(--line);
        text-align: center;
    }

        .rx-intro-num strong {
            display: block;
            font: 700 32px 'Poppins',sans-serif;
            color: var(--deep);
        }

        .rx-intro-num span {
            font-size: 11px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--faint);
        }

    .rx-grid2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 18px;
        margin-bottom: 18px;
    }

    .rx-chart {
        padding: 28px;
    }

    .rx-chart-h {
        display: flex;
        justify-content: space-between;
        align-items: flex-start;
        margin-bottom: 24px;
    }

        .rx-chart-h small {
            font-size: 11px;
            letter-spacing: .05em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .rx-chart-h h3 {
            margin-top: 4px;
            font-size: 18px;
        }

        .rx-chart-h > i {
            font-size: 19px;
            color: var(--teal);
        }

    .rx-donut-area {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 40px;
        min-height: 210px;
    }

    .rx-donut {
        width: 176px;
        height: 176px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: var(--line);
    }

    .rx-donut-in {
        width: 128px;
        height: 128px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff;
    }

        .rx-donut-in strong {
            font: 700 28px 'Poppins',sans-serif;
        }

        .rx-donut-in span {
            font-size: 11px;
            letter-spacing: .04em;
            text-transform: uppercase;
            color: var(--faint);
        }

    .rx-legend div {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        font-size: 14px;
    }

    .rx-legend strong {
        margin-left: auto;
        padding-left: 20px;
        font-family: 'IBM Plex Mono',monospace;
    }

    .rx-dot {
        width: 11px;
        height: 11px;
        border-radius: 50%;
    }

    .rx-bar {
        margin-bottom: 20px;
        font-size: 13px;
    }

        .rx-bar > div:first-child {
            display: flex;
            justify-content: space-between;
            gap: 12px;
            margin-bottom: 8px;
            color: var(--soft);
        }

        .rx-bar span {
            overflow: hidden;
            white-space: nowrap;
            text-overflow: ellipsis;
            max-width: 80%;
        }

    .rx-track {
        height: 10px;
        border-radius: 999px;
        background: var(--line);
        overflow: hidden;
    }

    .rx-fill {
        height: 100%;
        min-width: 2px;
        border-radius: 999px;
        background: linear-gradient(90deg,var(--g1),var(--g2));
    }

    .rx-trend {
        padding: 28px;
        margin-bottom: 18px;
    }

    .rx-thead {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 20px;
    }

    .rx-thead-l {
        display: flex;
        align-items: center;
        gap: 14px;
    }

    .rx-thead-ico {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 18px;
        color: var(--purple);
        background: var(--pl);
    }

    .rx-thead h3 {
        font-size: 19px;
    }

    .rx-thead p {
        margin: 4px 0 0;
        font-size: 12.5px;
        color: var(--faint);
    }

    .rx-sel {
        min-width: 240px;
        padding: 12px 14px;
        border: 1px solid var(--line2);
        border-radius: 12px;
        font: 13.5px 'Inter',sans-serif;
        color: var(--ink);
        background: #fff;
    }

    .rx-ranges {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 18px;
    }

    .rx-pill {
        padding: 9px 16px;
        border: 1px solid var(--line2);
        background: #fff;
        font-size: 12.5px;
    }

    /* ===== Trend: date / year filter row ===== */
    .rx-tf {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 10px 16px;
        margin-bottom: 18px;
        padding: 14px 16px;
        border: 1px solid var(--line);
        border-radius: 14px;
        background: #FBFDFC;
    }

        .rx-tf label {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 12px;
            color: var(--faint);
        }

        .rx-tf select, .rx-tf input[type=date] {
            padding: 8px 10px;
            border: 1px solid var(--line2);
            border-radius: 10px;
            font: 12.5px 'Inter',sans-serif;
            color: var(--ink);
            background: #fff;
            outline: none;
        }

            .rx-tf select:focus, .rx-tf input[type=date]:focus {
                border-color: var(--teal);
                box-shadow: 0 0 0 3px rgba(14,140,127,.10);
            }

    .rx-sum {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 12px;
        margin-bottom: 20px;
    }

        .rx-sum div {
            padding: 17px;
            border: 1px solid var(--line);
            border-radius: 15px;
            background: #FBFDFC;
        }

        .rx-sum small {
            display: block;
            margin-bottom: 8px;
            font-size: 11px;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: var(--faint);
        }

        .rx-sum b {
            font: 600 17px 'IBM Plex Mono',monospace;
        }

            .rx-sum b.up {
                color: var(--red);
            }

            .rx-sum b.down {
                color: var(--teal);
            }

            .rx-sum b.stable {
                color: var(--soft);
            }

    .rx-graph {
        padding: 18px;
        border: 1px solid var(--line);
        border-radius: 16px;
        background: linear-gradient(180deg,#FCFEFD,#F8FBFA);
    }

        .rx-graph svg {
            width: 100%;
            height: auto;
            display: block;
        }

        .rx-graph text {
            font: 11px 'IBM Plex Mono',monospace;
            fill: var(--faint);
        }

    .rx-graph-empty {
        padding: 60px 20px;
        text-align: center;
        font-size: 14px;
        color: var(--faint);
    }

    .rx-insight {
        display: flex;
        gap: 14px;
        margin-top: 18px;
        padding: 18px 20px;
        border-radius: 15px;
        border: 1px solid var(--line2);
        background: var(--tl);
        font-size: 13px;
        color: var(--soft);
        line-height: 1.6;
    }

        .rx-insight i {
            margin-top: 3px;
            color: var(--teal);
        }

        .rx-insight strong {
            display: block;
            margin-bottom: 2px;
            font-size: 14px;
            color: var(--deep);
        }

    .rx-footer {
        margin-top: 40px;
        padding-top: 22px;
        text-align: center;
        border-top: 1px solid var(--line);
        font-size: 12px;
        color: var(--faint);
    }

        .rx-footer i {
            margin-right: 6px;
            color: var(--teal);
        }

    /* Filters */
    .rxf {
        padding: 22px 24px;
        margin-bottom: 22px;
        display: grid;
        gap: 16px;
    }

    .rxf-top, .rxf-bottom {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 14px;
    }

    .rxf-search {
        position: relative;
        flex: 1 1 280px;
    }

        .rxf-search i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            font-size: 13px;
            color: var(--faint);
        }

        .rxf-search input, .rxf input[type=date] {
            padding: 12px 14px;
            border: 1px solid var(--line2);
            border-radius: 12px;
            font: 13.5px 'Inter',sans-serif;
            color: var(--ink);
            background: #fff;
            outline: none;
        }

        .rxf-search input {
            width: 100%;
            padding-left: 42px;
        }

    .rxf input:focus, .rxf select:focus {
        border-color: var(--teal);
        box-shadow: 0 0 0 3px rgba(14,140,127,.10);
    }

    .rxf .rx-sel {
        min-width: 170px;
    }

    .rxf-group {
        display: flex;
        flex-wrap: wrap;
        align-items: center;
        gap: 8px;
    }

        .rxf-group + .rxf-group {
            padding-left: 16px;
            border-left: 1px solid var(--line);
        }

    .rxf-btn {
        padding: 9px 16px;
        border: 1px solid var(--line2);
        border-radius: 999px;
        font: 600 12.5px 'Inter',sans-serif;
        color: var(--soft);
        background: #fff;
        cursor: pointer;
    }

        .rxf-btn:hover {
            border-color: var(--teal);
            color: var(--deep);
        }

        .rxf-btn.active {
            color: #fff;
            border-color: transparent;
            background: linear-gradient(120deg,var(--g1),var(--g2));
        }

    .rxf-group label {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12px;
        color: var(--faint);
    }

    .rxf input[type=date] {
        padding: 8px 10px;
        font-size: 12.5px;
    }

    .rxf-meta {
        display: flex;
        align-items: center;
        gap: 14px;
        margin-left: auto;
        font-size: 13px;
        color: var(--soft);
    }

    .rxf-clear {
        padding: 8px 14px;
        border: 1px solid var(--line2);
        border-radius: 999px;
        font: 600 12px 'Inter',sans-serif;
        color: var(--red);
        background: #fff;
        cursor: pointer;
    }

        .rxf-clear:hover {
            background: var(--rl);
        }

    .rxf-none {
        flex-direction: column;
        align-items: center;
        gap: 8px;
        padding: 48px 20px;
        margin-bottom: 22px;
        text-align: center;
        display: flex;
    }

        .rxf-none i {
            font-size: 30px;
            color: var(--teal);
        }

        .rxf-none strong {
            font-size: 16px;
        }

        .rxf-none span {
            font-size: 13px;
            color: var(--soft);
        }

        .rxf-none[hidden], .rxf-clear[hidden] {
            display: none;
        }

    @@media (max-width:800px) {
        .rxf-group + .rxf-group {
            padding-left: 0;
            border-left: none;
        }

        .rxf-meta {
            margin-left: 0;
            width: 100%;
            justify-content: space-between;
        }
    }

    @@media (max-width:1000px) {
        .rx-stats {
            grid-template-columns: repeat(2,1fr);
        }

        .rx-tests {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width:800px) {
        .rx-grid2 {
            grid-template-columns: 1fr;
        }

        .rx-hero {
            flex-direction: column;
            align-items: flex-start;
        }

        .rx-hero-right {
            width: 100%;
            justify-content: space-between;
        }

        .rx-sum {
            grid-template-columns: repeat(2,1fr);
        }

        .rx-donut-area {
            flex-direction: column;
        }

        .rx-empty {
            flex-direction: column;
            text-align: center;
            padding: 36px 24px;
        }

        .rx-steps {
            justify-content: center;
        }
    }

    @@media (max-width:600px) {
        .rx-wrap {
            padding: 20px 14px 45px;
        }

        .rx-stats {
            grid-template-columns: 1fr;
        }

        .rx-hero {
            padding: 26px 22px;
        }

            .rx-hero h1 {
                font-size: 24px;
            }

        .rx-tab {
            flex: 1;
            justify-content: center;
            padding: 12px;
        }

        .rx-tests {
            padding: 18px;
        }

        .rx-t-body {
            grid-template-columns: 1fr;
            gap: 16px;
        }

        .rx-ph {
            padding: 20px;
        }
    }

    @@media print {
        .rx-tabs, .rx-btn {
            display: none;
        }

        #rx-analytics {
            display: none !important;
        }

        #rx-all {
            display: block !important;
        }
    }

    /* ==========================================================
       GRAPH STYLES (trend line chart + all-tests bar chart)
    ========================================================== */
    .rx-wrap {
        --card: #FFFFFF;
        --blue: #2B7FD1;
    }

    .rx-graph {
        position: relative;
    }

        .rx-graph #trendBox {
            position: relative;
        }

    .g-legend {
        display: flex;
        flex-wrap: wrap;
        gap: 8px 20px;
        margin: 0 0 12px 4px;
        font-size: 12px;
        color: var(--soft);
    }

        .g-legend span {
            display: inline-flex;
            align-items: center;
            gap: 7px;
        }

    .g-sw {
        display: inline-block;
        width: 12px;
        height: 12px;
        border-radius: 4px;
    }

        .g-sw.line {
            height: 4px;
            width: 18px;
            border-radius: 4px;
            background: var(--teal);
        }

        .g-sw.band {
            background: var(--green);
            opacity: .25;
        }

        .g-sw.abn {
            border-radius: 50%;
            background: var(--red);
        }

        .g-sw.ok {
            border-radius: 50%;
            background: var(--teal);
        }

        .g-sw.above {
            background: var(--red);
        }

        .g-sw.below {
            background: var(--blue);
        }

    .g-grid {
        stroke: var(--line);
        stroke-width: 1;
        stroke-dasharray: 2 6;
    }

    .g-axis-line {
        stroke: var(--line2);
        stroke-width: 1;
    }

    .g-axis-t {
        fill: var(--faint);
        font: 11px 'IBM Plex Mono', monospace;
    }

    .g-axis-x {
        fill: var(--soft);
        font: 600 11px 'Inter', sans-serif;
    }

    .g-band {
        fill: var(--green);
        opacity: .10;
    }

    .g-band-l {
        stroke: var(--green);
        stroke-width: 1;
        stroke-dasharray: 5 5;
        opacity: .5;
    }

    .g-band-t {
        fill: var(--green);
        font: 700 10.5px 'Inter', sans-serif;
    }

    .g-stop-a {
        stop-color: var(--teal);
        stop-opacity: .34;
    }

    .g-stop-b {
        stop-color: var(--teal);
        stop-opacity: 0;
    }

    .g-shadow {
        flood-color: var(--teal);
        flood-opacity: .30;
    }

    .g-line {
        fill: none;
        stroke: var(--teal);
        stroke-width: 3.4;
        stroke-linecap: round;
        stroke-linejoin: round;
    }

        .g-line.g-draw {
            stroke-dasharray: 1;
            stroke-dashoffset: 1;
            animation: gDraw 1.1s ease forwards;
        }

    .g-area.g-fade {
        opacity: 0;
        animation: gFade .9s .35s ease forwards;
    }

    .g-dot {
        fill: var(--card);
        stroke: var(--teal);
        stroke-width: 3;
    }

        .g-dot.abn {
            stroke: var(--red);
        }

    .g-halo {
        fill: var(--teal);
        opacity: .16;
    }

        .g-halo.abn {
            fill: var(--red);
        }

    .g-tag rect {
        fill: var(--teal);
    }

    .g-tag.abn rect {
        fill: var(--red);
    }

    .g-tag text {
        fill: #fff;
        font: 700 12px 'IBM Plex Mono', monospace;
    }

    .g-tag {
        pointer-events: none;
    }

    .g-mm text {
        font: 600 11px 'IBM Plex Mono', monospace;
        paint-order: stroke;
        stroke: var(--card);
        stroke-width: 4px;
        stroke-linejoin: round;
        pointer-events: none;
    }

    .g-mm.max text {
        fill: var(--red);
    }

    .g-mm.min text {
        fill: var(--blue);
    }

    .g-cross {
        stroke: var(--line2);
        stroke-width: 1.5;
        stroke-dasharray: 4 4;
        opacity: 0;
        pointer-events: none;
    }

    .g-hover {
        fill: none;
        stroke: var(--teal);
        stroke-width: 2.5;
        opacity: 0;
        pointer-events: none;
    }

        .g-hover.abn {
            stroke: var(--red);
        }

    /* all-tests bar chart */
    .g-stripe {
        fill: var(--line);
        opacity: .28;
    }

    .g-zone {
        fill: var(--green);
        opacity: .14;
    }

    .g-ref {
        stroke: var(--teal);
        stroke-width: 1.5;
        stroke-dasharray: 6 4;
    }

    .g-ref-t {
        fill: var(--teal);
        font: 700 10.5px 'Inter', sans-serif;
    }

    .g-name {
        fill: var(--ink);
        font: 600 12.5px 'Inter', sans-serif;
    }

    .g-sub {
        fill: var(--faint);
        font: 10.5px 'IBM Plex Mono', monospace;
    }

    .g-val {
        font: 700 12px 'IBM Plex Mono', monospace;
    }

        .g-val.in {
            fill: var(--deep);
        }

        .g-val.above {
            fill: var(--red);
        }

        .g-val.below {
            fill: var(--blue);
        }

    .g-bar {
        transform-box: fill-box;
        transform-origin: left center;
    }

        .g-bar.in {
            fill: url(#gbOk);
        }

        .g-bar.above {
            fill: url(#gbAbove);
        }

        .g-bar.below {
            fill: url(#gbBelow);
        }

        .g-bar.g-grow {
            animation: gGrow .8s cubic-bezier(.2,.8,.2,1) both;
        }

    .g-rowhit {
        fill: transparent;
        cursor: pointer;
    }

    .g-rowfocus {
        fill: var(--teal);
        opacity: 0;
        pointer-events: none;
    }

    .gb-ok-a {
        stop-color: var(--g1);
    }

    .gb-ok-b {
        stop-color: var(--teal);
    }

    .gb-ab-a {
        stop-color: #E58A82;
    }

    .gb-ab-b {
        stop-color: var(--red);
    }

    .gb-be-a {
        stop-color: #6FB1EE;
    }

    .gb-be-b {
        stop-color: var(--blue);
    }

    /* tooltip */
    .g-tip {
        position: absolute;
        z-index: 6;
        min-width: 160px;
        max-width: 260px;
        padding: 11px 14px;
        border-radius: 13px;
        background: var(--card);
        border: 1px solid var(--line2);
        box-shadow: 0 14px 34px rgba(10,60,55,.20);
        pointer-events: none;
        opacity: 0;
        transform: translate(-50%, calc(-100% - 14px));
        transition: opacity .12s ease;
    }

        .g-tip.show {
            opacity: 1;
        }

        .g-tip.below {
            transform: translate(-50%, 14px);
        }

    .g-tip-d {
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: var(--faint);
    }

    .g-tip-n {
        margin-top: 2px;
        font: 700 13.5px 'Poppins', sans-serif;
        color: var(--ink);
    }

    .g-tip-v {
        margin: 2px 0 6px;
        font: 700 24px/1.1 'IBM Plex Mono', monospace;
        color: var(--ink);
    }

    .g-tip-s {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

        .g-tip-s.ok {
            color: var(--green);
            background: var(--gl);
        }

        .g-tip-s.abn {
            color: var(--red);
            background: var(--rl);
        }

        .g-tip-s.below {
            color: var(--blue);
            background: rgba(43,127,209,.14);
        }

    .g-tip-m {
        margin-top: 7px;
        font-size: 11.5px;
        line-height: 1.5;
        color: var(--soft);
    }

    @@keyframes gDraw {
        to {
            stroke-dashoffset: 0;
        }
    }

    @@keyframes gFade {
        to {
            opacity: 1;
        }
    }

    @@keyframes gGrow {
        from {
            transform: scaleX(0);
        }

        to {
            transform: scaleX(1);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .g-line.g-draw, .g-area.g-fade, .g-bar.g-grow {
            animation: none;
            stroke-dashoffset: 0;
            opacity: 1;
            transform: none;
        }
    }

    /* ==========================================================
       DARK MODE (html.rq-dark, same switch as the rest of the app)
    ========================================================== */
    html.rq-dark .rx-wrap {
        --ink: #E8EEEB;
        --soft: #A5B0AA;
        --faint: #7F8B85;
        --line: #26302B;
        --line2: #34403A;
        --teal: #2CC4BA;
        --deep: #5ED0C4;
        --tl: #12302D;
        --g1: #0F7F74;
        --g2: #0A3A35;
        --green: #5CBB82;
        --gl: #13301F;
        --red: #E1736B;
        --rl: #3A1B18;
        --purple: #B39DEB;
        --pl: #2A2142;
        --card: #172019;
        --blue: #6CB0E8;
    }

        /* surfaces that hard-code white */
        html.rq-dark .rx-wrap .rx-card {
            background: var(--card);
            border-color: var(--line);
            box-shadow: 0 8px 28px rgba(0,0,0,.40);
        }

        html.rq-dark .rx-wrap .rx-tabs {
            background: var(--card);
            box-shadow: 0 8px 28px rgba(0,0,0,.40);
        }

        html.rq-dark .rx-wrap .rx-ph {
            background: linear-gradient(180deg, #1B2620, var(--card));
        }

        html.rq-dark .rx-wrap .rxl-head {
            background: #141C18;
        }

        html.rq-dark .rx-wrap .rxl-row:hover {
            background: #1B2620;
        }

        html.rq-dark .rx-wrap .rxl-row.abn {
            background: rgba(225,115,107,.07);
        }

            html.rq-dark .rx-wrap .rxl-row.abn:hover {
                background: rgba(225,115,107,.12);
            }

        html.rq-dark .rx-wrap .rxl-meta {
            background: #141C18;
        }

        html.rq-dark .rx-wrap .rxl-line.flat {
            background: #1F4A40;
        }

        html.rq-dark .rx-wrap .rxl-row.abn .rxl-line.flat {
            background: #4A2A27;
        }

        html.rq-dark .rx-wrap .rxl-band {
            background: rgba(92,187,130,.45);
        }

        html.rq-dark .rx-wrap .rxl-mark {
            border-color: var(--card);
        }

        html.rq-dark .rx-wrap .rx-pf {
            background: #141C18;
        }

        html.rq-dark .rx-wrap .rx-btn {
            background: var(--card);
            color: var(--deep);
            border-color: var(--line2);
        }

            html.rq-dark .rx-wrap .rx-btn:hover {
                background: var(--tl);
                border-color: var(--teal);
            }

        html.rq-dark .rx-wrap .rx-donut-in {
            background: var(--card);
        }

        html.rq-dark .rx-wrap .rx-sel,
        html.rq-dark .rx-wrap .rx-pill,
        html.rq-dark .rx-wrap .rxf-btn,
        html.rq-dark .rx-wrap .rxf-clear {
            background: var(--card);
            color: var(--soft);
            border-color: var(--line2);
        }

            html.rq-dark .rx-wrap .rx-pill.active,
            html.rq-dark .rx-wrap .rxf-btn.active,
            html.rq-dark .rx-wrap .rx-tab.active {
                color: #fff;
                border-color: transparent;
                background: linear-gradient(120deg, #0F7F74, #0A3A35);
            }

        html.rq-dark .rx-wrap .rx-tab {
            color: var(--soft);
        }

            html.rq-dark .rx-wrap .rx-tab.active {
                color: #fff;
            }

        html.rq-dark .rx-wrap .rx-tf,
        html.rq-dark .rx-wrap .rx-sum div {
            background: #141C18;
            border-color: var(--line);
        }

            html.rq-dark .rx-wrap .rx-tf select,
            html.rq-dark .rx-wrap .rx-tf input[type=date],
            html.rq-dark .rx-wrap .rxf input[type=date],
            html.rq-dark .rx-wrap .rxf-search input {
                background: var(--card);
                color: var(--ink);
                border-color: var(--line2);
                color-scheme: dark;
            }

                html.rq-dark .rx-wrap .rxf-search input::placeholder {
                    color: var(--faint);
                }

        html.rq-dark .rx-wrap .rx-graph {
            background: linear-gradient(180deg, #141C18, #101714);
            border-color: var(--line);
        }

        html.rq-dark .rx-wrap .rx-insight {
            background: var(--tl);
            border-color: var(--line2);
        }

        html.rq-dark .rx-wrap .rx-sel option {
            background: #172019;
            color: #E8EEEB;
        }

        html.rq-dark .rx-wrap .g-tip {
            box-shadow: 0 14px 34px rgba(0,0,0,.55);
        }

        html.rq-dark .rx-wrap .rxf-clear:hover {
            background: var(--rl);
        }

</style>

<div class="rx-wrap">

    <section class="rx-hero">
        <div class="rx-hero-left">
            <div class="rx-hero-icon"><i class="fas fa-chart-line"></i></div>
            <div>
                <div class="rx-eyebrow"><i class="fas fa-flask"></i> Laboratory Results</div>
                <h1>@(single ? "Results for request #" + reqFilter : "My Test Results")</h1>
                <p>@(single ? "These are the released results for this one request. Download a PDF copy or go back to see all your requests." : "Review your laboratory results, monitor abnormal values and follow your health information over time.")</p>
            </div>
        </div>
        <div class="rx-hero-right">
            <span class="rx-status"><i></i> Results Portal</span>
            <div class="rx-hero-num"><strong>@panels</strong><small>Released Panels</small></div>
        </div>
    </section>

    @if (single)
    {
        <div style="margin:-6px 0 20px;display:flex;gap:10px;flex-wrap:wrap">
            <a class="rx-btn" href="@Url.Action("Requests", "Patient")"><i class="fas fa-arrow-left"></i> Back to my requests</a>
            <a class="rx-btn" href="@Url.Action("Results", "Patient")"><i class="fas fa-list"></i> View all results</a>
        </div>
    }

    <section class="rx-stats">
        <div class="rx-card rx-stat"><div class="rx-ico teal"><i class="fas fa-vial"></i></div><div><span>Total Results</span><strong>@total</strong><small>Laboratory values</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico green"><i class="fas fa-circle-check"></i></div><div><span>Normal</span><strong>@normal</strong><small>@normalPct.ToString("0")% of results</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico red"><i class="fas fa-triangle-exclamation"></i></div><div><span>Needs Attention</span><strong>@abnormal</strong><small>@abnormalPct.ToString("0")% of results</small></div></div>
        <div class="rx-card rx-stat"><div class="rx-ico purple"><i class="fas fa-microscope"></i></div><div><span>Test Types</span><strong>@testTypes</strong><small>Different tests</small></div></div>
    </section>

    @if (!results.Any())
    {
        <section class="rx-card rx-empty">
            <div class="rx-empty-visual">
                <div class="rx-empty-circle"><i class="fas fa-flask-vial"></i></div>
                <span class="rx-orbit o1"></span><span class="rx-orbit o2"></span>
            </div>
            <div>
                <span class="rx-label"><i class="fas fa-info-circle"></i> No results available</span>
                <h2>Your laboratory results will appear here</h2>
                <p>You don't have any released results on your patient record yet. Once a test is completed and released, it appears on this page automatically.</p>
                <div class="rx-steps"><span><b>01</b>Test requested</span><i></i><span><b>02</b>Sample processed</span><i></i><span><b>03</b>Result released</span></div>
            </div>
        </section>
    }
    else
    {
        <div class="rx-tabs">
            <button class="rx-tab active" type="button" onclick="switchTab(this,'rx-all')"><i class="fas fa-list"></i> All results</button>
            <button class="rx-tab" type="button" onclick="switchTab(this,'rx-analytics')"><i class="fas fa-chart-line"></i> Health analytics</button>
        </div>

        <!-- ================= ALL RESULTS ================= -->
        <div id="rx-all">

            <div class="rx-card rxf" id="rxFilter">
                <div class="rxf-top">
                    <div class="rxf-search"><i class="fas fa-magnifying-glass"></i><input id="rxfQ" type="search" placeholder="Search test, doctor, request or note" autocomplete="off"></div>
                    @if (filterTests.Count > 1)
                    {
                        <select id="rxfTest" class="rx-sel">
                            <option value="">All tests</option>
                            @foreach (var t in filterTests)
                            {
                                <option value="@t">@t</option>
                            }
                        </select>
                    }
                    @if (filterDoctors.Count > 1)
                    {
                        <select id="rxfDoctor" class="rx-sel">
                            <option value="">All doctors</option>
                            @foreach (var d in filterDoctors)
                            {
                                <option value="@d">@d</option>
                            }
                        </select>
                    }
                    @if (filterCats.Count > 1)
                    {
                        <select id="rxfCat" class="rx-sel">
                            <option value="">All categories</option>
                            @foreach (var c in filterCats)
                            {
                                <option value="@c">@c</option>
                            }
                        </select>
                    }
                </div>
                <div class="rxf-bottom">
                    <div class="rxf-group">
                        <button type="button" class="rxf-btn active" data-status="all">All (@total)</button>
                        <button type="button" class="rxf-btn" data-status="ok">Normal (@normal)</button>
                        <button type="button" class="rxf-btn" data-status="abn">Needs attention (@abnormal)</button>
                    </div>
                    <div class="rxf-group">
                        <button type="button" class="rxf-btn active" data-days="0">All time</button>
                        <button type="button" class="rxf-btn" data-days="30">30 days</button>
                        <button type="button" class="rxf-btn" data-days="180">6 months</button>
                        <button type="button" class="rxf-btn" data-days="365">Year</button>
                        <label>From <input type="date" id="rxfFrom"></label>
                        <label>To <input type="date" id="rxfTo"></label>
                    </div>
                    <div class="rxf-meta"><span id="rxfCount"></span><button type="button" id="rxfClear" class="rxf-clear" hidden>Clear filters</button></div>
                </div>
            </div>

            <div class="rx-card rxf-none" id="rxfNone" hidden>
                <i class="fas fa-filter-circle-xmark"></i>
                <strong>No results match your filters</strong>
                <span>Try a different date range or clear the filters to see everything.</span>
            </div>

            @foreach (var group in results.GroupBy(r => r.RequestID).OrderByDescending(g => g.Key))
            {
                var first = group.First();
                var reqDoctor = group.Select(r => r.DoctorName).FirstOrDefault(n => !string.IsNullOrWhiteSpace(n));
                var reqDate = group.Where(r => r.ResultDate != default(DateTime)).Select(r => r.ResultDate).DefaultIfEmpty().Max();

                <article class="rx-card rx-panel">
                    <div class="rx-ph">
                        <div class="rx-ph-left">
                            <div class="rx-ph-icon"><i class="fas fa-flask"></i></div>
                            <div>
                                <small>Laboratory request</small>
                                <h3>#@group.Key @(string.IsNullOrWhiteSpace(first.Category) ? "" : "· " + first.Category)</h3>
                                <div class="rx-ph-meta">
                                    <span><i class="fas fa-calendar-day"></i>@(reqDate != default(DateTime) ? reqDate.ToString("dd MMM yyyy") : "Date not recorded")</span>
                                    <span><i class="fas fa-user-doctor"></i>@Doctor(reqDoctor)</span>
                                    <span><i class="fas fa-vials"></i><span class="rx-tc">@group.Count() @(group.Count() == 1 ? "test" : "tests")</span></span>
                                </div>
                            </div>
                        </div>
                        <div class="rxl-chips">
                            <span class="rxl-chip">@(group.Count(x => !x.IsAbnormal)) normal</span>
                            @if (group.Any(x => x.IsAbnormal))
                            {
                                <span class="rxl-chip abn">@(group.Count(x => x.IsAbnormal)) need attention</span>
                            }
                            <span class="rx-badge"><i class="fas fa-circle-check"></i> Released</span>
                        </div>
                    </div>

                    <div class="rxl">
                        <div class="rxl-head"><span>Test</span><span>Result</span><span>Reference range</span><span>Status</span></div>

                        @foreach (var r in group)
                        {
                            double lo = 0, hi = 0, val = 0;
                            var hasVal = TryNum(r.ResultValue, out val);
                            var canGauge = hasVal && TryRange(r.NormalRange, out lo, out hi);
                            double bandStart = 0, bandWidth = 0, marker = 50;
                            var pos = "";
                            if (canGauge)
                            {
                                var span = hi - lo;
                                var pLo = lo - span * .4;
                                var pSpan = span * 1.8;
                                bandStart = (lo - pLo) / pSpan * 100;
                                bandWidth = span / pSpan * 100;
                                marker = Math.Clamp((val - pLo) / pSpan * 100, 2, 98);
                                pos = val < lo ? "Below range" : val > hi ? "Above range" : "Within range";
                            }
                            var unset = string.IsNullOrWhiteSpace(r.NormalRange)
                                || Regex.IsMatch(r.NormalRange, @"^\s*0+([.,]0+)?\s*(-|–|to)\s*0+([.,]0+)?(?![\d.,])");
                            var refText = unset ? "No reference range" : r.NormalRange.Trim();
                            if (!unset && !string.IsNullOrWhiteSpace(r.Unit)
                                && refText.IndexOf(r.Unit.Trim(), StringComparison.OrdinalIgnoreCase) < 0)
                            {
                                refText += " " + r.Unit.Trim();
                            }
                            var cls = r.IsAbnormal ? "abn" : "ok";
                            var note = r.TechnicianNotes?.Trim();
                            var noDoc = string.IsNullOrWhiteSpace(r.DoctorName);
                            var when = r.ResultDate == default(DateTime)
                                ? "Not recorded"
                                : r.ResultDate.ToString(r.ResultDate.TimeOfDay == TimeSpan.Zero ? "dd MMM yyyy" : "dd MMM yyyy, HH:mm");
                            var dateKey = r.ResultDate == default(DateTime) ? "" : r.ResultDate.ToString("yyyy-MM-dd");
                            var docLabel = Doctor(r.DoctorName);
                            var searchKey = string.Join(" ", new[] { r.TestName, r.RequestID.ToString(), r.Category, r.TechnicianNotes, docLabel }).ToLowerInvariant();

                            <div class="rxl-row @cls" data-status="@cls" data-test="@r.TestName" data-doctor="@docLabel" data-cat="@r.Category" data-date="@dateKey" data-search="@searchKey">
                                <div class="rxl-main">
                                    <div class="rxl-name">
                                        <span class="rxl-ico"><i class="fas fa-vial"></i></span>
                                        <strong>@r.TestName</strong>
                                    </div>
                                    <div class="rxl-val"><b>@r.ResultValue</b><span>@r.Unit</span></div>
                                    <div class="rxl-range">
                                        <div class="rxl-line @(canGauge ? "" : "flat")">
                                            @if (canGauge)
                                            {
                                                <div class="rxl-band" style="left:@F(bandStart)%;width:@F(bandWidth)%"></div>
                                                <div class="rxl-mark" style="left:@F(marker)%"></div>
                                            }
                                        </div>
                                        <small>
                                            <span>@refText</span>
                                            @if (pos != "")
                                            {
                                                <b>@pos</b>
                                            }
                                        </small>
                                    </div>
                                    <div class="rxl-st">
                                        @if (r.IsAbnormal)
                                        {
                                            <span class="rx-badge abn"><i class="fas fa-triangle-exclamation"></i> Abnormal</span>
                                        }
                                        else
                                        {
                                            <span class="rx-badge"><i class="fas fa-check"></i> Normal</span>
                                        }
                                    </div>
                                </div>

                                <div class="rxl-meta">
                                    <div><small>Date performed</small><span><i class="fas fa-calendar-day"></i>@when</span></div>
                                    <div><small>Doctor</small><span class="@(noDoc ? "none" : "")"><i class="fas fa-user-doctor"></i>@Doctor(r.DoctorName)</span></div>
                                    <div class="rxl-note"><small>Technician note</small><span class="@(string.IsNullOrWhiteSpace(note) ? "none" : "")"><i class="fas fa-note-sticky"></i>@(string.IsNullOrWhiteSpace(note) ? "No note recorded for this test" : note)</span></div>
                                </div>
                            </div>
                        }
                    </div>

                    <div class="rx-pf">
                        <span><i class="fas fa-clock"></i> Laboratory report</span>
                        <span style="display:flex;gap:10px;flex-wrap:wrap">
                            <a class="rx-btn" href="@Url.Action("DownloadResultsPdf", "Patient", new { requestId = group.Key })"><i class="fas fa-file-pdf"></i> Download PDF</a>
                            <button type="button" class="rx-btn" onclick="window.print()"><i class="fas fa-print"></i> Print</button>
                        </span>
                    </div>
                </article>
            }
        </div>

        <!-- ================= ANALYTICS ================= -->
        <div id="rx-analytics" style="display:none">

            <section class="rx-card rx-intro">
                <div>
                    <small><i class="fas fa-chart-line"></i> Results overview</small>
                    <h2>Your results at a glance</h2>
                    <p>A summary of the laboratory information currently on your patient record.</p>
                </div>
                <div class="rx-intro-num"><strong>@total</strong><span>Total values</span></div>
            </section>

            <div class="rx-grid2">
                <div class="rx-card rx-chart">
                    <div class="rx-chart-h"><div><small>Result status</small><h3>Normal vs attention</h3></div><i class="fas fa-chart-pie"></i></div>
                    <div class="rx-donut-area">
                        <div class="rx-donut" style="background:conic-gradient(#2E8B57 0deg @(normalDeg)deg, #B0463F @(normalDeg)deg 360deg)">
                            <div class="rx-donut-in"><strong>@normalPct.ToString("0")%</strong><span>Normal</span></div>
                        </div>
                        <div class="rx-legend">
                            <div><span class="rx-dot" style="background:#2E8B57"></span>Normal<strong>@normal</strong></div>
                            <div><span class="rx-dot" style="background:#B0463F"></span>Attention<strong>@abnormal</strong></div>
                        </div>
                    </div>
                </div>

                <div class="rx-card rx-chart">
                    <div class="rx-chart-h"><div><small>Laboratory activity</small><h3>Tests performed</h3></div><i class="fas fa-vials"></i></div>
                    @foreach (var t in topTests)
                    {
                        <div class="rx-bar">
                            <div><span>@t.Key</span><strong>@t.Count()</strong></div>
                            <div class="rx-track"><div class="rx-fill" style="width:@F((double)t.Count() / total * 100)%"></div></div>
                        </div>
                    }
                </div>
            </div>

            <!-- ===== RESULT TREND (with date / year filters and All-tests bar chart) ===== -->
            <div class="rx-card rx-trend">
                <div class="rx-thead">
                    <div class="rx-thead-l"><div class="rx-thead-ico"><i class="fas fa-wave-square"></i></div><div><h3>Result trend</h3><p>Follow one test over time, or compare every test at once.</p></div></div>
                    @if (series.Any())
                    {
                        <select id="trendSel" class="rx-sel" onchange="drawTrend()">
                            <option value="__all__">All tests (bar chart)</option>
                            @for (var i = 0; i < series.Count; i++)
                            {
                                <option value="@series[i].Key" selected="@(i == 0)">@series[i].Key (@series[i].Count())</option>
                            }
                        </select>
                    }
                </div>

                @if (!series.Any())
                {
                    <div class="rx-graph-empty">A trend appears once numeric measurements are recorded.</div>
                }
                else
                {
                    <div class="rx-ranges">
                        <button type="button" class="rx-pill active" data-days="0">All time</button>
                        <button type="button" class="rx-pill" data-days="7">7 days</button>
                        <button type="button" class="rx-pill" data-days="30">Month</button>
                        <button type="button" class="rx-pill" data-days="180">6 months</button>
                        <button type="button" class="rx-pill" data-days="365">Year</button>
                    </div>

                    <div class="rx-tf">
                        <label>Year <select id="tfYear"><option value="">All years</option></select></label>
                        <label>From <input type="date" id="tfFrom"></label>
                        <label>To <input type="date" id="tfTo"></label>
                        <button type="button" id="tfClear" class="rxf-clear" style="margin-left:auto" hidden>Clear dates</button>
                    </div>

                    <div class="rx-sum">
                        <div><small id="sl1">Latest</small><b id="sLatest">—</b></div>
                        <div><small id="sl2">Average</small><b id="sAvg">—</b></div>
                        <div><small id="sl3">Range</small><b id="sRange">—</b></div>
                        <div><small id="sl4">Direction</small><b id="sDir">—</b></div>
                    </div>
                    <div class="rx-graph"><div id="trendBox"></div></div>
                    <div class="rx-insight">
                        <i class="fas fa-lightbulb"></i>
                        <div><strong id="insTitle">—</strong><span id="insText"></span></div>
                    </div>
                }
            </div>

            <div class="rx-insight">
                <i class="fas fa-circle-info"></i>
                <div><strong>About your analytics</strong>These charts describe your recorded data statistically. A trend is not a diagnosis; discuss changes with your doctor.</div>
            </div>
        </div>
    }

    <footer class="rx-footer"><i class="fas fa-shield-halved"></i> Laboratory Information Management System · Patient Portal · @DateTime.Now.Year</footer>
</div>

@section Scripts {
    <script>
        var T = @Html.Raw(trendJson);
        var days = 0;
        var TF = { year: '', from: '', to: '' };

        function switchTab(btn, id) {
            document.querySelectorAll('.rx-tab').forEach(function(t) { t.classList.remove('active'); });
            btn.classList.add('active');
            document.getElementById('rx-all').style.display = id === 'rx-all' ? '' : 'none';
            document.getElementById('rx-analytics').style.display = id === 'rx-analytics' ? '' : 'none';
            if (id === 'rx-analytics') drawTrend();
        }

        /* ===== Trend date / year filters ===== */
        function markPill(btn) {
            document.querySelectorAll('.rx-pill').forEach(function(x) { x.classList.toggle('active', x === btn); });
        }
        function allTimePill() { return document.querySelector('.rx-pill[data-days="0"]'); }
        function syncTfClear() {
            var c = document.getElementById('tfClear');
            if (c) c.hidden = !(TF.year || TF.from || TF.to);
        }
        function resetTfInputs() {
            var y = document.getElementById('tfYear'), f = document.getElementById('tfFrom'), t = document.getElementById('tfTo');
            if (y) y.value = '';
            if (f) f.value = '';
            if (t) t.value = '';
        }

        // Quick range pills (7 days, month ...)
        document.querySelectorAll('.rx-pill').forEach(function(b) {
            b.addEventListener('click', function() {
                days = parseInt(b.dataset.days, 10) || 0;
                TF = { year: '', from: '', to: '' };
                resetTfInputs();
                markPill(b);
                syncTfClear();
                drawTrend();
            });
        });

        // Fill the year dropdown from the years that actually have results
        (function() {
            var sel = document.getElementById('tfYear');
            if (!sel) return;

            var ys = {};
            Object.keys(T).forEach(function(k) {
                T[k].forEach(function(p) { if (p.d) ys[p.d.slice(0, 4)] = 1; });
            });
            Object.keys(ys).sort().reverse().forEach(function(y) {
                var o = document.createElement('option');
                o.value = y; o.textContent = y;
                sel.appendChild(o);
            });

            sel.addEventListener('change', function() {
                TF = { year: sel.value, from: '', to: '' };
                days = 0;
                document.getElementById('tfFrom').value = '';
                document.getElementById('tfTo').value = '';
                markPill(sel.value ? null : allTimePill());
                syncTfClear();
                drawTrend();
            });

            ['tfFrom', 'tfTo'].forEach(function(id) {
                document.getElementById(id).addEventListener('input', function() {
                    TF = {
                        year: '',
                        from: document.getElementById('tfFrom').value,
                        to: document.getElementById('tfTo').value
                    };
                    days = 0;
                    document.getElementById('tfYear').value = '';
                    markPill((TF.from || TF.to) ? null : allTimePill());
                    syncTfClear();
                    drawTrend();
                });
            });

            document.getElementById('tfClear').addEventListener('click', function() {
                TF = { year: '', from: '', to: '' };
                days = 0;
                resetTfInputs();
                markPill(allTimePill());
                syncTfClear();
                drawTrend();
            });
        })();

        // Which dates are currently selected (year > custom dates > quick pill)
        function trendBounds() {
            var from = '', to = '';
            if (TF.year) { from = TF.year + '-01-01'; to = TF.year + '-12-31'; }
            else if (TF.from || TF.to) { from = TF.from; to = TF.to; }
            else if (days) { from = new Date(Date.now() - days * 864e5).toISOString().slice(0, 10); }
            return { from: from, to: to, active: !!(from || to) };
        }
        function inBounds(p, b) {
            if (!b.active) return true;
            if (!p.d) return false;
            if (b.from && p.d < b.from) return false;
            if (b.to && p.d > b.to) return false;
            return true;
        }

        /* ===== Filters (All results tab) ===== */
        var FLT = { status: 'all', test: '', doctor: '', cat: '', q: '', days: 0, from: '', to: '' };

        function applyFilters() {
            var cutoff = FLT.days ? new Date(Date.now() - FLT.days * 864e5).toISOString().slice(0, 10) : '';
            var from = FLT.from || cutoff, to = FLT.to;
            var shown = 0, all = 0;

            document.querySelectorAll('#rx-all .rx-panel').forEach(function(panel) {
                var rows = panel.querySelectorAll('.rxl-row'), vis = 0;
                rows.forEach(function(r) {
                    var d = r.dataset, ok = true;
                    if (FLT.status !== 'all' && d.status !== FLT.status) ok = false;
                    if (ok && FLT.test && d.test !== FLT.test) ok = false;
                    if (ok && FLT.doctor && d.doctor !== FLT.doctor) ok = false;
                    if (ok && FLT.cat && d.cat !== FLT.cat) ok = false;
                    if (ok && FLT.q && d.search.indexOf(FLT.q) < 0) ok = false;
                    if (ok && (from || to)) {
                        if (!d.date) ok = false;
                        else if ((from && d.date < from) || (to && d.date > to)) ok = false;
                    }
                    r.style.display = ok ? '' : 'none';
                    if (ok) vis++;
                });
                panel.style.display = vis ? '' : 'none';
                var tc = panel.querySelector('.rx-tc');
                if (tc) {
                    var nAll = rows.length;
                    tc.textContent = vis === nAll ? nAll + (nAll === 1 ? ' test' : ' tests') : vis + ' of ' + nAll + ' tests';
                }
                shown += vis; all += rows.length;
            });

            var active = FLT.status !== 'all' || FLT.test || FLT.doctor || FLT.cat || FLT.q || FLT.days || FLT.from || FLT.to;
            document.getElementById('rxfCount').textContent = 'Showing ' + shown + ' of ' + all + ' results';
            document.getElementById('rxfClear').hidden = !active;
            document.getElementById('rxfNone').hidden = shown !== 0;
        }

        (function() {
            var bar = document.getElementById('rxFilter');
            if (!bar) return;

            function mark(attr, btn) {
                bar.querySelectorAll('.rxf-btn[' + attr + ']').forEach(function(b) { b.classList.toggle('active', b === btn); });
            }

            bar.addEventListener('click', function(e) {
                var b = e.target.closest('.rxf-btn');
                if (b) {
                    if (b.hasAttribute('data-status')) { FLT.status = b.dataset.status; mark('data-status', b); }
                    else {
                        FLT.days = parseInt(b.dataset.days, 10) || 0; FLT.from = FLT.to = '';
                        document.getElementById('rxfFrom').value = ''; document.getElementById('rxfTo').value = '';
                        mark('data-days', b);
                    }
                    applyFilters();
                }
                if (e.target.id === 'rxfClear') {
                    FLT = { status: 'all', test: '', doctor: '', cat: '', q: '', days: 0, from: '', to: '' };
                    bar.querySelectorAll('input, select').forEach(function(el) { el.value = ''; });
                    mark('data-status', bar.querySelector('[data-status="all"]'));
                    mark('data-days', bar.querySelector('[data-days="0"]'));
                    applyFilters();
                }
            });

            bar.addEventListener('input', function(e) {
                var t = e.target, id = t.id;
                if (id === 'rxfQ') FLT.q = t.value.trim().toLowerCase();
                else if (id === 'rxfTest') FLT.test = t.value;
                else if (id === 'rxfDoctor') FLT.doctor = t.value;
                else if (id === 'rxfCat') FLT.cat = t.value;
                else if (id === 'rxfFrom' || id === 'rxfTo') {
                    FLT.from = document.getElementById('rxfFrom').value;
                    FLT.to = document.getElementById('rxfTo').value;
                    FLT.days = 0; mark('data-days', null);
                } else return;
                applyFilters();
            });

            applyFilters();
        })();

        /* ===== Trend graph (upgraded) ===== */
        var MON = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sep', 'Oct', 'Nov', 'Dec'];
        var lastDrawKey = '';
        var reduceMotion = window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches;

        function n(v) { return String(Math.round(v * 100) / 100); }
        function set(id, txt) { document.getElementById(id).textContent = txt; }
        function esc(s) {
            return String(s).replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;').replace(/"/g, '&quot;');
        }
        function setLabels(a) {
            ['sl1', 'sl2', 'sl3', 'sl4'].forEach(function(id, i) { set(id, a[i]); });
        }
        function fmtD(d, yr) {
            if (!d) return '';
            var p = d.split('-');
            return parseInt(p[2], 10) + ' ' + MON[parseInt(p[1], 10) - 1] + (yr ? ' ' + p[0] : '');
        }

        // Round axis limits to friendly numbers (0, 5, 10 ... instead of 3.37, 8.12 ...)
        function niceScale(lo, hi, want) {
            var span = (hi - lo) || 1;
            var raw = span / want;
            var mag = Math.pow(10, Math.floor(Math.log(raw) / Math.LN10));
            var f = raw / mag;
            var step = (f >= 7.5 ? 10 : f >= 3.5 ? 5 : f >= 1.5 ? 2 : 1) * mag;
            var nlo = Math.floor(lo / step + 1e-9) * step;
            var nhi = Math.ceil(hi / step - 1e-9) * step;
            if (nhi === nlo) nhi = nlo + step;
            return { lo: nlo, hi: nhi, step: step };
        }

        // Smooth curve through the points that never overshoots between them
        function smoothPath(p) {
            var c = p.length, i;
            if (c < 3) return p.map(function(q, k) { return (k ? 'L' : 'M') + q.x + ' ' + q.y; }).join(' ');
            var dx = [], m = [], t = [];
            for (i = 0; i < c - 1; i++) { dx[i] = p[i + 1].x - p[i].x; m[i] = (p[i + 1].y - p[i].y) / dx[i]; }
            t[0] = m[0]; t[c - 1] = m[c - 2];
            for (i = 1; i < c - 1; i++) t[i] = (m[i - 1] * m[i] <= 0) ? 0 : (m[i - 1] + m[i]) / 2;
            for (i = 0; i < c - 1; i++) {
                if (m[i] === 0) { t[i] = 0; t[i + 1] = 0; continue; }
                var a = t[i] / m[i], b = t[i + 1] / m[i], s = a * a + b * b;
                if (s > 9) { var k = 3 / Math.sqrt(s); t[i] = k * a * m[i]; t[i + 1] = k * b * m[i]; }
            }
            var d = 'M' + p[0].x + ' ' + p[0].y;
            for (i = 0; i < c - 1; i++) {
                var h = dx[i] / 3;
                d += ' C' + (p[i].x + h) + ' ' + (p[i].y + t[i] * h) + ' ' + (p[i + 1].x - h) + ' ' + (p[i + 1].y - t[i + 1] * h) + ' ' + p[i + 1].x + ' ' + p[i + 1].y;
            }
            return d;
        }

        function legendHtml(items) {
            return '<div class="g-legend">' + items.map(function(i) {
                return '<span><i class="g-sw ' + i[0] + '"></i>' + i[1] + '</span>';
            }).join('') + '</div>';
        }

        function placeTip(tip, svg, W, px, py) {
            var k = svg.getBoundingClientRect().width / W;
            var tw = tip.offsetWidth, bw = svg.getBoundingClientRect().width;
            var left = Math.min(Math.max(px * k, tw / 2 + 4), bw - tw / 2 - 4) + svg.offsetLeft;
            tip.classList.toggle('below', py * k < tip.offsetHeight + 28);
            tip.style.left = left + 'px';
            tip.style.top = (py * k + svg.offsetTop) + 'px';
            tip.classList.add('show');
        }

        function drawTrend() {
            var sel = document.getElementById('trendSel');
            if (!sel) return;

            if (sel.value === '__all__') { drawAll(); return; }

            setLabels(['Latest', 'Average', 'Range', 'Direction']);

            var b = trendBounds();
            var pts = (T[sel.value] || []).filter(function(p) { return inBounds(p, b); });
            var box = document.getElementById('trendBox');
            var dir = document.getElementById('sDir');

            if (pts.length < 2) {
                box.innerHTML = '<div class="rx-graph-empty">Not enough results in this period to draw a trend.</div>';
                ['sLatest', 'sAvg', 'sRange'].forEach(function(i) { set(i, '\u2014'); });
                dir.className = ''; dir.textContent = '\u2014';
                set('insTitle', 'Not enough data');
                set('insText', 'A trend needs at least two measurements of the same test.');
                return;
            }

            var vals = pts.map(function(p) { return p.v; });
            var min = Math.min.apply(null, vals), max = Math.max.apply(null, vals);
            var avg = vals.reduce(function(a, c) { return a + c; }, 0) / vals.length;
            var diff = vals[vals.length - 1] - vals[0];
            var tol = Math.max(Math.abs(avg) * 0.02, 1e-6);
            var d = diff > tol ? 'up' : diff < -tol ? 'down' : 'stable';
            var label = { up: 'Trending upward', down: 'Trending downward', stable: 'Stable' }[d];
            var text = {
                up: 'The latest value is higher than the first value in this period.',
                down: 'The latest value is lower than the first value in this period.',
                stable: 'The first and latest values are close, so this series is stable.'
            }[d];

            set('sLatest', n(vals[vals.length - 1])); set('sAvg', n(avg)); set('sRange', n(min) + ' \u2013 ' + n(max));
            dir.className = d; dir.textContent = label;
            set('insTitle', label); set('insText', text);

            // only animate when the picture really changes (not on window resize)
            var key = sel.value + '|' + b.from + '|' + b.to;
            var anim = key !== lastDrawKey && !reduceMotion;
            lastDrawKey = key;

            // geometry
            var W = 900, H = 360, L = 58, R = 30, Tp = 38, B = 48, gw = W - L - R, gh = H - Tp - B;
            var N = pts.length, li = N - 1;

            var ref = null;
            for (var q = N - 1; q >= 0; q--) { if (pts[q].lo != null) { ref = { lo: pts[q].lo, hi: pts[q].hi }; break; } }

            var lo = min, hi = max, pad = (max - min || Math.abs(max) * 0.1 || 1) * 0.22;
            lo -= pad; hi += pad;
            if (ref) {
                var rp = (ref.hi - ref.lo) * 0.12;
                lo = Math.min(lo, ref.lo - rp); hi = Math.max(hi, ref.hi + rp);
            }
            var ns = niceScale(lo, hi, 5);
            lo = ns.lo; hi = ns.hi;
            if (min >= 0 && lo < 0) lo = 0;

            var X = function(i) { return L + 16 + i / (N - 1) * (gw - 32); };
            var Y = function(v) { return Tp + (hi - v) / (hi - lo) * gh; };
            var xy = pts.map(function(p, i) { return { x: X(i), y: Y(p.v) }; });

            var s = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Trend of ' + esc(sel.value) + '">';
            s += '<defs>' +
                '<linearGradient id="gArea" x1="0" y1="0" x2="0" y2="1"><stop offset="0%" class="g-stop-a"/><stop offset="100%" class="g-stop-b"/></linearGradient>' +
                '<filter id="gGlow" x="-5%" y="-25%" width="110%" height="160%"><feDropShadow dx="0" dy="5" stdDeviation="5" class="g-shadow"/></filter>' +
                '</defs>';

            // grid + y labels
            for (var v = lo; v <= hi + ns.step / 2; v += ns.step) {
                var tv = Number(v.toFixed(6)), gy = Y(tv);
                s += '<line class="g-grid" x1="' + L + '" x2="' + (W - R) + '" y1="' + gy + '" y2="' + gy + '"/>' +
                    '<text class="g-axis-t" x="' + (L - 10) + '" y="' + (gy + 4) + '" text-anchor="end">' + n(tv) + '</text>';
            }
            s += '<line class="g-axis-line" x1="' + L + '" x2="' + (W - R) + '" y1="' + (Tp + gh) + '" y2="' + (Tp + gh) + '"/>';

            // normal range band
            if (ref) {
                var bt = Math.max(Tp, Y(ref.hi)), bb = Math.min(Tp + gh, Y(ref.lo));
                s += '<rect class="g-band" x="' + L + '" y="' + bt + '" width="' + gw + '" height="' + Math.max(bb - bt, 1) + '"/>' +
                    '<line class="g-band-l" x1="' + L + '" x2="' + (W - R) + '" y1="' + bt + '" y2="' + bt + '"/>' +
                    '<line class="g-band-l" x1="' + L + '" x2="' + (W - R) + '" y1="' + bb + '" y2="' + bb + '"/>' +
                    '<text class="g-band-t" x="' + (L + 10) + '" y="' + (bt + 15) + '">Normal range ' + n(ref.lo) + ' \u2013 ' + n(ref.hi) + '</text>';
            }

            // smooth line + soft area under it
            var path = smoothPath(xy);
            var area = path + ' L' + xy[li].x + ' ' + (Tp + gh) + ' L' + xy[0].x + ' ' + (Tp + gh) + ' Z';
            s += '<path class="g-area' + (anim ? ' g-fade' : '') + '" d="' + area + '" fill="url(#gArea)"/>';
            s += '<path class="g-line' + (anim ? ' g-draw' : '') + '" pathLength="1" d="' + path + '" filter="url(#gGlow)"/>';

            // crosshair + hover ring (moved by the mouse)
            s += '<line class="g-cross" id="gCross" x1="0" x2="0" y1="' + Tp + '" y2="' + (Tp + gh) + '"/>' +
                '<circle class="g-hover" id="gHover" cx="0" cy="0" r="10"/>';

            // dots: all of them for short series, only problem points + latest for long ones
            var showAll = N <= 30;
            pts.forEach(function(p, i) {
                var isLast = i === li;
                if (!showAll && !p.a && !isLast) return;
                if (p.a || isLast) s += '<circle class="g-halo' + (p.a ? ' abn' : '') + '" cx="' + xy[i].x + '" cy="' + xy[i].y + '" r="' + (isLast ? 14 : 10) + '"/>';
                s += '<circle class="g-dot' + (p.a ? ' abn' : '') + '" cx="' + xy[i].x + '" cy="' + xy[i].y + '" r="' + (isLast ? 6.5 : 5) + '"/>';
            });

            // highest / lowest tags
            if (max !== min && N <= 60) {
                var iMax = vals.indexOf(max), iMin = vals.indexOf(min);
                if (iMax !== li) s += '<g class="g-mm max"><text x="' + xy[iMax].x + '" y="' + (xy[iMax].y - 14) + '" text-anchor="middle">\u25B2 ' + n(max) + '</text></g>';
                if (iMin !== li) s += '<g class="g-mm min"><text x="' + xy[iMin].x + '" y="' + (xy[iMin].y + 24) + '" text-anchor="middle">\u25BC ' + n(min) + '</text></g>';
            }

            // value bubble on the latest point
            var lt = n(pts[li].v), bwid = lt.length * 8 + 20;
            var bx = Math.min(Math.max(xy[li].x - bwid / 2, L), W - R - bwid);
            var by = xy[li].y - 44 < Tp - 12 ? xy[li].y + 18 : xy[li].y - 44;
            s += '<g class="g-tag' + (pts[li].a ? ' abn' : '') + '"><rect x="' + bx + '" y="' + by + '" width="' + bwid + '" height="26" rx="13"/>' +
                '<text x="' + (bx + bwid / 2) + '" y="' + (by + 17) + '" text-anchor="middle">' + lt + '</text></g>';

            // x labels
            var yrs = pts[0].d && pts[li].d && pts[0].d.slice(0, 4) !== pts[li].d.slice(0, 4);
            var want = Math.min(N, 6), seen = {};
            for (var k = 0; k < want; k++) {
                var ix = want === 1 ? 0 : Math.round(k * (N - 1) / (want - 1));
                if (seen[ix]) continue;
                seen[ix] = 1;
                s += '<text class="g-axis-x" x="' + xy[ix].x + '" y="' + (H - 16) + '" text-anchor="middle">' + esc(fmtD(pts[ix].d, yrs) || ('Req #' + pts[ix].r)) + '</text>';
            }

            box.innerHTML = legendHtml([['line', 'Result'], ['band', 'Normal range'], ['ok', 'Normal'], ['abn', 'Needs attention']]) + s + '</svg>';

            // hover tooltip
            var svg = box.querySelector('svg');
            var tip = document.createElement('div');
            tip.className = 'g-tip';
            box.appendChild(tip);
            var cross = svg.querySelector('#gCross'), ring = svg.querySelector('#gHover');

            function hide() { tip.classList.remove('show'); cross.style.opacity = 0; ring.style.opacity = 0; }
            function show(i) {
                var p = pts[i];
                cross.setAttribute('x1', xy[i].x); cross.setAttribute('x2', xy[i].x); cross.style.opacity = 1;
                ring.setAttribute('cx', xy[i].x); ring.setAttribute('cy', xy[i].y);
                ring.setAttribute('class', 'g-hover' + (p.a ? ' abn' : '')); ring.style.opacity = 1;
                var dl = '';
                if (i > 0) { var df = p.v - pts[i - 1].v; dl = ' \u00B7 ' + (df > 0 ? '+' : '') + n(df) + ' vs previous'; }
                tip.innerHTML = '<div class="g-tip-d">' + esc(fmtD(p.d, true) || 'No date') + '</div>' +
                    '<div class="g-tip-v">' + n(p.v) + '</div>' +
                    '<span class="g-tip-s ' + (p.a ? 'abn' : 'ok') + '">' + (p.a ? 'Needs attention' : 'Normal') + '</span>' +
                    '<div class="g-tip-m">Request #' + esc(p.r) + dl + '</div>';
                placeTip(tip, svg, W, xy[i].x, xy[i].y);
            }
            function onMove(e) {
                var r = svg.getBoundingClientRect();
                var mx = (e.clientX - r.left) / r.width * W;
                if (mx < L - 6 || mx > W - R + 6) { hide(); return; }
                var best = 0, bd = 1e9;
                xy.forEach(function(q, i) { var dd = Math.abs(q.x - mx); if (dd < bd) { bd = dd; best = i; } });
                show(best);
            }
            svg.addEventListener('pointermove', onMove);
            svg.addEventListener('pointerdown', onMove);
            svg.addEventListener('pointerleave', hide);
        }

        /* ===== All tests at once (bar chart) =====
           Every test has different units, so each bar shows the latest value in the
           selected dates as a % of the TOP of that test's normal range.
           The green zone is the normal range; a bar that passes 100% is above range. */
        function drawAll() {
            setLabels(['Tests shown', 'Within range', 'Above range', 'Below range']);

            var b = trendBounds();
            var rows = [], skipped = [];

            Object.keys(T).forEach(function(name) {
                var pts = T[name].filter(function(p) { return inBounds(p, b); });
                if (!pts.length) return;
                var last = pts[pts.length - 1];
                if (last.lo != null && last.hi != null && last.hi > 0 && last.lo >= 0) {
                    rows.push({ name: name, v: last.v, lo: last.lo, hi: last.hi, a: last.a, d: last.d, r: last.r, c: pts.length });
                } else {
                    skipped.push(name);
                }
            });

            var box = document.getElementById('trendBox');
            var dir = document.getElementById('sDir');
            dir.className = '';

            if (!rows.length) {
                box.innerHTML = '<div class="rx-graph-empty">No numeric results with a reference range in this period.</div>';
                ['sLatest', 'sAvg', 'sRange'].forEach(function(i) { set(i, '\u2014'); });
                dir.textContent = '\u2014';
                set('insTitle', 'Nothing to compare');
                set('insText', 'Try a different year or date range, or pick a single test from the list.');
                return;
            }

            var within = 0, above = 0, below = 0;
            rows.forEach(function(r) {
                r.out = r.v > r.hi ? 'above' : r.v < r.lo ? 'below' : 'in';
                if (r.out === 'in') within++; else if (r.out === 'above') above++; else below++;
            });

            // tests outside their range first, then alphabetical
            rows.sort(function(a, c) {
                var ao = a.out === 'in' ? 1 : 0, co = c.out === 'in' ? 1 : 0;
                return ao - co || a.name.localeCompare(c.name);
            });

            set('sLatest', String(rows.length)); set('sAvg', String(within));
            set('sRange', String(above)); dir.textContent = String(below);

            var key = '__all__|' + b.from + '|' + b.to;
            var anim = key !== lastDrawKey && !reduceMotion;
            lastDrawKey = key;

            var W = 900, L = 232, R = 70, rowH = 46, Tp = 58, B = 38, MAXP = 160;
            var H = Tp + rows.length * rowH + B, gw = W - L - R;
            var X = function(pct) { return L + Math.min(Math.max(pct, 0), MAXP) / MAXP * gw; };
            var barH = 14;

            var s = '<svg viewBox="0 0 ' + W + ' ' + H + '" role="img" aria-label="Latest result of every test compared with its normal range">';
            s += '<defs>' +
                '<linearGradient id="gbOk" x1="0" x2="1"><stop offset="0%" class="gb-ok-a"/><stop offset="100%" class="gb-ok-b"/></linearGradient>' +
                '<linearGradient id="gbAbove" x1="0" x2="1"><stop offset="0%" class="gb-ab-a"/><stop offset="100%" class="gb-ab-b"/></linearGradient>' +
                '<linearGradient id="gbBelow" x1="0" x2="1"><stop offset="0%" class="gb-be-a"/><stop offset="100%" class="gb-be-b"/></linearGradient>' +
                '</defs>';

            // row stripes first, so everything else sits on top
            rows.forEach(function(r, i) {
                if (i % 2 === 0) s += '<rect class="g-stripe" x="12" y="' + (Tp + i * rowH) + '" width="' + (W - 24) + '" height="' + rowH + '" rx="10"/>';
            });

            // vertical grid + axis labels
            [0, 50, 100, 150].forEach(function(t) {
                s += '<line class="g-grid" x1="' + X(t) + '" x2="' + X(t) + '" y1="' + Tp + '" y2="' + (H - B) + '"/>' +
                    '<text class="g-axis-t" x="' + X(t) + '" y="' + (H - 14) + '" text-anchor="middle">' + t + '%</text>';
            });
            s += '<line class="g-ref" x1="' + X(100) + '" x2="' + X(100) + '" y1="' + (Tp - 8) + '" y2="' + (H - B) + '"/>' +
                '<text class="g-ref-t" x="' + X(100) + '" y="' + (Tp - 16) + '" text-anchor="middle">Top of normal range</text>';

            rows.forEach(function(r, i) {
                var y = Tp + i * rowH, cy = y + rowH / 2;
                var pct = r.v / r.hi * 100, loPct = r.lo / r.hi * 100;
                var nm = r.name.length > 26 ? r.name.slice(0, 25) + '\u2026' : r.name;
                var by = cy - barH / 2;

                s += '<rect class="g-zone" x="' + X(loPct) + '" y="' + (by - 6) + '" width="' + (X(100) - X(loPct)) + '" height="' + (barH + 12) + '" rx="7"/>' +
                    '<rect class="g-rowfocus" data-row="' + i + '" x="12" y="' + y + '" width="' + (W - 24) + '" height="' + rowH + '" rx="10"/>' +
                    '<text class="g-name" x="' + (L - 14) + '" y="' + (cy - 2) + '" text-anchor="end">' + esc(nm) + '</text>' +
                    '<text class="g-sub" x="' + (L - 14) + '" y="' + (cy + 13) + '" text-anchor="end">normal ' + n(r.lo) + ' \u2013 ' + n(r.hi) + '</text>' +
                    '<rect class="g-bar ' + r.out + (anim ? ' g-grow' : '') + '" x="' + L + '" y="' + by + '" width="' + Math.max(X(pct) - L, 3) + '" height="' + barH + '" rx="7" style="animation-delay:' + (i * 50) + 'ms"/>' +
                    '<text class="g-val ' + r.out + '" x="' + (X(pct) + 9) + '" y="' + (cy + 4) + '">' + n(r.v) + (pct > MAXP ? ' \u25B8' : '') + '</text>';
            });

            // invisible hit areas on top for the tooltip
            rows.forEach(function(r, i) {
                s += '<rect class="g-rowhit" data-row="' + i + '" x="12" y="' + (Tp + i * rowH) + '" width="' + (W - 24) + '" height="' + rowH + '"/>';
            });

            box.innerHTML = legendHtml([['ok', 'Within range'], ['above', 'Above range'], ['below', 'Below range'], ['band', 'Normal zone']]) + s + '</svg>';

            var svg = box.querySelector('svg');
            var tip = document.createElement('div');
            tip.className = 'g-tip';
            box.appendChild(tip);

            function hide() {
                tip.classList.remove('show');
                svg.querySelectorAll('.g-rowfocus').forEach(function(f) { f.style.opacity = 0; });
            }
            function show(i) {
                var r = rows[i];
                svg.querySelectorAll('.g-rowfocus').forEach(function(f) { f.style.opacity = f.getAttribute('data-row') === String(i) ? 0.07 : 0; });
                var st = r.out === 'in' ? 'Within range' : r.out === 'above' ? 'Above range' : 'Below range';
                var cls = r.out === 'in' ? 'ok' : r.out === 'above' ? 'abn' : 'below';
                tip.innerHTML = '<div class="g-tip-d">' + esc(fmtD(r.d, true) || 'No date') + '</div>' +
                    '<div class="g-tip-n">' + esc(r.name) + '</div>' +
                    '<div class="g-tip-v">' + n(r.v) + '</div>' +
                    '<span class="g-tip-s ' + cls + '">' + st + '</span>' +
                    '<div class="g-tip-m">Normal ' + n(r.lo) + ' \u2013 ' + n(r.hi) + ' \u00B7 ' + Math.round(r.v / r.hi * 100) + '% of the top<br>Request #' + esc(r.r) +
                    (r.c > 1 ? ' \u00B7 ' + r.c + ' results in this period' : '') + '</div>';
                placeTip(tip, svg, W, X(Math.min(r.v / r.hi * 100, MAXP)), Tp + i * rowH + rowH / 2);
            }
            function onMove(e) {
                var rc = svg.getBoundingClientRect();
                var my = (e.clientY - rc.top) / rc.width * W;
                var i = Math.floor((my - Tp) / rowH);
                if (i < 0 || i >= rows.length) { hide(); return; }
                show(i);
            }
            svg.addEventListener('pointermove', onMove);
            svg.addEventListener('pointerdown', onMove);
            svg.addEventListener('pointerleave', hide);

            set('insTitle', 'Comparing ' + rows.length + (rows.length === 1 ? ' test' : ' tests'));
            var note = within + ' of ' + rows.length + ' latest values are within their normal range. ' +
                'Each bar is the latest value in the selected dates as a % of the top of its normal range; ' +
                'the green zone is the normal range. Hover a bar for details.';
            if (skipped.length) {
                note += ' Not shown (no usable reference range): ' + skipped.join(', ') + '.';
            }
            set('insText', note);
        }

        window.addEventListener('resize', function() {
            if (document.getElementById('rx-analytics').style.display !== 'none') drawTrend();
        });
    </script>
}
