@model List<LabDash.Models.TestResultViewModel>
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Results";
    ViewData["ActivePage"] = "Results";
}

<div class="p-content">
    <div class="p-hero">
        <div class="p-hero-inner">
            <div>
                <h1 class="p-hero-title">Test Results 📊</h1>
                <p class="p-hero-subtitle">Access your laboratory data and track health trends over time.</p>
            </div>
        </div>
    </div>

    <div style="display: flex; gap: 10px; margin-bottom: 25px; border-bottom: 1px solid #eee; padding-bottom: 10px;">
        <button class="tab-btn active" onclick="switchResultTab(this,'tab-list')">
            <i class="fas fa-list"></i> All Results
        </button>
        <button class="tab-btn" onclick="switchResultTab(this,'tab-track')">
            <i class="fas fa-chart-line"></i> Track Over Time
        </button>
    </div>

    <div id="tab-list">
        @foreach (var group in Model.GroupBy(r => r.RequestID))
        {
            <div class="p-card" style="margin-bottom: 25px;">
                <div class="p-ch">
                    <div class="p-ct">
                        <i class="fas fa-flask"></i> Request #@group.Key — @group.First().Category
                    </div>
                    <span class="p-htag p-ht-c">Released</span>
                </div>
                <div class="p-cb" style="padding: 0; overflow-x: auto;">
                    <table style="width: 100%; border-collapse: collapse;">
                        <thead style="background: #f8f9fa;">
                            <tr>
                                <th style="padding: 12px; text-align: left;">Test</th>
                                <th style="padding: 12px; text-align: center;">Result</th>
                                <th style="padding: 12px; text-align: left;">Unit</th>
                                <th style="padding: 12px; text-align: left;">Normal Range</th>
                                <th style="padding: 12px; text-align: center;">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var result in group)
                            {
                                <tr style="border-bottom: 1px solid #eee;">
                                    <td style="padding: 12px; font-weight: 600;">@result.TestName</td>
                                    <td style="padding: 12px; text-align: center;">
                                        <span style="color: @(result.IsAbnormal ? "#dc3545" : "#0f717e"); font-weight: bold;">
                                            @result.ResultValue
                                        </span>
                                    </td>
                                    <td style="padding: 12px; color: #666;">@result.Unit</td>
                                    <td style="padding: 12px; font-size: 0.85rem;">@result.NormalRange</td>
                                    <td style="padding: 12px; text-align: center;">
                                        @if (result.IsAbnormal)
                                        {
                                            <span class="p-htag p-ht-a" style="background: #f8d7da; color: #721c24;">ABNORMAL</span>
                                        }
                                        else
                                        {
                                            <span class="p-htag p-ht-c">NORMAL</span>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
                <div class="p-cb" style="border-top: 1px solid #eee; background: #fafafa;">
                    <button class="p-btn" style="background: #66788a; font-size: 0.85rem;">
                        <i class="fas fa-download"></i> Download Full Report (PDF)
                    </button>
                </div>
            </div>
        }
    </div>

    <div id="tab-track" style="display:none">
        <div class="p-card">
            <div class="p-ch">
                <div class="p-ct"><i class="fas fa-chart-line"></i> Analytics</div>
            </div>
            <div class="p-cb">
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 30px;">
                    <div>
                        <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Test Type</label>
                        <select class="p-input" style="width: 100%;">
                            @foreach (var t in Model.Select(r => r.TestName).Distinct())
                            {
                                <option>@t</option>
                            }
                        </select>
                    </div>
                    <div>
                        <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Date Range</label>
                        <select class="p-input" style="width: 100%;">
                            <option>Last 6 months</option>
                            <option>Last 12 months</option>
                            <option>All time</option>
                        </select>
                    </div>
                </div>

                <h4 style="color: #0f717e; margin-bottom: 15px;">HbA1c Trend Analysis</h4>

                <div style="display: flex; flex-direction: column; gap: 12px; margin-bottom: 25px;">
                    @* Prototype Chart Bars *@
                    @{
                        var months = new[] { "Dec 2025", "Jan 2026", "Feb 2026", "Mar 2026", "Apr 2026", "May 2026" };
                        var values = new[] { 9.1, 8.8, 8.6, 9.3, 8.3, 8.9 };
                    }
                    @for (int i = 0; i < months.Length; i++)
                    {
                        <div style="display: flex; align-items: center; gap: 15px;">
                            <div style="width: 80px; font-size: 0.85rem; color: #666;">@months[i]</div>
                            <div style="flex: 1; height: 12px; background: #eee; border-radius: 6px; overflow: hidden;">
                                <div style="width: @(values[i] * 10)%; height: 100%; background: @(values[i] > 9.0 ? "#dc3545" : values[i] > 7.0 ? "#ffa000" : "#0f717e");"></div>
                            </div>
                            <div style="width: 40px; font-weight: bold; color: #1a4c6e;">@values[i]%</div>
                        </div>
                    }
                </div>

                <div style="background: #f0f7f8; padding: 15px; border-radius: 8px; font-size: 0.85rem; color: #0f717e;">
                    <i class="fas fa-info-circle"></i> **Target:** Less than 7.0%. Values above 7% are highlighted for your attention.
                </div>
            </div>
        </div>
    </div>
</div>

<style>
    .tab-btn {
        background: transparent;
        border: none;
        padding: 10px 20px;
        font-size: 1rem;
        color: #66788a;
        cursor: pointer;
        transition: all 0.3s;
        border-radius: 8px 8px 0 0;
    }

        .tab-btn.active {
            color: #0f717e;
            font-weight: 700;
            border-bottom: 3px solid #0f717e;
        }

        .tab-btn:hover {
            background: #f0f7f8;
        }

    .p-input {
        padding: 10px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
    }

    th {
        font-size: 0.75rem;
        text-transform: uppercase;
        color: #1a4c6e;
        letter-spacing: 0.5px;
    }
</style>

@section Scripts {
    <script>
        function switchResultTab(el, tabId) {
            document.querySelectorAll('.tab-btn').forEach(t => t.classList.remove('active'));
            el.classList.add('active');
            document.getElementById('tab-list').style.display = tabId === 'tab-list' ? '' : 'none';
            document.getElementById('tab-track').style.display = tabId === 'tab-track' ? '' : 'none';
        }
    </script>
}