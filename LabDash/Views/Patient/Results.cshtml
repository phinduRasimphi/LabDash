@section Scripts {

    
    <script>

        function switchResultsTab(button, tabId) {

            document
                .querySelectorAll('.rx-tab')
                .forEach(tab =>
                    tab.classList.remove('active'));

            button.classList.add('active');

            document.getElementById('rx-all').style.display =
                tabId === 'rx-all' ? '' : 'none';

            document.getElementById('rx-analytics').style.display =
                tabId === 'rx-analytics' ? '' : 'none';

        }

    </script>
    

}
