@model List<LabDash.Models.TestResultViewModel>

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Results";
    ViewData["ActivePage"] = "Results";


var results = Model ?? new List<LabDash.Models.TestResultViewModel>();

    var totalResults = results.Count;
    var releasedPanels = results.Select(r => r.RequestID).Distinct().Count();
    var abnormalResults = results.Count(r => r.IsAbnormal);
    var normalResults = results.Count(r => !r.IsAbnormal);

    var testTypes = results
        .Select(r => r.TestName)
        .Where(x => !string.IsNullOrWhiteSpace(x))
        .Distinct()
        .Count();

    var abnormalPercentage = totalResults > 0
        ? (double)abnormalResults / totalResults * 100
        : 0;

    var normalPercentage = totalResults > 0
        ? (double)normalResults / totalResults * 100
        : 0;


}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

<div class="rx-wrap">

    
    <!-- =====================================================
     HERO
====================================================== -->

    <section class="rx-hero">

        <div class="rx-hero-pattern"></div>

        <div class="rx-hero-left">

            <div class="rx-hero-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>

                <div class="rx-eyebrow">
                    <i class="fas fa-flask"></i>
                    Laboratory Results
                </div>

                <h1>My Test Results</h1>

                <p>
                    Review your laboratory results, monitor abnormal
                    values and follow your health information over time.
                </p>

            </div>

        </div>


        <div class="rx-hero-right">

            <span class="rx-active-status">
                <span></span>
                Results Portal
            </span>

            <div class="rx-hero-number">
                <strong>@releasedPanels</strong>
                <small>Released Panels</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
     SUMMARY STATISTICS
====================================================== -->

    <section class="rx-stats">

        <div class="rx-stat-card">

            <div class="rx-stat-icon rx-stat-teal">
                <i class="fas fa-vial"></i>
            </div>

            <div class="rx-stat-content">
                <span>Total Results</span>
                <strong>@totalResults</strong>
                <small>Laboratory values</small>
            </div>

        </div>


        <div class="rx-stat-card">

            <div class="rx-stat-icon rx-stat-green">
                <i class="fas fa-circle-check"></i>
            </div>

            <div class="rx-stat-content">
                <span>Normal</span>
                <strong>@normalResults</strong>
                <small>
                    @normalPercentage.ToString("0")% of results
                </small>
            </div>

        </div>


        <div class="rx-stat-card">

            <div class="rx-stat-icon rx-stat-red">
                <i class="fas fa-triangle-exclamation"></i>
            </div>

            <div class="rx-stat-content">
                <span>Needs Attention</span>
                <strong>@abnormalResults</strong>
                <small>
                    @abnormalPercentage.ToString("0")% of results
                </small>
            </div>

        </div>


        <div class="rx-stat-card">

            <div class="rx-stat-icon rx-stat-purple">
                <i class="fas fa-microscope"></i>
            </div>

            <div class="rx-stat-content">
                <span>Test Types</span>
                <strong>@testTypes</strong>
                <small>Different tests</small>
            </div>

        </div>

    </section>


    <!-- =====================================================
     EMPTY STATE
====================================================== -->
    @if (!results.Any())
    {
        <section class="rx-empty-panel">

            <div class="rx-empty-visual">

                <div class="rx-empty-circle">
                    <i class="fas fa-flask-vial"></i>
                </div>

                <span class="rx-empty-orbit rx-orbit-one"></span>
                <span class="rx-empty-orbit rx-orbit-two"></span>

            </div>

            <div class="rx-empty-content">

                <span class="rx-empty-label">
                    <i class="fas fa-info-circle"></i>
                    No Results Available
                </span>

                <h2>Your laboratory results will appear here</h2>

                <p>
                    You currently don't have any released laboratory
                    results on your patient record. Once a laboratory
                    test has been completed and released, your results
                    will automatically appear on this page.
                </p>

                <div class="rx-empty-steps">

                    <div>
                        <span>01</span>
                        <p>Test requested</p>
                    </div>

                    <div class="rx-step-line"></div>

                    <div>
                        <span>02</span>
                        <p>Sample processed</p>
                    </div>

                    <div class="rx-step-line"></div>

                    <div>
                        <span>03</span>
                        <p>Result released</p>
                    </div>

                </div>

            </div>

        </section>
   


    <!-- =====================================================
     RESULTS AVAILABLE
====================================================== -->
  

    <div class="rx-tabs">

        <button class="rx-tab active"
                onclick="switchResultsTab(this,'rx-all')">

            <i class="fas fa-list"></i>
            All Results

        </button>

        <button class="rx-tab"
                onclick="switchResultsTab(this,'rx-analytics')">

            <i class="fas fa-chart-line"></i>
            Health Analytics

        </button>

    </div>


    <!-- =================================================
         ALL RESULTS
    ================================================== -->

    <div id="rx-all">

        @foreach (var group in results.GroupBy(r => r.RequestID))
        {
            <article class="rx-panel">

                <div class="rx-panel-header">

                    <div class="rx-panel-title">

                        <div class="rx-panel-icon">
                            <i class="fas fa-flask"></i>
                        </div>

                        <div>

                            <span>Laboratory Request</span>

                            <h3>
                                #@group.Key
                                <span>•</span>
                                @group.First().Category
                            </h3>

                        </div>

                    </div>


                    <div class="rx-released">
                        <i class="fas fa-circle-check"></i>
                        Released
                    </div>

                </div>


                <div class="rx-panel-body">

                    @foreach (var result in group)
                    {
                        double lo = 0;
                        double hi = 100;
                        double val = 0;

                        bool canGauge = false;

                        if (!string.IsNullOrWhiteSpace(result.NormalRange)
                            && double.TryParse(result.ResultValue, out val))
                        {
                            var parts = result.NormalRange.Split('-');

                            if (parts.Length == 2
                                && double.TryParse(parts[0].Trim(), out lo)
                                && double.TryParse(parts[1].Trim(), out hi)
                                && hi > lo)
                            {
                                canGauge = true;
                            }
                        }

                        var span = hi - lo;

                        if (span <= 0)
                        {
                            span = 100;
                        }

                        var paddedLo = lo - span * .4;
                        var paddedHi = hi + span * .4;
                        var paddedSpan = paddedHi - paddedLo;

                        var bandStart = canGauge
                            ? ((lo - paddedLo) / paddedSpan) * 100
                            : 20;

                        var bandWidth = canGauge
                            ? ((hi - lo) / paddedSpan) * 100
                            : 60;

                        var marker = canGauge
                            ? Math.Clamp(
                                ((val - paddedLo) / paddedSpan) * 100,
                                2,
                                98)
                            : 50;


                        <div class="rx-result">

                            <div class="rx-result-name">

                                <span>
                                    <i class="fas fa-vial"></i>
                                </span>

                                <div>
                                    <strong>@result.TestName</strong>
                                    <small>Laboratory measurement</small>
                                </div>

                            </div>


                            <div class="rx-value">

                                <strong class="@(result.IsAbnormal ? "rx-abnormal-text" : "")">
                                    @result.ResultValue
                                </strong>

                                <span>@result.Unit</span>

                            </div>


                            <div class="rx-gauge-area">

                                <div class="rx-gauge">

                                    <div class="rx-gauge-normal"
                                         style="left:@bandStart.ToString("0.##")%;width:@bandWidth.ToString("0.##")%;">
                                    </div>

                                    <div class="rx-gauge-marker @(result.IsAbnormal ? "rx-marker-abnormal" : "")"
                                         style="left:@marker.ToString("0.##")%;">
                                    </div>

                                </div>

                                <small>
                                    Reference:
                                    @result.NormalRange
                                    @result.Unit
                                </small>

                            </div>


                            <div class="rx-status">

                                @if (result.IsAbnormal)
                                {
                                    <span class="rx-badge rx-badge-danger">
                                        <i class="fas fa-triangle-exclamation"></i>
                                        Abnormal
                                    </span>
                                }
                                else
                                {
                                    <span class="rx-badge rx-badge-normal">
                                        <i class="fas fa-check"></i>
                                        Normal
                                    </span>
                                }

                            </div>

                        </div>
                    }

                </div>


                <div class="rx-panel-footer">

                    <span>
                        <i class="fas fa-clock"></i>
                        Laboratory report
                    </span>

                    <button class="rx-download">
                        <i class="fas fa-download"></i>
                        Download Report
                    </button>

                </div>

            </article>
        }

    </div>


    <!-- =================================================
         ANALYTICS
    ================================================== -->

    <div id="rx-analytics" style="display:none;">

        <section class="rx-analytics-intro">

            <div>

                <span class="rx-section-label">
                    <i class="fas fa-chart-line"></i>
                    Results Overview
                </span>

                <h2>Your Results at a Glance</h2>

                <p>
                    A summary of the laboratory information currently
                    available on your patient record.
                </p>

            </div>

            <div class="rx-analytics-total">

                <strong>@totalResults</strong>
                <span>Total Values</span>

            </div>

        </section>


        <div class="rx-analytics-grid">

            <!-- Normal vs Abnormal -->
            <div class="rx-chart-card">

                <div class="rx-chart-header">

                    <div>
                        <span>Result Status</span>
                        <h3>Normal vs Attention</h3>
                    </div>

                    <i class="fas fa-chart-pie"></i>

                </div>


                @if (totalResults > 0)
                {
                    <div class="rx-donut">

                        <div class="rx-donut-inner">

                            <strong>
                                @normalPercentage.ToString("0")%
                            </strong>

                            <span>Normal</span>

                        </div>

                    </div>


                    <div class="rx-legend">

                        <div>
                            <span class="rx-dot rx-dot-green"></span>
                            <span>Normal</span>
                            <strong>@normalResults</strong>
                        </div>

                        <div>
                            <span class="rx-dot rx-dot-red"></span>
                            <span>Abnormal</span>
                            <strong>@abnormalResults</strong>
                        </div>

                    </div>
                }

            </div>


            <!-- Test Types -->
            <div class="rx-chart-card">

                <div class="rx-chart-header">

                    <div>
                        <span>Laboratory Activity</span>
                        <h3>Tests Performed</h3>
                    </div>

                    <i class="fas fa-vials"></i>

                </div>


                <div class="rx-test-bars">

                    @foreach (var test in results
                        .GroupBy(r => r.TestName)
                        .OrderByDescending(g => g.Count())
                        .Take(6))
                    {
                        var width = totalResults > 0
                            ? (double)test.Count() / totalResults * 100
                            : 0;

                        <div class="rx-test-bar">

                            <div class="rx-test-label">
                                <span>@test.Key</span>
                                <strong>@test.Count()</strong>
                            </div>

                            <div class="rx-bar-track">

                                <div class="rx-bar-fill"
                                     style="width:@width.ToString("0.##")%;">
                                </div>

                            </div>

                        </div>
                    }

                </div>

            </div>

        </div>


        <!-- IMPORTANT NOTICE -->

        <div class="rx-analytics-note">

            <div class="rx-note-icon">
                <i class="fas fa-chart-line"></i>
            </div>

            <div>

                <strong>About health trends</strong>

                <p>
                    Trend analysis becomes available when multiple
                    results for the same laboratory test are recorded
                    over time. Your results page currently displays
                    the information available in your patient record.
                </p>

            </div>

        </div>

    </div>

    }


    <!-- =====================================================
     FOOTER
====================================================== -->

    <footer class="rx-footer">

        <div>
            <i class="fas fa-shield-halved"></i>
            Laboratory Information Management System
        </div>

        <span>Patient Portal</span>

        <span>•</span>

        <span>@DateTime.Now.Year</span>

    </footer>
    ```

</div>

<style>

    /* ==========================================================
           RESULTS PAGE
           =========================================================== */

    :root {
        --rx-paper: #F0F7F6;
        --rx-white: #FFFFFF;
        --rx-ink: #102C27;
        --rx-soft: #52716C;
        --rx-faint: #8FA9A3;
        --rx-line: #E1EEEC;
        --rx-line-strong: #CCE3DF;
        --rx-teal: #0E8C7F;
        --rx-teal-deep: #0A5850;
        --rx-teal-light: #E3F4F1;
        --rx-teal-start: #12A392;
        --rx-teal-end: #0A4F48;
        --rx-green: #2E8B57;
        --rx-green-light: #E3F4EA;
        --rx-red: #B0463F;
        --rx-red-light: #F7E8E7;
        --rx-purple: #6D4EA8;
        --rx-purple-light: #EEE8F9;
        --rx-radius: 20px;
        --rx-radius-sm: 13px;
        --rx-shadow: 0 8px 28px rgba(10,60,55,.08);
    }


    * {
        box-sizing: border-box;
    }


    .rx-wrap {
        max-width: 1200px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        color: var(--rx-ink);
        font-family: 'Inter', sans-serif;
        animation: rxFade .45s ease;
    }


    @@keyframes rxFade {

        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* ==========================================================
           HERO
           =========================================================== */

    .rx-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 30px 34px;
        margin-bottom: 20px;
        border-radius: var(--rx-radius);
        overflow: hidden;
        background: linear-gradient( 125deg, var(--rx-teal-start), var(--rx-teal-end) );
        box-shadow: 0 18px 45px rgba(10,90,80,.20);
    }


    .rx-hero-pattern {
        position: absolute;
        inset: 0;
        background: radial-gradient( circle at 85% 15%, rgba(255,255,255,.13), transparent 35% ), radial-gradient( circle at 100% 100%, rgba(255,255,255,.08), transparent 35% );
    }


    .rx-hero-left {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 18px;
    }


    .rx-hero-icon {
        width: 62px;
        height: 62px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 17px;
        color: #fff;
        font-size: 23px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.3);
    }


    .rx-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        color: rgba(255,255,255,.7);
        font-size: 10px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }


    .rx-hero h1 {
        margin: 0 0 4px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 25px;
    }


    .rx-hero p {
        max-width: 590px;
        margin: 0;
        color: rgba(255,255,255,.84);
        font-size: 13px;
        line-height: 1.5;
    }


    .rx-hero-right {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 22px;
    }


    .rx-active-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        color: #fff;
        font-size: 10.5px;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.2);
    }


        .rx-active-status span {
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: #79E1D2;
            box-shadow: 0 0 0 4px rgba(121,225,210,.14);
        }


    .rx-hero-number {
        padding-left: 22px;
        border-left: 1px solid rgba(255,255,255,.25);
        display: flex;
        flex-direction: column;
    }


        .rx-hero-number strong {
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 27px;
            line-height: 1;
        }


        .rx-hero-number small {
            margin-top: 4px;
            color: rgba(255,255,255,.65);
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .06em;
        }


    /* ==========================================================
           STAT CARDS
           =========================================================== */

    .rx-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 14px;
        margin-bottom: 24px;
    }


    .rx-stat-card {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 16px;
        background: #fff;
        border: 1px solid var(--rx-line);
        border-radius: 17px;
        box-shadow: var(--rx-shadow);
        transition: .2s ease;
    }


        .rx-stat-card:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 32px rgba(10,60,55,.12);
        }


    .rx-stat-icon {
        width: 44px;
        height: 44px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 12px;
        font-size: 16px;
    }


    .rx-stat-teal {
        color: var(--rx-teal);
        background: var(--rx-teal-light);
    }


    .rx-stat-green {
        color: var(--rx-green);
        background: var(--rx-green-light);
    }


    .rx-stat-red {
        color: var(--rx-red);
        background: var(--rx-red-light);
    }


    .rx-stat-purple {
        color: var(--rx-purple);
        background: var(--rx-purple-light);
    }


    .rx-stat-content {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }


        .rx-stat-content span {
            color: var(--rx-soft);
            font-size: 10.5px;
            font-weight: 600;
        }


        .rx-stat-content strong {
            margin-top: 1px;
            font-family: 'Poppins', sans-serif;
            font-size: 22px;
            line-height: 1;
        }


        .rx-stat-content small {
            margin-top: 3px;
            color: var(--rx-faint);
            font-size: 9px;
        }


    /* ==========================================================
           EMPTY STATE
           =========================================================== */

    .rx-empty-panel {
        display: flex;
        align-items: center;
        gap: 55px;
        padding: 50px;
        margin-top: 8px;
        background: #fff;
        border: 1px solid var(--rx-line);
        border-radius: var(--rx-radius);
        box-shadow: var(--rx-shadow);
    }


    .rx-empty-visual {
        position: relative;
        width: 180px;
        height: 180px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
    }


    .rx-empty-circle {
        width: 110px;
        height: 110px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        color: var(--rx-teal);
        font-size: 35px;
        background: var(--rx-teal-light);
        box-shadow: 0 0 0 14px rgba(14,140,127,.05), 0 0 0 28px rgba(14,140,127,.025);
    }


    .rx-empty-orbit {
        position: absolute;
        border: 1px dashed var(--rx-line-strong);
        border-radius: 50%;
    }


    .rx-orbit-one {
        width: 145px;
        height: 145px;
        animation: rxRotate 12s linear infinite;
    }


    .rx-orbit-two {
        width: 175px;
        height: 175px;
        animation: rxRotate 18s linear infinite reverse;
    }


    @@keyframes rxRotate {

        to {
            transform: rotate(360deg);
        }
    }


    .rx-empty-content {
        max-width: 600px;
    }


    .rx-empty-label {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 6px 10px;
        border-radius: 999px;
        color: var(--rx-teal-deep);
        background: var(--rx-teal-light);
        font-size: 10px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .05em;
    }


    .rx-empty-content h2 {
        margin: 13px 0 7px;
        font-family: 'Poppins', sans-serif;
        font-size: 22px;
    }


    .rx-empty-content > p {
        max-width: 600px;
        margin: 0;
        color: var(--rx-soft);
        font-size: 12.5px;
        line-height: 1.65;
    }


    .rx-empty-steps {
        display: flex;
        align-items: center;
        margin-top: 25px;
    }


        .rx-empty-steps > div:not(.rx-step-line) {
            display: flex;
            align-items: center;
            gap: 8px;
        }


        .rx-empty-steps span {
            width: 28px;
            height: 28px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            color: var(--rx-teal);
            background: var(--rx-teal-light);
            font-size: 9px;
            font-weight: 700;
        }


        .rx-empty-steps p {
            margin: 0;
            color: var(--rx-soft);
            font-size: 10px;
            font-weight: 600;
        }


    .rx-step-line {
        width: 35px;
        height: 1px;
        margin: 0 10px;
        background: var(--rx-line-strong);
    }


    /* ==========================================================
           TABS
           =========================================================== */

    .rx-tabs {
        display: flex;
        width: fit-content;
        gap: 5px;
        padding: 5px;
        margin-bottom: 18px;
        border-radius: 999px;
        background: #fff;
        box-shadow: var(--rx-shadow);
    }


    .rx-tab {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 10px 18px;
        border: none;
        border-radius: 999px;
        color: var(--rx-soft);
        background: transparent;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 600;
        cursor: pointer;
    }


        .rx-tab.active {
            color: #fff;
            background: linear-gradient( 120deg, var(--rx-teal-start), var(--rx-teal-end) );
            box-shadow: 0 6px 15px rgba(10,90,80,.2);
        }


    /* ==========================================================
           RESULT PANEL
           =========================================================== */

    .rx-panel {
        margin-bottom: 18px;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--rx-line);
        border-radius: var(--rx-radius);
        box-shadow: var(--rx-shadow);
    }


    .rx-panel-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 18px 22px;
        border-bottom: 1px solid var(--rx-line);
    }


    .rx-panel-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .rx-panel-icon {
        width: 40px;
        height: 40px;
        display: flex;
