@model LabDash.Models.PatientProfileViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = "Profile";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="p-wrap">

    <!-- ==========================================
        BANNER
    =========================================== -->
    <div class="p-banner">
        <div class="p-banner-pattern"></div>

        <div class="p-banner-left">
            <div class="p-banner-avatar">
                <span class="p-icon-ring"></span>
                @Model.Initials
            </div>
            <div class="p-banner-text">
                <h1>My Profile <span></span></h1>
                <p>Manage your personal information and account security.</p>
                <div class="p-pills">
                    <span class="p-pill"><i class="fas fa-id-card"></i> Patient ID: PAT-@Model.PatientID.ToString("D5")</span>
                    <span class="p-pill"><i class="fas fa-user"></i> @Model.FullName</span>
                </div>
            </div>
        </div>

        <a href="@Url.Action("ChangePassword", "Account")" class="p-banner-cta">
            <i class="fas fa-key"></i> Change Password
        </a>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    <!-- ==========================================
        SECURITY NOTE STRIP
    =========================================== -->
    <div class="p-status-strip">
        <div class="p-status-left">
            <span class="p-status-dot"></span>
            <span><strong>Locked fields</strong> &middot; ID Number and Date of Birth can only be changed by visiting a clinic administrator</span>
        </div>
        <i class="fas fa-lock"></i>
    </div>

    <!-- ==========================================
        FORM
    =========================================== -->
    <div class="p-panel">
        <div class="p-panel-head">
            <span><i class="fa-solid fa-address-card"></i> Personal Information</span>
            <span class="p-panel-tag">Editable</span>
        </div>

        <div class="p-panel-body">
            <form asp-action="Profile" method="post">
                @Html.AntiForgeryToken()
                <div asp-validation-summary="ModelOnly" class="p-validation"></div>

                <div class="p-grid-2">
                    <div class="p-field">
                        <label>First Name</label>
                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Name" class="p-input" />
                        </div>
                        <span asp-validation-for="Name" class="p-field-error"></span>
                    </div>
                    <div class="p-field">
                        <label>Surname</label>
                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Surname" class="p-input" />
                        </div>
                        <span asp-validation-for="Surname" class="p-field-error"></span>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-field">
                        <label>SA ID Number <i class="fa-solid fa-lock p-lock-icon"></i></label>
                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-fingerprint"></i>
                            <input asp-for="IDNumber" readonly class="p-input p-input-locked" />
                        </div>
                    </div>
                    <div class="p-field">
                        <label>Date of Birth <i class="fa-solid fa-lock p-lock-icon"></i></label>
                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-cake-candles"></i>
                            <input asp-for="DateOfBirth" type="date" readonly class="p-input p-input-locked" />
                        </div>
                    </div>
                </div>

                <div class="p-grid-2">
                    <div class="p-field">
                        <label>E-mail (Username)</label>
                        <div class="p-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Email" type="email" class="p-input" />
                        </div>
                        <span asp-validation-for="Email" class="p-field-error"></span>
                    </div>
                    <div class="p-field">
                        <label>Cellphone</label>
                        <div class="p-input-wrap">
                            <i class="fa-solid fa-mobile-screen"></i>
                            <input asp-for="Cellphone" class="p-input" />
                        </div>
                        <span asp-validation-for="Cellphone" class="p-field-error"></span>
                    </div>
                </div>

                <div class="p-field p-field-full">
                    <label>Home Address</label>
                    <div class="p-input-wrap p-input-wrap-textarea">
                        <i class="fa-solid fa-location-dot"></i>
                        <textarea asp-for="HomeAddress" class="p-input p-textarea"></textarea>
                    </div>
                </div>

                <button type="submit" class="p-submit">
                    <i class="fas fa-save"></i> Save Profile Changes
                </button>
            </form>
        </div>
    </div>

    <!-- ==========================================
        FOOTER
    =========================================== -->
    <div class="p-footer">
        <hr />
        <div class="p-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="p-footer-divider">|</span>
            <span>Patient Portal</span>
            <span class="p-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </div>

</div>

<style>
    :root {
        --p-paper: #F0F7F6;
        --p-raised: #FFFFFF;
        --p-ink: #102C27;
        --p-ink-soft: #52716C;
        --p-ink-faint: #8FA9A3;
        --p-line: #E1EEEC;
        --p-line-strong: #CCE3DF;
        --p-teal: #0E8C7F;
        --p-teal-deep: #0A5850;
        --p-teal-dim: #E3F4F1;
        --p-teal-grad-start: #12A392;
        --p-teal-grad-end: #0A4F48;
        --p-radius: 20px;
        --p-radius-sm: 13px;
        --p-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --p-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    .p-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--p-ink);
        font-family: 'Inter', sans-serif;
        animation: pFadeIn .5s ease;
    }

    @@keyframes pFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============ BANNER ============ */
    .p-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        border-radius: var(--p-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }

    .p-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .p-banner-left {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .p-banner-avatar {
        position: relative;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 24px;
        flex-shrink: 0;
    }

    .p-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: pRingPulse 2.4s ease-out infinite;
    }

    @@keyframes pRingPulse {
        0% {
            transform: scale(0.9);
            opacity: .8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .p-banner-text {
        position: relative;
        z-index: 1;
    }

        .p-banner-text h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin: 0 0 4px;
            color: #fff;
            letter-spacing: -.01em;
        }

        .p-banner-text p {
            margin: 0 0 14px;
            color: rgba(255,255,255,.85);
            font-size: 14.5px;
        }

    .p-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .p-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
    }

    .p-banner-cta {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 13.5px;
        padding: 12px 20px;
        border-radius: 999px;
        transition: background .2s, transform .2s;
    }

        .p-banner-cta:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* ============ TOAST ============ */
    .p-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 15px 20px;
        border-radius: var(--p-radius-sm);
        margin-bottom: 20px;
        border-left: 4px solid var(--p-teal);
        font-size: 14px;
        font-weight: 500;
    }

    /* ============ STATUS STRIP ============ */
    .p-status-strip {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow-sm);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        border-left: 4px solid var(--p-teal);
    }

    .p-status-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13.5px;
        color: var(--p-ink);
    }

        .p-status-left strong {
            color: var(--p-teal-deep);
        }

    .p-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--p-teal);
        flex-shrink: 0;
        box-shadow: 0 0 0 4px var(--p-teal-dim);
    }

    .p-status-strip > i {
        color: var(--p-ink-faint);
        font-size: 15px;
    }

    /* ============ PANEL ============ */
    .p-panel {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow);
        overflow: hidden;
    }

    .p-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--p-line);
    }

        .p-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            color: var(--p-ink);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .p-panel-head span:first-child i {
                color: var(--p-teal);
            }

    .p-panel-tag {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 11.5px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    .p-panel-body {
        padding: 28px 30px 32px;
    }

    .p-validation {
        color: #B0463F;
        font-size: 13.5px;
        margin-bottom: 15px;
    }

    /* ============ FORM ============ */
    .p-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 22px;
    }

    .p-field {
        display: flex;
        flex-direction: column;
    }

    .p-field-full {
        margin-bottom: 8px;
    }

    .p-field label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--p-ink);
        margin-bottom: 8px;
    }

    .p-lock-icon {
        font-size: 11px;
        color: var(--p-ink-faint);
    }

    .p-input-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-paper);
        border: 1.5px solid var(--p-line-strong);
        border-radius: var(--p-radius-sm);
        padding: 0 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

        .p-input-wrap i {
            color: var(--p-teal);
            font-size: 14px;
            flex-shrink: 0;
        }

        .p-input-wrap:focus-within {
            border-color: var(--p-teal);
            background: #fff;
            box-shadow: 0 0 0 4px var(--p-teal-dim);
        }

    .p-input-wrap-locked {
        background: var(--p-line);
        border-color: var(--p-line);
    }

        .p-input-wrap-locked i {
            color: var(--p-ink-faint);
        }

    .p-input {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        padding: 12px 0;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: var(--p-ink);
    }

    .p-input-locked {
        color: var(--p-ink-faint);
        cursor: not-allowed;
    }

    .p-input-wrap-textarea {
        align-items: flex-start;
        padding-top: 12px;
    }

    .p-textarea {
        height: 80px;
        resize: none;
        padding: 0 0 12px;
    }

    .p-field-error {
        color: #B0463F;
        font-size: 12px;
        margin-top: 6px;
    }

    .p-submit {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 12px;
        padding: 15px;
        border: none;
        border-radius: var(--p-radius-sm);
        background: linear-gradient(120deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(10, 90, 80, 0.22);
        transition: transform .2s, box-shadow .2s;
    }

        .p-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(10, 90, 80, 0.28);
        }

    /* ============ FOOTER ============ */
    .p-footer {
        margin-top: 40px;
        text-align: center;
    }

        .p-footer hr {
            border: none;
            border-top: 1px solid var(--p-line);
            margin-bottom: 22px;
        }

    .p-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--p-ink-faint);
        font-size: 13px;
    }

        .p-footer-content i {
            color: var(--p-teal);
        }

    .p-footer-divider {
        color: var(--p-line-strong);
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 900px) {
        .p-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .p-banner-cta {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 640px) {
        .p-wrap {
            padding: 20px 16px 50px;
        }

        .p-grid-2 {
            grid-template-columns: 1fr;
        }

        .p-panel-body {
            padding: 22px 18px 26px;
        }

        .p-status-strip {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>
