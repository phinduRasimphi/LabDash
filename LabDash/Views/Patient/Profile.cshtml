@model LabDash.Models.PatientProfileViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = "Profile";
}

<div class="p-content">
    <div class="p-hero">
        <div class="p-hero-inner">
            <div>
                <h1 class="p-hero-title">My Profile 👤</h1>
                <p class="p-hero-subtitle">Manage your personal information and account security.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div style="background: #d4edda; color: #155724; padding: 15px; border-radius: 10px; margin-bottom: 20px; border-left: 5px solid #28a745;">
            <i class="fas fa-check-circle"></i> @TempData["SuccessMessage"]
        </div>
    }

    <div class="p-r2">
        <div style="display: flex; flex-direction: column; gap: 20px;">
            <div class="p-card">
                <div class="p-cb" style="text-align: center; padding: 30px 20px;">
                    <div style="width: 80px; height: 80px; background: #0f717e; color: white; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 2rem; font-weight: bold; margin: 0 auto 15px;">
                        @Model.Initials
                    </div>
                    <h3 style="color: #1a4c6e; margin-bottom: 5px;">@Model.FullName</h3>
                    <p style="color: #66788a; font-size: 0.9rem;">Patient ID: PAT-@Model.PatientID.ToString("D5")</p>

                    <div style="margin-top: 20px; padding-top: 20px; border-top: 1px solid #eee;">
                        <a href="@Url.Action("ChangePassword", "Account")" class="p-btn" style="background: #66788a; width: 100%; display: inline-block; text-decoration: none;">
                            <i class="fas fa-key"></i> Change Password
                        </a>
                    </div>
                </div>
            </div>

            <div class="p-card" style="background: #f0f7f8; border: none;">
                <div class="p-cb">
                    <h4 style="color: #0f717e; margin-bottom: 10px;"><i class="fas fa-info-circle"></i> Security Note</h4>
                    <p style="font-size: 0.85rem; color: #555;">Locked fields (ID Number and DOB) can only be changed by visiting a clinic administrator.</p>
                </div>
            </div>
        </div>

        <div class="p-card">
            <div class="p-ch">
                <div class="p-ct">Personal Information</div>
            </div>
            <div class="p-cb">
                <form asp-action="Profile" method="post">
                    @Html.AntiForgeryToken()
                    <div asp-validation-summary="ModelOnly" style="color: #dc3545; font-size: 0.9rem; margin-bottom: 15px;"></div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">First Name</label>
                            <input asp-for="Name" class="p-input" style="width: 100%;" />
                            <span asp-validation-for="Name" style="color: #dc3545; font-size: 0.8rem;"></span>
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Surname</label>
                            <input asp-for="Surname" class="p-input" style="width: 100%;" />
                            <span asp-validation-for="Surname" style="color: #dc3545; font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">SA ID Number</label>
                            <input asp-for="IDNumber" readonly style="width: 100%; background: #f9f9f9; color: #999; border: 1px solid #ddd; padding: 10px; border-radius: 8px;" />
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Date of Birth</label>
                            <input asp-for="DateOfBirth" type="date" readonly style="width: 100%; background: #f9f9f9; color: #999; border: 1px solid #ddd; padding: 10px; border-radius: 8px;" />
                        </div>
                    </div>

                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 20px; margin-bottom: 20px;">
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">E-mail (Username)</label>
                            <input asp-for="Email" type="email" class="p-input" style="width: 100%;" />
                            <span asp-validation-for="Email" style="color: #dc3545; font-size: 0.8rem;"></span>
                        </div>
                        <div>
                            <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Cellphone</label>
                            <input asp-for="Cellphone" class="p-input" style="width: 100%;" />
                            <span asp-validation-for="Cellphone" style="color: #dc3545; font-size: 0.8rem;"></span>
                        </div>
                    </div>

                    <div style="margin-bottom: 25px;">
                        <label style="display: block; font-weight: 600; color: #1a4c6e; margin-bottom: 5px;">Home Address</label>
                        <textarea asp-for="HomeAddress" class="p-input" style="width: 100%; height: 80px; resize: none;"></textarea>
                    </div>

                    <button type="submit" class="p-btn" style="width: 100%; padding: 15px; font-size: 1rem;">
                        <i class="fas fa-save"></i> Save Profile Changes
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>

<style>
    .p-input {
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.3s, box-shadow 0.3s;
    }

        .p-input:focus {
            border-color: #0f717e;
            box-shadow: 0 0 5px rgba(15, 113, 126, 0.2);
        }
</style>