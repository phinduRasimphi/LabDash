@model LabDash.Models.PatientProfileViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = "Profile";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="p-wrap">

    <!-- =========================================================
         HEADER
         ========================================================= -->
    <div class="p-banner">
        <div class="p-banner-pattern"></div>

        <div class="p-banner-left">
            <div class="p-banner-avatar">
                <span class="p-icon-ring"></span>
                @Model.Initials
            </div>

            <div class="p-banner-text">
                <h1>My Profile</h1>

                <p>
                    Manage your personal information, address and health information.
                </p>

                <div class="p-pills">
                    <span class="p-pill">
                        <i class="fas fa-id-card"></i>
                        Patient ID: PAT-@Model.PatientID.ToString("D5")
                    </span>

                    <span class="p-pill">
                        <i class="fas fa-user"></i>
                        @Model.FullName
                    </span>
                </div>
            </div>
        </div>

        <a href="@Url.Action("ChangePassword", "Account")"
           class="p-banner-cta">
            <i class="fas fa-key"></i>
            Change Password
        </a>
    </div>


    <!-- =========================================================
         SUCCESS MESSAGE
         ========================================================= -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div class="p-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }


    <!-- =========================================================
         LOCKED INFORMATION NOTICE
         ========================================================= -->
    <div class="p-status-strip">
        <div class="p-status-left">
            <span class="p-status-dot"></span>

            <span>
                <strong>Locked fields</strong>
                &middot;
                ID Number and Date of Birth can only be changed
                by visiting a clinic administrator
            </span>
        </div>

        <i class="fas fa-lock"></i>
    </div>


    <form asp-action="Profile" asp-controller="Patient" method="post">

        @Html.AntiForgeryToken()

        <div asp-validation-summary="ModelOnly"
             class="p-validation"></div>


        <!-- =====================================================
             PERSONAL INFORMATION
             ===================================================== -->
        <div class="p-panel">

            <div class="p-panel-head">
                <span>
                    <i class="fa-solid fa-address-card"></i>
                    Personal Information
                </span>

                <span class="p-panel-tag">Editable</span>
            </div>

            <div class="p-panel-body">

                <div class="p-grid-2">

                    <div class="p-field">
                        <label>First Name</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Name"
                                   class="p-input"
                                   placeholder="Enter your first name" />
                        </div>

                        <span asp-validation-for="Name" class="p-field-error"></span>
                    </div>


                    <div class="p-field">
                        <label>Surname</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="Surname"
                                   class="p-input"
                                   placeholder="Enter your surname" />
                        </div>

                        <span asp-validation-for="Surname" class="p-field-error"></span>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>
                            SA ID Number
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-fingerprint"></i>
                            <input asp-for="IDNumber"
                                   readonly
                                   class="p-input p-input-locked" />
                        </div>

                        <span asp-validation-for="IDNumber" class="p-field-error"></span>
                    </div>


                    <div class="p-field">
                        <label>
                            Date of Birth
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-cake-candles"></i>
                            <input asp-for="DateOfBirth"
                                   type="date"
                                   readonly
                                   class="p-input p-input-locked" />
                        </div>

                        <span asp-validation-for="DateOfBirth" class="p-field-error"></span>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>E-mail (Username)</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Email"
                                   type="email"
                                   class="p-input"
                                   placeholder="Enter your email address" />
                        </div>

                        <span asp-validation-for="Email" class="p-field-error"></span>
                    </div>


                    <div class="p-field">
                        <label>Cellphone</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-mobile-screen"></i>
                            <input asp-for="Cellphone"
                                   class="p-input"
                                   placeholder="Enter your cellphone number" />
                        </div>

                        <span asp-validation-for="Cellphone" class="p-field-error"></span>
                    </div>

                </div>

            </div>
        </div>


        <!-- =====================================================
             ADDRESS
             ===================================================== -->
        <div class="p-panel p-section-panel">

            <div class="p-panel-head">
                <span>
                    <i class="fa-solid fa-location-dot"></i>
                    Address Information
                </span>

                <span class="p-panel-tag">Editable</span>
            </div>

            <div class="p-panel-body">

                <div class="p-grid-2">

                    <div class="p-field">
                        <label>Address Line 1</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-house"></i>
                            <input asp-for="AddressLine1"
                                   class="p-input"
                                   placeholder="House / unit number and street" />
                        </div>
                    </div>


                    <div class="p-field">
                        <label>Address Line 2</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-building"></i>
                            <input asp-for="AddressLine2"
                                   class="p-input"
                                   placeholder="Apartment, complex or additional address details" />
                        </div>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>Suburb</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-map-location-dot"></i>
                            <input asp-for="Suburb"
                                   class="p-input"
                                   placeholder="Enter your suburb" />
                        </div>
                    </div>


                    <div class="p-field">
                        <label>City</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-city"></i>
                            <input asp-for="City"
                                   class="p-input"
                                   placeholder="Enter your city" />
                        </div>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>Province</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-map"></i>

                            <select asp-for="Province"
                                    class="p-input p-select">

                                <option value="">Select Province</option>
                                <option value="Eastern Cape">Eastern Cape</option>
                                <option value="Free State">Free State</option>
                                <option value="Gauteng">Gauteng</option>
                                <option value="KwaZulu-Natal">KwaZulu-Natal</option>
                                <option value="Limpopo">Limpopo</option>
                                <option value="Mpumalanga">Mpumalanga</option>
                                <option value="Northern Cape">Northern Cape</option>
                                <option value="North West">North West</option>
                                <option value="Western Cape">Western Cape</option>

                            </select>
                        </div>
                    </div>


                    <div class="p-field">
                        <label>Postal Code</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-envelopes-bulk"></i>
                            <input asp-for="PostalCode"
                                   class="p-input"
                                   maxlength="4"
                                   inputmode="numeric"
                                   placeholder="e.g. 6001" />
                        </div>

                        <span asp-validation-for="PostalCode" class="p-field-error"></span>
                    </div>

                </div>

            </div>
        </div>


        <!-- =====================================================
             HEALTH INFORMATION
             ===================================================== -->
        <div class="p-panel p-section-panel">

            <div class="p-panel-head">
                <span>
                    <i class="fa-solid fa-heart-pulse"></i>
                    Health Information
                </span>

                <span class="p-panel-tag">Editable</span>
            </div>


            <div class="p-panel-body">


                <!-- =============================================
                     MEDICAL CONDITIONS
                     ============================================= -->
                <div class="p-health-section">

                    <div class="p-health-heading">
                        <div>
                            <h3>
                                <i class="fa-solid fa-notes-medical"></i>
                                Medical Conditions
                            </h3>

                            <p>Select any conditions you have been diagnosed with.</p>
                        </div>
                    </div>


                    <!-- SEARCH -->
                    <div class="p-health-tools">

                        <div class="p-input-wrap p-health-search-wrap">
                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="text"
                                   class="p-input p-health-search"
                                   data-search-group="medical"
                                   placeholder="Search medical conditions..." />

                            <button type="button"
                                    class="p-health-search-clear"
                                    data-clear-search="medical"
                                    title="Clear search">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <span class="p-health-results"
                              data-results-count="medical"></span>

                    </div>


                    <div class="p-options-grid"
                         data-options-group="medical">

                        <!-- NONE -->
                        <label class="p-check-card p-none-card">

                            <input type="checkbox"
                                   class="none-checkbox"
                                   data-group="medical" />

                            <span class="p-check-box"></span>

                            <span class="p-check-content">
                                <strong>None diagnosed</strong>
                                <small>I have no diagnosed medical conditions</small>
                            </span>

                        </label>


                        <!-- DATABASE OPTIONS -->
                        @foreach (var condition in Model.MedicalConditionOptions)
                        {
                            <label class="p-check-card health-option"
                                   data-health-option="medical"
                                   data-search-text="@condition.ConditionName.ToLowerInvariant()">

                                <input type="checkbox"
                                       name="SelectedMedicalConditionIds"
                                       value="@condition.MedicalConditionId"
                                       class="medical-option"
                                       data-group="medical"
                                @(Model.SelectedMedicalConditionIds.Contains(condition.MedicalConditionId)
                                    ? "checked"
                                    : "") />

                                <span class="p-check-box"></span>

                                <span class="p-check-content">
                                    <strong>@condition.ConditionName</strong>

                                    @if (!string.IsNullOrWhiteSpace(condition.Description))
                                    {
                                        <small>@condition.Description</small>
                                    }
                                </span>

                            </label>
                        }

                    </div>


                    <div class="p-health-empty"
                         data-empty-message="medical">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>No medical conditions match your search.</span>
                    </div>


                    <!-- PAGINATION -->
                    <div class="p-health-pagination"
                         data-pagination="medical"></div>


                    <!-- OTHER -->
                    <div class="p-other-field">

                        <label>Other Medical Condition</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-pen"></i>
                            <input asp-for="OtherMedicalCondition"
                                   class="p-input"
                                   placeholder="Enter another condition not listed above" />
                        </div>

                    </div>

                </div>


                <div class="p-health-divider"></div>


                <!-- =============================================
                     ALLERGIES
                     ============================================= -->
                <div class="p-health-section">

                    <div class="p-health-heading">
                        <div>
                            <h3>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Allergies
                            </h3>

                            <p>Select any allergies that apply to you.</p>
                        </div>
                    </div>


                    <!-- SEARCH -->
                    <div class="p-health-tools">

                        <div class="p-input-wrap p-health-search-wrap">
                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="text"
                                   class="p-input p-health-search"
                                   data-search-group="allergy"
                                   placeholder="Search allergies..." />

                            <button type="button"
                                    class="p-health-search-clear"
                                    data-clear-search="allergy"
                                    title="Clear search">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <span class="p-health-results"
                              data-results-count="allergy"></span>

                    </div>


                    <div class="p-options-grid"
                         data-options-group="allergy">

                        <!-- NONE -->
                        <label class="p-check-card p-none-card">

                            <input type="checkbox"
                                   class="none-checkbox"
                                   data-group="allergy" />

                            <span class="p-check-box"></span>

                            <span class="p-check-content">
                                <strong>No known allergies</strong>
                                <small>I do not have any known allergies</small>
                            </span>

                        </label>


                        <!-- DATABASE OPTIONS -->
                        @foreach (var allergy in Model.AllergyOptions)
                        {
                            <label class="p-check-card health-option"
                                   data-health-option="allergy"
                                   data-search-text="@allergy.AllergyName.ToLowerInvariant()">

                                <input type="checkbox"
                                       name="SelectedAllergyIds"
                                       value="@allergy.AllergyId"
                                       class="allergy-option"
                                       data-group="allergy"
                                @(Model.SelectedAllergyIds.Contains(allergy.AllergyId)
                                    ? "checked"
                                    : "") />

                                <span class="p-check-box"></span>

                                <span class="p-check-content">
                                    <strong>@allergy.AllergyName</strong>

                                    @if (!string.IsNullOrWhiteSpace(allergy.Description))
                                    {
                                        <small>@allergy.Description</small>
                                    }
                                </span>

                            </label>
                        }

                    </div>


                    <div class="p-health-empty"
                         data-empty-message="allergy">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>No allergies match your search.</span>
                    </div>


                    <!-- PAGINATION -->
                    <div class="p-health-pagination"
                         data-pagination="allergy"></div>


                    <!-- OTHER -->
                    <div class="p-other-field">

                        <label>Other Allergy</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-pen"></i>
                            <input asp-for="OtherAllergy"
                                   class="p-input"
                                   placeholder="Enter another allergy not listed above" />
                        </div>

                    </div>

                </div>


                <div class="p-health-divider"></div>


                <!-- =============================================
                     MEDICATIONS
                     ============================================= -->
                <div class="p-health-section">

                    <div class="p-health-heading">
                        <div>
                            <h3>
                                <i class="fa-solid fa-pills"></i>
                                Current Medications
                            </h3>

                            <p>Select any medications you are currently taking.</p>
                        </div>
                    </div>


                    <!-- SEARCH -->
                    <div class="p-health-tools">

                        <div class="p-input-wrap p-health-search-wrap">
                            <i class="fa-solid fa-magnifying-glass"></i>

                            <input type="text"
                                   class="p-input p-health-search"
                                   data-search-group="medication"
                                   placeholder="Search medications..." />

                            <button type="button"
                                    class="p-health-search-clear"
                                    data-clear-search="medication"
                                    title="Clear search">
                                <i class="fa-solid fa-xmark"></i>
                            </button>
                        </div>

                        <span class="p-health-results"
                              data-results-count="medication"></span>

                    </div>


                    <div class="p-options-grid"
                         data-options-group="medication">

                        <!-- NONE -->
                        <label class="p-check-card p-none-card">

                            <input type="checkbox"
                                   class="none-checkbox"
                                   data-group="medication" />

                            <span class="p-check-box"></span>

                            <span class="p-check-content">
                                <strong>No current medications</strong>
                                <small>I am not currently taking any medication</small>
                            </span>

                        </label>


                        <!-- DATABASE OPTIONS -->
                        @foreach (var medication in Model.MedicationOptions)
                        {
                            <label class="p-check-card health-option"
                                   data-health-option="medication"
                                   data-search-text="@medication.MedicationName.ToLowerInvariant()">

                                <input type="checkbox"
                                       name="SelectedMedicationIds"
                                       value="@medication.MedicationId"
                                       class="medication-option"
                                       data-group="medication"
                                @(Model.SelectedMedicationIds.Contains(medication.MedicationId)
                                    ? "checked"
                                    : "") />

                                <span class="p-check-box"></span>

                                <span class="p-check-content">
                                    <strong>@medication.MedicationName</strong>

                                    @if (!string.IsNullOrWhiteSpace(medication.Description))
                                    {
                                        <small>@medication.Description</small>
                                    }
                                </span>

                            </label>
                        }

                    </div>


                    <div class="p-health-empty"
                         data-empty-message="medication">
                        <i class="fa-solid fa-magnifying-glass"></i>
                        <span>No medications match your search.</span>
                    </div>


                    <!-- PAGINATION -->
                    <div class="p-health-pagination"
                         data-pagination="medication"></div>


                    <!-- OTHER -->
                    <div class="p-other-field">

                        <label>Other Medication</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-pen"></i>
                            <input asp-for="OtherMedication"
                                   class="p-input"
                                   placeholder="Enter another medication not listed above" />
                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SAVE
                     ================================================= -->
                <button type="submit" class="p-submit">
                    <i class="fas fa-save"></i>
                    Save Profile Changes
                </button>

            </div>
        </div>

    </form>


    <!-- =========================================================
         FOOTER
         ========================================================= -->
    <div class="p-footer">

        <hr />

        <div class="p-footer-content">

            <i class="fa-solid fa-shield-halved"></i>

            <span>Laboratory Information Management System</span>

            <span class="p-footer-divider">|</span>

            <span>Patient Portal</span>

            <span class="p-footer-divider">|</span>

            <span>@DateTime.Now.Year</span>

        </div>

    </div>

</div>


<!-- =============================================================
     STYLES
     ============================================================= -->
<style>

    :root {
        --p-paper: #F0F7F6;
        --p-raised: #FFFFFF;
        --p-ink: #102C27;
        --p-ink-soft: #52716C;
        --p-ink-faint: #8FA9A3;
        --p-line: #E1EEEC;
        --p-line-strong: #CCE3DF;
        --p-teal: #0E8C7F;
        --p-teal-deep: #0A5850;
        --p-teal-dim: #E3F4F1;
        --p-teal-grad-start: #12A392;
        --p-teal-grad-end: #0A4F48;
        --p-radius: 20px;
        --p-radius-sm: 13px;
        --p-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --p-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    .p-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--p-ink);
        font-family: 'Inter', sans-serif;
        animation: pFadeIn .5s ease;
    }

    @@keyframes pFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
           BANNER
           ========================================================= */

    .p-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        border-radius: var(--p-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }

    .p-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .p-banner-left {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .p-banner-avatar {
        position: relative;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 24px;
        flex-shrink: 0;
    }

    .p-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: pRingPulse 2.4s ease-out infinite;
    }

    @@keyframes pRingPulse {
        0% {
            transform: scale(0.9);
            opacity: .8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .p-banner-text {
        position: relative;
        z-index: 1;
    }

        .p-banner-text h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin: 0 0 4px;
            color: #fff;
            letter-spacing: -.01em;
        }

        .p-banner-text p {
            margin: 0 0 14px;
            color: rgba(255,255,255,.85);
            font-size: 14.5px;
        }

    .p-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .p-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
    }

    .p-banner-cta {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 13.5px;
        padding: 12px 20px;
        border-radius: 999px;
        transition: background .2s, transform .2s;
    }

        .p-banner-cta:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* =========================================================
           TOAST + STATUS STRIP
           ========================================================= */

    .p-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 15px 20px;
        border-radius: var(--p-radius-sm);
        margin-bottom: 20px;
        border-left: 4px solid var(--p-teal);
        font-size: 14px;
        font-weight: 500;
    }

    .p-status-strip {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow-sm);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        border-left: 4px solid var(--p-teal);
    }

    .p-status-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13.5px;
