</style>


<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->
<script>

    document.addEventListener("DOMContentLoaded", function() {

        /* Real database options shown per page ("None" card is not counted) */
        const ITEMS_PER_PAGE = 8;

        const currentPages = { medical: 1, allergy: 1, medication: 1 };
        const searchValues = { medical: "", allergy: "", medication: "" };


        /* ---------- helpers ---------- */

        function getOptions(group) {
            return Array.from(
                document.querySelectorAll(
                    `.health-option[data-health-option="${group}"]`
                )
            );
        }

        function getFilteredOptions(group) {
            const search = searchValues[group].trim().toLowerCase();
            const options = getOptions(group);

            if (!search) return options;

            return options.filter(function(option) {
                return (option.dataset.searchText || "").includes(search);
            });
        }

        function buildPageList(current, total) {

            if (total <= 7) {
                return Array.from({ length: total }, function(_, i) { return i + 1; });
            }

            const pages = [1];

            if (current > 4) pages.push("...");

            const start = Math.max(2, current - 1);
            const end = Math.min(total - 1, current + 1);

            for (let p = start; p <= end; p++) pages.push(p);

            if (current < total - 3) pages.push("...");

            pages.push(total);

            return pages;
        }


        /* ---------- pagination ---------- */

        function renderPagination(group, totalItems) {

            const pagination = document.querySelector(`[data-pagination="${group}"]`);
            if (!pagination) return;

            pagination.innerHTML = "";

            const totalPages = Math.ceil(totalItems / ITEMS_PER_PAGE);
            if (totalPages <= 1) return;

            // previous
            const prev = document.createElement("button");
            prev.type = "button";
            prev.className = "p-health-page-btn";
            prev.innerHTML = '<i class="fa-solid fa-chevron-left"></i>';
            prev.disabled = currentPages[group] === 1;
            prev.addEventListener("click", function() {
                if (currentPages[group] > 1) {
                    currentPages[group]--;
                    renderGroup(group);
                }
            });
            pagination.appendChild(prev);

            // numbers
            buildPageList(currentPages[group], totalPages).forEach(function(page) {

                if (page === "...") {
                    const dots = document.createElement("span");
                    dots.className = "p-health-page-dots";
                    dots.textContent = "...";
                    pagination.appendChild(dots);
                    return;
                }

                const btn = document.createElement("button");
                btn.type = "button";
                btn.className = "p-health-page-btn";
                btn.textContent = page;

                if (page === currentPages[group]) btn.classList.add("active");

                btn.addEventListener("click", function() {
                    currentPages[group] = page;
                    renderGroup(group);
                });

                pagination.appendChild(btn);
            });

            // next
            const next = document.createElement("button");
            next.type = "button";
            next.className = "p-health-page-btn";
            next.innerHTML = '<i class="fa-solid fa-chevron-right"></i>';
            next.disabled = currentPages[group] === totalPages;
            next.addEventListener("click", function() {
                if (currentPages[group] < totalPages) {
                    currentPages[group]++;
                    renderGroup(group);
                }
            });
            pagination.appendChild(next);
        }


        /* ---------- render one group ---------- */

        function renderGroup(group) {

            const allOptions = getOptions(group);
            const filtered = getFilteredOptions(group);

            const totalPages = Math.max(1, Math.ceil(filtered.length / ITEMS_PER_PAGE));

            if (currentPages[group] > totalPages) {
                currentPages[group] = totalPages;
            }

            const startIndex = (currentPages[group] - 1) * ITEMS_PER_PAGE;
            const endIndex = startIndex + ITEMS_PER_PAGE;

            // hide everything, then show only the current page of matches
            allOptions.forEach(function(option) {
                option.style.display = "none";
            });

            filtered.slice(startIndex, endIndex).forEach(function(option) {
                option.style.display = "flex";
            });

            // empty state
            const empty = document.querySelector(`[data-empty-message="${group}"]`);
            if (empty) {
                empty.style.display = filtered.length === 0 ? "flex" : "none";
            }

            // result counter
            const counter = document.querySelector(`[data-results-count="${group}"]`);
            if (counter) {
                const total = filtered.length;
                const word = searchValues[group] ? "result" : "option";
                counter.textContent = `${total} ${word}${total === 1 ? "" : "s"}`;
            }

            renderPagination(group, filtered.length);
        }


        /* ---------- search ---------- */

        document.querySelectorAll(".p-health-search").forEach(function(input) {

            const group = input.dataset.searchGroup;

            input.addEventListener("input", function() {

                searchValues[group] = this.value;
                currentPages[group] = 1;
                renderGroup(group);

                const clearBtn = document.querySelector(`[data-clear-search="${group}"]`);
                if (clearBtn) {
                    clearBtn.classList.toggle("visible", this.value.trim() !== "");
                }
            });
        });

        document.querySelectorAll("[data-clear-search]").forEach(function(button) {

            button.addEventListener("click", function() {

                const group = this.dataset.clearSearch;
                const input = document.querySelector(`[data-search-group="${group}"]`);

                if (!input) return;

                input.value = "";
                searchValues[group] = "";
                currentPages[group] = 1;
                this.classList.remove("visible");

                renderGroup(group);
                input.focus();
            });
        });


        /* ---------- "None" checkbox logic ---------- */

        document.querySelectorAll(".none-checkbox").forEach(function(noneBox) {

            noneBox.addEventListener("change", function() {

                if (!this.checked) return;

                const group = this.dataset.group;

                document
                    .querySelectorAll(`input[data-group="${group}"]:not(.none-checkbox)`)
                    .forEach(function(cb) { cb.checked = false; });
            });
        });

        document
            .querySelectorAll('input[type="checkbox"][data-group]:not(.none-checkbox)')
            .forEach(function(checkbox) {

                checkbox.addEventListener("change", function() {

                    if (!this.checked) return;

                    const noneBox = document.querySelector(
                        `.none-checkbox[data-group="${this.dataset.group}"]`
                    );

                    if (noneBox) noneBox.checked = false;
                });
            });


        /* ---------- initial "None" state ---------- */

        ["medical", "allergy", "medication"].forEach(function(group) {

            const noneBox = document.querySelector(`.none-checkbox[data-group="${group}"]`);
            if (!noneBox) return;

            const anySelected = Array.from(
                document.querySelectorAll(`input[data-group="${group}"]:not(.none-checkbox)`)
            ).some(function(cb) { return cb.checked; });

            if (!anySelected) noneBox.checked = true;
        });


        /* ---------- initial render ---------- */

        ["medical", "allergy", "medication"].forEach(renderGroup);

    });

</script>

@section Scripts {

    <partial name="_ValidationScriptsPartial" />

}
