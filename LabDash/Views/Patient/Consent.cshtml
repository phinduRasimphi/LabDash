@model LabDash.Models.ConsentViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Consent Management";
    ViewData["ActivePage"] = "Consent";
}

<div class="p-content">

    <!-- HERO -->
    <div class="p-hero">
        <div class="p-hero-inner">
            <div>
                <h1 class="p-hero-title">Consent Management 🔒</h1>

                <p class="p-hero-subtitle">
                    Control which healthcare providers can view your medical records.
                </p>
            </div>
        </div>
    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["SuccessMessage"] != null)
    {
        <div style="
            background: #d4edda;
            color: #155724;
            padding: 15px;
            border-radius: 10px;
            margin-bottom: 20px;
            border-left: 5px solid #28a745;">

            <i class="fas fa-check-circle"></i>
            @TempData["SuccessMessage"]

        </div>
    }


    <div class="p-r2">

        <!-- ========================================= -->
        <!-- CURRENT CONSENT -->
        <!-- ========================================= -->

        <div class="p-card">

            <div class="p-ch">

                <div class="p-ct">
                    <i class="fas fa-user-check"></i>
                    Doctor Access
                </div>

            </div>


            <div class="p-cb">

                <div style="
                    text-align: center;
                    padding: 40px 20px;
                    color: #66788a;">

                    <i class="fas fa-user-shield"
                       style="
                        font-size: 3rem;
                        margin-bottom: 15px;
                        color: #0f717e;">
                    </i>

                    <h3 style="color: #1a4c6e;">
                        Consent Management
                    </h3>

                    <p>
                        Manage which healthcare providers are allowed
                        to access your medical information.
                    </p>

                </div>

            </div>

        </div>


        <!-- ========================================= -->
        <!-- GRANT NEW ACCESS -->
        <!-- ========================================= -->

        <div class="p-card">

            <div class="p-ch">

                <div class="p-ct">
                    <i class="fas fa-user-plus"></i>
                    Grant New Access
                </div>

            </div>


            <div class="p-cb">

                <!-- DOCTOR SEARCH -->

                <div style="margin-bottom: 15px;">

                    <label style="
                        display: block;
                        font-weight: 600;
                        color: #1a4c6e;
                        margin-bottom: 5px;">

                        Doctor Search

                    </label>

                    <input type="text"
                           class="p-input"
                           placeholder="Enter doctor name or HPCSA number..."
                           style="
                    width: 100%;
                    box-sizing: border-box;" />

                </div>


                <!-- TEST REQUESTS -->

                <div style="margin-bottom: 20px;">

                    <label style="
                        display: block;
                        font-weight: 600;
                        color: #1a4c6e;
                        margin-bottom: 5px;">

                        Select Test Requests to Share

                    </label>

                    <select multiple
                            style="
                        width: 100%;
                        height: 120px;
                        padding: 10px;
                        border: 1px solid #ddd;
                        border-radius: 8px;
                        outline-color: #0f717e;">

                        <option>
                            REQ-1041 (Blood Work)
                        </option>

                        <option>
                            REQ-0987 (X-Ray)
                        </option>

                        <option>
                            REQ-0921 (MRI Results)
                        </option>

                        <option>
                            REQ-0870 (Lipid Panel)
                        </option>

                    </select>

                    <small style="color: #666;">
                        Hold Ctrl (or Cmd) to select multiple requests.
                    </small>

                </div>


                <!-- GRANT ACCESS -->

                <button type="button"
                        class="p-btn"
                        style="
                    width: 100%;
                    padding: 15px;
                    font-size: 1rem;">

                    <i class="fas fa-check"></i>

                    Grant Access & Notify Doctor

                </button>

            </div>

        </div>

    </div>

</div>


<style>

    .p-input {
        padding: 10px 15px;
        border: 1px solid #ddd;
        border-radius: 8px;
        outline: none;
        transition: border-color 0.3s;
    }

        .p-input:focus {
            border-color: #0f717e;
        }

</style>