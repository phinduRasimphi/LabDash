@model LabDash.Models.ConsentViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Consent Management";
    ViewData["ActivePage"] = "Consent";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="cs-wrap">

    <!-- BANNER -->
    <div class="cs-banner">
        <div class="cs-banner-pattern"></div>

        <div class="cs-banner-left">
            <div class="cs-banner-avatar">
                <span class="cs-icon-ring"></span>
                <i class="fas fa-lock"></i>
            </div>
            <div class="cs-banner-text">
                <h1>Consent Management <span></span></h1>
                <p>Control which healthcare providers can view your medical records.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cs-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cs-toast cs-toast-error">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- REASSURANCE STRIP -->
    <div class="cs-status-strip">
        <div class="cs-status-left">
            <span class="cs-status-dot"></span>
            <span><strong>You're in control</strong> &middot; doctors only see the specific tests you grant, and access can be revoked at any time</span>
        </div>
        <i class="fas fa-shield-halved"></i>
    </div>

    <div class="cs-grid">

        <!-- ========================================= -->
        <!-- CURRENT ACCESS -->
        <!-- ========================================= -->
        <div class="cs-panel">
            <div class="cs-panel-head">
                <span><i class="fa-solid fa-id-badge"></i> Doctor Access</span>
                <span class="cs-panel-tag">@Model.ActiveGrants.Count active</span>
            </div>

            <div class="cs-panel-body">
                @if (!Model.ActiveGrants.Any())
                {
                    <div class="cs-badge-slot">
                        <div class="cs-badge-outline">
                            <i class="fa-solid fa-user-lock"></i>
                        </div>
                        <h5>No active access grants</h5>
                        <p>No doctors currently have access to your medical records. Grant access from the panel to the right, and their access will appear here.</p>
                    </div>
                }
                else
                {
                    @foreach (var grant in Model.ActiveGrants)
                    {
                        <div class="cs-grant-card">
                            <div class="cs-grant-card-top">
                                <div class="cs-grant-info">
                                    <h5>@grant.DoctorName</h5>
                                    <p>
                                        @if (!string.IsNullOrEmpty(grant.HPCSANumber))
                                        {
                                            <span>HPCSA @grant.HPCSANumber &middot; </span>
                                        }
                                        Granted @grant.GrantedDate.ToString("dd MMM yyyy")
                                    </p>
                                </div>

                                <form asp-action="RevokeConsent" method="post"
                                      data-cs-confirm="This doctor will immediately lose access to all the tests you've shared with them."
                                      data-cs-title="Revoke all access?"
                                      data-cs-yes="Revoke all"
                                      data-cs-tone="danger"
                                      data-cs-icon="fa-ban">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="consentId" value="@grant.ConsentID" />
                                    <button type="submit" class="cs-revoke-btn">
                                        <i class="fa-solid fa-ban"></i> Revoke All
                                    </button>
                                </form>
                            </div>

                            <div class="cs-grant-items">
                                @foreach (var group in grant.GrantedItems.GroupBy(i => i.RequestID))
                                {
                                    <div class="cs-grant-item-group">
                                        <span class="cs-grant-item-group-label">REQ-@group.Key</span>
                                        <div class="cs-grant-item-list">
                                            @foreach (var item in group)
                                            {
                                                <form asp-action="RevokeItemAccess" method="post" class="cs-item-tag-form"
                                                      data-cs-confirm="The doctor will no longer be able to see @item.TestName."
                                                      data-cs-title="Revoke this test?"
                                                      data-cs-yes="Revoke"
                                                      data-cs-tone="danger"
                                                      data-cs-icon="fa-ban">
                                                    @Html.AntiForgeryToken()
                                                    <input type="hidden" name="consentItemAccessId" value="@item.ConsentItemAccessID" />
                                                    <button type="submit" class="cs-item-tag" title="Revoke @item.TestName">
                                                        <span>@item.TestName</span>
                                                        <i class="fa-solid fa-xmark"></i>
                                                    </button>
                                                </form>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ========================================= -->
        <!-- GRANT NEW ACCESS -->
        <!-- ========================================= -->
        <div class="cs-panel">
            <div class="cs-panel-head">
                <span><i class="fa-solid fa-user-plus"></i> Grant New Access</span>
            </div>

            <div class="cs-panel-body">

                <div class="cs-steps">
                    <div class="cs-step-item"><span class="cs-step-num">1</span> Select doctor</div>
                    <div class="cs-step-connector"></div>
                    <div class="cs-step-item"><span class="cs-step-num">2</span> Select tests</div>
                    <div class="cs-step-connector"></div>
                    <div class="cs-step-item"><span class="cs-step-num">3</span> Grant access</div>
                </div>

                <form id="consentForm" asp-action="GrantConsent" method="post">
                    @Html.AntiForgeryToken()

                    <div class="cs-field">
                        <label>Doctor</label>

                        <input type="hidden" id="doctorId" name="doctorId" />

                        <div class="cs-input-wrap" id="docSearchWrap">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="docSearch" class="cs-input" autocomplete="off"
                                   placeholder="Search by name or HPCSA number&hellip;" />
                        </div>

                        <div class="cs-doc-results" id="docResults" hidden></div>

                        <div class="cs-doc-picked" id="docPicked" hidden>
                            <i class="fa-solid fa-user-doctor"></i>
                            <div class="cs-doc-picked-text">
                                <strong id="docPickedName"></strong>
                                <small id="docPickedMeta"></small>
                            </div>
                            <button type="button" class="cs-doc-change" id="docChange">Change</button>
                        </div>

                        @if (Model.LinkedDoctors.Any())
                        {
                            <div class="cs-doc-quick" id="docQuick">
                                <span>Your doctors</span>
                                @foreach (var doc in Model.LinkedDoctors)
                                {
                                    <button type="button" class="cs-doc-chip"
                                            data-id="@doc.DoctorId" data-name="@doc.FullName" data-hpcsa="@doc.HPCSANumber">
                                        @doc.FullName
                                    </button>
                                }
                            </div>
                        }

                        <small class="cs-hint">Type at least 3 characters. You can share with any registered doctor, such as a specialist or a second opinion.</small>
                    </div>

                    <div class="cs-field">
                        <label>Select Tests to Share</label>

                        @if (!Model.AvailableRequests.Any())
                        {
                            <small class="cs-hint">You don't have any released results yet, so there's nothing to share. Results appear here once your doctor releases them.</small>
                        }
                        else
                        {
                            <div class="cs-request-groups">
                                @foreach (var req in Model.AvailableRequests)
                                {
                                    <div class="cs-request-group">
                                        <div class="cs-request-group-head">
                                            <span class="cs-chip-id">REQ-@req.RequestID</span>
                                            <span class="cs-request-group-label">@(string.IsNullOrEmpty(req.Label) ? "Test Request" : req.Label)</span>
                                            <button type="button" class="cs-select-all">Select all</button>
                                        </div>
                                        <div class="cs-chip-grid">
                                            @foreach (var item in req.Items)
                                            {
                                                <input type="checkbox" id="cs-item-@item.TestRequestItemID" name="itemIds"
                                                       value="@item.TestRequestItemID" class="cs-chip-input" />
                                                <label for="cs-item-@item.TestRequestItemID" class="cs-chip">
                                                    <span class="cs-chip-type">@item.TestName</span>
                                                    <i class="fa-solid fa-check cs-chip-check"></i>
                                                </label>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                            <small class="cs-hint">Tap a test to include it &mdash; you can select individual tests from any request. The doctor will only see exactly what you check.</small>
                        }
                    </div>

                    <button type="submit" class="cs-submit" id="grantBtn" disabled>
                        <i class="fas fa-check"></i> Grant Access &amp; Notify Doctor
                    </button>
                </form>
            </div>
        </div>

    </div>

    <!-- FOOTER -->
    <div class="cs-footer">
        <hr />
        <div class="cs-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="cs-footer-divider">|</span>
            <span>Patient Portal</span>
            <span class="cs-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </div>

</div>

<style>
:root {
    --cs-paper: #F0F7F6;
    --cs-raised: #FFFFFF;
    --cs-ink: #102C27;
    --cs-ink-soft: #52716C;
    --cs-ink-faint: #8FA9A3;
    --cs-line: #E1EEEC;
    --cs-line-strong: #CCE3DF;
    --cs-teal: #0E8C7F;
    --cs-teal-deep: #0A5850;
    --cs-teal-dim: #E3F4F1;
    --cs-teal-grad-start: #12A392;
    --cs-teal-grad-end: #0A4F48;
    --cs-radius: 20px;
    --cs-radius-sm: 13px;
    --cs-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
    --cs-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
}

           .cs-wrap {
               max-width: 1080px;
               margin: 0 auto;
               padding: 26px 24px 60px;
               color: var(--cs-ink);
               font-family: 'Inter', sans-serif;
               animation: csFadeIn .5s ease;
           }

           @@keyframes csFadeIn {
               from {
                   opacity: 0;
                   transform: translateY(12px);
               }

               to {
                   opacity: 1;
                   transform: translateY(0);
               }
           }

           /* ============ BANNER ============ */
           .cs-banner {
               position: relative;
               display: flex;
               align-items: center;
               gap: 22px;
               background: linear-gradient(125deg, var(--cs-teal-grad-start), var(--cs-teal-grad-end));
               border-radius: var(--cs-radius);
               padding: 32px 36px;
               margin-bottom: 22px;
               box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
               overflow: hidden;
           }

           .cs-banner-pattern {
               position: absolute;
               inset: 0;
               background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
               pointer-events: none;
           }

           .cs-banner-left {
               display: flex;
               align-items: center;
               gap: 22px;
               position: relative;
               z-index: 1;
           }

           .cs-banner-avatar {
               position: relative;
               width: 76px;
               height: 76px;
               border-radius: 50%;
               background: rgba(255,255,255,.16);
               border: 2px solid rgba(255,255,255,.32);
               display: flex;
               align-items: center;
               justify-content: center;
               color: #fff;
               font-size: 28px;
               flex-shrink: 0;
           }

           .cs-icon-ring {
               position: absolute;
               inset: -6px;
               border-radius: 50%;
               border: 1.5px solid rgba(255,255,255,.4);
               animation: csRingPulse 2.4s ease-out infinite;
           }

           @@keyframes csRingPulse {
               0% {
                   transform: scale(0.9);
                   opacity: .8;
               }

               100% {
                   transform: scale(1.35);
                   opacity: 0;
               }
           }

           .cs-banner-text h1 {
               font-family: 'Poppins', sans-serif;
               font-weight: 700;
               font-size: 26px;
               margin: 0 0 4px;
               color: #fff;
               letter-spacing: -.01em;
           }

           .cs-banner-text p {
               margin: 0;
               color: rgba(255,255,255,.85);
               font-size: 14.5px;
           }

           /* ============ TOAST ============ */
           .cs-toast {
               display: flex;
               align-items: center;
               gap: 10px;
               background: var(--cs-teal-dim);
               color: var(--cs-teal-deep);
               padding: 15px 20px;
               border-radius: var(--cs-radius-sm);
               margin-bottom: 20px;
               border-left: 4px solid var(--cs-teal);
               font-size: 14px;
               font-weight: 500;
           }

           .cs-toast-error {
               background: #FDEDEC;
               color: #922B21;
               border-left-color: #C0392B;
           }

           /* ============ STATUS STRIP ============ */
           .cs-status-strip {
               background: var(--cs-raised);
               border-radius: var(--cs-radius);
               box-shadow: var(--cs-shadow-sm);
               padding: 16px 24px;
               display: flex;
               justify-content: space-between;
               align-items: center;
               margin-bottom: 22px;
               border-left: 4px solid var(--cs-teal);
           }

           .cs-status-left {
               display: flex;
               align-items: center;
               gap: 12px;
               font-size: 13.5px;
               color: var(--cs-ink);
           }

               .cs-status-left strong {
                   color: var(--cs-teal-deep);
               }

           .cs-status-dot {
               width: 10px;
               height: 10px;
               border-radius: 50%;
               background: var(--cs-teal);
               flex-shrink: 0;
               box-shadow: 0 0 0 4px var(--cs-teal-dim);
           }

           .cs-status-strip > i {
               color: var(--cs-ink-faint);
               font-size: 15px;
           }

           /* ============ GRID ============ */
           .cs-grid {
               display: grid;
               grid-template-columns: 0.85fr 1.15fr;
               gap: 20px;
               align-items: start;
           }

           /* ============ PANEL ============ */
           .cs-panel {
               background: var(--cs-raised);
               border-radius: var(--cs-radius);
               box-shadow: var(--cs-shadow);
               overflow: hidden;
           }

           .cs-panel-head {
               display: flex;
               justify-content: space-between;
               align-items: center;
               padding: 18px 24px;
               border-bottom: 1px solid var(--cs-line);
           }

               .cs-panel-head span:first-child {
                   font-family: 'Poppins', sans-serif;
                   font-weight: 700;
                   font-size: 15px;
                   color: var(--cs-ink);
                   display: flex;
                   align-items: center;
                   gap: 10px;
               }

                   .cs-panel-head span:first-child i {
                       color: var(--cs-teal);
                   }

           .cs-panel-tag {
               font-family: 'Inter', sans-serif;
               font-weight: 600;
               font-size: 11.5px;
               background: var(--cs-teal-dim);
               color: var(--cs-teal-deep);
               padding: 6px 13px;
               border-radius: 999px;
           }

           .cs-panel-body {
               padding: 26px 24px 28px;
           }

           /* ============ EMPTY STATE ============ */
           .cs-badge-slot {
               text-align: center;
               padding: 20px 10px 10px;
           }

           .cs-badge-outline {
               width: 90px;
               height: 68px;
               margin: 0 auto 20px;
               border: 2px dashed var(--cs-line-strong);
               border-radius: 16px;
               display: flex;
               align-items: center;
               justify-content: center;
               color: var(--cs-ink-faint);
               font-size: 24px;
               position: relative;
           }

               .cs-badge-outline::before {
                   content: "";
                   position: absolute;
                   top: -9px;
                   left: 50%;
                   transform: translateX(-50%);
                   width: 26px;
                   height: 8px;
                   border-radius: 4px;
                   background: var(--cs-line-strong);
               }

           .cs-badge-slot h5 {
               margin: 0 0 8px;
               font-family: 'Poppins', sans-serif;
               font-weight: 700;
               font-size: 15px;
               color: var(--cs-ink);
           }

           .cs-badge-slot p {
               font-size: 13px;
               color: var(--cs-ink-soft);
               line-height: 1.65;
               max-width: 290px;
               margin: 0 auto;
           }

           /* ============ GRANT CARD ============ */
           .cs-grant-card {
               background: var(--cs-paper);
               border: 1.5px solid var(--cs-line-strong);
               border-radius: var(--cs-radius-sm);
               padding: 14px 16px;
               margin-bottom: 12px;
           }

               .cs-grant-card:last-child {
                   margin-bottom: 0;
               }

           .cs-grant-card-top {
               display: flex;
               align-items: center;
               justify-content: space-between;
               gap: 14px;
           }

           .cs-grant-info h5 {
               margin: 0 0 3px;
               font-family: 'Poppins', sans-serif;
               font-weight: 700;
               font-size: 14px;
               color: var(--cs-ink);
           }

           .cs-grant-info p {
               margin: 0;
               font-size: 12px;
               color: var(--cs-ink-soft);
           }

           .cs-revoke-btn {
               display: flex;
               align-items: center;
               gap: 6px;
               border: 1.5px solid #E4B8B4;
               background: #FDF3F2;
               color: #B3413B;
               font-family: 'Inter', sans-serif;
               font-weight: 600;
               font-size: 12px;
               padding: 8px 14px;
               border-radius: 10px;
               cursor: pointer;
               white-space: nowrap;
               transition: background .2s, border-color .2s;
           }

               .cs-revoke-btn:hover {
                   background: #FBE5E3;
                   border-color: #D89A95;
               }

           /* ============ GRANTED ITEMS ============ */
           .cs-grant-items {
               margin-top: 12px;
               padding-top: 12px;
               border-top: 1px dashed var(--cs-line-strong);
               display: flex;
               flex-direction: column;
               gap: 10px;
           }

           .cs-grant-item-group {
               display: flex;
               align-items: flex-start;
               gap: 10px;
               flex-wrap: wrap;
           }

           .cs-grant-item-group-label {
               font-family: 'IBM Plex Mono', monospace;
               font-weight: 700;
               font-size: 11px;
               color: var(--cs-teal-deep);
               background: var(--cs-teal-dim);
               padding: 5px 9px;
               border-radius: 8px;
               flex-shrink: 0;
               margin-top: 1px;
           }

           .cs-grant-item-list {
               display: flex;
               flex-wrap: wrap;
               gap: 6px;
               flex: 1;
           }

           .cs-item-tag-form {
               display: inline-flex;
           }

           .cs-item-tag {
               display: flex;
               align-items: center;
               gap: 7px;
               background: #fff;
               border: 1.5px solid var(--cs-line-strong);
               color: var(--cs-ink);
               font-family: 'Inter', sans-serif;
               font-weight: 500;
               font-size: 11.5px;
               padding: 6px 10px;
               border-radius: 999px;
               cursor: pointer;
               transition: background .15s, border-color .15s, color .15s;
           }

               .cs-item-tag i {
                   font-size: 10px;
                   color: var(--cs-ink-faint);
                   transition: color .15s;
               }

               .cs-item-tag:hover {
                   background: #FDF3F2;
                   border-color: #E4B8B4;
                   color: #B3413B;
               }

                   .cs-item-tag:hover i {
                       color: #B3413B;
                   }

           /* ============ STEP TRACKER ============ */
           .cs-steps {
               display: flex;
               align-items: center;
               gap: 10px;
               margin-bottom: 26px;
               flex-wrap: wrap;
           }

           .cs-step-item {
               display: flex;
               align-items: center;
               gap: 8px;
               font-size: 12px;
               font-weight: 600;
               color: var(--cs-ink-soft);
               white-space: nowrap;
           }

           .cs-step-num {
               width: 20px;
               height: 20px;
               border-radius: 50%;
               background: var(--cs-teal-dim);
               color: var(--cs-teal-deep);
               display: flex;
               align-items: center;
               justify-content: center;
               font-family: 'IBM Plex Mono', monospace;
               font-size: 11px;
               font-weight: 700;
               flex-shrink: 0;
           }

           .cs-step-connector {
               flex: 1;
               min-width: 16px;
               height: 1px;
               background: var(--cs-line-strong);
           }

           /* ============ FIELDS ============ */
           .cs-field {
               margin-bottom: 22px;
           }

               .cs-field:last-of-type {
                   margin-bottom: 26px;
               }

               .cs-field > label {
                   display: block;
                   font-family: 'Poppins', sans-serif;
                   font-weight: 600;
                   font-size: 13px;
                   color: var(--cs-ink);
                   margin-bottom: 8px;
               }

           .cs-input-wrap {
               display: flex;
               align-items: center;
               gap: 10px;
               background: var(--cs-paper);
               border: 1.5px solid var(--cs-line-strong);
               border-radius: var(--cs-radius-sm);
               padding: 0 15px;
               transition: border-color .2s, box-shadow .2s, background .2s;
           }

               .cs-input-wrap i {
                   color: var(--cs-teal);
                   font-size: 14px;
               }

               .cs-input-wrap:focus-within {
                   border-color: var(--cs-teal);
                   background: #fff;
                   box-shadow: 0 0 0 4px var(--cs-teal-dim);
               }

           .cs-input {
               flex: 1;
               border: none;
               background: transparent;
               outline: none;
               padding: 12px 0;
               font-family: 'Inter', sans-serif;
               font-size: 14px;
               color: var(--cs-ink);
           }

           /* ============ DOCTOR SEARCH ============ */
           #docSearchWrap[hidden], .cs-doc-picked[hidden], .cs-doc-quick[hidden], .cs-doc-results[hidden] {
               display: none;
           }

           .cs-doc-results {
               margin-top: 8px;
               background: var(--cs-raised);
               border: 1.5px solid var(--cs-line-strong);
               border-radius: var(--cs-radius-sm);
               box-shadow: var(--cs-shadow-sm);
               overflow: hidden;
           }

           .cs-doc-result {
               display: flex;
               flex-direction: column;
               gap: 2px;
               width: 100%;
               text-align: left;
               padding: 11px 15px;
               border: none;
               background: transparent;
               cursor: pointer;
               font-family: 'Inter', sans-serif;
               color: var(--cs-ink);
           }

               .cs-doc-result + .cs-doc-result {
                   border-top: 1px solid var(--cs-line);
               }

               .cs-doc-result:hover {
                   background: var(--cs-teal-dim);
               }

               .cs-doc-result strong {
                   font-size: 13px;
               }

               .cs-doc-result small {
                   font-size: 11.5px;
                   color: var(--cs-ink-soft);
               }

           .cs-doc-empty {
               padding: 14px 15px;
               font-size: 12.5px;
               color: var(--cs-ink-faint);
           }

           .cs-doc-picked {
               display: flex;
               align-items: center;
               gap: 12px;
               padding: 12px 15px;
               background: var(--cs-teal-dim);
               border: 1.5px solid var(--cs-teal);
               border-radius: var(--cs-radius-sm);
           }

               .cs-doc-picked > i {
                   color: var(--cs-teal);
               }

           .cs-doc-picked-text {
               flex: 1;
               display: flex;
               flex-direction: column;
               min-width: 0;
           }

               .cs-doc-picked-text strong {
                   font-size: 13.5px;
               }

               .cs-doc-picked-text small {
                   font-size: 11.5px;
                   color: var(--cs-ink-soft);
               }

           .cs-doc-change {
               border: none;
               background: none;
               cursor: pointer;
               color: var(--cs-teal-deep);
               font-family: 'Inter', sans-serif;
               font-weight: 700;
               font-size: 12px;
           }

               .cs-doc-change:hover {
                   text-decoration: underline;
               }

           .cs-doc-quick {
               display: flex;
               flex-wrap: wrap;
               align-items: center;
               gap: 7px;
               margin-top: 10px;
           }

               .cs-doc-quick > span {
                   font-size: 11.5px;
                   font-weight: 600;
                   color: var(--cs-ink-faint);
               }

           .cs-doc-chip {
               border: 1.5px solid var(--cs-line-strong);
               background: var(--cs-raised);
               color: var(--cs-ink);
               font-family: 'Inter', sans-serif;
               font-weight: 500;
               font-size: 11.5px;
               padding: 5px 12px;
               border-radius: 999px;
               cursor: pointer;
               transition: background .15s, border-color .15s;
           }

               .cs-doc-chip:hover {
                   background: var(--cs-teal-dim);
                   border-color: var(--cs-teal);
               }

           /* ============ REQUEST GROUPS ============ */
           .cs-request-groups {
               display: flex;
               flex-direction: column;
               gap: 16px;
           }

           .cs-request-group {
               background: var(--cs-paper);
               border: 1.5px solid var(--cs-line-strong);
               border-radius: var(--cs-radius-sm);
               padding: 14px 14px 16px;
           }

           .cs-request-group-head {
               display: flex;
               align-items: center;
               gap: 10px;
               margin-bottom: 12px;
               flex-wrap: wrap;
           }

           .cs-request-group-label {
               font-size: 12.5px;
               font-weight: 600;
               color: var(--cs-ink-soft);
           }

           .cs-select-all {
               margin-left: auto;
               border: 1.5px solid var(--cs-line-strong);
               background: var(--cs-raised);
               color: var(--cs-teal-deep);
               font-family: 'Inter', sans-serif;
               font-weight: 600;
               font-size: 11.5px;
               padding: 5px 12px;
               border-radius: 999px;
               cursor: pointer;
               transition: background .15s, border-color .15s;
           }

               .cs-select-all:hover {
                   background: var(--cs-teal-dim);
                   border-color: var(--cs-teal);
               }

           /* ============ CHIPS ============ */
           .cs-chip-grid {
               display: grid;
               grid-template-columns: repeat(2, 1fr);
               gap: 10px;
           }

           .cs-chip-input {
               position: absolute;
               opacity: 0;
               width: 0;
               height: 0;
           }

           .cs-chip {
               position: relative;
               display: flex;
               flex-direction: column;
               gap: 2px;
               background: #fff;
               border: 1.5px solid var(--cs-line-strong);
               border-radius: var(--cs-radius-sm);
               padding: 12px 34px 12px 14px;
               cursor: pointer;
               transition: border-color .2s, background .2s, transform .15s;
           }

               .cs-chip:hover {
                   border-color: var(--cs-teal);
                   transform: translateY(-1px);
               }

           .cs-chip-id {
               font-family: 'IBM Plex Mono', monospace;
               font-weight: 700;
               font-size: 12.5px;
               color: var(--cs-teal-deep);
           }

           .cs-chip-type {
               font-size: 12px;
               color: var(--cs-ink-soft);
           }

           .cs-chip-check {
               position: absolute;
               top: 50%;
               right: 12px;
               transform: translateY(-50%) scale(0);
               color: var(--cs-teal);
               font-size: 13px;
               transition: transform .15s;
           }

           .cs-chip-input:checked + .cs-chip {
               background: var(--cs-teal-dim);
               border-color: var(--cs-teal);
           }

               .cs-chip-input:checked + .cs-chip .cs-chip-check {
                   transform: translateY(-50%) scale(1);
               }

           .cs-chip-input:focus-visible + .cs-chip {
               box-shadow: 0 0 0 3px var(--cs-teal-dim);
           }

           .cs-hint {
               display: block;
               margin-top: 10px;
               font-size: 12px;
               color: var(--cs-ink-faint);
           }

           /* ============ SUBMIT ============ */
           .cs-submit {
               width: 100%;
               display: flex;
               align-items: center;
               justify-content: center;
               gap: 10px;
               padding: 15px;
               border: none;
               border-radius: var(--cs-radius-sm);
               background: linear-gradient(120deg, var(--cs-teal-grad-start), var(--cs-teal-grad-end));
               color: #fff;
               font-family: 'Poppins', sans-serif;
               font-weight: 600;
               font-size: 14.5px;
               cursor: pointer;
               box-shadow: 0 10px 24px rgba(10, 90, 80, 0.22);
               transition: transform .2s, box-shadow .2s, opacity .2s;
           }

               .cs-submit:hover {
                   transform: translateY(-2px);
                   box-shadow: 0 14px 28px rgba(10, 90, 80, 0.28);
               }

               .cs-submit:disabled {
                   opacity: .5;
                   cursor: not-allowed;
                   transform: none;
                   box-shadow: none;
               }

           /* ============ FOOTER ============ */
           .cs-footer {
               margin-top: 40px;
               text-align: center;
           }

               .cs-footer hr {
                   border: none;
                   border-top: 1px solid var(--cs-line);
                   margin-bottom: 22px;
               }

           .cs-footer-content {
               display: flex;
               justify-content: center;
               align-items: center;
               flex-wrap: wrap;
               gap: 12px;
               color: var(--cs-ink-faint);
               font-size: 13px;
           }

               .cs-footer-content i {
                   color: var(--cs-teal);
               }

           .cs-footer-divider {
               color: var(--cs-line-strong);
           }

           /* ============ RESPONSIVE ============ */
           @@media (max-width: 900px) {
               .cs-grid {
                   grid-template-columns: 1fr;
               }
           }

           @@media (max-width: 560px) {
               .cs-wrap {
                   padding: 20px 14px 50px;
               }

               .cs-chip-grid {
                   grid-template-columns: 1fr;
               }

               .cs-panel-body {
                   padding: 22px 18px 26px;
               }

               .cs-status-strip {
                   flex-direction: column;
                   align-items: flex-start;
                   gap: 10px;
               }

               .cs-grant-card-top {
                   flex-direction: column;
                   align-items: flex-start;
                   gap: 10px;
               }
           }

           /* =========================================================
                  DARK MODE (html.rq-dark, same switch as the other pages)
                  Layering: layout bg < panels < inner cards < chips
                  ========================================================= */

                                         html.rq-dark {
                                         --cs-paper: #202D27;
                                         --cs-raised: #1A2621;
                                         --cs-ink: #E8EEEB;
                                         --cs-ink-soft: #A5B0AA;
                                         --cs-ink-faint: #7F8B85;
                                         --cs-line: #2C3B33;
                                         --cs-line-strong: #3A4B42;
                                         --cs-teal: #2CC4BA;
                                         --cs-teal-deep: #5ED0C4;
                                         --cs-teal-dim: #12302D;
                                         --cs-teal-grad-start: #0F7F74;
                                         --cs-teal-grad-end: #0A3A35;
                                         --cs-shadow: 0 6px 24px rgba(0, 0, 0, .40);
                                         --cs-shadow-sm: 0 3px 10px rgba(0, 0, 0, .30);
                                         color-scheme: dark;
                                         }

                                             html.rq-dark .cs-banner {
                                             box-shadow: 0 18px 40px rgba(0, 0, 0, .35);
                                             }

                                             html.rq-dark .cs-toast-error {
                                             background: #3A1B18;
                                             color: #F3A29B;
                                             border-left-color: #E1736B;
                                             }

                                             html.rq-dark .cs-panel,
                                             html.rq-dark .cs-status-strip {
                                             border: 1px solid var(--cs-line);
                                             }

                                             html.rq-dark .cs-status-dot {
                                             box-shadow: 0 0 0 4px rgba(44, 196, 186, .18);
                                             }

                                             html.rq-dark .cs-grant-card,
                                             html.rq-dark .cs-request-group {
                                             background: var(--cs-paper);
                                             border-color: var(--cs-line-strong);
                                             }

                                             html.rq-dark .cs-revoke-btn {
                                             background: #3A1B18;
                                             border-color: #6A332F;
                                             color: #F3A29B;
                                             }

                                             html.rq-dark .cs-revoke-btn:hover {
                                             background: #4A2320;
                                             border-color: #8A423D;
                                             }

                                             html.rq-dark .cs-item-tag {
                                             background: #2A3A32;
                                             border-color: var(--cs-line-strong);
                                             color: var(--cs-ink);
                                             }

                                             html.rq-dark .cs-item-tag:hover {
                                             background: #3A1B18;
                                             border-color: #6A332F;
                                             color: #F3A29B;
                                             }

                                             html.rq-dark .cs-item-tag:hover i {
                                             color: #F3A29B;
                                             }

                                             html.rq-dark .cs-input-wrap:focus-within {
                                             background: #172019;
                                             box-shadow: 0 0 0 4px rgba(44, 196, 186, .18);
                                             }

                                             html.rq-dark .cs-doc-results {
                                             background: #1A2621;
                                             border-color: var(--cs-line-strong);
                                             }

                                             html.rq-dark .cs-doc-chip,
                                             html.rq-dark .cs-select-all {
                                             background: #2A3A32;
                                             border-color: var(--cs-line-strong);
                                             }

                                             html.rq-dark .cs-doc-chip:hover,
                                             html.rq-dark .cs-select-all:hover {
                                             background: var(--cs-teal-dim);
                                             border-color: var(--cs-teal);
                                             }

                                             html.rq-dark .cs-doc-picked {
                                             background: var(--cs-teal-dim);
                                             }

                                             html.rq-dark .cs-chip {
                                             background: #2A3A32;
                                             border-color: var(--cs-line-strong);
                                             }

                                             html.rq-dark .cs-chip:hover {
                                             border-color: var(--cs-teal);
                                             }

                                             html.rq-dark .cs-chip-input:checked + .cs-chip {
                                             background: var(--cs-teal-dim);
                                             border-color: var(--cs-teal);
                                             }

                                             html.rq-dark .cs-chip-type {
                                             color: var(--cs-ink);
                                             }

                                             html.rq-dark .cs-chip-input:focus-visible + .cs-chip {
                                             box-shadow: 0 0 0 3px rgba(44, 196, 186, .25);
                                             }

                                             html.rq-dark .cs-submit {
                                             box-shadow: 0 10px 24px rgba(0, 0, 0, .35);
                                             }
</style>

<script>
    (function() {
        const form = document.getElementById('consentForm');
        const grantBtn = document.getElementById('grantBtn');
        if (!form || !grantBtn) return;

        const doctorId = document.getElementById('doctorId');
        const searchWrap = document.getElementById('docSearchWrap');
        const search = document.getElementById('docSearch');
        const results = document.getElementById('docResults');
        const picked = document.getElementById('docPicked');
        const pickedName = document.getElementById('docPickedName');
        const pickedMeta = document.getElementById('docPickedMeta');
        const quick = document.getElementById('docQuick');
        let timer = null;
        let chosenName = '';

        function getCheckedItems() {
            return form.querySelectorAll('input[name="itemIds"]:checked');
        }

        function refreshButtonState() {
            grantBtn.disabled = !(doctorId.value && getCheckedItems().length > 0);
        }

        function pick(id, name, hpcsa) {
            doctorId.value = id;
            chosenName = name;
            pickedName.textContent = name;
            pickedMeta.textContent = hpcsa ? 'HPCSA ' + hpcsa : '';
            picked.hidden = false;
            searchWrap.hidden = true;
            results.hidden = true;
            if (quick) quick.hidden = true;
            refreshButtonState();
        }

        function clearPick() {
            doctorId.value = '';
            chosenName = '';
            picked.hidden = true;
            searchWrap.hidden = false;
            if (quick) quick.hidden = false;
            search.value = '';
            search.focus();
            refreshButtonState();
        }

        function render(list) {
            results.innerHTML = '';
            if (!list.length) {
                const empty = document.createElement('div');
                empty.className = 'cs-doc-empty';
                empty.textContent = 'No doctors found.';
                results.appendChild(empty);
            } else {
                list.forEach(function(d) {
                    const b = document.createElement('button');
                    b.type = 'button';
                    b.className = 'cs-doc-result';
                    const n = document.createElement('strong');
                    n.textContent = d.name;
                    const m = document.createElement('small');
                    m.textContent = d.hpcsa ? 'HPCSA ' + d.hpcsa : '';
                    b.appendChild(n);
                    b.appendChild(m);
                    b.addEventListener('click', function() { pick(d.doctorId, d.name, d.hpcsa); });
                    results.appendChild(b);
                });
            }
            results.hidden = false;
        }

        search.addEventListener('input', function() {
            clearTimeout(timer);
            const q = search.value.trim();
            if (q.length < 3) { results.hidden = true; return; }
            timer = setTimeout(function() {
                fetch('@Url.Action("SearchDoctors", "Patient")?q=' + encodeURIComponent(q), { credentials: 'same-origin' })
                    .then(function(r) { return r.ok ? r.json() : []; })
                    .then(render)
                    .catch(function() { results.hidden = true; });
            }, 250);
        });

        document.getElementById('docChange').addEventListener('click', clearPick);

        if (quick) {
            quick.addEventListener('click', function(e) {
                const c = e.target.closest('.cs-doc-chip');
                if (c) pick(c.dataset.id, c.dataset.name, c.dataset.hpcsa);
            });
        }

        document.addEventListener('click', function(e) {
            if (!e.target.closest('#docSearchWrap') && !e.target.closest('#docResults')) {
                results.hidden = true;
            }
        });

        // Select all / clear for one request
        document.addEventListener('click', function(e) {
            const btn = e.target.closest('.cs-select-all');
            if (!btn) return;
            const group = btn.closest('.cs-request-group');
            const boxes = Array.from(group.querySelectorAll('input[name="itemIds"]'));
            const allChecked = boxes.every(function(b) { return b.checked; });
            boxes.forEach(function(b) { b.checked = !allChecked; });
            btn.textContent = allChecked ? 'Select all' : 'Clear';
            refreshButtonState();
        });

        form.addEventListener('change', function(e) {
            if (e.target && e.target.name === 'itemIds') refreshButtonState();
        });

        form.addEventListener('submit', function(e) {
            if (!doctorId.value) {
                e.preventDefault();
                CsPopup.notice({
                    title: 'Choose a doctor',
                    message: 'Search for the doctor you want to share your results with.',
                    icon: 'fa-user-doctor'
                });
                return;
            }

            const count = getCheckedItems().length;
            if (count === 0) {
                e.preventDefault();
                CsPopup.notice({
                    title: 'No tests selected',
                    message: 'Tick at least one test to share with this doctor.',
                    icon: 'fa-flask'
                });
                return;
            }

            e.preventDefault();
            CsPopup.confirm({
                title: 'Grant access?',
                message: chosenName + ' will be able to see ' + count + (count === 1 ? ' test' : ' tests') +
                    ' and will be notified. You can revoke this at any time.',
                okText: 'Grant access',
                tone: 'neutral',
                icon: 'fa-user-check'
            }).then(function(ok) {
                if (ok) form.submit();
            });
        });

        refreshButtonState();
    })();
</script>
