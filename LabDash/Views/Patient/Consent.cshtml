@model LabDash.Models.ConsentViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Consent Management";
    ViewData["ActivePage"] = "Consent";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="cs-wrap">

    <!-- ==========================================
        BANNER
    =========================================== -->
    <div class="cs-banner">
        <div class="cs-banner-pattern"></div>

        <div class="cs-banner-left">
            <div class="cs-banner-avatar">
                <span class="cs-icon-ring"></span>
                <i class="fas fa-lock"></i>
            </div>
            <div class="cs-banner-text">
                <h1>Consent Management <span></span></h1>
                <p>Control which healthcare providers can view your medical records.</p>
            </div>
        </div>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="cs-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["SuccessMessage"]</span>
        </div>
    }

    @if (TempData["ErrorMessage"] != null)
    {
        <div class="cs-toast" style="background:#FDEDEC; color:#922B21; border-left-color:#C0392B;">
            <i class="fas fa-triangle-exclamation"></i>
            <span>@TempData["ErrorMessage"]</span>
        </div>
    }

    <!-- ==========================================
        REASSURANCE STRIP
    =========================================== -->
    <div class="cs-status-strip">
        <div class="cs-status-left">
            <span class="cs-status-dot"></span>
            <span><strong>You're in control</strong> &middot; doctors only see the specific requests you grant, and access can be revoked at any time</span>
        </div>
        <i class="fas fa-shield-halved"></i>
    </div>

    <div class="cs-grid">

        <!-- ========================================= -->
        <!-- CURRENT ACCESS -->
        <!-- ========================================= -->
        <div class="cs-panel">
            <div class="cs-panel-head">
                <span><i class="fa-solid fa-id-badge"></i> Doctor Access</span>
                <span class="cs-panel-tag">@Model.ActiveGrants.Count active</span>
            </div>

            <div class="cs-panel-body">
                @if (!Model.ActiveGrants.Any())
                {
                    <div class="cs-badge-slot">
                        <div class="cs-badge-outline">
                            <i class="fa-solid fa-user-lock"></i>
                        </div>
                        <h5>No active access grants</h5>
                        <p>No doctors currently have access to your medical records. Grant access from the panel to the right, and their access badge will appear here.</p>
                    </div>
                }
                else
                {
                    @foreach (var grant in Model.ActiveGrants)
                    {
                        <div class="cs-grant-card">
                            <div class="cs-grant-info">
                                <h5>@grant.DoctorName</h5>
                                <p>
                                    @if (!string.IsNullOrEmpty(grant.HPCSANumber))
                                    {
                                        <span>HPCSA @grant.HPCSANumber &middot; </span>
                                    }
                                    Granted @grant.GrantedDate.ToString("dd MMM yyyy")
                                </p>
                            </div>
                            <form asp-action="RevokeConsent" method="post" onsubmit="return confirm('Revoke this doctor\'s access?');">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="consentId" value="@grant.ConsentID" />
                                <button type="submit" class="cs-revoke-btn">
                                    <i class="fa-solid fa-ban"></i> Revoke
                                </button>
                            </form>
                        </div>
                    }
                }
            </div>
        </div>

        <!-- ========================================= -->
        <!-- GRANT NEW ACCESS -->
        <!-- ========================================= -->
        <div class="cs-panel">
            <div class="cs-panel-head">
                <span><i class="fa-solid fa-user-plus"></i> Grant New Access</span>
            </div>

            <div class="cs-panel-body">

                <div class="cs-steps">
                    <div class="cs-step-item"><span class="cs-step-num">1</span> Search doctor</div>
                    <div class="cs-step-connector"></div>
                    <div class="cs-step-item"><span class="cs-step-num">2</span> Select requests</div>
                    <div class="cs-step-connector"></div>
                    <div class="cs-step-item"><span class="cs-step-num">3</span> Grant access</div>
                </div>

                <form id="consentForm" asp-action="GrantConsent" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="doctorId" id="selectedDoctorId" />

                    <div class="cs-field">
                        <label>Doctor Search</label>
                        <div class="cs-input-wrap">
                            <i class="fa-solid fa-magnifying-glass"></i>
                            <input type="text" id="doctorSearch" class="cs-input"
                                   placeholder="Enter doctor name or HPCSA number..." autocomplete="off" />
                        </div>
                        <div id="doctorResults" class="cs-doctor-results"></div>
                        <small class="cs-hint" id="selectedDoctorHint" style="display:none;"></small>
                    </div>

                    <div class="cs-field">
                        <label>Select Test Requests to Share</label>

                        @if (!Model.AvailableRequests.Any())
                        {
                            <small class="cs-hint">You don't have any test requests yet, so there's nothing to share.</small>
                        }
                        else
                        {
                            <div class="cs-chip-grid">
                                @foreach (var req in Model.AvailableRequests)
                                {
                                    <input type="checkbox" id="cs-req-@req.RequestID" name="requestIds"
                                           value="@req.RequestID" class="cs-chip-input" />
                                    <label for="cs-req-@req.RequestID" class="cs-chip">
                                        <span class="cs-chip-id">REQ-@req.RequestID</span>
                                        <span class="cs-chip-type">@(string.IsNullOrEmpty(req.Label) ? "Test Request" : req.Label)</span>
                                        <i class="fa-solid fa-check cs-chip-check"></i>
                                    </label>
                                }
                            </div>
                            <small class="cs-hint">Tap a request to include it. You can select more than one.</small>
                        }
                    </div>

                    <button type="submit" class="cs-submit" id="grantBtn" disabled>
                        <i class="fas fa-check"></i> Grant Access &amp; Notify Doctor
                    </button>
                </form>
            </div>
        </div>

    </div>

    <!-- ==========================================
        FOOTER
    =========================================== -->
    <div class="cs-footer">
        <hr />
        <div class="cs-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="cs-footer-divider">|</span>
            <span>Patient Portal</span>
            <span class="cs-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>
    </div>

</div>

<style>
    :root {
        --cs-paper: #F0F7F6;
        --cs-raised: #FFFFFF;
        --cs-ink: #102C27;
        --cs-ink-soft: #52716C;
        --cs-ink-faint: #8FA9A3;
        --cs-line: #E1EEEC;
        --cs-line-strong: #CCE3DF;
        --cs-teal: #0E8C7F;
        --cs-teal-deep: #0A5850;
        --cs-teal-dim: #E3F4F1;
        --cs-teal-grad-start: #12A392;
        --cs-teal-grad-end: #0A4F48;
        --cs-radius: 20px;
        --cs-radius-sm: 13px;
        --cs-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --cs-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    .cs-wrap {
        max-width: 1080px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--cs-ink);
        font-family: 'Inter', sans-serif;
        animation: csFadeIn .5s ease;
    }

    @@keyframes csFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* ============ BANNER ============ */
    .cs-banner {
        position: relative;
        display: flex;
        align-items: center;
        gap: 22px;
        background: linear-gradient(125deg, var(--cs-teal-grad-start), var(--cs-teal-grad-end));
        border-radius: var(--cs-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }

    .cs-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .cs-banner-left {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .cs-banner-avatar {
        position: relative;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 28px;
        flex-shrink: 0;
    }

    .cs-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: csRingPulse 2.4s ease-out infinite;
    }

    @@keyframes csRingPulse {
        0% {
            transform: scale(0.9);
            opacity: .8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .cs-banner-text h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 26px;
        margin: 0 0 4px;
        color: #fff;
        letter-spacing: -.01em;
    }

    .cs-banner-text p {
        margin: 0;
        color: rgba(255,255,255,.85);
        font-size: 14.5px;
    }

    /* ============ TOAST ============ */
    .cs-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--cs-teal-dim);
        color: var(--cs-teal-deep);
        padding: 15px 20px;
        border-radius: var(--cs-radius-sm);
        margin-bottom: 20px;
        border-left: 4px solid var(--cs-teal);
        font-size: 14px;
        font-weight: 500;
    }

    /* ============ STATUS STRIP ============ */
    .cs-status-strip {
        background: var(--cs-raised);
        border-radius: var(--cs-radius);
        box-shadow: var(--cs-shadow-sm);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        border-left: 4px solid var(--cs-teal);
    }

    .cs-status-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13.5px;
        color: var(--cs-ink);
    }

        .cs-status-left strong {
            color: var(--cs-teal-deep);
        }

    .cs-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--cs-teal);
        flex-shrink: 0;
        box-shadow: 0 0 0 4px var(--cs-teal-dim);
    }

    .cs-status-strip > i {
        color: var(--cs-ink-faint);
        font-size: 15px;
    }

    /* ============ GRID ============ */
    .cs-grid {
        display: grid;
        grid-template-columns: 0.85fr 1.15fr;
        gap: 20px;
        align-items: start;
    }

    /* ============ PANEL ============ */
    .cs-panel {
        background: var(--cs-raised);
        border-radius: var(--cs-radius);
        box-shadow: var(--cs-shadow);
        overflow: hidden;
    }

    .cs-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 24px;
        border-bottom: 1px solid var(--cs-line);
    }

        .cs-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15px;
            color: var(--cs-ink);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .cs-panel-head span:first-child i {
                color: var(--cs-teal);
            }

    .cs-panel-tag {
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 11.5px;
        background: var(--cs-teal-dim);
        color: var(--cs-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    .cs-panel-body {
        padding: 26px 24px 28px;
    }

    /* ============ BADGE SLOT (empty state) ============ */
    .cs-badge-slot {
        text-align: center;
        padding: 20px 10px 10px;
    }

    .cs-badge-outline {
        width: 90px;
        height: 68px;
        margin: 0 auto 20px;
        border: 2px dashed var(--cs-line-strong);
        border-radius: 16px;
        display: flex;
        align-items: center;
        justify-content: center;
        color: var(--cs-ink-faint);
        font-size: 24px;
        position: relative;
    }

        .cs-badge-outline::before {
            content: "";
            position: absolute;
            top: -9px;
            left: 50%;
            transform: translateX(-50%);
            width: 26px;
            height: 8px;
            border-radius: 4px;
            background: var(--cs-line-strong);
        }

    .cs-badge-slot h5 {
        margin: 0 0 8px;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 15px;
        color: var(--cs-ink);
    }

    .cs-badge-slot p {
        margin: 0;
        font-size: 13px;
        color: var(--cs-ink-soft);
        line-height: 1.65;
        max-width: 290px;
        margin: 0 auto;
    }

    /* ============ GRANT CARD (active access) ============ */
    .cs-grant-card {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 14px;
        background: var(--cs-paper);
        border: 1.5px solid var(--cs-line-strong);
        border-radius: var(--cs-radius-sm);
        padding: 14px 16px;
        margin-bottom: 12px;
    }

        .cs-grant-card:last-child {
            margin-bottom: 0;
        }

    .cs-grant-info h5 {
        margin: 0 0 3px;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 14px;
        color: var(--cs-ink);
    }

    .cs-grant-info p {
        margin: 0;
        font-size: 12px;
        color: var(--cs-ink-soft);
    }

    .cs-revoke-btn {
        display: flex;
        align-items: center;
        gap: 6px;
        border: 1.5px solid #E4B8B4;
        background: #FDF3F2;
        color: #B3413B;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 12px;
        padding: 8px 14px;
        border-radius: 10px;
        cursor: pointer;
        white-space: nowrap;
        transition: background .2s, border-color .2s;
    }

        .cs-revoke-btn:hover {
            background: #FBE5E3;
            border-color: #D89A95;
        }

    /* ============ STEP TRACKER ============ */
    .cs-steps {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 26px;
        flex-wrap: wrap;
    }

    .cs-step-item {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 600;
        color: var(--cs-ink-soft);
        white-space: nowrap;
    }

    .cs-step-num {
        width: 20px;
        height: 20px;
        border-radius: 50%;
        background: var(--cs-teal-dim);
        color: var(--cs-teal-deep);
        display: flex;
        align-items: center;
        justify-content: center;
        font-family: 'IBM Plex Mono', monospace;
        font-size: 11px;
        font-weight: 700;
        flex-shrink: 0;
    }

    .cs-step-connector {
        flex: 1;
        min-width: 16px;
        height: 1px;
        background: var(--cs-line-strong);
    }

    /* ============ FIELDS ============ */
    .cs-field {
        margin-bottom: 22px;
    }

        .cs-field:last-of-type {
            margin-bottom: 26px;
        }

        .cs-field label {
            display: block;
            font-family: 'Poppins', sans-serif;
            font-weight: 600;
            font-size: 13px;
            color: var(--cs-ink);
            margin-bottom: 8px;
        }

    .cs-input-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--cs-paper);
        border: 1.5px solid var(--cs-line-strong);
        border-radius: var(--cs-radius-sm);
        padding: 0 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

        .cs-input-wrap i {
            color: var(--cs-teal);
            font-size: 14px;
        }

        .cs-input-wrap:focus-within {
            border-color: var(--cs-teal);
            background: #fff;
            box-shadow: 0 0 0 4px var(--cs-teal-dim);
        }

    .cs-input {
        flex: 1;
        border: none;
        background: transparent;
        outline: none;
        padding: 12px 0;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: var(--cs-ink);
    }

    /* ============ DOCTOR SEARCH RESULTS ============ */
    .cs-doctor-results {
        margin-top: 8px;
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .cs-doctor-result {
        display: flex;
        justify-content: space-between;
        align-items: center;
        background: var(--cs-paper);
        border: 1.5px solid var(--cs-line-strong);
        border-radius: var(--cs-radius-sm);
        padding: 10px 14px;
        cursor: pointer;
        transition: border-color .15s, background .15s;
    }

        .cs-doctor-result:hover {
            border-color: var(--cs-teal);
            background: var(--cs-teal-dim);
        }

        .cs-doctor-result .cs-dr-name {
            font-weight: 600;
            font-size: 13px;
            color: var(--cs-ink);
        }

        .cs-doctor-result .cs-dr-hpcsa {
            font-family: 'IBM Plex Mono', monospace;
            font-size: 11.5px;
            color: var(--cs-ink-soft);
        }

    .cs-doctor-result.selected {
        border-color: var(--cs-teal);
        background: var(--cs-teal-dim);
    }

    /* ============ CHIP MULTISELECT ============ */
    .cs-chip-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 10px;
    }

    .cs-chip-input {
        position: absolute;
        opacity: 0;
        width: 0;
        height: 0;
    }

    .cs-chip {
        position: relative;
        display: flex;
        flex-direction: column;
        gap: 2px;
        background: var(--cs-paper);
        border: 1.5px solid var(--cs-line-strong);
        border-radius: var(--cs-radius-sm);
        padding: 12px 34px 12px 14px;
        cursor: pointer;
        transition: border-color .2s, background .2s, transform .15s;
    }

        .cs-chip:hover {
            border-color: var(--cs-teal);
            transform: translateY(-1px);
        }

    .cs-chip-id {
        font-family: 'IBM Plex Mono', monospace;
        font-weight: 700;
        font-size: 12.5px;
        color: var(--cs-teal-deep);
    }

    .cs-chip-type {
        font-size: 12px;
        color: var(--cs-ink-soft);
    }

    .cs-chip-check {
        position: absolute;
        top: 50%;
        right: 12px;
        transform: translateY(-50%) scale(0);
        color: var(--cs-teal);
        font-size: 13px;
        transition: transform .15s;
    }

    .cs-chip-input:checked + .cs-chip {
        background: var(--cs-teal-dim);
        border-color: var(--cs-teal);
    }

        .cs-chip-input:checked + .cs-chip .cs-chip-check {
            transform: translateY(-50%) scale(1);
        }

    .cs-chip-input:focus-visible + .cs-chip {
        box-shadow: 0 0 0 3px var(--cs-teal-dim);
    }

    .cs-hint {
        display: block;
        margin-top: 10px;
        font-size: 12px;
        color: var(--cs-ink-faint);
    }

    /* ============ SUBMIT ============ */
    .cs-submit {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        padding: 15px;
        border: none;
        border-radius: var(--cs-radius-sm);
        background: linear-gradient(120deg, var(--cs-teal-grad-start), var(--cs-teal-grad-end));
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(10, 90, 80, 0.22);
        transition: transform .2s, box-shadow .2s, opacity .2s;
    }

        .cs-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(10, 90, 80, 0.28);
        }

        .cs-submit:disabled {
            opacity: .5;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* ============ FOOTER ============ */
    .cs-footer {
        margin-top: 40px;
        text-align: center;
    }

        .cs-footer hr {
            border: none;
            border-top: 1px solid var(--cs-line);
            margin-bottom: 22px;
        }

    .cs-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--cs-ink-faint);
        font-size: 13px;
    }

        .cs-footer-content i {
            color: var(--cs-teal);
        }

    .cs-footer-divider {
        color: var(--cs-line-strong);
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 900px) {
        .cs-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 560px) {
        .cs-wrap {
            padding: 20px 14px 50px;
        }

        .cs-chip-grid {
            grid-template-columns: 1fr;
        }

        .cs-panel-body {
            padding: 22px 18px 26px;
        }

        .cs-status-strip {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }
    }
</style>

<script>
    (function () {
        const searchInput = document.getElementById('doctorSearch');
        const resultsBox = document.getElementById('doctorResults');
        const hiddenDoctorId = document.getElementById('selectedDoctorId');
        const selectedHint = document.getElementById('selectedDoctorHint');
        const grantBtn = document.getElementById('grantBtn');
        let debounceTimer = null;

        function clearSelection() {
            hiddenDoctorId.value = '';
            selectedHint.style.display = 'none';
            grantBtn.disabled = true;
        }

        searchInput.addEventListener('input', function () {
            clearSelection();
            clearTimeout(debounceTimer);

            const query = searchInput.value.trim();
            if (query.length < 2) {
                resultsBox.innerHTML = '';
                return;
            }

            debounceTimer = setTimeout(function () {
                fetch('/Patient/SearchDoctors?query=' + encodeURIComponent(query))
                    .then(function (res) { return res.json(); })
                    .then(function (doctors) {
                        if (!doctors || doctors.length === 0) {
                            resultsBox.innerHTML = '<small class="cs-hint">No matching doctors found.</small>';
                            return;
                        }

                        resultsBox.innerHTML = doctors.map(function (d) {
                            return '<div class="cs-doctor-result" data-id="' + d.doctorId + '" data-name="' + d.fullName + '">' +
                                '<span class="cs-dr-name">' + d.fullName + '</span>' +
                                (d.hpcsaNumber ? '<span class="cs-dr-hpcsa">HPCSA ' + d.hpcsaNumber + '</span>' : '') +
                                '</div>';
                        }).join('');

                        resultsBox.querySelectorAll('.cs-doctor-result').forEach(function (el) {
                            el.addEventListener('click', function () {
                                hiddenDoctorId.value = el.dataset.id;
                                searchInput.value = el.dataset.name;
                                resultsBox.innerHTML = '';
                                selectedHint.textContent = 'Selected: ' + el.dataset.name;
                                selectedHint.style.display = 'block';
                                grantBtn.disabled = false;
                            });
                        });
                    })
                    .catch(function () {
                        resultsBox.innerHTML = '<small class="cs-hint">Something went wrong searching for doctors.</small>';
                    });
            }, 300);
        });

        document.getElementById('consentForm').addEventListener('submit', function (e) {
            if (!hiddenDoctorId.value) {
                e.preventDefault();
                alert('Please select a doctor from the search results first.');
            }
        });
    })();
</script>
