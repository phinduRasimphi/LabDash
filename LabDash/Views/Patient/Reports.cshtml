@model LabDash.Models.ReportViewModel
@using LabDash.Models
@using LabDash.Helpers

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Reports";
    ViewData["ActivePage"] = "Reports";

    var results = Model.FilteredResults ?? new List<TestResultViewModel>();
    var reportType = ReportTypes.Normalize(Model.ReportType);
    var isAttention = reportType == ReportTypes.AbnormalResults;
    var isTrend = reportType == ReportTypes.HealthTrend;

    var totalResults = results.Count;
    var abnormalResults = results.Count(r => r.IsAbnormal);
    var normalResults = totalResults - abnormalResults;
    var categories = results.Select(r => ReportHelper.CategoryName(r)).Distinct().Count();
    var requests = results.Select(r => r.RequestID).Distinct().Count();

    var abnormalPercentage = totalResults > 0
        ? (double)abnormalResults / totalResults * 100
        : 0;

    // Same ordering and filtering the PDF uses: category, test name, date
    var previewRows = ReportHelper
        .OrderForReport(isAttention ? results.Where(r => r.IsAbnormal) : results)
        .ToList();

    var trends = isTrend ? ReportHelper.BuildTrends(results) : new List<TestTrend>();

    var periodText = Model.FromDate.ToString("dd MMM yyyy") + " - " + Model.ToDate.ToString("dd MMM yyyy");
    var inputValid = ViewData.ModelState.IsValid;

    var previewTitle = isTrend
        ? "Trend Summary for Selected Period"
        : isAttention
            ? "Abnormal Results for Selected Period"
            : "Results for Selected Period";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600;700&display=swap" rel="stylesheet">

<div class="rp-wrap">

    <!-- =========================================================
     HERO
    ========================================================== -->

    <section class="rp-hero">

        <div class="rp-hero-bg"></div>

        <div class="rp-hero-content">

            <div class="rp-hero-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <div>

                <div class="rp-eyebrow">
                    <i class="fas fa-shield-heart"></i>
                    Patient Reporting
                </div>

                <h1>Medical Reports</h1>

                <p>
                    Generate, review and organise reports based on
                    your laboratory results and selected date range.
                </p>

            </div>

        </div>

        <div class="rp-hero-side">

            <div class="rp-hero-stat">
                <strong>@totalResults</strong>
                <span>Results Available</span>
            </div>

            <div class="rp-hero-divider"></div>

            <div class="rp-hero-stat">
                <strong>@requests</strong>
                <span>Test Requests</span>
            </div>

        </div>

    </section>

    <!-- =========================================================
     SUMMARY
    ========================================================== -->

    <section class="rp-stats">

        <div class="rp-stat">
            <div class="rp-stat-icon rp-teal"><i class="fas fa-vials"></i></div>
            <div>
                <span>Total Results</span>
                <strong>@totalResults</strong>
                <small>Selected period</small>
            </div>
        </div>

        <div class="rp-stat">
            <div class="rp-stat-icon rp-green"><i class="fas fa-circle-check"></i></div>
            <div>
                <span>Normal</span>
                <strong>@normalResults</strong>
                <small>Within reference range</small>
            </div>
        </div>

        <div class="rp-stat">
            <div class="rp-stat-icon rp-red"><i class="fas fa-triangle-exclamation"></i></div>
            <div>
                <span>Needs Attention</span>
                <strong>@abnormalResults</strong>
                <small>@abnormalPercentage.ToString("0")% of results</small>
            </div>
        </div>

        <div class="rp-stat">
            <div class="rp-stat-icon rp-purple"><i class="fas fa-layer-group"></i></div>
            <div>
                <span>Categories</span>
                <strong>@categories</strong>
                <small>Test categories</small>
            </div>
        </div>

    </section>

    <!-- =========================================================
     GENERATE REPORT
    ========================================================== -->

    <section class="rp-builder">

        <div class="rp-builder-head">

            <div>
                <span class="rp-section-label">
                    <i class="fas fa-wand-magic-sparkles"></i>
                    Report Builder
                </span>

                <h2>Generate a New Report</h2>

                <p>
                    Select the period and the type of report. Use Update preview to
                    check what will be included before you generate the PDF.
                </p>
            </div>

            <div class="rp-builder-badge">
                <i class="fas fa-file-pdf"></i>
                PDF
            </div>

        </div>

        <form asp-action="Reports" asp-fragment="rpPreview" method="post" class="rp-form">

            <div asp-validation-summary="All" class="rp-alert"></div>

            <!-- DATE RANGE -->

            <div class="rp-form-section">

                <div class="rp-form-title">
                    <span>1</span>
                    <div>
                        <strong>Select Date Range</strong>
                        <small>Define which laboratory results should be included.</small>
                    </div>
                </div>

                <div class="rp-date-grid">

                    <div class="rp-field">
                        <label asp-for="FromDate">From Date</label>
                        <div class="rp-input-wrap">
                            <i class="fas fa-calendar-days"></i>
                            <input asp-for="FromDate" type="date" class="rp-input" />
                        </div>
                    </div>

                    <div class="rp-date-arrow">
                        <i class="fas fa-arrow-right"></i>
                    </div>

                    <div class="rp-field">
                        <label asp-for="ToDate">To Date</label>
                        <div class="rp-input-wrap">
                            <i class="fas fa-calendar-days"></i>
                            <input asp-for="ToDate" type="date" class="rp-input" />
                        </div>
                    </div>

                </div>

            </div>

            <!-- REPORT TYPE -->

            <div class="rp-form-section">

                <div class="rp-form-title">
                    <span>2</span>
                    <div>
                        <strong>Choose Report Type</strong>
                        <small>Select the format of information you want to review.</small>
                    </div>
                </div>

                <div class="rp-type-grid">

                    <label class="rp-type-card">
                        <input type="radio" name="ReportType" value="@ReportTypes.AllResults" checked="@(reportType == ReportTypes.AllResults)" />
                        <div class="rp-type-check"><i class="fas fa-check"></i></div>
                        <div class="rp-type-icon"><i class="fas fa-list-check"></i></div>
                        <div>
                            <strong>Complete Results</strong>
                            <p>Every result grouped by test category, with totals for each category.</p>
                        </div>
                    </label>

                    <label class="rp-type-card">
                        <input type="radio" name="ReportType" value="@ReportTypes.HealthTrend" checked="@(reportType == ReportTypes.HealthTrend)" />
                        <div class="rp-type-check"><i class="fas fa-check"></i></div>
                        <div class="rp-type-icon rp-purple-bg"><i class="fas fa-chart-line"></i></div>
                        <div>
                            <strong>Health Trend</strong>
                            <p>A chart and reading history for each test, showing how your results changed.</p>
                        </div>
                    </label>

                    <label class="rp-type-card">
                        <input type="radio" name="ReportType" value="@ReportTypes.AbnormalResults" checked="@(reportType == ReportTypes.AbnormalResults)" />
                        <div class="rp-type-check"><i class="fas fa-check"></i></div>
                        <div class="rp-type-icon rp-red-bg"><i class="fas fa-triangle-exclamation"></i></div>
                        <div>
                            <strong>Attention Report</strong>
                            <p>Only results outside their reference range, flagged High or Low.</p>
                        </div>
                    </label>

                </div>

            </div>

            <!-- GENERATE -->

            <div class="rp-generate">

                <div class="rp-generate-info">
                    <div class="rp-generate-icon">
                        <i class="fas fa-file-pdf"></i>
                    </div>
                    <div>
                        <strong>Ready to generate?</strong>
                        <span>
                            The PDF uses the date range and report type selected above.
                        </span>
                    </div>
                </div>

                <div class="rp-generate-actions">

                    <button type="submit" class="rp-preview-btn">
                        <i class="fas fa-eye"></i>
                        Update preview
                    </button>

                    <button type="submit" asp-action="DownloadReportPdf" class="rp-generate-btn">
                        <i class="fas fa-file-arrow-down"></i>
                        Generate PDF Report
                    </button>

                </div>

            </div>

        </form>

    </section>

    <!-- =========================================================
     RESULTS PREVIEW
    ========================================================== -->
    @if (totalResults > 0)
    {
        <section class="rp-results" id="rpPreview">

            <div class="rp-results-head">

                <div>
                    <span class="rp-section-label">
                        <i class="fas fa-table-list"></i>
                        Report Preview
                    </span>

                    <h2>@previewTitle</h2>
                    <p class="rp-results-period">@periodText</p>
                </div>

                <div class="rp-result-count">
                    <strong>@(isAttention ? abnormalResults : totalResults)</strong>
                    <span>@(isAttention ? "Abnormal" : "Entries")</span>
                </div>

            </div>

            <div class="rp-result-summary">

                <div>
                    <span class="rp-summary-dot rp-green-dot"></span>
                    <span>Normal</span>
                    <strong>@normalResults</strong>
                </div>

                <div>
                    <span class="rp-summary-dot rp-red-dot"></span>
                    <span>Abnormal</span>
                    <strong>@abnormalResults</strong>
                </div>

                <div>
                    <span class="rp-summary-dot rp-teal-dot"></span>
                    <span>Requests</span>
                    <strong>@requests</strong>
                </div>

            </div>

            @if (isTrend)
            {
                <div class="rp-table-wrap">

                    <table class="rp-table">

                        <thead>
                            <tr>
                                <th>Test</th>
                                <th>Category</th>
                                <th>Readings</th>
                                <th>First</th>
                                <th>Latest</th>
                                <th>Change</th>
                                <th>Trend</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var t in trends)
                            {
                                var dirIcon = t.DirectionKey == "up" ? "fa-arrow-trend-up"
                                    : t.DirectionKey == "down" ? "fa-arrow-trend-down"
                                    : t.DirectionKey == "flat" ? "fa-minus"
                                    : "fa-ellipsis";

                                <tr>
                                    <td>
                                        <div class="rp-test">
                                            <div class="rp-test-icon"><i class="fas fa-vial"></i></div>
                                            <div><strong>@t.TestName</strong></div>
                                        </div>
                                    </td>
                                    <td><span class="rp-category">@t.Category</span></td>
                                    <td>@t.Readings.Count</td>
                                    <td>@t.FirstText</td>
                                    <td><strong class="rp-result-value @(t.AbnormalCount > 0 ? "rp-abnormal" : "")">@t.LatestText</strong></td>
                                    <td>@t.ChangeText</td>
                                    <td><span class="rp-trend rp-trend-@t.DirectionKey"><i class="fas @dirIcon"></i> @t.Direction</span></td>
                                </tr>
                            }
                        </tbody>

                    </table>

                </div>

                <p class="rp-preview-note">
                    The PDF also includes a chart and the full reading history for every test.
                </p>
            }
            else if (previewRows.Count == 0)
            {
                <div class="rp-allclear">
                    <i class="fas fa-circle-check"></i>
                    <div>
                        <strong>No abnormal results found</strong>
                        <p>All @totalResults results in this period were within their reference ranges.</p>
                    </div>
                </div>
            }
            else
            {
                foreach (var grp in previewRows.GroupBy(r => ReportHelper.CategoryName(r)))
                {
                    var grpAbnormal = grp.Count(r => r.IsAbnormal);

                    <div class="rp-cat">

                        <div class="rp-cat-head">
                            <h3>@grp.Key</h3>
                            <span>@grp.Count() result@(grp.Count() == 1 ? "" : "s")@(isAttention ? "" : ", " + grpAbnormal + " abnormal")</span>
                        </div>

                        <div class="rp-table-wrap">

                            <table class="rp-table">

                                <thead>
                                    <tr>
                                        <th>Test</th>
                                        <th>Request</th>
                                        <th>Result</th>
                                        <th>Reference range</th>
                                        <th>Date</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>

                                <tbody>
                                    @foreach (var r in grp)
                                    {
                                        var flag = ReportHelper.Flag(r);
                                        var range = ReportHelper.RangeText(r);

                                        <tr>

                                            <td>
                                                <div class="rp-test">
                                                    <div class="rp-test-icon"><i class="fas fa-vial"></i></div>
                                                    <div><strong>@r.TestName</strong></div>
                                                </div>
                                            </td>

                                            <td><span class="rp-request">#@r.RequestID</span></td>

                                            <td>
                                                <strong class="rp-result-value @(r.IsAbnormal ? "rp-abnormal" : "")">@r.ResultValue</strong>
                                                <span class="rp-unit">@r.Unit</span>
                                            </td>

                                            <td>
                                                <span class="rp-range">@(range == "-" ? "-" : range + " " + r.Unit)</span>
                                            </td>

                                            <td>
                                                <span class="rp-date">
                                                    <i class="far fa-calendar"></i>
                                                    @r.ResultDate.ToString("dd MMM yyyy")
                                                </span>
                                            </td>

                                            <td>
                                                @if (r.IsAbnormal)
                                                {
                                                    <span class="rp-status rp-status-abnormal">
                                                        <i class="fas fa-triangle-exclamation"></i>
                                                        @flag
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="rp-status rp-status-normal">
                                                        <i class="fas fa-check"></i>
                                                        Normal
                                                    </span>
                                                }
                                            </td>

                                        </tr>
                                    }
                                </tbody>

                            </table>

                        </div>

                    </div>
                }
            }

        </section>
    }
    else if (inputValid)
    {
        <!-- =====================================================
         EMPTY STATE
        ====================================================== -->

        <section class="rp-empty" id="rpPreview">

            <div class="rp-empty-icon">
                <i class="fas fa-file-circle-xmark"></i>
            </div>

            <div>

                <span class="rp-section-label">
                    <i class="fas fa-info-circle"></i>
                    Nothing to Preview
                </span>

                <h2>No records found for the selected date range</h2>

                <p>
                    There are no released laboratory results between @periodText.
                    Choose a wider date range and update the preview. If you generate the PDF
                    anyway, it will state that no records were found.
                </p>

            </div>

        </section>
    }

    <!-- =========================================================
     REPORT INFORMATION
    ========================================================== -->

    <section class="rp-info-grid">

        <div class="rp-info-card">
            <div class="rp-info-icon"><i class="fas fa-lock"></i></div>
            <div>
                <strong>Secure Reports</strong>
                <p>Reports contain patient medical information and should be handled securely.</p>
            </div>
        </div>

        <div class="rp-info-card">
            <div class="rp-info-icon"><i class="fas fa-filter"></i></div>
            <div>
                <strong>Released Results Only</strong>
                <p>Only results your doctor has released, within your selected period, are included.</p>
            </div>
        </div>

        <div class="rp-info-card">
            <div class="rp-info-icon"><i class="fas fa-file-pdf"></i></div>
            <div>
                <strong>PDF Format</strong>
                <p>Reports are formatted for printing and sharing, with page numbers on every page.</p>
            </div>
        </div>

    </section>

    <!-- =========================================================
     FOOTER
    ========================================================== -->

    <footer class="rp-footer">

        <span>
            <i class="fas fa-shield-halved"></i>
            Laboratory Information Management System
        </span>

        <span>Patient Reports</span>

        <span>&bull;</span>

        <span>@DateTime.Now.Year</span>

    </footer>

</div>


<style>

    /* =========================================================
           REPORTS — MEDICAL TEAL THEME (v2, readable scale)
           ========================================================= */

    :root {
        --rp-paper: #F0F7F6;
        --rp-white: #FFFFFF;
        --rp-ink: #102C27;
        --rp-soft: #3E5C57;
        --rp-faint: #6C8983;
        --rp-line: #E1EEEC;
        --rp-line-strong: #CCE3DF;
        --rp-teal: #0E8C7F;
        --rp-teal-deep: #0A5850;
        --rp-teal-light: #E3F4F1;
        --rp-green: #227A4A;
        --rp-green-light: #E3F4EA;
        --rp-red: #A63A32;
        --rp-red-light: #F7E8E7;
        --rp-purple: #6D4EA8;
        --rp-purple-light: #EEE8F9;
        --rp-shadow: 0 8px 28px rgba(10,60,55,.08);
    }


    .rp-wrap {
        max-width: 1240px;
        margin: 0 auto;
        padding: 32px 24px 64px;
        color: var(--rp-ink);
        font-family: 'Inter', sans-serif;
        font-size: 16px;
        line-height: 1.5;
        animation: rpFade .45s ease;
    }


    @@keyframes rpFade {

        from {
            opacity: 0;
            transform: translateY(10px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }


    /* =========================================================
           HERO
           ========================================================= */

    .rp-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 26px;
        padding: 36px 38px;
        margin-bottom: 22px;
        overflow: hidden;
        border-radius: 20px;
        background: linear-gradient( 125deg, #12A392, #0A4F48 );
        box-shadow: 0 18px 45px rgba(10,90,80,.20);
    }


    .rp-hero-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient( circle at 85% 15%, rgba(255,255,255,.13), transparent 35% );
    }


    .rp-hero-content {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 20px;
    }


    .rp-hero-icon {
        width: 68px;
        height: 68px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 17px;
        color: #fff;
        font-size: 26px;
        background: rgba(255,255,255,.15);
        border: 1px solid rgba(255,255,255,.25);
    }


    .rp-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 6px;
        color: rgba(255,255,255,.8);
        font-size: 13px;
        font-weight: 700;
        letter-spacing: .02em;
    }


    .rp-hero h1 {
        margin: 0 0 6px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 32px;
        line-height: 1.15;
    }


    .rp-hero p {
        max-width: 580px;
        margin: 0;
        color: rgba(255,255,255,.9);
        font-size: 15px;
        line-height: 1.55;
    }


    .rp-hero-side {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 26px;
    }


    .rp-hero-stat {
        text-align: center;
    }


        .rp-hero-stat strong {
            display: block;
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 30px;
            line-height: 1;
        }


        .rp-hero-stat span {
            display: block;
            margin-top: 6px;
            color: rgba(255,255,255,.75);
            font-size: 12px;
            font-weight: 600;
        }


    .rp-hero-divider {
        width: 1px;
        height: 46px;
        background: rgba(255,255,255,.23);
    }


    /* =========================================================
           STATISTICS
           ========================================================= */

    .rp-stats {
        display: grid;
        grid-template-columns: repeat(4,1fr);
        gap: 16px;
        margin-bottom: 24px;
    }


    .rp-stat {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 18px;
        background: #fff;
        border: 1px solid var(--rp-line);
        border-radius: 16px;
        box-shadow: var(--rp-shadow);
        transition: .2s ease;
    }


        .rp-stat:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 32px rgba(10,60,55,.12);
        }


    .rp-stat-icon {
        width: 48px;
        height: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 12px;
        font-size: 17px;
    }


    .rp-teal {
        color: var(--rp-teal);
        background: var(--rp-teal-light);
    }


    .rp-green {
        color: var(--rp-green);
        background: var(--rp-green-light);
    }


    .rp-red {
        color: var(--rp-red);
        background: var(--rp-red-light);
    }


    .rp-purple {
        color: var(--rp-purple);
        background: var(--rp-purple-light);
    }


    .rp-stat span {
        display: block;
        color: var(--rp-soft);
        font-size: 13px;
        font-weight: 600;
    }


    .rp-stat strong {
        display: block;
        margin-top: 2px;
        font-family: 'Poppins', sans-serif;
        font-size: 26px;
        line-height: 1.2;
    }


    .rp-stat small {
        display: block;
        margin-top: 3px;
        color: var(--rp-faint);
        font-size: 12px;
    }


    /* =========================================================
           BUILDER
           ========================================================= */

    .rp-builder {
        margin-bottom: 24px;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--rp-line);
        border-radius: 20px;
        box-shadow: var(--rp-shadow);
    }


    .rp-builder-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 12px;
        padding: 26px;
        border-bottom: 1px solid var(--rp-line);
    }


    .rp-section-label {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--rp-teal);
        font-size: 13px;
        font-weight: 700;
    }


    .rp-builder-head h2,
    .rp-results-head h2 {
        margin: 6px 0 4px;
        font-family: 'Poppins', sans-serif;
        font-size: 22px;
    }


    .rp-builder-head p {
        margin: 0;
        color: var(--rp-soft);
        font-size: 14px;
    }


    .rp-builder-badge {
        display: flex;
        align-items: center;
        gap: 7px;
        padding: 9px 14px;
        border-radius: 999px;
        color: var(--rp-red);
        background: var(--rp-red-light);
        font-size: 13px;
        font-weight: 700;
    }


    .rp-form {
        padding: 26px;
    }


    .rp-form-section {
        padding-bottom: 26px;
        margin-bottom: 26px;
        border-bottom: 1px solid var(--rp-line);
    }


    .rp-form-title {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 19px;
    }


        .rp-form-title > span {
            width: 34px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 9px;
            color: var(--rp-teal);
            background: var(--rp-teal-light);
            font-family: 'Poppins', sans-serif;
            font-size: 15px;
            font-weight: 700;
        }


        .rp-form-title strong {
            display: block;
            font-size: 16px;
        }


        .rp-form-title small {
            display: block;
            margin-top: 3px;
            color: var(--rp-faint);
            font-size: 13px;
        }


    /* DATE */

