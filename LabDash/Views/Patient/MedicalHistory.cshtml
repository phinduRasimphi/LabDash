@model LabDash.Models.MedicalHistoryViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["ActivePage"] = "MedicalHistory";
}

<div class="p-content">

    <div class="p-hero">
        <div class="p-hero-inner">
            <div>
                <h1 class="p-hero-title">Medical History 🩺</h1>
                <p class="p-hero-subtitle">
                    View your recorded medical conditions, allergies and medication.
                </p>
            </div>
        </div>
    </div>

    <div class="p-r2">

        <!-- MEDICAL CONDITIONS -->

        <div class="p-card">

            <div class="p-ch">
                <div class="p-ct">
                    <i class="fas fa-notes-medical"></i>
                    Medical Conditions
                </div>

                <span class="p-htag p-ht-c">
                    @(Model.Conditions?.Count ?? 0)
                </span>
            </div>

            <div class="p-cb">

                @if (Model.Conditions != null && Model.Conditions.Any())
                {
                    foreach (var condition in Model.Conditions)
                    {
                        <div style="
                            padding: 12px 0;
                            border-bottom: 1px solid #eee;">

                            <i class="fas fa-heartbeat"
                               style="color: #0f717e; margin-right: 8px;">
                            </i>

                            <span style="color: #333;">
                                @condition
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div style="
                        text-align: center;
                        padding: 30px;
                        color: #66788a;">

                        <i class="fas fa-check-circle"
                           style="
                            font-size: 2rem;
                            color: #0f717e;
                            margin-bottom: 10px;">
                        </i>

                        <p>No medical conditions recorded.</p>

                    </div>
                }

            </div>
        </div>


        <!-- ALLERGIES -->

        <div class="p-card">

            <div class="p-ch">
                <div class="p-ct">
                    <i class="fas fa-allergies"></i>
                    Allergies
                </div>

                <span class="p-htag p-ht-c">
                    @(Model.Allergies?.Count ?? 0)
                </span>
            </div>

            <div class="p-cb">

                @if (Model.Allergies != null && Model.Allergies.Any())
                {
                    foreach (var allergy in Model.Allergies)
                    {
                        <div style="
                            padding: 12px 0;
                            border-bottom: 1px solid #eee;">

                            <i class="fas fa-exclamation-triangle"
                               style="color: #e65100; margin-right: 8px;">
                            </i>

                            <span style="color: #333;">
                                @allergy
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div style="
                        text-align: center;
                        padding: 30px;
                        color: #66788a;">

                        <i class="fas fa-check-circle"
                           style="
                            font-size: 2rem;
                            color: #0f717e;
                            margin-bottom: 10px;">
                        </i>

                        <p>No allergies recorded.</p>

                    </div>
                }

            </div>
        </div>


        <!-- MEDICATION -->

        <div class="p-card">

            <div class="p-ch">
                <div class="p-ct">
                    <i class="fas fa-pills"></i>
                    Medication
                </div>

                <span class="p-htag p-ht-c">
                    @(Model.Medication?.Count ?? 0)
                </span>
            </div>

            <div class="p-cb">

                @if (Model.Medication != null && Model.Medication.Any())
                {
                    foreach (var medication in Model.Medication)
                    {
                        <div style="
                            padding: 12px 0;
                            border-bottom: 1px solid #eee;">

                            <i class="fas fa-pills"
                               style="color: #0f717e; margin-right: 8px;">
                            </i>

                            <span style="color: #333;">
                                @medication
                            </span>

                        </div>
                    }
                }
                else
                {
                    <div style="
                        text-align: center;
                        padding: 30px;
                        color: #66788a;">

                        <i class="fas fa-info-circle"
                           style="
                            font-size: 2rem;
                            color: #0f717e;
                            margin-bottom: 10px;">
                        </i>

                        <p>No medication recorded.</p>

                    </div>
                }

            </div>
        </div>

    </div>
</div>