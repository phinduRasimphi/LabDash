@using System.Linq
@model LabDash.Models.MedicalHistoryViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["ActivePage"] = "MedicalHistory";

    var conditionCount  = Model.Conditions?.Count  ?? 0;
    var allergyCount    = Model.Allergies?.Count   ?? 0;
    var medicationCount = Model.Medications?.Count ?? 0;
    var totalRecords    = conditionCount + allergyCount + medicationCount;

    // ---- Build a single list of records from the three record types ----
    // NOTE: dates are not guaranteed to be present on every record (lab-entered
    // history is frequently backfilled without a confirmed event date), so the
    // view no longer assumes every item can be placed on a timeline. Records
    // are split into "dated" (placed on the chronological timeline) and
    // "undated" (shown separately, flagged as needing verification) instead of
    // silently sorting missing dates to DateTime.MinValue.
    var allItems = new List<RecordItem>();
    var refCounters = new Dictionary<string, int>();

    string NextRef(string type)
    {
        var prefix = type == "allergy" ? "ALG" : type == "medication" ? "MED" : "CND";
        refCounters.TryGetValue(prefix, out var n);
        n += 1;
        refCounters[prefix] = n;
        return $"{prefix}-{n:D3}";
    }

    if (Model.Conditions != null)
    {
        foreach (var c in Model.Conditions)
        {
            allItems.Add(new RecordItem
            {
                Type        = "condition",
                Ref         = NextRef("condition"),
                Name        = c.Name,
                Category    = c.CategoryName,
                PrimaryDate = c.DiagnosisDate,
                DateLabel   = "Diagnosed",
                Severity    = c.Severity,
                SeverityCss = c.SeverityCssClass,
                Doctor      = c.RecordedByDoctorName,
                Notes       = c.Notes
            });
        }
    }

    if (Model.Allergies != null)
    {
        foreach (var a in Model.Allergies)
        {
            allItems.Add(new RecordItem
            {
                Type        = "allergy",
                Ref         = NextRef("allergy"),
                Name        = a.Name,
                Category    = a.CategoryName,
                PrimaryDate = a.RecordedDate,
                DateLabel   = "Recorded",
                Severity    = a.Severity,
                SeverityCss = a.SeverityCssClass,
                Doctor      = a.RecordedByDoctorName,
                Notes       = a.Notes
            });
        }
    }

    if (Model.Medications != null)
    {
        foreach (var m in Model.Medications)
        {
            allItems.Add(new RecordItem
            {
                Type        = "medication",
                Ref         = NextRef("medication"),
                Name        = m.Name,
                Category    = m.CategoryName,
                PrimaryDate = m.StartDate,
                EndDate     = m.EndDate,
                DateLabel   = "Started",
                Doctor      = m.RecordedByDoctorName,
                Notes       = m.Notes,
                Dosage      = m.Dosage,
                Frequency   = m.Frequency,
                IsActive    = m.IsActive
            });
        }
    }

    var datedItems = allItems
        .Where(i => i.PrimaryDate.HasValue)
        .OrderByDescending(i => i.PrimaryDate)
        .ToList();

    var undatedItems = allItems
        .Where(i => !i.PrimaryDate.HasValue)
        .OrderBy(i => i.Name)
        .ToList();

    var undatedCount   = undatedItems.Count;
    var completenessPct = totalRecords > 0
        ? (int)Math.Round(100.0 * datedItems.Count / totalRecords)
        : 100;
}

@functions {
    public class RecordItem
    {
        public string Type { get; set; }
        public string Ref { get; set; }
        public string Name { get; set; }
        public string Category { get; set; }
        public DateTime? PrimaryDate { get; set; }
        public DateTime? EndDate { get; set; }
        public string DateLabel { get; set; }
        public string Severity { get; set; }
        public string SeverityCss { get; set; }
        public string Doctor { get; set; }
        public string Notes { get; set; }
        public string Dosage { get; set; }
        public string Frequency { get; set; }
        public bool? IsActive { get; set; }
    }
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="mh-page">

    <!-- ==========================================
         HERO
    =========================================== -->
    <section class="mh-hero">

        <div class="mh-hero-pattern"></div>

        <div class="mh-hero-left">

            <div class="mh-hero-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <div>
                <div class="mh-eyebrow">
                    <i class="fas fa-shield-heart"></i>
                    Personal Health Record
                </div>

                <h1>Medical History</h1>

                <p>
                    A lab-maintained record of your conditions, allergies and
                    medication — including entries still awaiting a confirmed
                    date.
                </p>
            </div>

        </div>

        <div class="mh-hero-right">

            <div class="mh-health-status">
                <span class="mh-status-dot"></span>
                Health Record Active
            </div>

            <div class="mh-hero-stat">
                <strong>@totalRecords</strong>
                <span>Records</span>
            </div>

            <div class="mh-hero-stat mh-hero-stat-divider">
                <strong>@completenessPct%</strong>
                <span>Dated</span>
            </div>

        </div>

    </section>


    <!-- ==========================================
         SUMMARY
    =========================================== -->
    <section class="mh-summary">

        <div class="mh-summary-card mh-summary-condition">
            <div class="mh-summary-icon"><i class="fas fa-heart-pulse"></i></div>
            <div class="mh-summary-info">
                <span>Conditions</span>
                <strong>@conditionCount</strong>
                <small>Recorded conditions</small>
            </div>
            <div class="mh-summary-arrow"><i class="fas fa-notes-medical"></i></div>
        </div>

        <div class="mh-summary-card mh-summary-allergy">
            <div class="mh-summary-icon"><i class="fas fa-allergies"></i></div>
            <div class="mh-summary-info">
                <span>Allergies</span>
                <strong>@allergyCount</strong>
                <small>Known allergies</small>
            </div>
            <div class="mh-summary-arrow"><i class="fas fa-triangle-exclamation"></i></div>
        </div>

        <div class="mh-summary-card mh-summary-medication">
            <div class="mh-summary-icon"><i class="fas fa-pills"></i></div>
            <div class="mh-summary-info">
                <span>Medication</span>
                <strong>@medicationCount</strong>
                <small>Recorded medications</small>
            </div>
            <div class="mh-summary-arrow"><i class="fas fa-prescription-bottle-medical"></i></div>
        </div>

    </section>

    @if (undatedCount > 0)
    {
        <div class="mh-completeness-banner">
            <div class="mh-completeness-icon"><i class="fas fa-clipboard-question"></i></div>
            <div class="mh-completeness-text">
                <strong>@undatedCount record@(undatedCount == 1 ? "" : "s") missing a confirmed date</strong>
                <span>These entries are on file but haven't been dated by the recording clinician yet. They're listed separately below.</span>
            </div>
            <a href="#mhUndatedSection" class="mh-completeness-jump">
                Review <i class="fas fa-arrow-down"></i>
            </a>
        </div>
    }


    <!-- ==========================================
         TIMELINE / MEDICAL FILE
    =========================================== -->
    <section class="mh-section">

        <div class="mh-section-heading">
            <div>
                <span class="mh-section-eyebrow">
                    <i class="fas fa-folder-open"></i>
                    Health Information
                </span>
                <h2>Your Medical File</h2>
                <p>Dated entries, most recent first.</p>
            </div>

            <div class="mh-record-count">
                @totalRecords
                <span>Total records</span>
            </div>
        </div>

        <!-- Filter tabs + search -->
        <div class="mh-toolbar">

            <div class="mh-filters" role="tablist" aria-label="Filter medical history">
                <button type="button" class="mh-filter-btn active" data-filter="all">
                    <i class="fas fa-layer-group"></i> All <span class="mh-filter-count">@totalRecords</span>
                </button>
                <button type="button" class="mh-filter-btn mh-filter-condition" data-filter="condition">
                    <i class="fas fa-heart-pulse"></i> Conditions <span class="mh-filter-count">@conditionCount</span>
                </button>
                <button type="button" class="mh-filter-btn mh-filter-allergy" data-filter="allergy">
                    <i class="fas fa-allergies"></i> Allergies <span class="mh-filter-count">@allergyCount</span>
                </button>
                <button type="button" class="mh-filter-btn mh-filter-medication" data-filter="medication">
                    <i class="fas fa-pills"></i> Medication <span class="mh-filter-count">@medicationCount</span>
                </button>
            </div>

            <div class="mh-search">
                <i class="fas fa-magnifying-glass"></i>
                <input type="text" id="mhSearchInput" placeholder="Search records by name…" aria-label="Search medical records">
            </div>

        </div>

        @if (datedItems.Any())
        {
            <div class="mh-timeline" id="mhTimeline">

                @foreach (var item in datedItems)
                {
                    var typeIcon = item.Type == "allergy" ? "fa-allergies"
                                 : item.Type == "medication" ? "fa-pills"
                                 : "fa-heart-pulse";

                    var dateText = item.PrimaryDate.HasValue
                        ? item.PrimaryDate.Value.ToString("dd MMM yyyy")
                        : "Not recorded";

                    string resultsHref = string.IsNullOrWhiteSpace(item.Category)
                        ? Url.Action("Results", "Patient")
                        : Url.Action("Results", "Patient", new { category = item.Category });

                    var hasNotes = !string.IsNullOrWhiteSpace(item.Notes);

                    <article class="mh-timeline-item mh-item-@item.Type" data-type="@item.Type" data-name="@item.Name.ToLowerInvariant()">

                        <div class="mh-timeline-marker">
                            <i class="fas @typeIcon"></i>
                        </div>

                        <div class="mh-timeline-card">

                            <div class="mh-tc-top">
                                <div class="mh-tc-title">
                                    <h3>@item.Name</h3>
                                    <span class="mh-ref">@item.Ref</span>
                                    @if (!string.IsNullOrWhiteSpace(item.Category))
                                    {
                                        <span class="mh-chip">@item.Category</span>
                                    }
                                </div>

                                @if (!string.IsNullOrWhiteSpace(item.Severity))
                                {
                                    <span class="mh-badge @item.SeverityCss">@item.Severity</span>
                                }
                                else if (item.Type != "medication")
                                {
                                    <span class="mh-badge mh-sev-unknown">Unspecified</span>
                                }

                                @if (item.Type == "medication")
                                {
                                    if (item.IsActive == true)
                                    {
                                        <span class="mh-pill mh-pill-active"><i class="fas fa-circle-dot"></i> Active</span>
                                    }
                                    else
                                    {
                                        <span class="mh-pill mh-pill-past"><i class="fas fa-circle-check"></i> Completed</span>
                                    }
                                }
                            </div>

                            <div class="mh-tc-meta">

                                @if (item.Type == "medication")
                                {
                                    var endText = item.EndDate.HasValue
                                        ? item.EndDate.Value.ToString("dd MMM yyyy")
                                        : "Present";

                                    <span class="mh-meta-pill">
                                        <i class="fas fa-calendar-days"></i>
                                        @dateText <i class="fas fa-arrow-right mh-meta-arrow"></i> @endText
                                    </span>

                                    if (!string.IsNullOrWhiteSpace(item.Dosage))
                                    {
                                        <span class="mh-meta-pill"><i class="fas fa-prescription-bottle-medical"></i> @item.Dosage</span>
                                    }
                                    if (!string.IsNullOrWhiteSpace(item.Frequency))
                                    {
                                        <span class="mh-meta-pill"><i class="fas fa-clock"></i> @item.Frequency</span>
                                    }
                                }
                                else
                                {
                                    <span class="mh-meta-pill"><i class="fas fa-calendar-days"></i> @item.DateLabel @dateText</span>
                                }

                                <span class="mh-meta-pill @(string.IsNullOrWhiteSpace(item.Doctor) ? "mh-meta-muted" : "")">
                                    <i class="fas fa-user-doctor"></i>
                                    @(string.IsNullOrWhiteSpace(item.Doctor) ? "Doctor not specified" : item.Doctor)
                                </span>

                            </div>

                            @if (hasNotes)
                            {
                                <div class="mh-tc-notes">
                                    <button type="button" class="mh-notes-toggle">
                                        <i class="fas fa-note-sticky"></i>
                                        <span class="mh-notes-label">View notes</span>
                                        <i class="fas fa-chevron-down mh-notes-chevron"></i>
                                    </button>
                                    <div class="mh-notes-body">
                                        <p>@item.Notes</p>
                                    </div>
                                </div>
                            }
                            else
                            {
                                <div class="mh-tc-notes mh-tc-notes-empty">
                                    <i class="fas fa-note-sticky"></i> No notes recorded
                                </div>
                            }

                            <div class="mh-tc-footer">
                                <a href="@resultsHref" class="mh-trend-link">
                                    <i class="fas fa-chart-line"></i>
                                    View related test results
                                    <i class="fas fa-arrow-right"></i>
                                </a>
                            </div>

                        </div>

                    </article>
                }

            </div>
        }
        else
        {
            <div class="mh-empty mh-empty-global">
                <div class="mh-empty-icon mh-empty-teal">
                    <i class="fas fa-folder-open"></i>
                </div>
                <strong>No dated records yet</strong>
                <span>Conditions, allergies and medication with a confirmed date will appear here.</span>
            </div>
        }

        <div id="mhNoResults" class="mh-empty mh-empty-global mh-hidden">
            <div class="mh-empty-icon mh-empty-teal">
                <i class="fas fa-magnifying-glass"></i>
            </div>
            <strong>No matching records</strong>
            <span>Try a different search term or filter.</span>
        </div>

    </section>


    <!-- ==========================================
         UNDATED / UNVERIFIED RECORDS
    =========================================== -->
    @if (undatedItems.Any())
    {
        <section class="mh-section mh-undated-section" id="mhUndatedSection">

            <div class="mh-section-heading">
                <div>
                    <span class="mh-section-eyebrow mh-section-eyebrow-amber">
                        <i class="fas fa-clock-rotate-left"></i>
                        Awaiting Verification
                    </span>
                    <h2>Records Without a Confirmed Date</h2>
                    <p>Listed alphabetically — not placed on the timeline until a date is confirmed.</p>
                </div>

                <div class="mh-record-count">
                    @undatedCount
                    <span>Undated records</span>
                </div>
            </div>

            <div class="mh-undated-grid" id="mhUndatedGrid">
                @foreach (var item in undatedItems)
                {
                    var typeIcon = item.Type == "allergy" ? "fa-allergies"
                                 : item.Type == "medication" ? "fa-pills"
                                 : "fa-heart-pulse";
                    var hasNotes = !string.IsNullOrWhiteSpace(item.Notes);

                    <article class="mh-undated-card mh-item-@item.Type" data-type="@item.Type" data-name="@item.Name.ToLowerInvariant()">

                        <div class="mh-uc-top">
                            <div class="mh-uc-icon"><i class="fas @typeIcon"></i></div>
                            <div class="mh-uc-title">
                                <h3>@item.Name</h3>
                                <span class="mh-ref">@item.Ref</span>
                            </div>
                            <span class="mh-badge mh-sev-unknown">Date not on file</span>
                        </div>

                        <div class="mh-tc-meta">
                            @if (!string.IsNullOrWhiteSpace(item.Category))
                            {
                                <span class="mh-chip">@item.Category</span>
                            }
                            @if (!string.IsNullOrWhiteSpace(item.Severity))
                            {
                                <span class="mh-badge @item.SeverityCss">@item.Severity</span>
                            }
                            @if (item.Type == "medication")
                            {
                                if (item.IsActive == true)
                                {
                                    <span class="mh-pill mh-pill-active"><i class="fas fa-circle-dot"></i> Active</span>
                                }
                                else
                                {
                                    <span class="mh-pill mh-pill-past"><i class="fas fa-circle-check"></i> Completed</span>
                                }
                                if (!string.IsNullOrWhiteSpace(item.Dosage))
                                {
                                    <span class="mh-meta-pill"><i class="fas fa-prescription-bottle-medical"></i> @item.Dosage</span>
                                }
                                if (!string.IsNullOrWhiteSpace(item.Frequency))
                                {
                                    <span class="mh-meta-pill"><i class="fas fa-clock"></i> @item.Frequency</span>
                                }
                            }
                            <span class="mh-meta-pill @(string.IsNullOrWhiteSpace(item.Doctor) ? "mh-meta-muted" : "")">
                                <i class="fas fa-user-doctor"></i>
                                @(string.IsNullOrWhiteSpace(item.Doctor) ? "Doctor not specified" : item.Doctor)
                            </span>
                        </div>

                        @if (hasNotes)
                        {
                            <div class="mh-tc-notes">
                                <button type="button" class="mh-notes-toggle">
                                    <i class="fas fa-note-sticky"></i>
                                    <span class="mh-notes-label">View notes</span>
                                    <i class="fas fa-chevron-down mh-notes-chevron"></i>
                                </button>
                                <div class="mh-notes-body">
                                    <p>@item.Notes</p>
                                </div>
                            </div>
                        }

                    </article>
                }
            </div>

        </section>
    }


    <!-- ==========================================
         FOOTER NOTE
    =========================================== -->
    <div class="mh-info-footer">
        <div class="mh-info-footer-icon"><i class="fas fa-circle-info"></i></div>
        <div>
            <strong>Keep your medical information up to date</strong>
            <p>Your medical history helps healthcare professionals provide safer and more informed care. If any of the entries above are missing a date, ask your clinician to confirm it at your next visit.</p>
        </div>
    </div>

</div>

<style>

    /* =========================================================
       MEDICAL HISTORY — shared visual language with Consent.cshtml
       ========================================================= */

    :root {
        --mh-paper: #F0F7F6;
        --mh-white: #FFFFFF;
        --mh-ink: #102C27;
        --mh-ink-soft: #52716C;
        --mh-ink-faint: #8FA9A3;
        --mh-line: #E1EEEC;
        --mh-line-strong: #CCE3DF;
        --mh-teal: #0E8C7F;
        --mh-teal-deep: #0A5850;
        --mh-teal-dim: #E3F4F1;
        --mh-teal-start: #12A392;
        --mh-teal-end: #0A4F48;
        --mh-purple: #6D4EA8;
        --mh-purple-deep: #57368F;
        --mh-purple-dim: #EEE8F9;
        --mh-orange: #D66A32;
        --mh-orange-deep: #A94C20;
        --mh-orange-dim: #FFF0E8;
        --mh-amber: #B3860A;
        --mh-amber-dim: #FFF6DF;
        --mh-radius: 20px;
        --mh-radius-sm: 14px;
        --mh-shadow: 0 8px 28px rgba(10, 60, 55, .08);
        --mh-shadow-hover: 0 18px 40px rgba(10, 60, 55, .13);
    }

    .mh-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        color: var(--mh-ink);
        font-family: 'Inter', sans-serif;
    }

    /* ---------- HERO ---------- */

    .mh-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 30px 34px;
        margin-bottom: 22px;
        border-radius: var(--mh-radius);
        background: linear-gradient(125deg, var(--mh-teal-start), var(--mh-teal-end));
        box-shadow: 0 18px 45px rgba(10, 90, 80, .20);
        overflow: hidden;
    }

    .mh-hero-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient(circle at 80% 15%, rgba(255,255,255,.12), transparent 32%),
                    radial-gradient(circle at 95% 90%, rgba(255,255,255,.08), transparent 35%);
    }

    .mh-hero-left { position: relative; z-index: 1; display: flex; align-items: center; gap: 19px; }

    .mh-hero-icon {
        width: 64px; height: 64px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center;
        border-radius: 18px; color: #fff; font-size: 25px;
        background: rgba(255,255,255,.15);
        border: 2px solid rgba(255,255,255,.30);
        box-shadow: inset 0 0 20px rgba(255,255,255,.06);
    }

    .mh-eyebrow {
        display: flex; align-items: center; gap: 7px; margin-bottom: 4px;
        color: rgba(255,255,255,.72); font-size: 10.5px; font-weight: 700;
        letter-spacing: .08em; text-transform: uppercase;
    }

    .mh-hero h1 { margin: 0 0 5px; color: #fff; font-family: 'Poppins', sans-serif; font-size: 24px; font-weight: 700; }
    .mh-hero p { margin: 0; max-width: 560px; color: rgba(255,255,255,.84); font-size: 13px; line-height: 1.5; }

    .mh-hero-right { position: relative; z-index: 1; display: flex; align-items: center; gap: 22px; }

    .mh-health-status {
        display: flex; align-items: center; gap: 8px; padding: 8px 13px;
        border-radius: 999px; color: #fff; font-size: 11px; font-weight: 600;
        background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.18);
    }

    .mh-status-dot {
        width: 7px; height: 7px; border-radius: 50%; background: #79E1D2;
        box-shadow: 0 0 0 4px rgba(121,225,210,.14); animation: mhPulse 2s infinite;
    }

    .mh-hero-stat { display: flex; flex-direction: column; align-items: center; }
    .mh-hero-stat strong { color: #fff; font-family: 'Poppins', sans-serif; font-size: 27px; line-height: 1; }
    .mh-hero-stat span { margin-top: 4px; color: rgba(255,255,255,.65); font-size: 9px; letter-spacing: .07em; text-transform: uppercase; }
    .mh-hero-stat-divider { padding-left: 22px; border-left: 1px solid rgba(255,255,255,.22); }

    /* ---------- SUMMARY ---------- */

    .mh-summary { display: grid; grid-template-columns: repeat(3, 1fr); gap: 16px; margin-bottom: 18px; }

    .mh-summary-card {
        position: relative; display: flex; align-items: center; gap: 14px;
        min-height: 105px; padding: 17px 19px; background: var(--mh-white);
        border: 1px solid var(--mh-line); border-radius: var(--mh-radius);
        box-shadow: var(--mh-shadow); overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }
    .mh-summary-card:hover { transform: translateY(-3px); box-shadow: var(--mh-shadow-hover); }
    .mh-summary-card::after {
        content: ""; position: absolute; right: -30px; bottom: -40px;
        width: 100px; height: 100px; border-radius: 50%; opacity: .55;
    }
    .mh-summary-condition::after { background: var(--mh-teal-dim); }
    .mh-summary-allergy::after { background: var(--mh-purple-dim); }
    .mh-summary-medication::after { background: var(--mh-orange-dim); }

    .mh-summary-icon {
        position: relative; z-index: 1; width: 48px; height: 48px; flex-shrink: 0;
        display: flex; align-items: center; justify-content: center; border-radius: 14px; font-size: 18px;
    }
    .mh-summary-condition .mh-summary-icon { background: var(--mh-teal-dim); color: var(--mh-teal); }
    .mh-summary-allergy .mh-summary-icon { background: var(--mh-purple-dim); color: var(--mh-purple); }
    .mh-summary-medication .mh-summary-icon { background: var(--mh-orange-dim); color: var(--mh-orange); }

    .mh-summary-info { position: relative; z-index: 1; display: flex; flex-direction: column; }
    .mh-summary-info span { color: var(--mh-ink-soft); font-size: 12px; font-weight: 600; }
    .mh-summary-info strong { margin-top: 1px; font-family: 'Poppins', sans-serif; font-size: 25px; line-height: 1; }
    .mh-summary-info small { margin-top: 4px; color: var(--mh-ink-faint); font-size: 10.5px; }
    .mh-summary-arrow { position: relative; z-index: 1; margin-left: auto; color: var(--mh-ink-faint); font-size: 14px; }

    /* ---------- COMPLETENESS BANNER ---------- */

    .mh-completeness-banner {
        display: flex; align-items: center; gap: 14px;
        padding: 14px 18px; margin-bottom: 26px;
        background: var(--mh-amber-dim); border: 1px solid #F0DFA0;
        border-radius: var(--mh-radius-sm);
    }
    .mh-completeness-icon {
        width: 36px; height: 36px; flex-shrink: 0; display: flex;
        align-items: center; justify-content: center; border-radius: 10px;
        background: #FCEDBB; color: var(--mh-amber); font-size: 14px;
    }
    .mh-completeness-text { flex: 1; }
    .mh-completeness-text strong { display: block; font-size: 12px; color: #6B4F04; }
    .mh-completeness-text span { display: block; margin-top: 2px; font-size: 11px; color: #7A5E11; line-height: 1.5; }
    .mh-completeness-jump {
        flex-shrink: 0; display: inline-flex; align-items: center; gap: 6px;
        padding: 8px 13px; border-radius: 999px; background: var(--mh-amber);
        color: #fff; font-size: 11px; font-weight: 700; text-decoration: none;
        white-space: nowrap;
    }
    .mh-completeness-jump:hover { background: #96700A; }

    /* ---------- SECTION HEADER ---------- */

    .mh-section { margin-top: 8px; }

    .mh-section-heading {
        display: flex; align-items: flex-end; justify-content: space-between;
        gap: 20px; margin-bottom: 16px;
    }
    .mh-section-eyebrow {
        display: flex; align-items: center; gap: 7px; margin-bottom: 4px;
        color: var(--mh-teal); font-size: 10.5px; font-weight: 700;
        text-transform: uppercase; letter-spacing: .07em;
    }
    .mh-section-eyebrow-amber { color: var(--mh-amber); }
    .mh-section-heading h2 { margin: 0; font-family: 'Poppins', sans-serif; font-size: 19px; font-weight: 700; }
    .mh-section-heading p { margin: 3px 0 0; color: var(--mh-ink-soft); font-size: 12.5px; }

    .mh-record-count { display: flex; flex-direction: column; align-items: flex-end; color: var(--mh-ink-soft); font-size: 11px; }
    .mh-record-count span { margin-top: 2px; color: var(--mh-ink-faint); font-size: 9.5px; text-transform: uppercase; letter-spacing: .05em; }

    /* ---------- TOOLBAR: FILTERS + SEARCH ---------- */

    .mh-toolbar {
        display: flex; align-items: center; justify-content: space-between;
        flex-wrap: wrap; gap: 12px; margin-bottom: 22px;
    }

    .mh-filters { display: flex; flex-wrap: wrap; gap: 9px; }

    .mh-filter-btn {
        display: flex; align-items: center; gap: 7px;
        padding: 9px 15px; border-radius: 999px;
        border: 1px solid var(--mh-line-strong); background: var(--mh-white);
        color: var(--mh-ink-soft); font-family: 'Inter', sans-serif;
        font-size: 12px; font-weight: 600; cursor: pointer;
        transition: all .15s ease;
    }
    .mh-filter-btn:hover { border-color: var(--mh-teal); color: var(--mh-teal-deep); }
    .mh-filter-count {
        background: var(--mh-paper); color: var(--mh-ink-soft);
        border-radius: 999px; padding: 1px 7px; font-size: 10.5px;
    }
    .mh-filter-btn.active { background: var(--mh-teal); border-color: var(--mh-teal); color: #fff; }
    .mh-filter-btn.active .mh-filter-count { background: rgba(255,255,255,.25); color: #fff; }
    .mh-filter-btn.mh-filter-allergy.active { background: var(--mh-purple); border-color: var(--mh-purple); }
    .mh-filter-btn.mh-filter-medication.active { background: var(--mh-orange); border-color: var(--mh-orange); }

    .mh-search {
        display: flex; align-items: center; gap: 9px;
        min-width: 230px; padding: 9px 14px;
        background: var(--mh-white); border: 1px solid var(--mh-line-strong);
        border-radius: 999px;
    }
    .mh-search i { color: var(--mh-ink-faint); font-size: 12px; }
    .mh-search input {
        border: none; outline: none; background: none; width: 100%;
        font-family: 'Inter', sans-serif; font-size: 12.5px; color: var(--mh-ink);
    }
    .mh-search input::placeholder { color: var(--mh-ink-faint); }
    .mh-search:focus-within { border-color: var(--mh-teal); }

    /* ---------- TIMELINE ---------- */

    .mh-timeline { position: relative; padding-left: 46px; }
    .mh-timeline::before {
        content: ""; position: absolute; left: 19px; top: 6px; bottom: 6px;
        width: 2px; background: var(--mh-line-strong);
    }

    .mh-timeline-item { position: relative; margin-bottom: 18px; }
    .mh-timeline-item:last-child { margin-bottom: 0; }
    .mh-hidden { display: none !important; }

    .mh-timeline-marker {
        position: absolute; left: -46px; top: 14px;
        width: 39px; height: 39px; border-radius: 50%;
        display: flex; align-items: center; justify-content: center;
        font-size: 14px; background: var(--mh-teal-dim); color: var(--mh-teal);
        border: 3px solid var(--mh-paper); box-shadow: 0 0 0 2px var(--mh-line-strong);
        z-index: 1;
    }
    .mh-item-allergy .mh-timeline-marker { background: var(--mh-purple-dim); color: var(--mh-purple); }
    .mh-item-medication .mh-timeline-marker { background: var(--mh-orange-dim); color: var(--mh-orange); }

    .mh-timeline-card {
        background: var(--mh-white); border: 1px solid var(--mh-line);
        border-left: 4px solid var(--mh-teal);
        border-radius: var(--mh-radius-sm); box-shadow: var(--mh-shadow);
        padding: 16px 20px; transition: transform .2s ease, box-shadow .2s ease;
    }
    .mh-timeline-card:hover { transform: translateY(-2px); box-shadow: var(--mh-shadow-hover); }
    .mh-item-allergy .mh-timeline-card { border-left-color: var(--mh-purple); }
    .mh-item-medication .mh-timeline-card { border-left-color: var(--mh-orange); }

    .mh-tc-top { display: flex; align-items: center; flex-wrap: wrap; gap: 9px; margin-bottom: 10px; }
    .mh-tc-title { display: flex; align-items: center; gap: 9px; flex-wrap: wrap; margin-right: auto; }
    .mh-tc-title h3 { margin: 0; font-family: 'Poppins', sans-serif; font-size: 14.5px; font-weight: 700; }

    .mh-ref {
        font-family: 'Inter', sans-serif; font-size: 9.5px; font-weight: 700;
        letter-spacing: .04em; color: var(--mh-ink-faint);
        background: var(--mh-paper); border: 1px solid var(--mh-line-strong);
        border-radius: 6px; padding: 1px 6px;
    }

    .mh-chip {
        background: var(--mh-paper); color: var(--mh-ink-soft);
        border: 1px solid var(--mh-line-strong); border-radius: 999px;
        padding: 2px 9px; font-size: 10px; font-weight: 600;
    }

    .mh-badge {
        padding: 3px 10px; border-radius: 999px; font-size: 9.5px;
        font-weight: 700; text-transform: uppercase; letter-spacing: .04em;
        white-space: nowrap;
    }
    .mh-sev-severe   { background: #FCE7E7; color: #B3261E; }
    .mh-sev-moderate { background: #FFF1D6; color: #96650A; }
    .mh-sev-mild     { background: #E5F5E9; color: #1E7D42; }
    .mh-sev-unknown  { background: #EEF1F1; color: #5B6C69; }

    .mh-pill {
        display: inline-flex; align-items: center; gap: 5px;
        padding: 3px 10px; border-radius: 999px; font-size: 10px; font-weight: 700;
        white-space: nowrap;
    }
    .mh-pill i { font-size: 7px; }
    .mh-pill-active { background: var(--mh-teal-dim); color: var(--mh-teal-deep); }
    .mh-pill-past { background: #EEF1F1; color: #5B6C69; }

    .mh-tc-meta { display: flex; flex-wrap: wrap; gap: 8px; margin-bottom: 12px; }

    .mh-meta-pill {
        display: inline-flex; align-items: center; gap: 6px;
        background: var(--mh-paper); border: 1px solid var(--mh-line);
        border-radius: 10px; padding: 6px 10px;
        font-size: 11px; color: var(--mh-ink-soft); font-weight: 500;
    }
    .mh-meta-pill i { color: var(--mh-ink-faint); font-size: 10px; }
    .mh-meta-arrow { font-size: 8px; margin: 0 1px; }
    .mh-meta-muted { color: var(--mh-ink-faint); font-style: italic; }

    .mh-tc-notes {
        border-top: 1px dashed var(--mh-line); padding-top: 10px; margin-bottom: 10px;
    }
    .mh-tc-notes-empty {
        color: var(--mh-ink-faint); font-size: 11px; display: flex;
        align-items: center; gap: 7px;
    }

    .mh-notes-toggle {
        display: flex; align-items: center; gap: 7px; width: 100%;
        background: none; border: none; cursor: pointer; padding: 0;
        color: var(--mh-teal-deep); font-family: 'Inter', sans-serif;
        font-size: 11.5px; font-weight: 600;
    }
    .mh-notes-chevron { margin-left: auto; font-size: 10px; transition: transform .2s ease; }
    .mh-notes-body {
        max-height: 0; overflow: hidden; transition: max-height .25s ease;
    }
    .mh-notes-body p {
        margin: 9px 0 0; padding: 10px 12px; background: var(--mh-paper);
        border-radius: 10px; color: var(--mh-ink-soft); font-size: 12px; line-height: 1.55;
    }
    .mh-tc-notes.mh-open .mh-notes-body { max-height: 300px; }
    .mh-tc-notes.mh-open .mh-notes-chevron { transform: rotate(180deg); }

    .mh-tc-footer { display: flex; justify-content: flex-end; }
    .mh-trend-link {
        display: inline-flex; align-items: center; gap: 7px;
        color: var(--mh-teal-deep); background: var(--mh-teal-dim);
        border-radius: 999px; padding: 7px 13px; font-size: 11.5px; font-weight: 700;
        text-decoration: none; transition: background .15s ease;
    }
    .mh-trend-link:hover { background: var(--mh-teal); color: #fff; }
    .mh-item-allergy .mh-trend-link { color: var(--mh-purple-deep); background: var(--mh-purple-dim); }
    .mh-item-allergy .mh-trend-link:hover { background: var(--mh-purple); color: #fff; }
    .mh-item-medication .mh-trend-link { color: var(--mh-orange-deep); background: var(--mh-orange-dim); }
    .mh-item-medication .mh-trend-link:hover { background: var(--mh-orange); color: #fff; }

    /* ---------- UNDATED SECTION ---------- */

    .mh-undated-section { margin-top: 34px; }

    .mh-undated-grid {
        display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
        gap: 14px;
    }

    .mh-undated-card {
        background: var(--mh-white); border: 1px dashed var(--mh-line-strong);
        border-radius: var(--mh-radius-sm); box-shadow: var(--mh-shadow);
        padding: 15px 17px; transition: transform .2s ease, box-shadow .2s ease;
    }
    .mh-undated-card:hover { transform: translateY(-2px); box-shadow: var(--mh-shadow-hover); }

    .mh-uc-top { display: flex; align-items: flex-start; gap: 10px; margin-bottom: 10px; }
    .mh-uc-icon {
        width: 34px; height: 34px; flex-shrink: 0; display: flex;
        align-items: center; justify-content: center; border-radius: 10px;
        background: var(--mh-teal-dim); color: var(--mh-teal); font-size: 13px;
    }
    .mh-item-allergy .mh-uc-icon { background: var(--mh-purple-dim); color: var(--mh-purple); }
    .mh-item-medication .mh-uc-icon { background: var(--mh-orange-dim); color: var(--mh-orange); }

    .mh-uc-title { flex: 1; min-width: 0; }
    .mh-uc-title h3 { margin: 0; font-family: 'Poppins', sans-serif; font-size: 13.5px; font-weight: 700; }
    .mh-uc-title .mh-ref { display: inline-block; margin-top: 4px; }

    /* ---------- EMPTY STATE ---------- */

    .mh-empty {
        min-height: 190px; display: flex; flex-direction: column;
        align-items: center; justify-content: center; text-align: center; padding: 24px 12px;
    }
    .mh-empty-global {
        background: var(--mh-white); border: 1px solid var(--mh-line);
        border-radius: var(--mh-radius); box-shadow: var(--mh-shadow);
    }
    .mh-empty-icon {
        width: 50px; height: 50px; display: flex; align-items: center; justify-content: center;
        margin-bottom: 10px; border-radius: 50%; font-size: 18px;
    }
    .mh-empty-teal { background: var(--mh-teal-dim); color: var(--mh-teal); }
    .mh-empty strong { font-size: 12.5px; }
    .mh-empty span { max-width: 280px; margin-top: 5px; color: var(--mh-ink-soft); font-size: 10.5px; line-height: 1.55; }

    /* ---------- FOOTER ---------- */

    .mh-info-footer {
        display: flex; align-items: center; gap: 13px; margin-top: 26px;
        padding: 15px 18px; border: 1px solid var(--mh-line);
        border-radius: var(--mh-radius-sm); background: rgba(255,255,255,.72);
    }
    .mh-info-footer-icon {
        width: 35px; height: 35px; flex-shrink: 0; display: flex;
        align-items: center; justify-content: center; border-radius: 10px;
        background: var(--mh-teal-dim); color: var(--mh-teal); font-size: 14px;
    }
    .mh-info-footer strong { display: block; font-size: 11.5px; }
    .mh-info-footer p { margin: 2px 0 0; color: var(--mh-ink-soft); font-size: 10.5px; }

    @@keyframes mhPulse {
        0%, 100% { box-shadow: 0 0 0 4px rgba(121,225,210,.14), 0 0 6px rgba(121,225,210,.2); }
        50% { box-shadow: 0 0 0 5px rgba(121,225,210,.18), 0 0 12px rgba(121,225,210,.5); }
    }

    /* ---------- RESPONSIVE ---------- */

    @@media (max-width: 1050px) {
        .mh-timeline { padding-left: 40px; }
        .mh-timeline::before { left: 16px; }
        .mh-timeline-marker { left: -40px; width: 34px; height: 34px; font-size: 12px; }
    }

    @@media (max-width: 800px) {
        .mh-summary { grid-template-columns: 1fr; }
        .mh-hero { flex-direction: column; align-items: flex-start; }
        .mh-hero-right { width: 100%; justify-content: space-between; }
        .mh-toolbar { flex-direction: column; align-items: stretch; }
        .mh-search { min-width: 0; }
    }

    @@media (max-width: 600px) {
        .mh-page { padding: 20px 15px 45px; }
        .mh-hero { padding: 23px 20px; }
        .mh-hero-left { align-items: flex-start; }
        .mh-hero-icon { width: 52px; height: 52px; font-size: 20px; }
        .mh-hero h1 { font-size: 20px; }
        .mh-hero p { font-size: 11.5px; }
        .mh-section-heading { align-items: flex-start; flex-direction: column; }
        .mh-record-count { align-items: flex-start; }
        .mh-info-footer { align-items: flex-start; }
        .mh-timeline { padding-left: 34px; }
        .mh-timeline::before { left: 13px; }
        .mh-timeline-marker { left: -34px; width: 28px; height: 28px; font-size: 11px; }
        .mh-tc-footer { justify-content: flex-start; }
        .mh-completeness-banner { flex-wrap: wrap; }
    }

</style>

<script>
    (function () {
        // ---- Notes expand/collapse ----
        document.querySelectorAll('.mh-notes-toggle').forEach(function (btn) {
            btn.addEventListener('click', function () {
                var wrapper = btn.closest('.mh-tc-notes');
                var isOpen = wrapper.classList.toggle('mh-open');
                var label = btn.querySelector('.mh-notes-label');
                if (label) { label.textContent = isOpen ? 'Hide notes' : 'View notes'; }
            });
        });

        // ---- Combined filter + search across both the dated timeline
        //      and the undated grid ----
        var filterButtons = document.querySelectorAll('.mh-filter-btn');
        var timelineItems = document.querySelectorAll('#mhTimeline .mh-timeline-item');
        var undatedCards  = document.querySelectorAll('#mhUndatedGrid .mh-undated-card');
        var searchInput   = document.getElementById('mhSearchInput');
        var noResults     = document.getElementById('mhNoResults');

        var activeFilter = 'all';

        function applyFilters() {
            var term = (searchInput ? searchInput.value : '').trim().toLowerCase();
            var visibleCount = 0;

            timelineItems.forEach(function (item) {
                var matchesType = activeFilter === 'all' || item.getAttribute('data-type') === activeFilter;
                var matchesTerm = !term || (item.getAttribute('data-name') || '').indexOf(term) !== -1;
                var show = matchesType && matchesTerm;
                item.classList.toggle('mh-hidden', !show);
                if (show) { visibleCount++; }
            });

            undatedCards.forEach(function (card) {
                var matchesType = activeFilter === 'all' || card.getAttribute('data-type') === activeFilter;
                var matchesTerm = !term || (card.getAttribute('data-name') || '').indexOf(term) !== -1;
                var show = matchesType && matchesTerm;
                card.classList.toggle('mh-hidden', !show);
                if (show) { visibleCount++; }
            });

            if (noResults) {
                noResults.classList.toggle('mh-hidden', visibleCount !== 0);
            }
        }

        filterButtons.forEach(function (btn) {
            btn.addEventListener('click', function () {
                filterButtons.forEach(function (b) { b.classList.remove('active'); });
                btn.classList.add('active');
                activeFilter = btn.getAttribute('data-filter');
                applyFilters();
            });
        });

        if (searchInput) {
            searchInput.addEventListener('input', applyFilters);
        }
    })();
</script>
