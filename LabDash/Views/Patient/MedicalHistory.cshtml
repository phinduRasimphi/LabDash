@model LabDash.Models.MedicalHistoryViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Medical History";
    ViewData["ActivePage"] = "MedicalHistory";


var conditionCount = Model.Conditions?.Count ?? 0;
    var allergyCount = Model.Allergies?.Count ?? 0;
    var medicationCount = Model.Medication?.Count ?? 0;
    var totalRecords = conditionCount + allergyCount + medicationCount;


}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="mh-page">

    
    <!-- ==========================================
     HERO
=========================================== -->
    <section class="mh-hero">

        <div class="mh-hero-pattern"></div>

        <div class="mh-hero-left">

            <div class="mh-hero-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <div>
                <div class="mh-eyebrow">
                    <i class="fas fa-shield-heart"></i>
                    Personal Health Record
                </div>

                <h1>Medical History</h1>

                <p>
                    A clear overview of your recorded conditions,
                    allergies and current medication.
                </p>
            </div>

        </div>

        <div class="mh-hero-right">

            <div class="mh-health-status">
                <span class="mh-status-dot"></span>
                Health Record Active
            </div>

            <div class="mh-hero-total">
                <strong>@totalRecords</strong>
                <span>Records</span>
            </div>

        </div>

    </section>


    <!-- ==========================================
     SUMMARY
=========================================== -->
    <section class="mh-summary">

        <!-- Conditions -->
        <div class="mh-summary-card mh-summary-condition">

            <div class="mh-summary-icon">
                <i class="fas fa-heart-pulse"></i>
            </div>

            <div class="mh-summary-info">
                <span>Conditions</span>
                <strong>@conditionCount</strong>
                <small>Recorded conditions</small>
            </div>

            <div class="mh-summary-arrow">
                <i class="fas fa-notes-medical"></i>
            </div>

        </div>


        <!-- Allergies -->
        <div class="mh-summary-card mh-summary-allergy">

            <div class="mh-summary-icon">
                <i class="fas fa-allergies"></i>
            </div>

            <div class="mh-summary-info">
                <span>Allergies</span>
                <strong>@allergyCount</strong>
                <small>Known allergies</small>
            </div>

            <div class="mh-summary-arrow">
                <i class="fas fa-triangle-exclamation"></i>
            </div>

        </div>


        <!-- Medication -->
        <div class="mh-summary-card mh-summary-medication">

            <div class="mh-summary-icon">
                <i class="fas fa-pills"></i>
            </div>

            <div class="mh-summary-info">
                <span>Medication</span>
                <strong>@medicationCount</strong>
                <small>Recorded medications</small>
            </div>

            <div class="mh-summary-arrow">
                <i class="fas fa-prescription-bottle-medical"></i>
            </div>

        </div>

    </section>


    <!-- ==========================================
     MEDICAL INFORMATION
=========================================== -->
    <section class="mh-section">

        <div class="mh-section-heading">

            <div>
                <span class="mh-section-eyebrow">
                    <i class="fas fa-folder-open"></i>
                    Health Information
                </span>

                <h2>Your Medical Records</h2>

                <p>
                    Information recorded as part of your patient profile.
                </p>
            </div>

            <div class="mh-record-count">
                @totalRecords
                <span>Total records</span>
            </div>

        </div>


        <div class="mh-grid">


            <!-- ==========================================
             CONDITIONS
        =========================================== -->
            <article class="mh-card mh-card-condition">

                <div class="mh-card-top">

                    <div class="mh-card-title">

                        <div class="mh-card-icon">
                            <i class="fas fa-heart-pulse"></i>
                        </div>

                        <div>
                            <h3>Medical Conditions</h3>
                            <span>Diagnosed conditions</span>
                        </div>

                    </div>

                    <div class="mh-count mh-count-teal">
                        @conditionCount
                    </div>

                </div>


                <div class="mh-card-line"></div>


                <div class="mh-record-list">

                    @if (Model.Conditions != null && Model.Conditions.Any())
                    {
                        foreach (var condition in Model.Conditions)
                        {
                            <div class="mh-record">

                                <div class="mh-record-marker">
                                    <i class="fas fa-heartbeat"></i>
                                </div>

                                <div class="mh-record-content">
                                    <strong>@condition</strong>
                                    <span>Medical condition</span>
                                </div>

                                <div class="mh-record-check">
                                    <i class="fas fa-circle-check"></i>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="mh-empty">

                            <div class="mh-empty-icon mh-empty-teal">
                                <i class="fas fa-heart-circle-check"></i>
                            </div>

                            <strong>No conditions recorded</strong>

                            <span>
                                No medical conditions have been recorded
                                on your patient profile.
                            </span>

                        </div>
                    }

                </div>

            </article>


            <!-- ==========================================
             ALLERGIES
        =========================================== -->
            <article class="mh-card mh-card-allergy">

                <div class="mh-card-top">

                    <div class="mh-card-title">

                        <div class="mh-card-icon mh-icon-purple">
                            <i class="fas fa-allergies"></i>
                        </div>

                        <div>
                            <h3>Allergies</h3>
                            <span>Known allergic reactions</span>
                        </div>

                    </div>

                    <div class="mh-count mh-count-purple">
                        @allergyCount
                    </div>

                </div>


                <div class="mh-card-line mh-line-purple"></div>


                <div class="mh-alert-note">

                    <i class="fas fa-triangle-exclamation"></i>

                    <span>
                        Make sure healthcare staff are aware of
                        these allergies before treatment.
                    </span>

                </div>


                <div class="mh-record-list">

                    @if (Model.Allergies != null && Model.Allergies.Any())
                    {
                        foreach (var allergy in Model.Allergies)
                        {
                            <div class="mh-record mh-record-alert">

                                <div class="mh-record-marker mh-marker-purple">
                                    <i class="fas fa-exclamation"></i>
                                </div>

                                <div class="mh-record-content">
                                    <strong>@allergy</strong>
                                    <span>Known allergy</span>
                                </div>

                                <div class="mh-record-check mh-purple-check">
                                    <i class="fas fa-shield-exclamation"></i>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="mh-empty">

                            <div class="mh-empty-icon mh-empty-purple">
                                <i class="fas fa-shield-check"></i>
                            </div>

                            <strong>No allergies recorded</strong>

                            <span>
                                No known allergies have been recorded
                                on your patient profile.
                            </span>

                        </div>
                    }

                </div>

            </article>


            <!-- ==========================================
             MEDICATION
        =========================================== -->
            <article class="mh-card mh-card-medication">

                <div class="mh-card-top">

                    <div class="mh-card-title">

                        <div class="mh-card-icon mh-icon-orange">
                            <i class="fas fa-pills"></i>
                        </div>

                        <div>
                            <h3>Medication</h3>
                            <span>Recorded medication</span>
                        </div>

                    </div>

                    <div class="mh-count mh-count-orange">
                        @medicationCount
                    </div>

                </div>


                <div class="mh-card-line mh-line-orange"></div>


                <div class="mh-record-list">

                    @if (Model.Medication != null && Model.Medication.Any())
                    {
                        foreach (var medication in Model.Medication)
                        {
                            <div class="mh-record">

                                <div class="mh-record-marker mh-marker-orange">
                                    <i class="fas fa-pills"></i>
                                </div>

                                <div class="mh-record-content">
                                    <strong>@medication</strong>
                                    <span>Recorded medication</span>
                                </div>

                                <div class="mh-record-check mh-orange-check">
                                    <i class="fas fa-prescription-bottle-medical"></i>
                                </div>

                            </div>
                        }
                    }
                    else
                    {
                        <div class="mh-empty">

                            <div class="mh-empty-icon mh-empty-orange">
                                <i class="fas fa-pills"></i>
                            </div>

                            <strong>No medication recorded</strong>

                            <span>
                                No medication has been recorded
                                on your patient profile.
                            </span>

                        </div>
                    }

                </div>

            </article>

        </div>

    </section>


    <!-- ==========================================
     FOOTER NOTE
=========================================== -->
    <div class="mh-info-footer">

        <div class="mh-info-footer-icon">
            <i class="fas fa-circle-info"></i>
        </div>

        <div>
            <strong>Keep your medical information up to date</strong>
            <p>
                Your medical history helps healthcare professionals
                provide safer and more informed care.
            </p>
        </div>

    </div>
    ```

</div>

<style>

    /* =========================================================
           MEDICAL HISTORY
           Shared visual language with the Allergies administration
           page: teal healthcare foundation + purple allergy accent.
           ========================================================= */

    :root {
        --mh-paper: #F0F7F6;
        --mh-white: #FFFFFF;
        --mh-ink: #102C27;
        --mh-ink-soft: #52716C;
        --mh-ink-faint: #8FA9A3;
        --mh-line: #E1EEEC;
        --mh-line-strong: #CCE3DF;
        --mh-teal: #0E8C7F;
        --mh-teal-deep: #0A5850;
        --mh-teal-dim: #E3F4F1;
        --mh-teal-start: #12A392;
        --mh-teal-end: #0A4F48;
        --mh-purple: #6D4EA8;
        --mh-purple-deep: #57368F;
        --mh-purple-dim: #EEE8F9;
        --mh-orange: #D66A32;
        --mh-orange-deep: #A94C20;
        --mh-orange-dim: #FFF0E8;
        --mh-radius: 20px;
        --mh-radius-sm: 14px;
        --mh-shadow: 0 8px 28px rgba(10, 60, 55, .08);
        --mh-shadow-hover: 0 18px 40px rgba(10, 60, 55, .13);
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .mh-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 28px 24px 60px;
        color: var(--mh-ink);
        font-family: 'Inter', sans-serif;
    }


    /* =========================================================
           HERO
           ========================================================= */

    .mh-hero {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 30px;
        padding: 30px 34px;
        margin-bottom: 22px;
        border-radius: var(--mh-radius);
        background: linear-gradient( 125deg, var(--mh-teal-start), var(--mh-teal-end) );
        box-shadow: 0 18px 45px rgba(10, 90, 80, .20);
        overflow: hidden;
    }


    .mh-hero-pattern {
        position: absolute;
        inset: 0;
        pointer-events: none;
        background: radial-gradient( circle at 80% 15%, rgba(255,255,255,.12), transparent 32% ), radial-gradient( circle at 95% 90%, rgba(255,255,255,.08), transparent 35% );
    }


    .mh-hero-left {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 19px;
    }


    .mh-hero-icon {
        width: 64px;
        height: 64px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 18px;
        color: #fff;
        font-size: 25px;
        background: rgba(255,255,255,.15);
        border: 2px solid rgba(255,255,255,.30);
        box-shadow: inset 0 0 20px rgba(255,255,255,.06);
    }


    .mh-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        color: rgba(255,255,255,.72);
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .08em;
        text-transform: uppercase;
    }


    .mh-hero h1 {
        margin: 0 0 5px;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-size: 24px;
        font-weight: 700;
    }


    .mh-hero p {
        margin: 0;
        max-width: 560px;
        color: rgba(255,255,255,.84);
        font-size: 13px;
        line-height: 1.5;
    }


    .mh-hero-right {
        position: relative;
        z-index: 1;
        display: flex;
        align-items: center;
        gap: 28px;
    }


    .mh-health-status {
        display: flex;
        align-items: center;
        gap: 8px;
        padding: 8px 13px;
        border-radius: 999px;
        color: #fff;
        font-size: 11px;
        font-weight: 600;
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.18);
    }


    .mh-status-dot {
        width: 7px;
        height: 7px;
        border-radius: 50%;
        background: #79E1D2;
        box-shadow: 0 0 0 4px rgba(121,225,210,.14);
        animation: mhPulse 2s infinite;
    }


    .mh-hero-total {
        display: flex;
        flex-direction: column;
        align-items: center;
    }


        .mh-hero-total strong {
            color: #fff;
            font-family: 'Poppins', sans-serif;
            font-size: 27px;
            line-height: 1;
        }


        .mh-hero-total span {
            margin-top: 4px;
            color: rgba(255,255,255,.65);
            font-size: 9px;
            letter-spacing: .07em;
            text-transform: uppercase;
        }


    /* =========================================================
           SUMMARY CARDS
           ========================================================= */

    .mh-summary {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 16px;
        margin-bottom: 30px;
    }


    .mh-summary-card {
        position: relative;
        display: flex;
        align-items: center;
        gap: 14px;
        min-height: 105px;
        padding: 17px 19px;
        background: var(--mh-white);
        border: 1px solid var(--mh-line);
        border-radius: var(--mh-radius);
        box-shadow: var(--mh-shadow);
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .mh-summary-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--mh-shadow-hover);
        }


        .mh-summary-card::after {
            content: "";
            position: absolute;
            right: -30px;
            bottom: -40px;
            width: 100px;
            height: 100px;
            border-radius: 50%;
            opacity: .55;
        }


    .mh-summary-condition::after {
        background: var(--mh-teal-dim);
    }


    .mh-summary-allergy::after {
        background: var(--mh-purple-dim);
    }


    .mh-summary-medication::after {
        background: var(--mh-orange-dim);
    }


    .mh-summary-icon {
        position: relative;
        z-index: 1;
        width: 48px;
        height: 48px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        font-size: 18px;
    }


    .mh-summary-condition .mh-summary-icon {
        background: var(--mh-teal-dim);
        color: var(--mh-teal);
    }


    .mh-summary-allergy .mh-summary-icon {
        background: var(--mh-purple-dim);
        color: var(--mh-purple);
    }


    .mh-summary-medication .mh-summary-icon {
        background: var(--mh-orange-dim);
        color: var(--mh-orange);
    }


    .mh-summary-info {
        position: relative;
        z-index: 1;
        display: flex;
        flex-direction: column;
    }


        .mh-summary-info span {
            color: var(--mh-ink-soft);
            font-size: 12px;
            font-weight: 600;
        }


        .mh-summary-info strong {
            margin-top: 1px;
            font-family: 'Poppins', sans-serif;
            font-size: 25px;
            line-height: 1;
        }


        .mh-summary-info small {
            margin-top: 4px;
            color: var(--mh-ink-faint);
            font-size: 10.5px;
        }


    .mh-summary-arrow {
        position: relative;
        z-index: 1;
        margin-left: auto;
        color: var(--mh-ink-faint);
        font-size: 14px;
    }


    /* =========================================================
           SECTION
           ========================================================= */

    .mh-section {
        margin-top: 8px;
    }


    .mh-section-heading {
        display: flex;
        align-items: flex-end;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 16px;
    }


    .mh-section-eyebrow {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        color: var(--mh-teal);
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .07em;
    }


    .mh-section-heading h2 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 19px;
        font-weight: 700;
    }


    .mh-section-heading p {
        margin: 3px 0 0;
        color: var(--mh-ink-soft);
        font-size: 12.5px;
    }


    .mh-record-count {
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        color: var(--mh-ink-soft);
        font-size: 11px;
    }


        .mh-record-count:first-line {
            color: var(--mh-ink);
        }


        .mh-record-count span {
            margin-top: 2px;
            color: var(--mh-ink-faint);
            font-size: 9.5px;
            text-transform: uppercase;
            letter-spacing: .05em;
        }


    /* =========================================================
           MEDICAL CARDS
           ========================================================= */

    .mh-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 18px;
        align-items: start;
    }


    .mh-card {
        position: relative;
        background: var(--mh-white);
        border: 1px solid var(--mh-line);
        border-radius: var(--mh-radius);
        box-shadow: var(--mh-shadow);
        overflow: hidden;
        transition: transform .2s ease, box-shadow .2s ease;
    }


        .mh-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--mh-shadow-hover);
        }


    .mh-card-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        padding: 20px 20px 17px;
    }


    .mh-card-title {
        display: flex;
        align-items: center;
        gap: 12px;
    }


    .mh-card-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        border-radius: 13px;
        background: var(--mh-teal-dim);
        color: var(--mh-teal);
        font-size: 17px;
    }


    .mh-icon-purple {
        background: var(--mh-purple-dim);
        color: var(--mh-purple);
    }


    .mh-icon-orange {
        background: var(--mh-orange-dim);
        color: var(--mh-orange);
    }


    .mh-card-title h3 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }


    .mh-card-title span {
        display: block;
        margin-top: 2px;
        color: var(--mh-ink-faint);
        font-size: 10.5px;
    }


    .mh-count {
        min-width: 31px;
        height: 31px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        font-family: 'Poppins', sans-serif;
        font-size: 12px;
        font-weight: 700;
    }


    .mh-count-teal {
        background: var(--mh-teal-dim);
        color: var(--mh-teal-deep);
    }


    .mh-count-purple {
        background: var(--mh-purple-dim);
        color: var(--mh-purple-deep);
    }


    .mh-count-orange {
        background: var(--mh-orange-dim);
        color: var(--mh-orange-deep);
    }


    .mh-card-line {
        height: 2px;
        margin: 0 20px;
        background: linear-gradient( 90deg, var(--mh-teal), transparent );
        opacity: .5;
    }


    .mh-line-purple {
        background: linear-gradient( 90deg, var(--mh-purple), transparent );
    }


    .mh-line-orange {
        background: linear-gradient( 90deg, var(--mh-orange), transparent );
    }


    /* =========================================================
           ALLERGY WARNING
           ========================================================= */

    .mh-alert-note {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        margin: 15px 20px 4px;
        padding: 10px 12px;
        border-radius: 11px;
        background: var(--mh-purple-dim);
        color: var(--mh-purple-deep);
        font-size: 10.5px;
        line-height: 1.45;
    }


        .mh-alert-note i {
            margin-top: 1px;
        }


    /* =========================================================
           RECORD LIST
           ========================================================= */

    .mh-record-list {
        padding: 10px 20px 18px;
    }


    .mh-record {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 12px 0;
        border-bottom: 1px solid var(--mh-line);
        transition: padding .15s ease;
    }


        .mh-record:last-child {
            border-bottom: none;
        }


        .mh-record:hover {
            padding-left: 4px;
            padding-right: 4px;
        }


    .mh-record-marker {
        width: 31px;
        height: 31px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 9px;
        background: var(--mh-teal-dim);
        color: var(--mh-teal);
        font-size: 12px;
    }


    .mh-marker-purple {
        background: var(--mh-purple-dim);
        color: var(--mh-purple);
    }


    .mh-marker-orange {
        background: var(--mh-orange-dim);
        color: var(--mh-orange);
    }


    .mh-record-content {
        min-width: 0;
        display: flex;
        flex-direction: column;
        flex: 1;
    }


        .mh-record-content strong {
            overflow: hidden;
            color: var(--mh-ink);
            font-size: 12.5px;
            font-weight: 600;
            text-overflow: ellipsis;
            white-space: nowrap;
        }


        .mh-record-content span {
            margin-top: 2px;
            color: var(--mh-ink-faint);
            font-size: 9.5px;
        }


    .mh-record-check {
        color: var(--mh-teal);
        font-size: 12px;
    }


    .mh-purple-check {
        color: var(--mh-purple);
    }


    .mh-orange-check {
        color: var(--mh-orange);
    }


    /* =========================================================
           EMPTY STATE
           ========================================================= */

    .mh-empty {
        min-height: 190px;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        text-align: center;
        padding: 24px 12px;
    }


    .mh-empty-icon {
        width: 50px;
        height: 50px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 10px;
        border-radius: 50%;
        font-size: 18px;
    }


