@model dynamic

@{
    ViewData["Title"] = "Patient Folders";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
}

<style>
    .folders-page {
        padding: 8px 10px 40px;
        max-width: 1000px;
        margin: 0 auto;
        font-family: 'Inter', system-ui, sans-serif;
    }

    .folders-heading {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        padding: 20px 24px;
        margin-bottom: 22px;
        border-radius: 17px;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        box-shadow: 0 8px 22px rgba(13,107,99,.14);
        color: #fff;
    }

        .folders-heading h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 800;
        }

        .folders-heading p {
            margin: 4px 0 0;
            font-size: 12px;
            opacity: 0.85;
        }

    .folder-search {
        position: relative;
        margin-bottom: 16px;
    }

        .folder-search input {
            width: 100%;
            height: 46px;
            padding: 0 16px 0 44px;
            border: 1px solid #dfeae7;
            border-radius: 12px;
            background: #fff;
            font-size: 13px;
            color: #173c38;
            outline: none;
            transition: all .15s ease;
        }

            .folder-search input:focus {
                border-color: #0d6b63;
                box-shadow: 0 0 0 4px rgba(13,107,99,.10);
            }

        .folder-search i {
            position: absolute;
            left: 17px;
            top: 50%;
            transform: translateY(-50%);
            color: #7d8e8a;
            pointer-events: none;
        }

    .folder-list {
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    /* ACCORDION CARD */
    .folder-card {
        background: #fff;
        border: 1px solid #dfeae7;
        border-radius: 16px;
        box-shadow: 0 4px 16px rgba(31,78,72,.04);
        overflow: hidden;
    }

    .folder-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 20px 24px;
        cursor: pointer;
        transition: background 0.15s ease;
        user-select: none;
    }

        .folder-header:hover {
            background: #f7fbfa;
        }

    .folder-avatar {
        width: 48px;
        height: 48px;
        min-width: 48px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: #fff;
        font-size: 15px;
        font-weight: 800;
    }

    .folder-info {
        flex: 1;
        min-width: 0;
    }

    .folder-name {
        color: #173c38;
        font-size: 17px;
        font-weight: 800;
        margin-bottom: 4px;
    }

    .folder-meta {
        color: #7d8e8a;
        font-size: 12px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

        .folder-meta i {
            font-size: 11px;
            margin-right: 4px;
        }

    .folder-chevron {
        color: #b0beb9;
        font-size: 14px;
        transition: transform 0.3s ease;
    }

    /* EXPANDED CONTENT */
    .folder-content {
        display: none;
        border-top: 1px solid #edf2f0;
        padding: 20px 24px;
        background: #fbfdfc;
    }

    .folder-card.expanded .folder-content {
        display: block;
    }

    .folder-card.expanded .folder-chevron {
        transform: rotate(90deg);
        color: #0d6b63;
    }

    /* REQUEST CARDS */
    .req-card {
        background: #fff;
        border: 1px solid #e0ebe8;
        border-radius: 12px;
        margin-bottom: 16px;
    }

        .req-card:last-child {
            margin-bottom: 0;
        }

    .req-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 14px 18px;
        background: #f7fbfa;
        border-bottom: 1px solid #e8efed;
        border-radius: 12px 12px 0 0;
    }

    .req-id {
        font-weight: 800;
        color: #294b45;
        font-size: 14px;
    }

    .req-date {
        font-size: 11px;
        color: #7d8e8a;
        margin-left: 10px;
    }

    .req-body {
        padding: 18px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .req-body {
            grid-template-columns: 1fr;
        }
    }

    /* VERTICAL TIMELINE */
    .timeline-title {
        font-size: 11px;
        font-weight: 800;
        color: #0d6b63;
        text-transform: uppercase;
        margin-bottom: 12px;
        letter-spacing: 0.5px;
    }

    .status-timeline {
        display: flex;
        flex-direction: column;
        gap: 0;
    }

    .timeline-item {
        display: flex;
        align-items: flex-start;
        gap: 10px;
        padding: 6px 0;
        position: relative;
        opacity: 0.4;
    }

        .timeline-item.done {
            opacity: 1;
        }

        .timeline-item + .timeline-item::before {
            content: "";
            position: absolute;
            left: 7px;
            top: -4px;
            width: 2px;
            height: 12px;
            background: #dfeae7;
        }

        .timeline-item.done + .timeline-item::before {
            background: #0d6b63;
        }

    .timeline-dot {
        width: 16px;
        height: 16px;
        min-width: 16px;
        border-radius: 50%;
        background: #dfeae7;
        border: 2px solid #fff;
        box-shadow: 0 0 0 1px #dfeae7;
        margin-top: 2px;
        flex-shrink: 0;
        position: relative;
        z-index: 1;
    }

    .timeline-item.done .timeline-dot {
        background: #0d6b63;
        box-shadow: 0 0 0 1px #0d6b63;
    }

    .timeline-label {
        color: #294b45;
        font-size: 12px;
        font-weight: 700;
    }

    .timeline-time {
        color: #8a9a97;
        font-size: 10px;
        margin-top: 2px;
        display: block;
    }

    .req-actions {
        grid-column: 1 / -1;
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 15px;
        border-top: 1px dashed #edf2f0;
        margin-top: 10px;
    }

    .btn {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 9px 16px;
        border-radius: 8px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
        border: 1px solid transparent;
        cursor: pointer;
        transition: all 0.15s ease;
    }

    .btn-primary {
        background: #0d6b63;
        color: #fff;
    }

        .btn-primary:hover {
            background: #09564f;
        }

        .btn-primary[disabled] {
            background: #dfe6ed;
            color: #9aa9a5;
            cursor: not-allowed;
            pointer-events: none;
        }

    .empty-state {
        padding: 60px 20px;
        text-align: center;
        background: #fff;
        border: 1px solid #e1ebe8;
        border-radius: 16px;
    }

    .empty-icon {
        font-size: 40px;
        color: #cde8e4;
        margin-bottom: 15px;
    }
</style>

<div class="folders-page">

    <div class="folders-heading">
        <div>
            <h1>Patient Folders</h1>
            <p>Click a patient to expand their test requests and timelines</p>
        </div>
        <div style="background: rgba(255,255,255,0.15); padding: 8px 16px; border-radius: 20px; font-weight: 800; font-size: 13px;">
            <i class="fas fa-folder"></i> @(((IEnumerable<dynamic>)Model).Count()) Folders
        </div>
    </div>

    <div class="folder-search">
        <i class="fas fa-search"></i>
        <input type="text" id="folderSearch" placeholder="Search patient name or ID number..." autocomplete="off" />
    </div>

    @if (Model == null || !((IEnumerable<dynamic>)Model).Any())
    {
        <div class="empty-state">
            <div class="empty-icon"><i class="fas fa-folder-open"></i></div>
            <h3>No Patient Folders</h3>
            <p>There are currently no patient records with laboratory test requests.</p>
        </div>
    }
    else
    {
        <div class="folder-list" id="folderList">
            @foreach (var folder in Model)
            {
                var patient = folder.Patient;
                var requests = folder.Requests;
                var patientName = $"{patient.Name} {patient.Surname}";
                var initials = ((!string.IsNullOrWhiteSpace((string)patient.Name) ? ((string)patient.Name).Substring(0, 1) : "P") + (!string.IsNullOrWhiteSpace((string)patient.Surname) ? ((string)patient.Surname).Substring(0, 1) : "")).ToUpper();

                <div class="folder-card" data-search="@($"{patientName} {patient.IDNumber}").ToLower()">

                    <!-- CLICK THIS HEADER TO EXPAND -->
                    <div class="folder-header" onclick="toggleFolder(this)">
                        <div class="folder-avatar">@initials</div>
                        <div class="folder-info">
                            <div class="folder-name">@patientName</div>
                            <div class="folder-meta">
                                <span><i class="fas fa-id-card"></i>@patient.IDNumber</span>
                                <span><i class="fas fa-file-medical"></i>@requests.Count request(s)</span>
                            </div>
                        </div>
                        <i class="fas fa-chevron-right folder-chevron"></i>
                    </div>

                    <!-- EXPANDED CONTENT -->
                    <div class="folder-content">
                        @foreach (var request in requests)
                        {
                            var status = request.Status?.ToString() ?? "Unknown";

                            DateTime? earliestStart = null;
                            DateTime? latestCompletion = null;
                            DateTime? earliestVerification = null;

                            if (request.TestRequestItems != null)
                            {
                                foreach (var it in request.TestRequestItems)
                                {
                                    if (it.StartDateTime != null) { var sd = (DateTime)it.StartDateTime; if (earliestStart == null || sd < earliestStart) earliestStart = sd; }
                                    if (it.CompletionDateTime != null) { var cd = (DateTime)it.CompletionDateTime; if (latestCompletion == null || cd > latestCompletion) latestCompletion = cd; }
                                    if (it.TestResults != null) { foreach (var r in it.TestResults) { if (r.VerificationDate != null) { var vd = (DateTime)r.VerificationDate; if (earliestVerification == null || vd < earliestVerification) earliestVerification = vd; } } }
                                }
                            }

                            var allItemsVerified = request.TestRequestItems != null && request.TestRequestItems.Count > 0 && ((IEnumerable<dynamic>)request.TestRequestItems).All((Func<dynamic, bool>)(i => (string)i.Status == "Verified"));
                            bool canViewResults = allItemsVerified && (status == "Completed" || status == "AppointmentScheduled" || status == "Released by doctor");

                            <div class="req-card">
                                <div class="req-header">
                                    <div>
                                        <span class="req-id">Request #@request.RequestId</span>
                                        <span class="req-date">@Convert.ToDateTime(request.RequestDate).ToString("dd MMM yyyy")</span>
                                    </div>
                                    <div style="font-size: 11px; font-weight: 800; color: #0d6b63; text-transform: uppercase;">@status</div>
                                </div>

                                <div class="req-body">

                                    <!-- VERTICAL TIMELINE -->
                                    <div>
                                        <div class="timeline-title"><i class="fas fa-clock-rotate-left"></i> Status Timeline</div>
                                        <div class="status-timeline">
                                            <div class="timeline-item @(request.SubmittedDate != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">Submitted</div>
                                                    <span class="timeline-time">@(request.SubmittedDate != null ? Convert.ToDateTime(request.SubmittedDate).ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(request.DateTimeReceived != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">Received</div>
                                                    <span class="timeline-time">@(request.DateTimeReceived != null ? Convert.ToDateTime(request.DateTimeReceived).ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(earliestStart != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">In Progress</div>
                                                    <span class="timeline-time">@(earliestStart != null ? earliestStart.Value.ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(latestCompletion != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">Completed</div>
                                                    <span class="timeline-time">@(latestCompletion != null ? latestCompletion.Value.ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(earliestVerification != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">Verified</div>
                                                    <span class="timeline-time">@(earliestVerification != null ? earliestVerification.Value.ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                            <div class="timeline-item @(request.ReleaseDate != null ? "done" : "")">
                                                <span class="timeline-dot"></span>
                                                <div>
                                                    <div class="timeline-label">Released</div>
                                                    <span class="timeline-time">@(request.ReleaseDate != null ? Convert.ToDateTime(request.ReleaseDate).ToString("dd MMM HH:mm") : "Pending")</span>
                                                </div>
                                            </div>
                                        </div>
                                    </div>

                                    <!-- TESTS & ACTION -->
                                    <div>
                                        <div class="timeline-title"><i class="fas fa-vial"></i> Tests in this Request</div>
                                        <div style="display:flex; flex-direction:column; gap:8px;">
                                            @if (request.TestRequestItems != null)
                                            {
                                                foreach (var item in request.TestRequestItems)
                                                {
                                                    <div style="display:flex; justify-content:space-between; padding:8px 12px; background:#f8fbfa; border-radius:8px; border:1px solid #edf2f0;">
                                                        <span style="font-weight:700; color:#294943; font-size:12px;">@item.TestType?.Name</span>
                                                        <span style="font-size:10px; font-weight:800; color:#0d6b63;">@item.Status</span>
                                                    </div>
                                                }
                                            }
                                        </div>

                                        <div class="req-actions">
                                            @if (canViewResults)
                                            {
                                                <a href="@Url.Action("PatientResults", "TestRequest", new { requestId = request.RequestId })" class="btn btn-primary">
                                                    <i class="fas fa-file-medical"></i> View Results
                                                </a>
                                            }
                                            else
                                            {
                                                <button class="btn btn-primary" disabled>
                                                    <i class="fas fa-lock"></i> Locked until Verified
                                                </button>
                                            }
                                        </div>
                                    </div>

                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
        </div>
    }
</div>

@section Scripts {
    <script>
        function toggleFolder(header) {
            var card = header.parentElement;
            card.classList.toggle('expanded');
        }

        document.getElementById('folderSearch').addEventListener('input', function() {
            var term = this.value.toLowerCase();
            var cards = document.querySelectorAll('.folder-card');
            cards.forEach(function(card) {
                var searchData = card.getAttribute('data-search') || '';
                if (searchData.includes(term)) {
                    card.style.display = 'block';
                } else {
                    card.style.display = 'none';
                }
            });
        });
    </script>
}