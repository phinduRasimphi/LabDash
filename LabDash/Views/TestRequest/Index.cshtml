@model IEnumerable<LabDash.Models.TestRequest>

@{
    ViewData["Title"] = "Index";
}

<h1>Index</h1>

<p>
    <a asp-action="Create">Create New</a>
</p>
<table class="table">
    <thead>
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.PatientId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Patient)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequestingDoctorId)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequestingDoctor)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.RequestDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Urgency)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ClinicalNotes)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Status)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DateTimeReceived)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SubmittedDate)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CancellationReason)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.Samples)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SampleReceives)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.TestRequestItems)
            </th>
            <th></th>
        </tr>
    </thead>
    <tbody>
@foreach (var item in Model) {
        <tr>
            <td>
                @Html.DisplayFor(model => item.PatientId)
            </td>
            <td>
                @Html.DisplayFor(model => item.Patient)
            </td>
            <td>
                @Html.DisplayFor(model => item.RequestingDoctorId)
            </td>
            <td>
                @Html.DisplayFor(model => item.RequestingDoctor)
            </td>
            <td>
                @Html.DisplayFor(model => item.RequestDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.Urgency)
            </td>
            <td>
                @Html.DisplayFor(model => item.ClinicalNotes)
            </td>
            <td>
                @Html.DisplayFor(model => item.Status)
            </td>
            <td>
                @Html.DisplayFor(model => item.DateTimeReceived)
            </td>
            <td>
                @Html.DisplayFor(model => item.SubmittedDate)
            </td>
            <td>
                @Html.DisplayFor(model => item.CancellationReason)
            </td>
            <td>
                @Html.DisplayFor(model => item.Samples)
            </td>
            <td>
                @Html.DisplayFor(model => item.SampleReceives)
            </td>
            <td>
                @Html.DisplayFor(model => item.TestRequestItems)
            </td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.RequestId">Edit</a> |
                <a asp-action="Details" asp-route-id="@item.RequestId">Details</a> |
                <a asp-action="Delete" asp-route-id="@item.RequestId">Delete</a>
            </td>
        </tr>
}
    </tbody>
</table>
