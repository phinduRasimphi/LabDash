
@model dynamic

@{
    ViewData["Title"] = "Test Request Folders";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>

    /* =========================================================
           PAGE
        ========================================================= */

    .folders-page {
        padding: 5px 5px 30px 5px;
    }


    /* =========================================================
           DECORATED PAGE HEADING
        ========================================================= */

    .page-heading {
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
        box-shadow: 0 4px 12px rgba(13, 107, 99, 0.12);
        position: relative;
        overflow: hidden;
    }

        .page-heading::before {
            content: "";
            position: absolute;
            width: 180px;
            height: 180px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.04);
            right: 70px;
            top: -100px;
        }

        .page-heading::after {
            content: "";
            position: absolute;
            width: 140px;
            height: 140px;
            border-radius: 50%;
            background: rgba(255, 255, 255, 0.06);
            right: -45px;
            top: -60px;
        }

    .heading-left {
        display: flex;
        align-items: center;
        gap: 13px;
        position: relative;
        z-index: 2;
    }

    .heading-icon {
        width: 46px;
        height: 46px;
        min-width: 46px;
        border-radius: 12px;
        background: rgba(255, 255, 255, 0.16);
        border: 1px solid rgba(255, 255, 255, 0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        font-size: 19px;
        box-shadow: inset 0 1px 2px rgba(255, 255, 255, 0.08);
    }

    .heading-text h1 {
        margin: 0;
        color: white;
        font-size: 21px;
        font-weight: 700;
        letter-spacing: -0.2px;
    }

    .heading-text p {
        margin: 4px 0 0;
        color: rgba(255, 255, 255, 0.82);
        font-size: 11px;
    }

    .heading-badge {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        gap: 7px;
        background: rgba(255, 255, 255, 0.13);
        border: 1px solid rgba(255, 255, 255, 0.18);
        color: white;
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 10px;
        font-weight: 600;
        white-space: nowrap;
    }

        .heading-badge i {
            font-size: 11px;
        }


    /* =========================================================
           ERROR MESSAGE
        ========================================================= */

    .pr-error {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ffcdd2;
        padding: 12px 15px;
        border-radius: 9px;
        margin-bottom: 18px;
        font-size: 12px;
        font-weight: 600;
    }

        .pr-error i {
            font-size: 15px;
        }


    /* =========================================================
           FOLDER GRID
        ========================================================= */

    .folder-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 18px;
    }


    /* =========================================================
           FOLDER CARD
        ========================================================= */

    .folder-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #e6edf2;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        transition: all 0.2s ease;
    }

        .folder-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 16px rgba(0, 0, 0, 0.07);
        }


    /* =========================================================
           FOLDER HEADER
        ========================================================= */

    .folder-header {
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        padding: 17px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .folder-avatar {
        width: 43px;
        height: 43px;
        min-width: 43px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.18);
        border: 1px solid rgba(255, 255, 255, 0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .folder-name {
        font-size: 14px;
        font-weight: 700;
        line-height: 1.3;
    }

    .folder-sub {
        font-size: 10px;
        opacity: 0.88;
        margin-top: 3px;
    }

    .folder-icon {
        margin-left: auto;
        font-size: 19px;
        opacity: 0.9;
    }


    /* =========================================================
           FOLDER BODY
        ========================================================= */

    .folder-body {
        padding: 16px;
    }


    /* =========================================================
           PATIENT INFORMATION
        ========================================================= */

    .folder-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-bottom: 14px;
    }

    .info-box {
        background: #f7fafb;
        border-radius: 8px;
        padding: 10px;
    }

    .info-label {
        font-size: 9px;
        color: #8998aa;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .info-value {
        font-size: 12px;
        color: #1a2f4e;
        font-weight: 700;
    }


    /* =========================================================
           UNLOCK AREA
        ========================================================= */

    .folder-lock {
        background: #f8fafd;
        border: 1px solid #edf1f4;
        border-radius: 9px;
        padding: 13px;
        text-align: center;
    }

    .lock-icon {
        width: 35px;
        height: 35px;
        margin: 0 auto 7px;
        border-radius: 50%;
        background: #e8f5f3;
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .lock-title {
        margin: 0 0 3px;
        color: #1a2f4e;
        font-size: 12px;
        font-weight: 700;
    }

    .lock-subtitle {
        margin: 0 0 10px;
        color: #7a8da8;
        font-size: 10px;
    }

    .folder-lock input {
        width: 100%;
        box-sizing: border-box;
        padding: 9px 10px;
        border: 1px solid #dfe6ec;
        border-radius: 7px;
        background: white;
        color: #1a2f4e;
        font-size: 12px;
        outline: none;
        margin-bottom: 8px;
        text-align: center;
    }

        .folder-lock input::placeholder {
            color: #a2adba;
        }

        .folder-lock input:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 2px rgba(26, 140, 130, 0.08);
        }

    .unlock-button {
        width: 100%;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        border: none;
        border-radius: 7px;
        padding: 9px 14px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: all 0.2s ease;
    }

        .unlock-button:hover {
            background: linear-gradient(135deg, #1a8c82, #0d6b63);
            transform: translateY(-1px);
        }

        .unlock-button:active {
            transform: translateY(0);
        }


    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        background: white;
        border: 1px solid #e6edf2;
        border-radius: 14px;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
    }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #e8f5f3;
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .empty-state h3 {
        margin: 0;
        color: #1a2f4e;
        font-size: 15px;
    }

    .empty-state p {
        margin: 6px 0 0;
        color: #7a8da8;
        font-size: 12px;
    }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 700px) {

        .folders-page {
            padding: 5px 0 25px;
        }

        .page-heading {
            padding: 15px;
        }

        .heading-text h1 {
            font-size: 18px;
        }

        .heading-text p {
            font-size: 10px;
        }

        .heading-badge {
            display: none;
        }

        .heading-icon {
            width: 40px;
            height: 40px;
            min-width: 40px;
            font-size: 17px;
        }

        .folder-grid {
            grid-template-columns: 1fr;
        }
    }

</style>


<div class="folders-page">


    <!-- =====================================================
         PAGE HEADING
    ====================================================== -->

    <div class="page-heading">

        <div class="heading-left">

            <div class="heading-icon">
                <i class="fas fa-folder-open"></i>
            </div>

            <div class="heading-text">

                <h1>
                    Test Request Folders
                </h1>

                <p>
                    Access and manage stored patient test requests
                </p>

            </div>

        </div>


        <div class="heading-badge">

            <i class="fas fa-flask"></i>

            Laboratory Requests

        </div>

    </div>


    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="pr-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- =====================================================
         PATIENT FOLDERS
    ====================================================== -->

    <div class="folder-grid">

        @if (Model == null || !((IEnumerable<dynamic>)Model).Any())
        {
            <div class="empty-state">

                <div class="empty-icon">

                    <i class="fas fa-folder-open"></i>

                </div>

                <h3>
                    No Test Request Folders
                </h3>

                <p>
                    There are currently no stored test requests.
                </p>

            </div>
        }
        else
        {
            foreach (var folder in Model)
            {
                var patient = folder.Patient;
                var requests = folder.Requests;

                var initials =
                    patient.Name.Substring(0, 1) +
                    patient.Surname.Substring(0, 1);


                <!-- =================================================
                     PATIENT FOLDER
                ================================================== -->

                <div class="folder-card">


                    <!-- =================================================
                         FOLDER HEADER
                    ================================================== -->

                    <div class="folder-header">

                        <div class="folder-avatar">
                            @initials
                        </div>


                        <div>

                            <div class="folder-name">
                                @patient.Name @patient.Surname
                            </div>

                            <div class="folder-sub">
                                SA ID: @patient.IDNumber
                            </div>

                        </div>


                        <div class="folder-icon">

                            <i class="fas fa-folder"></i>

                        </div>

                    </div>


                    <!-- =================================================
                         FOLDER BODY
                    ================================================== -->

                    <div class="folder-body">


                        <!-- =================================================
                             PATIENT INFORMATION
                        ================================================== -->

                        <div class="folder-info">


                            <div class="info-box">

                                <div class="info-label">
                                    Patient
                                </div>

                                <div class="info-value">
                                    @patient.Name
                                </div>

                            </div>


                            <div class="info-box">

                                <div class="info-label">
                                    Test Requests
                                </div>

                                <div class="info-value">
                                    @requests.Count
                                </div>

                            </div>


                        </div>


                        <!-- =================================================
                             UNLOCK
                        ================================================== -->

                        <div class="folder-lock">


                            <div class="lock-icon">

                                <i class="fas fa-lock"></i>

                            </div>


                            <p class="lock-title">
                                Protected Patient Folder
                            </p>


                            <p class="lock-subtitle">
                                Enter the patient's SA ID number to unlock
                            </p>


                            <form asp-action="UnlockFolder"
                                  asp-controller="TestRequest"
                                  method="post">

                                @Html.AntiForgeryToken()


                                <input type="hidden"
                                       name="patientId"
                                       value="@patient.PatientID" />


                                <input type="text"
                                       name="idNumber"
                                       placeholder="Enter 13-digit SA ID number"
                                       maxlength="13"
                                       minlength="13"
                                       pattern="[0-9]{13}"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       required />


                                <button type="submit"
                                        class="unlock-button">

                                    <i class="fas fa-unlock-alt"></i>

                                    &nbsp; Unlock & View Requests

                                </button>


                            </form>


                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>
