
@model dynamic

@{
    ViewData["Title"] = "Test Request Folders";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>

    /* =========================================================
           PAGE
        ========================================================= */

    .folders-page {
        padding: 5px 5px 30px 5px;
    }

    .page-heading {
        margin-bottom: 20px;
    }

        .page-heading h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
            color: #1a2f4e;
        }

        .page-heading p {
            margin: 5px 0 0;
            font-size: 12px;
            color: #7a8da8;
        }


    /* =========================================================
           ERROR
        ========================================================= */

    .pr-error {
        display: flex;
        align-items: center;
        gap: 10px;
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ffcdd2;
        padding: 12px 15px;
        border-radius: 9px;
        margin-bottom: 18px;
        font-size: 12px;
        font-weight: 600;
    }

        .pr-error i {
            font-size: 15px;
        }


    /* =========================================================
           FOLDER GRID
        ========================================================= */

    .folder-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 18px;
    }


    /* =========================================================
           PATIENT FOLDER CARD
        ========================================================= */

    .folder-card {
        background: #ffffff;
        border-radius: 14px;
        border: 1px solid #e6edf2;
        box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        overflow: hidden;
        transition: all 0.2s ease;
    }

        .folder-card:hover {
            transform: translateY(-2px);
            box-shadow: 0 5px 15px rgba(0, 0, 0, 0.07);
        }


    /* =========================================================
           FOLDER HEADER
        ========================================================= */

    .folder-header {
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        padding: 17px 18px;
        display: flex;
        align-items: center;
        gap: 12px;
    }

    .folder-avatar {
        width: 43px;
        height: 43px;
        min-width: 43px;
        border-radius: 50%;
        background: rgba(255,255,255,0.18);
        border: 1px solid rgba(255,255,255,0.25);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .folder-name {
        font-size: 14px;
        font-weight: 700;
        line-height: 1.3;
    }

    .folder-sub {
        font-size: 10px;
        opacity: 0.88;
        margin-top: 3px;
    }


    /* =========================================================
           FOLDER ICON
        ========================================================= */

    .folder-icon {
        margin-left: auto;
        font-size: 19px;
        opacity: 0.9;
    }


    /* =========================================================
           FOLDER BODY
        ========================================================= */

    .folder-body {
        padding: 16px;
    }

    .folder-info {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 9px;
        margin-bottom: 14px;
    }

    .info-box {
        background: #f7fafb;
        border-radius: 8px;
        padding: 9px;
    }

    .info-label {
        font-size: 9px;
        color: #8998aa;
        text-transform: uppercase;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .info-value {
        font-size: 12px;
        color: #1a2f4e;
        font-weight: 700;
    }


    /* =========================================================
           UNLOCK AREA
        ========================================================= */

    .folder-lock {
        background: #f8fafd;
        border: 1px solid #edf1f4;
        border-radius: 9px;
        padding: 12px;
        text-align: center;
    }

    .lock-icon {
        width: 34px;
        height: 34px;
        margin: 0 auto 7px;
        border-radius: 50%;
        background: #e8f5f3;
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    .lock-title {
        margin: 0 0 3px;
        color: #1a2f4e;
        font-size: 12px;
        font-weight: 700;
    }

    .lock-subtitle {
        margin: 0 0 10px;
        color: #7a8da8;
        font-size: 10px;
    }

    .folder-lock input {
        width: 100%;
        box-sizing: border-box;
        padding: 9px 10px;
        border: 1px solid #dfe6ec;
        border-radius: 7px;
        background: white;
        color: #1a2f4e;
        font-size: 12px;
        outline: none;
        margin-bottom: 8px;
        text-align: center;
    }

        .folder-lock input:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 2px rgba(26, 140, 130, 0.08);
        }

    .unlock-button {
        width: 100%;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        border: none;
        border-radius: 7px;
        padding: 9px 14px;
        font-size: 11px;
        font-weight: 700;
        cursor: pointer;
        transition: 0.2s ease;
    }

        .unlock-button:hover {
            background: linear-gradient(135deg, #1a8c82, #0d6b63);
        }


    /* =========================================================
           EMPTY STATE
        ========================================================= */

    .empty-state {
        grid-column: 1 / -1;
        text-align: center;
        padding: 60px 20px;
        background: white;
        border: 1px solid #e6edf2;
        border-radius: 14px;
    }

    .empty-icon {
        width: 55px;
        height: 55px;
        margin: 0 auto 12px;
        border-radius: 50%;
        background: #e8f5f3;
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .empty-state h3 {
        margin: 0;
        color: #1a2f4e;
        font-size: 15px;
    }

    .empty-state p {
        margin: 6px 0 0;
        color: #7a8da8;
        font-size: 12px;
    }


    /* =========================================================
           RESPONSIVE
        ========================================================= */

    @@media (max-width: 650px) {

        .folder-grid {
            grid-template-columns: 1fr;
        }

        .page-heading h1 {
            font-size: 19px;
        }
    }

</style>


<div class="folders-page">

    <!-- =====================================================
         PAGE HEADING
    ====================================================== -->

    <div class="page-heading">

        <h1>
            Test Request Folders
        </h1>

        <p>
            Select a patient folder and enter the patient's SA ID number
            to view their stored test requests.
        </p>

    </div>


    <!-- =====================================================
         ERROR MESSAGE
    ====================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="pr-error">

            <i class="fas fa-circle-exclamation"></i>

            <span>
                @TempData["Error"]
            </span>

        </div>
    }


    <!-- =====================================================
         PATIENT FOLDERS
    ====================================================== -->

    <div class="folder-grid">

        @if (Model == null || !((IEnumerable<dynamic>)Model).Any())
        {
            <div class="empty-state">

                <div class="empty-icon">
                    <i class="fas fa-folder-open"></i>
                </div>

                <h3>
                    No Test Request Folders
                </h3>

                <p>
                    There are currently no stored test requests.
                </p>

            </div>
        }
        else
        {
            foreach (var folder in Model)
            {
                var patient = folder.Patient;
                var requests = folder.Requests;

                var initials =
                    patient.Name.Substring(0, 1) +
                    patient.Surname.Substring(0, 1);

                <div class="folder-card">

                    <!-- =================================================
                         PATIENT HEADER
                    ================================================== -->

                    <div class="folder-header">

                        <div class="folder-avatar">
                            @initials
                        </div>

                        <div>

                            <div class="folder-name">
                                @patient.Name @patient.Surname
                            </div>

                            <div class="folder-sub">
                                SA ID: @patient.IDNumber
                            </div>

                        </div>

                        <div class="folder-icon">
                            <i class="fas fa-folder"></i>
                        </div>

                    </div>


                    <!-- =================================================
                         FOLDER BODY
                    ================================================== -->

                    <div class="folder-body">


                        <!-- PATIENT INFORMATION -->

                        <div class="folder-info">

                            <div class="info-box">

                                <div class="info-label">
                                    Patient
                                </div>

                                <div class="info-value">
                                    @patient.Name
                                </div>

                            </div>

                            <div class="info-box">

                                <div class="info-label">
                                    Requests
                                </div>

                                <div class="info-value">
                                    @requests.Count
                                </div>

                            </div>

                        </div>


                        <!-- =================================================
                             UNLOCK FORM
                        ================================================== -->

                        <div class="folder-lock">

                            <div class="lock-icon">
                                <i class="fas fa-lock"></i>
                            </div>

                            <p class="lock-title">
                                Protected Patient Folder
                            </p>

                            <p class="lock-subtitle">
                                Enter the patient's SA ID number to unlock
                            </p>


                            <form asp-action="UnlockFolder"
                                  asp-controller="TestRequest"
                                  method="post">

                                @Html.AntiForgeryToken()

                                <input type="hidden"
                                       name="patientId"
                                       value="@patient.PatientID" />

                                <input type="text"
                                       name="idNumber"
                                       placeholder="Enter 13-digit SA ID number"
                                       maxlength="13"
                                       minlength="13"
                                       pattern="[0-9]{13}"
                                       inputmode="numeric"
                                       autocomplete="off"
                                       required />

                                <button type="submit"
                                        class="unlock-button">

                                    <i class="fas fa-unlock-alt"></i>
                                    &nbsp; Unlock & View Requests

                                </button>

                            </form>

                        </div>

                    </div>

                </div>
            }
        }

    </div>

</div>
