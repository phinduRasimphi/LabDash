@{
    ViewData["Title"] = "Results Access";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";
    var requestId = ViewBag.RequestId as int? ?? 0;
}

<style>
    .results-lock-page {
        max-width: 520px;
        margin: 60px auto;
        padding: 0 22px;
        font-family: 'Inter', system-ui, sans-serif;
        animation: lockFadeUp 0.4s ease-out;
    }

    @@keyframes lockFadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .lock-card {
        background: #fff;
        border: 1px solid #e3e8ee;
        border-radius: 18px;
        box-shadow: 0 12px 40px rgba(15,35,55,0.10);
        padding: 40px 42px;
        text-align: center;
        position: relative;
        overflow: hidden;
    }

        .lock-card::before {
            content: "";
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 5px;
            background: linear-gradient(90deg, #0d6b63, #1a8c82, #2ab3a6);
        }

    .lock-icon {
        width: 72px;
        height: 72px;
        margin: 0 auto 22px;
        border-radius: 20px;
        background: linear-gradient(135deg, #e6f5f1, #d1ede8);
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 30px;
        box-shadow: 0 8px 20px rgba(13,107,99,0.14);
    }

    .lock-card h1 {
        margin: 0 0 10px;
        color: #18324f;
        font-size: 22px;
        font-weight: 800;
    }

    .lock-card p.sub {
        margin: 0 0 26px;
        color: #7d8e8a;
        font-size: 13px;
        line-height: 1.65;
    }

    .lock-form {
        display: flex;
        flex-direction: column;
        gap: 14px;
        text-align: left;
    }

    .lock-label {
        display: block;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #34554f;
        margin-bottom: 8px;
    }

    .lock-input-wrap {
        position: relative;
    }

        .lock-input-wrap i {
            position: absolute;
            left: 16px;
            top: 50%;
            transform: translateY(-50%);
            color: #99a8b5;
            font-size: 14px;
        }

    .lock-input {
        width: 100%;
        height: 50px;
        padding: 0 16px 0 46px;
        border: 2px solid #dfe6ed;
        border-radius: 12px;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: #18324f;
        box-sizing: border-box;
        transition: all 0.15s ease;
    }

        .lock-input:focus {
            outline: none;
            border-color: #0d6b63;
            box-shadow: 0 0 0 4px rgba(13,107,99,0.10);
        }

    .lock-btn {
        width: 100%;
        height: 50px;
        border: none;
        border-radius: 12px;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: #fff;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 700;
        cursor: pointer;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        margin-top: 6px;
        box-shadow: 0 6px 18px rgba(13,107,99,0.24);
        transition: all 0.15s ease;
    }

        .lock-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 10px 26px rgba(13,107,99,0.32);
        }

    .lock-back {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        margin-top: 20px;
        color: #7d8e8a;
        font-size: 12.5px;
        text-decoration: none;
        font-weight: 600;
    }

        .lock-back:hover {
            color: #0d6b63;
        }

    .lock-error {
        background: #fff6f6;
        border: 1px solid #f5c9c6;
        border-left: 4px solid #d92d20;
        border-radius: 10px;
        padding: 12px 16px;
        color: #b42318;
        font-size: 12.5px;
        margin-bottom: 16px;
        text-align: left;
    }
</style>

<div class="results-lock-page">
    <div class="lock-card">

        <div class="lock-icon">
            <i class="fas fa-lock"></i>
        </div>

        <h1>Protected Results</h1>
        <p class="sub">
            Patient results are confidential.<br />
            Enter your access password to view request <strong>#@requestId</strong>.
        </p>

        @if (!ViewData.ModelState.IsValid)
        {
            <div class="lock-error">
                @foreach (var err in ViewData.ModelState.Values.SelectMany(v => v.Errors))
                {
                    <div><i class="fas fa-exclamation-circle"></i> @err.ErrorMessage</div>
                }
            </div>
        }

        <form asp-action="ResultsAccess" method="post" class="lock-form">
            @Html.AntiForgeryToken()
            <input type="hidden" name="requestId" value="@requestId" />

            <div>
                <label class="lock-label" for="password">Access Password</label>
                <div class="lock-input-wrap">
                    <i class="fas fa-key"></i>
                    <input type="password"
                           id="password"
                           name="password"
                           class="lock-input"
                           placeholder="Enter password"
                           autocomplete="off"
                           autofocus />
                </div>
            </div>

            <button type="submit" class="lock-btn">
                <i class="fas fa-unlock"></i> Unlock Results
            </button>
        </form>

        <a asp-action="Track" class="lock-back">
            <i class="fas fa-arrow-left"></i> Back to Track
        </a>
    </div>
</div>