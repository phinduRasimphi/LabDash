@model LabDash.Models.TestRequest

@{
    ViewData["Title"] = "Test Results";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var patient = Model.Patient;
    var doctor = Model.RequestingDoctor;
    var items = Model.TestRequestItems?.OrderBy(i => i.TestType?.Name).ToList()
                ?? new List<LabDash.Models.TestRequestItem>();

    bool allVerified = items.Any() && items.All(i => i.Status == "Verified");
    bool isReleased = Model.Status == "Released by doctor";

    int abnormalCount = items.Count(i =>
        i.TestResults != null && i.TestResults.Any(r => r.IsAbnormal));
    int totalTests = items.Count;
    int normalCount = totalTests - abnormalCount;
    int pendingCount = items.Count(i =>
        i.TestResults == null || !i.TestResults.Any());
}

<style>
    @@keyframes fadeUp {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@keyframes pulse {
        0%, 100% {
            transform: scale(1);
            opacity: 1;
        }

        50% {
            transform: scale(1.05);
            opacity: 0.85;
        }
    }

    .results-page {
        max-width: 1100px;
        margin: 24px auto;
        padding: 0 22px 60px;
        font-family: 'Inter', system-ui, sans-serif;
        color: #1f2d3d;
    }

    /* ============ HERO ============ */
    .results-hero {
        background: linear-gradient(135deg, #0d6b63 0%, #1a8c82 55%, #2ab3a6 100%);
        color: #fff;
        border-radius: 20px;
        padding: 32px 38px;
        margin-bottom: 26px;
        box-shadow: 0 12px 36px rgba(13,107,99,0.24);
        position: relative;
        overflow: hidden;
        animation: fadeUp 0.5s ease-out;
    }

        .results-hero::before {
            content: "";
            position: absolute;
            width: 320px;
            height: 320px;
            right: -120px;
            top: -150px;
            background: radial-gradient(circle, rgba(255,255,255,0.08) 0%, transparent 70%);
            border-radius: 50%;
        }

    .results-hero-inner {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 20px;
    }

    .hero-icon-box {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,0.15);
        border: 1px solid rgba(255,255,255,0.22);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
        margin-bottom: 14px;
        backdrop-filter: blur(6px);
    }

    .results-hero h1 {
        margin: 0;
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -0.3px;
    }

    .results-hero p {
        margin: 8px 0 0;
        font-size: 13.5px;
        opacity: 0.92;
        line-height: 1.6;
    }

    .meta-row {
        display: flex;
        gap: 18px;
        flex-wrap: wrap;
        margin-top: 12px;
        font-size: 12.5px;
        opacity: 0.9;
    }

        .meta-row span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .hero-status {
        display: flex;
        gap: 10px;
        align-items: center;
        flex-wrap: wrap;
    }

    .hero-badge {
        padding: 10px 20px;
        border-radius: 24px;
        font-size: 11.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.7px;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: rgba(255,255,255,0.16);
        border: 1px solid rgba(255,255,255,0.24);
        backdrop-filter: blur(6px);
    }

        .hero-badge.released {
            background: linear-gradient(135deg,#22a06b,#16a34a);
            border-color: #1c8558;
            box-shadow: 0 6px 18px rgba(34,160,107,0.4);
        }

        .hero-badge.abnormal {
            background: linear-gradient(135deg,#d92d20,#b42318);
            border-color: #b42318;
        }

            .hero-badge.abnormal i {
                animation: pulse 1.6s ease-in-out infinite;
            }

    /* ============ SUMMARY CARDS ============ */
    .summary-strip {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(160px, 1fr));
        gap: 14px;
        margin-bottom: 24px;
    }

    .summary-tile {
        background: #fff;
        border: 2px solid #e3e8ee;
        border-radius: 14px;
        padding: 20px 22px;
        display: flex;
        align-items: center;
        gap: 14px;
        box-shadow: 0 3px 12px rgba(15,35,55,0.04);
        animation: fadeUp 0.65s ease-out;
        cursor: pointer;
        transition: all 0.2s ease;
        user-select: none;
        position: relative;
        overflow: hidden;
    }

        .summary-tile::before {
            content: "";
            position: absolute;
            inset: 0;
            background: linear-gradient(135deg, rgba(13,107,99,0.03), transparent);
            opacity: 0;
            transition: opacity 0.2s ease;
        }

        .summary-tile:hover {
            transform: translateY(-3px);
            box-shadow: 0 10px 26px rgba(15,35,55,0.10);
            border-color: #cce5e1;
        }

            .summary-tile:hover::before {
                opacity: 1;
            }

        .summary-tile.active {
            border-color: #0d6b63;
            background: linear-gradient(135deg,#f8fcfb,#f3faf9);
            box-shadow: 0 8px 22px rgba(13,107,99,0.16);
        }

            .summary-tile.active::after {
                content: "✓";
                position: absolute;
                top: 10px;
                right: 12px;
                font-size: 11px;
                font-weight: 800;
                color: #0d6b63;
            }

    .summary-icon {
        width: 48px;
        height: 48px;
        border-radius: 12px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        flex-shrink: 0;
        transition: transform 0.2s ease;
    }

    .summary-tile:hover .summary-icon {
        transform: scale(1.08);
    }

    .summary-icon.teal {
        background: #e6f5f1;
        color: #0d6b63;
    }

    .summary-icon.green {
        background: #e7f8ee;
        color: #16a34a;
    }

    .summary-icon.red {
        background: #fde8e8;
        color: #d92d20;
    }

    .summary-icon.amber {
        background: #fef3c7;
        color: #d97706;
    }

    .summary-num {
        font-size: 24px;
        font-weight: 800;
        color: #18324f;
        line-height: 1;
    }

    .summary-lbl {
        font-size: 10.5px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        color: #7d8e8a;
        margin-top: 6px;
    }

    /* ============ CARDS ============ */
    .results-card {
        background: #fff;
        border: 1px solid #e3e8ee;
        border-radius: 16px;
        box-shadow: 0 4px 20px rgba(15,35,55,0.05);
        padding: 26px 30px;
        margin-bottom: 22px;
        animation: fadeUp 0.6s ease-out;
    }

    .card-title {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 15px;
        font-weight: 800;
        color: #0d6b63;
        margin: 0 0 22px;
        padding-bottom: 14px;
        border-bottom: 2px solid #eaf6f4;
        letter-spacing: 0.3px;
    }

    .card-title-icon {
        width: 32px;
        height: 32px;
        border-radius: 9px;
        background: linear-gradient(135deg,#e6f5f1,#d1ede8);
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 14px;
    }

    /* ============ INFO COLUMNS ============ */
    .info-columns {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 24px;
    }

    @@media (max-width: 768px) {
        .info-columns {
            grid-template-columns: 1fr;
        }
    }

    .info-block-title {
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: 0.8px;
        color: #0d6b63;
        margin-bottom: 12px;
        padding-bottom: 8px;
        border-bottom: 1px solid #eaf6f4;
    }

    .info-line {
        display: grid;
        grid-template-columns: 140px 1fr;
        gap: 10px;
        padding: 9px 0;
        border-bottom: 1px solid #f4f7f8;
        font-size: 13px;
    }

        .info-line:last-child {
            border-bottom: none;
        }

        .info-line .lbl {
            color: #7d8e8a;
            font-weight: 600;
            font-size: 12px;
        }

        .info-line .val {
            color: #18324f;
            font-weight: 600;
            word-break: break-word;
        }

    /* ============ BANNERS ============ */
    .warn-banner {
        background: linear-gradient(135deg, #fff6f6 0%, #fde8e8 100%);
        border: 1px solid #f5c9c6;
        border-left: 5px solid #d92d20;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        font-size: 13px;
        color: #b42318;
        animation: fadeUp 0.7s ease-out;
    }

        .warn-banner .banner-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #fecaca;
            color: #b42318;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            animation: pulse 1.8s ease-in-out infinite;
        }

    .released-note {
        background: linear-gradient(135deg, #ecfdf5 0%, #d1fae5 100%);
        border: 1px solid #a7f3d0;
        border-left: 5px solid #22a06b;
        border-radius: 14px;
        padding: 18px 22px;
        margin-bottom: 22px;
        font-size: 13px;
        color: #145c57;
        display: flex;
        gap: 16px;
        align-items: flex-start;
        animation: fadeUp 0.7s ease-out;
    }

        .released-note .banner-icon {
            width: 44px;
            height: 44px;
            flex-shrink: 0;
            border-radius: 12px;
            background: #a7f3d0;
            color: #145c57;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
        }

        .released-note small {
            display: block;
            margin-top: 6px;
            color: #52736f;
            font-size: 11.5px;
        }

    /* ============ RESULTS TABLE ============ */
    .results-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 13px;
    }

        .results-table thead th {
            background: linear-gradient(180deg,#f3faf9,#e8f5f3);
            color: #0d6b63;
            font-size: 10.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 0.7px;
            text-align: left;
            padding: 15px 16px;
            border-bottom: 2px solid #cce5e1;
        }

            .results-table thead th:first-child {
                border-top-left-radius: 12px;
            }

            .results-table thead th:last-child {
                border-top-right-radius: 12px;
            }

        .results-table tbody td {
            padding: 16px;
            border-bottom: 1px solid #f0f2f5;
            color: #26384d;
            vertical-align: middle;
        }

        .results-table tbody tr {
            transition: background 0.12s ease;
        }

            .results-table tbody tr:hover td {
                background: #f8fbfa;
            }

            .results-table tbody tr.abnormal td {
                background: linear-gradient(90deg,#fff6f6,#ffffff);
                color: #b42318;
            }

            .results-table tbody tr.abnormal:hover td {
                background: linear-gradient(90deg,#fde8e8,#fff6f6);
            }

            .results-table tbody tr.abnormal td:first-child {
                border-left: 4px solid #d92d20;
                padding-left: 12px;
            }

            .results-table tbody tr.abnormal .test-name::after {
                content: " ●";
                color: #d92d20;
                font-size: 8px;
                vertical-align: middle;
                margin-left: 4px;
                animation: pulse 1.6s ease-in-out infinite;
            }

            .results-table tbody tr.hidden-row {
                display: none;
            }

    .test-name {
        font-weight: 700;
        color: #18324f;
        display: block;
        font-size: 13.5px;
    }

    .test-cat {
        font-size: 11px;
        color: #7d8e8a;
        margin-top: 3px;
        display: block;
    }

    .result-value {
        font-weight: 800;
        font-size: 14.5px;
        color: #18324f;
    }

    .results-table tr.abnormal .result-value {
        color: #b42318;
    }

    .flag {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 10.5px;
        font-weight: 800;
        letter-spacing: 0.4px;
        text-transform: uppercase;
    }

        .flag.normal {
            background: #e6f5f1;
            color: #0d6b63;
        }

        .flag.abnormal {
            background: #fde8e8;
            color: #b42318;
        }

        .flag.pending {
            background: #fef3c7;
            color: #92400e;
        }

    .comment-row td {
        background: #f8fbfa !important;
        font-size: 12px;
        color: #52736f;
        padding: 12px 18px !important;
        border-bottom: 1px solid #f0f2f5;
        font-style: italic;
    }

    .comment-row strong {
        color: #0d6b63;
        font-style: normal;
    }

    /* ============ ACTIONS ============ */
    .actions-bar {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 24px;
        padding-top: 24px;
        border-top: 2px solid #eaf6f4;
    }

    .actions-left, .actions-right {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .btn {
        height: 46px;
        padding: 0 24px;
        border-radius: 12px;
        font-size: 13px;
        font-weight: 700;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        border: 1px solid transparent;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
        transition: all 0.15s ease;
    }

    .btn-secondary {
        background: #fff;
        border-color: #d5dde6;
        color: #475467;
    }

        .btn-secondary:hover {
            background: #f5faf9;
            border-color: #b7cfcb;
            color: #0d6b63;
            transform: translateY(-1px);
        }

    .btn-pdf {
        background: linear-gradient(135deg, #dc2626, #b91c1c);
        color: #fff;
        box-shadow: 0 4px 14px rgba(220,38,38,0.24);
    }

        .btn-pdf:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(220,38,38,0.32);
            color: #fff;
        }

    .btn-release {
        background: linear-gradient(135deg, #f59e0b, #d97706);
        color: #fff;
        box-shadow: 0 4px 14px rgba(245,158,11,0.28);
        padding: 0 28px;
    }

        .btn-release:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 22px rgba(245,158,11,0.38);
            color: #fff;
        }

        .btn-release i {
            animation: pulse 2s ease-in-out infinite;
        }

    .released-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 12px 22px;
        background: linear-gradient(135deg, #ecfdf5, #d1fae5);
        border: 1px solid #a7f3d0;
        border-radius: 999px;
        color: #145c57;
        font-size: 13px;
        font-weight: 700;
        box-shadow: 0 4px 12px rgba(34,160,107,0.14);
    }

    /* ============ MODAL ============ */
    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,31,45,0.65);
        backdrop-filter: blur(5px);
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 20px;
        padding: 34px 38px;
        max-width: 540px;
        width: 100%;
        box-shadow: 0 30px 70px rgba(0,0,0,0.28);
        animation: fadeUp 0.25s ease-out;
    }

    .modal-icon {
        width: 56px;
        height: 56px;
        border-radius: 14px;
        background: linear-gradient(135deg, #fef3c7, #fde68a);
        color: #d97706;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
        margin-bottom: 16px;
    }

    .modal-box h3 {
        margin: 0 0 8px;
        color: #0d6b63;
        font-size: 20px;
        font-weight: 800;
    }

    .modal-box .sub {
        margin: 0 0 24px;
        color: #7d8e8a;
        font-size: 13px;
        line-height: 1.65;
    }

    .modal-section-label {
        font-size: 10.5px;
        font-weight: 800;
        text-transform: uppercase;
        color: #34554f;
        letter-spacing: 0.7px;
        margin-bottom: 12px;
        display: block;
    }

    .radio-tile {
        display: flex;
        gap: 14px;
        align-items: flex-start;
        padding: 16px 18px;
        border: 2px solid #e7efee;
        border-radius: 14px;
        cursor: pointer;
        margin-bottom: 12px;
        transition: all 0.15s ease;
        background: #fbfdfc;
    }

        .radio-tile:hover {
            border-color: #b2dfdb;
            background: #f3faf9;
            transform: translateY(-1px);
        }

        .radio-tile input {
            margin-top: 3px;
            accent-color: #0d6b63;
            transform: scale(1.3);
        }

        .radio-tile .tile-text {
            flex: 1;
        }

            .radio-tile .tile-text strong {
                display: block;
                color: #18324f;
                font-size: 13.5px;
                font-weight: 700;
                margin-bottom: 4px;
            }

            .radio-tile .tile-text span {
                color: #7d8e8a;
                font-size: 12px;
                line-height: 1.55;
            }

        .radio-tile.selected {
            border-color: #0d6b63;
            background: #f3faf9;
            box-shadow: 0 0 0 4px rgba(13,107,99,0.09);
        }

    .modal-box textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 13px 15px;
        border: 1.5px solid #dfe6ed;
        border-radius: 12px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        min-height: 100px;
        resize: vertical;
        color: #26384d;
    }

        .modal-box textarea:focus {
            outline: none;
            border-color: #0d6b63;
            box-shadow: 0 0 0 4px rgba(13,107,99,0.1);
        }

    .modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        margin-top: 26px;
    }
</style>

<div class="results-page">

    <!-- ========== HERO ========== -->
    <div class="results-hero">
        <div class="results-hero-inner">
            <div>
                <div class="hero-icon-box">
                    <i class="fas fa-file-medical-alt"></i>
                </div>
                <h1>Test Results</h1>
                <p>Request #@Model.RequestId · @totalTests test@(totalTests == 1 ? "" : "s") on this report</p>
                <div class="meta-row">
                    <span><i class="fas fa-calendar-day"></i> @Model.RequestDate.ToString("dd MMM yyyy")</span>
                    <span><i class="fas fa-bolt"></i> @Model.Urgency</span>
                </div>
            </div>

            <div class="hero-status">
                @if (abnormalCount > 0)
                {
                    <span class="hero-badge abnormal">
                        <i class="fas fa-exclamation-triangle"></i> @abnormalCount abnormal
                    </span>
                }
                @if (isReleased)
                {
                    <span class="hero-badge released">
                        <i class="fas fa-check-circle"></i> Released by Doctor
                    </span>
                }
            </div>
        </div>
    </div>

    <!-- ========== SUMMARY ========== -->
    <div class="summary-strip">
        <div class="summary-tile active" data-filter="all" onclick="filterResults('all', this)">
            <div class="summary-icon teal"><i class="fas fa-vial"></i></div>
            <div>
                <div class="summary-num">@totalTests</div>
                <div class="summary-lbl">Total Tests</div>
            </div>
        </div>

        <div class="summary-tile" data-filter="normal" onclick="filterResults('normal', this)">
            <div class="summary-icon green"><i class="fas fa-check-circle"></i></div>
            <div>
                <div class="summary-num">@normalCount</div>
                <div class="summary-lbl">Normal</div>
            </div>
        </div>

        <div class="summary-tile" data-filter="abnormal" onclick="filterResults('abnormal', this)">
            <div class="summary-icon red"><i class="fas fa-exclamation-circle"></i></div>
            <div>
                <div class="summary-num">@abnormalCount</div>
                <div class="summary-lbl">Abnormal</div>
            </div>
        </div>

        <div class="summary-tile" data-filter="pending" onclick="filterResults('pending', this)">
            <div class="summary-icon amber"><i class="fas fa-hourglass-half"></i></div>
            <div>
                <div class="summary-num">@pendingCount</div>
                <div class="summary-lbl">Pending</div>
            </div>
        </div>
    </div>

    <!-- ========== PATIENT & DOCTOR ========== -->
    @if (patient != null)
    {
        <div class="results-card">
            <h2 class="card-title">
                <span class="card-title-icon"><i class="fas fa-folder-open"></i></span>
                Patient &amp; Referring Doctor Information
            </h2>

            <div class="info-columns">
                <div>
                    <div class="info-block-title">
                        <i class="fas fa-user"></i> Patient Details
                    </div>

                    <div class="info-line">
                        <span class="lbl">Full Name</span>
                        <span class="val">@patient.Name @patient.Surname</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">ID Number</span>
                        <span class="val">@patient.IDNumber</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Date of Birth</span>
                        <span class="val">@patient.DOB.ToString("dd MMMM yyyy")</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Email Address</span>
                        <span class="val">@patient.Email</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Contact Number</span>
                        <span class="val">@patient.CellphoneNumber</span>
                    </div>
                </div>

                <div>
                    <div class="info-block-title">
                        <i class="fas fa-user-doctor"></i> Referring Doctor
                    </div>

                    <div class="info-line">
                        <span class="lbl">Doctor Name</span>
                        <span class="val">Dr. @(doctor?.FirstName ?? "—") @(doctor?.LastName ?? "")</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">HPCSA Number</span>
                        <span class="val">@(string.IsNullOrWhiteSpace(doctor?.HPCSANumber) ? "Not Provided" : doctor.HPCSANumber)</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Practice Email</span>
                        <span class="val">@(doctor?.Email ?? "—")</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Contact Number</span>
                        <span class="val">@(string.IsNullOrWhiteSpace(doctor?.PhoneNumb) ? "Not Provided" : doctor.PhoneNumb)</span>
                    </div>
                    <div class="info-line">
                        <span class="lbl">Request Date</span>
                        <span class="val">@Model.RequestDate.ToString("dd MMMM yyyy")</span>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- ========== ABNORMAL WARNING ========== -->
    @if (abnormalCount > 0)
    {
        <div class="warn-banner">
            <div class="banner-icon"><i class="fas fa-exclamation-triangle"></i></div>
            <div>
                <strong>@abnormalCount abnormal result@(abnormalCount == 1 ? "" : "s") detected.</strong><br />
                Rows highlighted in red below require the patient's attention.
            </div>
        </div>
    }

    <!-- ========== RELEASE NOTE ========== -->
    @if (isReleased && !string.IsNullOrWhiteSpace(Model.ReleaseNote))
    {
        <div class="released-note">
            <div class="banner-icon"><i class="fas fa-check-circle"></i></div>
            <div>
                <strong>Release note:</strong> @Model.ReleaseNote
                <small>Released on @Model.ReleaseDate?.ToString("dd MMMM yyyy 'at' HH:mm")</small>
            </div>
        </div>
    }

    <!-- ========== RESULTS TABLE ========== -->
    <div class="results-card">
        <h2 class="card-title">
            <span class="card-title-icon"><i class="fas fa-microscope"></i></span>
            Laboratory Results
        </h2>

        @if (!items.Any())
        {
            <p style="color:#7d8e8a;font-size:13px;">No test items on this request.</p>
        }
        else
        {
            <table class="results-table" id="resultsTable">
                <thead>
                    <tr>
                        <th style="width:34%;">Test</th>
                        <th style="width:18%;">Result</th>
                        <th style="width:12%;">Units</th>
                        <th style="width:20%;">Reference Range</th>
                        <th style="width:16%;">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var result = item.TestResults?
                            .OrderByDescending(r => r.DateCaptured)
                            .FirstOrDefault();

                        bool abnormal = result?.IsAbnormal ?? false;
                        bool pending = result == null;

                        string rowClass =
                            abnormal ? "result-row abnormal" :
                            pending ? "result-row pending" :
                                       "result-row normal";

                        string statusText =
                            pending ? "Pending" :
                            result.IsAbnormal ? "Abnormal" : "Normal";

                        string flagClass =
                            pending ? "pending" :
                            result.IsAbnormal ? "abnormal" : "normal";

                        <tr class="@rowClass">
                            <td>
                                <span class="test-name">@item.TestType?.Name</span>
                                @if (!string.IsNullOrWhiteSpace(item.TestType?.Category))
                                {
                                    <span class="test-cat">@item.TestType.Category</span>
                                }
                            </td>
                            <td><span class="result-value">@(result?.ResultValue ?? "—")</span></td>
                            <td>@(result?.Units ?? "—")</td>
                            <td>@(result?.ReferenceRange ?? "—")</td>
                            <td>
                                <span class="flag @flagClass">
                                    @if (pending)
                                    {
                                        <i class="fas fa-hourglass-half"></i>
                                    }
                                    else if (result.IsAbnormal)
                                    {
                                        <i class="fas fa-arrow-up"></i>
                                    }
                                    else
                                    {
                                        <i class="fas fa-check"></i>
                                    }
                                    @statusText
                                </span>
                            </td>
                        </tr>

                        @if (!string.IsNullOrWhiteSpace(result?.Comments))
                        {
                            <tr class="comment-row">
                                <td colspan="5">
                                    <strong>Comment:</strong> @result.Comments
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        <!-- ACTION BAR -->
        <div class="actions-bar">
            <div class="actions-left">
                <a asp-action="Track" class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i> Back to Track
                </a>

                @if (allVerified)
                {
                    <a asp-action="ResultsPdf"
                       asp-route-requestId="@Model.RequestId"
                       class="btn btn-pdf"
                       target="_blank">
                        <i class="fas fa-file-pdf"></i> Download PDF
                    </a>
                }
            </div>

            <div class="actions-right">
                @if (isReleased)
                {
                    <span class="released-pill">
                        <i class="fas fa-check-circle"></i> Released to Patient
                    </span>
                }
                else if (allVerified)
                {
                    <button type="button" class="btn btn-release" onclick="openReleaseModal()">
                        <i class="fas fa-paper-plane"></i> Release to Patient
                    </button>
                }
            </div>
        </div>
    </div>

</div>

<!-- ========== RELEASE MODAL ========== -->
@if (allVerified && !isReleased)
{
    <div class="modal-overlay" id="releaseModal">
        <div class="modal-box">
            <div class="modal-icon"><i class="fas fa-paper-plane"></i></div>
            <h3>Release Results</h3>
            <p class="sub">
                Choose how to notify <strong>@patient?.Name @patient?.Surname</strong>.
                They will receive an email with the details.
            </p>

            <form asp-action="ReleaseWithNote" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.RequestId" />

                <span class="modal-section-label">Notification Method</span>

                <label class="radio-tile selected" onclick="selectTile(this)">
                    <input type="radio" name="mode" value="SendResults" checked />
                    <span class="tile-text">
                        <strong>📧 Email results directly</strong>
                        <span>The patient receives a full results summary table by email.</span>
                    </span>
                </label>

                <label class="radio-tile" onclick="selectTile(this)">
                    <input type="radio" name="mode" value="InviteConsultation" />
                    <span class="tile-text">
                        <strong>📅 Invite for consultation</strong>
                        <span>The patient is asked to book an appointment to discuss results in person.</span>
                    </span>
                </label>

                <div style="margin-top:22px;">
                    <span class="modal-section-label">Note (optional)</span>
                    <textarea name="note"
                              placeholder="Add a friendly note or instructions for the patient..."></textarea>
                </div>

                <div class="modal-actions">
                    <button type="button" class="btn btn-secondary" onclick="closeReleaseModal()">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-release">
                        <i class="fas fa-paper-plane"></i> Release Now
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openReleaseModal()  { document.getElementById('releaseModal').classList.add('show'); }
        function closeReleaseModal() { document.getElementById('releaseModal').classList.remove('show'); }

        function selectTile(label) {
            document.querySelectorAll('.radio-tile').forEach(t => t.classList.remove('selected'));
            label.classList.add('selected');
        }

        document.getElementById('releaseModal')?.addEventListener('click', function (e) {
            if (e.target === this) closeReleaseModal();
        });

        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape') closeReleaseModal();
        });
    </script>
}

<!-- ========== FILTER SCRIPT ========== -->
<script>
    function filterResults(filter, tile) {
        document.querySelectorAll('.summary-tile').forEach(t => t.classList.remove('active'));
        tile.classList.add('active');

        var rows = document.querySelectorAll('#resultsTable tbody tr.result-row');

        rows.forEach(function (row) {
            var show = false;

            if (filter === 'all') {
                show = true;
            } else if (filter === 'normal' && row.classList.contains('normal')) {
                show = true;
            } else if (filter === 'abnormal' && row.classList.contains('abnormal')) {
                show = true;
            } else if (filter === 'pending' && row.classList.contains('pending')) {
                show = true;
            }

            row.classList.toggle('hidden-row', !show);

            var next = row.nextElementSibling;
            if (next && next.classList.contains('comment-row')) {
                next.classList.toggle('hidden-row', !show);
            }
        });
    }
</script>