@{
    ViewData["Title"] = "Create Test Request";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>
    /* ============================================
           ROOT VARIABLES
        ============================================ */
    :root {
        --primary: #0d6b63;
        --primary-light: #1a8c82;
        --primary-dark: #09544d;
        --primary-bg: #f0f7f6;
        --primary-gradient: linear-gradient(135deg, #0d6b63, #1a8c82);
        --primary-gradient-light: linear-gradient(135deg, #1a8c82, #2aa89e);
        --text-primary: #1a2f4e;
        --text-secondary: #4a5c7c;
        --text-muted: #7a8da8;
        --border: #e2e8f0;
        --shadow-sm: 0 1px 3px rgba(0,0,0,0.06);
        --shadow-md: 0 4px 16px rgba(0,0,0,0.08);
        --shadow-lg: 0 8px 30px rgba(0,0,0,0.1);
        --radius: 12px;
        --transition: all 0.25s ease;
    }

    /* ============================================
           PAGE LAYOUT - TWO COLUMN
        ============================================ */
    .tr-page {
        display: grid;
        grid-template-columns: 1fr 320px;
        gap: 24px;
        max-width: 1200px;
        margin: 0 auto;
        padding: 0 4px;
    }

    /* ============================================
           LEFT COLUMN - MAIN FORM
        ============================================ */
    .tr-main {
        min-width: 0;
    }

    /* ===== HEADER ===== */
    .tr-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        margin-bottom: 20px;
        flex-wrap: wrap;
        gap: 12px;
    }

        .tr-header h1 {
            font-size: 22px;
            font-weight: 700;
            color: var(--text-primary);
            margin: 0;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .tr-header h1 small {
                font-size: 13px;
                font-weight: 400;
                color: var(--text-muted);
                margin-left: 4px;
            }

        .tr-header .status-badge {
            background: #e8f0fe;
            color: #1a5a8c;
            font-size: 11px;
            font-weight: 600;
            padding: 5px 16px;
            border-radius: 20px;
            letter-spacing: 0.3px;
            text-transform: uppercase;
        }

    /* ===== PATIENT BANNER ===== */
    .tr-patient-banner {
        background: var(--primary-gradient);
        color: white;
        border-radius: var(--radius);
        padding: 18px 22px;
        display: flex;
        align-items: center;
        gap: 16px;
        margin-bottom: 24px;
        box-shadow: var(--shadow-md);
    }

    .tr-patient-avatar {
        width: 44px;
        height: 44px;
        border-radius: 50%;
        background: rgba(255,255,255,0.2);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 17px;
        text-transform: uppercase;
        border: 2px solid rgba(255,255,255,0.2);
        flex-shrink: 0;
    }

    .tr-patient-info {
        flex: 1;
    }

    .tr-patient-name {
        font-size: 15px;
        font-weight: 700;
    }

    .tr-patient-sub {
        font-size: 12px;
        opacity: 0.85;
        display: flex;
        gap: 14px;
        flex-wrap: wrap;
        margin-top: 2px;
    }

        .tr-patient-sub span {
            display: inline-flex;
            align-items: center;
            gap: 4px;
        }

    /* ===== FORM CARDS - COLORFUL ===== */
    .tr-card {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        padding: 24px 28px;
        margin-bottom: 20px;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

        /* Colored accent bar on each card */
        .tr-card::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 4px;
        }

        /* Card 1 - Request Details (Blue/Teal) */
        .tr-card:nth-child(1)::before {
            background: linear-gradient(90deg, #0d6b63, #1a8c82, #2aa89e);
        }

        /* Card 2 - Test Selection (Green/Teal) */
        .tr-card:nth-child(2)::before {
            background: linear-gradient(90deg, #1a8c82, #2aa89e, #34c4b8);
        }

        /* Card 3 - Barcodes (Gold/Amber) */
        .tr-card:nth-child(3)::before {
            background: linear-gradient(90deg, #f59e0b, #fbbf24, #fcd34d);
        }

        .tr-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .tr-card:last-child {
            margin-bottom: 0;
        }

    /* Card header with colored step numbers */
    .tr-card-header {
        display: flex;
        align-items: center;
        gap: 10px;
        margin-bottom: 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #f0f2f5;
    }

        .tr-card-header .step {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            width: 28px;
            height: 28px;
            background: var(--primary-gradient);
            color: white;
            border-radius: 50%;
            font-size: 12px;
            font-weight: 700;
            flex-shrink: 0;
            box-shadow: 0 2px 8px rgba(13, 107, 99, 0.3);
        }

        .tr-card-header h3 {
            font-size: 13px;
            font-weight: 700;
            color: var(--text-primary);
            text-transform: uppercase;
            letter-spacing: 0.4px;
            margin: 0;
        }

        .tr-card-header .sub {
            font-size: 12px;
            color: var(--text-muted);
            font-weight: 400;
            text-transform: none;
            margin-left: auto;
            background: var(--primary-bg);
            padding: 2px 12px;
            border-radius: 12px;
            color: var(--primary);
        }

    /* ===== FORM FIELDS ===== */
    .tr-form-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
    }

    .tr-form-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .tr-form-group.full {
            grid-column: 1 / -1;
        }

        .tr-form-group label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

            .tr-form-group label .required {
                color: #dc3545;
                margin-left: 2px;
            }

        .tr-form-group .hint {
            font-size: 10px;
            color: var(--text-muted);
            font-weight: 400;
            text-transform: none;
            margin-left: 4px;
        }

        .tr-form-group input,
        .tr-form-group select,
        .tr-form-group textarea {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 13px;
            font-family: 'Inter', -apple-system, sans-serif;
            background: #fafbfc;
            transition: var(--transition);
            width: 100%;
        }

            .tr-form-group input:focus,
            .tr-form-group select:focus,
            .tr-form-group textarea:focus {
                border-color: var(--primary);
                outline: none;
                background: white;
                box-shadow: 0 0 0 3px rgba(13, 107, 99, 0.08);
            }

        .tr-form-group textarea {
            resize: vertical;
            min-height: 76px;
        }

    /* ===== TEST LIST ===== */
    .tr-testtype-list {
        display: flex;
        flex-direction: column;
        gap: 8px;
        max-height: 350px;
        overflow-y: auto;
        padding-right: 4px;
    }

        .tr-testtype-list::-webkit-scrollbar {
            width: 4px;
        }

        .tr-testtype-list::-webkit-scrollbar-track {
            background: #f0f2f5;
            border-radius: 4px;
        }

        .tr-testtype-list::-webkit-scrollbar-thumb {
            background: var(--primary-light);
            border-radius: 4px;
        }

    .tr-testtype-item {
        display: flex;
        align-items: center;
        gap: 12px;
        border: 1.5px solid var(--border);
        border-radius: 8px;
        padding: 10px 14px;
        cursor: pointer;
        transition: var(--transition);
        background: white;
        position: relative;
    }

        .tr-testtype-item:hover {
            border-color: var(--primary);
            background: var(--primary-bg);
            transform: translateX(4px);
        }

        .tr-testtype-item.checked {
            border-color: var(--primary);
            background: var(--primary-bg);
            box-shadow: 0 0 0 2px rgba(13, 107, 99, 0.15);
        }

        .tr-testtype-item input[type="checkbox"] {
            width: 17px;
            height: 17px;
            min-width: 17px;
            accent-color: var(--primary);
            cursor: pointer;
            margin: 0;
        }

    .tr-testtype-info {
        flex: 1;
        min-width: 0;
    }

    .tr-testtype-name {
        font-size: 13px;
        font-weight: 600;
        color: var(--text-primary);
    }

    .tr-testtype-meta {
        font-size: 11px;
        color: var(--text-muted);
        margin-top: 2px;
        display: flex;
        align-items: center;
        gap: 8px;
        flex-wrap: wrap;
    }

        .tr-testtype-meta .dot {
            color: var(--border);
        }

    .tr-sample-pill {
        font-size: 10px;
        font-weight: 600;
        padding: 3px 12px;
        border-radius: 20px;
        white-space: nowrap;
        flex-shrink: 0;
    }

        .tr-sample-pill.blood {
            background: #fce4ec;
            color: #c62828;
        }

        .tr-sample-pill.urine {
            background: #fff3e0;
            color: #e65100;
        }

        .tr-sample-pill.saliva {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .tr-sample-pill.swab {
            background: #f3e5f5;
            color: #6a1b9a;
        }

        .tr-sample-pill.serum {
            background: #e3f2fd;
            color: #0d47a1;
        }

        .tr-sample-pill.plasma {
            background: #fce4ec;
            color: #880e4f;
        }

        .tr-sample-pill.stool {
            background: #efebe9;
            color: #4e342e;
        }

        .tr-sample-pill.other {
            background: #f5f5f5;
            color: #424242;
        }

    /* ===== SAMPLES NEEDED ===== */
    .tr-samples-needed {
        margin-top: 14px;
        background: linear-gradient(135deg, #e8f5e9, #c8e6c9);
        border: 1px solid #81c784;
        border-radius: 8px;
        padding: 12px 16px;
        font-size: 12.5px;
        color: #1b5e20;
        display: none;
        align-items: center;
        gap: 12px;
    }

        .tr-samples-needed.visible {
            display: flex;
        }

        .tr-samples-needed .icon {
            font-size: 18px;
        }

        .tr-samples-needed strong {
            font-weight: 600;
        }

        .tr-samples-needed .list {
            font-weight: 500;
        }

    /* ===== BARCODES ===== */
    .tr-barcode-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-top: 4px;
    }

    .tr-barcode-group {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .tr-barcode-group label {
            font-size: 11px;
            font-weight: 600;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.3px;
        }

        .tr-barcode-group input {
            border: 1px solid var(--border);
            border-radius: 8px;
            padding: 10px 12px;
            font-size: 14px;
            font-family: 'Courier New', monospace;
            letter-spacing: 0.5px;
            background: #fafbfc;
            transition: var(--transition);
        }

            .tr-barcode-group input:focus {
                border-color: var(--primary);
                outline: none;
                background: white;
                box-shadow: 0 0 0 3px rgba(13, 107, 99, 0.08);
            }

    /* ===== ERROR DISPLAY ===== */
    .tr-error {
        color: #dc3545;
        font-size: 12px;
        margin-top: 8px;
        display: block;
    }

        .tr-error ul {
            list-style: none;
            padding: 0;
            margin: 0;
        }

            .tr-error ul li::before {
                content: "⚠ ";
            }

    /* ===== BUTTONS ===== */
    .tr-actions {
        margin-top: 24px;
        padding-top: 20px;
        border-top: 1px solid #f0f2f5;
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        flex-wrap: wrap;
    }

    .tr-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 24px;
        font-size: 13px;
        font-weight: 600;
        border: none;
        border-radius: 8px;
        cursor: pointer;
        transition: var(--transition);
        text-decoration: none;
        font-family: 'Inter', -apple-system, sans-serif;
    }

    .tr-btn-cancel {
        background: #f0f2f5;
        color: var(--text-secondary);
    }

        .tr-btn-cancel:hover {
            background: #e5e7eb;
            color: var(--text-primary);
        }

    .tr-btn-submit {
        background: var(--primary-gradient);
        color: white;
        box-shadow: 0 2px 10px rgba(13, 107, 99, 0.3);
    }

        .tr-btn-submit:hover {
            background: var(--primary-gradient-light);
            transform: translateY(-2px);
            box-shadow: 0 4px 20px rgba(13, 107, 99, 0.4);
        }

        .tr-btn-submit:disabled {
            opacity: 0.6;
            cursor: not-allowed;
            transform: none;
            box-shadow: none;
        }

    /* ============================================
           RIGHT COLUMN - SIDEBAR SUMMARY
        ============================================ */
    .tr-sidebar {
        position: sticky;
        top: 20px;
        align-self: start;
    }

    .tr-sidebar-card {
        background: white;
        border-radius: var(--radius);
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--border);
        padding: 20px 22px;
        margin-bottom: 16px;
        transition: var(--transition);
        position: relative;
        overflow: hidden;
    }

        /* Sidebar card colored accents */
        .tr-sidebar-card:nth-child(1)::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #0d6b63, #1a8c82);
        }

        .tr-sidebar-card:nth-child(2)::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #1a8c82, #2aa89e);
        }

        .tr-sidebar-card:nth-child(3)::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #f59e0b, #fbbf24);
        }

        .tr-sidebar-card:nth-child(4)::before {
            content: '';
            position: absolute;
            top: 0;
            left: 0;
            right: 0;
            height: 3px;
            background: linear-gradient(90deg, #8b5cf6, #a78bfa);
        }

        .tr-sidebar-card:hover {
            box-shadow: var(--shadow-md);
            transform: translateY(-2px);
        }

        .tr-sidebar-card:last-child {
            margin-bottom: 0;
        }

        .tr-sidebar-card .title {
            font-size: 11px;
            font-weight: 700;
            color: var(--text-secondary);
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin: 0 0 12px 0;
            padding-bottom: 10px;
            border-bottom: 1px solid #f0f2f5;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

            .tr-sidebar-card .title .count {
                background: var(--primary-bg);
                color: var(--primary);
                font-size: 11px;
                padding: 1px 10px;
                border-radius: 12px;
                font-weight: 700;
            }

    /* ===== SUMMARY ITEMS ===== */
    .tr-summary-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 8px 0;
        border-bottom: 1px solid #f5f6f8;
        font-size: 13px;
    }

        .tr-summary-item:last-child {
            border-bottom: none;
        }

        .tr-summary-item .dot {
            width: 6px;
            height: 6px;
            border-radius: 50%;
            background: var(--primary);
            flex-shrink: 0;
        }

        .tr-summary-item .name {
            flex: 1;
            color: var(--text-primary);
            font-weight: 500;
            font-size: 12px;
        }

        .tr-summary-item .badge-sm {
            font-size: 10px;
            color: var(--text-muted);
            background: #f0f2f5;
            padding: 1px 8px;
            border-radius: 10px;
        }

    .tr-summary-empty {
        color: var(--text-muted);
        font-size: 13px;
        text-align: center;
        padding: 16px 0;
    }

    /* ===== SIDEBAR STATS ===== */
    .tr-stat-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .tr-stat {
        background: #f8f9fb;
        border-radius: 8px;
        padding: 12px 14px;
        text-align: center;
        transition: var(--transition);
    }

        .tr-stat:hover {
            background: var(--primary-bg);
            transform: scale(1.02);
        }

        .tr-stat .value {
            font-size: 20px;
            font-weight: 700;
            color: var(--primary);
        }

        .tr-stat .label {
            font-size: 10px;
            color: var(--text-muted);
            text-transform: uppercase;
            letter-spacing: 0.3px;
            margin-top: 2px;
        }

    /* ===== SIDEBAR PATIENT INFO ===== */
    .tr-sidebar-patient {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

        .tr-sidebar-patient .name {
            font-weight: 600;
            color: var(--text-primary);
            font-size: 14px;
        }

        .tr-sidebar-patient .detail {
            font-size: 12px;
            color: var(--text-muted);
        }

            .tr-sidebar-patient .detail strong {
                color: var(--text-secondary);
                font-weight: 600;
            }

    /* ===== SEARCH/FILTER ===== */
    .tr-search-box {
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--border);
        border-radius: 8px;
        font-size: 13px;
        margin-bottom: 12px;
        background: #fafbfc;
        transition: var(--transition);
    }

        .tr-search-box:focus {
            border-color: var(--primary);
            outline: none;
            background: white;
            box-shadow: 0 0 0 3px rgba(13, 107, 99, 0.08);
        }

        .tr-search-box::placeholder {
            color: #b0bccd;
        }

    /* ============================================
           RESPONSIVE
        ============================================ */
    @@media (max-width: 1024px) {
        .tr-page {
            grid-template-columns: 1fr;
        }

        .tr-sidebar {
            position: static;
            display: grid;
            grid-template-columns: 1fr 1fr;
            gap: 16px;
        }

        .tr-sidebar-card {
            margin-bottom: 0;
        }
    }

    @@media (max-width: 768px) {
        .tr-card {
            padding: 18px 16px;
        }

        .tr-form-grid,
        .tr-barcode-grid {
            grid-template-columns: 1fr;
        }

        .tr-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .tr-patient-banner {
            flex-wrap: wrap;
        }

        .tr-patient-sub {
            flex-direction: column;
            gap: 2px;
        }

        .tr-actions {
            flex-direction: column-reverse;
        }

            .tr-actions .tr-btn {
                justify-content: center;
                width: 100%;
            }

        .tr-sidebar {
            grid-template-columns: 1fr;
        }

        .tr-testtype-list {
            max-height: 250px;
        }
    }

    /* ============================================
           ANIMATIONS
        ============================================ */
    @@keyframes slideIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    .tr-card {
        animation: slideIn 0.3s ease both;
    }

        .tr-card:nth-child(1) {
            animation-delay: 0.02s;
        }

        .tr-card:nth-child(2) {
            animation-delay: 0.06s;
        }

        .tr-card:nth-child(3) {
            animation-delay: 0.10s;
        }

    .tr-sidebar-card {
        animation: slideIn 0.3s ease both;
    }

        .tr-sidebar-card:nth-child(1) {
            animation-delay: 0.04s;
        }

        .tr-sidebar-card:nth-child(2) {
            animation-delay: 0.08s;
        }

        .tr-sidebar-card:nth-child(3) {
            animation-delay: 0.12s;
        }

        .tr-sidebar-card:nth-child(4) {
            animation-delay: 0.16s;
        }

    .tr-testtype-item {
        animation: slideIn 0.2s ease both;
    }

        .tr-testtype-item:nth-child(1) {
            animation-delay: 0.01s;
        }

        .tr-testtype-item:nth-child(2) {
            animation-delay: 0.03s;
        }

        .tr-testtype-item:nth-child(3) {
            animation-delay: 0.05s;
        }

        .tr-testtype-item:nth-child(4) {
            animation-delay: 0.07s;
        }

        .tr-testtype-item:nth-child(5) {
            animation-delay: 0.09s;
        }

        .tr-testtype-item:nth-child(6) {
            animation-delay: 0.11s;
        }

        .tr-testtype-item:nth-child(7) {
            animation-delay: 0.13s;
        }

        .tr-testtype-item:nth-child(8) {
            animation-delay: 0.15s;
        }

        .tr-testtype-item:nth-child(9) {
            animation-delay: 0.17s;
        }

        .tr-testtype-item:nth-child(10) {
            animation-delay: 0.19s;
        }
</style>

<!-- ============================================
   PAGE CONTENT
============================================ -->
<div class="tr-page">

    <!-- ===== LEFT COLUMN ===== -->
    <div class="tr-main">

        <!-- HEADER -->
        <div class="tr-header">
            <h1>
                Create Test Request
                <small>New laboratory order</small>
            </h1>
            <span class="status-badge">● Draft</span>
        </div>

        <!-- PATIENT BANNER -->
        <div class="tr-patient-banner">
            <div class="tr-patient-avatar">
                @{
                    var patientName = ViewBag.PatientName as string ?? "Unknown";
                    var initial = string.IsNullOrEmpty(patientName) ? "?" : patientName.Substring(0, 1);
                }
                @initial
            </div>
            <div class="tr-patient-info">
                <div class="tr-patient-name">@patientName</div>
                <div class="tr-patient-sub">
                    <span>🆔 @ViewBag.PatientIDNumber</span>
                    <span>📅 DOB: @ViewBag.PatientDOB</span>
                </div>
            </div>
            <div style="font-size:12px;opacity:0.8;margin-left:auto;white-space:nowrap;">
                ID: @ViewBag.PatientId
            </div>
        </div>

        <!-- ===== FORM ===== -->
        <form asp-action="Create" method="post" id="testRequestForm" novalidate>

            <input type="hidden" name="patientId" value="@ViewBag.PatientId" />

            <!-- VALIDATION -->
            @if (!ViewData.ModelState.IsValid)
            {
                <div class="tr-card" style="background:#fef2f2;border-color:#fecaca;padding:14px 20px;margin-bottom:16px;">
                    <div class="tr-error">
                        <div asp-validation-summary="All"></div>
                    </div>
                </div>
            }

            @if (TempData["Error"] != null)
            {
                <div class="tr-card" style="background:#fef2f2;border-color:#fecaca;padding:14px 20px;margin-bottom:16px;">
                    <span class="tr-error">⚠ @TempData["Error"]</span>
                </div>
            }

            <!-- ===== CARD 1: REQUEST DETAILS ===== -->
            <div class="tr-card">
                <div class="tr-card-header">
                    <span class="step">1</span>
                    <h3>Request Details</h3>
                    <span class="sub">Step 1 of 3</span>
                </div>

                <div class="tr-form-grid">
                    <div class="tr-form-group">
                        <label>Request Date <span class="required">*</span></label>
                        <input type="date"
                               name="requestDate"
                               value="@DateTime.Now.ToString("yyyy-MM-dd")"
                               required />
                    </div>

                    <div class="tr-form-group">
                        <label>Urgency <span class="required">*</span></label>
                        <select name="urgency" required>
                            <option value="">Select urgency</option>
                            <option value="Routine">Routine (24-48 hrs)</option>
                            <option value="Urgent">Urgent (4-8 hrs)</option>
                            <option value="STAT">STAT (1-2 hrs)</option>
                        </select>
                    </div>

                    <div class="tr-form-group full">
                        <label>Clinical Notes <span class="hint">(optional)</span></label>
                        <textarea name="clinicalNotes"
                                  placeholder="Provide clinical context, symptoms, or specific questions for the pathologist..."
                                  rows="3"></textarea>
                    </div>
                </div>
            </div>

            <!-- ===== CARD 2: TEST SELECTION ===== -->
            <div class="tr-card">
                <div class="tr-card-header">
                    <span class="step">2</span>
                    <h3>Select Tests</h3>
                    <span class="sub" id="testCount">0 selected</span>
                </div>

                <!-- Search/Filter -->
                <input type="text"
                       class="tr-search-box"
                       id="testSearch"
                       placeholder="🔍 Search tests by name or category..."
                       autocomplete="off" />

                <div class="tr-testtype-list" id="testTypeList">
                    @{
                        var testTypes = ViewBag.TestTypes as List<LabDash.Models.TestType>;
                        if (testTypes != null && testTypes.Any())
                        {
                            foreach (var t in testTypes)
                            {
                                var sampleClass = t.RequiredSampleType?.ToLower() ?? "other";
                                <label class="tr-testtype-item"
                                       data-sample="@t.RequiredSampleType"
                                       data-name="@t.Name?.ToLower()"
                                       data-category="@t.Category?.ToLower()">
                                    <input type="checkbox"
                                           name="selectedTestTypeIds"
                                           value="@t.Id"
                                           class="tt-checkbox" />
                                    <div class="tr-testtype-info">
                                        <div class="tr-testtype-name">@t.Name</div>
                                        <div class="tr-testtype-meta">
                                            @t.Category
                                            <span class="dot">•</span>
                                            ⏱ @t.TurnaroundTimeHours hrs turnaround
                                        </div>
                                    </div>
                                    <span class="tr-sample-pill @sampleClass">@t.RequiredSampleType</span>
                                </label>
                            }
                        }
                        else
                        {
                            <div style="padding:20px;text-align:center;color:var(--text-muted);">
                                <p>No test types available.</p>
                            </div>
                        }
                    }
                </div>

                <!-- SAMPLES NEEDED -->
                <div class="tr-samples-needed" id="samplesNeededBox">
                    <span class="icon">🧪</span>
                    <div>
                        <strong>Samples to collect:</strong>
                        <span class="list" id="samplesNeededText">None selected</span>
                    </div>
                </div>
            </div>

            <!-- ===== CARD 3: BARCODES ===== -->
            <div class="tr-card">
                <div class="tr-card-header">
                    <span class="step">3</span>
                    <h3>Sample Barcodes</h3>
                    <span class="sub">Step 3 of 3</span>
                </div>

                <div class="tr-barcode-grid">
                    <div class="tr-barcode-group">
                        <label>Barcode #1</label>
                        <input type="text"
                               name="sampleBarcode1"
                               placeholder="Enter barcode..."
                               autocomplete="off"
                               spellcheck="false" />
                    </div>
                    <div class="tr-barcode-group">
                        <label>Barcode #2</label>
                        <input type="text"
                               name="sampleBarcode2"
                               placeholder="Enter barcode..."
                               autocomplete="off"
                               spellcheck="false" />
                    </div>
                </div>
            </div>

            <!-- ===== ACTIONS ===== -->
            <div class="tr-actions">
                <a href="@Url.Action("ManagePatients", "Doctor")" class="tr-btn tr-btn-cancel">
                    ← Cancel
                </a>
                <button type="submit" class="tr-btn tr-btn-submit" id="submitBtn">
                    📤 Submit Request
                </button>
            </div>

        </form>
    </div>

    <!-- ===== RIGHT COLUMN - SIDEBAR ===== -->
    <div class="tr-sidebar">

        <!-- PATIENT SUMMARY -->
        <div class="tr-sidebar-card">
            <div class="title">Patient Summary</div>
            <div class="tr-sidebar-patient">
                <div class="name">@patientName</div>
                <div class="detail"><strong>ID:</strong> @ViewBag.PatientIDNumber</div>
                <div class="detail"><strong>DOB:</strong> @ViewBag.PatientDOB</div>
                <div class="detail"><strong>Status:</strong> Active</div>
            </div>
        </div>

        <!-- SELECTED TESTS -->
        <div class="tr-sidebar-card">
            <div class="title">
                Selected Tests
                <span class="count" id="sidebarCount">0</span>
            </div>
            <div id="sidebarTestList">
                <div class="tr-summary-empty">No tests selected yet</div>
            </div>
        </div>

        <!-- QUICK STATS -->
        <div class="tr-sidebar-card">
            <div class="title">Quick Stats</div>
            <div class="tr-stat-grid">
                <div class="tr-stat">
                    <div class="value" id="statTests">0</div>
                    <div class="label">Tests</div>
                </div>
                <div class="tr-stat">
                    <div class="value" id="statSamples">0</div>
                    <div class="label">Sample Types</div>
                </div>
                <div class="tr-stat">
                    <div class="value" id="statUrgency">—</div>
                    <div class="label">Urgency</div>
                </div>
                <div class="tr-stat">
                    <div class="value" id="statTurnaround">—</div>
                    <div class="label">Turnaround</div>
                </div>
            </div>
        </div>

        <!-- HELPFUL INFO -->
        <div class="tr-sidebar-card" style="background:linear-gradient(135deg, #f8fafc, #f0f7f6);border-color:#c8d6e5;">
            <div class="title" style="border-bottom-color:#c8d6e5;">💡 Helpful Tips</div>
            <ul style="margin:0;padding-left:18px;font-size:12px;color:var(--text-muted);line-height:1.7;">
                <li>Select at least one test to proceed</li>
                <li>STAT requests are prioritized</li>
                <li>Barcodes are optional for now</li>
                <li>Clinical notes help pathologists</li>
            </ul>
        </div>

    </div>
</div>

<!-- ============================================
   SCRIPTS
============================================ -->
@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function () {
            const checkboxes = document.querySelectorAll('.tt-checkbox');
            const samplesBox = document.getElementById('samplesNeededBox');
            const samplesText = document.getElementById('samplesNeededText');
            const sidebarList = document.getElementById('sidebarTestList');
            const sidebarCount = document.getElementById('sidebarCount');
            const testCount = document.getElementById('testCount');
            const statTests = document.getElementById('statTests');
            const statSamples = document.getElementById('statSamples');
            const form = document.getElementById('testRequestForm');
            const submitBtn = document.getElementById('submitBtn');
            const searchBox = document.getElementById('testSearch');

            // Sample type colors for sidebar dots
            const sampleColors = {
                'blood': '#c62828',
                'urine': '#e65100',
                'saliva': '#2e7d32',
                'swab': '#6a1b9a',
                'serum': '#0d47a1',
                'plasma': '#880e4f',
                'stool': '#4e342e',
                'other': '#7a8da8'
            };

            // ===== SEARCH/FILTER FUNCTIONALITY =====
            if (searchBox) {
                searchBox.addEventListener('input', function () {
                    const query = this.value.toLowerCase().trim();
                    const items = document.querySelectorAll('.tr-testtype-item');

                    items.forEach(item => {
                        const name = item.dataset.name || '';
                        const category = item.dataset.category || '';
                        const sample = item.dataset.sample || '';

                        const matches = name.includes(query) ||
                                       category.includes(query) ||
                                       sample.toLowerCase().includes(query);

                        item.style.display = matches ? 'flex' : 'none';
                    });
                });
            }

            // ===== UPDATE SUMMARY FUNCTION =====
            function updateSummary() {
                const selected = Array.from(checkboxes).filter(cb => cb.checked);
                const selectedItems = selected.map(cb => cb.closest('.tr-testtype-item'));

                // Toggle checked class
                document.querySelectorAll('.tr-testtype-item').forEach(item => {
                    item.classList.toggle('checked', item.querySelector('.tt-checkbox').checked);
                });

                // Update counts
                const count = selected.length;
                sidebarCount.textContent = count;
                testCount.textContent = count + ' selected';
                statTests.textContent = count;

                // Update samples
                const sampleTypes = [...new Set(
                    selectedItems.map(item => item.dataset.sample).filter(Boolean)
                )];

                if (sampleTypes.length > 0) {
                    samplesBox.classList.add('visible');
                    samplesText.textContent = sampleTypes.join(', ');
                    statSamples.textContent = sampleTypes.length;
                } else {
                    samplesBox.classList.remove('visible');
                    samplesText.textContent = 'None selected';
                    statSamples.textContent = '0';
                }

                // Update sidebar list
                if (selectedItems.length === 0) {
                    sidebarList.innerHTML = '<div class="tr-summary-empty">No tests selected yet</div>';
                } else {
                    let html = '';
                    selectedItems.forEach(item => {
                        const name = item.querySelector('.tr-testtype-name').textContent;
                        const sample = item.dataset.sample || 'other';
                        const color = sampleColors[sample.toLowerCase()] || '#7a8da8';
                        html += `
                            <div class="tr-summary-item">
                                <span class="dot" style="background:${color};"></span>
                                <span class="name">${name}</span>
                                <span class="badge-sm">${sample}</span>
                            </div>
                        `;
                    });
                    sidebarList.innerHTML = html;
                }

                // Update urgency stat
                const urgencySelect = document.querySelector('select[name="urgency"]');
                if (urgencySelect) {
                    const urgencyText = urgencySelect.options[urgencySelect.selectedIndex]?.text || '—';
                    document.getElementById('statUrgency').textContent = urgencyText.split(' ')[0] || '—';
                }

                // Update turnaround stat
                const turnarounds = selectedItems.map(item => {
                    const meta = item.querySelector('.tr-testtype-meta')?.textContent || '';
                    const match = meta.match(/(\d+)\s*hrs?/);
                    return match ? parseInt(match[1]) : 0;
                }).filter(h => h > 0);

                if (turnarounds.length > 0) {
                    const max = Math.max(...turnarounds);
                    const min = Math.min(...turnarounds);
                    document.getElementById('statTurnaround').textContent = min === max ? min + 'h' : min + '-' + max + 'h';
                } else {
                    document.getElementById('statTurnaround').textContent = '—';
                }
            }

            // ===== ATTACH EVENTS =====
            checkboxes.forEach(cb => {
                cb.addEventListener('change', updateSummary);
            });

            // Urgency change updates stats
            const urgencySelect = document.querySelector('select[name="urgency"]');
            if (urgencySelect) {
                urgencySelect.addEventListener('change', updateSummary);
            }

            // ===== FORM SUBMISSION =====
            form.addEventListener('submit', function (e) {
                const selected = document.querySelectorAll('.tt-checkbox:checked');

                if (selected.length === 0) {
                    e.preventDefault();
                    alert('Please select at least one test type.');
                    return false;
                }

                submitBtn.disabled = true;
                submitBtn.innerHTML = '⏳ Submitting...';
            });

            // ===== CLICK ON TEST ITEM TOGGLE =====
            document.querySelectorAll('.tr-testtype-item').forEach(item => {
                const checkbox = item.querySelector('.tt-checkbox');
                if (!checkbox) return;

                item.addEventListener('click', function (e) {
                    // Don't toggle if clicking the checkbox itself
                    if (e.target.tagName === 'INPUT') return;
                    checkbox.checked = !checkbox.checked;
                    checkbox.dispatchEvent(new Event('change'));
                });
            });

            // ===== INITIAL UPDATE =====
            updateSummary();
        });
    </script>
}