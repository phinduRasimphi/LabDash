@using LabDash.Models

@{
    ViewData["Title"] = "New Test Request";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var testTypes = ViewBag.TestTypes as IEnumerable<TestType>
                    ?? Enumerable.Empty<TestType>();

    int patientId = ViewBag.PatientId ?? 0;

    string patientName = ViewBag.PatientName ?? "Unknown Patient";
    string patientIDNumber = ViewBag.PatientIDNumber ?? "Not available";
    string patientDOB = ViewBag.PatientDOB ?? "Not available";
    string patientEmail = ViewBag.PatientEmail ?? "Not available";
    string patientCell = ViewBag.PatientCell ?? "Not available";
    DateTime requestDate = ViewBag.RequestDate ?? DateTime.Today;

    var allergies = ViewBag.PatientAllergies as System.Collections.IEnumerable;
    var conditions = ViewBag.PatientConditions as System.Collections.IEnumerable;
    var medications = ViewBag.PatientMedications as System.Collections.IEnumerable;
    var prevResults = ViewBag.PreviousResults as System.Collections.IEnumerable;

    // Group tests by category for display, alphabetical.
    var groupedTests = testTypes
        .GroupBy(t => t.TestCategory != null
                        ? t.TestCategory.CategoryName
                        : t.Category)
        .OrderBy(g => g.Key);
}

<style>
    .test-request-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 28px 30px 50px;
        color: #294943;
    }

    .tr-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .tr-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .tr-header-icon {
        width: 56px;
        height: 56px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: #fff;
        font-size: 22px;
    }

    .tr-page-header h1 {
        margin: 0;
        color: #173c38;
        font-size: 25px;
        font-weight: 750;
    }

    .tr-page-header p {
        margin: 5px 0 0;
        color: #788b87;
        font-size: 13px;
    }

    .tr-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-radius: 12px;
        border: 1px solid #d8e6e3;
        background: #fff;
        color: #46635d;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
    }

        .tr-back-btn:hover {
            background: #f3faf8;
            color: #0d6b63;
        }

    .tr-layout {
        display: grid;
        grid-template-columns: minmax(0,1fr) 325px;
        gap: 22px;
        align-items: start;
    }

    .tr-main {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .tr-sidebar {
        position: sticky;
        top: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .tr-card {
        background: #fff;
        border: 1px solid #e0ebe8;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 5px 22px rgba(31,78,72,.055);
    }

    .tr-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 20px;
    }

    .tr-card-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eaf6f4;
        color: #0d6b63;
    }

    .tr-card-header h3 {
        margin: 0;
        color: #173c38;
        font-size: 16px;
        font-weight: 750;
    }

    .tr-card-header p {
        margin: 4px 0 0;
        color: #7d8e8a;
        font-size: 11px;
    }

    /* ---------- patient banner ---------- */
    .patient-banner {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 15px;
        padding: 19px;
        border-radius: 17px;
        background: linear-gradient(135deg,#edf9f7,#f8fcfb);
        border: 1px solid #d7ebe7;
    }

    .patient-avatar {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient(135deg,#0d6b63,#1a8c82);
        color: #fff;
        font-size: 19px;
    }

    .patient-main-name {
        color: #173c38;
        font-size: 17px;
        font-weight: 750;
    }

    .patient-main-id {
        margin-top: 4px;
        color: #71847f;
        font-size: 11px;
    }

    .patient-badge {
        padding: 7px 12px;
        border-radius: 30px;
        background: #d9efeb;
        color: #0d6b63;
        font-size: 10px;
        font-weight: 750;
    }

    .patient-details {
        display: grid;
        grid-template-columns: repeat(2,1fr);
        gap: 12px;
        margin-top: 13px;
    }

    .patient-detail {
        padding: 12px 14px;
        border: 1px solid #e2ecea;
        border-radius: 12px;
        background: #fbfdfc;
    }

    .patient-detail-label {
        display: block;
        margin-bottom: 4px;
        color: #879792;
        font-size: 9px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .patient-detail-value {
        color: #35534d;
        font-size: 12px;
        font-weight: 650;
    }

    /* ---------- clinical snapshot ---------- */
    .clinical-snap {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 12px;
        margin-top: 17px;
    }

    .clinical-box {
        padding: 13px 14px;
        border-radius: 12px;
        border: 1px solid #e2ecea;
        background: #fbfdfc;
    }

        .clinical-box h4 {
            margin: 0 0 8px;
            color: #35534d;
            font-size: 11px;
            font-weight: 750;
            text-transform: uppercase;
            letter-spacing: .5px;
        }

        .clinical-box ul {
            list-style: none;
            margin: 0;
            padding: 0;
        }

        .clinical-box li {
            color: #4b6862;
            font-size: 11px;
            padding: 4px 0;
            border-bottom: 1px dashed #e7efee;
        }

            .clinical-box li:last-child {
                border-bottom: none;
            }

            .clinical-box li span {
                display: block;
                color: #8fa9a3;
                font-size: 9px;
                margin-top: 2px;
            }

    .clinical-empty {
        color: #9aa9a5;
        font-size: 11px;
        font-style: italic;
    }

    /* ---------- previous results ---------- */
    .prev-results {
        margin-top: 20px;
        border-top: 1px solid #e0ebe8;
        padding-top: 18px;
    }

        .prev-results h4 {
            margin: 0 0 12px;
            color: #173c38;
            font-size: 13px;
            font-weight: 750;
        }

    .prev-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 11px;
    }

        .prev-table th {
            text-align: left;
            padding: 8px 10px;
            background: #f3faf8;
            color: #0d6b63;
            font-weight: 700;
            border-bottom: 1px solid #d7ebe7;
        }

        .prev-table td {
            padding: 8px 10px;
            border-bottom: 1px solid #e7efee;
            color: #35534d;
        }

        .prev-table tr.abn td {
            color: #b6392f;
            background: #fff6f5;
        }

    /* ---------- form fields ---------- */
    .tr-form-grid {
        display: grid;
        grid-template-columns: repeat(2,minmax(0,1fr));
        gap: 18px;
    }

    .tr-form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .tr-form-group.full-width {
            grid-column: 1 / -1;
        }

    .tr-label {
        color: #34554f;
        font-size: 11px;
        font-weight: 750;
    }

    .tr-required {
        color: #c64d4d;
    }

    .tr-input, .tr-textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #d5e3e0;
        border-radius: 12px;
        background: #fff;
        color: #294943;
        font-size: 12px;
        outline: none;
    }

        .tr-input:focus, .tr-textarea:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 3px rgba(26,140,130,.09);
        }

    .tr-textarea {
        min-height: 115px;
        resize: vertical;
        line-height: 1.6;
    }

    .tr-input[readonly] {
        background: #f3faf8;
        cursor: not-allowed;
        color: #52716c;
    }

    .tr-help {
        font-size: 11px;
        color: #7d8e8a;
        margin-top: 5px;
    }

    /* ---------- urgency ---------- */
    .urgency-options {
        display: grid;
        grid-template-columns: repeat(3,1fr);
        gap: 9px;
    }

    .urgency-option {
        position: relative;
        cursor: pointer;
    }

        .urgency-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .urgency-content {
        padding: 12px 8px;
        text-align: center;
        border: 1px solid #d9e5e2;
        border-radius: 12px;
        background: #fff;
    }

        .urgency-content strong {
            display: block;
            color: #455f59;
            font-size: 11px;
        }

        .urgency-content span {
            display: block;
            margin-top: 3px;
            color: #899894;
            font-size: 9px;
        }

    .urgency-option input:checked + .urgency-content {
        border-color: #0d6b63;
        background: #eaf7f5;
    }

        .urgency-option input:checked + .urgency-content strong {
            color: #0d6b63;
        }

    /* ---------- tests grouped by category ---------- */
    .test-group {
        margin-bottom: 22px;
    }

        .test-group:last-child {
            margin-bottom: 0;
        }

    .test-group-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #0d6b63;
        font-size: 12px;
        font-weight: 750;
        margin-bottom: 10px;
        padding-bottom: 7px;
        border-bottom: 2px solid #eaf6f4;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .test-option {
        position: relative;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px 15px;
        border: 1px solid #dce8e6;
        border-radius: 14px;
        background: #fff;
        cursor: pointer;
        margin-bottom: 8px;
        transition: all .2s ease;
    }

        .test-option:hover {
            border-color: #1a8c82;
            background: #f7fcfb;
        }

        .test-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .test-check {
        width: 24px;
        height: 24px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #cbdad7;
        border-radius: 7px;
        color: transparent;
        flex-shrink: 0;
    }

    .test-option input:checked ~ .test-check {
        background: #0d6b63;
        border-color: #0d6b63;
        color: #fff;
    }

    .test-option:has(input:checked) {
        border-color: #0d6b63;
        background: #eef9f7;
    }

    .test-option-content {
        flex: 1;
        min-width: 0;
    }

    .test-option-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .test-name {
        color: #294b45;
        font-size: 13px;
        font-weight: 750;
    }

    .test-category {
        padding: 5px 9px;
        border-radius: 20px;
        background: #edf5f3;
        color: #52716b;
        font-size: 9px;
        font-weight: 750;
    }

    .test-option-details {
        display: flex;
        gap: 18px;
        margin-top: 7px;
        color: #80928e;
        font-size: 10px;
    }

        .test-option-details i {
            color: #1a8c82;
            margin-right: 3px;
        }

    /* ---------- barcode list ---------- */
    .barcode-list {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .barcode-row {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 14px;
        align-items: center;
        padding: 13px 15px;
        border: 1px solid #dce8e6;
        border-radius: 14px;
        background: #fbfdfc;
    }

        .barcode-row .barcode-test-name {
            color: #173c38;
            font-size: 12px;
            font-weight: 750;
        }

        .barcode-row .barcode-test-sample {
            color: #7d8e8a;
            font-size: 10px;
            margin-top: 3px;
        }

    .barcode-input-wrapper {
        position: relative;
    }

        .barcode-input-wrapper i {
            position: absolute;
            left: 12px;
            top: 50%;
            transform: translateY(-50%);
            color: #78918b;
            font-size: 12px;
        }

    .barcode-input {
        width: 100%;
        box-sizing: border-box;
        padding: 11px 13px 11px 36px;
        border: 1px solid #d3e2df;
        border-radius: 11px;
        background: #fff;
        color: #294943;
        font-size: 12px;
    }

        .barcode-input:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 3px rgba(26,140,130,.09);
            outline: none;
        }

    .barcode-empty {
        color: #9aa9a5;
        font-size: 11px;
        text-align: center;
        padding: 20px;
        border: 1px dashed #d6e3e0;
        border-radius: 12px;
        background: #fafdfc;
    }

    /* ---------- client errors ---------- */
    .client-error {
        display: none;
        align-items: center;
        gap: 8px;
        padding: 11px 13px;
        margin-bottom: 14px;
        border: 1px solid #edcccc;
        border-radius: 11px;
        background: #fff3f3;
        color: #984848;
        font-size: 11px;
    }

        .client-error.show {
            display: flex;
        }

    /* ---------- actions ---------- */
    .tr-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 3px;
    }

    .tr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 19px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
        text-decoration: none;
    }

    .tr-btn-secondary {
        border: 1px solid #d6e3e0;
        background: #fff;
        color: #526963;
    }

        .tr-btn-secondary:hover {
            background: #f5faf9;
            color: #0d6b63;
        }

    .tr-btn-primary {
        border: none;
        background: linear-gradient(135deg,#0d6b63,#1a8c82);
        color: #fff;
    }

        .tr-btn-primary:hover {
            opacity: .92;
        }

        .tr-btn-primary:disabled {
            opacity: .6;
            cursor: not-allowed;
        }

    /* ---------- sidebar ---------- */
    .tr-side-card {
        background: #fff;
        border: 1px solid #e0ebe8;
        border-radius: 18px;
        padding: 18px;
    }

    .tr-side-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        color: #294b45;
        font-size: 12px;
        font-weight: 750;
    }

        .tr-side-title i {
            color: #0d6b63;
        }

    .selected-test-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 250px;
        overflow-y: auto;
    }

    .selected-test-item {
        padding: 9px;
        border-radius: 10px;
        background: #f5faf9;
        color: #4b6862;
        font-size: 10px;
    }

    .empty-selected-tests {
        padding: 14px;
        border: 1px dashed #d8e4e1;
        border-radius: 10px;
        color: #9aa9a5;
        text-align: center;
        font-size: 10px;
    }

    .sample-needed-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .sample-pill {
        padding: 6px 9px;
        border-radius: 20px;
        background: #eaf6f4;
        color: #0d6b63;
        font-size: 9px;
        font-weight: 750;
    }

    .empty-sample-pill {
        color: #9aa9a5;
        font-size: 10px;
    }

    /* ---------- confirmation modal ---------- */
    .confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(17,43,39,.58);
        backdrop-filter: blur(4px);
    }

        .confirm-overlay.show {
            display: flex;
        }

    .confirm-modal {
        width: 100%;
        max-width: 480px;
        padding: 27px;
        border-radius: 21px;
        background: #fff;
        box-shadow: 0 25px 70px rgba(0,0,0,.20);
    }

    .confirm-icon {
        width: 53px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        border-radius: 16px;
        background: #e8f5f3;
        color: #0d6b63;
    }

    .confirm-modal h3 {
        margin: 0;
        color: #173c38;
        font-size: 18px;
        font-weight: 750;
    }

    .confirm-modal p {
        margin: 8px 0 18px;
        color: #758681;
        font-size: 11px;
        line-height: 1.6;
    }

    .confirm-summary {
        padding: 13px;
        border: 1px solid #e0ebe8;
        border-radius: 12px;
        background: #f7faf9;
        margin-bottom: 18px;
    }

    .confirm-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 6px 0;
        font-size: 11px;
    }

        .confirm-summary-row span:first-child {
            color: #82928e;
        }

        .confirm-summary-row span:last-child {
            color: #31534d;
            font-weight: 750;
            text-align: right;
        }

    .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }

    @@media (max-width: 1100px) {
        .tr-layout {
            grid-template-columns: 1fr;
        }

        .tr-sidebar {
            position: static;
            display: grid;
            grid-template-columns: repeat(3,minmax(0,1fr));
        }
    }

    @@media (max-width: 820px) {
        .test-request-page {
            padding: 20px 15px 40px;
        }

        .tr-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .tr-form-grid {
            grid-template-columns: 1fr;
        }

        .tr-form-group.full-width {
            grid-column: auto;
        }

        .tr-sidebar {
            grid-template-columns: repeat(2,minmax(0,1fr));
        }

        .clinical-snap {
            grid-template-columns: 1fr;
        }

        .barcode-row {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 600px) {
        .tr-card {
            padding: 18px;
        }

        .tr-sidebar {
            grid-template-columns: 1fr;
        }

        .patient-banner {
            grid-template-columns: auto 1fr;
        }

        .patient-badge {
            grid-column: 1 / -1;
            width: fit-content;
        }

        .patient-details {
            grid-template-columns: 1fr;
        }

        .urgency-options {
            grid-template-columns: 1fr;
        }

        .tr-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .tr-btn {
            width: 100%;
        }

        .confirm-actions {
            flex-direction: column-reverse;
        }

            .confirm-actions .tr-btn {
                width: 100%;
            }
    }
</style>


<div class="test-request-page">

    <!-- HEADER -->
    <div class="tr-page-header">
        <div class="tr-header-left">
            <div class="tr-header-icon"><i class="fas fa-file-medical"></i></div>
            <div>
                <h1>New Test Request</h1>
                <p>Create and submit a laboratory test request for the selected patient.</p>
            </div>
        </div>

        <a asp-controller="Doctor" asp-action="ManagePatients" class="tr-back-btn">
            <i class="fas fa-arrow-left"></i> Back to Patients
        </a>
    </div>

    <form asp-controller="TestRequest" asp-action="Create" method="post" id="testRequestForm">
        @Html.AntiForgeryToken()
        <input type="hidden" name="patientId" value="@patientId" />

        <div class="tr-layout">

            <main class="tr-main">

                <!-- PATIENT + CLINICAL SNAPSHOT -->
                <div class="tr-card">

                    <div class="tr-card-header">
                        <div class="tr-card-icon"><i class="fas fa-user-injured"></i></div>
                        <div>
                            <h3>Patient Information</h3>
                            <p>Patient details, allergies, conditions and medications.</p>
                        </div>
                    </div>

                    <div class="patient-banner">
                        <div class="patient-avatar"><i class="fas fa-user"></i></div>
                        <div>
                            <div class="patient-main-name">@patientName</div>
                            <div class="patient-main-id">ID Number: @patientIDNumber</div>
                        </div>
                        <div class="patient-badge">
                            <i class="fas fa-check-circle"></i> Patient Selected
                        </div>
                    </div>

                    <div class="patient-details">
                        <div class="patient-detail">
                            <span class="patient-detail-label">Date of Birth</span>
                            <span class="patient-detail-value">@patientDOB</span>
                        </div>
                        <div class="patient-detail">
                            <span class="patient-detail-label">Email</span>
                            <span class="patient-detail-value">@patientEmail</span>
                        </div>
                        <div class="patient-detail">
                            <span class="patient-detail-label">Cellphone</span>
                            <span class="patient-detail-value">@patientCell</span>
                        </div>
                        <div class="patient-detail">
                            <span class="patient-detail-label">Patient ID</span>
                            <span class="patient-detail-value">#@patientId</span>
                        </div>
                    </div>

                    <!-- Clinical snapshot -->
                    <div class="clinical-snap">

                        <div class="clinical-box">
                            <h4>Allergies</h4>
                            @if (allergies != null && allergies.Cast<object>().Any())
                            {
                                <ul>
                                    @foreach (dynamic a in allergies)
                                    {
                                        <li>
                                            @a.Name
                                            <span>@a.Category @(string.IsNullOrEmpty((string)a.Severity) ? "" : "· " + a.Severity)</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="clinical-empty">None recorded</div>
                            }
                        </div>

                        <div class="clinical-box">
                            <h4>Medical Conditions</h4>
                            @if (conditions != null && conditions.Cast<object>().Any())
                            {
                                <ul>
                                    @foreach (dynamic c in conditions)
                                    {
                                        <li>
                                            @c.Name
                                            <span>@c.Category @(string.IsNullOrEmpty((string)c.Severity) ? "" : "· " + c.Severity)</span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="clinical-empty">None recorded</div>
                            }
                        </div>

                        <div class="clinical-box">
                            <h4>Medications</h4>
                            @if (medications != null && medications.Cast<object>().Any())
                            {
                                <ul>
                                    @foreach (dynamic m in medications)
                                    {
                                        <li>
                                            @m.Name
                                            <span>
                                                @m.Category
                                                @(string.IsNullOrEmpty((string)m.Dosage) ? "" : "· " + m.Dosage)
                                                @(string.IsNullOrEmpty((string)m.Frequency) ? "" : "· " + m.Frequency)
                                            </span>
                                        </li>
                                    }
                                </ul>
                            }
                            else
                            {
                                <div class="clinical-empty">None recorded</div>
                            }
                        </div>

                    </div>

                    <!-- Previous results -->
                    <div class="prev-results">
                        <h4>
                            <i class="fas fa-clock-rotate-left"></i>
                            Previous Test Results
                        </h4>

                        @if (prevResults != null && prevResults.Cast<object>().Any())
                        {
                            <table class="prev-table">
                                <thead>
                                    <tr>
                                        <th>Date</th>
                                        <th>Test</th>
                                        <th>Result</th>
                                        <th>Status</th>
                                    </tr>
                                </thead>
                                <tbody>
                                    @foreach (dynamic r in prevResults)
                                    {
                                        DateTime capturedDate = (DateTime)r.DateCaptured;
                                        string? units = (string?)r.Units;
                                        bool abnormal = (bool)r.IsAbnormal;

                                        <tr class="@(abnormal ? "abn" : "")">
                                            <td>@capturedDate.ToString("dd MMM yyyy")</td>
                                            <td>@r.TestName</td>
                                            <td>
                                                @r.ResultValue
                                                @if (!string.IsNullOrWhiteSpace(units))
                                                {
                                                    <text>@units</text>
                                                }
                                            </td>
                                            <td>@(abnormal ? "Abnormal" : "Normal")</td>
                                        </tr>
                                    }
                                </tbody>
                            </table>
                        }
                        else
                        {
                            <div class="clinical-empty">No previous results for this patient.</div>
                        }
                    </div>

                </div>

                <!-- REQUEST DETAILS -->
                <div class="tr-card">

                    <div class="tr-card-header">
                        <div class="tr-card-icon"><i class="fas fa-clipboard-list"></i></div>
                        <div>
                            <h3>Request Details</h3>
                            <p>Request date is recorded automatically to today.</p>
                        </div>
                    </div>

                    <div class="tr-form-grid">

                        <div class="tr-form-group">
                            <label class="tr-label">Request Date</label>

                            <input type="text"
                                   class="tr-input"
                                   value="@requestDate.ToString("dd MMM yyyy")"
                                   readonly />

                            <div class="tr-help">
                                Request date is set automatically to today.
                            </div>
                        </div>

                        <div class="tr-form-group">
                            <label class="tr-label">
                                Urgency <span class="tr-required">*</span>
                            </label>
                            <div class="urgency-options">
                                <label class="urgency-option">
                                    <input type="radio" name="urgency" value="Routine" checked />
                                    <div class="urgency-content">
                                        <strong>Routine</strong>
                                        <span>Standard processing</span>
                                    </div>
                                </label>
                                <label class="urgency-option">
                                    <input type="radio" name="urgency" value="Urgent" />
                                    <div class="urgency-content">
                                        <strong>Urgent</strong>
                                        <span>Priority processing</span>
                                    </div>
                                </label>
                                <label class="urgency-option">
                                    <input type="radio" name="urgency" value="STAT" />
                                    <div class="urgency-content">
                                        <strong>STAT</strong>
                                        <span>Immediate priority</span>
                                    </div>
                                </label>
                            </div>
                        </div>

                        <div class="tr-form-group full-width">
                            <label class="tr-label" for="clinicalNotes">Clinical Notes</label>
                            <textarea id="clinicalNotes"
                                      name="clinicalNotes"
                                      class="tr-textarea"
                                      placeholder="Enter relevant symptoms, diagnosis, clinical findings or other information that may assist the laboratory..."></textarea>
                        </div>

                    </div>

                </div>

                <!-- TESTS GROUPED BY CATEGORY -->
                <div class="tr-card">

                    <div class="tr-card-header">
                        <div class="tr-card-icon"><i class="fas fa-flask"></i></div>
                        <div>
                            <h3>Laboratory Tests</h3>
                            <p>Select the tests that need to be performed. Grouped by category.</p>
                        </div>
                    </div>

                    <div class="client-error" id="testSelectionError">
                        <i class="fas fa-exclamation-circle"></i>
                        <span>Please select at least one laboratory test.</span>
                    </div>

                    @if (testTypes.Any())
                    {
                        foreach (var group in groupedTests)
                        {
                            <div class="test-group">

                                <div class="test-group-title">
                                    <i class="fas fa-folder"></i>
                                    @group.Key
                                </div>

                                @foreach (var test in group.OrderBy(t => t.Name))
                                {
                                    <label class="test-option">
                                        <input type="checkbox"
                                               name="selectedTestTypeIds"
                                               value="@test.Id"
                                               class="test-checkbox"
                                               data-test-name="@test.Name"
                                               data-sample="@test.RequiredSampleType"
                                               data-turnaround="@test.TurnaroundTimeMinutes" />

                                        <div class="test-check"><i class="fas fa-check"></i></div>

                                        <div class="test-option-content">
                                            <div class="test-option-top">
                                                <span class="test-name">@test.Name</span>
                                                <span class="test-category">@test.Category</span>
                                            </div>
                                            <div class="test-option-details">
                                                <span><i class="fas fa-vial"></i> @test.RequiredSampleType</span>
                                                <span><i class="fas fa-clock"></i> @test.TurnaroundTimeMinutes min</span>
                                            </div>
                                        </div>
                                    </label>
                                }

                            </div>
                        }
                    }
                    else
                    {
                        <div class="barcode-empty">
                            <i class="fas fa-exclamation-triangle"></i>
                            <span>No laboratory tests are currently available in the system.</span>
                        </div>
                    }

                </div>

                <!-- BARCODES — one per selected test -->
                <div class="tr-card">

                    <div class="tr-card-header">
                        <div class="tr-card-icon"><i class="fas fa-barcode"></i></div>
                        <div>
                            <h3>Sample Barcodes</h3>
                            <p>Each selected test has its own unique barcode.</p>
                        </div>
                    </div>

                    <div class="client-error" id="barcodeError">
                        <i class="fas fa-exclamation-circle"></i>
                        <span id="barcodeErrorText">Please enter a barcode for every selected test.</span>
                    </div>

                    <div id="barcodeList" class="barcode-list">
                        <div class="barcode-empty" id="barcodeEmptyMsg">
                            <i class="fas fa-barcode"></i>
                            <div style="margin-top:8px;">Select a test above to add its barcode.</div>
                        </div>
                    </div>

                </div>

                <!-- ACTIONS -->
                <div class="tr-actions">
                    <a asp-controller="Doctor"
                       asp-action="ManagePatients"
                       class="tr-btn tr-btn-secondary">
                        <i class="fas fa-times"></i> Cancel
                    </a>

                    <button type="submit"
                            class="tr-btn tr-btn-primary"
                            id="submitRequestBtn">
                        <i class="fas fa-paper-plane"></i> Submit Test Request
                    </button>
                </div>

            </main>

            <!-- SIDEBAR -->
            <aside class="tr-sidebar">

                <div class="tr-side-card">
                    <div class="tr-side-title">
                        <i class="fas fa-list-check"></i> Selected Tests
                    </div>
                    <div id="selectedTestList" class="selected-test-list">
                        <div class="empty-selected-tests">No tests selected yet.</div>
                    </div>
                </div>

                <div class="tr-side-card">
                    <div class="tr-side-title">
                        <i class="fas fa-vial"></i> Samples Required
                    </div>
                    <div id="samplesNeededBox" class="sample-needed-list">
                        <span class="empty-sample-pill">Select tests first.</span>
                    </div>
                </div>

                <div class="tr-side-card">
                    <div class="tr-side-title">
                        <i class="fas fa-circle-info"></i> Guidelines
                    </div>
                    <div style="font-size:11px;color:#7d8e8a;line-height:1.6;">
                        <p style="margin:0 0 6px;">
                            <i class="fas fa-check" style="color:#0d6b63;"></i>
                            Select one or more laboratory tests.
                        </p>
                        <p style="margin:0 0 6px;">
                            <i class="fas fa-barcode" style="color:#0d6b63;"></i>
                            Each test needs a unique barcode.
                        </p>
                        <p style="margin:0;">
                            <i class="fas fa-paper-plane" style="color:#0d6b63;"></i>
                            Patient is notified by email on submit.
                        </p>
                    </div>
                </div>

            </aside>

        </div>

    </form>

</div>

<!-- CONFIRMATION MODAL -->
<div class="confirm-overlay" id="confirmOverlay">
    <div class="confirm-modal">

        <div class="confirm-icon"><i class="fas fa-paper-plane"></i></div>

        <h3>Confirm Test Request</h3>

        <p>Please review the request information before submitting it to the laboratory.</p>

        <div class="confirm-summary">

            <div class="confirm-summary-row">
                <span>Patient</span>
                <span>@patientName</span>
            </div>

            <div class="confirm-summary-row">
                <span>Tests</span>
                <span id="confirmTests">0 tests</span>
            </div>

            <div class="confirm-summary-row">
                <span>Barcodes</span>
                <span id="confirmBarcodes">0</span>
            </div>

            <div class="confirm-summary-row">
                <span>Urgency</span>
                <span id="confirmUrgency">Routine</span>
            </div>

        </div>

        <div class="confirm-actions">
            <button type="button" class="tr-btn tr-btn-secondary" id="cancelConfirm">
                <i class="fas fa-arrow-left"></i> Review
            </button>
            <button type="button" class="tr-btn tr-btn-primary" id="confirmSubmit">
                <i class="fas fa-paper-plane"></i> Confirm & Submit
            </button>
        </div>

    </div>
</div>


@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form = document.getElementById("testRequestForm");
            const checkboxes = document.querySelectorAll(".test-checkbox");
            const selectedTestList = document.getElementById("selectedTestList");
            const samplesNeededBox = document.getElementById("samplesNeededBox");
            const barcodeList = document.getElementById("barcodeList");
            const barcodeEmptyMsg = document.getElementById("barcodeEmptyMsg");
            const testSelectionError = document.getElementById("testSelectionError");
            const barcodeError = document.getElementById("barcodeError");
            const barcodeErrorText = document.getElementById("barcodeErrorText");
            const confirmOverlay = document.getElementById("confirmOverlay");
            const cancelConfirm = document.getElementById("cancelConfirm");
            const confirmSubmit = document.getElementById("confirmSubmit");
            const confirmTests = document.getElementById("confirmTests");
            const confirmBarcodes = document.getElementById("confirmBarcodes");
            const confirmUrgency = document.getElementById("confirmUrgency");
            const submitRequestBtn = document.getElementById("submitRequestBtn");

            function escapeHtml(value) {
                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");
            }

            function getSelectedTests() {
                return Array.from(document.querySelectorAll(".test-checkbox:checked"));
            }

            // Preserve barcodes when the checkbox set changes.
            function readExistingBarcodes() {
                const map = {};
                barcodeList.querySelectorAll(".barcode-row").forEach(function (row) {
                    const testId = row.dataset.testId;
                    const input = row.querySelector(".barcode-input");
                    if (testId && input) { map[testId] = input.value; }
                });
                return map;
            }

            function renderBarcodeInputs() {
                const selected = getSelectedTests();
                const existing = readExistingBarcodes();

                if (selected.length === 0) {
                    barcodeList.innerHTML = `
                        <div class="barcode-empty" id="barcodeEmptyMsg">
                            <i class="fas fa-barcode"></i>
                            <div style="margin-top:8px;">Select a test above to add its barcode.</div>
                        </div>
                    `;
                    return;
                }

                barcodeList.innerHTML = selected.map(function (cb) {
                    const testId = cb.value;
                    const testName = cb.dataset.testName || "Test";
                    const sampleType = cb.dataset.sample || "";
                    const prevValue = existing[testId] || "";

                    return `
                        <div class="barcode-row" data-test-id="${escapeHtml(testId)}">
                            <div>
                                <div class="barcode-test-name">${escapeHtml(testName)}</div>
                                <div class="barcode-test-sample">
                                    ${sampleType ? "Sample: " + escapeHtml(sampleType) : ""}
                                </div>
                            </div>
                            <div class="barcode-input-wrapper">
                                <i class="fas fa-barcode"></i>
                                <input type="text"
                                       name="barcodes"
                                       class="barcode-input"
                                       value="${escapeHtml(prevValue)}"
                                       placeholder="Enter barcode for this test"
                                       maxlength="100"
                                       autocomplete="off" />
                            </div>
                        </div>
                    `;
                }).join("");
            }

            function updateSidebar() {
                const selected = getSelectedTests();

                if (selected.length === 0) {
                    selectedTestList.innerHTML = `
                        <div class="empty-selected-tests">No tests selected yet.</div>
                    `;
                    samplesNeededBox.innerHTML = `
                        <span class="empty-sample-pill">Select tests first.</span>
                    `;
                    return;
                }

                selectedTestList.innerHTML = selected.map(function (cb) {
                    const name = cb.dataset.testName || "Laboratory Test";
                    return `
                        <div class="selected-test-item">
                            <i class="fas fa-check-circle"></i>
                            ${escapeHtml(name)}
                        </div>
                    `;
                }).join("");

                const sampleSet = new Set();
                selected.forEach(function (cb) {
                    const s = (cb.dataset.sample || "").trim();
                    if (s) sampleSet.add(s);
                });

                if (sampleSet.size === 0) {
                    samplesNeededBox.innerHTML = `
                        <span class="empty-sample-pill">No samples required.</span>
                    `;
                } else {
                    samplesNeededBox.innerHTML = Array.from(sampleSet)
                        .sort()
                        .map(function (s) {
                            return `
                                <span class="sample-pill">
                                    <i class="fas fa-vial"></i> ${escapeHtml(s)}
                                </span>
                            `;
                        }).join("");
                }
            }

            function updatePage() {
                updateSidebar();
                renderBarcodeInputs();
                testSelectionError.classList.remove("show");
                barcodeError.classList.remove("show");
            }

            checkboxes.forEach(function (cb) {
                cb.addEventListener("change", updatePage);
            });

            function validateTests() {
                if (getSelectedTests().length === 0) {
                    testSelectionError.classList.add("show");
                    testSelectionError.scrollIntoView({ behavior: "smooth", block: "center" });
                    return false;
                }
                return true;
            }

            function validateBarcodes() {
                const rows = barcodeList.querySelectorAll(".barcode-row");
                if (rows.length === 0) {
                    barcodeErrorText.textContent =
                        "Please select at least one test before adding barcodes.";
                    barcodeError.classList.add("show");
                    return false;
                }

                const values = [];
                let firstEmpty = null;

                rows.forEach(function (row) {
                    const input = row.querySelector(".barcode-input");
                    const v = (input.value || "").trim();
                    if (!v) {
                        if (!firstEmpty) firstEmpty = input;
                    } else {
                        values.push(v.toLowerCase());
                    }
                });

                if (firstEmpty) {
                    barcodeErrorText.textContent =
                        "Each selected test needs its own barcode.";
                    barcodeError.classList.add("show");
                    firstEmpty.focus();
                    return false;
                }

                if (new Set(values).size !== values.length) {
                    barcodeErrorText.textContent =
                        "Each barcode must be unique.";
                    barcodeError.classList.add("show");
                    return false;
                }

                return true;
            }

            form.addEventListener("submit", function (event) {
                event.preventDefault();

                if (!validateTests()) return;

                if (!validateBarcodes()) {
                    barcodeError.scrollIntoView({ behavior: "smooth", block: "center" });
                    return;
                }

                const selected = getSelectedTests();
                const barcodeRows = barcodeList.querySelectorAll(".barcode-row");

                confirmTests.textContent = selected.length +
                    (selected.length === 1 ? " test" : " tests");

                confirmBarcodes.textContent = barcodeRows.length;

                const urgency = document.querySelector('input[name="urgency"]:checked');
                confirmUrgency.textContent = urgency ? urgency.value : "Routine";

                confirmOverlay.classList.add("show");
            });

            cancelConfirm.addEventListener("click", function () {
                confirmOverlay.classList.remove("show");
            });

            confirmSubmit.addEventListener("click", function () {
                confirmSubmit.disabled = true;
                confirmSubmit.innerHTML = '<i class="fas fa-spinner fa-spin"></i> Submitting...';
                submitRequestBtn.disabled = true;
                HTMLFormElement.prototype.submit.call(form);
            });

            confirmOverlay.addEventListener("click", function (e) {
                if (e.target === confirmOverlay) {
                    confirmOverlay.classList.remove("show");
                }
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape") {
                    confirmOverlay.classList.remove("show");
                }
            });

            // Initial render
            updatePage();
        });

    </script>
}