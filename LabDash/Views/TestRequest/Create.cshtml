@using LabDash.Models

@{
    ViewData["Title"] = "New Test Request";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var testTypes = ViewBag.TestTypes as IEnumerable<TestType>
                    ?? Enumerable.Empty<TestType>();

    int patientId = ViewBag.PatientId ?? 0;

    string patientName =
        ViewBag.PatientName ?? "Unknown Patient";

    string patientIDNumber =
        ViewBag.PatientIDNumber ?? "Not available";

    string patientDOB =
        ViewBag.PatientDOB ?? "Not available";
}

<style>

    /* ============================================================
           NMB LAB - NEW TEST REQUEST
        ============================================================ */

    .test-request-page {
        max-width: 1450px;
        margin: 0 auto;
        padding: 28px 30px 50px;
        color: #294943;
    }


    /* ============================================================
           PAGE HEADER
        ============================================================ */

    .tr-page-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
        margin-bottom: 25px;
    }

    .tr-header-left {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .tr-header-icon {
        width: 56px;
        height: 56px;
        border-radius: 17px;
        display: flex;
        align-items: center;
        justify-content: center;
        background: linear-gradient( 135deg, #0d6b63, #1a8c82 );
        color: #fff;
        font-size: 22px;
        box-shadow: 0 8px 20px rgba(13, 107, 99, .18);
    }

    .tr-page-header h1 {
        margin: 0;
        color: #173c38;
        font-size: 25px;
        font-weight: 750;
        letter-spacing: -.3px;
    }

    .tr-page-header p {
        margin: 5px 0 0;
        color: #788b87;
        font-size: 13px;
    }


    /* ============================================================
           BACK BUTTON
        ============================================================ */

    .tr-back-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 11px 16px;
        border-radius: 12px;
        border: 1px solid #d8e6e3;
        background: #fff;
        color: #46635d;
        text-decoration: none;
        font-size: 12px;
        font-weight: 700;
        transition: all .2s ease;
    }

        .tr-back-btn:hover {
            color: #0d6b63;
            background: #f3faf8;
            border-color: #bddbd6;
        }


    /* ============================================================
           LAYOUT
        ============================================================ */

    .tr-layout {
        display: grid;
        grid-template-columns: minmax(0, 1fr) 325px;
        gap: 22px;
        align-items: start;
    }

    .tr-main {
        display: flex;
        flex-direction: column;
        gap: 20px;
        min-width: 0;
    }

    .tr-sidebar {
        position: sticky;
        top: 20px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }


    /* ============================================================
           CARDS
        ============================================================ */

    .tr-card {
        background: #fff;
        border: 1px solid #e0ebe8;
        border-radius: 20px;
        padding: 24px;
        box-shadow: 0 5px 22px rgba(31, 78, 72, .055);
    }

    .tr-card-header {
        display: flex;
        align-items: center;
        gap: 13px;
        margin-bottom: 20px;
    }

    .tr-card-icon {
        width: 43px;
        height: 43px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #eaf6f4;
        color: #0d6b63;
        flex-shrink: 0;
    }

    .tr-card-header h3 {
        margin: 0;
        color: #173c38;
        font-size: 16px;
        font-weight: 750;
    }

    .tr-card-header p {
        margin: 4px 0 0;
        color: #7d8e8a;
        font-size: 11px;
    }


    /* ============================================================
           PATIENT
        ============================================================ */

    .patient-banner {
        display: grid;
        grid-template-columns: auto 1fr auto;
        align-items: center;
        gap: 15px;
        padding: 19px;
        border-radius: 17px;
        background: linear-gradient( 135deg, #edf9f7, #f8fcfb );
        border: 1px solid #d7ebe7;
    }

    .patient-avatar {
        width: 52px;
        height: 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        background: linear-gradient( 135deg, #0d6b63, #1a8c82 );
        color: #fff;
        font-size: 19px;
    }

    .patient-main-name {
        color: #173c38;
        font-size: 17px;
        font-weight: 750;
    }

    .patient-main-id {
        margin-top: 4px;
        color: #71847f;
        font-size: 11px;
    }

    .patient-badge {
        padding: 7px 12px;
        border-radius: 30px;
        background: #d9efeb;
        color: #0d6b63;
        font-size: 10px;
        font-weight: 750;
        white-space: nowrap;
    }

    .patient-details {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 12px;
        margin-top: 13px;
    }

    .patient-detail {
        padding: 12px 14px;
        border: 1px solid #e2ecea;
        border-radius: 12px;
        background: #fbfdfc;
    }

    .patient-detail-label {
        display: block;
        margin-bottom: 4px;
        color: #879792;
        font-size: 9px;
        font-weight: 750;
        text-transform: uppercase;
        letter-spacing: .5px;
    }

    .patient-detail-value {
        color: #35534d;
        font-size: 12px;
        font-weight: 650;
    }


    /* ============================================================
           FORM
        ============================================================ */

    .tr-form-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

    .tr-form-group {
        display: flex;
        flex-direction: column;
        gap: 7px;
    }

        .tr-form-group.full-width {
            grid-column: 1 / -1;
        }

    .tr-label {
        color: #34554f;
        font-size: 11px;
        font-weight: 750;
    }

    .tr-required {
        color: #c64d4d;
    }

    .tr-input,
    .tr-textarea {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #d5e3e0;
        border-radius: 12px;
        background: #fff;
        color: #294943;
        font-size: 12px;
        outline: none;
        transition: all .2s ease;
    }

        .tr-input:focus,
        .tr-textarea:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 3px rgba(26, 140, 130, .09);
        }

    .tr-textarea {
        min-height: 115px;
        resize: vertical;
        line-height: 1.6;
    }

        .tr-input::placeholder,
        .tr-textarea::placeholder {
            color: #a4b1ae;
        }


    /* ============================================================
           URGENCY
        ============================================================ */

    .urgency-options {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 9px;
    }

    .urgency-option {
        position: relative;
        cursor: pointer;
    }

        .urgency-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .urgency-content {
        padding: 12px 8px;
        text-align: center;
        border: 1px solid #d9e5e2;
        border-radius: 12px;
        background: #fff;
        transition: all .2s ease;
    }

        .urgency-content strong {
            display: block;
            color: #455f59;
            font-size: 11px;
        }

        .urgency-content span {
            display: block;
            margin-top: 3px;
            color: #899894;
            font-size: 9px;
        }

    .urgency-option:hover .urgency-content {
        border-color: #1a8c82;
        background: #f4fbfa;
    }

    .urgency-option input:checked + .urgency-content {
        border-color: #0d6b63;
        background: #eaf7f5;
        box-shadow: 0 4px 12px rgba(13, 107, 99, .08);
    }

        .urgency-option input:checked + .urgency-content strong {
            color: #0d6b63;
        }


    /* ============================================================
           TEST SELECTION
        ============================================================ */

    .test-selection-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .test-option {
        position: relative;
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 15px;
        border: 1px solid #dce8e6;
        border-radius: 15px;
        background: #fff;
        cursor: pointer;
        transition: all .2s ease;
    }

        .test-option:hover {
            border-color: #1a8c82;
            background: #f7fcfb;
            transform: translateY(-1px);
        }

        .test-option input {
            position: absolute;
            opacity: 0;
            pointer-events: none;
        }

    .test-check {
        width: 25px;
        height: 25px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 2px solid #cbdad7;
        border-radius: 7px;
        color: transparent;
        flex-shrink: 0;
        transition: all .2s ease;
    }

        .test-check i {
            font-size: 11px;
        }

    .test-option input:checked ~ .test-check {
        background: #0d6b63;
        border-color: #0d6b63;
        color: #fff;
    }

    .test-option:has(input:checked) {
        border-color: #0d6b63;
        background: #eef9f7;
        box-shadow: 0 5px 15px rgba(13, 107, 99, .07);
    }

    .test-option-content {
        flex: 1;
        min-width: 0;
    }

    .test-option-top {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
    }

    .test-name {
        color: #294b45;
        font-size: 13px;
        font-weight: 750;
    }

    .test-category {
        padding: 5px 9px;
        border-radius: 20px;
        background: #edf5f3;
        color: #52716b;
        font-size: 9px;
        font-weight: 750;
        white-space: nowrap;
    }

    .test-option-details {
        display: flex;
        gap: 18px;
        margin-top: 7px;
        color: #80928e;
        font-size: 10px;
    }

        .test-option-details span {
            display: flex;
            align-items: center;
            gap: 5px;
        }

        .test-option-details i {
            color: #1a8c82;
        }


    /* ============================================================
           TEST SUMMARY
        ============================================================ */

    .selected-test-summary {
        display: flex;
        align-items: center;
        gap: 11px;
        margin-top: 17px;
        padding: 13px 15px;
        border: 1px solid #d8ebe7;
        border-radius: 13px;
        background: #f3faf8;
    }

    .selected-summary-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #0d6b63;
        color: #fff;
    }

        .selected-summary-icon i {
            font-size: 12px;
        }

    .selected-test-summary strong {
        display: block;
        color: #21463f;
        font-size: 12px;
    }

    .selected-test-summary span {
        display: block;
        margin-top: 2px;
        color: #83938f;
        font-size: 10px;
    }


    /* ============================================================
           SAMPLE SECTION
        ============================================================ */

    .sample-intro {
        display: flex;
        align-items: flex-start;
        gap: 9px;
        padding: 13px 15px;
        margin-bottom: 15px;
        border: 1px solid #dcece9;
        border-radius: 12px;
        background: #f5faf9;
        color: #637873;
        font-size: 11px;
        line-height: 1.5;
    }

        .sample-intro i {
            margin-top: 2px;
            color: #0d6b63;
        }

    .sample-requirements {
        display: flex;
        flex-direction: column;
        gap: 11px;
    }

    .sample-row {
        display: grid;
        grid-template-columns: 190px minmax(0, 1fr);
        gap: 15px;
        align-items: center;
        padding: 14px;
        border: 1px solid #dce8e6;
        border-radius: 15px;
        background: #fbfdfc;
    }

    .sample-type {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #31534d;
        font-size: 12px;
        font-weight: 750;
    }

    .sample-type-icon {
        width: 35px;
        height: 35px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 10px;
        background: #e8f5f3;
        color: #0d6b63;
    }

        .sample-type-icon i {
            font-size: 13px;
        }

    .barcode-label {
        display: block;
        margin-bottom: 6px;
        color: #81918d;
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .4px;
    }

    .barcode-input-wrapper {
        position: relative;
    }

        .barcode-input-wrapper i {
            position: absolute;
            left: 13px;
            top: 50%;
            transform: translateY(-50%);
            color: #78918b;
            font-size: 13px;
        }

    .barcode-input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 13px 12px 38px;
        border: 1px solid #d3e2df;
        border-radius: 11px;
        background: #fff;
        color: #294943;
        font-size: 12px;
        outline: none;
        transition: all .2s ease;
    }

        .barcode-input:focus {
            border-color: #1a8c82;
            box-shadow: 0 0 0 3px rgba(26, 140, 130, .09);
        }

        .barcode-input::placeholder {
            color: #a3b0ad;
        }

    .no-samples {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 17px;
        border: 1px dashed #d6e3e0;
        border-radius: 13px;
        background: #fafdfc;
        color: #84948f;
        font-size: 11px;
    }

        .no-samples i {
            color: #0d6b63;
            font-size: 17px;
        }


    /* ============================================================
           SIDEBAR
        ============================================================ */

    .tr-side-card {
        background: #fff;
        border: 1px solid #e0ebe8;
        border-radius: 18px;
        padding: 18px;
        box-shadow: 0 5px 18px rgba(31, 78, 72, .045);
    }

    .tr-side-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        color: #294b45;
        font-size: 12px;
        font-weight: 750;
    }

        .tr-side-title i {
            color: #0d6b63;
        }


    /* ============================================================
           SELECTED TESTS
        ============================================================ */

    .selected-test-list {
        display: flex;
        flex-direction: column;
        gap: 7px;
        max-height: 250px;
        overflow-y: auto;
    }

    .selected-test-item {
        display: flex;
        align-items: flex-start;
        gap: 7px;
        padding: 9px;
        border-radius: 10px;
        background: #f5faf9;
        color: #4b6862;
        font-size: 10px;
        line-height: 1.4;
    }

        .selected-test-item i {
            margin-top: 2px;
            color: #0d6b63;
        }

    .empty-selected-tests {
        padding: 14px;
        border: 1px dashed #d8e4e1;
        border-radius: 10px;
        color: #9aa9a5;
        text-align: center;
        font-size: 10px;
    }


    /* ============================================================
           SAMPLE PILLS
        ============================================================ */

    .sample-needed-list {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .sample-pill {
        padding: 6px 9px;
        border-radius: 20px;
        background: #eaf6f4;
        color: #0d6b63;
        font-size: 9px;
        font-weight: 750;
    }

        .sample-pill i {
            margin-right: 4px;
        }

    .empty-sample-pill {
        color: #9aa9a5;
        font-size: 10px;
    }


    /* ============================================================
           TURNAROUND
        ============================================================ */

    .turnaround-box {
        padding: 15px;
        border: 1px solid #e0ebe8;
        border-radius: 13px;
        background: #f8fbfa;
    }

    .turnaround-number {
        color: #0d6b63;
        font-size: 25px;
        font-weight: 800;
    }

    .turnaround-label {
        color: #7b8c88;
        font-size: 9px;
        line-height: 1.4;
    }


    /* ============================================================
           TIPS
        ============================================================ */

    .tip-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .tip {
        display: flex;
        align-items: flex-start;
        gap: 8px;
        color: #71827e;
        font-size: 10px;
        line-height: 1.5;
    }

        .tip i {
            margin-top: 2px;
            color: #1a8c82;
        }


    /* ============================================================
           VALIDATION
        ============================================================ */

    .client-error {
        display: none;
        align-items: center;
        gap: 8px;
        padding: 11px 13px;
        margin-bottom: 14px;
        border: 1px solid #edcccc;
        border-radius: 11px;
        background: #fff3f3;
        color: #984848;
        font-size: 11px;
    }

        .client-error.show {
            display: flex;
        }


    /* ============================================================
           ACTIONS
        ============================================================ */

    .tr-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        padding-top: 3px;
    }

    .tr-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        min-height: 43px;
        padding: 0 19px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 750;
        cursor: pointer;
        text-decoration: none;
        transition: all .2s ease;
    }

    .tr-btn-secondary {
        border: 1px solid #d6e3e0;
        background: #fff;
        color: #526963;
    }

        .tr-btn-secondary:hover {
            background: #f5faf9;
            color: #0d6b63;
        }

    .tr-btn-primary {
        border: none;
        background: linear-gradient( 135deg, #0d6b63, #1a8c82 );
        color: #fff;
        box-shadow: 0 7px 16px rgba(13, 107, 99, .18);
    }

        .tr-btn-primary:hover {
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(13, 107, 99, .23);
        }

        .tr-btn-primary:disabled {
            opacity: .6;
            cursor: not-allowed;
            transform: none;
        }


    /* ============================================================
           CONFIRMATION MODAL
        ============================================================ */

    .confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 9999;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(17, 43, 39, .58);
        backdrop-filter: blur(4px);
    }

        .confirm-overlay.show {
            display: flex;
        }

    .confirm-modal {
        width: 100%;
        max-width: 480px;
        padding: 27px;
        border-radius: 21px;
        background: #fff;
        box-shadow: 0 25px 70px rgba(0, 0, 0, .20);
    }

    .confirm-icon {
        width: 53px;
        height: 53px;
        display: flex;
        align-items: center;
        justify-content: center;
        margin-bottom: 15px;
        border-radius: 16px;
        background: #e8f5f3;
        color: #0d6b63;
    }

        .confirm-icon i {
            font-size: 20px;
        }

    .confirm-modal h3 {
        margin: 0;
        color: #173c38;
        font-size: 18px;
        font-weight: 750;
    }

    .confirm-modal p {
        margin: 8px 0 18px;
        color: #758681;
        font-size: 11px;
        line-height: 1.6;
    }

    .confirm-summary {
        padding: 13px;
        border: 1px solid #e0ebe8;
        border-radius: 12px;
        background: #f7faf9;
        margin-bottom: 18px;
    }

    .confirm-summary-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 6px 0;
        font-size: 11px;
    }

        .confirm-summary-row span:first-child {
            color: #82928e;
        }

        .confirm-summary-row span:last-child {
            color: #31534d;
            font-weight: 750;
            text-align: right;
        }

    .confirm-actions {
        display: flex;
        justify-content: flex-end;
        gap: 9px;
    }


    /* ============================================================
           RESPONSIVE
        ============================================================ */

    media (max-width: 1100px) {

        .tr-layout {
            grid-template-columns: 1fr;
        }

        .tr-sidebar {
            position: static;
            display: grid;
            grid-template-columns: repeat(3, minmax(0, 1fr));
        }
    }


    media (max-width: 820px) {

        .test-request-page {
            padding: 20px 15px 40px;
        }

        .tr-page-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .tr-form-grid {
            grid-template-columns: 1fr;
        }

        .tr-form-group.full-width {
            grid-column: auto;
        }

        .tr-sidebar {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .sample-row {
            grid-template-columns: 1fr;
        }
    }


    media (max-width: 600px) {

        .tr-card {
            padding: 18px;
        }

        .tr-sidebar {
            grid-template-columns: 1fr;
        }

        .patient-banner {
            grid-template-columns: auto 1fr;
        }

        .patient-badge {
            grid-column: 1 / -1;
            width: fit-content;
        }

        .patient-details {
            grid-template-columns: 1fr;
        }

        .urgency-options {
            grid-template-columns: 1fr;
        }

        .test-option-top {
            align-items: flex-start;
            flex-direction: column;
            gap: 6px;
        }

        .test-option-details {
            flex-direction: column;
            gap: 5px;
        }

        .tr-actions {
            flex-direction: column-reverse;
            align-items: stretch;
        }

        .tr-btn {
            width: 100%;
        }

        .confirm-actions {
            flex-direction: column-reverse;
        }

            .confirm-actions .tr-btn {
                width: 100%;
            }
    }

</style>


<div class="test-request-page">

    <!-- ============================================================
         PAGE HEADER
    ============================================================ -->

    <div class="tr-page-header">

        <div class="tr-header-left">

            <div class="tr-header-icon">
                <i class="fas fa-file-medical"></i>
            </div>

            <div>

                <h1>
                    New Test Request
                </h1>

                <p>
                    Create and submit a laboratory test request
                    for the selected patient.
                </p>

            </div>

        </div>


        <a asp-controller="Doctor"
           asp-action="ManagePatients"
           class="tr-back-btn">

            <i class="fas fa-arrow-left"></i>

            Back to Patients

        </a>

    </div>


    <!-- ============================================================
         FORM
    ============================================================ -->

    <form asp-controller="TestRequest"
          asp-action="Create"
          method="post"
          id="testRequestForm">

        @Html.AntiForgeryToken()

        <input type="hidden"
               name="patientId"
               value="@patientId" />


        <div class="tr-layout">


            <!-- ====================================================
                 MAIN
            ===================================================== -->

            <main class="tr-main">


                <!-- =================================================
                     PATIENT INFORMATION
                ================================================== -->

                <div class="tr-card">

                    <div class="tr-card-header">

                        <div class="tr-card-icon">
                            <i class="fas fa-user-injured"></i>
                        </div>

                        <div>

                            <h3>
                                Patient Information
                            </h3>

                            <p>
                                Patient selected for this laboratory
                                request.
                            </p>

                        </div>

                    </div>


                    <div class="patient-banner">

                        <div class="patient-avatar">

                            <i class="fas fa-user"></i>

                        </div>


                        <div>

                            <div class="patient-main-name">
                                @patientName
                            </div>

                            <div class="patient-main-id">
                                ID Number: @patientIDNumber
                            </div>

                        </div>


                        <div class="patient-badge">

                            <i class="fas fa-check-circle"></i>

                            Patient Selected

                        </div>

                    </div>


                    <div class="patient-details">

                        <div class="patient-detail">

                            <span class="patient-detail-label">
                                Patient ID
                            </span>

                            <span class="patient-detail-value">
                                #@patientId
                            </span>

                        </div>


                        <div class="patient-detail">

                            <span class="patient-detail-label">
                                Date of Birth
                            </span>

                            <span class="patient-detail-value">
                                @patientDOB
                            </span>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     REQUEST DETAILS
                ================================================== -->

                <div class="tr-card">

                    <div class="tr-card-header">

                        <div class="tr-card-icon">

                            <i class="fas fa-clipboard-list"></i>

                        </div>

                        <div>

                            <h3>
                                Request Details
                            </h3>

                            <p>
                                Provide the information required
                                for the laboratory request.
                            </p>

                        </div>

                    </div>


                    <div class="tr-form-grid">


                        <!-- Request Date -->

                        <div class="tr-form-group">

                            <label class="tr-label"
                                   for="requestDate">

                                Request Date
                                <span class="tr-required">*</span>

                            </label>

                            <input type="date"
                                   id="requestDate"
                                   name="requestDate"
                                   class="tr-input"
                                   value="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   max="@DateTime.Today.ToString("yyyy-MM-dd")"
                                   required />

                        </div>


                        <!-- Urgency -->

                        <div class="tr-form-group">

                            <label class="tr-label">

                                Urgency
                                <span class="tr-required">*</span>

                            </label>


                            <div class="urgency-options">


                                <label class="urgency-option">

                                    <input type="radio"
                                           name="urgency"
                                           value="Routine"
                                           checked />

                                    <div class="urgency-content">

                                        <strong>
                                            Routine
                                        </strong>

                                        <span>
                                            Standard processing
                                        </span>

                                    </div>

                                </label>


                                <label class="urgency-option">

                                    <input type="radio"
                                           name="urgency"
                                           value="Urgent" />

                                    <div class="urgency-content">

                                        <strong>
                                            Urgent
                                        </strong>

                                        <span>
                                            Priority processing
                                        </span>

                                    </div>

                                </label>


                                <label class="urgency-option">

                                    <input type="radio"
                                           name="urgency"
                                           value="STAT" />

                                    <div class="urgency-content">

                                        <strong>
                                            STAT
                                        </strong>

                                        <span>
                                            Immediate priority
                                        </span>

                                    </div>

                                </label>

                            </div>

                        </div>


                        <!-- Clinical Notes -->

                        <div class="tr-form-group full-width">

                            <label class="tr-label"
                                   for="clinicalNotes">

                                Clinical Notes

                            </label>

                            <textarea id="clinicalNotes"
                                      name="clinicalNotes"
                                      class="tr-textarea"
                                      placeholder="Enter relevant symptoms, diagnosis, clinical findings or other information that may assist the laboratory..."></textarea>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     TEST SELECTION
                ================================================== -->

                <div class="tr-card">

                    <div class="tr-card-header">

                        <div class="tr-card-icon">

                            <i class="fas fa-flask"></i>

                        </div>

                        <div>

                            <h3>
                                Laboratory Tests
                            </h3>

                            <p>
                                Select the tests that need to be
                                performed for this patient.
                            </p>

                        </div>

                    </div>


                    <div class="client-error"
                         id="testSelectionError">

                        <i class="fas fa-exclamation-circle"></i>

                        <span>
                            Please select at least one laboratory test.
                        </span>

                    </div>


                    <div class="test-selection-list">


                        @if (testTypes.Any())
                        {

                            foreach (var test in testTypes)
                            {

                                <label class="test-option">

                                    <input type="checkbox"
                                           name="selectedTestTypeIds"
                                           value="@test.Id"
                                           class="test-checkbox"
                                           data-test-name="@test.Name"
                                           data-sample="@test.RequiredSampleType"
                                           data-turnaround="@test.TurnaroundTimeMinutes" />


                                    <div class="test-check">

                                        <i class="fas fa-check"></i>

                                    </div>


                                    <div class="test-option-content">

                                        <div class="test-option-top">

                                            <span class="test-name">
                                                @test.Name
                                            </span>

                                            <span class="test-category">
                                                @test.Category
                                            </span>

                                        </div>


                                        <div class="test-option-details">

                                            <span>

                                                <i class="fas fa-vial"></i>

                                                @test.RequiredSampleType

                                            </span>


                                            <span>

                                                <i class="fas fa-clock"></i>

                                                @test.TurnaroundTimeMinutes
                                                minutes

                                            </span>

                                        </div>

                                    </div>

                                </label>

                            }

                        }
                        else
                        {

                            <div class="no-samples">

                                <i class="fas fa-exclamation-triangle"></i>

                                <span>
                                    No laboratory tests are currently
                                    available in the system.
                                </span>

                            </div>

                        }

                    </div>


                    <div class="selected-test-summary">

                        <div class="selected-summary-icon">

                            <i class="fas fa-check-double"></i>

                        </div>

                        <div>

                            <strong id="selectedTestCount">
                                0 tests selected
                            </strong>

                            <span>
                                Select at least one test to continue.
                            </span>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     SAMPLES AND BARCODES
                ================================================== -->

                <div class="tr-card">

                    <div class="tr-card-header">

                        <div class="tr-card-icon">

                            <i class="fas fa-vials"></i>

                        </div>

                        <div>

                            <h3>
                                Sample Collection
                            </h3>

                            <p>
                                Record the barcode for every sample
                                required by the selected tests.
                            </p>

                        </div>

                    </div>


                    <div class="sample-intro">

                        <i class="fas fa-info-circle"></i>

                        <span>
                            Sample requirements are generated
                            automatically from the selected laboratory
                            tests. Each required sample must have a
                            unique barcode.
                        </span>

                    </div>


                    <div class="client-error"
                         id="sampleError">

                        <i class="fas fa-exclamation-circle"></i>

                        <span id="sampleErrorText">
                            Please enter all required sample barcodes.
                        </span>

                    </div>


                    <div id="sampleRequirements"
                         class="sample-requirements">

                        <div class="no-samples"
                             id="noSamplesMessage">

                            <i class="fas fa-vial"></i>

                            <span>
                                Select a laboratory test above to
                                display the required sample types.
                            </span>

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     ACTIONS
                ================================================== -->

                <div class="tr-actions">

                    <a asp-controller="Doctor"
                       asp-action="ManagePatients"
                       class="tr-btn tr-btn-secondary">

                        <i class="fas fa-times"></i>

                        Cancel

                    </a>


                    <button type="submit"
                            class="tr-btn tr-btn-primary"
                            id="submitRequestBtn">

                        <i class="fas fa-paper-plane"></i>

                        Submit Test Request

                    </button>

                </div>


            </main>



            <!-- ====================================================
                 SIDEBAR
            ===================================================== -->

            <aside class="tr-sidebar">


                <!-- =================================================
                     SELECTED TESTS
                ================================================== -->

                <div class="tr-side-card">

                    <div class="tr-side-title">

                        <i class="fas fa-list-check"></i>

                        Selected Tests

                    </div>


                    <div id="selectedTestList"
                         class="selected-test-list">

                        <div class="empty-selected-tests">

                            No tests selected yet.

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     SAMPLES NEEDED
                ================================================== -->

                <div class="tr-side-card">

                    <div class="tr-side-title">

                        <i class="fas fa-vial"></i>

                        Samples Required

                    </div>


                    <div id="samplesNeededBox"
                         class="sample-needed-list">

                        <span class="empty-sample-pill">
                            Select tests first.
                        </span>

                    </div>

                </div>



                <!-- =================================================
                     TURNAROUND
                ================================================== -->

                <div class="tr-side-card">

                    <div class="tr-side-title">

                        <i class="fas fa-clock"></i>

                        Estimated Turnaround

                    </div>


                    <div class="turnaround-box">

                        <div id="turnaroundNumber"
                             class="turnaround-number">

                            —

                        </div>

                        <div class="turnaround-label">

                            Maximum estimated turnaround
                            based on selected tests

                        </div>

                    </div>

                </div>



                <!-- =================================================
                     INFORMATION
                ================================================== -->

                <div class="tr-side-card">

                    <div class="tr-side-title">

                        <i class="fas fa-circle-info"></i>

                        Request Guidelines

                    </div>


                    <div class="tip-list">


                        <div class="tip">

                            <i class="fas fa-check"></i>

                            <span>
                                Select one or more laboratory tests.
                            </span>

                        </div>


                        <div class="tip">

                            <i class="fas fa-barcode"></i>

                            <span>
                                Enter a unique barcode for every
                                required sample.
                            </span>

                        </div>


                        <div class="tip">

                            <i class="fas fa-notes-medical"></i>

                            <span>
                                Include relevant clinical information
                                when necessary.
                            </span>

                        </div>


                        <div class="tip">

                            <i class="fas fa-paper-plane"></i>

                            <span>
                                The request will be sent to the
                                laboratory after confirmation.
                            </span>

                        </div>

                    </div>

                </div>

            </aside>

        </div>

    </form>

</div>



<!-- ================================================================
     CONFIRMATION MODAL
================================================================ -->

<div class="confirm-overlay"
     id="confirmOverlay">

    <div class="confirm-modal">

        <div class="confirm-icon">

            <i class="fas fa-paper-plane"></i>

        </div>


        <h3>
            Confirm Test Request
        </h3>


        <p>
            Please review the request information before submitting
            it to the laboratory.
        </p>


        <div class="confirm-summary">

            <div class="confirm-summary-row">

                <span>
                    Patient
                </span>

                <span>
                    @patientName
                </span>

            </div>


            <div class="confirm-summary-row">

                <span>
                    Tests
                </span>

                <span id="confirmTests">
                    0 tests
                </span>

            </div>


            <div class="confirm-summary-row">

                <span>
                    Samples
                </span>

                <span id="confirmSamples">
                    0 samples
                </span>

            </div>


            <div class="confirm-summary-row">

                <span>
                    Urgency
                </span>

                <span id="confirmUrgency">
                    Routine
                </span>

            </div>

        </div>


        <div class="confirm-actions">

            <button type="button"
                    class="tr-btn tr-btn-secondary"
                    id="cancelConfirm">

                <i class="fas fa-arrow-left"></i>

                Review Request

            </button>


            <button type="button"
                    class="tr-btn tr-btn-primary"
                    id="confirmSubmit">

                <i class="fas fa-paper-plane"></i>

                Confirm & Submit

            </button>

        </div>

    </div>

</div>



@section Scripts {

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            /* ============================================================
               ELEMENTS
            ============================================================ */

            const form =
                document.getElementById("testRequestForm");

            const checkboxes =
                document.querySelectorAll(".test-checkbox");

            const selectedTestCount =
                document.getElementById("selectedTestCount");

            const selectedTestList =
                document.getElementById("selectedTestList");

            const samplesNeededBox =
                document.getElementById("samplesNeededBox");

            const sampleRequirements =
                document.getElementById("sampleRequirements");

            const testSelectionError =
                document.getElementById("testSelectionError");

            const sampleError =
                document.getElementById("sampleError");

            const sampleErrorText =
                document.getElementById("sampleErrorText");

            const turnaroundNumber =
                document.getElementById("turnaroundNumber");

            const confirmOverlay =
                document.getElementById("confirmOverlay");

            const cancelConfirm =
                document.getElementById("cancelConfirm");

            const confirmSubmit =
                document.getElementById("confirmSubmit");

            const confirmTests =
                document.getElementById("confirmTests");

            const confirmSamples =
                document.getElementById("confirmSamples");

            const confirmUrgency =
                document.getElementById("confirmUrgency");

            const submitRequestBtn =
                document.getElementById("submitRequestBtn");


            /* ============================================================
               ESCAPE HTML
            ============================================================ */

            function escapeHtml(value) {

                return String(value)
                    .replace(/&/g, "&amp;")
                    .replace(/</g, "&lt;")
                    .replace(/>/g, "&gt;")
                    .replace(/"/g, "&quot;")
                    .replace(/'/g, "&#039;");

            }


            /* ============================================================
               SELECTED TESTS
            ============================================================ */

            function getSelectedTests() {

                return Array.from(
                    document.querySelectorAll(
                        ".test-checkbox:checked"
                    )
                );

            }


            /* ============================================================
               REQUIRED SAMPLES
            ============================================================ */

            function getRequiredSampleTypes() {

                const selectedTests =
                    getSelectedTests();

                const sampleTypes = [];


                selectedTests.forEach(function (checkbox) {

                    const sample =
                        (checkbox.dataset.sample || "").trim();


                    if (sample.length > 0) {

                        const alreadyExists =
                            sampleTypes.some(function (existing) {

                                return existing.toLowerCase() ===
                                       sample.toLowerCase();

                            });


                        if (!alreadyExists) {

                            sampleTypes.push(sample);

                        }

                    }

                });


                return sampleTypes.sort(
                    function (a, b) {

                        return a.localeCompare(b);

                    }
                );

            }


            /* ============================================================
               UPDATE TEST COUNT
            ============================================================ */

            function updateTestCount() {

                const count =
                    getSelectedTests().length;


                if (count === 0) {

                    selectedTestCount.textContent =
                        "0 tests selected";

                }
                else if (count === 1) {

                    selectedTestCount.textContent =
                        "1 test selected";

                }
                else {

                    selectedTestCount.textContent =
                        count + " tests selected";

                }

            }


            /* ============================================================
               UPDATE SELECTED TEST SIDEBAR
            ============================================================ */

            function updateSelectedTestList() {

                const selectedTests =
                    getSelectedTests();


                if (selectedTests.length === 0) {

                    selectedTestList.innerHTML = `
                        <div class="empty-selected-tests">
                            No tests selected yet.
                        </div>
                    `;

                    return;

                }


                selectedTestList.innerHTML =
                    selectedTests.map(function (checkbox) {

                        const name =
                            checkbox.dataset.testName ||
                            "Laboratory Test";


                        return `
                            <div class="selected-test-item">

                                <i class="fas fa-check-circle"></i>

                                <span>
                                    ${escapeHtml(name)}
                                </span>

                            </div>
                        `;

                    }).join("");

            }


            /* ============================================================
               UPDATE SAMPLE SIDEBAR
            ============================================================ */

            function updateSamplesNeeded() {

                const sampleTypes =
                    getRequiredSampleTypes();


                if (sampleTypes.length === 0) {

                    samplesNeededBox.innerHTML = `
                        <span class="empty-sample-pill">
                            Select tests first.
                        </span>
                    `;

                    return;

                }


                samplesNeededBox.innerHTML =
                    sampleTypes.map(function (sample) {

                        return `
                            <span class="sample-pill">

                                <i class="fas fa-vial"></i>

                                ${escapeHtml(sample)}

                            </span>
                        `;

                    }).join("");

            }


            /* ============================================================
               KEEP EXISTING BARCODE VALUES
            ============================================================ */

            function getExistingBarcodes() {

                const values = {};


                const rows =
                    sampleRequirements.querySelectorAll(
                        ".sample-row"
                    );


                rows.forEach(function (row) {

                    const sampleType =
                        row.dataset.sampleType;


                    const input =
                        row.querySelector(
                            ".barcode-input"
                        );


                    if (sampleType && input) {

                        values[
                            sampleType.toLowerCase()
                        ] = input.value;

                    }

                });


                return values;

            }


            /* ============================================================
               CREATE SAMPLE TEXTBOXES
            ============================================================ */

            function renderSampleInputs() {

                const sampleTypes =
                    getRequiredSampleTypes();


                const existingBarcodes =
                    getExistingBarcodes();


                if (sampleTypes.length === 0) {

                    sampleRequirements.innerHTML = `
                        <div class="no-samples">

                            <i class="fas fa-vial"></i>

                            <span>
                                Select a laboratory test above to display
                                the required sample types.
                            </span>

                        </div>
                    `;

                    return;

                }


                sampleRequirements.innerHTML =
                    sampleTypes.map(function (sampleType) {

                        const previousBarcode =
                            existingBarcodes[
                                sampleType.toLowerCase()
                            ] || "";


                        return `
                            <div class="sample-row"
                                 data-sample-type="${escapeHtml(sampleType)}">

                                <div class="sample-type">

                                    <div class="sample-type-icon">

                                        <i class="fas fa-vial"></i>

                                    </div>

                                    <span>
                                        ${escapeHtml(sampleType)}
                                    </span>

                                </div>


                                <div>

                                    <label class="barcode-label">
                                        Sample Barcode
                                    </label>

                                    <div class="barcode-input-wrapper">

                                        <i class="fas fa-barcode"></i>

                                        <input
                                            type="text"
                                            name="sampleBarcodes"
                                            class="barcode-input"
                                            value="${escapeHtml(previousBarcode)}"
                                            placeholder="Enter ${escapeHtml(sampleType)} sample barcode"
                                            maxlength="100"
                                            autocomplete="off"
                                        />

                                        <input
                                            type="hidden"
                                            name="sampleTypes"
                                            value="${escapeHtml(sampleType)}"
                                        />

                                    </div>

                                </div>

                            </div>
                        `;

                    }).join("");

            }


            /* ============================================================
               TURNAROUND
            ============================================================ */

            function updateTurnaround() {

                const selectedTests =
                    getSelectedTests();


                if (selectedTests.length === 0) {

                    turnaroundNumber.textContent = "—";

                    return;

                }


                const turnaroundValues =
                    selectedTests
                        .map(function (checkbox) {

                            return parseInt(
                                checkbox.dataset.turnaround || "0"
                            );

                        })
                        .filter(function (value) {

                            return value > 0;

                        });


                if (turnaroundValues.length === 0) {

                    turnaroundNumber.textContent = "—";

                    return;

                }


                turnaroundNumber.textContent =
                    Math.max(...turnaroundValues);

            }


            /* ============================================================
               UPDATE PAGE
            ============================================================ */

            function updatePage() {

                updateTestCount();

                updateSelectedTestList();

                updateSamplesNeeded();

                updateTurnaround();

                renderSampleInputs();

            }


            /* ============================================================
               TEST CHECKBOX EVENTS
            ============================================================ */

            checkboxes.forEach(function (checkbox) {

                checkbox.addEventListener(
                    "change",
                    function () {

                        testSelectionError.classList.remove(
                            "show"
                        );

                        sampleError.classList.remove(
                            "show"
                        );

                        updatePage();

                    }
                );

            });


            /* ============================================================
               VALIDATE TEST SELECTION
            ============================================================ */

            function validateTests() {

                const selectedTests =
                    getSelectedTests();


                if (selectedTests.length === 0) {

                    testSelectionError.classList.add(
                        "show"
                    );

                    testSelectionError.scrollIntoView({
                        behavior: "smooth",
                        block: "center"
                    });

                    return false;

                }


                testSelectionError.classList.remove(
                    "show"
                );

                return true;

            }


            /* ============================================================
               VALIDATE SAMPLE BARCODES
            ============================================================ */

            function validateSamples() {

                const rows =
                    sampleRequirements.querySelectorAll(
                        ".sample-row"
                    );


                if (rows.length === 0) {

                    sampleErrorText.textContent =
                        "Please select at least one test.";

                    sampleError.classList.add(
                        "show"
                    );

                    return false;

                }


                let valid = true;

                let firstEmptyInput = null;


                rows.forEach(function (row) {

                    const input =
                        row.querySelector(
                            ".barcode-input"
                        );


                    if (!input ||
                        input.value.trim() === "") {

                        valid = false;

                        if (!firstEmptyInput) {

                            firstEmptyInput = input;

                        }

                    }

                });


                if (!valid) {

                    sampleErrorText.textContent =
                        "Please enter a barcode for every required sample.";

                    sampleError.classList.add(
                        "show"
                    );


                    if (firstEmptyInput) {

                        firstEmptyInput.focus();

                    }

                    return false;

                }


                /* ========================================================
                   DUPLICATE BARCODE CHECK
                ======================================================== */

                const barcodeInputs =
                    Array.from(
                        sampleRequirements.querySelectorAll(
                            ".barcode-input"
                        )
                    );


                const barcodes =
                    barcodeInputs.map(function (input) {

                        return input.value
                            .trim()
                            .toLowerCase();

                    });


                const duplicates =
                    barcodes.filter(function (
                        barcode,
                        index
                    ) {

                        return barcodes.indexOf(barcode)
                               !== index;

                    });


                if (duplicates.length > 0) {

                    sampleErrorText.textContent =
                        "Each sample must have a unique barcode.";

                    sampleError.classList.add(
                        "show"
                    );

                    return false;

                }


                sampleError.classList.remove(
                    "show"
                );

                return true;

            }


            /* ============================================================
               FORM SUBMIT
            ============================================================ */

            form.addEventListener(
                "submit",
                function (event) {

                    event.preventDefault();


                    if (!validateTests()) {

                        return;

                    }


                    if (!validateSamples()) {

                        sampleError.scrollIntoView({
                            behavior: "smooth",
                            block: "center"
                        });

                        return;

                    }


                    const selectedTests =
                        getSelectedTests();


                    const sampleRows =
                        sampleRequirements.querySelectorAll(
                            ".sample-row"
                        );


                    confirmTests.textContent =
                        selectedTests.length +
                        (
                            selectedTests.length === 1
                                ? " test"
                                : " tests"
                        );


                    confirmSamples.textContent =
                        sampleRows.length +
                        (
                            sampleRows.length === 1
                                ? " sample"
                                : " samples"
                        );


                    const urgency =
                        document.querySelector(
                            'input[name="urgency"]:checked'
                        );


                    confirmUrgency.textContent =
                        urgency
                            ? urgency.value
                            : "Routine";


                    confirmOverlay.classList.add(
                        "show"
                    );

                }
            );


            /* ============================================================
               CANCEL CONFIRMATION
            ============================================================ */

            cancelConfirm.addEventListener(
                "click",
                function () {

                    confirmOverlay.classList.remove(
                        "show"
                    );

                }
            );


            /* ============================================================
               CONFIRM SUBMIT
            ============================================================ */

            confirmSubmit.addEventListener(
                "click",
                function () {

                    confirmSubmit.disabled = true;

                    confirmSubmit.innerHTML = `
                        <i class="fas fa-spinner fa-spin"></i>
                        Submitting...
                    `;


                    submitRequestBtn.disabled = true;


                    /*
                     * Native submit bypasses the submit event,
                     * preventing the confirmation from appearing again.
                     */

                    HTMLFormElement.prototype.submit.call(form);

                }
            );


            /* ============================================================
               CLOSE MODAL OUTSIDE
            ============================================================ */

            confirmOverlay.addEventListener(
                "click",
                function (event) {

                    if (event.target === confirmOverlay) {

                        confirmOverlay.classList.remove(
                            "show"
                        );

                    }

                }
            );


            /* ============================================================
               ESCAPE KEY
            ============================================================ */

            document.addEventListener(
                "keydown",
                function (event) {

                    if (event.key === "Escape") {

                        confirmOverlay.classList.remove(
                            "show"
                        );

                    }

                }
            );


            /* ============================================================
               INITIAL LOAD
            ============================================================ */

            updatePage();

        });

    </script>

}