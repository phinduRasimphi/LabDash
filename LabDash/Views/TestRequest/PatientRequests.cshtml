@model List<LabDash.Models.TestRequest>

@{
    ViewData["Title"] = "Patient Test Requests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    var firstRequest = Model.FirstOrDefault();
    var patient = firstRequest?.Patient;
}

<style>
    .req-container {
        max-width: 1000px;
        margin: 0 auto;
    }

    .req-document {
        background: white;
        border: 2px solid rgba(0, 0, 0, 0.05);
        border-radius: 16px;
        box-shadow: 0 8px 20px rgba(0, 0, 0, 0.08);
        margin-bottom: 28px;
        overflow: hidden;
    }

    .req-header {
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

        .req-header h3 {
            margin: 0;
            font-size: 18px;
            font-weight: 700;
        }

        .req-header .req-id {
            font-size: 13px;
            background: rgba(255, 255, 255, 0.2);
            padding: 6px 12px;
            border-radius: 12px;
            font-weight: 600;
        }

    .req-body {
        padding: 28px;
    }

    .section-title {
        font-size: 12px;
        font-weight: 700;
        color: #4a5c7c;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        border-bottom: 2px solid #f0f2f5;
        padding-bottom: 10px;
        margin-bottom: 18px;
    }

    .patient-info-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 16px;
        margin-bottom: 24px;
    }

    .info-item label {
        display: block;
        font-size: 11px;
        font-weight: 600;
        color: #7a8da8;
        text-transform: uppercase;
        letter-spacing: 0.4px;
        margin-bottom: 2px;
    }

    .info-item span {
        font-size: 15px;
        font-weight: 500;
        color: #1a2f4e;
    }

    .clinical-notes {
        background: #f8fafd;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 18px;
        margin-bottom: 24px;
    }

        .clinical-notes p {
            margin: 6px 0 0 0;
            font-size: 14px;
            color: #4a5c7c;
            font-style: italic;
        }

    .tests-grid {
        display: grid;
        grid-template-columns: 1fr;
        gap: 12px;
        margin-bottom: 24px;
    }

    .test-row {
        display: flex;
        align-items: center;
        justify-content: space-between;
        border: 1px solid #e2e8f0;
        border-radius: 10px;
        padding: 12px 16px;
    }

        .test-row strong {
            font-size: 14px;
            color: #1a2f4e;
        }

    .sample-type {
        background: #e3f2fd;
        color: #1565c0;
        font-size: 12px;
        font-weight: 600;
        padding: 4px 10px;
        border-radius: 12px;
    }

    .barcodes {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
    }

    .barcode-chip {
        background: #f0f7f6;
        border: 1px solid #cde8e4;
        color: #0d6b63;
        font-family: 'Courier New', monospace;
        font-size: 14px;
        font-weight: 600;
        padding: 6px 12px;
        border-radius: 8px;
    }

    .status-badge {
        display: inline-block;
        padding: 6px 12px;
        border-radius: 16px;
        font-size: 13px;
        font-weight: 700;
    }

        .status-badge.Submitted {
            background: #e3f2fd;
            color: #1565c0;
        }

        .status-badge.SamplesReceived {
            background: #f3e5f5;
            color: #6a1b9a;
        }

        .status-badge.InProgress {
            background: #fff8e1;
            color: #7a5c00;
        }

        .status-badge.Completed {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .status-badge.Releasedbydoctor {
            background: #e0f2f1;
            color: #00695c;
        }

        .status-badge.Cancelled {
            background: #ffebee;
            color: #c62828;
        }

    .req-return {
        margin-top: 24px;
        text-align: center;
    }

        .req-return a {
            background: #f0f2f5;
            color: #4a5c7c;
            border: none;
            border-radius: 8px;
            padding: 12px 20px;
            font-size: 14px;
            font-weight: 600;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 8px;
        }
</style>

<div class="req-container">
    <h1 style="font-size:22px;font-weight:700;color:#1a2f4e;margin-bottom:20px;">Patient Test Requests</h1>

    @if (patient != null)
    {
        <div class="req-header" style="margin-bottom: 24px; border-radius: 16px;">
            <div>
                <h3>@patient.Name @patient.Surname</h3>
                <span style="font-size: 13px;">ID: @patient.IDNumber | Email: @patient.Email</span>
            </div>
        </div>
    }

    @if (!Model.Any())
    {
        <p style="text-align:center; padding: 40px; color:#7a8da8; font-size: 16px;">No test requests found for this patient.</p>
    }
    else
    {
        foreach (var request in Model)
        {
            <div class="req-document">
                <div class="req-header">
                    <h3>Test Request</h3>
                    <span class="req-id">#@request.RequestId</span>
                </div>

                <div class="req-body">
                    <!-- SECTION 1: PATIENT & REQUEST INFO -->
                    <div class="section-title">Patient Information</div>
                    <div class="patient-info-grid">
                        <div class="info-item">
                            <label>Patient ID</label>
                            <span>@request.Patient?.IDNumber</span>
                        </div>
                        <div class="info-item">
                            <label>Date of Birth</label>
                            <span>@request.Patient?.DOB.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="info-item">
                            <label>Request Date</label>
                            <span>@request.RequestDate.ToString("dd MMM yyyy")</span>
                        </div>
                        <div class="info-item">
                            <label>Doctor</label>
                            <span>@request.RequestingDoctor?.FullName</span>
                        </div>
                        <div class="info-item">
                            <label>Urgency</label>
                            <span>@request.Urgency</span>
                        </div>
                        <div class="info-item">
                            <label>Status</label>
                            <span class="status-badge @request.Status.Replace(" ", "")">@request.Status</span>
                        </div>
                    </div>

                    <!-- SECTION 2: CLINICAL NOTES -->
                    <div class="section-title">Clinical Notes</div>
                    <div class="clinical-notes">
                        @if (!string.IsNullOrEmpty(request.ClinicalNotes))
                        {
                            <p>@request.ClinicalNotes</p>
                        }
                        else
                        {
                            <p style="color: #7a8da8; font-style: normal;">N/A</p>
                        }
                    </div>

                    <!-- SECTION 3: TEST TYPES -->
                    <div class="section-title">Selected Laboratory Tests</div>
                    <div class="tests-grid">
                        @if (request.TestRequestItems != null && request.TestRequestItems.Any())
                        {
                            foreach (var item in request.TestRequestItems)
                            {
                                <div class="test-row">
                                    <div>
                                        <strong>@item.TestType?.Name</strong>
                                    </div>
                                    <div>
                                        <span class="sample-type">@item.TestType?.RequiredSampleType</span>
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <p style="color: #7a8da8; font-size: 14px;">No tests selected.</p>
                        }
                    </div>

                    <!-- SECTION 4: SAMPLE INFO & BARCODES -->
                    <div class="section-title">Sample Information & Barcodes</div>
                    <div class="barcodes">
                        @if (!string.IsNullOrEmpty(request.SampleBarcodes))
                        {
                            foreach (var barcode in request.SampleBarcodes.Split(','))
                            {
                                <span class="barcode-chip">@barcode.Trim()</span>
                            }
                        }
                        else
                        {
                            <span style="color: #7a8da8; font-size: 14px;">N/A</span>
                        }
                    </div>
                </div>
            </div>
        }
    }

    <div class="req-return">
        <a href="@Url.Action("Index", "TestRequest")">
            <i class="fas fa-arrow-left"></i> Return to Folders
        </a>
    </div>
</div>