@model LabDash.Models.TestRequest

@{
    ViewData["Title"] = "Patient Results";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var patient = Model.Patient;
}

<style>
    .results-page {
        max-width: 1150px;
        margin: 0 auto;
        padding: 20px;
        font-family: 'Inter', system-ui, sans-serif;
        color: #263238;
    }

    .results-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 15px;
        margin-bottom: 25px;
    }

        .results-header h2 {
            font-size: 25px;
            font-weight: 750;
            color: #123c38;
            margin: 0 0 6px;
        }

        .results-header p {
            color: #718096;
            margin: 0;
            font-size: 14px;
        }

    .results-card {
        background: #fff;
        border: 1px solid #e5eeec;
        border-radius: 16px;
        padding: 23px;
        margin-bottom: 20px;
        box-shadow: 0 4px 15px rgba(15, 70, 63, 0.04);
    }

    .card-heading {
        font-size: 17px;
        font-weight: 700;
        color: #145c54;
        margin-bottom: 18px;
        padding-bottom: 12px;
        border-bottom: 1px solid #edf2f1;
    }

    .patient-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 20px;
    }

    .info-label {
        display: block;
        font-size: 12px;
        color: #84919a;
        margin-bottom: 6px;
        font-weight: 600;
        text-transform: uppercase;
    }

    .info-value {
        font-size: 14px;
        font-weight: 650;
        color: #263b39;
        overflow-wrap: anywhere;
    }

    .status-badge {
        display: inline-block;
        padding: 7px 13px;
        border-radius: 30px;
        background: #e3f5ed;
        color: #14734d;
        font-size: 12px;
        font-weight: 750;
    }

    .result-table-wrapper {
        width: 100%;
        overflow-x: auto;
    }

    .result-table {
        width: 100%;
        border-collapse: collapse;
        min-width: 650px;
    }

        .result-table th {
            background: #f0f7f5;
            color: #28645c;
            font-size: 12px;
            text-transform: uppercase;
            text-align: left;
            padding: 14px;
            white-space: nowrap;
        }

        .result-table td {
            padding: 15px 14px;
            border-bottom: 1px solid #edf1f0;
            font-size: 13px;
            color: #425451;
        }

        .result-table tr:last-child td {
            border-bottom: none;
        }

    .verified-badge {
        background: #e3f5ed;
        color: #14734d;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .abnormal-badge {
        background: #fff0ed;
        color: #b42318;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .normal-badge {
        background: #e3f5ed;
        color: #14734d;
        padding: 6px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .clinical-notes {
        background: #f7faf9;
        border-left: 4px solid #168477;
        border-radius: 8px;
        padding: 15px;
        font-size: 14px;
        color: #52615e;
        line-height: 1.7;
    }

    .empty-results {
        text-align: center;
        padding: 35px 15px;
        color: #84919a;
    }

        .empty-results i {
            font-size: 35px;
            color: #9dbbb5;
            margin-bottom: 12px;
        }

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 20px;
    }

    .btn-results {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 17px;
        border-radius: 9px;
        border: none;
        text-decoration: none;
        font-size: 13px;
        font-weight: 650;
        cursor: pointer;
        transition: .2s;
    }

    .btn-back {
        background: #edf2f1;
        color: #40534f;
    }

        .btn-back:hover {
            background: #dfe9e6;
            color: #263b39;
        }

    .btn-pdf {
        background: #0d6b63;
        color: white;
    }

        .btn-pdf:hover {
            background: #09564f;
            color: white;
        }

    @@media (max-width: 600px) {
        .results-page {
            padding: 12px;
        }

        .results-card {
            padding: 16px;
        }

        .results-header h2 {
            font-size: 21px;
        }
    }
</style>

<div class="results-page">

    <!-- PAGE HEADER -->
    <div class="results-header">
        <div>
            <h2>
                <i class="fas fa-file-medical"></i>
                Patient Laboratory Results
            </h2>
            <p>View and review verified laboratory test results.</p>
        </div>

        <span class="status-badge">
            <i class="fas fa-check-circle"></i>
            Verified Results
        </span>
    </div>

    <!-- PATIENT INFORMATION -->
    <div class="results-card">
        <div class="card-heading">
            <i class="fas fa-user-injured"></i>
            Patient Information
        </div>

        <div class="patient-grid">

            <div>
                <span class="info-label">Patient Name</span>
                <span class="info-value">
                    @patient?.Name
                </span>
            </div>

            <div>
                <span class="info-label">Patient ID</span>
                <span class="info-value">
                    @patient?.IDNumber
                </span>
            </div>

            <div>
                <span class="info-label">Request Number</span>
                <span class="info-value">
                    TR-@Model.RequestId
                </span>
            </div>

            <div>
                <span class="info-label">Request Status</span>
                <span class="info-value">
                    @Model.Status
                </span>
            </div>

        </div>
    </div>

    <!-- TEST RESULTS -->
    <div class="results-card">
        <div class="card-heading">
            <i class="fas fa-microscope"></i>
            Laboratory Test Results
        </div>

        @if (Model.TestRequestItems != null &&
                Model.TestRequestItems.Any())
        {
            <div class="result-table-wrapper">
                <table class="result-table">
                    <thead>
                        <tr>
                            <th>Test Name</th>
                            <th>Result</th>
                            <th>Units</th>
                            <th>Reference Range</th>
                            <th>Status</th>
                            <th>Verification</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model.TestRequestItems)
                        {
                            if (item.TestResults != null &&
                            item.TestResults.Any())
                            {
                                foreach (var result in item.TestResults)
                                {
                                    <tr>
                                        <td>
                                            <strong>
                                                @item.TestType?.Name
                                            </strong>
                                        </td>

                                        <td>
                                            @result.ResultValue
                                        </td>

                                        <td>
                                            @result.Units
                                        </td>

                                        <td>
                                            @result.ReferenceRange
                                        </td>

                                        <td>
                                            @if (result.IsAbnormal)
                                            {
                                                <span class="abnormal-badge">
                                                    Abnormal
                                                </span>
                                            }
                                            else
                                            {
                                                <span class="normal-badge">
                                                    Normal
                                                </span>
                                            }
                                        </td>

                                        <td>
                                            <span class="verified-badge">
                                                <i class="fas fa-check"></i>
                                                Verified
                                            </span>
                                        </td>
                                    </tr>
                                }
                            }
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="empty-results">
                <i class="fas fa-flask"></i>
                <h4>No Results Available</h4>
                <p>No laboratory results were found for this request.</p>
            </div>
        }
    </div>

    <!-- CLINICAL NOTES -->
    <div class="results-card">
        <div class="card-heading">
            <i class="fas fa-notes-medical"></i>
            Clinical Notes
        </div>

        <div class="clinical-notes">
            @if (!string.IsNullOrWhiteSpace(Model.ClinicalNotes))
            {
                @Model.ClinicalNotes
            }
            else
            {
                <span>No clinical notes were provided for this request.</span>
            }
        </div>
    </div>

    <!-- ACTION BUTTONS -->
    <div class="action-buttons">

        <a asp-controller="TestRequest"
           asp-action="Index"
           class="btn-results btn-back">
            <i class="fas fa-arrow-left"></i>
            Back to Requests
        </a>

        <a asp-controller="TestRequest"
           asp-action="ResultsPdf"
           asp-route-requestId="@Model.RequestId"
           class="btn-results btn-pdf">
            <i class="fas fa-file-pdf"></i>
            Download PDF
        </a>

    </div>

</div>