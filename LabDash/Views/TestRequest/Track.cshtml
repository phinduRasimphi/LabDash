@model LabDash.Models.TestRequest

@{
    ViewData["Title"] = "Patient Results";
    ViewData["ActivePage"] = "TestRequests";
    Layout = "~/Views/Shared/_DoctorLayout.cshtml";

    var patient = Model.Patient;
    var items = Model.TestRequestItems?.OrderBy(i => i.TestType?.Name).ToList()
                ?? new List<LabDash.Models.TestRequestItem>();

    bool allCompleted = items.Any() && items.All(i => i.Status == "Completed");
    bool isReleased = Model.Status == "Released by doctor";
    int abnormalCount = items.Count(i =>
        i.TestResults != null &&
        i.TestResults.Any(r => r.IsAbnormal));
}

<style>
    .results-page {
        max-width: 1100px;
        margin: 20px auto;
        padding: 12px 22px;
        font-family: 'Inter', sans-serif;
    }

    .results-header {
        background: linear-gradient(135deg, #126b65, #1a8179);
        color: #fff;
        padding: 26px 32px;
        border-radius: 12px;
        margin-bottom: 22px;
        box-shadow: 0 5px 18px rgba(18,107,101,0.18);
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
    }

        .results-header h1 {
            margin: 0;
            font-size: 22px;
            font-weight: 700;
        }

        .results-header p {
            margin: 6px 0 0;
            opacity: 0.85;
            font-size: 13px;
        }

    .status-badge {
        padding: 6px 14px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.6px;
        background: rgba(255,255,255,0.2);
        color: #fff;
    }

        .status-badge.released {
            background: #22a06b;
        }

    .patient-card,
    .results-card {
        background: #fff;
        border: 1px solid #e3e8ee;
        border-radius: 12px;
        box-shadow: 0 4px 22px rgba(15,35,55,0.07);
        padding: 24px 28px;
        margin-bottom: 22px;
    }

    .card-title {
        font-size: 15px;
        font-weight: 700;
        color: #18324f;
        margin: 0 0 16px;
        padding-bottom: 12px;
        border-bottom: 1px solid #e9edf2;
    }

    .patient-grid {
        display: grid;
        grid-template-columns: repeat(2, 1fr);
        gap: 14px 26px;
    }

    .patient-field {
        font-size: 13px;
    }

        .patient-field strong {
            display: block;
            color: #7d8e8a;
            font-weight: 500;
            font-size: 11px;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            margin-bottom: 3px;
        }

        .patient-field span {
            color: #18324f;
            font-weight: 600;
        }

    .results-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13px;
    }

        .results-table th {
            background: #f3faf9;
            color: #145c57;
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 0.5px;
            text-align: left;
            padding: 12px 14px;
            border-bottom: 1px solid #cce5e1;
        }

        .results-table td {
            padding: 14px;
            border-bottom: 1px solid #f0f2f5;
            color: #26384d;
        }

        .results-table tr.abnormal td {
            background: #fff6f6;
            color: #b42318;
        }

            .results-table tr.abnormal td:first-child {
                border-left: 4px solid #d92d20;
            }

    .flag {
        display: inline-block;
        padding: 3px 10px;
        border-radius: 12px;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: 0.4px;
    }

        .flag.normal {
            background: #e6f5f1;
            color: #126b65;
        }

        .flag.abnormal {
            background: #fde8e8;
            color: #b42318;
        }

        .flag.pending {
            background: #fef3c7;
            color: #92400e;
        }

    .actions-bar {
        display: flex;
        gap: 12px;
        flex-wrap: wrap;
        margin-top: 20px;
        padding-top: 20px;
        border-top: 1px solid #e9edf2;
    }

    .btn {
        height: 42px;
        padding: 0 22px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        display: inline-flex;
        align-items: center;
        gap: 8px;
        border: none;
        cursor: pointer;
        font-family: 'Inter', sans-serif;
    }

    .btn-primary {
        background: linear-gradient(135deg,#126b65,#1a8179);
        color: #fff;
    }

    .btn-secondary {
        background: #ffffff;
        border: 1px solid #d5dde6;
        color: #475467;
    }

    .btn-warn {
        background: #f59e0b;
        color: #fff;
    }

    .note-box {
        background: #f3faf9;
        border-left: 4px solid #126b65;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 13px;
        color: #344054;
    }

    .released-note {
        background: #ecfdf5;
        border-left: 4px solid #22a06b;
        padding: 14px 18px;
        border-radius: 8px;
        margin-bottom: 18px;
        font-size: 13px;
        color: #145c57;
    }

    textarea.form-control {
        width: 100%;
        padding: 10px 13px;
        border: 1px solid #d8e0e8;
        border-radius: 7px;
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        resize: vertical;
        min-height: 90px;
        box-sizing: border-box;
    }

    .modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(15,31,45,0.55);
        backdrop-filter: blur(3px);
        align-items: center;
        justify-content: center;
        z-index: 9999;
        padding: 20px;
    }

        .modal-overlay.show {
            display: flex;
        }

    .modal-box {
        background: #fff;
        border-radius: 12px;
        padding: 28px 32px;
        max-width: 460px;
        width: 100%;
        box-shadow: 0 20px 55px rgba(0,0,0,0.18);
    }

        .modal-box h3 {
            margin: 0 0 14px;
            color: #18324f;
            font-size: 17px;
        }

        .modal-box p {
            margin: 0 0 18px;
            color: #7d8e8a;
            font-size: 13px;
        }

    .modal-actions {
        display: flex;
        gap: 10px;
        justify-content: flex-end;
    }

    .radio-group {
        display: flex;
        flex-direction: column;
        gap: 10px;
        margin: 14px 0 18px;
    }

        .radio-group label {
            display: flex;
            gap: 8px;
            align-items: center;
            font-size: 13px;
            color: #344054;
            cursor: pointer;
        }
</style>

<div class="results-page">

    <div class="results-header">
        <div>
            <h1><i class="fas fa-file-medical-alt"></i> Test Results</h1>
            <p>Request #@Model.RequestId · @Model.RequestDate.ToString("dd MMM yyyy") · @Model.Urgency</p>
        </div>
        <span class="status-badge @(isReleased ? "released" : "")">
            @Model.Status
        </span>
    </div>

    @if (patient != null)
    {
        <div class="patient-card">
            <h2 class="card-title">Patient</h2>
            <div class="patient-grid">
                <div class="patient-field">
                    <strong>Full Name</strong>
                    <span>@patient.Name @patient.Surname</span>
                </div>
                <div class="patient-field">
                    <strong>ID Number</strong>
                    <span>@patient.IDNumber</span>
                </div>
                <div class="patient-field">
                    <strong>Date of Birth</strong>
                    <span>@patient.DOB.ToString("dd MMM yyyy")</span>
                </div>
                <div class="patient-field">
                    <strong>Email</strong>
                    <span>@patient.Email</span>
                </div>
                <div class="patient-field">
                    <strong>Cellphone</strong>
                    <span>@patient.CellphoneNumber</span>
                </div>
            </div>
        </div>
    }

    @if (abnormalCount > 0)
    {
        <div class="note-box" style="background:#fff6f6;border-left-color:#d92d20;color:#b42318;">
            <strong><i class="fas fa-exclamation-triangle"></i> @abnormalCount abnormal result@(abnormalCount == 1 ? "" : "s") detected.</strong>
            Highlighted rows below require the patient's attention.
        </div>
    }

    @if (isReleased && !string.IsNullOrWhiteSpace(Model.ReleaseNote))
    {
        <div class="released-note">
            <strong>Release note:</strong> @Model.ReleaseNote
            <br /><small>Released on @Model.ReleaseDate?.ToString("dd MMM yyyy HH:mm")</small>
        </div>
    }

    <div class="results-card">
        <h2 class="card-title">Results</h2>

        @if (!items.Any())
        {
            <p style="color:#7d8e8a;font-size:13px;">No test items on this request.</p>
        }
        else
        {
            <table class="results-table">
                <thead>
                    <tr>
                        <th>Test</th>
                        <th>Result</th>
                        <th>Units</th>
                        <th>Reference Range</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in items)
                    {
                        var result = item.TestResults?
                            .OrderByDescending(r => r.DateCaptured)
                            .FirstOrDefault();

                        bool abnormal = result?.IsAbnormal ?? false;
                        string statusText =
                            result == null ? "Pending" :
                            result.IsAbnormal ? "Abnormal" : "Normal";

                        string flagClass =
                            result == null ? "pending" :
                            result.IsAbnormal ? "abnormal" : "normal";

                        <tr class="@(abnormal ? "abnormal" : "")">
                            <td>
                                <strong>@item.TestType?.Name</strong>
                                @if (!string.IsNullOrWhiteSpace(item.TestType?.Category))
                                {
                                    <br /><small style="color:#7d8e8a;">@item.TestType.Category</small>
                                }
                            </td>
                            <td>@(result?.ResultValue ?? "—")</td>
                            <td>@(result?.Units ?? "—")</td>
                            <td>@(result?.ReferenceRange ?? "—")</td>
                            <td><span class="flag @flagClass">@statusText</span></td>
                        </tr>

                        @if (!string.IsNullOrWhiteSpace(result?.Comments))
                        {
                            <tr>
                                <td colspan="5" style="background:#f8fbfa;font-size:12px;color:#52736f;">
                                    <strong>Comment:</strong> @result.Comments
                                </td>
                            </tr>
                        }
                    }
                </tbody>
            </table>
        }

        <div class="actions-bar">

            <a asp-action="Track" class="btn btn-secondary">
                <i class="fas fa-arrow-left"></i> Back to Track
            </a>

            @if (allCompleted && !isReleased)
            {
                <button type="button" class="btn btn-warn" onclick="openReleaseModal()">
                    <i class="fas fa-paper-plane"></i> Release to Patient
                </button>
            }

            @if (isReleased)
            {
                <span style="display:inline-flex;align-items:center;color:#22a06b;font-size:13px;font-weight:600;">
                    <i class="fas fa-check-circle" style="margin-right:6px;"></i> Released to patient
                </span>
            }
        </div>
    </div>
</div>

@if (allCompleted && !isReleased)
{
    <div class="modal-overlay" id="releaseModal">
        <div class="modal-box">
            <h3>Release Results to Patient</h3>
            <p>Choose how to notify the patient. They will receive an email.</p>

            <form asp-action="ReleaseWithNote" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="requestId" value="@Model.RequestId" />

                <div class="radio-group">
                    <label>
                        <input type="radio" name="mode" value="SendResults" checked />
                        <span>Email the results directly to the patient</span>
                    </label>
                    <label>
                        <input type="radio" name="mode" value="InviteConsultation" />
                        <span>Invite the patient for a consultation</span>
                    </label>
                </div>

                <label style="font-size:12px;font-weight:600;color:#344054;display:block;margin-bottom:6px;">
                    Note (optional)
                </label>
                <textarea name="note" class="form-control"
                          placeholder="Add a note for the patient..."></textarea>

                <div class="modal-actions" style="margin-top:20px;">
                    <button type="button" class="btn btn-secondary" onclick="closeReleaseModal()">
                        Cancel
                    </button>
                    <button type="submit" class="btn btn-primary">
                        <i class="fas fa-paper-plane"></i> Release
                    </button>
                </div>
            </form>
        </div>
    </div>

    <script>
        function openReleaseModal()  { document.getElementById('releaseModal').classList.add('show'); }
        function closeReleaseModal() { document.getElementById('releaseModal').classList.remove('show'); }
    </script>
}