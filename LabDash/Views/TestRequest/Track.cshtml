@model List<LabDash.Models.TrackRequestViewModel>

@{
    ViewData["Title"] = "Track Test Requests";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<style>

    /* ============================================================
           MAIN CONTAINER
        ============================================================ */

    .track-container {
        max-width: 1100px;
        margin: 0 auto;
        padding-bottom: 40px;
    }

    .track-page-title {
        font-size: 24px;
        font-weight: 700;
        color: #1a2f4e;
        margin-bottom: 5px;
    }

    .track-page-subtitle {
        color: #7a8da8;
        font-size: 14px;
        margin-bottom: 22px;
    }


    /* ============================================================
           ALERTS
        ============================================================ */

    .track-alert {
        padding: 14px 18px;
        border-radius: 10px;
        margin-bottom: 18px;
        font-size: 14px;
        font-weight: 600;
    }

    .track-alert-error {
        background: #ffebee;
        color: #c62828;
        border: 1px solid #ffcdd2;
    }

    .track-alert-success {
        background: #e8f5e9;
        color: #2e7d32;
        border: 1px solid #c8e6c9;
    }


    /* ============================================================
           PATIENT CARD
        ============================================================ */

    .track-card {
        background: white;
        border-radius: 16px;
        border: 1px solid #e2e8f0;
        box-shadow: 0 8px 22px rgba(0, 0, 0, 0.07);
        margin-bottom: 28px;
        overflow: hidden;
    }


    /* ============================================================
           PATIENT HEADER
        ============================================================ */

    .track-header {
        background: linear-gradient(135deg, #0d6b63, #1a8c82);
        color: white;
        padding: 20px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
    }

    .track-patient {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .track-avatar {
        width: 55px;
        height: 55px;
        min-width: 55px;
        border-radius: 50%;
        background: rgba(255, 255, 255, 0.20);
        border: 1px solid rgba(255, 255, 255, 0.35);
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 18px;
    }

    .track-patient-name {
        font-size: 18px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .track-patient-sub {
        font-size: 13px;
        opacity: 0.88;
    }

    .patient-folder-label {
        display: flex;
        align-items: center;
        gap: 7px;
        background: rgba(255, 255, 255, 0.15);
        padding: 8px 12px;
        border-radius: 20px;
        font-size: 12px;
        font-weight: 600;
    }


    /* ============================================================
           CARD BODY
        ============================================================ */

    .track-body {
        padding: 24px;
    }

    .track-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: #1a2f4e;
        font-size: 15px;
        font-weight: 700;
        margin-bottom: 15px;
    }

        .track-section-title i {
            color: #0d6b63;
        }


    /* ============================================================
           REQUEST GRID
        ============================================================ */

    .track-status-grid {
        display: grid;
        grid-template-columns: repeat(auto-fill, minmax(300px, 1fr));
        gap: 18px;
    }


    /* ============================================================
           REQUEST CARD
        ============================================================ */

    .track-request {
        background: #f8fafd;
        border: 1px solid #e2e8f0;
        border-radius: 13px;
        padding: 18px;
        transition: all 0.25s ease;
    }

        .track-request:hover {
            border-color: #b7d9d5;
            box-shadow: 0 5px 15px rgba(13, 107, 99, 0.08);
            transform: translateY(-2px);
        }


    /* ============================================================
           REQUEST HEADER
        ============================================================ */

    .request-top {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 10px;
        margin-bottom: 12px;
    }

    .status-label {
        font-size: 12px;
        font-weight: 700;
        color: #7a8da8;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .request-date {
        font-size: 13px;
        color: #52657d;
    }


    /* ============================================================
           STATUS BADGES
        ============================================================ */

    .track-status {
        padding: 6px 12px;
        border-radius: 16px;
        font-size: 12px;
        font-weight: 700;
        display: inline-block;
        white-space: nowrap;
    }

        .track-status.Submitted {
            background: #e3f2fd;
            color: #1565c0;
        }

        .track-status.SamplesReceived {
            background: #f3e5f5;
            color: #6a1b9a;
        }

        .track-status.InProgress {
            background: #fff8e1;
            color: #7a5c00;
        }

        .track-status.Completed {
            background: #e8f5e9;
            color: #2e7d32;
        }

        .track-status.Releasedbydoctor {
            background: #e0f2f1;
            color: #00695c;
        }

        .track-status.Cancelled {
            background: #ffebee;
            color: #c62828;
        }


    /* ============================================================
           REQUEST INFORMATION
        ============================================================ */

    .request-info {
        background: white;
        border: 1px solid #e8edf3;
        border-radius: 9px;
        padding: 11px 12px;
        margin-bottom: 13px;
    }

    .request-info-row {
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 10px;
        padding: 5px 0;
        font-size: 13px;
    }

        .request-info-row:not(:last-child) {
            border-bottom: 1px solid #f0f2f5;
        }

    .request-info-label {
        color: #7a8da8;
    }

    .request-info-value {
        color: #26384d;
        font-weight: 600;
        text-align: right;
    }


    /* ============================================================
           URGENCY
        ============================================================ */

    .urgency-badge {
        padding: 4px 9px;
        border-radius: 12px;
        font-size: 11px;
        font-weight: 700;
    }

    .urgency-routine {
        background: #eef2f7;
        color: #52657d;
    }

    .urgency-urgent {
        background: #fff3e0;
        color: #e65100;
    }

    .urgency-stat {
        background: #ffebee;
        color: #c62828;
    }


    /* ============================================================
           PROGRESS TIMELINE
        ============================================================ */

    .track-progress {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        width: 100%;
        margin-top: 17px;
        padding: 8px 0 12px;
    }

    .track-step {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        min-width: 42px;
    }

    .track-progress-step {
        width: 27px;
        height: 27px;
        border-radius: 50%;
        background: #e2e8f0;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 700;
        color: #7a8da8;
        border: 2px solid #e2e8f0;
    }

        .track-progress-step.active {
            background: #0d6b63;
            border-color: #0d6b63;
            color: white;
        }

    .track-step-label {
        font-size: 9px;
        font-weight: 600;
        color: #7a8da8;
        text-transform: uppercase;
        text-align: center;
        line-height: 1.2;
    }

    .track-progress-line {
        flex: 1;
        height: 3px;
        background: #e2e8f0;
        margin-top: 12px;
        border-radius: 2px;
    }

        .track-progress-line.active {
            background: #0d6b63;
        }


    /* ============================================================
           ACTION AREA
        ============================================================ */

    .track-actions {
        margin-top: 14px;
        padding-top: 14px;
        border-top: 1px solid #e2e8f0;
    }

    .btn-view {
        display: block;
        width: 100%;
        padding: 10px;
        border-radius: 8px;
        font-size: 13px;
        font-weight: 600;
        text-align: center;
        text-decoration: none;
        background: #0d6b63;
        color: white;
        transition: all 0.25s ease;
        margin-bottom: 10px;
    }

        .btn-view:hover {
            background: #09554f;
            color: white;
            text-decoration: none;
        }

        .btn-view.disabled {
            background: #e2e8f0;
            color: #7a8da8;
            cursor: not-allowed;
            pointer-events: none;
        }


    /* ============================================================
           FORMS
        ============================================================ */

    .track-form {
        display: flex;
        flex-direction: column;
        gap: 8px;
    }

        .track-form input {
            width: 100%;
            border: 1px solid #d8e0e8;
            border-radius: 8px;
            padding: 10px 11px;
            font-size: 13px;
            outline: none;
            transition: border-color 0.2s ease;
        }

            .track-form input:focus {
                border-color: #0d6b63;
                box-shadow: 0 0 0 2px rgba(13, 107, 99, 0.08);
            }

    .btn-cancel {
        width: 100%;
        background: #c62828;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-cancel:hover {
            background: #a91f1f;
        }

    .btn-release {
        width: 100%;
        background: #0d6b63;
        color: white;
        border: none;
        border-radius: 8px;
        padding: 10px;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
    }

        .btn-release:hover {
            background: #09554f;
        }


    /* ============================================================
           CANCELLED MESSAGE
        ============================================================ */

    .cancelled-message {
        background: #fff5f5;
        border: 1px solid #ffcdd2;
        color: #c62828;
        border-radius: 8px;
        padding: 10px 12px;
        font-size: 12px;
        line-height: 1.5;
    }


    /* ============================================================
           EMPTY STATE
        ============================================================ */

    .track-empty {
        background: white;
        border: 1px solid #e2e8f0;
        border-radius: 16px;
        padding: 55px 20px;
        text-align: center;
        box-shadow: 0 8px 20px rgba(0,0,0,0.05);
    }

    .track-empty-icon {
        width: 65px;
        height: 65px;
        border-radius: 50%;
        background: #e7f4f2;
        color: #0d6b63;
        display: flex;
        align-items: center;
        justify-content: center;
        margin: 0 auto 15px;
        font-size: 26px;
    }

    .track-empty h3 {
        color: #1a2f4e;
        font-size: 18px;
        margin-bottom: 7px;
    }

    .track-empty p {
        color: #7a8da8;
        font-size: 14px;
        margin: 0;
    }


    /* ============================================================
           RESPONSIVE
        ============================================================ */

    @@media (max-width: 768px) {

        .track-container {
            padding: 0 10px 30px;
        }

        .track-header {
            padding: 17px;
        }

        .patient-folder-label {
            display: none;
        }

        .track-body {
            padding: 17px;
        }

        .track-status-grid {
            grid-template-columns: 1fr;
        }

        .request-top {
            flex-direction: column;
        }

        .track-status {
            align-self: flex-start;
        }

        .track-progress {
            overflow-x: auto;
            min-width: 260px;
        }
    }

</style>


<div class="track-container">

    <!-- =========================================================
         PAGE HEADER
    ========================================================== -->

    <h1 class="track-page-title">
        <i class="fas fa-route" style="color:#0d6b63;"></i>
        Track Test Requests
    </h1>

    <div class="track-page-subtitle">
        Monitor the progress and status of your patients' laboratory test requests.
    </div>


    <!-- =========================================================
         ERROR MESSAGE
    ========================================================== -->
    @if (TempData["Error"] != null)
    {
        <div class="track-alert track-alert-error">
            <i class="fas fa-exclamation-circle"></i>
            @TempData["Error"]
        </div>
    }


    <!-- =========================================================
         SUCCESS MESSAGE
    ========================================================== -->
    @if (TempData["Success"] != null)
    {
        <div class="track-alert track-alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="track-alert track-alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["SuccessMessage"]
        </div>
    }


    <!-- =========================================================
         EMPTY STATE
    ========================================================== -->
    @if (Model == null || !Model.Any())
    {
        <div class="track-empty">

            <div class="track-empty-icon">
                <i class="fas fa-flask"></i>
            </div>

            <h3>No Test Requests Found</h3>

            <p>
                There are currently no test requests available to track.
            </p>

        </div>
    }
    else
    {

        <!-- =====================================================
             PATIENT FOLDERS
        ====================================================== -->
        foreach (var folder in Model)
        {
            if (folder.Patient == null)
            {
                continue;
            }

            string initials =
                $"{folder.Patient.Name?.FirstOrDefault()}{folder.Patient.Surname?.FirstOrDefault()}";

            <div class="track-card">

                <!-- =================================================
                     PATIENT HEADER
                ================================================== -->

                <div class="track-header">

                    <div class="track-patient">

                        <div class="track-avatar">
                            @initials.ToUpper()
                        </div>

                        <div>

                            <div class="track-patient-name">
                                @folder.Patient.Name @folder.Patient.Surname
                            </div>

                            <div class="track-patient-sub">
                                ID: @folder.Patient.IDNumber
                            </div>

                        </div>

                    </div>

                    <div class="patient-folder-label">
                        <i class="fas fa-folder-open"></i>
                        Patient Requests
                    </div>

                </div>


                <!-- =================================================
                     REQUEST BODY
                ================================================== -->

                <div class="track-body">

                    <div class="track-section-title">
                        <i class="fas fa-list-check"></i>
                        Test Request History
                    </div>


                    <div class="track-status-grid">

                        @foreach (var request in folder.Requests)
                        {
                            if (request == null)
                            {
                                continue;
                            }

                            string statusClass =
                                request.Status?
                                    .Replace(" ", "") ??
                                "";

                            string urgencyClass =
                                request.Urgency == "STAT"
                                    ? "urgency-stat"
                                    : request.Urgency == "Urgent"
                                        ? "urgency-urgent"
                                        : "urgency-routine";


                            <div class="track-request">

                                <!-- =================================
                                     REQUEST HEADER
                                ================================== -->

                                <div class="request-top">

                                    <div>

                                        <div class="status-label">
                                            Test Request
                                        </div>

                                        <div class="request-date">
                                            <strong>
                                                Request #@request.RequestId
                                            </strong>
                                            <br />

                                            @request.RequestDate.ToString("dd MMM yyyy")
                                        </div>

                                    </div>

                                    <span class="track-status @statusClass">
                                        @request.Status
                                    </span>

                                </div>


                                <!-- =================================
                                     REQUEST INFORMATION
                                ================================== -->

                                <div class="request-info">

                                    <div class="request-info-row">

                                        <span class="request-info-label">
                                            Urgency
                                        </span>

                                        <span class="urgency-badge @urgencyClass">
                                            @request.Urgency
                                        </span>

                                    </div>

                                    <div class="request-info-row">

                                        <span class="request-info-label">
                                            Doctor
                                        </span>

                                        <span class="request-info-value">
                                            @request.RequestingDoctorId
                                        </span>

                                    </div>

                                    <div class="request-info-row">

                                        <span class="request-info-label">
                                            Submitted
                                        </span>

                                        <span class="request-info-value">
                                            @(request.SubmittedDate?.ToString("dd MMM yyyy HH:mm") ?? "N/A")
                                        </span>

                                    </div>

                                </div>


                                <!-- =================================
                                     PROGRESS TIMELINE
                                ================================== -->

                                <div class="track-progress">

                                    <!-- Submitted -->

                                    <div class="track-step">

                                        <div class="track-progress-step
                                            @(request.Status == "Submitted"
                                             || request.Status == "Samples Received"
                                             || request.Status == "In Progress"
                                             || request.Status == "Completed"
                                             || request.Status == "Released by doctor"
                                             ? "active"
                                             : "")">
                                            1
                                        </div>

                                        <div class="track-step-label">
                                            Submitted
                                        </div>

                                    </div>


                                    <!-- Line -->

                                    <div class="track-progress-line
                                        @(request.Status == "Submitted"
                                         || request.Status == "Samples Received"
                                         || request.Status == "In Progress"
                                         || request.Status == "Completed"
                                         || request.Status == "Released by doctor"
                                         ? "active"
                                         : "")">
                                    </div>


                                    <!-- Received -->

                                    <div class="track-step">

                                        <div class="track-progress-step
                                            @(request.Status == "Samples Received"
                                             || request.Status == "In Progress"
                                             || request.Status == "Completed"
                                             || request.Status == "Released by doctor"
                                             ? "active"
                                             : "")">
                                            2
                                        </div>

                                        <div class="track-step-label">
                                            Received
                                        </div>

                                    </div>


                                    <!-- Line -->

                                    <div class="track-progress-line
                                        @(request.Status == "In Progress"
                                         || request.Status == "Completed"
                                         || request.Status == "Released by doctor"
                                         ? "active"
                                         : "")">
                                    </div>


                                    <!-- Testing -->

                                    <div class="track-step">

                                        <div class="track-progress-step
                                            @(request.Status == "In Progress"
                                             || request.Status == "Completed"
                                             || request.Status == "Released by doctor"
                                             ? "active"
                                             : "")">
                                            3
                                        </div>

                                        <div class="track-step-label">
                                            Testing
                                        </div>

                                    </div>


                                    <!-- Line -->

                                    <div class="track-progress-line
                                        @(request.Status == "Completed"
                                         || request.Status == "Released by doctor"
                                         ? "active"
                                         : "")">
                                    </div>


                                    <!-- Completed -->

                                    <div class="track-step">

                                        <div class="track-progress-step
                                            @(request.Status == "Completed"
                                             || request.Status == "Released by doctor"
                                             ? "active"
                                             : "")">
                                            4
                                        </div>

                                        <div class="track-step-label">
                                            Completed
                                        </div>

                                    </div>

                                </div>


                                <!-- =================================
                                     ACTIONS
                                ================================== -->

                                <div class="track-actions">

                                    <!-- VIEW -->

                                    <a href="@Url.Action("ViewRequest", "TestRequest", new { id = request.RequestId })"
                                       class="btn-view
                                        @(request.Status == "Completed"
                                       || request.Status == "Released by doctor"
                                       ? ""
                                       : "disabled")">

                                        <i class="fas fa-eye"></i>
                                        View Request

                                    </a>


                                    <!-- CANCEL -->
                                    @if (request.Status == "Submitted"
                                                                            || request.Status == "Samples Received")
                                    {
                                        <form asp-action="Cancel"
                                              method="post"
                                              class="track-form">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="requestId"
                                                   value="@request.RequestId" />

                                            <input type="text"
                                                   name="cancellationReason"
                                                   placeholder="Enter cancellation reason..."
                                                   required />

                                            <button type="submit"
                                                    class="btn-cancel">

                                                <i class="fas fa-times-circle"></i>
                                                Cancel Request

                                            </button>

                                        </form>
                                    }


                                    <!-- RELEASE RESULTS -->
                                    else if (request.Status == "Completed")
                                    {
                                    <form asp-action="ReleaseResults"
                                          method="post"
                                          class="track-form">

                                        @Html.AntiForgeryToken()

                                        <input type="hidden"
                                               name="requestId"
                                               value="@request.RequestId" />

                                        <input type="text"
                                               name="releaseNote"
                                               placeholder="Optional note for patient..." />

                                        <button type="submit"
                                                class="btn-release">

                                            <i class="fas fa-paper-plane"></i>
                                            Release to Patient

                                        </button>

                                    </form>
                                    }


                                    <!-- CANCELLED -->
                                    else if (request.Status == "Cancelled")
                                    {
                                    <div class="cancelled-message">

                                        <i class="fas fa-ban"></i>

                                        <strong>
                                            Request Cancelled
                                        </strong>

                                        <br />

                                        Reason:
                                        @request.CancellationReason

                                    </div>
                                    }

                                </div>

                            </div>
                        }

                    </div>

                </div>

            </div>
        }
    }

</div>