<button class="to-top" id="toTop" type="button" aria-label="Back to top"><i class="fa-solid fa-arrow-up"></i></button>

<script>
(function () {
  // Videos: forced muted play, pause off screen, user toggle (hero and stats section)
  function setupVideo(video, toggle) {
    if (!video || !toggle) return;
    var userPaused = false;
    video.muted = true; video.defaultMuted = true;
    video.addEventListener('error', function () {
      var s = video.querySelector('source');
      console.warn('LabDash video failed to load:', s ? s.src : '', '(404 = wrong folder, otherwise codec: use H.264 MP4)');
    }, true);
    var p = video.play();
    if (p && p.catch) p.catch(function () {
      var retry = function () { if (!userPaused) video.play(); };
      ['pointerdown', 'keydown', 'scroll', 'touchstart'].forEach(function (e) { window.addEventListener(e, retry, { once: true, passive: true }); });
    });
    if ('IntersectionObserver' in window) {
      new IntersectionObserver(function (en) {
        if (en[0].isIntersecting) { if (!userPaused) video.play().catch(function () {}); } else video.pause();
      }, { threshold: 0.05 }).observe(video);
    }
    toggle.addEventListener('click', function () {
      userPaused = !userPaused;
      userPaused ? video.pause() : video.play().catch(function () {});
      toggle.querySelector('i').className = userPaused ? 'fa-solid fa-play' : 'fa-solid fa-pause';
      toggle.querySelector('span').textContent = userPaused ? 'Play video' : 'Pause video';
      toggle.setAttribute('aria-label', userPaused ? 'Play background video' : 'Pause background video');
    });
  }
  setupVideo(document.getElementById('heroVideo'), document.getElementById('heroToggle'));
  setupVideo(document.getElementById('bgVideo'), document.getElementById('videoToggle'));

  // Mobile menu
  var burger = document.getElementById('burger'), links = document.getElementById('navLinks');
  function closeMenu() { links.classList.remove('open'); burger.setAttribute('aria-expanded', 'false'); burger.firstElementChild.className = 'fa-solid fa-bars'; }
  burger.addEventListener('click', function () {
    var open = links.classList.toggle('open');
    burger.setAttribute('aria-expanded', open);
    burger.firstElementChild.className = open ? 'fa-solid fa-xmark' : 'fa-solid fa-bars';
  });
  links.addEventListener('click', function (e) { if (e.target.tagName === 'A') closeMenu(); });
  document.addEventListener('keydown', function (e) { if (e.key === 'Escape') closeMenu(); });

  // Nav shadow, back-to-top
  var nav = document.getElementById('nav'), toTop = document.getElementById('toTop');
  function onScroll() { nav.classList.toggle('scrolled', window.scrollY > 10); toTop.classList.toggle('show', window.scrollY > 700); }
  window.addEventListener('scroll', onScroll, { passive: true }); onScroll();
  toTop.addEventListener('click', function () { window.scrollTo({ top: 0 }); });

  // Active nav link
  if ('IntersectionObserver' in window) {
    var anchors = {};
    links.querySelectorAll('a[href^="#"]').forEach(function (a) { anchors[a.getAttribute('href').slice(1)] = a; });
    var so = new IntersectionObserver(function (entries) {
      entries.forEach(function (en) {
        if (en.isIntersecting && anchors[en.target.id]) {
          Object.keys(anchors).forEach(function (k) { anchors[k].classList.remove('active'); });
          anchors[en.target.id].classList.add('active');
        }
      });
    }, { rootMargin: '-45% 0px -50% 0px' });
    Object.keys(anchors).forEach(function (id) { var s = document.getElementById(id); if (s) so.observe(s); });
  }

  // Role tabs (arrow keys supported)
  var tabs = Array.prototype.slice.call(document.querySelectorAll('.tab'));
  function selectTab(tab) {
    tabs.forEach(function (t) {
      var on = t === tab;
      t.setAttribute('aria-selected', on); t.tabIndex = on ? 0 : -1;
      document.getElementById(t.getAttribute('aria-controls')).hidden = !on;
    });
    tab.focus();
  }
  tabs.forEach(function (t, i) {
    t.addEventListener('click', function () { selectTab(t); });
    t.addEventListener('keydown', function (e) {
      if (e.key === 'ArrowRight') selectTab(tabs[(i + 1) % tabs.length]);
      if (e.key === 'ArrowLeft') selectTab(tabs[(i - 1 + tabs.length) % tabs.length]);
    });
  });

  // Counters (numbers already in the HTML, so no-JS still shows them)
  var counters = document.querySelectorAll('[data-count]');
  function runCounter(el) {
    var target = parseInt(el.getAttribute('data-count'), 10), suffix = el.getAttribute('data-suffix') || '', start = null;
    function tick(ts) {
      if (!start) start = ts;
      var q = Math.min((ts - start) / 1500, 1);
      el.textContent = Math.floor(target * q).toLocaleString('en-ZA') + (q === 1 ? suffix : '');
      if (q < 1) requestAnimationFrame(tick);
    }
    requestAnimationFrame(tick);
  }
  var reduce = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if ('IntersectionObserver' in window && !reduce) {
    new IntersectionObserver(function (entries, obs) {
      if (entries[0].isIntersecting) { counters.forEach(runCounter); obs.disconnect(); }
    }, { threshold: 0.4 }).observe(document.getElementById('stats'));
  }

  // "Open now" badge (South Africa time)
  var badge = document.getElementById('openNow');
  function updateOpen() {
    var parts = new Intl.DateTimeFormat('en-GB', { timeZone: 'Africa/Johannesburg', weekday: 'short', hour: '2-digit', minute: '2-digit', hour12: false }).formatToParts(new Date());
    var get = function (t) { return parts.filter(function (x) { return x.type === t; })[0].value; };
    var day = get('weekday'), mins = parseInt(get('hour'), 10) * 60 + parseInt(get('minute'), 10);
    var open = (['Mon', 'Tue', 'Wed', 'Thu', 'Fri'].indexOf(day) > -1 && mins >= 420 && mins < 1020) || (day === 'Sat' && mins >= 480 && mins < 720);
    badge.textContent = open ? 'Open now' : 'Closed right now';
    badge.classList.toggle('is-open', open);
  }
  updateOpen(); setInterval(updateOpen, 60000);

  // Scroll effects: progress bar, hero parallax, step lighting, reveal, card glow
  var progress = document.getElementById('progress'), heroInner = document.querySelector('.hero-inner'), hero = document.getElementById('top'), cue = document.getElementById('scrollCue'), stepsEl = document.querySelector('.steps'), stepEls = Array.prototype.slice.call(document.querySelectorAll('.step')), ticking = false;
  function frame() {
    ticking = false;
    var y = window.scrollY, vh = window.innerHeight, max = document.documentElement.scrollHeight - vh;
    progress.style.transform = 'scaleX(' + (max > 0 ? Math.min(y / max, 1) : 0) + ')';
    if (!reduce && y < hero.offsetHeight) {
      heroInner.style.transform = 'translateY(' + (y * 0.22) + 'px)';
      heroInner.style.opacity = 1 - Math.min(y / (hero.offsetHeight * 0.7), 1);
    }
    cue.classList.toggle('hide', y > 80);
    if (stepsEl) {
      var r = stepsEl.getBoundingClientRect(), p = Math.max(0, Math.min(1, (vh * 0.85 - r.top) / (vh * 0.5)));
      stepEls.forEach(function (st, i) { st.classList.toggle('on', p > 0 && p >= i * 0.28); });
    }
  }
  window.addEventListener('scroll', function () { if (!ticking) { ticking = true; requestAnimationFrame(frame); } }, { passive: true });
  window.addEventListener('resize', frame); frame();

  if ('IntersectionObserver' in window && !reduce) {
    var groups = '.section-head,.tabs,.card,.step,.info-card,.tab-panel,.faq-list details,.cta-box';
    var ro = new IntersectionObserver(function (es) {
      es.forEach(function (e) {
        if (!e.isIntersecting) return;
        var t = e.target; t.classList.add('in'); ro.unobserve(t);
        setTimeout(function () { t.classList.remove('rv', 'in'); t.style.removeProperty('--d'); }, 1500);
      });
    }, { threshold: 0.12, rootMargin: '0px 0px -6% 0px' });
    document.querySelectorAll(groups).forEach(function (el) {
      var sibs = Array.prototype.filter.call(el.parentNode.children, function (c) { return c.matches(groups); });
      el.style.setProperty('--d', (Math.min(sibs.indexOf(el), 5) * 0.09) + 's');
      el.classList.add('rv'); ro.observe(el);
    });
  }

  document.querySelectorAll('.card,.info-card').forEach(function (c) {
    c.addEventListener('pointermove', function (e) {
      var r = c.getBoundingClientRect();
      c.style.setProperty('--mx', (e.clientX - r.left) + 'px'); c.style.setProperty('--my', (e.clientY - r.top) + 'px');
    });
  });
})();
</script>
</body>
</html>
