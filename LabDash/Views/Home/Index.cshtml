@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width, initial-scale=1" />
<title>LabDash | Medical Laboratory System</title>
<meta name="description" content="Request tests, follow them through the lab and view verified results securely with LabDash." />
<meta name="theme-color" content="#053833" />

<!-- Logo in the document: browser tab, bookmarks, phone home screen, link previews.
     Put your logo at wwwroot/images/labdash-logo.png (square, 512x512 PNG works best). -->
<link rel="icon" type="image/png" href="@Url.Content("~/images/labdash-logo.png")" />
<link rel="shortcut icon" href="@Url.Content("~/images/labdash-logo.png")" />
<link rel="apple-touch-icon" href="@Url.Content("~/images/labdash-logo.png")" />
<meta property="og:title" content="LabDash | Medical Laboratory System" />
<meta property="og:description" content="Request tests, follow them through the lab and view verified results securely." />
<meta property="og:image" content="@Url.Content("~/images/labdash-logo.png")" />
<meta property="og:type" content="website" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />
<style>
:root{--t950:#042f2b;--t900:#07463f;--t800:#095a52;--t700:#0a6a61;--t600:#0d766e;--t500:#12918a;--mint:#8ff2e3;--soft:rgba(255,255,255,.8);--faint:rgba(255,255,255,.6);--glass:rgba(255,255,255,.06);--glass2:rgba(255,255,255,.12);--line:rgba(255,255,255,.14);--ink:#0b2b27}
*{margin:0;padding:0;box-sizing:border-box}
html{scroll-behavior:smooth;scroll-padding-top:84px}
body{font-family:'Plus Jakarta Sans',Arial,sans-serif;background:var(--t800);color:#fff;line-height:1.65;-webkit-font-smoothing:antialiased;text-rendering:optimizeLegibility}
a{color:inherit}
img{max-width:100%}
:focus-visible{outline:3px solid var(--mint);outline-offset:3px;border-radius:6px}
.wrap{width:90%;max-width:1200px;margin:0 auto}
.skip{position:absolute;left:-999px;top:8px;background:#fff;color:var(--t700);padding:10px 16px;border-radius:8px;font-weight:700;z-index:100}
.skip:focus{left:8px}

/* Logo (image with icon fallback if the file is missing) */
.logo-mark{display:inline-grid;place-items:center;flex-shrink:0}
.logo-mark img{height:46px;width:auto;display:block}
.brand-text{display:none}
.brand.no-img .brand-text{display:inline}
.logo-mark i{display:none;width:42px;height:42px;place-items:center;border-radius:11px;background:linear-gradient(145deg,var(--t500),var(--t700));font-size:18px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.2)}
.logo-mark.no-img i{display:grid}

/* Top bar + nav */
.topbar{background:var(--t950);color:var(--soft);font-size:13px}
.topbar .wrap{display:flex;justify-content:space-between;align-items:center;gap:20px;min-height:40px;flex-wrap:wrap}
.topbar .group{display:flex;gap:26px;flex-wrap:wrap}
.topbar a,.topbar span{display:inline-flex;align-items:center;gap:8px;text-decoration:none}
.topbar a:hover{color:#fff}
.topbar i{color:var(--mint);font-size:12px}
.nav{position:sticky;top:0;z-index:60;background:rgba(5,50,45,.82);backdrop-filter:blur(16px) saturate(140%);-webkit-backdrop-filter:blur(16px) saturate(140%);border-bottom:1px solid var(--line);transition:box-shadow .25s}
.nav.scrolled{box-shadow:0 12px 32px rgba(0,0,0,.28)}
.nav .wrap{display:flex;align-items:center;justify-content:space-between;height:74px}
.brand{display:flex;align-items:center;gap:12px;text-decoration:none;font-weight:800;font-size:22px;letter-spacing:.2px}
.nav-links{display:flex;align-items:center;gap:30px}
.nav-links a:not(.btn){color:var(--soft);text-decoration:none;font-weight:500;font-size:15px;padding:6px 0;border-bottom:2px solid transparent;transition:color .2s,border-color .2s}
.nav-links a:not(.btn):hover,.nav-links a.active{color:#fff;border-color:var(--mint)}
.burger{display:none;background:none;border:1px solid var(--line);color:#fff;width:44px;height:44px;border-radius:10px;font-size:18px;cursor:pointer}

/* Buttons */
.btn{display:inline-flex;align-items:center;justify-content:center;gap:10px;padding:15px 30px;border-radius:14px;text-decoration:none;font-weight:700;font-size:15px;border:1.5px solid transparent;cursor:pointer;transition:background .2s,border-color .2s,transform .2s,box-shadow .2s}
.btn:hover{transform:translateY(-2px)}
.btn-primary{background:#fff;color:var(--t700);box-shadow:0 10px 26px rgba(0,0,0,.25)}
.btn-primary:hover{background:#e9fbf8;box-shadow:0 14px 32px rgba(0,0,0,.3)}
.btn-outline{border-color:rgba(255,255,255,.45);color:#fff;background:rgba(255,255,255,.04)}
.btn-outline:hover{background:var(--glass2);border-color:#fff}
.btn-sm{padding:10px 22px;font-size:14px;border-radius:12px}

/* Hero (video background) */
.hero{position:relative;overflow:hidden;min-height:calc(100vh - 114px);min-height:calc(100svh - 114px);display:grid;place-items:center;padding:120px 0 150px;background:var(--t950)}
.hero video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;transform:scale(1.08);animation:drift 28s ease-in-out infinite alternate}
.hero::before{content:"";position:absolute;inset:0;z-index:1;background:radial-gradient(900px 520px at 50% 0%,rgba(143,242,227,.16),transparent 60%),linear-gradient(135deg,rgba(13,118,110,.6),rgba(4,47,43,.84))}
.hero::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(to bottom,transparent 70%,var(--t800))}
.hero-inner{position:relative;z-index:3;width:90%;max-width:900px;text-align:center}
.badge{display:inline-flex;align-items:center;gap:10px;padding:7px 16px 7px 8px;border:1px solid var(--line);background:rgba(4,47,43,.5);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);border-radius:999px;font-size:13px;font-weight:600;color:var(--soft);margin-bottom:28px}
.badge b{background:var(--mint);color:var(--t950);border-radius:999px;padding:2px 10px;font-size:12px}
.hero h1{font-size:clamp(40px,6vw,74px);line-height:1.03;font-weight:800;letter-spacing:-2px;margin-bottom:24px}
.hero .lead{font-size:19px;color:var(--soft);max-width:620px;margin:0 auto 38px}
.buttons{display:flex;flex-wrap:wrap;gap:14px}
.hero .buttons{justify-content:center}
.trust{display:inline-flex;flex-wrap:wrap;justify-content:center;gap:12px 34px;margin-top:52px;padding:16px 30px;border:1px solid var(--line);border-radius:999px;background:rgba(4,47,43,.5);backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
.trust span{display:inline-flex;align-items:center;gap:10px;font-size:14px;font-weight:500;color:var(--soft)}
.trust i{color:var(--mint)}

/* Cinematic video section */
.cinema{position:relative;overflow:hidden;min-height:680px;display:grid;place-items:center;padding:130px 0;background:var(--t950)}
.cinema video{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;z-index:0;transform:scale(1.08);animation:drift 28s ease-in-out infinite alternate}
.cinema::before{content:"";position:absolute;inset:0;z-index:1;background:linear-gradient(135deg,rgba(13,118,110,.62),rgba(4,47,43,.82))}
.cinema::after{content:"";position:absolute;inset:0;z-index:2;pointer-events:none;background:linear-gradient(to bottom,var(--t800),transparent 26%,transparent 74%,var(--t900))}
.cinema-inner{position:relative;z-index:3;width:90%;max-width:1000px;text-align:center}
.cinema h2{font-size:clamp(30px,4.2vw,52px);line-height:1.1;letter-spacing:-1.2px;margin-bottom:16px}
.cinema .sub{font-size:18px;color:var(--soft);max-width:560px;margin:0 auto 40px}
.glass-stats{display:grid;grid-template-columns:repeat(4,1fr);gap:1px;margin-bottom:40px;border:1px solid var(--line);border-radius:24px;overflow:hidden;background:var(--line);backdrop-filter:blur(18px);-webkit-backdrop-filter:blur(18px);box-shadow:0 30px 70px rgba(0,0,0,.38)}
.glass-stats div{background:rgba(4,47,43,.5);padding:32px 14px}
.glass-stats strong{display:block;font-size:40px;font-weight:800;color:var(--mint);line-height:1.2;font-variant-numeric:tabular-nums}
.glass-stats span{font-size:14px;color:var(--soft)}
.video-toggle{position:absolute;left:5%;bottom:22px;z-index:4;display:inline-flex;align-items:center;gap:8px;background:rgba(4,47,43,.7);color:#fff;border:1px solid var(--line);border-radius:999px;padding:8px 16px;font:600 13px 'Plus Jakarta Sans',Arial,sans-serif;cursor:pointer;backdrop-filter:blur(6px)}
.video-toggle:hover{background:rgba(4,47,43,.95)}
@@keyframes drift{to{transform:scale(1.2) translate(-1.5%,-1%)}}

/* Sections */
section.block{padding:108px 0}
.services,.locations,.faq{background:var(--t800)}
.workflow,.contact,.roles{background:var(--t900)}
.section-head{max-width:660px;margin:0 auto 60px;text-align:center}
.section-head h2{font-size:clamp(28px,3.4vw,42px);line-height:1.15;letter-spacing:-.9px;margin-bottom:14px}
.section-head p{color:var(--soft);font-size:17px}
.cards,.steps,.info-grid{display:grid;gap:22px}
.cards,.info-grid{grid-template-columns:repeat(3,1fr)}
.steps{grid-template-columns:repeat(4,1fr);position:relative}
.card,.step,.info-card{background:var(--glass);border:1px solid var(--line);border-radius:20px;padding:34px 30px;position:relative;transition:border-color .25s,background .25s,transform .25s}
.card:hover,.info-card:hover{border-color:rgba(143,242,227,.5);background:var(--glass2)}
.card.wide{grid-column:span 2;display:grid;grid-template-columns:auto 1fr;gap:0 26px;align-items:center;background:linear-gradient(120deg,rgba(18,145,138,.4),var(--glass));overflow:hidden}
.card.wide .icon{grid-row:span 2;margin:0;width:68px;height:68px;font-size:27px}
.card .icon,.step .icon{width:52px;height:52px;display:grid;place-items:center;border-radius:14px;background:linear-gradient(145deg,var(--t500),var(--t600));font-size:20px;margin-bottom:20px;box-shadow:inset 0 0 0 1px rgba(255,255,255,.18)}
.card h3,.step h3{font-size:18px;margin-bottom:8px;letter-spacing:-.2px}
.card p,.step p{font-size:15px;color:var(--soft)}
.steps::before{content:"";position:absolute;top:60px;left:12%;right:12%;height:2px;background:repeating-linear-gradient(90deg,var(--line) 0 8px,transparent 8px 16px)}
.step{text-align:center;background:var(--t900);padding-top:34px}
.step .icon{margin:0 auto 20px;position:relative;box-shadow:0 0 0 8px var(--t900)}
.step .num{position:absolute;top:18px;right:20px;font-size:13px;font-weight:700;color:var(--faint)}

/* Tabs */
.tabs{display:flex;justify-content:center;gap:10px;flex-wrap:wrap;margin-bottom:30px}
.tab{background:var(--glass);color:var(--soft);border:1px solid var(--line);border-radius:999px;padding:11px 24px;font:600 15px 'Plus Jakarta Sans',Arial,sans-serif;cursor:pointer;transition:background .2s,color .2s}
.tab:hover{background:var(--glass2)}
.tab[aria-selected="true"]{background:#fff;color:var(--t700);border-color:#fff}
.tab-panel{max-width:880px;margin:0 auto;background:var(--glass);border:1px solid var(--line);border-radius:24px;padding:42px;display:grid;grid-template-columns:1fr 1.2fr;gap:38px;align-items:center}
.tab-panel[hidden]{display:none}
.tab-panel h3{font-size:25px;margin-bottom:10px;letter-spacing:-.4px}
.tab-panel p{color:var(--soft)}
.tab-panel ul{list-style:none;display:grid;gap:12px}
.tab-panel li{display:flex;gap:12px;color:var(--soft);font-size:15px}
.tab-panel li i{color:var(--mint);margin-top:6px}

/* Info cards */
.card-title{display:flex;align-items:center;gap:14px;margin-bottom:24px;padding-bottom:20px;border-bottom:1px solid var(--line)}
.card-title .icon{width:44px;height:44px;flex-shrink:0;display:grid;place-items:center;border-radius:12px;background:linear-gradient(145deg,var(--t500),var(--t600));font-size:18px}
.card-title h3{font-size:19px}
.loc-list{list-style:none;display:grid;gap:14px;color:var(--soft);font-size:15px}
.loc-list li{display:flex;gap:14px}
.loc-list i{color:var(--mint);width:18px;margin-top:5px;flex-shrink:0}
.link{color:var(--mint);font-weight:600;text-decoration:none}
.link:hover{text-decoration:underline}
.contact-list{list-style:none;display:grid;gap:20px}
.contact-list li{display:flex;align-items:center;gap:16px}
.contact-list .ci{width:42px;height:42px;flex-shrink:0;display:grid;place-items:center;border-radius:10px;background:var(--glass2);color:var(--mint)}
.contact-list small{display:block;font-size:12px;font-weight:600;color:var(--faint)}
.hours{list-style:none}
.hours li{display:flex;justify-content:space-between;gap:16px;padding:14px 0;border-bottom:1px solid var(--line);color:var(--soft);font-size:15px}
.hours li:first-child{padding-top:0}
.hours li:last-child{border-bottom:none;padding-bottom:0}
.hours strong{color:#fff}
.hours .closed strong{color:#ffb4a8}
.open-now{display:inline-flex;align-items:center;gap:8px;margin-top:22px;padding:6px 14px;border-radius:999px;font-size:13px;font-weight:700;background:var(--glass2)}
.open-now::before{content:"";width:9px;height:9px;border-radius:50%;background:#ff8a78}
.open-now.is-open::before{background:#5be3a4}

/* FAQ */
.faq-list{max-width:820px;margin:0 auto}
.faq-list details{background:var(--glass);border:1px solid var(--line);border-radius:16px;margin-bottom:12px;transition:background .2s}
.faq-list details[open]{background:var(--glass2)}
.faq-list summary{cursor:pointer;list-style:none;padding:20px 24px;font-weight:600;display:flex;justify-content:space-between;align-items:center;gap:16px}
.faq-list summary::-webkit-details-marker{display:none}
.faq-list summary::after{content:'+';font-size:24px;color:var(--mint);transition:transform .25s}
.faq-list details[open] summary::after{transform:rotate(45deg)}
.faq-list details p{padding:0 24px 22px;color:var(--soft)}

/* Closing call to action */
.cta{background:var(--t800);padding:0 0 104px}
.cta-box{position:relative;overflow:hidden;text-align:center;padding:72px 28px;border-radius:30px;border:1px solid var(--line);background:radial-gradient(600px 300px at 80% 0%,rgba(143,242,227,.25),transparent 60%),linear-gradient(135deg,var(--t600),var(--t950))}
.cta-box h2{font-size:clamp(28px,3.6vw,44px);line-height:1.12;letter-spacing:-1px;margin-bottom:14px}
.cta-box p{color:var(--soft);font-size:17px;max-width:520px;margin:0 auto 34px}
.cta-box .buttons{justify-content:center}

/* Footer */
footer{background:var(--t950);color:var(--soft);font-size:14px}
.footer-main{display:grid;grid-template-columns:1.4fr 1fr 1fr 1fr;gap:48px;padding:70px 0 54px}
footer .brand{margin-bottom:16px}
footer p{max-width:340px;line-height:1.8}
footer h4{color:#fff;font-size:15px;margin-bottom:16px}
footer ul{list-style:none;display:grid;gap:12px}
footer a{text-decoration:none}
footer a:hover{color:#fff}
footer li i{color:var(--mint);width:20px}
.footer-bottom{border-top:1px solid var(--line);padding:22px 0;display:flex;justify-content:space-between;gap:16px;flex-wrap:wrap;font-size:13px;color:var(--faint)}
.to-top{position:fixed;right:22px;bottom:22px;z-index:55;width:46px;height:46px;border-radius:50%;border:none;background:#fff;color:var(--t700);font-size:16px;cursor:pointer;box-shadow:0 8px 22px rgba(0,0,0,.3);opacity:0;pointer-events:none;transform:translateY(10px);transition:opacity .25s,transform .25s}
.to-top.show{opacity:1;pointer-events:auto;transform:none}


/* Scroll effects */
.progress{position:absolute;left:0;bottom:-1px;width:100%;height:3px;transform:scaleX(0);transform-origin:left;background:linear-gradient(90deg,var(--t500),var(--mint),#fff);box-shadow:0 0 12px rgba(143,242,227,.7)}
.rv{opacity:0;transform:translateY(30px);transition:opacity .8s cubic-bezier(.2,.7,.2,1),transform .8s cubic-bezier(.2,.7,.2,1);transition-delay:var(--d,0s)}
.rv.in{opacity:1;transform:none}
.card::before,.info-card::before{content:"";position:absolute;inset:0;border-radius:inherit;background:radial-gradient(340px circle at var(--mx,50%) var(--my,50%),rgba(143,242,227,.15),transparent 60%);opacity:0;transition:opacity .3s;pointer-events:none}
.card:hover::before,.info-card:hover::before{opacity:1}
.step{transition:border-color .4s,background .4s}
.step .icon{transition:background .4s,color .4s}
.step.on{border-color:rgba(143,242,227,.55)}
.step.on .icon{background:var(--mint);color:var(--t950)}
.step.on .num{color:var(--mint)}
.scroll-cue{position:absolute;left:50%;bottom:26px;z-index:4;transform:translateX(-50%);width:46px;height:46px;border-radius:50%;border:1px solid var(--line);background:rgba(4,47,43,.5);backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);display:grid;place-items:center;color:#fff;text-decoration:none;transition:opacity .3s}
.scroll-cue i{animation:bob 1.8s ease-in-out infinite}
.scroll-cue.hide{opacity:0;pointer-events:none}
@@keyframes bob{50%{transform:translateY(5px)}}

/* Hero entrance: the one orchestrated page-load moment */
@@keyframes rise{from{opacity:0;transform:translateY(22px)}to{opacity:1;transform:none}}
.hero-inner>*{animation:rise .7s ease both}
.hero-inner>:nth-child(2){animation-delay:.1s}
.hero-inner>:nth-child(3){animation-delay:.2s}
.hero-inner>:nth-child(4){animation-delay:.3s}
.hero-inner>:nth-child(5){animation-delay:.4s}

@@media (max-width:1000px){
.hero{min-height:0;padding:80px 0 120px}
.cards{grid-template-columns:repeat(2,1fr)}
.info-grid{grid-template-columns:1fr}
.steps{grid-template-columns:repeat(2,1fr)}
.steps::before{display:none}
.glass-stats{grid-template-columns:repeat(2,1fr)}
.footer-main{grid-template-columns:1fr 1fr;gap:40px;padding:56px 0 40px}
.tab-panel{grid-template-columns:1fr;padding:30px 26px}
section.block{padding:76px 0}
.cta{padding-bottom:76px}
.cinema{min-height:0;padding:90px 0 110px}
.burger{display:inline-grid;place-items:center}
.nav-links{position:absolute;top:74px;left:0;right:0;flex-direction:column;align-items:stretch;gap:0;padding:8px 5% 20px;background:var(--t900);border-bottom:1px solid var(--line);display:none}
.nav-links.open{display:flex}
.nav-links a:not(.btn){padding:14px 0;border-bottom:1px solid var(--line)}
.nav-links .btn{margin-top:16px}
}
@@media (max-width:600px){
.cards,.steps,.footer-main{grid-template-columns:1fr}
.card.wide{grid-column:auto;grid-template-columns:1fr}
.card.wide .icon{margin-bottom:20px}
.topbar .group:last-child{display:none}
.cta-box{padding:52px 22px}
.trust{border-radius:22px;padding:16px 22px}
}
@@media (prefers-reduced-motion:reduce){
html{scroll-behavior:auto}
.hero-inner>*,.hero video,.cinema video,.scroll-cue i{animation:none}
}
</style>
</head>
<body>
<a class="skip" href="#services">Skip to content</a>

<div class="topbar">
  <div class="wrap">
    <div class="group">
      <a href="tel:+27824763347"><i class="fa-solid fa-phone"></i> 082 476 3347</a>
      <a href="mailto:LabDashSupport@@gmail.com"><i class="fa-solid fa-envelope"></i> LabDashSupport@@gmail.com</a>
    </div>
    <div class="group"><span><i class="fa-solid fa-clock"></i> Mon to Fri: 07:00 to 17:00</span></div>
  </div>
</div>

<header class="nav" id="nav">
  <div class="wrap">
    <a href="#top" class="brand" aria-label="LabDash home">
      <span class="logo-mark"><img src="@Url.Content("~/images/labdash-logo.png")" alt="" onerror="this.parentNode.classList.add('no-img');this.parentNode.parentNode.classList.add('no-img');this.remove();" /><i class="fa-solid fa-flask-vial"></i></span>
      <span class="brand-text">LabDash</span>
    </a>
    <button class="burger" id="burger" aria-label="Open menu" aria-expanded="false" aria-controls="navLinks"><i class="fa-solid fa-bars"></i></button>
    <nav class="nav-links" id="navLinks" aria-label="Main navigation">
      <a href="#services">Services</a>
      <a href="#workflow">How it works</a>
      <a href="#roles">Who it is for</a>
      <a href="#locations">Locations</a>
      <a href="#faq">FAQ</a>
      <a href="#contact">Contact</a>
      <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Log in</a>
    </nav>
  </div>
  <div class="progress" id="progress" aria-hidden="true"></div>
</header>

<section class="hero" id="top">
  <video class="bg-video" id="heroVideo" autoplay muted loop playsinline preload="auto" aria-hidden="true">
      <source src="@Url.Content("~/videos/lab-hero.mp4")" type="video/mp4" />
  </video>
  <div class="hero-inner">
    <span class="badge"><b>New</b> Share only the results you choose</span>
    <h1>See your lab results as soon as they are verified.</h1>
    <p class="lead">Request tests, follow them through the laboratory and share the results you choose with your doctor, all in one secure portal.</p>
    <div class="buttons">
      <a asp-controller="Account" asp-action="Login" class="btn btn-primary"><i class="fa-solid fa-right-to-bracket"></i> Log in to your portal</a>
      <a asp-controller="Account" asp-action="Register" class="btn btn-outline"><i class="fa-solid fa-user-plus"></i> Create patient account</a>
    </div>
    <div class="trust">
      <span><i class="fa-solid fa-shield-halved"></i> Secure access</span>
