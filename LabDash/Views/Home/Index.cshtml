@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}




<head>

    <meta charset="utf-8" />

    <title>Medical Laboratory System</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: Arial,sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: linear-gradient( 135deg, #0d766e, #0a5f58);
                color: white;
            }

            .container {
                width: 90%;
                max-width: 1300px;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 40px;
                align-items: center;
            }

            .content h1 {
                font-size: 55px;
                margin-bottom: 20px;
            }

            .content p {
                font-size: 18px;
                line-height: 1.8;
                margin-bottom: 30px;
            }

            .buttons {
                display: flex;
                gap: 20px;
            }

            .btn {
                padding: 15px 35px;
                border-radius: 30px;
                text-decoration: none;
                font-weight: bold;
                transition: .4s;
            }

            .login-btn {
                background: white;
                color: #0d766e;
            }

            .signup-btn {
                background: #1d4ed8;
                color: white;
            }

            .btn:hover {
                transform: translateY(-5px);
            }

            .image-box img {
                width: 100%;
                border-radius: 25px;
            }

    </style>

</head>


    <div class="container">

        <div class="content">

            <h1>
                Medical Laboratory System
            </h1>

            <p>

                Streamline patient management,
                laboratory testing,
                reporting and verification
                in one intelligent healthcare platform.

            </p>

            <div class="buttons">

            <a asp-controller="Account"
               asp-action="Login"
               class="btn login-btn">
                Login
            </a>

                @*  <a asp-controller="Home"
                   asp-action="SelectRole"
                   class="btn signup-btn">

                    Sign Up

                </a> *@

            </div>

        </div>


        <div class="image-box">

            <img src="https://www.lighthouselabservices.com/wp-content/uploads/2022/06/Good-LIS-Software-Solutions.png" />

        </div>

    </div>




