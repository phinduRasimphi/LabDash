@{
    ViewData["Title"] = "Home Page";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>LABDASH | Medical Laboratory System</title>

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>
            :root {
                --teal-950: #053833;
                --teal-900: #07463f;
                --teal-800: #095a52;
                --teal-700: #0a6a61;
                --teal-600: #0d766e;
                --teal-500: #12918a;
                --mint: #8ff2e3;
                --text: #ffffff;
                --text-soft: rgba(255, 255, 255, .78);
                --text-faint: rgba(255, 255, 255, .6);
                --glass: rgba(255, 255, 255, .07);
                --glass-strong: rgba(255, 255, 255, .12);
                --border: rgba(255, 255, 255, .16);
                --radius: 16px;
            }

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
            }

            html {
                scroll-behavior: smooth;
            }

            body {
                font-family: 'Inter', Arial, sans-serif;
                background: var(--teal-800);
                color: var(--text);
                line-height: 1.65;
                -webkit-font-smoothing: antialiased;
            }

            a:focus-visible, .btn:focus-visible {
                outline: 3px solid var(--mint);
                outline-offset: 3px;
            }

            .wrap {
                width: 90%;
                max-width: 1200px;
                margin: 0 auto;
            }

            /* ---------- Utility bar ---------- */
            .topbar {
                background: var(--teal-950);
                color: var(--text-soft);
                font-size: 13px;
            }

                .topbar .wrap {
                    display: flex;
                    justify-content: space-between;
                    align-items: center;
                    gap: 20px;
                    min-height: 42px;
                    flex-wrap: wrap;
                }

                .topbar .group {
                    display: flex;
                    gap: 28px;
                    flex-wrap: wrap;
                }

                .topbar span, .topbar a {
                    display: inline-flex;
                    align-items: center;
                    gap: 8px;
                    color: inherit;
                    text-decoration: none;
                }

                    .topbar a:hover {
                        color: #fff;
                    }

                .topbar i {
                    color: var(--mint);
                    font-size: 12px;
                }

            /* ---------- Navbar ---------- */
            .nav {
                position: sticky;
                top: 0;
                z-index: 50;
                background: rgba(7, 70, 63, .94);
                backdrop-filter: blur(10px);
                border-bottom: 1px solid var(--border);
            }

                .nav .wrap {
                    display: flex;
                    align-items: center;
                    justify-content: space-between;
                    height: 78px;
                }

            .brand {
                display: flex;
                align-items: center;
                gap: 12px;
                text-decoration: none;
                color: #fff;
                font-weight: 800;
                font-size: 21px;
                letter-spacing: .8px;
            }

                .brand i {
                    width: 40px;
                    height: 40px;
                    display: grid;
                    place-items: center;
                    border-radius: 10px;
                    background: var(--teal-500);
                    color: #fff;
                    font-size: 17px;
                }

            .nav-links {
                display: flex;
                align-items: center;
                gap: 36px;
            }

                .nav-links a:not(.btn) {
                    color: var(--text-soft);
                    text-decoration: none;
                    font-weight: 500;
                    font-size: 15px;
                    transition: color .2s;
                }

                    .nav-links a:not(.btn):hover {
                        color: #fff;
                    }

            /* ---------- Buttons ---------- */
            .btn {
                display: inline-flex;
                align-items: center;
                justify-content: center;
                gap: 10px;
                padding: 14px 30px;
                border-radius: 10px;
                text-decoration: none;
                font-weight: 600;
                font-size: 15px;
                border: 1.5px solid transparent;
                transition: background .2s, transform .2s, box-shadow .2s, border-color .2s;
            }

                .btn:hover {
                    transform: translateY(-2px);
                }

            /* Light button on teal gives strong contrast for the primary action */
            .btn-primary {
                background: #fff;
                color: var(--teal-700);
                box-shadow: 0 8px 20px rgba(0, 0, 0, .22);
            }

                .btn-primary:hover {
                    background: #e9fbf8;
                }

            .btn-outline {
                border-color: rgba(255, 255, 255, .45);
                color: #fff;
                background: transparent;
            }

                .btn-outline:hover {
                    background: var(--glass-strong);
                    border-color: #fff;
                }

            .btn-sm {
                padding: 10px 22px;
                font-size: 14px;
            }

            /* ---------- Hero ---------- */
            .hero {
                background: linear-gradient(135deg, var(--teal-600) 0%, var(--teal-800) 55%, var(--teal-900) 100%);
                padding: 100px 0 116px;
            }

                .hero .wrap {
                    display: grid;
                    grid-template-columns: 1.05fr .95fr;
                    gap: 88px;
                    align-items: center;
                }

            .eyebrow {
                display: inline-flex;
                align-items: center;
                gap: 10px;
                color: var(--mint);
                font-size: 13px;
                font-weight: 700;
                letter-spacing: 1.6px;
                text-transform: uppercase;
                margin-bottom: 22px;
            }

                .eyebrow::before {
                    content: "";
                    width: 28px;
                    height: 2px;
                    background: var(--mint);
                }

            .hero h1 {
                font-size: clamp(36px, 4.6vw, 58px);
                line-height: 1.1;
                font-weight: 800;
                letter-spacing: -1px;
                margin-bottom: 24px;
            }

                .hero h1 span {
                    color: var(--mint);
                }

            .hero p.lead {
                font-size: 18px;
                color: var(--text-soft);
                max-width: 530px;
                margin-bottom: 38px;
            }

            .buttons {
                display: flex;
                flex-wrap: wrap;
                gap: 16px;
            }

            .trust {
                display: flex;
                flex-wrap: wrap;
                gap: 14px 32px;
                margin-top: 48px;
                padding-top: 30px;
                border-top: 1px solid var(--border);
            }

                .trust span {
                    display: inline-flex;
                    align-items: center;
                    gap: 10px;
                    font-size: 14px;
                    font-weight: 500;
                    color: var(--text-soft);
                }

                .trust i {
                    color: var(--mint);
                }

            .image-box img {
                width: 100%;
                display: block;
                border-radius: 20px;
                border: 1px solid var(--border);
                box-shadow: 0 28px 64px rgba(0, 0, 0, .32);
            }

            /* ---------- Sections ---------- */
            section.block {
                padding: 108px 0;
            }

            .block.workflow {
                background: var(--teal-800);
            }

            .block.contact {
                background: var(--teal-900);
            }

            .section-head {
                max-width: 640px;
                margin: 0 auto 64px;
                text-align: center;
            }

                .section-head .eyebrow {
                    justify-content: center;
                }

                    .section-head .eyebrow::before {
                        display: none;
                    }

                .section-head h2 {
                    font-size: clamp(28px, 3.2vw, 38px);
                    line-height: 1.2;
                    letter-spacing: -.5px;
                    margin-bottom: 14px;
                }

                .section-head p {
                    color: var(--text-soft);
                    font-size: 17px;
                }

            /* ---------- Workflow ---------- */
            .steps {
                display: grid;
                grid-template-columns: repeat(4, 1fr);
                gap: 28px;
            }

            .step {
                background: var(--glass);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 34px 28px 32px;
                position: relative;
                transition: background .25s, transform .25s, border-color .25s;
            }

                .step:hover {
                    background: var(--glass-strong);
                    transform: translateY(-4px);
                    border-color: rgba(255, 255, 255, .3);
                }

                .step .num {
                    position: absolute;
                    top: 24px;
                    right: 26px;
                    font-size: 13px;
                    font-weight: 700;
                    color: var(--text-faint);
                    letter-spacing: 1px;
                }

                .step .icon {
                    width: 52px;
                    height: 52px;
                    display: grid;
                    place-items: center;
                    border-radius: 12px;
                    background: var(--teal-500);
                    color: #fff;
                    font-size: 20px;
                    margin-bottom: 22px;
                }

                .step h3 {
                    font-size: 18px;
                    margin-bottom: 8px;
                }

                .step p {
                    font-size: 15px;
                    color: var(--text-soft);
                }

            /* ---------- Contact ---------- */
            .info-grid {
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 28px;
            }

            .info-card {
                background: var(--glass);
                border: 1px solid var(--border);
                border-radius: var(--radius);
                padding: 38px 34px;
            }

            .card-title {
                display: flex;
                align-items: center;
                gap: 14px;
                margin-bottom: 26px;
                padding-bottom: 22px;
                border-bottom: 1px solid var(--border);
            }

                .card-title .icon {
                    width: 46px;
                    height: 46px;
                    display: grid;
                    place-items: center;
                    border-radius: 12px;
                    background: var(--teal-500);
                    color: #fff;
                    font-size: 18px;
                }

                .card-title h3 {
                    font-size: 19px;
                }

            .info-card address {
                font-style: normal;
                color: var(--text-soft);
                line-height: 1.9;
            }

                .info-card address strong {
                    color: #fff;
                }

            .link {
                color: var(--mint);
                font-weight: 600;
                text-decoration: none;
            }

                .link:hover {
                    text-decoration: underline;
                }

            .map-link {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                margin-top: 22px;
            }

            .contact-list {
                list-style: none;
                display: grid;
                gap: 22px;
            }

                .contact-list li {
                    display: flex;
                    align-items: center;
                    gap: 16px;
                }

                .contact-list .ci {
                    width: 42px;
                    height: 42px;
                    flex-shrink: 0;
                    display: grid;
                    place-items: center;
                    border-radius: 10px;
                    background: var(--glass-strong);
                    color: var(--mint);
                }

                .contact-list small {
                    display: block;
                    font-size: 11.5px;
                    font-weight: 600;
                    letter-spacing: .9px;
                    text-transform: uppercase;
                    color: var(--text-faint);
                }

            .hours {
                list-style: none;
            }

                .hours li {
                    display: flex;
                    justify-content: space-between;
                    gap: 16px;
                    padding: 15px 0;
                    border-bottom: 1px solid var(--border);
                    color: var(--text-soft);
                    font-size: 15px;
                }

                    .hours li:first-child {
                        padding-top: 0;
                    }

                    .hours li:last-child {
                        border-bottom: none;
                        padding-bottom: 0;
                    }

                .hours strong {
                    color: #fff;
                    font-weight: 600;
                }

                .hours .closed strong {
                    color: #ffb4a8;
                }

            /* ---------- Footer ---------- */
            footer {
                background: var(--teal-950);
                color: var(--text-soft);
                font-size: 14px;
            }

            .footer-main {
                display: grid;
                grid-template-columns: 1.4fr 1fr 1fr;
                gap: 56px;
                padding: 72px 0 56px;
            }

            footer .brand {
                margin-bottom: 18px;
            }

            footer p {
                max-width: 340px;
                line-height: 1.8;
            }

            footer h4 {
                color: #fff;
                font-size: 15px;
                margin-bottom: 18px;
            }

            footer ul {
                list-style: none;
                display: grid;
                gap: 12px;
            }

            footer a {
                color: inherit;
                text-decoration: none;
            }

                footer a:hover {
                    color: #fff;
                }

            footer li i {
                color: var(--mint);
                width: 20px;
            }

            .footer-bottom {
                border-top: 1px solid var(--border);
                padding: 24px 0;
                display: flex;
                justify-content: space-between;
                gap: 16px;
                flex-wrap: wrap;
                font-size: 13px;
                color: var(--text-faint);
            }

            /* ---------- Responsive ---------- */
            @@media (max-width: 1000px) {
                .hero {
                    padding: 64px 0 80px;
                }

                    .hero .wrap {
                        grid-template-columns: 1fr;
                        gap: 56px;
                    }

                .steps {
                    grid-template-columns: repeat(2, 1fr);
                }

                .info-grid {
                    grid-template-columns: 1fr;
                }

                .footer-main {
                    grid-template-columns: 1fr;
                    gap: 40px;
                    padding: 56px 0 40px;
                }

                .nav-links a:not(.btn) {
                    display: none;
                }

                section.block {
                    padding: 80px 0;
                }
            }

            @@media (max-width: 600px) {
                .steps {
                    grid-template-columns: 1fr;
                }

                .topbar .group:last-child {
                    display: none;
                }
            }
    </style>
</head>

<body>

    <!-- Utility bar -->
    <div class="topbar">
        <div class="wrap">
            <div class="group">
                <a href="tel:+270000000000"><i class="fa-solid fa-phone"></i> +27 00 000 0000</a>
                <a href="mailto:info@@labdash.example"><i class="fa-solid fa-envelope"></i> info@@labdash.example</a>
            </div>
            <div class="group">
                <span><i class="fa-solid fa-clock"></i> Mon – Fri: 07:00 – 17:00</span>
            </div>
        </div>
    </div>

    <!-- Navbar -->
    <header class="nav">
        <div class="wrap">
            <a href="#" class="brand" aria-label="LabDash home">
                <i class="fa-solid fa-flask-vial"></i> LABDASH
            </a>
            <nav class="nav-links" aria-label="Main navigation">
                <a href="#workflow">How it works</a>
                <a href="#contact">Contact</a>
                <a asp-controller="Account" asp-action="Login" class="btn btn-primary btn-sm">Login</a>
            </nav>
        </div>
    </header>

    <!-- Hero -->
    <section class="hero">
        <div class="wrap">

            <div class="content">
                <div class="eyebrow">Laboratory Information System</div>

                <h1>Medical Laboratory <span>System</span></h1>

                <p class="lead">
                    Streamline patient management, laboratory testing,
                    reporting and verification in one intelligent
                    healthcare platform.
                </p>

                <div class="buttons">
                    <a asp-controller="Account" asp-action="Login" class="btn btn-primary">
                        <i class="fa-solid fa-right-to-bracket"></i> Login to Portal
                    </a>
                    <a href="#contact" class="btn btn-outline">
                        <i class="fa-solid fa-location-dot"></i> Visit Our Lab
                    </a>

                    @*  <a asp-controller="Home"
                           asp-action="SelectRole"
                           class="btn signup-btn">
                            Sign Up
                        </a> *@
                </div>

                <div class="trust">
                    <span><i class="fa-solid fa-shield-halved"></i> Secure access</span>
                    <span><i class="fa-solid fa-circle-check"></i> Verified results</span>
                    <span><i class="fa-solid fa-file-medical"></i> Accurate reporting</span>
                </div>
            </div>

            <div class="image-box">
                <img src="https://www.lighthouselabservices.com/wp-content/uploads/2022/06/Good-LIS-Software-Solutions.png"
                     alt="Laboratory information system dashboard" />
            </div>

        </div>
    </section>

    <!-- Workflow -->
    <section class="block workflow" id="workflow">
        <div class="wrap">

            <div class="section-head">
                <div class="eyebrow">How it works</div>
                <h2>One platform for the entire lab workflow</h2>
                <p>From the moment a patient is registered to the final verified report, every step is tracked in one place.</p>
            </div>

            <div class="steps">
                <div class="step">
                    <span class="num">01</span>
                    <div class="icon"><i class="fa-solid fa-user-plus"></i></div>
                    <h3>Patient Management</h3>
                    <p>Register patients and capture requests quickly and accurately.</p>
                </div>
                <div class="step">
                    <span class="num">02</span>
                    <div class="icon"><i class="fa-solid fa-vial"></i></div>
                    <h3>Laboratory Testing</h3>
                    <p>Track samples and record test results as work moves through the lab.</p>
                </div>
                <div class="step">
                    <span class="num">03</span>
                    <div class="icon"><i class="fa-solid fa-clipboard-check"></i></div>
                    <h3>Verification</h3>
                    <p>Review and approve results before they are released.</p>
                </div>
                <div class="step">
                    <span class="num">04</span>
                    <div class="icon"><i class="fa-solid fa-file-medical"></i></div>
                    <h3>Reporting</h3>
                    <p>Produce clear, consistent reports for clinicians and patients.</p>
                </div>
            </div>

        </div>
    </section>

    <!-- Lab information -->
    <section class="block contact" id="contact">
        <div class="wrap">

            <div class="section-head">
                <div class="eyebrow">Contact us</div>
                <h2>Find our laboratory</h2>
                <p>Visit us, call ahead or send an email. Our team is happy to assist with enquiries.</p>
            </div>

            <div class="info-grid">

                <div class="info-card">
                    <div class="card-title">
                        <div class="icon"><i class="fa-solid fa-location-dot"></i></div>
                        <h3>Location</h3>
                    </div>
                    <address>
                        <strong>LabDash Medical Laboratory</strong><br />
                        123 Example Street<br />
                        Suburb, City, 0000<br />
                        South Africa
                    </address>
                    <a class="link map-link"
                       href="https://www.google.com/maps/search/?api=1&query=123+Example+Street+City"
                       target="_blank" rel="noopener">
                        <i class="fa-solid fa-diamond-turn-right"></i> Get directions
                    </a>
                </div>

                <div class="info-card">
                    <div class="card-title">
                        <div class="icon"><i class="fa-solid fa-headset"></i></div>
                        <h3>Contact Details</h3>
                    </div>
                    <ul class="contact-list">
                        <li>
                            <span class="ci"><i class="fa-solid fa-phone"></i></span>
                            <div><small>Phone</small><a class="link" href="tel:+270000000000">+27 00 000 0000</a></div>
                        </li>
                        <li>
                            <span class="ci"><i class="fa-brands fa-whatsapp"></i></span>
                            <div><small>WhatsApp</small><a class="link" href="https://wa.me/270000000000" target="_blank" rel="noopener">+27 00 000 0000</a></div>
                        </li>
                        <li>
                            <span class="ci"><i class="fa-solid fa-envelope"></i></span>
                            <div><small>Email</small><a class="link" href="mailto:info@@labdash.example">info@@labdash.example</a></div>
                        </li>
                    </ul>
                </div>

                <div class="info-card">
                    <div class="card-title">
                        <div class="icon"><i class="fa-solid fa-clock"></i></div>
                        <h3>Operating Hours</h3>
                    </div>
                    <ul class="hours">
                        <li><span>Monday – Friday</span><strong>07:00 – 17:00</strong></li>
                        <li><span>Saturday</span><strong>08:00 – 13:00</strong></li>
                        <li class="closed"><span>Sunday</span><strong>Closed</strong></li>
                        <li class="closed"><span>Public Holidays</span><strong>Closed</strong></li>
                    </ul>
                </div>

            </div>
        </div>
    </section>

    <!-- Footer -->
    <footer>
        <div class="wrap">
            <div class="footer-main">
                <div>
                    <a href="#" class="brand"><i class="fa-solid fa-flask-vial"></i> LABDASH</a>
                    <p>A secure, integrated platform for patient management, laboratory testing, verification and reporting.</p>
                </div>
                <div>
                    <h4>Quick Links</h4>
                    <ul>
                        <li><a href="#workflow">How it works</a></li>
                        <li><a href="#contact">Contact</a></li>
                        <li><a asp-controller="Account" asp-action="Login">Staff Login</a></li>
                    </ul>
                </div>
                <div>
                    <h4>Get in touch</h4>
                    <ul>
                        <li><i class="fa-solid fa-location-dot"></i> 123 Example Street, City</li>
                        <li><i class="fa-solid fa-phone"></i> +27 00 000 0000</li>
                        <li><i class="fa-solid fa-envelope"></i> info@@labdash.example</li>
                    </ul>
                </div>
            </div>
            <div class="footer-bottom">
                <span>&copy; @DateTime.Now.Year LabDash Medical Laboratory System. All rights reserved.</span>
                <span>Confidential patient data is handled securely.</span>
            </div>
        </div>
    </footer>

</body>
</html>