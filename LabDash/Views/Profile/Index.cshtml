@model LabDash.Models.ViewModels.ProfileViewModel

@{
    ViewData["Title"] = "My Profile";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="dashboard-page">

    <!-- PAGE HEADER -->
    <div style="
        background:white;
        padding:25px;
        border-radius:15px;
        margin-bottom:25px;
        box-shadow:0 2px 10px rgba(0,0,0,.05);">

        <h2 style="color:#0d766e;">

            <i class="fa-solid fa-user-circle"></i>

            My Profile

        </h2>

        <p style="color:gray;margin-top:8px;margin-bottom:0;">

            Update your personal information or change your password.

        </p>

    </div>


    <!-- SUCCESS MESSAGE -->
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">

            <i class="fa-solid fa-circle-check"></i>

            @TempData["Success"]

        </div>
    }


    <!-- ERROR MESSAGE -->
    @if (!ViewData.ModelState.IsValid)
    {
        <div class="alert alert-danger">

            <div asp-validation-summary="All"></div>

        </div>
    }


    <div class="row g-4">

        <!-- =========================================================
             PROFILE INFORMATION
             ========================================================= -->

        <div class="col-lg-7">

            <div class="records-box">

                <div style="
                    padding:20px;
                    border-bottom:1px solid #eee;">

                    <h4 style="color:#0d766e;margin:0;">

                        <i class="fa-solid fa-id-card"></i>

                        Personal Information

                    </h4>

                    <small style="color:#777;">

                        Update your account details below.

                    </small>

                </div>


                <div style="padding:25px;">

                    <form asp-controller="Profile"
                          asp-action="UpdateProfile"
                          method="post">

                        @Html.AntiForgeryToken()


                        @* <!-- USERNAME -->

                        <div class="mb-3">

                            <label class="form-label">
                                Username
                            </label>

                            <input class="form-control"
                                   value="@Model.UserName"
                                   readonly />

                            <small class="text-muted">
                                Username cannot be changed.
                            </small>

                        </div> *@


                        <div class="row">

                            <!-- FIRST NAME -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="FirstName"
                                       class="form-label"></label>

                                <input asp-for="FirstName"
                                       class="form-control" />

                                <span asp-validation-for="FirstName"
                                      class="text-danger"></span>

                            </div>


                            <!-- LAST NAME -->

                            <div class="col-md-6 mb-3">

                                <label asp-for="LastName"
                                       class="form-label"></label>

                                <input asp-for="LastName"
                                       class="form-control" />

                                <span asp-validation-for="LastName"
                                      class="text-danger"></span>

                            </div>

                        </div>


                        <!-- EMAIL -->

                        <div class="mb-3">

                            <label asp-for="Email"
                                   class="form-label"></label>

                            <input asp-for="Email"
                                   class="form-control" />

                            <span asp-validation-for="Email"
                                  class="text-danger"></span>

                        </div>


                        <!-- PHONE -->

                        <div class="mb-3">

                            <label asp-for="PhoneNumber"
                                   class="form-label"></label>

                            <input asp-for="PhoneNumber"
                                   class="form-control" />

                            <span asp-validation-for="PhoneNumber"
                                  class="text-danger"></span>

                        </div>


                        <!-- GENDER -->

                        <div class="mb-3">

                            <label asp-for="Gender"
                                   class="form-label"></label>

                            <select asp-for="Gender"
                                    class="form-select">

                                <option value="">
                                    Select Gender
                                </option>

                                <option value="Male">
                                    Male
                                </option>

                                <option value="Female">
                                    Female
                                </option>

                                <option value="Other">
                                    Other
                                </option>

                            </select>

                            <span asp-validation-for="Gender"
                                  class="text-danger"></span>

                        </div>


                        <!-- ROLE -->

                        <div class="mb-3">

                            <label class="form-label">
                                Role
                            </label>

                            <input class="form-control"
                                   value="Lab Technician"
                                   readonly />

                        </div>


                        <!-- ACCOUNT CREATED -->

                        <div class="mb-4">

                            <label class="form-label">
                                Account Created
                            </label>

                            <input class="form-control"
                                   value="@Model.AccountCreated.ToString("dd MMMM yyyy")"
                                   readonly />

                        </div>


                        <!-- SAVE -->

                        <button type="submit"
                                class="btn btn-success">

                            <i class="fa-solid fa-floppy-disk"></i>

                            Save Profile Changes

                        </button>

                    </form>

                </div>

            </div>

        </div>


        <!-- =========================================================
             CHANGE PASSWORD
             ========================================================= -->

        <div class="col-lg-5">

            <div class="records-box">

                <div style="
                    padding:20px;
                    border-bottom:1px solid #eee;">

                    <h4 style="color:#0d766e;margin:0;">

                        <i class="fa-solid fa-lock"></i>

                        Change Password

                    </h4>

                    <small style="color:#777;">

                        Keep your account secure by using a strong password.

                    </small>

                </div>


                <div style="padding:25px;">

                    <form asp-controller="Profile"
                          asp-action="ChangePassword"
                          method="post">

                        @Html.AntiForgeryToken()


                        <!-- CURRENT PASSWORD -->

                        <div class="mb-3">

                            <label asp-for="CurrentPassword"
                                   class="form-label"></label>

                            <input asp-for="CurrentPassword"
                                   class="form-control"
                                   autocomplete="current-password" />

                            <span asp-validation-for="CurrentPassword"
                                  class="text-danger"></span>

                        </div>


                        <!-- NEW PASSWORD -->

                        <div class="mb-3">

                            <label asp-for="NewPassword"
                                   class="form-label"></label>

                            <input asp-for="NewPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="NewPassword"
                                  class="text-danger"></span>

                        </div>


                        <!-- CONFIRM PASSWORD -->

                        <div class="mb-4">

                            <label asp-for="ConfirmPassword"
                                   class="form-label"></label>

                            <input asp-for="ConfirmPassword"
                                   class="form-control"
                                   autocomplete="new-password" />

                            <span asp-validation-for="ConfirmPassword"
                                  class="text-danger"></span>

                        </div>


                        <button type="submit"
                                class="btn btn-success w-100">

                            <i class="fa-solid fa-key"></i>

                            Change Password

                        </button>

                    </form>

                </div>

            </div>

        </div>

    </div>

</div>


@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}