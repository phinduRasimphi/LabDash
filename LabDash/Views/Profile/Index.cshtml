@model LabDash.Models.ViewModels.ProfileViewModel

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "My Profile";
    ViewData["ActivePage"] = "Profile";

    var initials = (
        (Model.FirstName?.Trim().FirstOrDefault().ToString() ?? "") +
        (Model.LastName?.Trim().FirstOrDefault().ToString() ?? "")
    ).ToUpperInvariant();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&family=IBM+Plex+Mono:wght@500;600&display=swap" rel="stylesheet">

<div class="p-wrap">

    <!-- =========================================================
         HEADER
         ========================================================= -->
    <div class="p-banner">
        <div class="p-banner-pattern"></div>

        <div class="p-banner-left">
            <div class="p-banner-avatar">
                <span class="p-icon-ring"></span>
                @initials
            </div>

            <div class="p-banner-text">
                <h1>My Profile</h1>

                <p>Manage your personal information and keep your account secure.</p>

                <div class="p-pills">
                    <span class="p-pill">
                        <i class="fas fa-user"></i>
                        @Model.FullName
                    </span>

                    @if (!string.IsNullOrWhiteSpace(Model.EmployeeNumber))
                    {
                        <span class="p-pill">
                            <i class="fas fa-id-badge"></i>
                            Employee No: @Model.EmployeeNumber
                        </span>
                    }

                    <span class="p-pill">
                        <i class="fas fa-microscope"></i>
                        Lab Technician
                    </span>

                    <span class="p-pill">
                        <i class="fas fa-calendar-day"></i>
                        Member since @Model.AccountCreated.ToString("MMM yyyy")
                    </span>
                </div>
            </div>
        </div>

       <a href="@Url.Action("ChangePassword", "Account")"
           class="p-banner-cta">

            <i class="fas fa-key"></i>
            Change Password

        </a>
    </div>


    <!-- =========================================================
         MESSAGES
         ========================================================= -->
    @if (TempData["Success"] != null)
    {
        <div class="p-toast">
            <i class="fas fa-check-circle"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    @if (!ViewData.ModelState.IsValid)
    {
        <div class="p-toast p-toast-error p-toast-block">
            <i class="fas fa-circle-exclamation"></i>
            <div asp-validation-summary="All" class="p-validation-list"></div>
        </div>
    }


    <!-- =========================================================
         LOCKED INFORMATION NOTICE
         ========================================================= -->
    <div class="p-status-strip">
        <div class="p-status-left">
            <span class="p-status-dot"></span>

            <span>
                <strong>Locked fields</strong>
                &middot;
                Employee number, ID number, gender, role and account creation date can only be changed by a system administrator
            </span>
        </div>

        <i class="fas fa-lock"></i>
    </div>


    <!-- =========================================================
         PERSONAL INFORMATION
         ========================================================= -->
    <form asp-controller="Profile" asp-action="UpdateProfile" method="post">

        @Html.AntiForgeryToken()

        <div class="p-panel">

            <div class="p-panel-head">
                <span>
                    <i class="fa-solid fa-address-card"></i>
                    Personal Information
                </span>

                <span class="p-panel-tag">Editable</span>
            </div>

            <div class="p-panel-body">

                <div class="p-grid-2">

                    <div class="p-field">
                        <label asp-for="FirstName">First Name</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="FirstName"
                                   class="p-input"
                                   maxlength="50"
                                   autocomplete="given-name"
                                   placeholder="Enter your first name" />
                        </div>

                        <span asp-validation-for="FirstName" class="p-field-error"></span>
                    </div>

                    <div class="p-field">
                        <label asp-for="LastName">Last Name</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-user"></i>
                            <input asp-for="LastName"
                                   class="p-input"
                                   maxlength="50"
                                   autocomplete="family-name"
                                   placeholder="Enter your last name" />
                        </div>

                        <span asp-validation-for="LastName" class="p-field-error"></span>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label asp-for="Email">E-mail</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-envelope"></i>
                            <input asp-for="Email" type="email" class="p-input" placeholder="Enter your email address" />
                        </div>

                        <span asp-validation-for="Email" class="p-field-error"></span>
                    </div>

                    <div class="p-field">
                        <label asp-for="PhoneNumber">Phone Number</label>

                        <div class="p-input-wrap">
                            <i class="fa-solid fa-mobile-screen"></i>
                            <input asp-for="PhoneNumber"
                                   type="tel"
                                   class="p-input"
                                   maxlength="10"
                                   inputmode="numeric"
                                   autocomplete="tel"
                                   placeholder="e.g. 0821234567" />
                        </div>

                        <span asp-validation-for="PhoneNumber" class="p-field-error"></span>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>
                            Gender
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-venus-mars"></i>
                            <input asp-for="Gender" class="p-input p-input-locked" readonly />
                        </div>
                    </div>

                    <div class="p-field">
                        <label>
                            Role
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-microscope"></i>
                            <input class="p-input p-input-locked" value="Lab Technician" readonly />
                        </div>
                    </div>

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>
                            Employee Number
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-id-badge"></i>
                            <input asp-for="EmployeeNumber" class="p-input p-input-locked" readonly />
                        </div>
                    </div>

                    @* <div class="p-field">
                        <label>
                            SA ID Number
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-fingerprint"></i>
                            <input asp-for="IDNumber" class="p-input p-input-locked" readonly />
                        </div>
                    </div> *@

                </div>


                <div class="p-grid-2">

                    <div class="p-field">
                        <label>
                            Account Created
                            <i class="fa-solid fa-lock p-lock-icon"></i>
                        </label>

                        <div class="p-input-wrap p-input-wrap-locked">
                            <i class="fa-solid fa-calendar-day"></i>
                            <input class="p-input p-input-locked"
                                   value="@Model.AccountCreated.ToString("dd MMMM yyyy")"
                                   readonly />
                        </div>
                    </div>

                </div>

                <button type="submit" class="p-submit">
                    <i class="fas fa-save"></i>
                    Save Profile Changes
                </button>

            </div>
        </div>

    </form>


    

    <!-- =========================================================
         FOOTER
         ========================================================= -->
    <div class="p-footer">

        <hr />

        <div class="p-footer-content">
            <i class="fa-solid fa-shield-halved"></i>
            <span>Laboratory Information Management System</span>
            <span class="p-footer-divider">|</span>
            <span>Lab Technician Portal</span>
            <span class="p-footer-divider">|</span>
            <span>@DateTime.Now.Year</span>
        </div>

    </div>

</div>


<!-- =============================================================
     STYLES
     ============================================================= -->
<style>

    :root {
        --p-paper: #F0F7F6;
        --p-raised: #FFFFFF;
        --p-ink: #102C27;
        --p-ink-soft: #52716C;
        --p-ink-faint: #8FA9A3;
        --p-line: #E1EEEC;
        --p-line-strong: #CCE3DF;
        --p-teal: #0E8C7F;
        --p-teal-deep: #0A5850;
        --p-teal-dim: #E3F4F1;
        --p-teal-grad-start: #12A392;
        --p-teal-grad-end: #0A4F48;
        --p-danger: #B0463F;
        --p-danger-dim: #FBECEA;
        --p-radius: 20px;
        --p-radius-sm: 13px;
        --p-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --p-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    html {
        scroll-behavior: smooth;
    }

    .p-wrap {
        max-width: 1000px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--p-ink);
        font-family: 'Inter', sans-serif;
        animation: pFadeIn .5s ease;
    }

    @@keyframes pFadeIn {
        from {
            opacity: 0;
            transform: translateY(12px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        html {
            scroll-behavior: auto;
        }

        .p-wrap, .p-icon-ring {
            animation: none;
        }
    }

    /* ===== BANNER ===== */

    .p-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        border-radius: var(--p-radius);
        padding: 32px 36px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
    }

    .p-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .p-banner-left {
        display: flex;
        align-items: center;
        gap: 22px;
        position: relative;
        z-index: 1;
    }

    .p-banner-avatar {
        position: relative;
        width: 76px;
        height: 76px;
        border-radius: 50%;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 24px;
        flex-shrink: 0;
    }

    .p-icon-ring {
        position: absolute;
        inset: -6px;
        border-radius: 50%;
        border: 1.5px solid rgba(255,255,255,.4);
        animation: pRingPulse 2.4s ease-out infinite;
    }

    @@keyframes pRingPulse {
        0% {
            transform: scale(0.9);
            opacity: .8;
        }

        100% {
            transform: scale(1.35);
            opacity: 0;
        }
    }

    .p-banner-text {
        position: relative;
        z-index: 1;
    }

        .p-banner-text h1 {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 26px;
            margin: 0 0 4px;
            color: #fff;
            letter-spacing: -.01em;
        }

        .p-banner-text p {
            margin: 0 0 14px;
            color: rgba(255,255,255,.85);
            font-size: 14.5px;
        }

    .p-pills {
        display: flex;
        gap: 10px;
        flex-wrap: wrap;
    }

    .p-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 15px;
        border-radius: 999px;
        background: rgba(255,255,255,.16);
        color: #fff;
        font-size: 12.5px;
        font-weight: 500;
    }

    .p-banner-cta {
        position: relative;
        z-index: 1;
        display: inline-flex;
        align-items: center;
        gap: 9px;
        white-space: nowrap;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.32);
        color: #fff;
        text-decoration: none;
        font-weight: 600;
        font-size: 13.5px;
        padding: 12px 20px;
        border-radius: 999px;
        transition: background .2s, transform .2s;
    }

        .p-banner-cta:hover {
            background: rgba(255,255,255,.24);
            color: #fff;
            text-decoration: none;
            transform: translateY(-2px);
        }

    /* ===== TOAST + STATUS ===== */

    .p-toast {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 15px 20px;
        border-radius: var(--p-radius-sm);
        margin-bottom: 20px;
        border-left: 4px solid var(--p-teal);
        font-size: 14px;
        font-weight: 500;
    }

    .p-toast-error {
        background: var(--p-danger-dim);
        color: var(--p-danger);
        border-left-color: var(--p-danger);
    }

    .p-toast-block {
        align-items: flex-start;
    }

        .p-toast-block i {
            margin-top: 3px;
        }

    .p-validation-list ul {
        margin: 0;
        padding-left: 18px;
    }

    .p-status-strip {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow-sm);
        padding: 16px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 22px;
        border-left: 4px solid var(--p-teal);
    }

    .p-status-left {
        display: flex;
        align-items: center;
        gap: 12px;
        font-size: 13.5px;
        color: var(--p-ink);
    }

        .p-status-left strong {
            color: var(--p-teal-deep);
        }

    .p-status-dot {
        width: 10px;
        height: 10px;
        border-radius: 50%;
        background: var(--p-teal);
        flex-shrink: 0;
        box-shadow: 0 0 0 4px var(--p-teal-dim);
    }

    .p-status-strip > i {
        color: var(--p-ink-faint);
        font-size: 15px;
    }

    /* ===== PANELS ===== */

    .p-panel {
        background: var(--p-raised);
        border-radius: var(--p-radius);
        box-shadow: var(--p-shadow);
        overflow: hidden;
    }

    .p-section-panel {
        margin-top: 22px;
        scroll-margin-top: 20px;
    }

    .p-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--p-line);
    }

        .p-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            color: var(--p-ink);
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .p-panel-head span:first-child i {
                color: var(--p-teal);
            }

    .p-panel-tag {
        font-weight: 600;
        font-size: 11.5px;
        background: var(--p-teal-dim);
        color: var(--p-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    .p-panel-body {
        padding: 28px 30px 32px;
    }

    /* ===== FIELDS ===== */

    .p-grid-2 {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 20px;
        margin-bottom: 22px;
    }

        .p-grid-2:last-of-type {
            margin-bottom: 0;
        }

    .p-field {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .p-field-spaced {
        margin-bottom: 22px;
    }

    .p-field label {
        display: flex;
        align-items: center;
        gap: 6px;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 13px;
        color: var(--p-ink);
        margin-bottom: 8px;
    }

    .p-lock-icon {
        font-size: 11px;
        color: var(--p-ink-faint);
    }

    .p-input-wrap {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--p-paper);
        border: 1.5px solid var(--p-line-strong);
        border-radius: var(--p-radius-sm);
        padding: 0 15px;
        transition: border-color .2s, box-shadow .2s, background .2s;
    }

        .p-input-wrap > i {
            color: var(--p-teal);
            font-size: 14px;
            flex-shrink: 0;
        }

        .p-input-wrap:focus-within {
            border-color: var(--p-teal);
            background: #fff;
            box-shadow: 0 0 0 4px var(--p-teal-dim);
        }

    .p-input-wrap-locked {
        background: var(--p-line);
        border-color: var(--p-line);
    }

        .p-input-wrap-locked > i {
            color: var(--p-ink-faint);
        }

    .p-input {
        flex: 1;
        min-width: 0;
        border: none;
        background: transparent;
        outline: none;
        padding: 12px 0;
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        color: var(--p-ink);
    }

        .p-input::placeholder {
            color: var(--p-ink-faint);
        }

    .p-input-locked {
        color: var(--p-ink-faint);
        cursor: not-allowed;
    }

    .p-select {
        appearance: auto;
        cursor: pointer;
    }

    .p-field-error {
        color: var(--p-danger);
        font-size: 12px;
        margin-top: 6px;
    }

    .p-eye {
        width: 30px;
        height: 30px;
        display: grid;
        place-items: center;
        border: 0;
        border-radius: 8px;
        background: transparent;
        color: var(--p-ink-faint);
        cursor: pointer;
        flex-shrink: 0;
        transition: background .2s, color .2s;
    }

        .p-eye:hover {
            background: var(--p-teal-dim);
            color: var(--p-teal);
        }

        .p-eye i {
            color: inherit;
            font-size: 13px;
        }

    /* ===== PASSWORD ===== */

    .p-strength {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 6px;
        margin-top: 10px;
    }

        .p-strength span {
            height: 5px;
            border-radius: 999px;
            background: var(--p-line-strong);
            transition: background .25s;
        }

        .p-strength[data-level="1"] span:nth-child(-n+1) {
            background: #C8574E;
        }

        .p-strength[data-level="2"] span:nth-child(-n+2) {
            background: #D9922E;
        }

        .p-strength[data-level="3"] span:nth-child(-n+3) {
            background: #6DAE5C;
        }

        .p-strength[data-level="4"] span:nth-child(-n+4) {
            background: var(--p-teal);
        }

    .p-strength-label {
        margin-top: 7px;
        font-size: 12px;
        color: var(--p-ink-soft);
        min-height: 16px;
    }

        .p-strength-label.ok {
            color: var(--p-teal-deep);
            font-weight: 600;
        }

        .p-strength-label.bad {
            color: var(--p-danger);
            font-weight: 600;
        }

    .p-pw-rules {
        list-style: none;
        display: flex;
        flex-wrap: wrap;
        gap: 8px 22px;
        margin: 22px 0 0;
        padding: 14px 16px;
        background: var(--p-paper);
        border-radius: var(--p-radius-sm);
        font-size: 12.5px;
        color: var(--p-ink-soft);
    }

        .p-pw-rules li {
            display: flex;
            align-items: center;
            gap: 8px;
        }

        .p-pw-rules i {
            font-size: 7px;
            color: var(--p-ink-faint);
            width: 11px;
            text-align: center;
        }

        .p-pw-rules li.met {
            color: var(--p-teal-deep);
            font-weight: 600;
        }

            .p-pw-rules li.met i {
                color: var(--p-teal);
                font-size: 11px;
            }

                .p-pw-rules li.met i::before {
                    content: "\f00c";
                }

    /* ===== SUBMIT + FOOTER ===== */

    .p-submit {
        width: 100%;
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 10px;
        margin-top: 28px;
        padding: 15px;
        border: none;
        border-radius: var(--p-radius-sm);
        background: linear-gradient(120deg, var(--p-teal-grad-start), var(--p-teal-grad-end));
        color: #fff;
        font-family: 'Poppins', sans-serif;
        font-weight: 600;
        font-size: 14.5px;
        cursor: pointer;
        box-shadow: 0 10px 24px rgba(10, 90, 80, 0.22);
        transition: transform .2s, box-shadow .2s;
    }

        .p-submit:hover {
            transform: translateY(-2px);
            box-shadow: 0 14px 28px rgba(10, 90, 80, 0.28);
        }

    .p-footer {
        margin-top: 40px;
        text-align: center;
    }

        .p-footer hr {
            border: none;
            border-top: 1px solid var(--p-line);
            margin-bottom: 22px;
        }

    .p-footer-content {
        display: flex;
        justify-content: center;
        align-items: center;
        flex-wrap: wrap;
        gap: 12px;
        color: var(--p-ink-faint);
        font-size: 13px;
    }

        .p-footer-content i {
            color: var(--p-teal);
        }

    .p-footer-divider {
        color: var(--p-line-strong);
    }

    /* ===== RESPONSIVE ===== */

    @@media (max-width: 900px) {
        .p-banner {
            flex-direction: column;
            align-items: flex-start;
            gap: 20px;
        }

        .p-banner-cta {
            width: 100%;
            justify-content: center;
        }
    }

    @@media (max-width: 640px) {
        .p-wrap {
            padding: 20px 16px 50px;
        }

        .p-grid-2 {
            grid-template-columns: 1fr;
        }

        .p-panel-body {
            padding: 22px 18px 26px;
        }

        .p-status-strip {
            flex-direction: column;
            align-items: flex-start;
            gap: 10px;
        }

        .p-banner-left {
            flex-direction: column;
            align-items: flex-start;
        }
    }

</style>


<!-- =============================================================
     JAVASCRIPT
     ============================================================= -->
<script>

    document.addEventListener("DOMContentLoaded", function() {

        /* ---------- first name + last name: letters only ---------- */

        ["FirstName", "LastName"].forEach(function (id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.addEventListener("input", function () {
                this.value = this.value.replace(/[^A-Za-z]/g, "");
            });
        });


        /* ---------- phone: digits only, max 10 ---------- */

        var phone = document.getElementById("PhoneNumber");
        if (phone) {
            phone.addEventListener("input", function () {
                this.value = this.value.replace(/\D/g, "").slice(0, 10);
            });
        }


        /* ---------- show / hide password ---------- */

        document.querySelectorAll("[data-toggle-pw]").forEach(function(btn) {
            btn.addEventListener("click", function() {
                const input = document.getElementById(this.dataset.togglePw);
                if (!input) return;

                const show = input.type === "password";
                input.type = show ? "text" : "password";

                const icon = this.querySelector("i");
                icon.classList.toggle("fa-eye", !show);
                icon.classList.toggle("fa-eye-slash", show);
            });
        });


        /* ---------- password strength, rules and match ---------- */

        const newPw = document.getElementById("NewPassword");
        const confirmPw = document.getElementById("ConfirmPassword");
        const meter = document.querySelector(".p-strength");
        const strengthLabel = document.getElementById("pwStrengthLabel");
        const matchLabel = document.getElementById("pwMatchLabel");
        const rules = document.getElementById("pwRules");

        function evaluate() {

            if (!newPw || !meter) return;

            const v = newPw.value;

            const checks = {
                len: v.length >= 8,
                upper: /[A-Z]/.test(v),
                lower: /[a-z]/.test(v),
                num: /\d/.test(v),
                sym: /[^A-Za-z0-9]/.test(v)
            };

            Object.keys(checks).forEach(function(key) {
                const li = rules.querySelector('[data-rule="' + key + '"]');
                if (li) li.classList.toggle("met", checks[key]);
            });

            const score = Object.values(checks).filter(Boolean).length;
            const level = v.length === 0 ? 0 : score <= 2 ? 1 : score === 3 ? 2 : score === 4 ? 3 : 4;
            const names = ["", "Weak", "Fair", "Good", "Strong"];

            meter.dataset.level = level;
            strengthLabel.textContent = v.length === 0
                ? "Enter a password to see its strength"
                : "Strength: " + names[level];

            if (confirmPw && confirmPw.value.length > 0) {
                const same = confirmPw.value === v;
                matchLabel.textContent = same ? "Passwords match" : "Passwords do not match";
                matchLabel.className = "p-strength-label " + (same ? "ok" : "bad");
            } else if (matchLabel) {
                matchLabel.textContent = "";
            }
        }

        if (newPw) newPw.addEventListener("input", evaluate);
        if (confirmPw) confirmPw.addEventListener("input", evaluate);

        evaluate();

    });

</script>

@section Scripts
{
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}