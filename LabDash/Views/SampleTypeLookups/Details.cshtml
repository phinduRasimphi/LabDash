@model LabDash.Models.SampleTypeLookup

@{
    ViewData["Title"] = "Sample Type Details";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2>Sample Type Details</h2>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Sample Type
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>


                <dt class="col-sm-3">
                    Description
                </dt>

                <dd class="col-sm-9">
                    @(string.IsNullOrEmpty(Model.Description)
                        ? "No description"
                        : Model.Description)
                </dd>


                <dt class="col-sm-3">
                    Status
                </dt>

                <dd class="col-sm-9">

                    @if (Model.IsActive)
                    {
                        <span class="badge bg-success">
                            Active
                        </span>
                    }
                    else
                    {
                        <span class="badge bg-secondary">
                            Inactive
                        </span>
                    }

                </dd>

            </dl>


            <a asp-action="Edit"
               asp-route-id="@Model.SampleTypeLookupId"
               class="btn btn-warning">

                <i class="bi bi-pencil"></i>
                Edit

            </a>


            <a asp-action="Index"
               class="btn btn-secondary">

                Back to List

            </a>

        </div>

    </div>

</div>