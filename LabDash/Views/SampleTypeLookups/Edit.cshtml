@model LabDash.Models.SampleTypeLookup

@{
    ViewData["Title"] = "Edit Sample Type";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2>Edit Sample Type</h2>

        <p class="text-muted">
            Update the sample type information.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit">

                <input type="hidden"
                       asp-for="SampleTypeLookupId" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger">
                </div>


                <div class="mb-3">

                    <label asp-for="Name"
                           class="form-label">
                    </label>

                    <input asp-for="Name"
                           class="form-control" />

                    <span asp-validation-for="Name"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="4">
                    </textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>


                <div class="form-check mb-4">

                    <input asp-for="IsActive"
                           class="form-check-input" />

                    <label asp-for="IsActive"
                           class="form-check-label">
                    </label>

                </div>


                <button type="submit"
                        class="btn btn-primary">

                    <i class="bi bi-save"></i>
                    Save Changes

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts {

    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

}
