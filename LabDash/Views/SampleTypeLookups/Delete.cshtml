@model LabDash.Models.SampleTypeLookup

@{
    ViewData["Title"] = "Delete Sample Type";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid">

    <div class="mb-4">

        <h2>Delete Sample Type</h2>

        <p class="text-danger">
            Are you sure you want to delete this sample type?
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <dl class="row">

                <dt class="col-sm-3">
                    Sample Type
                </dt>

                <dd class="col-sm-9">
                    @Model.Name
                </dd>


                <dt class="col-sm-3">
                    Description
                </dt>

                <dd class="col-sm-9">
                    @Model.Description
                </dd>

            </dl>


            <form asp-action="Delete">

                <input type="hidden"
                       asp-for="SampleTypeLookupId" />


                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Delete

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>