@model LabDash.Models.TestCategory
@{
    ViewData["Title"] = "Category Details";
    Layout = "_SystemLayout";
}

<div class="page-header d-flex justify-content-between align-items-center">
    <h2>@Model.CategoryName</h2>
    <div class="d-flex gap-2">
        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-primary">
            <i class="bi bi-pencil"></i> Edit
        </a>
        <a asp-action="Index" class="btn btn-outline-secondary">Back to List</a>
    </div>
</div>

<div class="panel mb-3">
    <div class="panel-body">
        <dl class="row mb-0">
            <dt class="col-sm-2">Category Name</dt>
            <dd class="col-sm-10">@Model.CategoryName</dd>

            <dt class="col-sm-2">Description</dt>
            <dd class="col-sm-10">@Model.Description</dd>
        </dl>
    </div>
</div>

<div class="panel">
    <div class="panel-header">
        <h5>Test Types in This Category (@Model.TestTypes.Count)</h5>
    </div>
    <div class="panel-body p-0">
        @if (Model.TestTypes.Any())
        {
            <table class="table table-hover mb-0">
                <thead>
                    <tr>
                        <th>Test Name</th>
                        <th>Sample Type</th>
                        <th>Turnaround (min)</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var test in Model.TestTypes)
                    {
                        <tr>
                            <td>
                                <a asp-controller="TestTypes" asp-action="Details" asp-route-id="@test.Id">
                                    @test.Name
                                </a>
                            </td>
                            @* <td>@test.RequiredSampleType?.Name</td> *@
                            <td>@test.TurnaroundTimeHours</td>
                        </tr>
                    }
                </tbody>
            </table>
        }
        else
        {
            <p class="text-muted p-3 mb-0">No test types assigned to this category yet.</p>
        }
    </div>
</div>
