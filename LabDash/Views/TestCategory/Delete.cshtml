@model LabDash.Models.TestCategory
@{
    ViewData["Title"] = "Delete Test Category";
    Layout = "_SystemLayout";
}

<div class="page-header">
    <h2>Delete Test Category</h2>
</div>

<div class="alert alert-warning">
    <i class="bi bi-exclamation-triangle-fill"></i>
    Are you sure you want to delete this test category? This cannot be undone.
</div>

@if (Model.TestTypes.Any())
{
    <div class="alert alert-danger">
        This category cannot be deleted because <strong>@Model.TestTypes.Count</strong> test type(s)
        still reference it. Reassign or remove those test types first.
    </div>
}

<div class="panel" style="max-width: 600px;">
    <div class="panel-body">
        <dl class="row mb-0">
            <dt class="col-sm-3">Category Name</dt>
            <dd class="col-sm-9">@Model.CategoryName</dd>

            <dt class="col-sm-3">Description</dt>
            <dd class="col-sm-9">@Model.Description</dd>
        </dl>
    </div>
</div>

<form asp-action="Delete" method="post" class="mt-3">
    <input type="hidden" asp-for="Id" />
    <button type="submit" class="btn btn-danger" @(Model.TestTypes.Any() ? "disabled" : "")>
        <i class="bi bi-trash"></i> Confirm Delete
    </button>
    <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
</form>
