@model IEnumerable<LabDash.Areas.Identity.Data.LabUser>

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Lab Technicians";
}

<style>
    .technician-page {
        padding: 30px;
        background: #f4fafa;
        min-height: 100vh;
    }

    .page-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 25px;
    }

        .page-header h1 {
            color: #134e4a;
            font-size: 28px;
            font-weight: 700;
            margin: 0;
        }

        .page-header p {
            color: #64748b;
            margin-top: 6px;
        }

    .btn-add {
        background: #0f766e;
        color: white;
        padding: 11px 18px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }

        .btn-add:hover {
            background: #115e59;
            color: white;
        }

    .alert-success {
        background: #dcfce7;
        color: #166534;
        padding: 12px 16px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .alert-info {
        background: #e0f2fe;
        color: #075985;
        padding: 15px;
        border-radius: 8px;
        margin-bottom: 20px;
    }

    .technician-card {
        background: white;
        border-radius: 12px;
        padding: 0;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
        overflow: hidden;
    }

    .technician-table {
        width: 100%;
        border-collapse: collapse;
    }

        .technician-table th {
            background: #0f766e;
            color: white;
            padding: 14px;
            text-align: left;
            font-size: 13px;
        }

        .technician-table td {
            padding: 14px;
            border-bottom: 1px solid #e5e7eb;
            color: #334155;
            font-size: 14px;
        }

        .technician-table tr:hover {
            background: #f0fdfa;
        }

    .technician-name {
        font-weight: 700;
        color: #134e4a;
    }

    .status-badge {
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-change {
        background: #fef3c7;
        color: #92400e;
    }

    .status-ok {
        background: #dcfce7;
        color: #166534;
    }

    .action-buttons {
        display: flex;
        gap: 6px;
        flex-wrap: wrap;
    }

    .action-btn {
        padding: 7px 10px;
        border-radius: 6px;
        text-decoration: none;
        font-size: 12px;
        font-weight: 600;
    }

    .btn-view {
        background: #e0f2fe;
        color: #0369a1;
    }

    .btn-edit {
        background: #fef3c7;
        color: #92400e;
    }

    .btn-assign {
        background: #ccfbf1;
        color: #0f766e;
    }

    .btn-delete {
        background: #fee2e2;
        color: #b91c1c;
    }

    .empty-message {
        text-align: center;
        padding: 50px;
        color: #64748b;
    }

    @@media (max-width: 900px) {
        .technician-table {
            min-width: 900px;
        }

        .technician-card {
            overflow-x: auto;
        }

        .page-header {
            flex-direction: column;
            align-items: flex-start;
            gap: 15px;
        }
    }
</style>

<div class="technician-page">

    <div class="page-header">

        <div>
            <h1>
                <i class="bi bi-person-workspace"></i>
                Lab Technicians
            </h1>

            <p>
                Manage laboratory technicians and their assigned test types.
            </p>
        </div>

        <a asp-action="Create" class="btn-add">
            <i class="bi bi-plus-lg"></i>
            Add Technician
        </a>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert-success">
            <i class="bi bi-check-circle-fill"></i>
            @TempData["Success"]
        </div>
    }


    @if (TempData["TemporaryPassword"] != null)
    {
        <div class="alert-info">

            <strong>
                Temporary Password:
            </strong>

            @TempData["TemporaryPassword"]

            <br />

            <small>
                Technician:
                @TempData["TechnicianEmail"]
                <br />
                The technician must change this password at first login.
            </small>

        </div>
    }


    <div class="technician-card">

        @if (Model.Any())
        {
            <table class="technician-table">

                <thead>
                    <tr>
                        <th>Name</th>
                        <th>South African ID</th>
                        <th>Employee Number</th>
                        <th>Email</th>
                        <th>Contact Number</th>
                        <th>Password</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>

                    @foreach (var technician in Model)
                    {
                        <tr>

                            <td>
                                <div class="technician-name">
                                    @technician.FirstName @technician.LastName
                                </div>
                            </td>

                            <td>
                                @technician.SouthAfricanID
                            </td>

                            <td>
                                @technician.EmployeeNumber
                            </td>

                            <td>
                                @technician.Email
                            </td>

                            <td>
                                @technician.PhoneNumb
                            </td>

                            <td>

                                @if (technician.MustChangePassword)
                                {
                                    <span class="status-badge status-change">
                                        Must Change
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-ok">
                                        Updated
                                    </span>
                                }

                            </td>

                            <td>

                                <div class="action-buttons">

                                    <a asp-action="Details"
                                       asp-route-id="@technician.Id"
                                       class="action-btn btn-view">
                                        <i class="bi bi-eye"></i>
                                        View
                                    </a>

                                    <a asp-action="Edit"
                                       asp-route-id="@technician.Id"
                                       class="action-btn btn-edit">
                                        <i class="bi bi-pencil"></i>
                                        Edit
                                    </a>

                                    <a asp-action="AssignTestTypes"
                                       asp-route-id="@technician.Id"
                                       class="action-btn btn-assign">
                                        <i class="bi bi-clipboard-check"></i>
                                        Tests
                                    </a>

                                    <a asp-action="Delete"
                                       asp-route-id="@technician.Id"
                                       class="action-btn btn-delete">
                                        <i class="bi bi-trash"></i>
                                        Delete
                                    </a>

                                </div>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>
        }
        else
        {
            <div class="empty-message">

                <i class="bi bi-person-x"
                   style="font-size:40px;"></i>

                <h3>No Lab Technicians</h3>

                <p>
                    No laboratory technicians have been registered yet.
                </p>

                <a asp-action="Create"
                   class="btn-add">
                    Add First Technician
                </a>

            </div>
        }

    </div>

</div>