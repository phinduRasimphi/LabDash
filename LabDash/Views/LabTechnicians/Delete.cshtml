@model LabDash.Areas.Identity.Data.LabUser

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Delete Technician";

    var assignments = ViewBag.Assignments
        as List<LabDash.Models.TechnicianTestType>
        ?? new List<LabDash.Models.TechnicianTestType>();
}

<style>
    .delete-page {
        padding: 30px;
        background: #f4fafa;
        min-height: 100vh;
    }

    .delete-card {
        max-width: 700px;
        margin: 50px auto;
        background: white;
        padding: 30px;
        border-radius: 14px;
        box-shadow: 0 4px 15px rgba(0,0,0,0.06);
    }

    .warning {
        background: #fee2e2;
        border-left: 5px solid #dc2626;
        padding: 15px;
        color: #991b1b;
        margin-bottom: 25px;
        border-radius: 6px;
    }

    .technician-info {
        background: #f8fafc;
        padding: 20px;
        border-radius: 10px;
        margin-bottom: 20px;
    }

        .technician-info p {
            margin: 8px 0;
            color: #334155;
        }

    .btn-delete {
        background: #dc2626;
        color: white;
        border: none;
        padding: 11px 20px;
        border-radius: 8px;
        font-weight: 600;
    }

    .btn-cancel {
        background: #e2e8f0;
        color: #334155;
        padding: 11px 20px;
        border-radius: 8px;
        text-decoration: none;
        font-weight: 600;
    }
</style>

<div class="delete-page">

    <div class="delete-card">

        <h1 style="color:#991b1b;">
            <i class="bi bi-exclamation-triangle-fill"></i>
            Delete Technician
        </h1>


        <div class="warning">

            <strong>Warning!</strong>

            <br />

            Are you sure you want to delete this laboratory technician?
            This will also remove their test type assignments.

        </div>


        <div class="technician-info">

            <p>
                <strong>Name:</strong>
                @Model.FirstName @Model.LastName
            </p>

            <p>
                <strong>Employee Number:</strong>
                @Model.EmployeeNumber
            </p>

            <p>
                <strong>South African ID:</strong>
                @Model.SouthAfricanID
            </p>

            <p>
                <strong>Email:</strong>
                @Model.Email
            </p>

            <p>
                <strong>Test Types Assigned:</strong>
                @assignments.Count
            </p>

        </div>


        <form asp-action="Delete"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="id"
                   value="@Model.Id" />

            <button type="submit"
                    class="btn-delete">

                <i class="bi bi-trash"></i>
                Yes, Delete Technician

            </button>

            <a asp-action="Index"
               class="btn-cancel">

                Cancel

            </a>

        </form>

    </div>

</div>