@model LabDash.Models.Supplier

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid p-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Supplier Details
        </h2>

        <p class="text-muted">
            View supplier information.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    Supplier Name
                </div>

                <div class="col-md-8">
                    @Model.SupplierName
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    Contact Person
                </div>

                <div class="col-md-8">
                    @Model.ContactPerson
                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-4 fw-bold">
                    Email Address
                </div>

                <div class="col-md-8">
                    @Model.EmailAddress
                </div>

            </div>


            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.SupplierId"
                   class="btn btn-primary">

                    <i class="bi bi-pencil"></i>
                    Edit

                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Back to Suppliers

                </a>

            </div>

        </div>

    </div>

</div>