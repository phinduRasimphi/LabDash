@model LabDash.Models.Supplier

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid p-4">

    <div class="mb-4">

        <h2 class="fw-bold text-danger">
            Delete Supplier
        </h2>

        <p class="text-muted">
            Are you sure you want to delete this supplier?
        </p>

    </div>


    <div class="card shadow-sm border-danger">

        <div class="card-body">

            <div class="alert alert-warning">

                <i class="bi bi-exclamation-triangle"></i>

                This action cannot be undone.

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    Supplier Name
                </div>

                <div class="col-md-8">
                    @Model.SupplierName
                </div>

            </div>


            <div class="row mb-3">

                <div class="col-md-4 fw-bold">
                    Contact Person
                </div>

                <div class="col-md-8">
                    @Model.ContactPerson
                </div>

            </div>


            <div class="row mb-4">

                <div class="col-md-4 fw-bold">
                    Email Address
                </div>

                <div class="col-md-8">
                    @Model.EmailAddress
                </div>

            </div>


            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="SupplierId" />


                <button type="submit"
                        class="btn btn-danger">

                    <i class="bi bi-trash"></i>
                    Delete Supplier

                </button>


                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>