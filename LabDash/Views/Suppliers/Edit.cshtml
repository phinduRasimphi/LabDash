@model LabDash.Models.Supplier

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid p-4">

    <div class="mb-4">

        <h2 class="fw-bold">
            Edit Supplier
        </h2>

        <p class="text-muted">
            Update supplier information.
        </p>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Edit" method="post">

                <input type="hidden"
                       asp-for="SupplierId" />


                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>


                <div class="mb-3">

                    <label asp-for="SupplierName"
                           class="form-label">
                    </label>

                    <input asp-for="SupplierName"
                           class="form-control" />

                    <span asp-validation-for="SupplierName"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-3">

                    <label asp-for="ContactPerson"
                           class="form-label">
                    </label>

                    <input asp-for="ContactPerson"
                           class="form-control" />

                    <span asp-validation-for="ContactPerson"
                          class="text-danger">
                    </span>

                </div>


                <div class="mb-4">

                    <label asp-for="EmailAddress"
                           class="form-label">
                    </label>

                    <input asp-for="EmailAddress"
                           type="email"
                           class="form-control" />

                    <span asp-validation-for="EmailAddress"
                          class="text-danger">
                    </span>

                </div>


                <div class="d-flex gap-2">

                    <button type="submit"
                            class="btn btn-primary">

                        <i class="bi bi-save"></i>
                        Save Changes

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
