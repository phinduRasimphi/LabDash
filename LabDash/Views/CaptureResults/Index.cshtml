@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Capture Test Results";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var totalTests = Model.Count();

    var overdueTests = Model.Count(x =>
        x.StartDateTime.HasValue &&
        x.StartDateTime.Value.AddMinutes(x.TestType.TurnaroundTimeMinutes) < DateTime.Now);

    var statRequests = Model.Count(x =>
        x.TestRequest.Urgency == "STAT");

    var urgentRequests = Model.Count(x =>
        x.TestRequest.Urgency == "Urgent");
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --ink: #0f2f2d;
        --muted: #6b817f;
        --line: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --danger: #c0443f;
        --danger-soft: #fde8e8;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
        --radius-lg: 20px;
        --radius-md: 16px;
        --shadow-soft: 0 10px 30px rgba(15, 80, 72, .08);
        --shadow-lift: 0 14px 34px rgba(15, 80, 72, .14);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .page-container,
    .page-container * {
        box-sizing: border-box;
    }

    .page-container {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--ink);
        background: var(--page-bg);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    .page-container *:focus-visible {
        outline: 3px solid rgba(15, 148, 136, .4);
        outline-offset: 2px;
        border-radius: 8px;
    }

    /*================ HERO HEADER =================*/

    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .header-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .page-header h2 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .page-header p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .header-stat {
        min-width: 150px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

    .header-stat span {
        display: block;
        margin-bottom: 4px;
        color: rgba(255, 255, 255, .78);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .header-stat strong {
        color: #fff;
        font-size: 22px;
        font-weight: 700;
    }

    /*================ STATISTICS =================*/

    .stats {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 18px;
        margin-bottom: 22px;
    }

    .stat-card {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 20px 24px;
        background: #fff;
        border: 1.5px solid transparent;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        cursor: pointer;
        transition: transform .2s ease, box-shadow .2s ease, border-color .2s ease;
    }

        .stat-card:hover {
            transform: translateY(-3px);
            box-shadow: var(--shadow-lift);
        }

        .stat-card.active {
            border-color: var(--teal);
            background: var(--teal-soft);
        }

        .stat-card h6 {
            margin: 0 0 6px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 600;
            letter-spacing: .3px;
            text-transform: uppercase;
        }

        .stat-card h2 {
            margin: 0;
            color: var(--teal-dark);
            font-size: 28px;
            font-weight: 800;
            letter-spacing: -.5px;
        }

        .stat-card.danger h2 {
            color: var(--danger);
        }

        .stat-card.warning h2 {
            color: var(--warning);
        }

    .stat-icon {
        width: 52px;
        height: 52px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 14px;
        color: var(--teal);
        background: var(--teal-light);
        font-size: 22px;
    }

    .stat-card.danger .stat-icon {
        color: var(--danger);
        background: var(--danger-soft);
    }

    .stat-card.warning .stat-icon {
        color: var(--warning);
        background: var(--warning-soft);
    }

    /*================ TABLE CARD =================*/

    .table-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .table-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        flex-wrap: wrap;
        gap: 16px;
        padding: 18px 26px;
        border-bottom: 1px solid var(--line);
    }

        .table-header h4 {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 0;
            color: var(--ink);
            font-family: "Inter", sans-serif;
            font-size: 17px;
            font-weight: 700;
        }

            .table-header h4 > i {
                color: var(--teal);
                font-size: 16px;
            }

        .table-header .result-count {
            padding: 4px 12px;
            color: var(--teal-dark);
            background: var(--teal-light);
            border-radius: 999px;
            font-size: 12px;
            font-weight: 600;
        }

            .table-header .result-count:empty {
                display: none;
            }

    .search-box {
        position: relative;
        width: 340px;
        max-width: 100%;
    }

        .search-box input {
            width: 100%;
            height: 46px;
            padding: 0 16px 0 44px;
            color: var(--ink);
            background: var(--field-bg);
            border: 1px solid var(--teal-border);
            border-radius: 999px;
            font-family: "Inter", sans-serif;
            font-size: 14px;
            outline: none;
            transition: border-color .15s, box-shadow .15s, background .15s;
        }

            .search-box input::placeholder {
                color: #8aa09e;
            }

            .search-box input:focus {
                background: #fff;
                border-color: var(--teal);
                box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
            }

        .search-box i {
            position: absolute;
            top: 50%;
            left: 17px;
            transform: translateY(-50%);
            color: var(--muted);
            pointer-events: none;
        }

    /*================ FILTER CHIPS =================*/

    .filter-bar {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        padding: 16px 26px;
        border-bottom: 1px solid var(--line);
    }

    .filter-chip {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 8px 16px;
        color: var(--muted);
        background: #fff;
        border: 1.5px solid var(--line);
        border-radius: 999px;
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 600;
        cursor: pointer;
        transition: .2s;
    }

        .filter-chip:hover {
            color: var(--teal-dark);
            border-color: var(--teal);
        }

        .filter-chip.active {
            color: #fff;
            background: var(--btn-gradient);
            border-color: transparent;
            box-shadow: 0 6px 14px rgba(10, 93, 85, .25);
        }

        .filter-chip .count {
            padding: 1px 9px;
            background: var(--teal-light);
            color: var(--teal-dark);
            border-radius: 999px;
            font-size: 12px;
        }

        .filter-chip.active .count {
            color: #fff;
            background: rgba(255, 255, 255, .25);
        }

    /*================ TABLE =================*/

    .table-scroll {
        max-height: 640px;
        overflow: auto;
    }

    .table {
        width: 100%;
        margin: 0;
        border-collapse: separate;
        border-spacing: 0;
    }

        .table thead th {
            position: sticky;
            top: 0;
            z-index: 2;
            padding: 15px 20px;
            color: var(--teal-dark);
            background: var(--teal-light);
            border: none;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

            .table thead th.sortable {
                cursor: pointer;
                user-select: none;
            }

                .table thead th.sortable:hover,
                .table thead th.sorted {
                    color: var(--teal-deep);
                }

            .table thead th i {
                margin-left: 4px;
                opacity: .6;
            }

        .table td {
            padding: 18px 20px;
            color: var(--ink);
            background: #fff;
            border-bottom: 1px solid var(--line);
            font-size: 14px;
            text-align: left;
            vertical-align: middle;
        }

        .table tbody tr {
            transition: background .15s;
        }

            .table tbody tr:hover td {
                background: var(--teal-soft);
            }

            .table tbody tr.row-overdue {
                box-shadow: none;
            }

    .patient-name {
        font-weight: 600;
        color: var(--ink);
    }

    .muted-sub {
        color: var(--muted);
        font-size: 12px;
    }

    .table td .patient-name,
    .table td strong {
        display: block;
        font-weight: 600;
    }

    .table td .muted-sub {
        display: block;
        margin-top: 4px;
    }

    /*================ BADGES =================*/

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-stat {
        color: var(--danger);
        background: var(--danger-soft);
    }

    .badge-urgent {
        color: var(--warning);
        background: var(--warning-soft);
    }

    .badge-routine {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .badge-progress {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .badge-completed {
        color: var(--success);
        background: var(--success-soft);
    }

    .badge-overdue {
        color: var(--danger);
        background: var(--danger-soft);
    }

    .badge-default {
        color: #607572;
        background: #edf4f3;
    }

    /*================ BUTTONS =================*/

    .btn-capture {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        color: #fff;
        background: var(--btn-gradient);
        border: 0;
        border-radius: 12px;
        box-shadow: 0 6px 14px rgba(10, 93, 85, .25);
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: transform .15s, box-shadow .15s;
    }

        .btn-capture:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(10, 93, 85, .34);
        }

    .btn-history {
        width: 40px;
        height: 40px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        color: var(--muted);
        background: #fff;
        border: 1.5px solid var(--teal-border);
        border-radius: 12px;
        font-size: 14px;
        text-decoration: none;
        transition: .2s;
    }

        .btn-history:hover {
            color: var(--teal-dark);
            background: var(--teal-soft);
            border-color: var(--teal);
        }

    /*================ EMPTY STATE =================*/

    .empty-state {
        padding: 60px 20px;
        text-align: center;
    }

        .empty-state i {
            margin-bottom: 16px;
            color: var(--teal);
            font-size: 52px;
            opacity: .85;
        }

        .empty-state h3 {
            color: var(--ink);
            font-size: 18px;
            font-weight: 700;
        }

        .empty-state p {
            color: var(--muted);
        }

    /*================ RESPONSIVE =================*/

    @@media (max-width: 992px) {

        .stats {
            grid-template-columns: repeat(2, 1fr);
        }

        .header-stat {
            display: none;
        }

        .table-header {
            flex-direction: column;
            align-items: stretch;
        }

        .search-box {
            width: 100%;
        }
    }

    @@media (max-width: 576px) {

        .page-container {
            padding: 12px 9px 28px;
        }

        .page-header {
            padding: 18px;
            border-radius: 20px;
        }

            .page-header h2 {
                font-size: 19px;
            }

        .stats {
            grid-template-columns: 1fr;
        }

        .table-header,
        .filter-bar {
            padding-left: 16px;
            padding-right: 16px;
        }
    }

</style>

<div class="page-container">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success shadow-sm">
            <i class="fa-solid fa-circle-check"></i>
            @TempData["Success"]
        </div>
    }

    <div class="page-header">

        <div class="header-icon">
            <i class="fa-solid fa-microscope"></i>
        </div>

        <div>
            <h2>Capture Laboratory Results</h2>
            <p>Capture laboratory findings for tests assigned to you.</p>
        </div>

        <div class="header-stat">
            <span>Assigned to you</span>
            <strong>@totalTests</strong>
        </div>

    </div>

    <div class="stats">

        <div class="stat-card" data-filter="all">
            <div>
                <h6>Total Assigned</h6>
                <h2>@totalTests</h2>
            </div>
            <div class="stat-icon"><i class="fa-solid fa-vials"></i></div>
        </div>

        <div class="stat-card danger" data-filter="stat">
            <div>
                <h6>STAT Requests</h6>
                <h2>@statRequests</h2>
            </div>
            <div class="stat-icon"><i class="fa-solid fa-bolt"></i></div>
        </div>

        <div class="stat-card warning" data-filter="urgent">
            <div>
                <h6>Urgent Tests</h6>
                <h2>@urgentRequests</h2>
            </div>
            <div class="stat-icon"><i class="fa-solid fa-triangle-exclamation"></i></div>
        </div>

        <div class="stat-card danger" data-filter="overdue">
            <div>
                <h6>Overdue Tests</h6>
                <h2>@overdueTests</h2>
            </div>
            <div class="stat-icon"><i class="fa-solid fa-clock"></i></div>
        </div>

    </div>

    <div class="table-card">

        <div class="table-header">

            <h4>
                <i class="fa-solid fa-list-check"></i>
                Assigned Laboratory Tests
                <span class="result-count" id="resultCount"></span>
            </h4>

            <div class="search-box">
                <i class="fa-solid fa-search"></i>
                <input type="text"
                       id="searchInput"
                       class="form-control"
                       placeholder="Search patient, request or test..."
                       aria-label="Search assigned tests" />
            </div>

        </div>

        @if (!Model.Any())
        {
            <div class="empty-state">
                <i class="fa-solid fa-vials"></i>
                <h3>No Assigned Tests</h3>
                <p>There are currently no laboratory tests available for result capture.</p>
            </div>
        }
        else
        {

            <div class="filter-bar" role="group" aria-label="Filter tests by urgency">
                <button type="button" class="filter-chip active" data-filter="all">
                    All <span class="count">@totalTests</span>
                </button>
                <button type="button" class="filter-chip" data-filter="stat">
                    <i class="fa-solid fa-bolt"></i> STAT <span class="count">@statRequests</span>
                </button>
                <button type="button" class="filter-chip" data-filter="urgent">
                    <i class="fa-solid fa-triangle-exclamation"></i> Urgent <span class="count">@urgentRequests</span>
                </button>
                <button type="button" class="filter-chip" data-filter="overdue">
                    <i class="fa-solid fa-clock"></i> Overdue <span class="count">@overdueTests</span>
                </button>
            </div>

            <div class="table-scroll">
                <table class="table table-hover" id="resultsTable">

                    <thead>
                        <tr>
                            <th class="sortable" data-sort="request">Request <i class="fa-solid fa-sort"></i></th>
                            <th class="sortable" data-sort="patient">Patient <i class="fa-solid fa-sort"></i></th>
                            <th class="sortable" data-sort="test">Test <i class="fa-solid fa-sort"></i></th>
                            <th>Category</th>
                            <th class="sortable" data-sort="urgency">Urgency <i class="fa-solid fa-sort"></i></th>
                            <th class="sortable" data-sort="started">Started <i class="fa-solid fa-sort"></i></th>
                            <th class="sortable" data-sort="turnaround">Turnaround <i class="fa-solid fa-sort"></i></th>
                            <th>Status</th>
                            <th>Action</th>
                        </tr>
                    </thead>

                    <tbody>
                        @foreach (var item in Model)
                        {
                            var expectedCompletion = item.StartDateTime?.AddMinutes(item.TestType.TurnaroundTimeMinutes);

                            bool overdue =
                                expectedCompletion.HasValue &&
                                DateTime.Now > expectedCompletion.Value;

                            var urgencyKey = item.TestRequest.Urgency == "STAT" ? "stat"
                                : item.TestRequest.Urgency == "Urgent" ? "urgent" : "routine";

                            <tr class="@(overdue ? "row-overdue" : "")"
                                data-urgency="@urgencyKey"
                                data-overdue="@(overdue ? "1" : "0")"
                                data-request="TR-@item.RequestId"
                                data-patient="@item.TestRequest.Patient.Name @item.TestRequest.Patient.Surname"
                                data-test="@item.TestType.Name"
                                data-started="@(item.StartDateTime?.ToString("o") ?? "")"
                                data-expected="@(expectedCompletion?.ToString("o") ?? "")">

                                <td><strong>TR-@item.RequestId</strong></td>

                                <td class="patient-name">
                                    @item.TestRequest.Patient.Name
                                    @item.TestRequest.Patient.Surname
                                </td>

                                <td><strong>@item.TestType.Name</strong></td>

                                <td>@item.TestType.Category</td>

                                <td>
                                    @if (item.TestRequest.Urgency == "STAT")
                                    {
                                        <span class="badge-status badge-stat">
                                            <i class="fa-solid fa-bolt"></i> STAT
                                        </span>
                                    }
                                    else if (item.TestRequest.Urgency == "Urgent")
                                    {
                                        <span class="badge-status badge-urgent">
                                            <i class="fa-solid fa-triangle-exclamation"></i> Urgent
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-routine">Routine</span>
                                    }
                                </td>

                                <td>@(item.StartDateTime?.ToString("dd MMM yyyy HH:mm") ?? "-")</td>

                                <td>
                                    @if (expectedCompletion.HasValue)
                                    {
                                        <div>@expectedCompletion.Value.ToString("dd MMM yyyy HH:mm")</div>
                                        <small class="live-countdown muted-sub @(overdue ? "text-danger fw-bold" : "text-success")"></small>
                                    }
                                    else
                                    {
                                        <span>-</span>
                                    }
                                </td>

                                <td>
                                    @if (overdue)
                                    {
                                        <span class="badge-status badge-overdue">OVERDUE</span>
                                    }
                                    else if (item.Status == "In Progress")
                                    {
                                        <span class="badge-status badge-progress">@item.Status</span>
                                    }
                                    else if (item.Status == "Completed")
                                    {
                                        <span class="badge-status badge-completed">@item.Status</span>
                                    }
                                    else
                                    {
                                        <span class="badge-status badge-default">@item.Status</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2 justify-content-center">
                                        <a asp-action="Capture"
                                           asp-route-id="@item.TestRequestItemId"
                                           class="btn-capture">
                                            <i class="fa-solid fa-floppy-disk"></i>
                                            Capture Result
                                        </a>
                                        <a asp-controller="Verification"
                                           asp-action="History"
                                           asp-route-id="@item.TestRequestItemId"
                                           class="btn-history"
                                           title="View review history">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                        </a>
                                    </div>
                                </td>

                            </tr>
                        }
                    </tbody>

                </table>
            </div>

            <div class="empty-state d-none" id="noResults">
                <i class="fa-solid fa-magnifying-glass"></i>
                <h3>No matching tests</h3>
                <p>Try a different search term or clear the active filter.</p>
            </div>

        }

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            var table = document.getElementById("resultsTable");
            if (!table) return;

            var searchInput = document.getElementById("searchInput");
            var rows = Array.prototype.slice.call(table.querySelectorAll("tbody tr"));
            var chips = document.querySelectorAll(".filter-chip, .stat-card[data-filter]");
            var noResults = document.getElementById("noResults");
            var resultCount = document.getElementById("resultCount");
            var currentFilter = "all";
            var currentSort = { key: null, dir: 1 };

            function matchesFilter(row) {
                if (currentFilter === "all") return true;
                if (currentFilter === "overdue") return row.dataset.overdue === "1";
                return row.dataset.urgency === currentFilter;
            }

            function matchesSearch(row, term) {
                if (!term) return true;
                return row.innerText.toLowerCase().indexOf(term) > -1;
            }

            function applyFilters() {
                var term = (searchInput.value || "").toLowerCase();
                var visibleCount = 0;

                rows.forEach(function(row) {
                    var show = matchesFilter(row) && matchesSearch(row, term);
                    row.style.display = show ? "" : "none";
                    if (show) visibleCount++;
                });

                resultCount.textContent = visibleCount + " of " + rows.length + " shown";
                noResults.classList.toggle("d-none", visibleCount > 0);
            }

            searchInput.addEventListener("keyup", applyFilters);

            chips.forEach(function(chip) {
                chip.addEventListener("click", function() {
                    currentFilter = chip.dataset.filter;

                    document.querySelectorAll(".filter-chip").forEach(function(c) {
                        c.classList.toggle("active", c.dataset.filter === currentFilter);
                    });
                    document.querySelectorAll(".stat-card[data-filter]").forEach(function(c) {
                        c.classList.toggle("active", c.dataset.filter === currentFilter);
                    });

                    applyFilters();
                });
            });

            // Sorting
            var sortIndexMap = { request: 0, patient: 1, test: 2, urgency: 4, started: 5, turnaround: 6 };
            var urgencyRank = { stat: 0, urgent: 1, routine: 2 };

            table.querySelectorAll("th.sortable").forEach(function(th) {
                th.addEventListener("click", function() {
                    var key = th.dataset.sort;

                    if (currentSort.key === key) {
                        currentSort.dir *= -1;
                    } else {
                        currentSort.key = key;
                        currentSort.dir = 1;
                    }

                    table.querySelectorAll("th.sortable").forEach(function(h) {
                        h.classList.remove("sorted");
                        h.querySelector("i").className = "fa-solid fa-sort";
                    });
                    th.classList.add("sorted");
                    th.querySelector("i").className = currentSort.dir === 1
                        ? "fa-solid fa-sort-up"
                        : "fa-solid fa-sort-down";

                    var tbody = table.querySelector("tbody");
                    var sorted = rows.slice().sort(function(a, b) {
                        var av, bv;

                        if (key === "urgency") {
                            av = urgencyRank[a.dataset.urgency];
                            bv = urgencyRank[b.dataset.urgency];
                        } else if (key === "started") {
                            av = a.dataset.started ? new Date(a.dataset.started).getTime() : 0;
                            bv = b.dataset.started ? new Date(b.dataset.started).getTime() : 0;
                        } else if (key === "turnaround") {
                            av = a.dataset.expected ? new Date(a.dataset.expected).getTime() : 0;
                            bv = b.dataset.expected ? new Date(b.dataset.expected).getTime() : 0;
                        } else {
                            av = (a.dataset[key] || "").toString().toLowerCase();
                            bv = (b.dataset[key] || "").toString().toLowerCase();
                        }

                        if (av < bv) return -1 * currentSort.dir;
                        if (av > bv) return 1 * currentSort.dir;
                        return 0;
                    });

                    sorted.forEach(function(row) { tbody.appendChild(row); });
                    rows = sorted;
                });
            });

            // Live countdown / overdue timer (total minutes only), refreshed every 30s
            function formatDiff(ms) {
                var totalMinutes = Math.floor(Math.abs(ms) / 60000);
                return totalMinutes + " min";
            }

            function tickCountdowns() {
                var now = Date.now();
                rows.forEach(function(row) {
                    var expected = row.dataset.expected;
                    if (!expected) return;

                    var el = row.querySelector(".live-countdown");
                    if (!el) return;

                    var diff = new Date(expected).getTime() - now;
                    var overdue = diff < 0;

                    el.innerHTML = '<i class="fa-solid fa-clock"></i> ' +
                        formatDiff(diff) + (overdue ? " overdue" : " left");
                    el.classList.toggle("text-danger", overdue);
                    el.classList.toggle("fw-bold", overdue);
                    el.classList.toggle("text-success", !overdue);
                });
            }

            tickCountdowns();
            setInterval(tickCountdowns, 30000);
            applyFilters();
        })();
    </script>
}