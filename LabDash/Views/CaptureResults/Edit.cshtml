@model LabDash.Models.TestResult

@{
    ViewData["Title"] = "Edit Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var testItem = ViewBag.TestItem as LabDash.Models.TestRequestItem;
    var patient = ViewBag.Patient as LabDash.Models.Patient;

    bool isResubmission =
        ViewBag.IsResubmission == true;

    string? previousNote =
        ViewBag.PreviousVerificationNote as string;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --text: #0f2f2d;
        --muted: #6b817f;
        --border: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --danger: #c0443f;
        --danger-soft: #fde8e8;
        --danger-border: #f3c4c4;
        --warning-soft: #fff3d9;
        --card-radius: 20px;
        --card-shadow: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .edit-container,
    .edit-container * {
        box-sizing: border-box;
    }

    .edit-container {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--text);
        background: var(--page-bg);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    /* ---------- HERO HEADER ---------- */

    .edit-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .edit-header-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .edit-header h2 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .edit-header p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .header-stat {
        min-width: 180px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

        .header-stat span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .header-stat strong {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
        }

    /* ---------- RETURNED-FOR-REVIEW NOTICE ---------- */

    .review-warning {
        padding: 16px 20px;
        margin-bottom: 22px;
        color: #6f5a2d;
        background: var(--warning-soft);
        border: 1px solid #efdca2;
        border-left: 4px solid #c58a00;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
        font-size: 13px;
        line-height: 1.7;
    }

        .review-warning > strong {
            display: flex;
            align-items: center;
            gap: 8px;
            color: #765300;
            font-size: 14px;
            font-weight: 700;
        }

    .review-note {
        margin-top: 8px;
    }

        .review-note strong {
            color: #765300;
        }

    /* ---------- CARDS (scoped so Bootstrap's .card is not affected) ---------- */

    .edit-container .card {
        margin-bottom: 22px;
        padding: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }

    .card-heading {
        min-height: 64px;
        padding: 18px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        border-bottom: 1px solid var(--border);
    }

        .card-heading h4 {
            display: inline-flex;
            align-items: center;
            gap: 11px;
            margin: 0;
            color: var(--text);
            font-family: "Inter", sans-serif;
            font-size: 17px;
            font-weight: 700;
        }

            .card-heading h4 i {
                color: var(--teal);
                font-size: 16px;
            }

    .card-content {
        padding: 22px 26px 26px;
    }

    /* ---------- INFO TILES ---------- */

    .patient-grid {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
        gap: 14px;
    }

    .info-tile {
        min-width: 0;
        padding: 14px 16px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

    .edit-container .label {
        margin: 0 0 6px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .4px;
        text-transform: uppercase;
    }

    .edit-container .value {
        color: var(--text);
        font-size: 15px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    /* ---------- FORM ---------- */

    .form-group {
        display: flex;
        flex-direction: column;
        gap: 8px;
        margin-bottom: 20px;
    }

    .form-label {
        display: block;
        margin: 0;
        color: var(--text);
        font-size: 13px;
        font-weight: 600;
    }

    /* soft, tinted inputs like the search bar in the admin panel */
    .edit-container .form-control {
        width: 100%;
        min-width: 0;
        min-height: 46px;
        padding: 12px 16px;
        color: var(--text);
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

        .edit-container .form-control::placeholder {
            color: #8aa09e;
        }

        .edit-container .form-control:focus {
            background: #fff;
            border-color: var(--teal);
            box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
        }

        .edit-container .form-control[readonly] {
            background: #f3f8f7;
            color: #59716e;
        }

    .edit-container textarea.form-control {
        min-height: 120px;
        line-height: 1.7;
        resize: vertical;
    }

    .validation {
        color: var(--danger);
        font-size: 12px;
    }

    div.validation {
        margin-bottom: 15px;
    }

    /* ---------- BUTTONS ---------- */

    .buttons {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        margin-top: 6px;
        border-top: 1px solid var(--border);
    }

    .btn-save,
    .btn-cancel {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: box-shadow .15s, transform .1s, background .15s;
    }

    .btn-save {
        color: #fff;
        background: var(--btn-gradient);
        border: 0;
        box-shadow: 0 8px 18px rgba(10, 93, 85, .28);
    }

        .btn-save:hover {
            color: #fff;
            box-shadow: 0 10px 22px rgba(10, 93, 85, .36);
            transform: translateY(-1px);
        }

    .btn-cancel {
        color: #3f605d;
        background: #fff;
        border: 1px solid var(--teal-border);
    }

        .btn-cancel:hover {
            color: var(--teal-dark);
            background: var(--teal-soft);
        }

        .btn-save:focus-visible,
        .btn-cancel:focus-visible {
            outline: 3px solid rgba(15, 148, 136, .35);
            outline-offset: 2px;
        }

    /* ---------- RESPONSIVE ---------- */

    @@media (max-width: 760px) {
        .header-stat {
            display: none;
        }
    }

    @@media (max-width: 500px) {
        .edit-container {
            padding: 12px 9px 28px;
        }

        .edit-header {
            padding: 18px;
            border-radius: 20px;
        }

            .edit-header h2 {
                font-size: 19px;
            }

        .card-heading {
            padding: 14px 16px;
        }

            .card-heading h4 {
                font-size: 15px;
            }

        .card-content {
            padding: 16px;
        }

        .buttons {
            flex-direction: column-reverse;
        }

        .btn-save,
        .btn-cancel {
            width: 100%;
        }
    }
</style>

<div class="edit-container">

    <!-- HEADER -->

    <div class="edit-header">
        <div class="edit-header-icon">
            <i class="fa-solid fa-pen-to-square"></i>
        </div>

        <div>
            <h2>Edit Laboratory Result</h2>
            <p>Correct the result before sending it back for verification.</p>
        </div>

        <div class="header-stat">
            <span>Test</span>
            <strong>@(testItem?.TestType?.Name ?? "Laboratory Test")</strong>
        </div>
    </div>


    @if (isResubmission)
    {
        <div class="review-warning" role="alert">

            <strong>
                <i class="fa-solid fa-triangle-exclamation"></i>
                Result Returned For Review
            </strong>

            @if (!string.IsNullOrWhiteSpace(previousNote))
            {
                <div class="review-note">
                    <strong>Reviewer's Note:</strong>
                    <br />
                    @previousNote
                </div>
            }

        </div>
    }


    <!-- PATIENT & TEST INFORMATION -->

    <div class="card">

        <div class="card-heading">
            <h4>
                <i class="fa-solid fa-user"></i>
                Patient &amp; Test Information
            </h4>
        </div>

        <div class="card-content">
            <div class="patient-grid">

                <div class="info-tile">
                    <div class="label">Patient</div>
                    <div class="value">@patient?.Name</div>
                </div>

                <div class="info-tile">
                    <div class="label">Request Number</div>
                    <div class="value">@testItem?.RequestId</div>
                </div>

                <div class="info-tile">
                    <div class="label">Test Type</div>
                    <div class="value">@testItem?.TestType?.Name</div>
                </div>

            </div>
        </div>

    </div>


    <!-- EDIT FORM -->

    <div class="card">

        <div class="card-heading">
            <h4>
                <i class="fa-solid fa-flask"></i>
                Laboratory Result
            </h4>
        </div>

        <div class="card-content">

            <form asp-controller="CaptureResults"
                  asp-action="Edit"
                  asp-route-id="@Model.TestRequestItemId"
                  method="post">

                @Html.AntiForgeryToken()

                <input type="hidden"
                       asp-for="TestRequestItemId" />

                <div asp-validation-summary="ModelOnly"
                     class="validation">
                </div>


                <!-- RESULT VALUE -->

                <div class="form-group">

                    <label asp-for="ResultValue"
                           class="form-label">
                        Result Value
                    </label>

                    <input asp-for="ResultValue"
                           class="form-control"
                           placeholder="Enter laboratory result" />

                    <span asp-validation-for="ResultValue"
                          class="validation">
                    </span>

                </div>


                <!-- UNITS -->

                <div class="form-group">

                    <label asp-for="Units"
                           class="form-label">
                        Units
                    </label>

                    <input asp-for="Units"
                           class="form-control"
                           placeholder="e.g. g/dL, x10³/µL, %" />

                </div>


                <!-- REFERENCE RANGE -->

                <div class="form-group">

                    <label asp-for="ReferenceRange"
                           class="form-label">
                        Reference Range
                    </label>

                    <input asp-for="ReferenceRange"
                           class="form-control"
                           readonly />

                </div>


                <!-- COMMENTS -->

                <div class="form-group">

                    <label asp-for="Comments"
                           class="form-label">
                        Comments
                    </label>

                    <textarea asp-for="Comments"
                              class="form-control"
                              placeholder="Enter laboratory comments"></textarea>

                </div>


                <!-- BUTTONS -->

                <div class="buttons">

                    <a asp-controller="CaptureResults"
                       asp-action="Details"
                       asp-route-id="@Model.TestRequestItemId"
                       class="btn-cancel">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn-save">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Changes &amp; Send For Verification
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}
