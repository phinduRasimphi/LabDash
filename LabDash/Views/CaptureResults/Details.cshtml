@model LabDash.Models.TestResult
@using LabDash.Models
@using System.Globalization

@{
    ViewData["Title"] = "Laboratory Result Details";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var request = ViewBag.Request as TestRequest ?? test?.TestRequest;
    var testType = test?.TestType;

    // ---------- Helpers ----------

    string Show(string? value, string fallback = "Not provided") =>
        string.IsNullOrWhiteSpace(value) ? fallback : value;

    string ShowDate(DateTime? date) =>
        date.HasValue ? date.Value.ToString("dd MMM yyyy HH:mm") : "Not available";

    // ---------- Test + request values ----------

    var urgency = request?.Urgency ?? "Routine";
    var testStatus = test?.Status ?? "Completed";
    var unit = testType?.UnitOfMeasurement ?? "";
    var testName = testType?.Name ?? "Laboratory Test";
    var category = testType?.Category ?? "Not specified";
    var sampleType = testType?.RequiredSampleType ?? "Not specified";
    var doctorName = request?.RequestingDoctor?.UserName;
    var technicianName = test?.AssignedTechnician?.UserName;

    // ---------- Abnormal detection ----------
    // Uses the stored flag AND checks the numeric result against the
    // test type's reference range, so an abnormal result is never shown as normal.

    var resultText = Convert.ToString(Model.ResultValue, CultureInfo.InvariantCulture);
    var outOfRange = false;

    if (decimal.TryParse(resultText?.Trim().Replace(',', '.'),
                         NumberStyles.Any,
                         CultureInfo.InvariantCulture,
                         out var numericResult))
    {
        if (testType?.ReferenceRangeLow != null && numericResult < testType.ReferenceRangeLow)
        {
            outOfRange = true;
        }

        if (testType?.ReferenceRangeHigh != null && numericResult > testType.ReferenceRangeHigh)
        {
            outOfRange = true;
        }
    }

    var isAbnormal = Model.IsAbnormal || outOfRange;
    var abnormalClass = isAbnormal ? "is-abnormal" : "";

    // ---------- Display values ----------

    var displayUnit = string.IsNullOrWhiteSpace(Model.Units) ? unit : Model.Units;

    string defaultRange = "";
    if (testType?.ReferenceRangeLow != null && testType?.ReferenceRangeHigh != null)
    {
        defaultRange = $"{testType.ReferenceRangeLow:0.##} - {testType.ReferenceRangeHigh:0.##}";
    }

    var referenceRange = string.IsNullOrWhiteSpace(Model.ReferenceRange)
        ? defaultRange
        : Model.ReferenceRange;

    var hasDefinedRange = !string.IsNullOrWhiteSpace(referenceRange);

    var address = patient == null
        ? ""
        : string.Join(", ", new[]
        {
            patient.AddressLine1, patient.AddressLine2, patient.Suburb,
            patient.City, patient.Province, patient.PostalCode
        }.Where(s => !string.IsNullOrWhiteSpace(s)));

    if (string.IsNullOrWhiteSpace(address))
    {
        address = patient?.HomeAddress ?? "";
    }

    var urgencyClass = urgency == "STAT"
        ? "urgency-stat"
        : urgency == "Urgent"
            ? "urgency-urgent"
            : "urgency-routine";

    var resultStatusClass = Model.Status == "Verified"
        ? "status-completed"
        : Model.Status == "To Be Reviewed"
            ? "status-review"
            : "status-progress";

    var testStatusClass = testStatus == "Completed" || testStatus == "Verified"
        ? "status-completed"
        : testStatus == "In Progress"
            ? "status-progress"
            : "status-routine";

    // ---------- Workflow position ----------

    var currentStep = Model.Status switch
    {
        "Verified" => 5,
        "Completed" => 4,
        "To Be Reviewed" => 4,
        _ => testStatus switch
        {
            "Submitted" => 1,
            "Samples Received" => 2,
            "In Progress" => 3,
            "Completed" => 4,
            "Verified" => 5,
            _ => 4
        }
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="capture-page">

    <!-- BANNER -->

    <div class="banner">

        <div class="banner-left">

            <div class="banner-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>
                <h1>Laboratory Result Details</h1>
                <p>View the captured laboratory result and test information.</p>
            </div>

        </div>

        <div class="banner-stats">

            <div class="banner-test">
                <span>Laboratory test</span>
                <strong>@testName</strong>
            </div>

            <div class="banner-stat">
                <strong>TR-@(test?.RequestId)</strong>
                <span>Request</span>
            </div>

            <span class="banner-pill">
                <i class="fa-solid @(urgency == "STAT" ? "fa-bolt" : "fa-clock")"></i>
                @urgency
            </span>

        </div>

    </div>


    <!-- PROCESSING WORKFLOW -->

    <section class="panel">

        <div class="panel-head">
            <h2 class="panel-title">
                <i class="fa-solid fa-list-check"></i>
                Test processing workflow
            </h2>

            <span class="count-pill">@Model.Status</span>
        </div>

        <div class="workflow-body">

            <div class="workflow">
                @{
                    var workflowSteps = new[]
                    {
                        "Submitted",
                        "Sample Received",
                        "In Progress",
                        "Result Captured",
                        "Verified"
                    };
                }

                @for (var i = 0; i < workflowSteps.Length; i++)
                {
                    var stepNumber = i + 1;
                    var completed = stepNumber < currentStep;
                    var current = stepNumber == currentStep;

                    <div class="workflow-step @(completed ? "completed" : "") @(current ? "current" : "")">
                        <div class="step-circle">
                            @if (completed)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                @stepNumber
                            }
                        </div>

                        <span class="step-label">@workflowSteps[i]</span>
                    </div>

                    @if (i < workflowSteps.Length - 1)
                    {
                        <div class="step-line @(completed ? "line-completed" : "")"></div>
                    }
                }
            </div>

        </div>

    </section>


    <!-- PATIENT LEFT / TEST RIGHT -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-user"></i>
                    Patient information
                </h2>
            </div>

            <div class="card-body">

                <div class="patient-profile">

                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <span class="eyebrow">Patient</span>
                        <h3>@patient?.Name @patient?.Surname</h3>
                    </div>

                </div>

                <div class="patient-details">

                    <div class="patient-detail-row">
                        <span>ID number</span>
                        <strong>@Show(patient?.IDNumber)</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@Show(patient?.Email)</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@Show(patient?.CellphoneNumber)</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Address</span>
                        <strong>@Show(address)</strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-title">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <p>@Show(patient?.Allergies, "None recorded")</p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical conditions
                        </div>

                        <p>@Show(patient?.MedicalConditions, "None recorded")</p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <p>@Show(patient?.Medication, "None recorded")</p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-title">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor clinical notes
                </div>

                <div class="doctor-notes">

                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        @(string.IsNullOrWhiteSpace(doctorName) ? "Doctor's notes" : $"Notes from {doctorName}")
                    </div>

                    <p>
                        @Show(request?.ClinicalNotes, "No clinical notes were provided for this laboratory request.")
                    </p>

                </div>

            </div>

        </section>


        <!-- TEST INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-vials"></i>
                    Test information
                </h2>
            </div>

            <div class="card-body">

                <!-- TEST PROFILE -->

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">Laboratory test</span>
                        <h3>@testName</h3>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @category
                        </span>
                    </div>

                </div>

                <!-- SAMPLE AND CATEGORY -->

                <div class="sample-grid">

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-droplet"></i>
                            Sample type
                        </span>
                        <strong>@sampleType</strong>
                    </div>

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-flask"></i>
                            Test category
                        </span>
                        <strong>@category</strong>
                    </div>

                </div>

                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span>Request number</span>
                        <strong>TR-@(test?.RequestId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test item</span>
                        <strong>#@(test?.TestRequestItemId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Requesting doctor</span>
                        <strong>@Show(doctorName, "Not available")</strong>
                    </div>

                    <div class="test-detail">
                        <span>Request date</span>
                        <strong>@ShowDate(request?.RequestDate)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Current status</span>
                        <strong>
                            <span class="status-pill @testStatusClass">
                                <i class="fa-solid fa-circle"></i>
                                @testStatus
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Urgency</span>
                        <strong>
                            <span class="status-pill @urgencyClass">
                                @if (urgency == "STAT")
                                {
                                    <i class="fa-solid fa-bolt"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }
                                @urgency
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Assigned technician</span>
                        <strong>@Show(technicianName, "Not assigned")</strong>
                    </div>

                    <div class="test-detail">
                        <span>Turnaround time</span>
                        <strong>
                            @(testType != null
                                ? $"{testType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Date started</span>
                        <strong>@ShowDate(test?.StartDateTime)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Date completed</span>
                        <strong>@ShowDate(test?.CompletionDateTime)</strong>
                    </div>

                </div>

                <!-- CONFIGURED REFERENCE RANGE -->

                <div class="configured-range">
                    <span>Configured reference range</span>
                    <strong>
                        @(hasDefinedRange ? referenceRange : "No range configured")
                        @if (!string.IsNullOrWhiteSpace(displayUnit))
                        {
                            <small>@displayUnit</small>
                        }
                    </strong>
                </div>

            </div>

        </section>

    </div>


    <!-- RESULT -->

    <section class="panel result-card">

        <div class="panel-head">

            <h2 class="panel-title">
                <i class="fa-solid fa-clipboard-check"></i>
                Laboratory result
            </h2>

            @if (isAbnormal)
            {
                <span class="count-pill pill-danger">
                    <i class="fa-solid fa-triangle-exclamation"></i>
                    Abnormal result
                </span>
            }
            else
            {
                <span class="count-pill">
                    <i class="fa-solid fa-circle-check"></i>
                    Within reference range
                </span>
            }

        </div>

        <div class="result-body">

            <div class="section-title first-title">
                <i class="fa-solid fa-flask"></i>
                Captured laboratory findings
            </div>

            <div class="result-display-grid">

                <div class="result-tile result-main @abnormalClass">
                    <span class="result-label">Result</span>
                    <strong class="result-big">
                        @Model.ResultValue
                        <small>@displayUnit</small>
                    </strong>
                </div>

                <div class="result-tile @abnormalClass">
                    <span class="result-label">Reference range</span>
                    <strong class="result-medium">@Show(referenceRange, "Not specified")</strong>
                </div>

                <div class="result-tile">
                    <span class="result-label">Date captured</span>
                    <strong class="result-medium">@Model.DateCaptured.ToString("dd MMM yyyy HH:mm")</strong>
                </div>

            </div>

            @if (isAbnormal)
            {
                <div class="abnormal-alert" role="alert">
                    <strong>
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Abnormal result
                    </strong>
                    <p>This result is outside the expected reference range.</p>
                </div>
            }

            <!-- LABORATORY COMMENTS -->

            <div class="section-title">
                <i class="fa-solid fa-comment-medical"></i>
                Laboratory comments
            </div>

            <div class="doctor-notes">

                <div class="notes-heading">
                    <i class="fa-solid fa-comment"></i>
                    Technician notes
                </div>

                <p>
                    @Show(Model.Comments, "No laboratory comments were captured for this result.")
                </p>

            </div>

            <!-- RESULT SUMMARY -->

            <div class="capture-summary">

                <div class="summary-tile">
                    <i class="fa-solid fa-circle-check"></i>
                    <strong>Result status</strong>
                    <span>@Model.Status</span>
                </div>

                <div class="summary-tile @abnormalClass">
                    <i class="fa-solid @(isAbnormal ? "fa-triangle-exclamation" : "fa-shield-halved")"></i>
                    <strong>Interpretation</strong>
                    <span>@(isAbnormal ? "Abnormal" : "Normal")</span>
                </div>

                <div class="summary-tile">
                    <i class="fa-solid fa-calendar-check"></i>
                    <strong>Capture date</strong>
                    <span>@Model.DateCaptured.ToString("dd MMM yyyy")</span>
                </div>

                <div class="summary-tile">
                    <i class="fa-solid fa-clock"></i>
                    <strong>Capture time</strong>
                    <span>@Model.DateCaptured.ToString("HH:mm")</span>
                </div>

            </div>

            <div class="form-actions">

                <a asp-controller="CaptureResults"
                   asp-action="Index"
                   class="cancel-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    Back to tests
                </a>

                @if (Model.Status == "Completed" ||
                     Model.Status == "To Be Reviewed")
                {
                    <a asp-controller="CaptureResults"
                       asp-action="Edit"
                       asp-route-id="@Model.TestRequestItemId"
                       class="submit-button">
                        <i class="fa-solid fa-pen"></i>
                        Edit result
                    </a>
                }

            </div>

        </div>

    </section>

</div>

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b7a70;
        --teal-deep: #0a5f58;
        --teal-light: #e1f3f0;
        --teal-soft: #f2f8f7;
        --teal-border: #dbe9e7;
        --text: #12302f;
        --muted: #6f8584;
        --page-bg: #eaf1f1;
        --danger: #a32626;
        --danger-soft: #fde8e8;
        --danger-border: #f5c6c6;
        --warning: #8f5a00;
        --warning-soft: #fff3dc;
        --warning-border: #f3d9a0;
        --success: #17814a;
        --success-soft: #e4f6ec;
    }

    .capture-page,
    .capture-page * {
        box-sizing: border-box;
    }

    .capture-page {
        width: 100%;
        min-height: 100vh;
        padding: 28px 32px 48px;
        color: var(--text);
        background: var(--page-bg);
        font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }


    /* BANNER */

    .banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
    }

    .banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .banner-stats {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .banner-test {
        text-align: right;
    }

        .banner-test span,
        .banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }

        .banner-test span {
            margin: 0 0 4px;
        }

        .banner-test strong {
            display: block;
            font-size: 16px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

    .banner-stat {
        text-align: center;
    }

        .banner-stat strong {
            display: block;
            font-size: 20px;
            font-weight: 800;
            line-height: 1.15;
        }

    .banner-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* PANELS + CARDS */

    .panel,
    .information-card {
        min-width: 0;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
        overflow: hidden;
    }

    .panel {
        margin-bottom: 24px;
    }

    .panel-head,
    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 32px;
        border-bottom: 1px solid var(--teal-border);
        background: transparent;
        color: var(--text);
    }

        .panel-title,
        .card-header h2 {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--text);
        }

            .panel-title i,
            .card-header h2 i {
                color: var(--teal);
                font-size: 18px;
            }

    .count-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

        .count-pill.pill-danger {
            background: var(--danger-soft);
            color: var(--danger);
        }

    .card-body {
        padding: 26px 32px 30px;
    }

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 24px;
        margin-bottom: 24px;
    }

        .information-grid > .information-card {
            height: 100%;
        }


    /* SECTION HEADINGS */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 28px 0 14px;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .02em;
    }

        .section-title i {
            color: var(--teal);
        }

        .section-title.first-title {
            margin-top: 0;
        }


    /* WORKFLOW */

    .workflow-body {
        padding: 28px 32px 30px;
        overflow-x: auto;
    }

    .workflow {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 620px;
    }

    .workflow-step {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 0;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        flex: 0 0 40px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #e6eeed;
        color: var(--muted);
        font-size: 12px;
        font-weight: 800;
    }

    .workflow-step.completed .step-circle {
        background: var(--teal-dark);
        color: #fff;
    }

    .workflow-step.current .step-circle {
        background: var(--teal);
        color: #fff;
        box-shadow: 0 0 0 5px var(--teal-light);
    }

    .step-label {
        color: var(--muted);
        font-size: 12.5px;
        font-weight: 700;
        white-space: nowrap;
    }

    .workflow-step.current .step-label,
    .workflow-step.completed .step-label {
        color: var(--text);
    }

    .step-line {
        height: 3px;
        flex: 1;
        min-width: 14px;
        border-radius: 999px;
        background: var(--teal-border);
    }

        .step-line.line-completed {
            background: var(--teal-dark);
        }


    /* PATIENT */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 18px;
        margin-bottom: 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 18px;
    }

    .patient-avatar {
        width: 54px;
        height: 54px;
        flex: 0 0 54px;
        display: flex;
