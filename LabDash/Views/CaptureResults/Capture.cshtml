@* ============================================================
   STEP 1 — Replace the Google Fonts <link> near the top of the view
   (the screenshot uses Inter only; Poppins is no longer needed)
   ============================================================ *@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

@* ============================================================
   STEP 2 — Replace your whole <style> ... </style> block with this
   (markup does not need to change)
   ============================================================ *@

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --text: #0f2f2d;
        --muted: #6b817f;
        --border: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --danger: #c0443f;
        --danger-soft: #fde8e8;
        --danger-border: #f3c4c4;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
        --card-radius: 20px;
        --card-shadow: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .capture-page,
    .capture-page * {
        box-sizing: border-box;
    }

    .capture-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--text);
        background: var(--page-bg);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    /* ---------- HERO HEADER (gradient banner) ---------- */

    .capture-heading {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .capture-heading-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .capture-heading h1 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .capture-heading p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .heading-test {
        min-width: 220px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        background: transparent;
        border: 0;
        border-left: 1px solid rgba(255, 255, 255, .28);
        border-radius: 0;
        text-align: left;
    }

        .heading-test span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .heading-test strong {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
        }

    /* ---------- CARDS ---------- */

    .information-card,
    .workflow-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 22px;
        margin-bottom: 22px;
    }

        .information-grid > .information-card {
            height: 100%;
        }

    /* white card header with teal icon + bold title, divider underneath */
    .card-header {
        min-height: 64px;
        padding: 18px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #fff;
        color: var(--text);
        border-bottom: 1px solid var(--border);
        font-family: "Inter", sans-serif;
        font-size: 17px;
        font-weight: 700;
    }

        .card-header > span {
            display: inline-flex;
            align-items: center;
            gap: 11px;
        }

            .card-header > span > i {
                color: var(--teal);
                font-size: 16px;
            }

    .card-body {
        padding: 22px 26px 26px;
    }

    /* ---------- SECTION TITLES ---------- */

    .section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 22px 0 12px;
        color: var(--teal-deep);
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

        .section-title i {
            color: var(--teal);
        }

    /* ---------- PATIENT ---------- */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px;
        margin-bottom: 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .patient-avatar,
    .test-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff;
        color: var(--teal-dark);
        border: 2px solid #d5c98a;
        font-size: 20px;
    }

    .eyebrow {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .patient-profile h2,
    .test-profile h2 {
        margin: 0;
        color: var(--text);
        font-family: "Inter", sans-serif;
        font-size: 18px;
        font-weight: 700;
        line-height: 1.4;
        overflow-wrap: anywhere;
    }

    .patient-details {
        margin-bottom: 18px;
    }

    .patient-detail-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 11px 2px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
    }

        .patient-detail-row > span {
            color: var(--muted);
            flex-shrink: 0;
        }

        .patient-detail-row strong {
            max-width: 68%;
            text-align: right;
            font-weight: 600;
            overflow-wrap: anywhere;
        }

    /* ---------- CLINICAL INFORMATION ---------- */

    .clinical-list {
        display: grid;
        gap: 10px;
    }

    .clinical-item {
        padding: 12px 15px;
        border: 1px solid transparent;
        border-radius: 14px;
    }

        .clinical-item.allergy {
            color: #a23a3a;
            background: var(--danger-soft);
            border-color: var(--danger-border);
        }

        .clinical-item.condition {
            color: #8c6108;
            background: var(--warning-soft);
            border-color: #f5dfaa;
        }

        .clinical-item.medication {
            color: var(--teal-dark);
            background: var(--teal-light);
            border-color: var(--teal-border);
        }

    .clinical-item-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 12px;
        font-weight: 700;
    }

    .clinical-item p {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .doctor-notes {
        padding: 15px 16px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 14px;
    }

    .notes-heading {
        display: flex;
        gap: 8px;
        align-items: center;
        margin-bottom: 8px;
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
    }

    .doctor-notes p {
        margin: 0;
        color: #3f605d;
        font-size: 13px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    /* ---------- TEST PROFILE ---------- */

    .test-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px;
        margin-bottom: 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .test-profile-details {
        min-width: 0;
    }

    .test-icon {
        border: 0;
        border-radius: 14px;
        background: var(--teal-light);
        font-size: 22px;
    }

    .test-profile h2 {
        margin-bottom: 6px;
    }

    /* pill, same look as the "10 categories" badge */
    .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 11px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border: 0;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .sample-grid,
    .test-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
    }

    .sample-grid {
        margin-bottom: 12px;
    }

    .sample-box {
        min-width: 0;
        padding: 14px;
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

    .sample-label {
        display: block;
        margin-bottom: 6px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
    }

        .sample-label i {
            margin-right: 5px;
            color: var(--teal);
        }

    .sample-box strong {
        display: block;
        color: var(--teal-dark);
        font-size: 14px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .test-detail {
        min-width: 0;
        min-height: 64px;
        padding: 12px 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
    }

        .test-detail > span:first-child {
            display: block;
            margin-bottom: 5px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }

        .test-detail > strong {
            color: var(--text);
            font-size: 13px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

    .status-pill,
    .capture-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    .status-progress {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .status-completed {
        color: var(--success);
        background: var(--success-soft);
    }

    .status-routine {
        color: #607572;
        background: #edf4f3;
    }

    .urgency-stat {
        color: var(--danger);
        background: var(--danger-soft);
    }

    .urgency-urgent {
        color: #9a6c00;
        background: var(--warning-soft);
    }

    .urgency-routine {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .configured-range {
        padding: 14px 16px;
        margin-top: 12px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

        .configured-range > span {
            display: block;
            margin-bottom: 5px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
        }

        .configured-range strong {
            color: var(--teal-deep);
            font-family: "Inter", sans-serif;
            font-size: 17px;
            font-weight: 700;
        }

        .configured-range small {
            margin-left: 5px;
            color: var(--muted);
            font-family: "Inter", sans-serif;
            font-size: 12px;
            font-weight: 500;
        }

    /* ---------- WORKFLOW ---------- */

    .workflow-card {
        padding: 20px 26px 22px;
        margin-bottom: 22px;
    }

        .workflow-card > .section-title {
            margin-top: 0;
            margin-bottom: 18px;
            font-size: 15px;
        }

    .workflow {
        display: flex;
        align-items: center;
        gap: 9px;
    }

    .workflow-step {
        display: flex;
        align-items: center;
        gap: 9px;
        min-width: 0;
    }

    .step-circle {
        width: 34px;
        height: 34px;
        flex: 0 0 34px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #edf2f1;
        color: #879795;
        font-size: 12px;
        font-weight: 700;
    }

    .workflow-step.completed .step-circle,
    .workflow-step.current .step-circle {
        background: var(--btn-gradient);
        color: #fff;
    }

    .workflow-step.current .step-circle {
        box-shadow: 0 0 0 5px rgba(15, 148, 136, .14);
    }

    .step-label {
        color: var(--muted);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .workflow-step.current .step-label,
    .workflow-step.completed .step-label {
        color: var(--teal-dark);
    }

    .step-line {
        height: 2px;
        flex: 1;
        min-width: 8px;
        background: #dce8e6;
    }

        .step-line.line-completed {
            background: var(--teal);
        }

    /* ---------- RETURNED NOTICE ---------- */

    .review-alert {
        padding: 16px 20px;
        margin-bottom: 22px;
        background: var(--warning-soft);
        border: 1px solid #efdca2;
        border-left: 4px solid #c58a00;
        border-radius: 16px;
        box-shadow: var(--card-shadow);
    }

    .alert-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 5px;
        color: #765300;
        font-size: 14px;
        font-weight: 700;
    }

    .review-alert p {
        margin: 0;
        color: #6f5a2d;
        font-size: 13px;
        line-height: 1.7;
    }

    /* ---------- RESULT FORM ---------- */

    .result-card {
        margin-top: 22px;
    }

    .capture-badge {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .result-body {
        padding: 24px 26px 28px;
    }

        .result-body > .section-title {
            margin-top: 0;
            margin-bottom: 18px;
        }

    .result-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 20px;
    }

    .form-field {
        display: flex;
        flex-direction: column;
        min-width: 0;
        gap: 8px;
    }

    .full-width {
        grid-column: 1 / -1;
    }

    .form-field label {
        color: var(--text);
        font-size: 13px;
        font-weight: 600;
    }

    /* soft, tinted inputs like the search bar in the screenshot */
    .form-control {
        width: 100%;
        min-width: 0;
        min-height: 46px;
        padding: 12px 16px;
        color: var(--text);
        background: var(--field-bg);
        border: 1px solid var(--teal-border);
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        outline: none;
        transition: border-color .15s, box-shadow .15s, background .15s;
    }

        .form-control::placeholder {
            color: #8aa09e;
        }

        .form-control:focus {
            background: #fff;
            border-color: var(--teal);
            box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
        }

        .form-control[readonly] {
            background: #f3f8f7;
            color: #59716e;
        }

    .result-value-input {
        color: var(--teal-dark);
        font-size: 18px;
        font-weight: 700;
    }

    .result-textarea {
        min-height: 120px;
        resize: vertical;
        line-height: 1.7;
    }

    .input-helper {
        color: var(--muted);
        font-size: 12px;
        line-height: 1.5;
    }

        .input-helper i {
            margin-right: 5px;
            color: var(--teal);
        }

    .field-validation-error,
    .validation-summary {
        color: var(--danger);
        font-size: 12px;
    }

    #abnormalAlert {
        display: none;
        padding: 15px 18px;
        background: var(--danger-soft);
        border: 1px solid var(--danger-border);
        border-left: 4px solid var(--danger);
        border-radius: 14px;
    }

        #abnormalAlert strong {
            display: block;
            margin-bottom: 5px;
            color: var(--danger);
            font-size: 14px;
            font-weight: 700;
        }

        #abnormalAlert p {
            margin: 0;
            color: #7c343b;
            font-size: 13px;
            line-height: 1.6;
        }

    .is-valid-custom {
        border: 2px solid var(--success) !important;
        background: #f5fff8 !important;
    }

    .is-invalid-custom {
        border: 2px solid var(--danger) !important;
        background: #fff7f7 !important;
    }

    /* ---------- CAPTURE SUMMARY ---------- */

    .capture-summary {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 12px;
        padding-top: 22px;
        margin-top: 24px;
        border-top: 1px solid var(--border);
    }

    .summary-tile {
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 6px;
        padding: 16px 10px;
        text-align: center;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

        .summary-tile i {
            color: var(--teal);
            font-size: 18px;
        }

        .summary-tile strong {
            color: var(--text);
            font-size: 12px;
            font-weight: 700;
        }

        .summary-tile span {
            color: var(--muted);
            font-size: 12px;
        }

    /* ---------- BUTTONS ---------- */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 12px;
        padding-top: 20px;
        margin-top: 22px;
        border-top: 1px solid var(--border);
    }

    .cancel-button,
    .submit-button {
        min-height: 46px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 9px;
        padding: 12px 22px;
        border-radius: 12px;
        font-family: "Inter", sans-serif;
        font-size: 14px;
        font-weight: 600;
        text-decoration: none;
        cursor: pointer;
        transition: background .15s, box-shadow .15s, transform .1s;
    }

    .cancel-button {
        color: #3f605d;
        background: #fff;
        border: 1px solid var(--teal-border);
    }

        .cancel-button:hover {
            color: var(--teal-dark);
            background: var(--teal-soft);
        }

    /* gradient button with soft teal shadow, like "Add Category" */
    .submit-button {
        color: #fff;
        background: var(--btn-gradient);
        border: 0;
        box-shadow: 0 8px 18px rgba(10, 93, 85, .28);
    }

        .submit-button:hover {
            color: #fff;
            box-shadow: 0 10px 22px rgba(10, 93, 85, .36);
            transform: translateY(-1px);
        }

        .cancel-button:focus-visible,
        .submit-button:focus-visible {
            outline: 3px solid rgba(15, 148, 136, .35);
            outline-offset: 2px;
        }

    /* ---------- RESPONSIVE ---------- */

    @@media (max-width: 1000px) {
        .capture-page {
            padding: 18px 15px 35px;
        }

        .information-grid {
            gap: 16px;
        }

        .card-body {
            padding: 18px;
        }

        .workflow {
            flex-wrap: wrap;
            row-gap: 12px;
        }
    }

    @@media (max-width: 760px) {
        .information-grid {
            grid-template-columns: minmax(0, 1fr);
        }

            .information-grid > .information-card {
                height: auto;
            }

        .heading-test {
            display: none;
        }

        .workflow {
            justify-content: flex-start;
            overflow-x: auto;
            flex-wrap: nowrap;
            padding: 5px 0;
        }

        .workflow-step {
            flex-shrink: 0;
        }

        .step-line {
            flex: 0 0 20px;
        }

        .step-label {
            white-space: normal;
            max-width: 80px;
        }
    }

    @@media (max-width: 500px) {
        .capture-page {
            padding: 12px 9px 28px;
        }

        .capture-heading {
            padding: 18px;
            border-radius: 20px;
        }

            .capture-heading h1 {
                font-size: 19px;
            }

        .card-header {
            padding: 14px 16px;
            font-size: 15px;
        }

        .card-body,
        .result-body {
            padding: 16px;
        }

        .test-detail-grid,
        .sample-grid,
        .result-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .full-width {
            grid-column: auto;
        }

        .capture-summary {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .cancel-button,
        .submit-button {
            width: 100%;
        }
    }
</style>