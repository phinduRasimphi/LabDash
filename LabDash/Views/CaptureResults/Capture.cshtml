
@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Capture Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;

    var urgency = test?.TestRequest?.Urgency ?? "Routine";
    var status = test?.Status ?? "In Progress";
    var unit = test?.TestType?.UnitOfMeasurement ?? "";
    var testName = test?.TestType?.Name ?? "Laboratory Test";
    var category = test?.TestType?.Category ?? "Not specified";
    var sampleType = test?.TestType?.RequiredSampleType ?? "Not specified";

    var hasDefinedRange = !string.IsNullOrWhiteSpace(Model.ReferenceRange);

    var urgencyClass = urgency == "STAT"
        ? "urgency-stat"
        : urgency == "Urgent"
            ? "urgency-urgent"
            : "urgency-routine";

    var statusClass = status == "Completed"
        ? "status-completed"
        : status == "In Progress"
            ? "status-progress"
            : "status-routine";

    var currentStep = status switch
    {
        "Submitted" => 1,
        "Samples Received" => 2,
        "In Progress" => 3,
        "Completed" => 4,
        "Verified" => 5,
        _ => 3
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="capture-page">

    <!-- WORKFLOW HEADER -->

    <div class="capture-heading">
        <div class="capture-heading-icon">
            <i class="fa-solid fa-flask-vial"></i>
        </div>

        <div>
            <h1>Capture Laboratory Result</h1>
            <p>Review patient information and enter laboratory findings.</p>
        </div>

        <div class="heading-test">
            <span>Current Laboratory Test</span>
            <strong>@testName</strong>
        </div>
    </div>

    <!-- PROCESSING WORKFLOW -->

    <section class="workflow-card">
        <div class="section-title">
            <i class="fa-solid fa-list-check"></i>
            Test Processing Workflow
        </div>

        <div class="workflow">
            @{
                var workflowSteps = new[]
                {
                    "Submitted",
                    "Sample Received",
                    "In Progress",
                    "Result Captured",
                    "Verified"
                };
            }

            @for (var i = 0; i < workflowSteps.Length; i++)
            {
                var stepNumber = i + 1;
                var completed = stepNumber < currentStep;
                var current = stepNumber == currentStep;

                <div class="workflow-step @(completed ? "completed" : "") @(current ? "current" : "")">
                    <div class="step-circle">
                        @if (completed)
                        {
                            <i class="fa-solid fa-check"></i>
                        }
                        else
                        {
                            @stepNumber
                        }
                    </div>

                    <span class="step-label">@workflowSteps[i]</span>
                </div>

                @if (i < workflowSteps.Length - 1)
                {
                    <div class="step-line @(completed ? "line-completed" : "")"></div>
                }
            }
        </div>
    </section>

    <!-- RETURNED RESULT NOTICE -->

    @if (ViewBag.IsResubmission == true)
    {
        <div class="review-alert">
            <div class="alert-heading">
                <i class="fa-solid fa-rotate-left"></i>
                Result Returned for Review
            </div>

            <p>
                This result was returned by a verifier and must be corrected
                before it can be submitted again.

                @if (!string.IsNullOrWhiteSpace(ViewBag.PreviousVerificationNote as string))
                {
                    <span>
                        <strong>Verifier's note:</strong>
                        @ViewBag.PreviousVerificationNote
                    </span>
                }
            </p>
        </div>
    }

    <!-- PATIENT LEFT / TEST RIGHT -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <span>
                    <i class="fa-solid fa-user"></i>
                    Patient Information
                </span>
            </div>

            <div class="card-body">

                <div class="patient-profile">
                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <span class="eyebrow">PATIENT</span>
                        <h2>@patient?.Name @patient?.Surname</h2>
                    </div>
                </div>

                <div class="patient-details">

                    <div class="patient-detail-row">
                        <span>ID Number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of Birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-title">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical Information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical Conditions
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-title">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor Clinical Notes
                </div>

                <div class="doctor-notes">
                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's Notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided for this laboratory request."
                            : test.TestRequest.ClinicalNotes)
                    </p>
                </div>

            </div>
        </section>

        <!-- TEST INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <span>
                    <i class="fa-solid fa-vials"></i>
                    Test Information
                </span>
            </div>

            <div class="card-body">

                <!-- TEST PROFILE -->

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">LABORATORY TEST</span>
                        <h2>@testName</h2>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @category
                        </span>
                    </div>

                </div>

                <!-- SAMPLE AND UNIT -->

                <div class="sample-grid">

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-droplet"></i>
                            Sample Type
                        </span>
                        <strong>@sampleType</strong>
                    </div>

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-flask"></i>
                            Test Category
                        </span>
                        <strong>@category</strong>
                    </div>

                </div>

                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span>Request Number</span>
                        <strong>TR-@test?.RequestId</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test Item</span>
                        <strong>#@test?.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail">
                        <span>Unit of Measurement</span>
                        <strong>@(string.IsNullOrWhiteSpace(unit) ? "Not specified" : unit)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Reference Range</span>
                        <strong>@(hasDefinedRange ? Model.ReferenceRange : "Not specified")</strong>
                    </div>

                    <div class="test-detail">
                        <span>Current Status</span>
                        <strong>
                            <span class="status-pill @statusClass">
                                <i class="fa-solid fa-circle"></i>
                                @status
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Urgency</span>
                        <strong>
                            <span class="status-pill @urgencyClass">
                                @if (urgency == "STAT")
                                {
                                    <i class="fa-solid fa-bolt"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }
                                @urgency
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Date Started</span>
                        <strong>
                            @(test?.StartDateTime.HasValue == true
                                ? test.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not available")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Turnaround Time</span>
                        <strong>
                            @(test?.TestType?.TurnaroundTimeMinutes != null
                                ? $"{test.TestType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                </div>

                <!-- CONFIGURED REFERENCE RANGE -->

                <div class="configured-range">
                    <span>Configured Reference Range</span>
                    <strong>
                        @(hasDefinedRange ? Model.ReferenceRange : "No range configured")
                        @if (!string.IsNullOrWhiteSpace(unit))
                        {
                            <small>@unit</small>
                        }
                    </strong>
                </div>

            </div>
        </section>

    </div>

    <!-- RESULT ENTRY -->

    <section class="information-card result-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-clipboard-check"></i>
                Laboratory Result Entry
            </span>

            <span class="capture-badge">
                <i class="fa-solid fa-pen-to-square"></i>
                Technician Capture
            </span>
        </div>

        <div class="result-body">

            <form asp-controller="CaptureResults"
                  asp-action="Capture"
                  method="post">

                <input type="hidden"
                       name="TestRequestItemId"
                       value="@Model.TestRequestItemId" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="section-title">
                    <i class="fa-solid fa-flask"></i>
                    Enter Laboratory Findings
                </div>

                <div class="result-grid">

                    <div class="form-field">
                        <label asp-for="ResultValue">Result Value</label>

                        <input asp-for="ResultValue"
                               id="ResultValue"
                               class="form-control result-value-input"
                               placeholder="Enter numeric result"
                               autocomplete="off"
                               inputmode="decimal"
                               type="text"
                               maxlength="20" />

                        <span asp-validation-for="ResultValue"
                              class="field-validation-error"></span>

                        <small class="input-helper">
                            <i class="fa-solid fa-calculator"></i>
                            Numbers and decimal values are allowed.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="Units">Units</label>

                        <input asp-for="Units"
                               class="form-control"
                               value="@unit"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-lock"></i>
                            Determined by the selected test.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="ReferenceRange">Reference Range</label>

                        <input asp-for="ReferenceRange"
                               id="ReferenceRange"
                               class="form-control"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-shield-halved"></i>
                            @if (hasDefinedRange)
                            {
                                <text>Results outside this range will be flagged.</text>
                            }
                            else
                            {
                                <text>No numeric reference range is defined.</text>
                            }
                        </small>
                    </div>

                    <div class="form-field">
                        <label>Capture Date &amp; Time</label>

                        <input class="form-control"
                               readonly
                               value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" />

                        <small class="input-helper">
                            <i class="fa-solid fa-clock"></i>
                            Current system date and time.
                        </small>
                    </div>

                    <div class="form-field full-width">
                        <div id="abnormalAlert" role="alert">
                            <strong>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal Result Detected
                            </strong>
                            <p>
                                The entered result appears to fall outside
                                the configured reference range. Please verify the value.
                            </p>
                        </div>
                    </div>

                    <div class="form-field full-width">
                        <label asp-for="Comments">Laboratory Comments / Notes</label>

                        <textarea asp-for="Comments"
                                  class="form-control result-textarea"
                                  rows="4"
                                  placeholder="Enter observations, abnormalities, interpretation or additional laboratory notes..."></textarea>

                        <span asp-validation-for="Comments"
                              class="field-validation-error"></span>
                    </div>

                </div>

                <!-- CAPTURE SUMMARY -->

                <div class="capture-summary">

                    <div class="summary-tile">
                        <i class="fa-solid fa-user-doctor"></i>
                        <strong>Captured By</strong>
                        <span>Logged-in Technician</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-vial-circle-check"></i>
                        <strong>Next Step</strong>
                        <span>Verification</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-calendar-check"></i>
                        <strong>Capture Date</strong>
                        <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-clock"></i>
                        <strong>Capture Time</strong>
                        <span>@DateTime.Now.ToString("HH:mm")</span>
                    </div>

                </div>

                <div class="form-actions">

                    <a asp-action="Index" class="cancel-button">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to Tests
                    </a>

                    <button type="submit" class="submit-button">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save Laboratory Result
                    </button>

                </div>

            </form>
        </div>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {
            const resultInput = document.getElementById("ResultValue");
            const rangeInput = document.getElementById("ReferenceRange");
            const abnormalAlert = document.getElementById("abnormalAlert");

            if (!resultInput || !rangeInput || !abnormalAlert) {
                return;
            }

            function checkAbnormalResult() {
                abnormalAlert.style.display = "none";

                resultInput.classList.remove(
                    "is-invalid-custom",
                    "is-valid-custom"
                );

                const resultText = resultInput.value.trim();
                const rangeTextOriginal = rangeInput.value.trim();

                if (!resultText || !rangeTextOriginal) {
                    return;
                }

                const result = parseFloat(resultText.replace(",", "."));

                if (Number.isNaN(result)) {
                    return;
                }

                const rangeText = rangeTextOriginal
                    .replace(/[–—]/g, "-")
                    .replace(/\s/g, "");

                const match = rangeText.match(
                    /^(-?\d+(?:\.\d+)?)-(-?\d+(?:\.\d+)?)$/
                );

                if (!match) {
                    return;
                }

                const minimum = parseFloat(match[1]);
                const maximum = parseFloat(match[2]);

                if (Number.isNaN(minimum) || Number.isNaN(maximum)) {
                    return;
                }

                if (result < minimum || result > maximum) {
                    abnormalAlert.style.display = "block";
                    resultInput.classList.add("is-invalid-custom");
                } else {
                    resultInput.classList.add("is-valid-custom");
                }
            }

            resultInput.addEventListener("input", function () {
                let value = this.value.replace(/[^0-9.]/g, "");
                const firstDot = value.indexOf(".");

                if (firstDot !== -1) {
                    value = value.substring(0, firstDot + 1)
                        + value.substring(firstDot + 1).replace(/\./g, "");
                }

                this.value = value;
                checkAbnormalResult();
            });

            resultInput.addEventListener("paste", function (event) {
                event.preventDefault();

                const pastedText = (event.clipboardData || window.clipboardData)
                    .getData("text");

                let cleaned = pastedText.replace(/[^0-9.]/g, "");
                const firstDot = cleaned.indexOf(".");

                if (firstDot !== -1) {
                    cleaned = cleaned.substring(0, firstDot + 1)
                        + cleaned.substring(firstDot + 1).replace(/\./g, "");
                }

                const start = this.selectionStart ?? this.value.length;
                const end = this.selectionEnd ?? this.value.length;

                this.setRangeText(cleaned, start, end, "end");
                this.dispatchEvent(new Event("input", { bubbles: true }));
            });

            checkAbnormalResult();
        });
    </script>
}

<style>
    :root {
        --teal: #008f83;
        --teal-dark: #006f67;
        --teal-deep: #005c55;
        --teal-light: #e8f7f5;
        --teal-soft: #f1faf8;
        --teal-border: #ccebe7;
        --teal-bright: #00a99a;
        --text: #173a3a;
        --muted: #718785;
        --border: #dcebea;
        --danger: #dc3545;
        --danger-soft: #fde9eb;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
    }

    .capture-page,
    .capture-page * {
        box-sizing: border-box;
    }

    .capture-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 22px 24px 48px;
        color: var(--text);
        background: #f3faf9;
        font-family: "Inter", sans-serif;
    }

    /* HEADER */

    .capture-heading {
        display: flex;
        align-items: center;
        gap: 15px;
        padding: 0 0 22px;
    }

    .capture-heading-icon {
        width: 49px;
        height: 49px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        color: var(--teal-dark);
        background: #d8f1ed;
        font-size: 21px;
    }

    .capture-heading h1 {
        margin: 0 0 4px;
        color: var(--teal-deep);
        font-family: "Poppins", sans-serif;
        font-size: 22px;
        font-weight: 800;
    }

    .capture-heading p {
        margin: 0;
        color: var(--muted);
        font-size: 12px;
        line-height: 1.6;
    }

    .heading-test {
        min-width: 200px;
        margin-left: auto;
        padding: 11px 14px;
        background: white;
        border: 1px solid var(--teal-border);
        border-radius: 11px;
    }

    .heading-test span {
        display: block;
        margin-bottom: 4px;
        color: var(--muted);
        font-size: 9px;
        text-transform: uppercase;
    }

    .heading-test strong {
        color: var(--teal-dark);
        font-size: 12px;
    }

    /* CARDS */

    .information-card,
    .workflow-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 17px;
        box-shadow: 0 5px 20px rgba(16, 79, 72, .055);
    }

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 20px;
        margin-bottom: 20px;
    }

    .information-grid > .information-card {
        height: 100%;
    }

    .card-header {
        min-height: 47px;
        padding: 13px 19px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--teal);
        color: #fff;
        font-family: "Poppins", sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

    .card-header > span {
        display: inline-flex;
        align-items: center;
        gap: 9px;
    }

    .card-body {
        padding: 18px;
    }

    /* SHARED SECTION HEADINGS */

    .section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 17px 0 10px;
        color: var(--teal-dark);
        font-family: "Poppins", sans-serif;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .section-title i {
        color: var(--teal);
    }

    /* PATIENT */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 13px;
        margin-bottom: 12px;
        background: linear-gradient(120deg, var(--teal-light), #f8fcfb);
        border: 1px solid var(--teal-border);
        border-radius: 12px;
    }

    .patient-avatar,
    .test-icon {
        width: 49px;
        height: 49px;
        flex: 0 0 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #d4efeb;
        color: var(--teal-dark);
        font-size: 20px;
    }

    .eyebrow {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
    }

    .patient-profile h2,
    .test-profile h2 {
        margin: 0;
        color: var(--teal-deep);
        font-family: "Poppins", sans-serif;
        font-size: 16px;
        font-weight: 800;
        line-height: 1.45;
        overflow-wrap: anywhere;
    }

    .patient-details {
        margin-bottom: 16px;
    }

    .patient-detail-row {
        display: flex;
        justify-content: space-between;
        gap: 12px;
        padding: 9px 2px;
        border-bottom: 1px solid #e8f0ef;
        font-size: 11px;
    }

    .patient-detail-row > span {
        color: var(--muted);
        flex-shrink: 0;
    }

    .patient-detail-row strong {
        max-width: 68%;
        text-align: right;
        overflow-wrap: anywhere;
    }

    /* CLINICAL INFORMATION */

    .clinical-list {
        display: grid;
        gap: 8px;
    }

    .clinical-item {
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: 10px;
    }

    .clinical-item.allergy {
        color: #a52b36;
        background: #fde9eb;
        border-color: #f8cdd1;
    }

    .clinical-item.condition {
        color: #8c6108;
        background: #fff3d9;
        border-color: #f5dfaa;
    }

    .clinical-item.medication {
        color: var(--teal-dark);
        background: #e1f4f2;
        border-color: #c4e9e5;
    }

    .clinical-item-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        font-size: 10px;
        font-weight: 800;
    }

    .clinical-item p {
        margin: 0;
        font-size: 11px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    .doctor-notes {
        padding: 13px;
