@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Capture Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;

    var urgency = test?.TestRequest?.Urgency ?? "Routine";
    var status = test?.Status ?? "In Progress";
    var unit = test?.TestType?.UnitOfMeasurement ?? "";
    var testName = test?.TestType?.Name ?? "Laboratory Test";
    var category = test?.TestType?.Category ?? "Not specified";
    var sampleType = test?.TestType?.RequiredSampleType ?? "Not specified";

    var hasDefinedRange = !string.IsNullOrWhiteSpace(Model.ReferenceRange);

    var urgencyClass = urgency == "STAT"
        ? "urgency-stat"
        : urgency == "Urgent"
            ? "urgency-urgent"
            : "urgency-routine";

    var statusClass = status == "Completed"
        ? "status-completed"
        : status == "In Progress"
            ? "status-progress"
            : "status-routine";

    var currentStep = status switch
    {
        "Submitted" => 1,
        "Samples Received" => 2,
        "In Progress" => 3,
        "Completed" => 4,
        "Verified" => 5,
        _ => 3
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="capture-page">

    <!-- BANNER -->

    <div class="banner">

        <div class="banner-left">

            <div class="banner-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>
                <h1>Capture Laboratory Result</h1>
                <p>Review patient information and enter laboratory findings.</p>
            </div>

        </div>

        <div class="banner-stats">

            <div class="banner-test">
                <span>Current laboratory test</span>
                <strong>@testName</strong>
            </div>

            <div class="banner-stat">
                <strong>TR-@(test?.RequestId)</strong>
                <span>Request</span>
            </div>

            <span class="banner-pill">
                <i class="fa-solid @(urgency == "STAT" ? "fa-bolt" : "fa-clock")"></i>
                @urgency
            </span>

        </div>

    </div>


    <!-- PROCESSING WORKFLOW -->

    <section class="panel">

        <div class="panel-head">
            <h2 class="panel-title">
                <i class="fa-solid fa-list-check"></i>
                Test processing workflow
            </h2>

            <span class="count-pill">@status</span>
        </div>

        <div class="workflow-body">

            <div class="workflow">
                @{
                    var workflowSteps = new[]
                    {
                        "Submitted",
                        "Sample Received",
                        "In Progress",
                        "Result Captured",
                        "Verified"
                    };
                }

                @for (var i = 0; i < workflowSteps.Length; i++)
                {
                    var stepNumber = i + 1;
                    var completed = stepNumber < currentStep;
                    var current = stepNumber == currentStep;

                    <div class="workflow-step @(completed ? "completed" : "") @(current ? "current" : "")">
                        <div class="step-circle">
                            @if (completed)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                @stepNumber
                            }
                        </div>

                        <span class="step-label">@workflowSteps[i]</span>
                    </div>

                    @if (i < workflowSteps.Length - 1)
                    {
                        <div class="step-line @(completed ? "line-completed" : "")"></div>
                    }
                }
            </div>

        </div>

    </section>


    <!-- RETURNED RESULT NOTICE -->
    @if (ViewBag.IsResubmission == true)
    {
        <div class="review-alert" role="alert">

            <div class="alert-heading">
                <i class="fa-solid fa-rotate-left"></i>
                Result returned for review
            </div>

            <p>
                This result was returned by a verifier and must be corrected
                before it can be submitted again.

                @if (!string.IsNullOrWhiteSpace(ViewBag.PreviousVerificationNote as string))
                {
                    <span>
                        <strong>Verifier's note:</strong>
                        @ViewBag.PreviousVerificationNote
                    </span>
                }
            </p>

        </div>
    }


    <!-- PATIENT LEFT / TEST RIGHT -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-user"></i>
                    Patient information
                </h2>
            </div>

            <div class="card-body">

                <div class="patient-profile">

                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <span class="eyebrow">Patient</span>
                        <h3>@patient?.Name @patient?.Surname</h3>
                    </div>

                </div>

                <div class="patient-details">

                    <div class="patient-detail-row">
                        <span>ID number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-title">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical conditions
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-title">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor clinical notes
                </div>

                <div class="doctor-notes">

                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided for this laboratory request."
                            : test.TestRequest.ClinicalNotes)
                    </p>

                </div>

            </div>

        </section>


        <!-- TEST INFORMATION -->

        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-vials"></i>
                    Test information
                </h2>
            </div>

            <div class="card-body">

                <!-- TEST PROFILE -->

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">Laboratory test</span>
                        <h3>@testName</h3>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @category
                        </span>
                    </div>

                </div>

                <!-- SAMPLE AND CATEGORY -->

                <div class="sample-grid">

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-droplet"></i>
                            Sample type
                        </span>
                        <strong>@sampleType</strong>
                    </div>

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-flask"></i>
                            Test category
                        </span>
                        <strong>@category</strong>
                    </div>

                </div>

                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span>Request number</span>
                        <strong>TR-@(test?.RequestId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test item</span>
                        <strong>#@(test?.TestRequestItemId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Unit of measurement</span>
                        <strong>@(string.IsNullOrWhiteSpace(unit) ? "Not specified" : unit)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Reference range</span>
                        <strong>@(hasDefinedRange ? Model.ReferenceRange : "Not specified")</strong>
                    </div>

                    <div class="test-detail">
                        <span>Current status</span>
                        <strong>
                            <span class="status-pill @statusClass">
                                <i class="fa-solid fa-circle"></i>
                                @status
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Urgency</span>
                        <strong>
                            <span class="status-pill @urgencyClass">
                                @if (urgency == "STAT")
                                {
                                    <i class="fa-solid fa-bolt"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }
                                @urgency
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Date started</span>
                        <strong>
                            @(test?.StartDateTime.HasValue == true
                                ? test.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not available")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Turnaround time</span>
                        <strong>
                            @(test?.TestType?.TurnaroundTimeMinutes != null
                                ? $"{test.TestType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                </div>

                <!-- CONFIGURED REFERENCE RANGE -->

                <div class="configured-range">
                    <span>Configured reference range</span>
                    <strong>
                        @(hasDefinedRange ? Model.ReferenceRange : "No range configured")
                        @if (!string.IsNullOrWhiteSpace(unit))
                        {
                            <small>@unit</small>
                        }
                    </strong>
                </div>

            </div>

        </section>

    </div>


    <!-- RESULT ENTRY -->

    <section class="panel result-card">

        <div class="panel-head">

            <h2 class="panel-title">
                <i class="fa-solid fa-clipboard-check"></i>
                Laboratory result entry
            </h2>

            <span class="count-pill">
                <i class="fa-solid fa-pen-to-square"></i>
                Technician capture
            </span>

        </div>

        <div class="result-body">

            <form asp-controller="CaptureResults"
                  asp-action="Capture"
                  method="post">

                <input type="hidden"
                       name="TestRequestItemId"
                       value="@Model.TestRequestItemId" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="section-title first-title">
                    <i class="fa-solid fa-flask"></i>
                    Enter laboratory findings
                </div>

                <div class="result-grid">

                    <div class="form-field">
                        <label asp-for="ResultValue">Result value</label>

                        <input asp-for="ResultValue"
                               id="ResultValue"
                               class="form-control result-value-input"
                               placeholder="Enter numeric result"
                               autocomplete="off"
                               inputmode="decimal"
                               type="text"
                               maxlength="20" />

                        <span asp-validation-for="ResultValue"
                              class="field-validation-error"></span>

                        <small class="input-helper">
                            <i class="fa-solid fa-calculator"></i>
                            Numbers and decimal values are allowed.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="Units">Units</label>

                        <input asp-for="Units"
                               class="form-control"
                               value="@unit"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-lock"></i>
                            Determined by the selected test.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="ReferenceRange">Reference range</label>

                        <input asp-for="ReferenceRange"
                               id="ReferenceRange"
                               class="form-control"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-shield-halved"></i>
                            @if (hasDefinedRange)
                            {
                                <text>Results outside this range will be flagged.</text>
                            }
                            else
                            {
                                <text>No numeric reference range is defined.</text>
                            }
                        </small>
                    </div>

                    <div class="form-field">
                        <label>Capture date &amp; time</label>

                        <input class="form-control"
                               readonly
                               value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" />

                        <small class="input-helper">
                            <i class="fa-solid fa-clock"></i>
                            Current system date and time.
                        </small>
                    </div>

                    <div class="form-field full-width">
                        <div id="abnormalAlert" role="alert">
                            <strong>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal result detected
                            </strong>
                            <p>
                                The entered result appears to fall outside
                                the configured reference range. Please verify the value.
                            </p>
                        </div>
                    </div>

                    <div class="form-field full-width">
                        <label asp-for="Comments">Laboratory comments / notes</label>

                        <textarea asp-for="Comments"
                                  class="form-control result-textarea"
                                  rows="4"
                                  placeholder="Enter observations, abnormalities, interpretation or additional laboratory notes..."></textarea>

                        <span asp-validation-for="Comments"
                              class="field-validation-error"></span>
                    </div>

                </div>

                <!-- CAPTURE SUMMARY -->

                <div class="capture-summary">

                    <div class="summary-tile">
                        <i class="fa-solid fa-user-doctor"></i>
                        <strong>Captured by</strong>
                        <span>Logged-in technician</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-vial-circle-check"></i>
                        <strong>Next step</strong>
                        <span>Verification</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-calendar-check"></i>
                        <strong>Capture date</strong>
                        <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-clock"></i>
                        <strong>Capture time</strong>
                        <span>@DateTime.Now.ToString("HH:mm")</span>
                    </div>

                </div>

                <div class="form-actions">

                    <a asp-action="Index" class="cancel-button">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to tests
                    </a>

                    <button type="submit" class="submit-button">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save laboratory result
                    </button>

                </div>

            </form>

        </div>

    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function() {
            const resultInput = document.getElementById("ResultValue");
            const rangeInput = document.getElementById("ReferenceRange");
            const abnormalAlert = document.getElementById("abnormalAlert");

            if (!resultInput || !rangeInput || !abnormalAlert) {
                return;
            }

            function checkAbnormalResult() {
                abnormalAlert.style.display = "none";

                resultInput.classList.remove(
                    "is-invalid-custom",
                    "is-valid-custom"
                );

                const resultText = resultInput.value.trim();
                const rangeTextOriginal = rangeInput.value.trim();

                if (!resultText || !rangeTextOriginal) {
                    return;
                }

                const result = parseFloat(resultText.replace(",", "."));

                if (Number.isNaN(result)) {
                    return;
                }

                const rangeText = rangeTextOriginal
                    .replace(/[–—]/g, "-")
                    .replace(/\s/g, "");

                const match = rangeText.match(
                    /^(-?\d+(?:\.\d+)?)-(-?\d+(?:\.\d+)?)$/
                );

                if (!match) {
                    return;
                }

                const minimum = parseFloat(match[1]);
                const maximum = parseFloat(match[2]);

                if (Number.isNaN(minimum) || Number.isNaN(maximum)) {
                    return;
                }

                if (result < minimum || result > maximum) {
                    abnormalAlert.style.display = "block";
                    resultInput.classList.add("is-invalid-custom");
                } else {
                    resultInput.classList.add("is-valid-custom");
                }
            }

            resultInput.addEventListener("input", function() {
                let value = this.value.replace(/[^0-9.]/g, "");
                const firstDot = value.indexOf(".");

                if (firstDot !== -1) {
                    value = value.substring(0, firstDot + 1)
                        + value.substring(firstDot + 1).replace(/\./g, "");
                }

                this.value = value;
                checkAbnormalResult();
            });

            resultInput.addEventListener("paste", function(event) {
                event.preventDefault();

                const pastedText = (event.clipboardData || window.clipboardData)
                    .getData("text");

                let cleaned = pastedText.replace(/[^0-9.]/g, "");
                const firstDot = cleaned.indexOf(".");

                if (firstDot !== -1) {
                    cleaned = cleaned.substring(0, firstDot + 1)
                        + cleaned.substring(firstDot + 1).replace(/\./g, "");
                }

                const start = this.selectionStart ?? this.value.length;
                const end = this.selectionEnd ?? this.value.length;

                this.setRangeText(cleaned, start, end, "end");
                this.dispatchEvent(new Event("input", { bubbles: true }));
            });

            checkAbnormalResult();
        });
    </script>
}

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b7a70;
        --teal-deep: #0a5f58;
        --teal-light: #e1f3f0;
        --teal-soft: #f2f8f7;
        --teal-border: #dbe9e7;
        --text: #12302f;
        --muted: #6f8584;
        --page-bg: #eaf1f1;
        --danger: #a32626;
        --danger-soft: #fde8e8;
        --danger-border: #f5c6c6;
        --warning: #8f5a00;
        --warning-soft: #fff3dc;
        --warning-border: #f3d9a0;
        --success: #17814a;
        --success-soft: #e4f6ec;
    }

    .capture-page,
    .capture-page * {
        box-sizing: border-box;
    }

    .capture-page {
        width: 100%;
        min-height: 100vh;
        padding: 28px 32px 48px;
        color: var(--text);
        background: var(--page-bg);
        font-family: "Plus Jakarta Sans", "Segoe UI", sans-serif;
        overflow-x: hidden;
        -webkit-font-smoothing: antialiased;
    }


    /* BANNER */

    .banner {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 24px;
        flex-wrap: wrap;
        padding: 24px 32px;
        margin-bottom: 24px;
        border-radius: 24px;
        color: #fff;
        background: linear-gradient(135deg, #129a8d 0%, #0b7068 100%);
        box-shadow: 0 14px 34px rgba(10, 95, 88, .22);
    }

    .banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        min-width: 0;
    }

    .banner-icon {
        width: 58px;
        height: 58px;
        flex: 0 0 58px;
        border-radius: 17px;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .38);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 24px;
    }

    .banner h1 {
        margin: 0 0 4px;
        font-size: 24px;
        font-weight: 800;
        letter-spacing: -.01em;
        color: #fff;
    }

    .banner p {
        margin: 0;
        font-size: 13.5px;
        font-weight: 500;
        color: rgba(255, 255, 255, .86);
    }

    .banner-stats {
        display: flex;
        align-items: center;
        gap: 30px;
        flex-wrap: wrap;
    }

    .banner-test {
        text-align: right;
    }

        .banner-test span,
        .banner-stat span {
            display: block;
            margin-top: 4px;
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
            color: rgba(255, 255, 255, .78);
        }

        .banner-test span {
            margin: 0 0 4px;
        }

        .banner-test strong {
            display: block;
            font-size: 16px;
            font-weight: 800;
            overflow-wrap: anywhere;
        }

    .banner-stat {
        text-align: center;
    }

        .banner-stat strong {
            display: block;
            font-size: 20px;
            font-weight: 800;
            line-height: 1.15;
        }

    .banner-pill {
        display: inline-flex;
        align-items: center;
        gap: 9px;
        padding: 10px 18px;
        border-radius: 999px;
        background: #fff;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
        white-space: nowrap;
    }


    /* PANELS + CARDS */

    .panel,
    .information-card {
        min-width: 0;
        background: #fff;
        border-radius: 24px;
        box-shadow: 0 10px 30px rgba(8, 70, 66, .07);
        overflow: hidden;
    }

    .panel {
        margin-bottom: 24px;
    }

    .panel-head,
    .card-header {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 16px;
        flex-wrap: wrap;
        padding: 22px 32px;
        border-bottom: 1px solid var(--teal-border);
        background: transparent;
        color: var(--text);
    }

        .panel-title,
        .card-header h2 {
            display: flex;
            align-items: center;
            gap: 14px;
            margin: 0;
            font-size: 17px;
            font-weight: 800;
            color: var(--text);
        }

            .panel-title i,
            .card-header h2 i {
                color: var(--teal);
                font-size: 18px;
            }

    .count-pill {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 6px 14px;
        border-radius: 999px;
        background: var(--teal-light);
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
        white-space: nowrap;
    }

    .card-body {
        padding: 26px 32px 30px;
    }

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 24px;
        margin-bottom: 24px;
    }

        .information-grid > .information-card {
            height: 100%;
        }


    /* SECTION HEADINGS */

    .section-title {
        display: flex;
        align-items: center;
        gap: 10px;
        margin: 28px 0 14px;
        color: var(--teal-deep);
        font-size: 13px;
        font-weight: 800;
        letter-spacing: .02em;
    }

        .section-title i {
            color: var(--teal);
        }

        .section-title.first-title {
            margin-top: 0;
        }


    /* WORKFLOW */

    .workflow-body {
        padding: 28px 32px 30px;
        overflow-x: auto;
    }

    .workflow {
        display: flex;
        align-items: center;
        gap: 10px;
        min-width: 620px;
    }

    .workflow-step {
        display: flex;
        align-items: center;
        gap: 10px;
