@model LabDash.Models.TestResult

@using LabDash.Models

@{
    ViewData["Title"] = "Capture Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;

    var urgency = test?.TestRequest?.Urgency;
    var status = test?.Status;

    var hasDefinedRange = !string.IsNullOrWhiteSpace(Model.ReferenceRange);

    var urgencyClass =
        urgency == "STAT" ? "urgency-stat" :
        urgency == "Urgent" ? "urgency-urgent" :
        "urgency-routine";

    var statusClass =
        status == "Completed" ? "status-completed" :
        status == "In Progress" ? "status-progress" :
        "status-routine";

    var currentStep = status switch
    {
        "Submitted" => 1,
        "Samples Received" => 2,
        "In Progress" => 3,
        "Completed" => 4,
        "Verified" => 5,
        _ => 3
    };

    var testName = test?.TestType?.Name ?? "Laboratory Test";
    var category = test?.TestType?.Category ?? "Not specified";
    var sampleType = test?.TestType?.RequiredSampleType ?? "Not specified";
    var unit = test?.TestType?.UnitOfMeasurement ?? "";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

    /* =========================================================
           COLOUR SYSTEM
           ========================================================= */

    :root {
        --teal: #008f83;
        --teal-dark: #006f67;
        --teal-deep: #005c55;
        --teal-light: #e8f7f5;
        --teal-soft: #f1faf8;
        --teal-border: #ccebe7;
        --teal-bright: #00a99a;
        --text: #173a3a;
        --muted: #718785;
        --border: #dcebea;
        --white: #ffffff;
        --danger: #dc3545;
        --danger-soft: #fff1f2;
        --warning: #c58a00;
        --warning-soft: #fff7df;
        --success: #198754;
        --success-soft: #eaf8f0;
        --info: #2785a8;
        --info-soft: #edf7fb;
        --shadow-sm: 0 5px 18px rgba(0, 111, 103, .07);
        --shadow-md: 0 10px 28px rgba(0, 111, 103, .11);
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #f3faf9;
        color: var(--text);
        font-family: 'Inter', sans-serif;
    }

    /* =========================================================
           MAIN PAGE
           ========================================================= */

    .capture-page {
        width: 100%;
        max-width: 1480px;
        margin: 25px auto 50px;
        padding: 0 22px;
    }

    /* =========================================================
           HEADER
           ========================================================= */

    .capture-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--teal), var(--teal-dark));
        border-radius: 20px;
        padding: 27px 31px;
        color: white;
        box-shadow: var(--shadow-md);
        margin-bottom: 20px;
    }

        .capture-header::after {
            content: "";
            position: absolute;
            width: 230px;
            height: 230px;
            right: -80px;
            top: -110px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 20px;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 15px;
    }

    .header-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.18);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
    }

    .capture-header h1 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 28px;
        font-weight: 800;
    }

    .capture-header p {
        margin: 4px 0 0;
        font-size: 13px;
        opacity: .9;
    }

    .header-test {
        position: relative;
        z-index: 3;
        min-width: 230px;
        padding: 12px 17px;
        border-radius: 13px;
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
    }

        .header-test small {
            display: block;
            font-size: 9px;
            text-transform: uppercase;
            letter-spacing: .08em;
            opacity: .75;
            margin-bottom: 3px;
        }

        .header-test strong {
            font-size: 15px;
        }

    /* =========================================================
           WORKFLOW
           ========================================================= */

    .workflow-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: var(--shadow-sm);
        padding: 20px 24px;
        margin-bottom: 20px;
    }

    .workflow-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--teal-dark);
        font-size: 13px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 18px;
    }

        .workflow-title i {
            color: var(--teal);
        }

    .workflow {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .workflow-step {
        display: flex;
        align-items: center;
        flex: 1;
        position: relative;
    }

        .workflow-step:last-child {
            flex: 0 0 auto;
        }

    .step-circle {
        width: 39px;
        height: 39px;
        min-width: 39px;
        border-radius: 50%;
        background: #edf2f1;
        color: #879795;
        border: 3px solid white;
        box-shadow: 0 0 0 1px #dce6e4;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 12px;
        font-weight: 800;
        z-index: 2;
    }

    .step-label {
        margin-left: 8px;
        font-size: 10px;
        font-weight: 700;
        color: #82908e;
        white-space: nowrap;
    }

    .step-line {
        height: 3px;
        flex: 1;
        margin: 0 9px;
        background: #e3ecea;
        border-radius: 20px;
    }

    .workflow-step.completed .step-circle {
        background: var(--teal);
        color: white;
        box-shadow: 0 0 0 1px var(--teal);
    }

    .workflow-step.completed .step-label {
        color: var(--teal-dark);
    }

    .workflow-step.current .step-circle {
        background: var(--teal-bright);
        color: white;
        box-shadow: 0 0 0 5px rgba(0,143,131,.13);
    }

    .workflow-step.current .step-label {
        color: var(--teal-dark);
        font-weight: 800;
    }

    .workflow-step.completed + .workflow-step .step-line {
        background: var(--teal);
    }

    /* =========================================================
           REVIEW ALERT
           ========================================================= */

    .review-alert {
        background: var(--warning-soft);
        border: 1px solid #efdca2;
        border-left: 5px solid var(--warning);
        border-radius: 13px;
        padding: 16px 18px;
        margin-bottom: 20px;
    }

    .review-alert-header {
        display: flex;
        align-items: center;
        gap: 9px;
        color: #765300;
        font-size: 13px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .review-alert p {
        margin: 0;
        color: #6f5a2d;
        font-size: 13px;
        line-height: 1.5;
    }

    /* =========================================================
           IMPORTANT:
           PATIENT LEFT / TEST RIGHT
           CSS GRID IS USED INSTEAD OF BOOTSTRAP ROW/COLUMNS
           ========================================================= */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        width: 100%;
        margin-bottom: 20px;
    }

    .information-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        min-width: 0;
    }

    /* =========================================================
           CARD HEADERS
           ========================================================= */

    .information-card-header {
        background: var(--teal);
        color: white;
        min-height: 54px;
        padding: 15px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
    }

    .information-card-header-left {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 14px;
        font-weight: 800;
    }

        .information-card-header-left i {
            font-size: 14px;
        }

    .header-request-number {
        font-size: 10px;
        font-weight: 800;
        background: rgba(255,255,255,.15);
        border-radius: 20px;
        padding: 6px 10px;
    }

    .information-card-body {
        padding: 20px;
    }

    /* =========================================================
           PATIENT
           ========================================================= */

    .patient-identity {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 17px;
        border-bottom: 1px solid var(--border);
        margin-bottom: 16px;
    }

    .patient-avatar {
        width: 53px;
        height: 53px;
        min-width: 53px;
        border-radius: 15px;
        background: var(--teal-light);
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .patient-name {
        margin: 0 0 3px;
        font-family: 'Poppins', sans-serif;
        font-size: 18px;
        font-weight: 800;
        color: var(--text);
    }

    .patient-subtitle {
        color: var(--muted);
        font-size: 11px;
    }

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 0 25px;
    }

    .detail-item {
        padding: 11px 0;
        border-bottom: 1px solid #edf3f2;
        min-width: 0;
    }

    .detail-label {
        display: block;
        color: #78908d;
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 4px;
    }

    .detail-value {
        color: var(--text);
        font-size: 12px;
        font-weight: 700;
        word-break: break-word;
    }

    /* =========================================================
           TEST INFORMATION - HIGHLIGHTED
           ========================================================= */

    .test-highlight {
        background: var(--teal-light);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
        padding: 16px;
        margin-bottom: 17px;
    }

    .test-highlight-top {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .test-highlight-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 14px;
        background: white;
        border: 1px solid var(--teal-border);
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .test-highlight-label {
        color: var(--teal-dark);
        font-size: 9px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 3px;
    }

    .test-highlight-name {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        color: var(--teal-dark);
        font-size: 20px;
        font-weight: 800;
    }

    .category-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: white;
        border: 1px solid var(--teal-border);
        color: var(--teal-dark);
        border-radius: 20px;
        padding: 5px 9px;
        margin-top: 8px;
        font-size: 9px;
        font-weight: 800;
    }

    /* =========================================================
           SAMPLE TYPE - STRONGLY HIGHLIGHTED
           ========================================================= */

    .sample-highlight {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 17px;
    }

    .sample-box,
    .unit-box {
        min-height: 82px;
        border-radius: 14px;
        padding: 14px;
        border: 1px solid var(--teal-border);
        background: #eff9f7;
        display: flex;
        align-items: center;
        gap: 11px;
    }

    .sample-box {
        background: linear-gradient(135deg, #e5f7f4, #f4fbfa);
        border: 2px solid #bde4df;
    }

    .sample-box-icon,
    .unit-box-icon {
        width: 40px;
        height: 40px;
        min-width: 40px;
        border-radius: 11px;
        background: white;
        color: var(--teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
    }

    .sample-label,
    .unit-label {
        display: block;
        color: #71908b;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .06em;
        margin-bottom: 3px;
    }

    .sample-value,
    .unit-value {
        display: block;
        color: var(--teal-dark);
        font-size: 13px;
        font-weight: 800;
    }

    /* =========================================================
           TEST DETAILS
           ========================================================= */

    .test-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .test-detail-box {
        background: #f7fbfa;
        border: 1px solid var(--border);
        border-radius: 12px;
        padding: 12px;
    }

    .test-detail-label {
        display: block;
        color: #78908d;
        font-size: 8px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .05em;
        margin-bottom: 5px;
    }

    .test-detail-value {
        color: var(--text);
        font-size: 12px;
        font-weight: 800;
    }

    /* =========================================================
           BADGES
           ========================================================= */

    .urgency-badge,
    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 20px;
        padding: 6px 10px;
        font-size: 9px;
        font-weight: 800;
    }

    .urgency-stat {
        background: var(--danger-soft);
        color: var(--danger);
    }

    .urgency-urgent {
        background: var(--warning-soft);
        color: #9a6c00;
    }

    .urgency-routine {
        background: var(--teal-light);
        color: var(--teal-dark);
    }

    .status-progress {
        background: var(--teal-light);
        color: var(--teal-dark);
    }

    .status-completed {
        background: var(--success-soft);
        color: var(--success);
    }

    .status-routine {
        background: #edf4f3;
        color: #607572;
    }

    /* =========================================================
           DOCTOR CLINICAL NOTES
           ========================================================= */

    .clinical-notes {
        background: #f0faf8;
        border: 1px solid var(--teal-border);
        border-left: 5px solid var(--teal);
        border-radius: 13px;
        padding: 15px 16px;
        margin-top: 5px;
    }

    .clinical-notes-header {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--teal-dark);
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 8px;
    }

        .clinical-notes-header i {
            color: var(--teal);
        }

    .clinical-notes p {
        margin: 0;
        color: var(--text);
        font-size: 12px;
        line-height: 1.6;
    }

    .no-notes {
        color: var(--muted) !important;
        font-style: italic;
    }

    /* =========================================================
           PATIENT CLINICAL ALERTS
           ========================================================= */

    .patient-alerts {
        margin-top: 16px;
    }

    .patient-alert {
        border-radius: 11px;
        padding: 12px 14px;
        margin-top: 10px;
    }

    .patient-alert-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
        margin-bottom: 5px;
    }

    .patient-alert p {
        margin: 0;
        font-size: 12px;
        line-height: 1.5;
    }

    .allergy-alert {
        background: #fff1f2;
        border-left: 4px solid var(--danger);
    }

        .allergy-alert .patient-alert-title {
            color: var(--danger);
        }

    .medical-alert {
        background: #fff8e7;
        border-left: 4px solid var(--warning);
    }

        .medical-alert .patient-alert-title {
            color: #9a6c00;
        }

    .medication-alert {
        background: #eef8fb;
        border-left: 4px solid var(--info);
    }

        .medication-alert .patient-alert-title {
            color: var(--info);
        }

    /* =========================================================
           RESULT CARD
           ========================================================= */

    .result-card {
        background: white;
        border: 1px solid var(--border);
        border-radius: 18px;
        box-shadow: var(--shadow-md);
        overflow: hidden;
    }

    .result-header {
        background: var(--teal);
        color: white;
        padding: 17px 22px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 15px;
    }

    .result-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 15px;
        font-weight: 800;
    }

    .result-status {
        background: rgba(255,255,255,.14);
        border: 1px solid rgba(255,255,255,.2);
        border-radius: 20px;
        padding: 6px 11px;
        font-size: 9px;
        font-weight: 800;
    }

    .result-body {
        padding: 25px;
    }

    /* =========================================================
           FORM
           ========================================================= */

    .form-section-title {
        display: flex;
        align-items: center;
        gap: 8px;
        color: var(--teal-dark);
        font-size: 14px;
        font-weight: 800;
        margin-bottom: 18px;
    }

        .form-section-title i {
            color: var(--teal);
        }

    .form-label-custom {
        display: block;
        color: var(--text);
        font-size: 12px;
        font-weight: 800;
        margin-bottom: 7px;
    }

    .form-control-custom {
        width: 100%;
        min-height: 48px;
        border: 1.5px solid var(--border);
        border-radius: 11px;
        padding: 11px 14px;
        background: white;
        color: var(--text);
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        outline: none;
        transition: .2s;
    }

        .form-control-custom:focus {
            border-color: var(--teal);
            box-shadow: 0 0 0 3px rgba(0,143,131,.10);
        }

        .form-control-custom[readonly] {
            background: #f3f9f8;
            color: #59716e;
        }

    .result-value-input {
        font-size: 17px;
        font-weight: 800;
        color: var(--teal-dark);
    }

    textarea.form-control-custom {
        min-height: 135px;
        resize: vertical;
        line-height: 1.6;
    }

    .input-helper {
        display: block;
        margin-top: 6px;
        color: #78908d;
        font-size: 10.5px;
    }

    /* =========================================================
           ABNORMAL RESULT
           ========================================================= */

    #abnormalAlert {
        display: none;
        background: var(--danger-soft);
        border: 1px solid #f1c7cc;
        border-left: 5px solid var(--danger);
        border-radius: 12px;
        padding: 14px 17px;
        margin-bottom: 20px;
    }

        #abnormalAlert h5 {
            margin: 0 0 4px;
            color: var(--danger);
            font-size: 13px;
            font-weight: 800;
        }

        #abnormalAlert p {
            margin: 0;
            color: #7c343b;
            font-size: 12px;
        }

    .is-valid-custom {
        border: 2px solid var(--success) !important;
        background: #f5fff8 !important;
    }

    .is-invalid-custom {
        border: 2px solid var(--danger) !important;
        background: #fff7f7 !important;
    }

    /* =========================================================
           SUMMARY
           ========================================================= */

    .capture-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 12px;
        margin-top: 22px;
        padding-top: 22px;
        border-top: 1px solid var(--border);
    }

    .summary-tile {
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 13px;
        padding: 15px 10px;
        text-align: center;
    }

        .summary-tile i {
            color: var(--teal);
            font-size: 18px;
            margin-bottom: 7px;
        }

        .summary-tile h6 {
            margin: 0 0 4px;
            color: var(--text);
            font-size: 9px;
            font-weight: 800;
            text-transform: uppercase;
        }

        .summary-tile small {
            color: var(--muted);
            font-size: 10px;
        }

    /* =========================================================
           BUTTONS
           ========================================================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        padding-top: 20px;
        margin-top: 22px;
        border-top: 1px solid var(--border);
    }

    .btn-back-custom {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid #d4e2df;
        background: white;
        color: #58706d;
        border-radius: 10px;
        padding: 11px 18px;
        font-size: 12px;
        font-weight: 700;
        text-decoration: none;
    }

        .btn-back-custom:hover {
            color: var(--teal-dark);
            border-color: var(--teal);
            background: var(--teal-light);
        }

    .btn-save-custom {
        border: 0;
        background: var(--teal);
        color: white;
        border-radius: 10px;
        padding: 11px 21px;
        font-size: 12px;
        font-weight: 800;
        cursor: pointer;
        transition: .2s;
        box-shadow: 0 6px 16px rgba(0,111,103,.18);
    }

        .btn-save-custom:hover {
            background: var(--teal-dark);
            color: white;
            transform: translateY(-1px);
        }

    /* =========================================================
           VALIDATION
           ========================================================= */

    .field-validation-error {
        color: var(--danger);
        font-size: 11px;
        font-weight: 600;
    }

    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 900px) {

        .information-grid {
            grid-template-columns: 1fr;
        }

        .header-content {
            align-items: flex-start;
        }

        .header-test {
            min-width: 190px;
        }
    }

    @@media (max-width: 700px) {

        .capture-page {
            padding: 0 13px;
        }

        .capture-header {
            padding: 22px;
        }

        .header-content {
            flex-direction: column;
            align-items: stretch;
        }

        .header-test {
            width: 100%;
        }

        .workflow {
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .workflow-step {
            min-width: 145px;
        }

        .detail-grid,
        .test-detail-grid,
        .sample-highlight {
            grid-template-columns: 1fr;
        }

        .capture-summary {
            grid-template-columns: 1fr 1fr;
        }

        .result-body {
            padding: 18px;
        }
    }

    @@media (max-width: 450px) {

        .capture-summary {
            grid-template-columns: 1fr;
        }

        .form-actions {
            flex-direction: column;
        }

        .btn-back-custom,
        .btn-save-custom {
            width: 100%;
        }
    }

</style>


<div class="capture-page">

    <!-- =====================================================
         PAGE HEADER
         ====================================================== -->

    <div class="capture-header">

        <div class="header-content">

            <div class="header-title">

                <div class="header-icon">
                    <i class="fa-solid fa-flask-vial"></i>
                </div>

                <div>
                    <h1>Capture Laboratory Result</h1>

                    <p>
                        Enter and submit the laboratory findings for verification.
                    </p>
                </div>

            </div>

            <div class="header-test">

                <small>Current Laboratory Test</small>

                <strong>
                    @testName
                </strong>

            </div>

        </div>

    </div>


    <!-- =====================================================
         WORKFLOW
         ====================================================== -->

    <div class="workflow-card">

        <div class="workflow-title">

            <i class="fa-solid fa-list-check"></i>

            Test Processing Workflow

        </div>

        <div class="workflow">

            <!-- STEP 1 -->

            <div class="workflow-step @(currentStep > 1 ? "completed" : currentStep == 1 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 1)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>1</span>
                    }

                </div>

                <div class="step-label">
                    Submitted
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 2 -->

            <div class="workflow-step @(currentStep > 2 ? "completed" : currentStep == 2 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 2)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>2</span>
                    }

                </div>

                <div class="step-label">
                    Sample Received
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 3 -->

            <div class="workflow-step @(currentStep > 3 ? "completed" : currentStep == 3 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 3)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>3</span>
                    }

                </div>

                <div class="step-label">
                    In Progress
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 4 -->

            <div class="workflow-step @(currentStep > 4 ? "completed" : currentStep == 4 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 4)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>4</span>
                    }

                </div>

                <div class="step-label">
                    Result Captured
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 5 -->

            <div class="workflow-step @(currentStep == 5 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep == 5)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>5</span>
                    }

                </div>

                <div class="step-label">
                    Verified
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RETURNED FOR REVIEW
         ====================================================== -->
    @if (ViewBag.IsResubmission == true)
    {
        <div class="review-alert">

            <div class="review-alert-header">

                <i class="fa-solid fa-rotate-left"></i>

                Returned For Review

            </div>

            <p>

                This result was returned by a verifier and needs to be corrected
                before it can be submitted again.

                @if (!string.IsNullOrWhiteSpace(ViewBag.PreviousVerificationNote as string))
                {
                    <span>
                        <strong>Reviewer's note:</strong>
                        @ViewBag.PreviousVerificationNote
                    </span>
                }

            </p>

        </div>
    }


    <!-- =====================================================
         PATIENT LEFT / TEST RIGHT
         ====================================================== -->

    <div class="information-grid">

        <!-- =================================================
             LEFT: PATIENT INFORMATION
             ================================================== -->

        <div class="information-card">

            <div class="information-card-header">

                <div class="information-card-header-left">

                    <i class="fa-solid fa-user"></i>

                    Patient Information

                </div>

                <span class="header-request-number">
                    TR-@test?.RequestId
                </span>

            </div>


            <div class="information-card-body">

                <div class="patient-identity">

                    <div class="patient-avatar">

                        <i class="fa-solid fa-user"></i>

                    </div>

                    <div>

                        <h3 class="patient-name">

                            @patient?.Name @patient?.Surname

                        </h3>

                        <span class="patient-subtitle">

                            Patient registered on laboratory system

                        </span>

                    </div>

                </div>


                <!-- PATIENT BASIC INFORMATION -->

                <div class="detail-grid">

                    <div class="detail-item">

                        <span class="detail-label">
                            ID Number
                        </span>

                        <span class="detail-value">
                            @(patient?.IDNumber ?? "Not available")
                        </span>

                    </div>


                    <div class="detail-item">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value">
                            @(patient?.Email ?? "Not available")
                        </span>

                    </div>

                </div>


                <!-- PATIENT CLINICAL INFORMATION -->

                <div class="patient-alerts">

                    <div class="patient-alert allergy-alert">

                        <div class="patient-alert-title">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            Allergies

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                        {
                            <p>
                                @patient.Allergies
                            </p>
                        }
                        else
                        {
                            <p class="no-notes">
                                No allergies recorded.
                            </p>
                        }

                    </div>


                    <div class="patient-alert medical-alert">

                        <div class="patient-alert-title">

                            <i class="fa-solid fa-heart-pulse"></i>

                            Medical Conditions

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                        {
                            <p>
                                @patient.MedicalConditions
                            </p>
                        }
                        else
                        {
                            <p class="no-notes">
                                No medical conditions recorded.
                            </p>
                        }

                    </div>


                    <div class="patient-alert medication-alert">

                        <div class="patient-alert-title">

                            <i class="fa-solid fa-pills"></i>

                            Current Medication

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                        {
                            <p>
                                @patient.Medication
                            </p>
                        }
                        else
                        {
                            <p class="no-notes">
                                No current medication recorded.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- =================================================
             RIGHT: TEST INFORMATION
             ================================================== -->

        <div class="information-card">

            <div class="information-card-header">

                <div class="information-card-header-left">

                    <i class="fa-solid fa-flask"></i>

                    Test Information

                </div>

                <span class="header-request-number">
                    Test #@test?.TestRequestItemId
                </span>

            </div>


            <div class="information-card-body">


                <!-- =================================================
                     MAIN TEST HIGHLIGHT
                     ================================================== -->

                <div class="test-highlight">

                    <div class="test-highlight-top">

                        <div class="test-highlight-icon">

                            <i class="fa-solid fa-vial"></i>

                        </div>

                        <div>

                            <div class="test-highlight-label">
                                Laboratory Test
                            </div>

                            <h2 class="test-highlight-name">
                                @testName
                            </h2>

                            <span class="category-badge">

                                <i class="fa-solid fa-layer-group"></i>

                                @category

                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     SAMPLE TYPE + UNIT
                     ================================================== -->

                <div class="sample-highlight">

                    <div class="sample-box">

                        <div class="sample-box-icon">

                            <i class="fa-solid fa-droplet"></i>

                        </div>

                        <div>

                            <span class="sample-label">
                                Sample Type
                            </span>

                            <span class="sample-value">
                                @sampleType
                            </span>

                        </div>

                    </div>


                    <div class="unit-box">

                        <div class="unit-box-icon">

                            <i class="fa-solid fa-ruler"></i>

                        </div>

                        <div>

                            <span class="unit-label">
                                Unit of Measurement
                            </span>

                            <span class="unit-value">
                                @(string.IsNullOrWhiteSpace(unit) ? "Not specified" : unit)
                            </span>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TEST DETAILS
                     ================================================== -->

                <div class="test-detail-grid">

                    <div class="test-detail-box">

                        <span class="test-detail-label">
                            Request Number
                        </span>

                        <span class="test-detail-value">
                            TR-@test?.RequestId
                        </span>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-label">
                            Status
                        </span>

                        <span class="status-badge @statusClass">

                            <i class="fa-solid fa-circle"></i>

                            @status

                        </span>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-label">
                            Urgency
                        </span>

                        <span class="urgency-badge @urgencyClass">

                            @if (urgency == "STAT")
                            {
                                <i class="fa-solid fa-bolt"></i>
                            }
                            else if (urgency == "Urgent")
                            {
                                <i class="fa-solid fa-clock"></i>
                            }
                            else
                            {
                                <i class="fa-solid fa-circle"></i>
                            }

                            @urgency

                        </span>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-label">
                            Date Started
                        </span>

                        <span class="test-detail-value">

                            @(test?.StartDateTime.HasValue == true
                                ? test.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not available")

                        </span>

                    </div>

                </div>


                <!-- =================================================
                     DOCTOR CLINICAL NOTES
                     ================================================== -->

                <div class="clinical-notes">

                    <div class="clinical-notes-header">

                        <i class="fa-solid fa-user-doctor"></i>

                        Doctor Clinical Notes

                    </div>

                    @if (!string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes))
                    {
                        <p>
                            @test.TestRequest.ClinicalNotes
                        </p>
                    }
                    else
                    {
                        <p class="no-notes">
                            No clinical notes were provided by the doctor
                            for this laboratory request.
                        </p>
                    }

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RESULT ENTRY
         ====================================================== -->

    <div class="result-card">

        <div class="result-header">

            <div class="result-title">

                <i class="fa-solid fa-clipboard-check"></i>

                Laboratory Result Entry

            </div>

            <div class="result-status">

                <i class="fa-solid fa-pen-to-square"></i>

                Technician Capture

            </div>

        </div>


        <div class="result-body">

            <form asp-controller="CaptureResults"
                  asp-action="Capture"
                  method="post">

                <input type="hidden"
                       name="TestRequestItemId"
                       value="@Model.TestRequestItemId" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="form-section-title">

                    <i class="fa-solid fa-flask"></i>

                    Enter Laboratory Findings

                </div>


                <!-- =================================================
                     RESULT VALUE + UNIT
                     ================================================== -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="ResultValue"
                               class="form-label-custom">

                            Result Value

                        </label>

                        <input asp-for="ResultValue"
                               id="ResultValue"
                               class="form-control-custom result-value-input"
                               placeholder="Enter numeric result..."
                               autocomplete="off"
                               inputmode="decimal"
                               type="text"
                               maxlength="20" />

                        <span asp-validation-for="ResultValue"
                              class="field-validation-error">
                        </span>

                        <small class="input-helper">

                            <i class="fa-solid fa-calculator"></i>

                            Numbers only. Decimal values are allowed.

                        </small>

                    </div>


                    <div class="col-md-6 mb-4">

                        <label asp-for="Units"
                               class="form-label-custom">

                            Units

                        </label>

                        <input asp-for="Units"
                               class="form-control-custom"
                               value="@unit"
                               readonly />

                        <small class="input-helper">

                            <i class="fa-solid fa-lock"></i>

                            Automatically determined by the selected test.

                        </small>

                    </div>

                </div>


                <!-- =================================================
                     REFERENCE RANGE + CAPTURE DATE
                     ================================================== -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="ReferenceRange"
                               class="form-label-custom">

                            Reference Range

                        </label>

                        <input asp-for="ReferenceRange"
                               id="ReferenceRange"
                               class="form-control-custom"
                               placeholder="Not defined for this test"
                               readonly />

                        @if (hasDefinedRange)
                        {
                            <small class="input-helper">

                                <i class="fa-solid fa-shield-halved"></i>

                                Results outside this range will be flagged.

                            </small>
                        }
                        else
                        {
                            <small class="input-helper">

                                <i class="fa-solid fa-circle-info"></i>

                                No numeric reference range is defined.

                            </small>
                        }

                    </div>


                    <div class="col-md-6 mb-4">

                        <label class="form-label-custom">

                            Capture Date &amp; Time

                        </label>

                        <input class="form-control-custom"
                               readonly
                               value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" />

                        <small class="input-helper">

                            <i class="fa-solid fa-clock"></i>

                            Current system date and time.

                        </small>

                    </div>

                </div>


                <!-- =================================================
                     ABNORMAL RESULT
                     ================================================== -->

                <div id="abnormalAlert">

                    <h5>

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Abnormal Result Detected

                    </h5>

                    <p>

                        The entered result appears to fall outside the
                        supplied reference range. Please verify the value.

                    </p>

                </div>


                <!-- =================================================
                     COMMENTS
                     ================================================== -->

                <div class="mb-4">

                    <label asp-for="Comments"
                           class="form-label-custom">

                        Laboratory Comments / Notes

                    </label>

                    <textarea asp-for="Comments"
                              class="form-control-custom"
                              placeholder="Enter observations, abnormalities, interpretation or additional laboratory notes..."></textarea>

                    <span asp-validation-for="Comments"
                          class="field-validation-error">
                    </span>

                </div>


                <!-- =================================================
                     SUMMARY
                     ================================================== -->

                <div class="capture-summary">

                    <div class="summary-tile">

                        <i class="fa-solid fa-user-doctor"></i>

                        <h6>
                            Captured By
                        </h6>

                        <small>
                            Logged-in Technician
                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-vial-circle-check"></i>

                        <h6>
                            Status
                        </h6>

                        <small>
                            Result Capture
                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-calendar-check"></i>

                        <h6>
                            Capture Date
                        </h6>

                        <small>
                            @DateTime.Now.ToString("dd MMM yyyy")
                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-clock"></i>

                        <h6>
                            Capture Time
                        </h6>

                        <small>
                            @DateTime.Now.ToString("HH:mm")
                        </small>

                    </div>

                </div>


                <!-- =================================================
                     ACTIONS
                     ================================================== -->

                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn-back-custom">

                        <i class="fa-solid fa-arrow-left"></i>

                        Back to Tests

                    </a>


                    <button type="submit"
                            class="btn-save-custom">

                        <i class="fa-solid fa-floppy-disk"></i>

                        Save Laboratory Result

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const resultInput =
                document.getElementById("ResultValue");

            const rangeInput =
                document.getElementById("ReferenceRange");

            const abnormalAlert =
                document.getElementById("abnormalAlert");


            /* =====================================================
               RESULT VALUE - NUMBERS ONLY
               ===================================================== */

            if (resultInput) {

                resultInput.addEventListener("keydown", function(event) {

                    const allowedKeys = [
                        "Backspace",
                        "Delete",
                        "Tab",
                        "Escape",
                        "Enter",
                        "ArrowLeft",
                        "ArrowRight",
                        "ArrowUp",
                        "ArrowDown",
                        "Home",
                        "End"
                    ];

                    if (allowedKeys.includes(event.key)) {
                        return;
                    }


                    /*
                     * Allow numbers 0-9
                     */

                    if (/^[0-9]$/.test(event.key)) {
                        return;
                    }


                    /*
                     * Allow one decimal point.
                     */

                    if (event.key === "." &&
                        !resultInput.value.includes(".")) {

                        return;
                    }


                    /*
                     * Block everything else.
                     */

                    event.preventDefault();

                });


                /*
                 * Prevent letters/symbols being inserted through
                 * paste, drag/drop or other input methods.
                 */

                resultInput.addEventListener("input", function() {

                    let value = this.value;

                    /*
                     * Keep numbers and decimal point only.
                     */

                    value = value.replace(/[^0-9.]/g, "");

                    /*
                     * Only allow one decimal point.
                     */

                    const firstDot = value.indexOf(".");

                    if (firstDot !== -1) {

                        value =
                            value.substring(0, firstDot + 1) +
                            value.substring(firstDot + 1)
                                .replace(/\./g, "");

                    }

                    this.value = value;

                    checkAbnormalResult();

                });


                /*
                 * Prevent invalid paste.
                 */

                resultInput.addEventListener("paste", function(event) {

                    event.preventDefault();

                    const pastedText =
                        (event.clipboardData || window.clipboardData)
                            .getData("text");

                    const cleaned =
                        pastedText
                            .replace(/[^0-9.]/g, "");

                    document.execCommand(
                        "insertText",
                        false,
                        cleaned
                    );

                    checkAbnormalResult();

                });


                resultInput.focus();

            }


            /* =====================================================
               ABNORMAL RESULT CHECK
               ===================================================== */

            function checkAbnormalResult() {

                if (!resultInput || !rangeInput || !abnormalAlert) {
                    return;
                }

                abnormalAlert.style.display = "none";

                resultInput.classList.remove(
                    "is-invalid-custom",
                    "is-valid-custom"
                );


                if (!resultInput.value.trim() ||
                    !rangeInput.value.trim()) {

                    return;
                }


                const result =
                    parseFloat(
                        resultInput.value.replace(",", ".")
                    );


                if (isNaN(result)) {
                    return;
                }


                /*
                 * Supports:
                 *
                 * 145-569
                 * 145 - 569
                 * 145–569
                 * 145 — 569
                 */

                let rangeText =
                    rangeInput.value
                        .replace(/\s/g, "")
                        .replace("–", "-")
                        .replace("—", "-");


                const range =
                    rangeText.split("-");


                if (range.length !== 2) {
                    return;
                }


                const minimum =
                    parseFloat(
                        range[0].replace(",", ".")
                    );

                const maximum =
                    parseFloat(
                        range[1].replace(",", ".")
                    );


                if (isNaN(minimum) ||
                    isNaN(maximum)) {

                    return;
                }


                if (result < minimum ||
                    result > maximum) {

                    abnormalAlert.style.display = "block";

                    resultInput.classList.add(
                        "is-invalid-custom"
                    );

                }
                else {

                    resultInput.classList.add(
                        "is-valid-custom"
                    );

                }

            }


            if (resultInput) {

                resultInput.addEventListener(
                    "change",
                    checkAbnormalResult
                );

            }


            checkAbnormalResult();

        });

    </script>
}