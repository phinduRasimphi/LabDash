@model LabDash.Models.TestResult

@using LabDash.Models

@{
    ViewData["Title"] = "Capture Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;

    var urgency = test?.TestRequest?.Urgency;
    var status = test?.Status;

    var urgencyBadgeClass =
        urgency == "STAT" ? "badge-stat" :
        urgency == "Urgent" ? "badge-urgent" :
        "badge-routine";

    var statusBadgeClass =
        status == "Completed" ? "badge-completed" :
        status == "In Progress" ? "badge-progress" :
        "badge-routine";

    var hasDefinedRange = !string.IsNullOrWhiteSpace(Model.ReferenceRange);

    /*
     * Process Test style:
     * 1 = Submitted
     * 2 = Samples Received
     * 3 = In Progress
     * 4 = Completed
     * 5 = Verified
     */
    var currentStep = status switch
    {
        "Submitted" => 1,
        "Samples Received" => 2,
        "In Progress" => 3,
        "Completed" => 4,
        "Verified" => 5,
        _ => 3
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>

<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Poppins:wght@600;700;800&display=swap"
      rel="stylesheet">

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<style>

    :root {
        --teal-950: #003b35;
        --teal-900: #004d45;
        --teal-800: #005b52;
        --teal-700: #00695c;
        --teal-600: #00796b;
        --teal-500: #009688;
        --teal-400: #26a69a;

        --teal-soft: #eef8f7;
        --teal-soft-2: #e5f4f2;

        --ink: #173a3a;
        --muted: #66807d;

        --line: #dfeceb;
        --white: #ffffff;

        --danger: #dc3545;
        --danger-soft: #fff1f2;

        --warning: #c98700;
        --warning-soft: #fff8e8;

        --info: #0d6efd;
        --info-soft: #edf4ff;

        --success: #198754;
        --success-soft: #edf9f2;

        --shadow-sm: 0 5px 18px rgba(0, 69, 61, .07);
        --shadow-md: 0 12px 30px rgba(0, 69, 61, .10);

        --radius-lg: 20px;
        --radius-md: 14px;
        --radius-sm: 10px;
    }

    * {
        box-sizing: border-box;
    }

    body {
        background: #f4faf9;
        color: var(--ink);
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .capture-page {
        max-width: 1480px;
        margin: 30px auto 50px;
        padding: 0 18px;
    }

    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .capture-header {
        position: relative;
        overflow: hidden;
        background: linear-gradient(135deg, var(--teal-500), var(--teal-950));
        border-radius: var(--radius-lg);
        padding: 30px 34px;
        color: white;
        box-shadow: var(--shadow-md);
        margin-bottom: 22px;
    }

    .capture-header::before {
        content: "";
        position: absolute;
        width: 240px;
        height: 240px;
        right: -80px;
        top: -110px;
        border-radius: 50%;
        background: rgba(255,255,255,.07);
    }

    .capture-header::after {
        content: "";
        position: absolute;
        width: 150px;
        height: 150px;
        right: 120px;
        bottom: -100px;
        border-radius: 50%;
        background: rgba(255,255,255,.04);
    }

    .header-content {
        position: relative;
        z-index: 2;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 25px;
    }

    .header-title {
        display: flex;
        align-items: center;
        gap: 16px;
    }

    .header-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,.14);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 27px;
        border: 1px solid rgba(255,255,255,.12);
    }

    .capture-header h1 {
        margin: 0;
        font-family: 'Poppins', sans-serif;
        font-size: 29px;
        font-weight: 800;
        letter-spacing: -.02em;
    }

    .capture-header p {
        margin: 5px 0 0;
        font-size: 14px;
        opacity: .88;
    }

    .header-test-badge {
        background: rgba(255,255,255,.13);
        border: 1px solid rgba(255,255,255,.18);
        border-radius: 14px;
        padding: 14px 18px;
        min-width: 230px;
        text-align: right;
    }

    .header-test-badge small {
        display: block;
        opacity: .75;
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .08em;
        margin-bottom: 3px;
    }

    .header-test-badge strong {
        font-size: 17px;
    }

    /* =========================================================
       PROCESS STEPPER
       ========================================================= */

    .workflow-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-sm);
        padding: 22px 25px;
        margin-bottom: 22px;
        border: 1px solid var(--line);
    }

    .workflow-title {
        display: flex;
        align-items: center;
        gap: 9px;
        font-size: 14px;
        font-weight: 800;
        color: var(--teal-800);
        margin-bottom: 22px;
        text-transform: uppercase;
        letter-spacing: .04em;
    }

    .workflow-title i {
        color: var(--teal-500);
    }

    .workflow {
        display: flex;
        align-items: center;
        width: 100%;
    }

    .workflow-step {
        display: flex;
        align-items: center;
        flex: 1;
        position: relative;
    }

    .workflow-step:last-child {
        flex: 0 0 auto;
    }

    .step-circle {
        width: 40px;
        height: 40px;
        border-radius: 50%;
        background: #edf2f1;
        color: #81918f;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 800;
        font-size: 13px;
        border: 3px solid white;
        box-shadow: 0 0 0 1px #dbe6e4;
        position: relative;
        z-index: 2;
        flex-shrink: 0;
    }

    .step-label {
        margin-left: 9px;
        font-size: 11px;
        font-weight: 700;
        color: #82908e;
        white-space: nowrap;
    }

    .step-line {
        height: 3px;
        background: #e4eceb;
        flex: 1;
        margin: 0 9px;
        border-radius: 20px;
    }

    .workflow-step.completed .step-circle {
        background: var(--teal-600);
        color: white;
        box-shadow: 0 0 0 1px var(--teal-600);
    }

    .workflow-step.completed .step-label {
        color: var(--teal-700);
    }

    .workflow-step.current .step-circle {
        background: var(--teal-500);
        color: white;
        box-shadow: 0 0 0 5px rgba(0,150,136,.13);
    }

    .workflow-step.current .step-label {
        color: var(--teal-800);
        font-weight: 800;
    }

    .workflow-step.completed + .workflow-step .step-line {
        background: var(--teal-500);
    }

    /* =========================================================
       RETURNED FOR REVIEW
       ========================================================= */

    .review-alert {
        background: var(--warning-soft);
        border: 1px solid #f1d795;
        border-left: 5px solid var(--warning);
        border-radius: var(--radius-md);
        padding: 17px 20px;
        margin-bottom: 22px;
    }

    .review-alert-header {
        display: flex;
        align-items: center;
        gap: 10px;
        color: #765300;
        font-weight: 800;
        margin-bottom: 5px;
    }

    .review-alert p {
        margin: 0;
        color: #6f5a2d;
        font-size: 14px;
        line-height: 1.6;
    }

    /* =========================================================
       MAIN INFORMATION CARDS
       ========================================================= */

    .info-card {
        background: white;
        border-radius: var(--radius-lg);
        overflow: hidden;
        box-shadow: var(--shadow-sm);
        border: 1px solid var(--line);
        height: 100%;
        margin-bottom: 22px;
    }

    .card-header-custom {
        background: linear-gradient(135deg, var(--teal-700), var(--teal-600));
        color: white;
        padding: 15px 21px;
        display: flex;
        align-items: center;
        gap: 10px;
        font-size: 15px;
        font-weight: 800;
    }

    .card-header-custom i {
        font-size: 15px;
    }

    .card-body-custom {
        padding: 22px;
    }

    /* =========================================================
       PATIENT DETAILS
       ========================================================= */

    .patient-identity {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 18px;
        border-bottom: 1px solid var(--line);
        margin-bottom: 18px;
    }

    .patient-avatar {
        width: 52px;
        height: 52px;
        border-radius: 15px;
        background: var(--teal-soft-2);
        color: var(--teal-700);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
        flex-shrink: 0;
    }

    .patient-identity h4 {
        margin: 0 0 3px;
        font-size: 18px;
        font-weight: 800;
        color: var(--ink);
    }

    .patient-identity span {
        font-size: 12px;
        color: var(--muted);
    }

    .detail-row {
        display: flex;
        justify-content: space-between;
        gap: 15px;
        padding: 9px 0;
        border-bottom: 1px solid #f0f4f3;
        font-size: 13.5px;
    }

    .detail-row:last-child {
        border-bottom: none;
    }

    .detail-label {
        color: var(--muted);
        font-weight: 600;
    }

    .detail-value {
        color: var(--ink);
        font-weight: 700;
        text-align: right;
    }

    /* =========================================================
       ALERT INFORMATION
       ========================================================= */

    .clinical-alert {
        border-radius: 12px;
        padding: 14px 16px;
        margin-top: 14px;
    }

    .clinical-alert-title {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 7px;
    }

    .clinical-alert p {
        margin: 0;
        font-size: 13.5px;
        line-height: 1.55;
    }

    .alert-allergy {
        background: var(--danger-soft);
        border-left: 4px solid var(--danger);
    }

    .alert-allergy .clinical-alert-title {
        color: var(--danger);
    }

    .alert-medical {
        background: var(--warning-soft);
        border-left: 4px solid var(--warning);
    }

    .alert-medical .clinical-alert-title {
        color: var(--warning);
    }

    .alert-medication {
        background: var(--info-soft);
        border-left: 4px solid var(--info);
    }

    .alert-medication .clinical-alert-title {
        color: var(--info);
    }

    /* =========================================================
       TEST INFORMATION
       ========================================================= */

    .test-name-box {
        background: var(--teal-soft);
        border: 1px solid #d5ece8;
        border-radius: 13px;
        padding: 16px;
        margin-bottom: 17px;
    }

    .test-name-box small {
        display: block;
        text-transform: uppercase;
        font-size: 10px;
        font-weight: 800;
        letter-spacing: .08em;
        color: var(--muted);
        margin-bottom: 4px;
    }

    .test-name-box strong {
        font-size: 19px;
        color: var(--teal-800);
    }

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        border-radius: 20px;
        padding: 5px 11px;
        font-size: 11.5px;
        font-weight: 800;
    }

    .badge-stat {
        background: var(--danger-soft);
        color: var(--danger);
    }

    .badge-urgent {
        background: var(--warning-soft);
        color: var(--warning);
    }

    .badge-routine {
        background: #eef2f2;
        color: #657472;
    }

    .badge-progress {
        background: var(--info-soft);
        color: var(--info);
    }

    .badge-completed {
        background: var(--success-soft);
        color: var(--success);
    }

    /* =========================================================
       CLINICAL NOTES
       ========================================================= */

    .clinical-notes {
        background: #f8fbfb;
        border: 1px solid var(--line);
        border-radius: 12px;
        padding: 15px;
        margin-top: 18px;
    }

    .clinical-notes-title {
        color: var(--teal-700);
        font-size: 12px;
        font-weight: 800;
        text-transform: uppercase;
        letter-spacing: .04em;
        margin-bottom: 7px;
    }

    .clinical-notes p {
        margin: 0;
        font-size: 13.5px;
        line-height: 1.6;
        color: var(--ink);
    }

    /* =========================================================
       RESULT CARD
       ========================================================= */

    .result-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-md);
        border: 1px solid var(--line);
        overflow: hidden;
        margin-top: 2px;
    }

    .result-header {
        background: linear-gradient(135deg, var(--teal-800), var(--teal-950));
        color: white;
        padding: 19px 24px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 15px;
    }

    .result-header-title {
        display: flex;
        align-items: center;
        gap: 11px;
        font-size: 17px;
        font-weight: 800;
    }

    .result-header-title i {
        color: #8be1d6;
    }

    .result-header-status {
        background: rgba(255,255,255,.12);
        border: 1px solid rgba(255,255,255,.15);
        border-radius: 20px;
        padding: 6px 12px;
        font-size: 11px;
        font-weight: 700;
    }

    .result-body {
        padding: 28px;
    }

    /* =========================================================
       FORM
       ========================================================= */

    .form-section-title {
        display: flex;
        align-items: center;
        gap: 9px;
        color: var(--teal-800);
        font-size: 15px;
        font-weight: 800;
        margin-bottom: 18px;
    }

    .form-section-title i {
        color: var(--teal-500);
    }

    .form-label.fw-bold {
        color: var(--ink);
        font-size: 13px;
        font-weight: 800 !important;
        margin-bottom: 7px;
    }

    .form-control-lg,
    .form-control {
        border: 1.5px solid var(--line);
        border-radius: 11px;
        color: var(--ink);
        font-size: 14px;
    }

    .form-control-lg {
        min-height: 50px;
        padding: 12px 15px;
    }

    .form-control:focus {
        border-color: var(--teal-500);
        box-shadow: 0 0 0 3px rgba(0,150,136,.10);
    }

    .form-control[readonly] {
        background: #f5f9f8;
        color: #58716e;
    }

    textarea.form-control {
        min-height: 145px;
        resize: vertical;
        padding: 14px 15px;
    }

    .input-helper {
        display: block;
        margin-top: 6px;
        color: #78908d;
        font-size: 11.5px;
    }

    /* =========================================================
       ABNORMAL RESULT
       ========================================================= */

    #abnormalAlert {
        display: none;
        background: var(--danger-soft);
        border: 1px solid #f4c5ca;
        border-left: 5px solid var(--danger);
        border-radius: 12px;
        padding: 16px 18px;
        margin-bottom: 22px;
        animation: slideDown .25s ease;
    }

    #abnormalAlert h5 {
        color: var(--danger);
        font-size: 14px;
        font-weight: 800;
        margin-bottom: 5px;
    }

    #abnormalAlert p {
        color: #7c343b;
        font-size: 13px;
    }

    .is-valid {
        border: 2px solid var(--success) !important;
        background: #f5fff8 !important;
    }

    .is-invalid {
        border: 2px solid var(--danger) !important;
        background: #fff7f7 !important;
    }

    /* =========================================================
       RESULT SUMMARY
       ========================================================= */

    .capture-summary {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        gap: 13px;
        margin-top: 25px;
        padding-top: 25px;
        border-top: 1px solid var(--line);
    }

    .summary-tile {
        background: var(--teal-soft);
        border: 1px solid #dcecea;
        border-radius: 13px;
        padding: 17px 12px;
        text-align: center;
    }

    .summary-tile i {
        font-size: 20px;
        margin-bottom: 9px;
    }

    .summary-tile h6 {
        color: var(--ink);
        font-size: 11px;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 800;
        margin: 0 0 5px;
    }

    .summary-tile small {
        color: var(--muted);
        font-size: 11.5px;
    }

    /* =========================================================
       BUTTONS
       ========================================================= */

    .form-actions {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 12px;
        margin-top: 25px;
        padding-top: 22px;
        border-top: 1px solid var(--line);
    }

    .btn-back {
        border: 1px solid #d6e3e1;
        background: white;
        color: #58706d;
        border-radius: 11px;
        font-weight: 700;
        padding: 12px 20px;
    }

    .btn-back:hover {
        color: var(--teal-700);
        border-color: var(--teal-400);
        background: var(--teal-soft);
    }

    .btn-save {
        border: none;
        background: linear-gradient(135deg, var(--teal-500), var(--teal-700));
        color: white;
        border-radius: 11px;
        font-weight: 800;
        padding: 12px 25px;
        box-shadow: 0 7px 18px rgba(0,105,92,.18);
        transition: .2s ease;
    }

    .btn-save:hover {
        color: white;
        transform: translateY(-2px);
        box-shadow: 0 10px 22px rgba(0,105,92,.27);
    }

    /* =========================================================
       ANIMATION
       ========================================================= */

    @@keyframes slideDown {
        from {
            opacity: 0;
            transform: translateY(-8px);
        }

        to {
            opacity: 1;
            transform: translateY(0);
        }
    }

    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media(max-width: 1100px) {

        .header-content {
            align-items: flex-start;
        }

        .header-test-badge {
            min-width: 190px;
        }

        .workflow-step .step-label {
            font-size: 10px;
        }
    }

    @@media(max-width: 768px) {

        .capture-page {
            margin-top: 18px;
        }

        .capture-header {
            padding: 24px;
        }

        .header-content {
            flex-direction: column;
        }

        .header-test-badge {
            width: 100%;
            text-align: left;
        }

        .capture-header h1 {
            font-size: 24px;
        }

        .workflow {
            overflow-x: auto;
            padding-bottom: 8px;
        }

        .workflow-step {
            min-width: 145px;
        }

        .capture-summary {
            grid-template-columns: repeat(2, 1fr);
        }

        .result-body {
            padding: 20px;
        }

        .result-header {
            flex-direction: column;
            align-items: flex-start;
        }

        .form-actions {
            flex-direction: column-reverse;
        }

        .form-actions .btn {
            width: 100%;
        }
    }

    @@media(max-width: 480px) {

        .capture-summary {
            grid-template-columns: 1fr;
        }

        .patient-identity {
            align-items: flex-start;
        }

        .detail-row {
            flex-direction: column;
            gap: 3px;
        }

        .detail-value {
            text-align: left;
        }
    }

</style>


<div class="capture-page">

    <!-- =====================================================
         HEADER
         ====================================================== -->

    <div class="capture-header">

        <div class="header-content">

            <div class="header-title">

                <div class="header-icon">
                    <i class="fa-solid fa-flask-vial"></i>
                </div>

                <div>
                    <h1>Capture Laboratory Result</h1>

                    <p>
                        Enter and submit the laboratory findings for verification.
                    </p>
                </div>

            </div>

            <div class="header-test-badge">

                <small>Current Test</small>

                <strong>
                    @(test?.TestType?.Name ?? "Laboratory Test")
                </strong>

            </div>

        </div>

    </div>


    <!-- =====================================================
         PROCESS TEST STYLE WORKFLOW
         ====================================================== -->

    <div class="workflow-card">

        <div class="workflow-title">
            <i class="fa-solid fa-list-check"></i>
            Test Processing Workflow
        </div>

        <div class="workflow">

            <!-- STEP 1 -->

            <div class="workflow-step @(currentStep >= 1 ? "completed" : "")">

                <div class="step-circle">
                    @if (currentStep > 1)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>1</span>
                    }
                </div>

                <div class="step-label">
                    Submitted
                </div>

                @if (currentStep < 2)
                {
                    <div class="step-line"></div>
                }

            </div>


            <!-- STEP 2 -->

            <div class="workflow-step @(currentStep > 2 ? "completed" : currentStep == 2 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 2)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>2</span>
                    }

                </div>

                <div class="step-label">
                    Sample Received
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 3 -->

            <div class="workflow-step @(currentStep > 3 ? "completed" : currentStep == 3 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 3)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>3</span>
                    }

                </div>

                <div class="step-label">
                    In Progress
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 4 -->

            <div class="workflow-step @(currentStep > 4 ? "completed" : currentStep == 4 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep > 4)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>4</span>
                    }

                </div>

                <div class="step-label">
                    Result Captured
                </div>

                <div class="step-line"></div>

            </div>


            <!-- STEP 5 -->

            <div class="workflow-step @(currentStep == 5 ? "current" : "")">

                <div class="step-circle">

                    @if (currentStep == 5)
                    {
                        <i class="fa-solid fa-check"></i>
                    }
                    else
                    {
                        <span>5</span>
                    }

                </div>

                <div class="step-label">
                    Verified
                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RETURNED FOR REVIEW
         ====================================================== -->

    @if (ViewBag.IsResubmission == true)
    {
        <div class="review-alert">

            <div class="review-alert-header">

                <i class="fa-solid fa-rotate-left"></i>

                Returned For Review

            </div>

            <p>

                This result was returned by a verifier and needs to be corrected
                before it can be submitted again.

                @if (!string.IsNullOrWhiteSpace(ViewBag.PreviousVerificationNote as string))
                {
                    <span>
                        <strong>Reviewer's note:</strong>
                        @ViewBag.PreviousVerificationNote
                    </span>
                }

            </p>

        </div>
    }


    <!-- =====================================================
         PATIENT + TEST INFORMATION
         ====================================================== -->

    <div class="row">

        <!-- ================= PATIENT ================= -->

        <div class="col-lg-6">

            <div class="info-card">

                <div class="card-header-custom">

                    <i class="fa-solid fa-user"></i>

                    Patient Information

                </div>

                <div class="card-body-custom">

                    <div class="patient-identity">

                        <div class="patient-avatar">
                            <i class="fa-solid fa-user"></i>
                        </div>

                        <div>

                            <h4>
                                @patient?.Name @patient?.Surname
                            </h4>

                            <span>
                                Patient registered on laboratory system
                            </span>

                        </div>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            ID Number
                        </span>

                        <span class="detail-value">
                            @(patient?.IDNumber ?? "Not available")
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Email
                        </span>

                        <span class="detail-value">
                            @(patient?.Email ?? "Not available")
                        </span>

                    </div>


                    <!-- ALLERGIES -->

                    <div class="clinical-alert alert-allergy">

                        <div class="clinical-alert-title">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            Allergies

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                        {
                            <p>
                                @patient.Allergies
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No allergies recorded.
                            </p>
                        }

                    </div>


                    <!-- MEDICAL CONDITIONS -->

                    <div class="clinical-alert alert-medical">

                        <div class="clinical-alert-title">

                            <i class="fa-solid fa-heart-pulse"></i>

                            Medical Conditions

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                        {
                            <p>
                                @patient.MedicalConditions
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No medical conditions recorded.
                            </p>
                        }

                    </div>


                    <!-- MEDICATION -->

                    <div class="clinical-alert alert-medication">

                        <div class="clinical-alert-title">

                            <i class="fa-solid fa-pills"></i>

                            Current Medication

                        </div>

                        @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                        {
                            <p>
                                @patient.Medication
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No current medication recorded.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>


        <!-- ================= TEST ================= -->

        <div class="col-lg-6">

            <div class="info-card">

                <div class="card-header-custom">

                    <i class="fa-solid fa-vials"></i>

                    Test Information

                </div>

                <div class="card-body-custom">

                    <div class="test-name-box">

                        <small>
                            Laboratory Test
                        </small>

                        <strong>
                            @(test?.TestType?.Name ?? "Not specified")
                        </strong>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Request Number
                        </span>

                        <span class="detail-value">
                            TR-@test?.RequestId
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Category
                        </span>

                        <span class="detail-value">
                            @(test?.TestType?.Category ?? "Not specified")
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Sample Type
                        </span>

                        <span class="detail-value">
                            @(test?.TestType?.RequiredSampleType ?? "Not specified")
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Urgency
                        </span>

                        <span class="detail-value">

                            <span class="badge-status @urgencyBadgeClass">

                                @if (urgency == "STAT")
                                {
                                    <i class="fa-solid fa-bolt"></i>
                                }
                                else if (urgency == "Urgent")
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-circle"></i>
                                }

                                @urgency

                            </span>

                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Date Started
                        </span>

                        <span class="detail-value">
                            @test?.StartDateTime?.ToString("dd MMM yyyy HH:mm")
                        </span>

                    </div>


                    <div class="detail-row">

                        <span class="detail-label">
                            Status
                        </span>

                        <span class="detail-value">

                            <span class="badge-status @statusBadgeClass">

                                <i class="fa-solid fa-circle"></i>

                                @status

                            </span>

                        </span>

                    </div>


                    <!-- CLINICAL NOTES -->

                    <div class="clinical-notes">

                        <div class="clinical-notes-title">

                            <i class="fa-solid fa-notes-medical"></i>

                            Doctor Clinical Notes

                        </div>

                        @if (!string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes))
                        {
                            <p>
                                @test.TestRequest.ClinicalNotes
                            </p>
                        }
                        else
                        {
                            <p class="text-muted">
                                No clinical notes were provided for this request.
                            </p>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         RESULT ENTRY
         ====================================================== -->

    <div class="result-card">

        <div class="result-header">

            <div class="result-header-title">

                <i class="fa-solid fa-clipboard-check"></i>

                Laboratory Result Entry

            </div>

            <div class="result-header-status">

                <i class="fa-solid fa-pen-to-square"></i>

                Technician Capture

            </div>

        </div>


        <div class="result-body">

            <form asp-controller="CaptureResults"
                  asp-action="Capture"
                  method="post">

                <input type="hidden"
                       name="TestRequestItemId"
                       value="@Model.TestRequestItemId" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <div class="form-section-title">

                    <i class="fa-solid fa-flask"></i>

                    Enter Laboratory Findings

                </div>


                <!-- RESULT + UNITS -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="ResultValue"
                               class="form-label fw-bold">

                            Result Value

                        </label>

                        <input asp-for="ResultValue"
                               id="ResultValue"
                               class="form-control form-control-lg"
                               placeholder="Enter laboratory result..."
                               autocomplete="off" />

                        <span asp-validation-for="ResultValue"
                              class="text-danger">
                        </span>

                        <small class="input-helper">

                            <i class="fa-solid fa-circle-info"></i>

                            Enter the measured laboratory value exactly as obtained.

                        </small>

                    </div>


                    <div class="col-md-6 mb-4">

                        <label asp-for="Units"
                               class="form-label fw-bold">

                            Units

                        </label>

                        <input asp-for="Units"
                               class="form-control form-control-lg"
                               value="@test?.TestType?.UnitOfMeasurement"
                               readonly />

                        <small class="input-helper">

                            <i class="fa-solid fa-lock"></i>

                            Automatically determined by the selected test type.

                        </small>

                        <span asp-validation-for="Units"
                              class="text-danger">
                        </span>

                    </div>

                </div>


                <!-- REFERENCE RANGE + DATE -->

                <div class="row">

                    <div class="col-md-6 mb-4">

                        <label asp-for="ReferenceRange"
                               class="form-label fw-bold">

                            Reference Range

                        </label>

                        <input asp-for="ReferenceRange"
                               id="ReferenceRange"
                               class="form-control form-control-lg"
                               placeholder="Not defined for this test type"
                               readonly="@hasDefinedRange" />

                        <span asp-validation-for="ReferenceRange"
                              class="text-danger">
                        </span>

                        @if (hasDefinedRange)
                        {
                            <small class="input-helper">

                                <i class="fa-solid fa-shield-halved"></i>

                                Reference range is supplied by this test type.
                                Results outside the range will be flagged.

                            </small>
                        }
                        else
                        {
                            <small class="input-helper">

                                <i class="fa-solid fa-circle-info"></i>

                                No numeric reference range is defined for this test.

                            </small>
                        }

                    </div>


                    <div class="col-md-6 mb-4">

                        <label class="form-label fw-bold">

                            Capture Date &amp; Time

                        </label>

                        <input class="form-control form-control-lg"
                               readonly
                               value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" />

                        <small class="input-helper">

                            <i class="fa-solid fa-clock"></i>

                            Recorded using the current system date and time.

                        </small>

                    </div>

                </div>


                <!-- ABNORMAL RESULT -->

                <div id="abnormalAlert">

                    <h5>

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Abnormal Result Detected

                    </h5>

                    <p class="mb-0">

                        The entered result appears to fall outside the supplied
                        reference range. Please verify the value before saving.

                    </p>

                </div>


                <!-- COMMENTS -->

                <div class="mb-4">

                    <label asp-for="Comments"
                           class="form-label fw-bold">

                        Laboratory Comments / Notes

                    </label>

                    <textarea asp-for="Comments"
                              rows="6"
                              class="form-control"
                              placeholder="Enter observations, abnormalities, interpretation or additional laboratory notes..."></textarea>

                    <span asp-validation-for="Comments"
                          class="text-danger">
                    </span>

                </div>


                <!-- SUMMARY -->

                <div class="capture-summary">

                    <div class="summary-tile">

                        <i class="fa-solid fa-user-doctor"
                           style="color:var(--teal-600)">
                        </i>

                        <h6>
                            Captured By
                        </h6>

                        <small>
                            Logged-in Technician
                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-vial-circle-check"
                           style="color:var(--info)">
                        </i>

                        <h6>
                            Status
                        </h6>

                        <small>

                            <span class="badge-status badge-completed">
                                Completed
                            </span>

                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-calendar-check"
                           style="color:var(--warning)">
                        </i>

                        <h6>
                            Capture Date
                        </h6>

                        <small>
                            @DateTime.Now.ToString("dd MMM yyyy")
                        </small>

                    </div>


                    <div class="summary-tile">

                        <i class="fa-solid fa-clock"
                           style="color:var(--teal-500)">
                        </i>

                        <h6>
                            Capture Time
                        </h6>

                        <small>
                            @DateTime.Now.ToString("HH:mm")
                        </small>

                    </div>

                </div>


                <!-- ACTIONS -->

                <div class="form-actions">

                    <a asp-action="Index"
                       class="btn btn-back">

                        <i class="fa-solid fa-arrow-left me-1"></i>

                        Back to Tests

                    </a>


                    <button type="submit"
                            class="btn btn-save">

                        <i class="fa-solid fa-floppy-disk me-1"></i>

                        Save Laboratory Result

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const resultInput = document.getElementById("ResultValue");
            const rangeInput = document.getElementById("ReferenceRange");
            const abnormalAlert = document.getElementById("abnormalAlert");

            if (!resultInput || !rangeInput || !abnormalAlert) {
                return;
            }

            resultInput.focus();


            function checkAbnormalResult() {

                abnormalAlert.style.display = "none";

                resultInput.classList.remove("is-invalid");
                resultInput.classList.remove("is-valid");


                if (!resultInput.value.trim() ||
                    !rangeInput.value.trim()) {

                    return;
                }


                let result = parseFloat(
                    resultInput.value.replace(",", ".")
                );


                if (isNaN(result)) {
                    return;
                }


                /*
                 * Supports ranges such as:
                 *
                 * 10-20
                 * 10 - 20
                 * 10–20
                 * 10 — 20
                 */

                let rangeText = rangeInput.value
                    .replace(/\s/g, "")
                    .replace("–", "-")
                    .replace("—", "-");


                let range = rangeText.split("-");


                if (range.length !== 2) {
                    return;
                }


                let minimum = parseFloat(
                    range[0].replace(",", ".")
                );

                let maximum = parseFloat(
                    range[1].replace(",", ".")
                );


                if (isNaN(minimum) ||
                    isNaN(maximum)) {

                    return;
                }


                if (result < minimum ||
                    result > maximum) {

                    abnormalAlert.style.display = "block";

                    resultInput.classList.add("is-invalid");

                }
                else {

                    resultInput.classList.add("is-valid");

                }

            }


            resultInput.addEventListener(
                "input",
                checkAbnormalResult
            );

            resultInput.addEventListener(
                "change",
                checkAbnormalResult
            );


            /*
             * Run once in case a value already exists.
             */

            checkAbnormalResult();

        });

    </script>
}

