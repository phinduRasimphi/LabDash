@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Capture Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;

    var urgency = test?.TestRequest?.Urgency ?? "Routine";
    var status = test?.Status ?? "In Progress";
    var unit = test?.TestType?.UnitOfMeasurement ?? "";
    var testName = test?.TestType?.Name ?? "Laboratory Test";
    var category = test?.TestType?.Category ?? "Not specified";
    var sampleType = test?.TestType?.RequiredSampleType ?? "Not specified";

    var hasDefinedRange = !string.IsNullOrWhiteSpace(Model.ReferenceRange);

    var urgencyClass = urgency == "STAT"
        ? "urgency-stat"
        : urgency == "Urgent"
            ? "urgency-urgent"
            : "urgency-routine";

    var statusClass = status == "Completed"
        ? "status-completed"
        : status == "In Progress"
            ? "status-progress"
            : "status-routine";

    var currentStep = status switch
    {
        "Submitted" => 1,
        "Samples Received" => 2,
        "In Progress" => 3,
        "Completed" => 4,
        "Verified" => 5,
        _ => 3
    };
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">
<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css">

<div class="capture-page">

    <!-- BANNER -->
    <div class="banner">

        <div class="banner-left">
            <div class="banner-icon">
                <i class="fa-solid fa-flask-vial"></i>
            </div>

            <div>
                <h1>Capture Laboratory Result</h1>
                <p>Review patient information and enter laboratory findings.</p>
            </div>
        </div>

        <div class="banner-stats">

            <div class="banner-test">
                <span>Current laboratory test</span>
                <strong>@testName</strong>
            </div>

            <div class="banner-stat">
                <strong>TR-@(test?.RequestId)</strong>
                <span>Request</span>
            </div>

            <span class="banner-pill">
                <i class="fa-solid @(urgency == "STAT" ? "fa-bolt" : "fa-clock")"></i>
                @urgency
            </span>

        </div>

    </div>


    <!-- PROCESSING WORKFLOW -->
    <section class="panel">

        <div class="panel-head">
            <h2 class="panel-title">
                <i class="fa-solid fa-list-check"></i>
                Test processing workflow
            </h2>

            <span class="count-pill">@status</span>
        </div>

        <div class="workflow-body">

            <div class="workflow">
                @{
                    var workflowSteps = new[]
                    {
                        "Submitted",
                        "Sample Received",
                        "In Progress",
                        "Result Captured",
                        "Verified"
                    };
                }

                @for (var i = 0; i < workflowSteps.Length; i++)
                {
                    var stepNumber = i + 1;
                    var completed = stepNumber < currentStep;
                    var current = stepNumber == currentStep;

                    <div class="workflow-step @(completed ? "completed" : "") @(current ? "current" : "")">
                        <div class="step-circle">
                            @if (completed)
                            {
                                <i class="fa-solid fa-check"></i>
                            }
                            else
                            {
                                @stepNumber
                            }
                        </div>

                        <span class="step-label">@workflowSteps[i]</span>
                    </div>

                    @if (i < workflowSteps.Length - 1)
                    {
                        <div class="step-line @(completed ? "line-completed" : "")"></div>
                    }
                }
            </div>

        </div>

    </section>


    <!-- RETURNED RESULT NOTICE -->
    @if (ViewBag.IsResubmission == true)
    {
        <div class="review-alert" role="alert">

            <div class="alert-heading">
                <i class="fa-solid fa-rotate-left"></i>
                Result returned for review
            </div>

            <p>
                This result was returned by a verifier and must be corrected
                before it can be submitted again.

                @if (!string.IsNullOrWhiteSpace(ViewBag.PreviousVerificationNote as string))
                {
                    <span>
                        <strong>Verifier's note:</strong>
                        @ViewBag.PreviousVerificationNote
                    </span>
                }
            </p>

        </div>
    }


    <!-- PATIENT LEFT / TEST RIGHT -->
    <div class="information-grid">

        <!-- PATIENT INFORMATION -->
        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-user"></i>
                    Patient information
                </h2>
            </div>

            <div class="card-body">

                <div class="patient-profile">

                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <span class="eyebrow">Patient</span>
                        <h3>@patient?.Name @patient?.Surname</h3>
                    </div>

                </div>

                <div class="patient-details">

                    <div class="patient-detail-row">
                        <span>ID number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->
                <div class="section-title">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical conditions
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->
                <div class="section-title">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor clinical notes
                </div>

                <div class="doctor-notes">

                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided for this laboratory request."
                            : test.TestRequest.ClinicalNotes)
                    </p>

                </div>

            </div>

        </section>


        <!-- TEST INFORMATION -->
        <section class="information-card">

            <div class="card-header">
                <h2>
                    <i class="fa-solid fa-vials"></i>
                    Test information
                </h2>
            </div>

            <div class="card-body">

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">Laboratory test</span>
                        <h3>@testName</h3>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @category
                        </span>
                    </div>

                </div>

                <div class="sample-grid">

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-droplet"></i>
                            Sample type
                        </span>
                        <strong>@sampleType</strong>
                    </div>

                    <div class="sample-box">
                        <span class="sample-label">
                            <i class="fa-solid fa-flask"></i>
                            Test category
                        </span>
                        <strong>@category</strong>
                    </div>

                </div>

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span>Request number</span>
                        <strong>TR-@(test?.RequestId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test item</span>
                        <strong>#@(test?.TestRequestItemId)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Unit of measurement</span>
                        <strong>@(string.IsNullOrWhiteSpace(unit) ? "Not specified" : unit)</strong>
                    </div>

                    <div class="test-detail">
                        <span>Reference range</span>
                        <strong>@(hasDefinedRange ? Model.ReferenceRange : "Not specified")</strong>
                    </div>

                    <div class="test-detail">
                        <span>Current status</span>
                        <strong>
                            <span class="status-pill @statusClass">
                                <i class="fa-solid fa-circle"></i>
                                @status
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Urgency</span>
                        <strong>
                            <span class="status-pill @urgencyClass">
                                @if (urgency == "STAT")
                                {
                                    <i class="fa-solid fa-bolt"></i>
                                }
                                else
                                {
                                    <i class="fa-solid fa-clock"></i>
                                }
                                @urgency
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Date started</span>
                        <strong>
                            @(test?.StartDateTime.HasValue == true
                                ? test.StartDateTime.Value.ToString("dd MMM yyyy HH:mm")
                                : "Not available")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Turnaround time</span>
                        <strong>
                            @(test?.TestType?.TurnaroundTimeMinutes != null
                                ? $"{test.TestType.TurnaroundTimeMinutes} minutes"
                                : "Not specified")
                        </strong>
                    </div>

                </div>

                <div class="configured-range">
                    <span>Configured reference range</span>
                    <strong>
                        @(hasDefinedRange ? Model.ReferenceRange : "No range configured")
                        @if (!string.IsNullOrWhiteSpace(unit))
                        {
                            <small>@unit</small>
                        }
                    </strong>
                </div>

            </div>

        </section>

    </div>


    <!-- RESULT ENTRY -->
    <section class="panel result-card">

        <div class="panel-head">

            <h2 class="panel-title">
                <i class="fa-solid fa-clipboard-check"></i>
                Laboratory result entry
            </h2>

            <span class="count-pill">
                <i class="fa-solid fa-pen-to-square"></i>
                Technician capture
            </span>

        </div>

        <div class="result-body">

            <form id="captureForm"
                  asp-controller="CaptureResults"
                  asp-action="Capture"
                  method="post">

                <input type="hidden"
                       name="TestRequestItemId"
                       value="@Model.TestRequestItemId" />

                <!-- Updated by script; the server should still recalculate this. -->
                <input type="hidden" id="IsAbnormal" name="IsAbnormal" value="false" />

                <div asp-validation-summary="ModelOnly"
                     class="validation-summary"></div>

                <div class="section-title first-title">
                    <i class="fa-solid fa-flask"></i>
                    Enter laboratory findings
                </div>

                <div class="result-grid">

                    <div class="form-field">
                        <div class="label-row">
                            <label asp-for="ResultValue">Result value</label>

                            <span id="flagBadge" class="flag-badge" hidden></span>
                        </div>

                        <input asp-for="ResultValue"
                               id="ResultValue"
                               class="form-control result-value-input"
                               placeholder="Enter numeric result"
                               autocomplete="off"
                               inputmode="decimal"
                               type="text"
                               maxlength="20" />

                        <span asp-validation-for="ResultValue"
                              class="field-validation-error"></span>

                        <small class="input-helper">
                            <i class="fa-solid fa-calculator"></i>
                            Numbers and decimal values are allowed.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="Units">Units</label>

                        <input asp-for="Units"
                               class="form-control"
                               value="@unit"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-lock"></i>
                            Determined by the selected test.
                        </small>
                    </div>

                    <div class="form-field">
                        <label asp-for="ReferenceRange">Reference range</label>

                        <input asp-for="ReferenceRange"
                               id="ReferenceRange"
                               class="form-control"
                               readonly />

                        <small class="input-helper">
                            <i class="fa-solid fa-shield-halved"></i>
                            @if (hasDefinedRange)
                            {
                                <text>Results outside this range will be flagged abnormal.</text>
                            }
                            else
                            {
                                <text>No numeric reference range is defined.</text>
                            }
                        </small>
                    </div>

                    <div class="form-field">
                        <label>Capture date &amp; time</label>

                        <input class="form-control"
                               readonly
                               value="@DateTime.Now.ToString("dd MMM yyyy HH:mm")" />

                        <small class="input-helper">
                            <i class="fa-solid fa-clock"></i>
                            Current system date and time.
                        </small>
                    </div>

                    <div class="form-field full-width">
                        <div id="abnormalAlert" role="alert" hidden>
                            <strong>
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                <span id="abnormalTitle">Flagged abnormal</span>
                            </strong>
                            <p id="abnormalText">
                                The entered result falls outside the configured reference range.
                                Please verify the value before saving.
                            </p>
                        </div>
                    </div>

                    <div class="form-field full-width">
                        <label asp-for="Comments">Laboratory comments / notes</label>

                        <textarea asp-for="Comments"
                                  class="form-control result-textarea"
                                  rows="4"
                                  placeholder="Enter observations, abnormalities, interpretation or additional laboratory notes..."></textarea>

                        <span asp-validation-for="Comments"
                              class="field-validation-error"></span>
                    </div>

                </div>

                <!-- CAPTURE SUMMARY -->
                <div class="capture-summary">

                    <div class="summary-tile">
                        <i class="fa-solid fa-user-doctor"></i>
                        <strong>Captured by</strong>
                        <span>Logged-in technician</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-vial-circle-check"></i>
                        <strong>Next step</strong>
                        <span>Verification</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-calendar-check"></i>
                        <strong>Capture date</strong>
                        <span>@DateTime.Now.ToString("dd MMM yyyy")</span>
                    </div>

                    <div class="summary-tile">
                        <i class="fa-solid fa-clock"></i>
                        <strong>Capture time</strong>
                        <span>@DateTime.Now.ToString("HH:mm")</span>
                    </div>

                </div>

                <div class="form-actions">

                    <a asp-action="Index" class="cancel-button">
                        <i class="fa-solid fa-arrow-left"></i>
                        Back to tests
                    </a>

                    <button type="submit" class="submit-button" id="saveButton">
                        <i class="fa-solid fa-floppy-disk"></i>
                        Save laboratory result
                    </button>

                </div>

            </form>

        </div>

    </section>

</div>


<!-- SAVE CONFIRMATION MODAL -->
<div id="confirmOverlay" class="confirm-overlay" hidden>

    <div class="confirm-dialog"
         role="dialog"
         aria-modal="true"
         aria-labelledby="confirmTitle"
         aria-describedby="confirmMessage">

        <div id="confirmIcon" class="confirm-icon">
            <i class="fa-solid fa-circle-question"></i>
        </div>

        <h3 id="confirmTitle">Save laboratory result?</h3>

        <p id="confirmMessage">
            Are you sure you want to save this result? It will be sent for verification.
        </p>

        <div class="confirm-summary">

            <div class="confirm-row">
                <span>Test</span>
                <strong>@testName</strong>
            </div>

            <div class="confirm-row">
                <span>Result</span>
                <strong id="confirmValue">-</strong>
            </div>

            <div class="confirm-row">
                <span>Reference range</span>
                <strong id="confirmRange">-</strong>
            </div>

            <div class="confirm-row">
                <span>Flag</span>
                <strong id="confirmFlag">-</strong>
            </div>

        </div>

        <div class="confirm-actions">
            <button type="button" id="confirmCancel" class="cancel-button">
                <i class="fa-solid fa-xmark"></i>
                No, go back
            </button>

            <button type="button" id="confirmSave" class="submit-button">
                <i class="fa-solid fa-check"></i>
                Yes, save result
            </button>
        </div>

    </div>

</div>


@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        document.addEventListener("DOMContentLoaded", function () {

            var form = document.getElementById("captureForm");
            var resultInput = document.getElementById("ResultValue");
            var rangeInput = document.getElementById("ReferenceRange");
            var unitInput = document.getElementById("Units");
            var isAbnormalInput = document.getElementById("IsAbnormal");

            var flagBadge = document.getElementById("flagBadge");
            var abnormalAlert = document.getElementById("abnormalAlert");
            var abnormalTitle = document.getElementById("abnormalTitle");
            var abnormalText = document.getElementById("abnormalText");

            var overlay = document.getElementById("confirmOverlay");
            var dialog = overlay ? overlay.querySelector(".confirm-dialog") : null;
            var confirmIcon = document.getElementById("confirmIcon");
            var confirmTitle = document.getElementById("confirmTitle");
            var confirmMessage = document.getElementById("confirmMessage");
            var confirmValue = document.getElementById("confirmValue");
            var confirmRange = document.getElementById("confirmRange");
            var confirmFlag = document.getElementById("confirmFlag");
            var confirmCancel = document.getElementById("confirmCancel");
            var confirmSave = document.getElementById("confirmSave");
            var saveButton = document.getElementById("saveButton");

            if (!form || !resultInput || !rangeInput) {
                return;
            }

            var lastFocused = null;

            /* ---------- Helpers ---------- */

            function sanitizeNumber(text) {
                var negative = text.trim().charAt(0) === "-";
                var value = text.replace(/,/g, ".").replace(/[^0-9.]/g, "");
                var firstDot = value.indexOf(".");

                if (firstDot !== -1) {
                    value = value.substring(0, firstDot + 1)
                        + value.substring(firstDot + 1).replace(/\./g, "");
                }

                return (negative ? "-" : "") + value;
            }

            // Supports "10-20", "10 - 20", "10 to 20", "<5", "<=5", ">3", ">=3"
            function parseRange(rangeText) {
                var text = (rangeText || "")
                    .replace(/[\u2013\u2014]/g, "-")
                    .replace(/\u2264/g, "<=")
                    .replace(/\u2265/g, ">=")
                    .replace(/\s/g, "")
                    .toLowerCase()
                    .replace(/,/g, ".");

                var num = "(-?\\d+(?:\\.\\d+)?)";
                var match;

                match = text.match(new RegExp("^" + num + "(?:-|to)" + num + "$"));
                if (match) {
                    return { min: parseFloat(match[1]), max: parseFloat(match[2]) };
                }

                match = text.match(new RegExp("^<(=?)" + num + "$"));
                if (match) {
                    return { min: null, max: parseFloat(match[2]), maxInclusive: match[1] === "=" };
                }

                match = text.match(new RegExp("^>(=?)" + num + "$"));
                if (match) {
                    return { min: parseFloat(match[2]), max: null, minInclusive: match[1] === "=" };
                }

                return null;
            }

            // Returns "normal", "low", "high" or "unknown"
            function evaluate() {
                var resultText = resultInput.value.trim();
                var result = parseFloat(resultText);

                if (!resultText || Number.isNaN(result)) {
                    return "unknown";
                }

                var range = parseRange(rangeInput.value);

                if (!range) {
                    return "unknown";
                }

                if (range.min !== null && range.min !== undefined) {
                    var belowMin = range.minInclusive === false
                        ? result <= range.min
                        : result < range.min;
                    if (belowMin) { return "low"; }
                }

                if (range.max !== null && range.max !== undefined) {
                    var aboveMax = range.maxInclusive === false
                        ? result >= range.max
                        : result > range.max;
                    if (aboveMax) { return "high"; }
                }

                return "normal";
            }

            function describeFlag(state) {
                if (state === "high") { return "Flagged abnormal (High)"; }
                if (state === "low") { return "Flagged abnormal (Low)"; }
                if (state === "normal") { return "Within range"; }
                return "Not evaluated";
            }

            /* ---------- Live flagging ---------- */

            function updateFlag() {
                var state = evaluate();
                var abnormal = state === "high" || state === "low";

                resultInput.classList.remove("is-invalid-custom", "is-valid-custom");
                flagBadge.classList.remove("flag-abnormal", "flag-normal");
                flagBadge.hidden = true;
                abnormalAlert.hidden = true;

                if (isAbnormalInput) {
                    isAbnormalInput.value = abnormal ? "true" : "false";
                }

                if (abnormal) {
                    resultInput.classList.add("is-invalid-custom");

                    flagBadge.hidden = false;
                    flagBadge.classList.add("flag-abnormal");
                    flagBadge.innerHTML =
                        '<i class="fa-solid fa-flag"></i> Flagged abnormal \u00b7 ' +
                        (state === "high" ? "High" : "Low");

                    abnormalAlert.hidden = false;
                    abnormalTitle.textContent =
                        "Flagged abnormal \u2013 result is " +
                        (state === "high" ? "above" : "below") +
                        " the reference range";
                    abnormalText.textContent =
                        "The entered value falls outside the configured reference range (" +
                        rangeInput.value.trim() + "). Please verify the value before saving.";
                } else if (state === "normal") {
                    resultInput.classList.add("is-valid-custom");

                    flagBadge.hidden = false;
                    flagBadge.classList.add("flag-normal");
                    flagBadge.innerHTML = '<i class="fa-solid fa-circle-check"></i> Within range';
                }

                return state;
            }

            resultInput.addEventListener("input", function () {
                var cleaned = sanitizeNumber(this.value);

                if (cleaned !== this.value) {
                    this.value = cleaned;
                }

                updateFlag();
            });

            resultInput.addEventListener("paste", function (event) {
                event.preventDefault();

                var pasted = (event.clipboardData || window.clipboardData).getData("text");
                var cleaned = sanitizeNumber(pasted);

                var start = this.selectionStart != null ? this.selectionStart : this.value.length;
                var end = this.selectionEnd != null ? this.selectionEnd : this.value.length;

                this.setRangeText(cleaned, start, end, "end");
                this.dispatchEvent(new Event("input", { bubbles: true }));
            });

            updateFlag();

            /* ---------- Save confirmation ---------- */

            var confirmed = false;

            function openConfirm() {
                var state = updateFlag();
                var abnormal = state === "high" || state === "low";
                var unitText = unitInput && unitInput.value ? " " + unitInput.value : "";

                confirmValue.textContent = resultInput.value.trim() + unitText;
                confirmRange.textContent = rangeInput.value.trim() || "Not specified";
                confirmFlag.textContent = describeFlag(state);
                confirmFlag.className = abnormal ? "text-danger" : (state === "normal" ? "text-success" : "");

                if (abnormal) {
                    dialog.classList.add("is-abnormal");
                    confirmIcon.innerHTML = '<i class="fa-solid fa-triangle-exclamation"></i>';
                    confirmTitle.textContent = "Save abnormal result?";
                    confirmMessage.textContent =
                        "This result is flagged abnormal because it is outside the reference range. " +
                        "Are you sure you want to save it?";
                } else {
                    dialog.classList.remove("is-abnormal");
                    confirmIcon.innerHTML = '<i class="fa-solid fa-circle-question"></i>';
                    confirmTitle.textContent = "Save laboratory result?";
                    confirmMessage.textContent =
                        "Are you sure you want to save this result? It will be sent for verification.";
                }

                lastFocused = document.activeElement;
                overlay.hidden = false;
                document.body.classList.add("modal-open");
                confirmSave.focus();
            }

            function closeConfirm() {
                overlay.hidden = true;
                document.body.classList.remove("modal-open");

                if (lastFocused && lastFocused.focus) {
                    lastFocused.focus();
                }
            }

            form.addEventListener("submit", function (event) {
                if (confirmed) {
                    return; // user already confirmed, let the post go through
                }

                event.preventDefault();

                // Respect unobtrusive / jQuery validation if present
                if (window.jQuery && window.jQuery.fn && window.jQuery.fn.valid) {
                    if (!window.jQuery(form).valid()) {
                        return;
                    }
                }

                if (!resultInput.value.trim()) {
                    resultInput.focus();
                    return;
                }

                openConfirm();
            });

            confirmCancel.addEventListener("click", closeConfirm);

            confirmSave.addEventListener("click", function () {
                confirmed = true;
                confirmSave.disabled = true;
                confirmCancel.disabled = true;
                confirmSave.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Saving...';
                form.submit();
            });

            overlay.addEventListener("click", function (event) {
                if (event.target === overlay) {
                    closeConfirm();
                }
            });

            document.addEventListener("keydown", function (event) {
                if (overlay.hidden) {
                    return;
                }

                if (event.key === "Escape") {
                    closeConfirm();
                    return;
                }

                // Keep focus inside the dialog
                if (event.key === "Tab") {
                    var focusable = dialog.querySelectorAll("button:not([disabled])");
                    var first = focusable[0];
                    var last = focusable[focusable.length - 1];

                    if (event.shiftKey && document.activeElement === first) {
                        event.preventDefault();
                        last.focus();
                    } else if (!event.shiftKey && document.activeElement === last) {
                        event.preventDefault();
                        first.focus();
                    }
                }
            });
        });
    </script>
}

