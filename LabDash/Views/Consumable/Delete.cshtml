@model LabDash.Models.Consumable

@{
    ViewData["Title"] = "Delete Consumable";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container">

    <div class="mb-4">
        <h2>Delete Consumable</h2>
        <p class="text-muted">
            Confirm that you want to delete this consumable.
        </p>
    </div>

    <div class="card shadow-sm border-danger">

        <div class="card-body">

            <div class="alert alert-danger">
                <i class="fas fa-exclamation-triangle"></i>
                Are you sure you want to delete this consumable?
                This action cannot be undone.
            </div>

            <dl class="row">

                <dt class="col-sm-4">
                    Name
                </dt>

                <dd class="col-sm-8">
                    @Model.Name
                </dd>

                <dt class="col-sm-4">
                    Category
                </dt>

                <dd class="col-sm-8">
                    @(Model.Category ?? "N/A")
                </dd>

                <dt class="col-sm-4">
                    Supplier
                </dt>

                <dd class="col-sm-8">
                    @(Model.SupplierName ?? "N/A")
                </dd>

                <dt class="col-sm-4">
                    Quantity on Hand
                </dt>

                <dd class="col-sm-8">
                    @Model.StockLevel
                </dd>

            </dl>

            <hr />

            <form asp-action="Delete" method="post">

                <input type="hidden"
                       asp-for="ConsumableID" />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>

                    <button type="submit"
                            class="btn btn-danger">
                        <i class="fas fa-trash"></i>
                        Delete Consumable
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>