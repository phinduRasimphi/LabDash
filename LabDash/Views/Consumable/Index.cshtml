@model IEnumerable<LabDash.Models.Consumable>

@{
    ViewData["Title"] = "Manage Consumables";
}

<div class="container-fluid">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h2>Manage Consumables</h2>
            <p class="text-muted">Manage laboratory consumable stock.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Add Consumable
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            <i class="fas fa-check-circle"></i>
            @TempData["Success"]
        </div>
    }

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="table-responsive">

                <table class="table table-hover align-middle">

                    <thead>
                        <tr>
                            <th>Name</th>
                            <th>Category</th>
                            <th>Supplier</th>
                            <th>Stock On Hand</th>
                            <th>Reorder Level</th>
                            <th>Expiry</th>
                            <th>Status</th>
                            <th>Actions</th>
                        </tr>
                    </thead>

                    <tbody>

                        @foreach (var item in Model)
                        {
                            <tr>

                                <td>
                                    <strong>@item.Name</strong>
                                </td>

                                <td>
                                    @(item.Category ?? "N/A")
                                </td>

                                <td>
                                    @(item.SupplierName ?? "N/A")
                                </td>

                                <td>
                                    @item.StockLevel
                                </td>

                                <td>
                                    @item.ReorderLevel
                                </td>

                                <td>
                                    @(item.Expiry?.ToString("dd/MM/yyyy") ?? "N/A")
                                </td>

                                <td>
                                    @if (item.StockLevel <= item.ReorderLevel)
                                    {
                                        <span class="badge bg-danger">
                                            Low Stock
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-success">
                                            In Stock
                                        </span>
                                    }
                                </td>

                                <td>

                                    <div class="btn-group">

                                        <a asp-action="Details"
                                           asp-route-id="@item.ConsumableID"
                                           class="btn btn-sm btn-info">
                                            <i class="fas fa-eye"></i>
                                        </a>

                                        <a asp-action="Edit"
                                           asp-route-id="@item.ConsumableID"
                                           class="btn btn-sm btn-warning">
                                            <i class="fas fa-edit"></i>
                                        </a>

                                        <a asp-action="AdjustStock"
                                           asp-route-id="@item.ConsumableID"
                                           class="btn btn-sm btn-success">
                                            <i class="fas fa-boxes"></i>
                                        </a>

                                        <a asp-action="Delete"
                                           asp-route-id="@item.ConsumableID"
                                           class="btn btn-sm btn-danger">
                                            <i class="fas fa-trash"></i>
                                        </a>

                                    </div>

                                </td>

                            </tr>
                        }

                    </tbody>

                </table>

            </div>

        </div>

    </div>

</div>