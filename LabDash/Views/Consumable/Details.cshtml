@model LabDash.Models.Consumable

@{
    ViewData["Title"] = "Consumable Details";
}

<div class="container">

    <div class="mb-4">
        <h2>Consumable Details</h2>
        <p class="text-muted">
            View information about this consumable.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <div class="row">

                <div class="col-md-6 mb-3">
                    <strong>Consumable Name</strong>
                    <p>@Model.Name</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Category</strong>
                    <p>@(Model.Category ?? "N/A")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Supplier</strong>
                    <p>@(Model.SupplierName ?? "N/A")</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Quantity on Hand</strong>
                    <p>@Model.StockLevel</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Reorder Level</strong>
                    <p>@Model.ReorderLevel</p>
                </div>

                <div class="col-md-6 mb-3">
                    <strong>Expiry Date</strong>
                    <p>
                        @(Model.Expiry?.ToString("dd/MM/yyyy") ?? "N/A")
                    </p>
                </div>

                <div class="col-md-12 mb-3">
                    <strong>Description</strong>
                    <p>@(Model.Description ?? "No description available.")</p>
                </div>

            </div>

            <hr />

            <div class="d-flex gap-2">

                <a asp-action="Edit"
                   asp-route-id="@Model.ConsumableID"
                   class="btn btn-warning">
                    <i class="fas fa-edit"></i>
                    Edit
                </a>

                <a asp-action="AdjustStock"
                   asp-route-id="@Model.ConsumableID"
                   class="btn btn-success">
                    <i class="fas fa-boxes"></i>
                    Adjust Stock
                </a>

                <a asp-action="Index"
                   class="btn btn-secondary">
                    <i class="fas fa-arrow-left"></i>
                    Back
                </a>

            </div>

        </div>

    </div>

</div>
