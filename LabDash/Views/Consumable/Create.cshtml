@model LabDash.Models.Consumable

@{
    ViewData["Title"] = "Add Consumable";
}

<div class="container">

    <div class="mb-4">
        <h2>Add Consumable</h2>
        <p class="text-muted">
            Add a new laboratory consumable.
        </p>
    </div>

    <div class="card shadow-sm">

        <div class="card-body">

            <form asp-action="Create" method="post">

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3">
                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="Name"
                               class="form-label">
                            Consumable Name
                        </label>

                        <input asp-for="Name"
                               class="form-control"
                               placeholder="Enter consumable name" />

                        <span asp-validation-for="Name"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Category"
                               class="form-label">
                            Category
                        </label>

                        <input asp-for="Category"
                               class="form-control"
                               placeholder="e.g. Gloves, Tubes, Reagents" />

                        <span asp-validation-for="Category"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="mb-3">

                    <label asp-for="Description"
                           class="form-label">
                        Description
                    </label>

                    <textarea asp-for="Description"
                              class="form-control"
                              rows="3"
                              placeholder="Enter description"></textarea>

                    <span asp-validation-for="Description"
                          class="text-danger">
                    </span>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="SupplierName"
                               class="form-label">
                            Supplier Name
                        </label>

                        <input asp-for="SupplierName"
                               class="form-control"
                               placeholder="Enter supplier name" />

                        <span asp-validation-for="SupplierName"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="Expiry"
                               class="form-label">
                            Expiry Date
                        </label>

                        <input asp-for="Expiry"
                               type="date"
                               class="form-control" />

                        <span asp-validation-for="Expiry"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <div class="row">

                    <div class="col-md-6 mb-3">

                        <label asp-for="ReorderLevel"
                               class="form-label">
                            Reorder Level
                        </label>

                        <input asp-for="ReorderLevel"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="ReorderLevel"
                              class="text-danger">
                        </span>

                    </div>

                    <div class="col-md-6 mb-3">

                        <label asp-for="StockLevel"
                               class="form-label">
                            Quantity on Hand
                        </label>

                        <input asp-for="StockLevel"
                               type="number"
                               min="0"
                               class="form-control" />

                        <span asp-validation-for="StockLevel"
                              class="text-danger">
                        </span>

                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between">

                    <a asp-action="Index"
                       class="btn btn-secondary">
                        <i class="fas fa-arrow-left"></i>
                        Back
                    </a>

                    <button type="submit"
                            class="btn btn-primary">
                        <i class="fas fa-save"></i>
                        Save Consumable
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}