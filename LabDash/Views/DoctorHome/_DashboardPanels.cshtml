@model LabDash.Models.DoctorDashboardModel
@{
    var stamp = DateTime.Now.ToString("HH:mm:ss");
}

<!-- STAT CARDS -->
<div class="db-section-head">
    <div>
        <h3>Clinical overview</h3>
        <p>Live counts of your patients, requests, and results.</p>
    </div>
</div>

<div class="db-grid db-grid-4">

    <a class="db-stat" asp-controller="Doctor" asp-action="SharedWithMe">
        <div class="db-stat-icon c-teal"><i class="fa-solid fa-user-shield"></i></div>
        <div class="db-stat-body">
            <div class="num" data-counter="@Model.SharedPatientCount">@Model.SharedPatientCount</div>
            <h5>Shared With Me</h5>
            <small>Patients who granted access</small>
        </div>
    </a>

    <a class="db-stat" asp-controller="TestRequest" asp-action="Index">
        <div class="db-stat-icon c-blue"><i class="fa-solid fa-paper-plane"></i></div>
        <div class="db-stat-body">
            <div class="num" data-counter="@Model.PendingRequests">@Model.PendingRequests</div>
            <h5>Pending Requests</h5>
            <small>Submitted, awaiting lab</small>
        </div>
    </a>

    <a class="db-stat" asp-controller="TestResult" asp-action="Index">
        <div class="db-stat-icon c-green"><i class="fa-solid fa-file-medical"></i></div>
        <div class="db-stat-body">
            <div class="num" data-counter="@Model.ReleasedRequests">@Model.ReleasedRequests</div>
            <h5>Released Results</h5>
            <small>Verified &amp; finalised</small>
        </div>
    </a>

    <a class="db-stat" asp-controller="TestResult" asp-action="Alerts"
       style="border-top-color: var(--db-red);">
        <div class="db-stat-icon c-red"><i class="fa-solid fa-triangle-exclamation"></i></div>
        <div class="db-stat-body">
            <div class="num" data-counter="@Model.AbnormalResults" style="color:#B0463F;">@Model.AbnormalResults</div>
            <h5 style="color:#B0463F;">Abnormal Alerts</h5>
            <small>Results needing attention</small>
        </div>
    </a>

</div>

<!-- CHARTS -->
<div class="db-section-head db-mt-lg">
    <div>
        <h3>Trends</h3>
        <p>Activity over the last two weeks and month.</p>
    </div>
</div>

<div class="db-grid db-grid-2">

    <div class="db-chart">
        <div class="db-chart-head">
            <h4><i class="fa-solid fa-chart-line"></i> Results captured</h4>
            <small>Last 14 days</small>
        </div>
        <div class="db-chart-canvas">
            <canvas id="resultsChart"></canvas>
        </div>
    </div>

    <div class="db-chart">
        <div class="db-chart-head">
            <h4><i class="fa-solid fa-user-shield"></i> Consent activity</h4>
            <small>Last 30 days</small>
        </div>
        <div class="db-chart-canvas">
            <canvas id="consentChart"></canvas>
        </div>
    </div>

</div>

<!-- SPLIT -->
<div class="db-section-head db-mt-lg">
    <div>
        <h3>Recent activity</h3>
        <p>Latest patients who shared with you, and your recent notifications.</p>
    </div>
</div>

<div class="db-split">

    <div class="db-panel">
        <div class="db-panel-head">
            <span><i class="fa-solid fa-user-shield"></i> Recently shared with you</span>
            <a class="db-panel-link" asp-controller="Doctor" asp-action="SharedWithMe">
                View all <i class="fa-solid fa-arrow-right"></i>
            </a>
        </div>

        @if (Model.RecentSharedPatients != null && Model.RecentSharedPatients.Any())
        {
            <ul class="db-shared-list">
                @foreach (var p in Model.RecentSharedPatients)
                {
                    <li>
                        <a class="db-shared-item"
                           asp-controller="Doctor"
                           asp-action="PatientSharedResults"
                           asp-route-patientId="@p.PatientID">
                            <div class="db-shared-avatar">@p.Initials</div>
                            <div class="db-shared-body">
                                <div class="db-shared-name">@p.FullName</div>
                                <div class="db-shared-meta">
                                    ID: @p.IDNumber &nbsp;·&nbsp;
                                    @p.LastGrantedDate.ToString("dd MMM yyyy")
                                </div>
                            </div>
                            <span class="db-shared-pill">
                                @p.SharedItemCount item@(p.SharedItemCount == 1 ? "" : "s")
                            </span>
                        </a>
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="db-empty">
                <i class="fa-solid fa-inbox"></i>
                <h5>No shared records yet</h5>
                <p>When a patient grants you consent to view their results, they'll appear here.</p>
            </div>
        }
    </div>

    <div class="db-panel">
        <div class="db-panel-head">
            <span><i class="fa-solid fa-bell"></i> Latest notifications</span>
            <span class="db-panel-tag">
                @if (Model.UnreadNotificationCount > 0)
                {
                    @($"{Model.UnreadNotificationCount} unread")
                }
                else
                {
                    @("All read")
                }
            </span>
        </div>

        @if (Model.RecentNotifications != null && Model.RecentNotifications.Any())
        {
            <ul class="db-notif-list">
                @foreach (var n in Model.RecentNotifications)
                {
                    <li>
                        @if (!string.IsNullOrWhiteSpace(n.LinkUrl))
                        {
                            <a class="db-notif-item" href="@n.LinkUrl">
                                <div class="db-notif-title">@n.Title</div>
                                <div class="db-notif-msg">@n.Message</div>
                                <div class="db-notif-time">@n.TimeAgo</div>
                            </a>
                        }
                        else
                        {
                            <div class="db-notif-item">
                                <div class="db-notif-title">@n.Title</div>
                                <div class="db-notif-msg">@n.Message</div>
                                <div class="db-notif-time">@n.TimeAgo</div>
                            </div>
                        }
                    </li>
                }
            </ul>
        }
        else
        {
            <div class="db-empty">
                <i class="fa-solid fa-bell-slash"></i>
                <h5>No notifications yet</h5>
                <p>You'll see updates here when patients share records with you.</p>
            </div>
        }
    </div>

</div>

<!-- QUICK ACTIONS -->
<div class="db-section-head db-mt-lg">
    <div>
        <h3>Quick actions</h3>
        <p>Access your most frequently used functions.</p>
    </div>
</div>

<div class="db-grid db-grid-4">

    <a asp-controller="Doctor" asp-action="ManagePatients" class="db-action">
        <div class="db-action-icon"><i class="fa-solid fa-users"></i></div>
        <h5>Manage Patients</h5>
        <p>Search, register and manage patient records.</p>
        <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a asp-controller="Doctor" asp-action="SharedWithMe" class="db-action">
        <div class="db-action-icon"><i class="fa-solid fa-user-shield"></i></div>
        <h5>Shared With Me</h5>
        <p>View patients who have granted you access to their results.</p>
        <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a asp-controller="TestRequest" asp-action="Create" class="db-action">
        <div class="db-action-icon"><i class="fa-solid fa-vials"></i></div>
        <h5>New Test Request</h5>
        <p>Create and submit a laboratory test request.</p>
        <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

    <a asp-controller="TestResult" asp-action="Index" class="db-action">
        <div class="db-action-icon"><i class="fa-solid fa-file-medical"></i></div>
        <h5>View Results</h5>
        <p>Review completed test results and abnormal alerts.</p>
        <span class="db-action-go"><i class="fa-solid fa-arrow-right"></i></span>
    </a>

</div>

<!-- FOOTER -->
<div class="db-footer">
    <hr />
    <div class="db-footer-content">
        <i class="fa-solid fa-flask-vial"></i>
        <span>Laboratory Information Management System</span>
        <span class="db-footer-divider">|</span>
        <span>Doctor Dashboard</span>
        <span class="db-footer-divider">|</span>
        <span>@DateTime.Now.Year</span>
    </div>
</div>

<!-- Chart data payload -->
<script id="db-chart-data" type="application/json">
    {
      "resultsLabels": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResultsTrendLabels)),
      "resultsCounts": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ResultsTrendCounts)),
      "consentLabels": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ConsentTrendLabels)),
      "consentCounts": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.ConsentTrendCounts))
    }
</script>

<span id="db-last-updated" data-stamp="@stamp" style="display:none;"></span>