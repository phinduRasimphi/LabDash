@model LabDash.ViewModels.PatientActivationEmailViewModel
@{
    Layout = null;
}
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>Activate your NMB LAB account</title>
</head>
<body style="margin:0;padding:0;background-color:#eef3f2;
    font-family:'Segoe UI',Roboto,Helvetica,Arial,sans-serif;
    color:#243b53;-webkit-font-smoothing:antialiased;">

    <!-- Preheader (hidden preview text) -->
    <div style="display:none;max-height:0;overflow:hidden;opacity:0;">
        Your NMB LAB patient account is ready — activate it and choose your password.
    </div>

    <!-- Outer wrapper -->
    <table role="presentation" cellpadding="0" cellspacing="0" border="0"
           width="100%" style="background-color:#eef3f2;padding:32px 12px;">
        <tr>
            <td align="center">

                <!-- Email container -->
                <table role="presentation" cellpadding="0" cellspacing="0" border="0"
                       width="600" style="max-width:600px;width:100%;
                    background:#ffffff;border-radius:14px;overflow:hidden;
                    box-shadow:0 6px 24px rgba(15,23,42,.06);">

                    <!-- =========================================================
                         HEADER (teal gradient)
                         ========================================================= -->
                    <tr>
                        <td align="center"
                            style="background:linear-gradient(135deg,#0b5f58 0%,#0d6b63 55%,#159d91 100%);
                            background-color:#0d6b63;
                            padding:34px 30px 30px;">

                            <div style="display:inline-block;width:60px;height:60px;
                                border-radius:16px;background:rgba(255,255,255,.16);
                                border:1px solid rgba(255,255,255,.28);
                                text-align:center;line-height:60px;
                                color:#ffffff;font-size:26px;font-weight:700;
                                letter-spacing:.5px;margin-bottom:14px;">
                                &#10010;
                            </div>

                            <h1 style="margin:0;color:#ffffff;font-size:24px;
                                font-weight:700;letter-spacing:-.3px;">
                                NMB Haematology Laboratory
                            </h1>

                            <p style="margin:8px 0 0;color:rgba(255,255,255,.82);
                                font-size:13px;letter-spacing:.4px;
                                text-transform:uppercase;">
                                Patient Portal
                            </p>
                        </td>
                    </tr>

                    <!-- =========================================================
                         BODY
                         ========================================================= -->
                    <tr>
                        <td style="padding:38px 40px 12px;">

                            <h2 style="margin:0 0 10px;color:#172b4d;
                                font-size:21px;font-weight:700;
                                letter-spacing:-.2px;">
                                Welcome, @Model.FirstName
                            </h2>

                            <p style="margin:0 0 18px;font-size:14.5px;
                                line-height:1.65;color:#4a5b70;">
                                Your patient profile has been created by your
                                doctor at <strong style="color:#0d6b63;">NMB LAB</strong>.
                                To finish setting up your account, please
                                choose your own password by clicking the
                                button below.
                            </p>

                            <!-- Call-to-action button -->
                            <table role="presentation" cellpadding="0" cellspacing="0"
                                   border="0" style="margin:26px 0 22px;">
                                <tr>
                                    <td align="center"
                                        style="border-radius:9px;
                                        background:linear-gradient(135deg,#0d6b63,#159d91);
                                        background-color:#0d6b63;
                                        box-shadow:0 6px 16px rgba(13,107,99,.22);">
                                        <a href="@Model.ActivationUrl"
                                           style="display:inline-block;
                                            padding:14px 34px;
                                            color:#ffffff;
                                            font-size:14.5px;
                                            font-weight:650;
                                            letter-spacing:.2px;
                                            text-decoration:none;
                                            border-radius:9px;">
                                            Activate my account &nbsp;&#8594;
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <!-- Info box -->
                            <table role="presentation" cellpadding="0" cellspacing="0"
                                   border="0" width="100%"
                                   style="background:#f1f8f7;border:1px solid #d5e8e5;
                                border-radius:10px;margin:6px 0 22px;">
                                <tr>
                                    <td style="padding:14px 18px;
                                        font-size:13px;
                                        line-height:1.6;
                                        color:#3b5a56;">
                                        <strong style="color:#0d6b63;">
                                            This link is valid for 48 hours
                                        </strong>
                                        and can only be used once. After you set
                                        your password you'll be able to log in
                                        with your email address.
                                    </td>
                                </tr>
                            </table>

                            <!-- Fallback URL -->
                            <p style="margin:0 0 8px;font-size:12.5px;
                                color:#7a8da8;line-height:1.6;">
                                If the button doesn't work, copy and paste this
                                link into your browser:
                            </p>

                            <p style="margin:0 0 26px;font-size:12.5px;
                                word-break:break-all;">
                                <a href="@Model.ActivationUrl"
                                   style="color:#0d6b63;text-decoration:underline;">
                                    @Model.ActivationUrl
                                </a>
                            </p>

                            <p style="margin:0 0 6px;font-size:14px;
                                color:#4a5b70;">
                                Regards,
                            </p>
                            <p style="margin:0 0 26px;font-size:14px;
                                font-weight:650;color:#0d6b63;">
                                NMB Haematology Laboratory
                            </p>

                            <hr style="border:none;border-top:1px solid #edf1f4;
                            margin:0 0 18px;" />

                            <p style="margin:0 0 4px;font-size:12px;
                                color:#8697a9;line-height:1.6;">
                                If you did not expect this email, you can
                                safely ignore it — no action is required.
                            </p>

                        </td>
                    </tr>

                    <!-- =========================================================
                         FOOTER
                         ========================================================= -->
                    <tr>
                        <td style="padding:22px 40px 30px;
                            background:#f7fafb;
                            border-top:1px solid #edf1f4;">

                            <p style="margin:0 0 6px;font-size:11.5px;
                                color:#8697a9;line-height:1.6;">
                                This is an automated message — please do not
                                reply to this email.
                            </p>

                            <p style="margin:0;font-size:11.5px;
                                color:#8697a9;line-height:1.6;">
                                &copy; @DateTime.UtcNow.Year NMB Haematology
                                Laboratory &middot; All rights reserved.
                            </p>

                        </td>
                    </tr>

                </table>
                <!-- /Email container -->

            </td>
        </tr>
    </table>

</body>
</html>