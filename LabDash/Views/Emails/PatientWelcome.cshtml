@model LabDash.ViewModels.PatientWelcomeEmailViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Welcome to LAB DASH</title>
</head>
<body style="margin:0; padding:0; background-color:#eef3f2; font-family: 'Segoe UI', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f2; padding:30px 10px;">
        <tr>
            <td align="center">
                <!-- Main Card -->
                <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background: linear-gradient(135deg, #0b5f58 0%, #0d6b63 55%, #159d91 100%); background-color:#0d6b63; padding:35px 20px;">
                            <h1 style="margin:0; color:#ffffff; font-size:24px; font-weight:700;">Welcome to NMB LAB</h1>
                            <p style="margin:8px 0 0; color:#d1ede8; font-size:14px; letter-spacing:1px;">PATIENT PORTAL</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:40px 30px;">
                            <p style="margin:0 0 15px; font-size:16px; color:#333333;">Hi @Model.FirstName,</p>

                            <p style="margin:0 0 20px; font-size:15px; color:#555555; line-height:1.6;">
                                Your patient account has been created successfully. You can now use the details below to sign in to the patient portal and manage your health records.
                            </p>

                            <!-- Credentials Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fbfa; border:1px solid #e1eeec; border-radius:8px; margin-bottom:25px;">
                                <tr>
                                    <td style="padding:20px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding-bottom:10px; font-size:14px; color:#666666; width:100px;"><strong>Username</strong></td>
                                                <td style="padding-bottom:10px; font-size:14px; color:#0d6b63;"><strong>@Model.Email</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom:10px; font-size:14px; color:#666666;"><strong>Password</strong></td>
                                                <td style="padding-bottom:10px; font-size:14px; color:#0d6b63;"><strong>@Model.Password</strong></td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <!-- Button -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                <tr>
                                    <td align="center">
                                        <a href="@Model.LoginUrl" style="display:inline-block; background-color:#0d6b63; color:#ffffff; text-decoration:none; font-size:15px; font-weight:600; padding:14px 30px; border-radius:8px;">
                                            Sign in to Patient Portal
                                        </a>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:25px 0 0; font-size:13px; color:#888888; text-align:center; line-height:1.5;">
                                For your security, you will be asked to change this password the first time you sign in.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background-color:#f8fbfa; border-top:1px solid #e8edf2; padding:20px;">
                            <p style="margin:0; font-size:12px; color:#888888;">
                                Regards,<br><strong>LABDASH Haematology Laboratory</strong>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>