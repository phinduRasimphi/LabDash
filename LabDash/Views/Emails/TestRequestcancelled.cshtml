@model LabDash.ViewModels.TestRequestCancelledEmailViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Test Request Cancelled</title>
</head>
<body style="margin:0; padding:0; background-color:#eef3f2; font-family: 'Segoe UI', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f2; padding:30px 10px;">
        <tr>
            <td align="center">
                <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">
                    <!-- Header -->
                    <tr>
                        <td align="center" style="background: linear-gradient(135deg, #8f302b 0%, #b3413b 55%, #d16b65 100%); background-color:#b3413b; padding:35px 20px;">
                            <h1 style="margin:0; color:#ffffff; font-size:24px; font-weight:700;">LAB DASH</h1>
                            <p style="margin:8px 0 0; color:#fce8e7; font-size:14px; letter-spacing:1px;">TEST REQUEST CANCELLED</p>
                        </td>
                    </tr>
                    <!-- Body -->
                    <tr>
                        <td style="padding:40px 30px;">
                            <p style="margin:0 0 15px; font-size:16px; color:#333333;">Dear @Model.PatientFirstName,</p>
                            <p style="margin:0 0 20px; font-size:15px; color:#555555; line-height:1.6;">
                                We would like to inform you that Dr. @Model.DoctorName has cancelled your laboratory test request (<strong>TR-@Model.RequestId</strong>).
                            </p>
                            <!-- Reason Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#fdf3f2; border-left:4px solid #b3413b; border-radius:4px; margin-bottom:25px;">
                                <tr>
                                    <td style="padding:16px 20px;">
                                        <p style="margin:0 0 4px; font-size:12px; font-weight:700; color:#8f302b; text-transform:uppercase; letter-spacing:0.5px;">Reason for Cancellation</p>
                                        <p style="margin:0; font-size:14px; color:#333333; line-height:1.5;">@Model.CancellationReason</p>
                                    </td>
                                </tr>
                            </table>
                            <p style="margin:0 0 20px; font-size:15px; color:#555555; line-height:1.6;">
                                You do not need to visit the laboratory for this request. If you have any questions or believe this was cancelled in error, please contact your doctor directly.
                            </p>
                        </td>
                    </tr>
                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background-color:#f8fbfa; border-top:1px solid #e8edf2; padding:20px;">
                            <p style="margin:0; font-size:12px; color:#888888;">
                                Regards,<br><strong>LAB DASH</strong>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>