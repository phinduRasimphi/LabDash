@model LabDash.ViewModels.TestRequestSubmittedEmailViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>New Test Request</title>
</head>
<body style="margin:0; padding:0; background-color:#eef3f2; font-family: 'Segoe UI', Arial, sans-serif;">
    <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#eef3f2; padding:30px 10px;">
        <tr>
            <td align="center">
                <!-- Main Card -->
                <table width="600" cellpadding="0" cellspacing="0" border="0" style="max-width:600px; width:100%; background-color:#ffffff; border-radius:12px; overflow:hidden; box-shadow: 0 4px 15px rgba(0,0,0,0.05);">

                    <!-- Header -->
                    <tr>
                        <td align="center" style="background: linear-gradient(135deg, #0b5f58 0%, #0d6b63 55%, #159d91 100%); background-color:#0d6b63; padding:35px 20px;">
                            <h1 style="margin:0; color:#ffffff; font-size:24px; font-weight:700;">LAB DASH</h1>
                            <p style="margin:8px 0 0; color:#d1ede8; font-size:14px; letter-spacing:1px;">NEW TEST REQUEST</p>
                        </td>
                    </tr>

                    <!-- Body -->
                    <tr>
                        <td style="padding:40px 30px;">
                            <p style="margin:0 0 15px; font-size:16px; color:#333333;">Dear @Model.PatientFirstName,</p>

                            <p style="margin:0 0 20px; font-size:15px; color:#555555; line-height:1.6;">
                                Dr. @Model.DoctorName has submitted a test request for you at LAB DASH.
                            </p>

                            <!-- Info Box -->
                            <table width="100%" cellpadding="0" cellspacing="0" border="0" style="background-color:#f8fbfa; border:1px solid #e1eeec; border-radius:8px; margin-bottom:25px;">
                                <tr>
                                    <td style="padding:20px;">
                                        <table width="100%" cellpadding="0" cellspacing="0" border="0">
                                            <tr>
                                                <td style="padding-bottom:10px; font-size:14px; color:#666666; width:140px;"><strong>Tests Requested</strong></td>
                                                <td style="padding-bottom:10px; font-size:14px; color:#0d6b63;"><strong>@Model.TestList</strong></td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom:10px; font-size:14px; color:#666666;"><strong>Date</strong></td>
                                                <td style="padding-bottom:10px; font-size:14px; color:#333333;">@Model.RequestDate</td>
                                            </tr>
                                            <tr>
                                                <td style="padding-bottom:10px; font-size:14px; color:#666666;"><strong>Request ID</strong></td>
                                                <td style="padding-bottom:10px; font-size:14px; color:#333333;">TR-@Model.RequestId</td>
                                            </tr>
                                        </table>
                                    </td>
                                </tr>
                            </table>

                            <p style="margin:0 0 20px; font-size:15px; color:#555555; line-height:1.6;">
                                Please visit the lab at your earliest convenience to provide the required samples.
                            </p>
                        </td>
                    </tr>

                    <!-- Footer -->
                    <tr>
                        <td align="center" style="background-color:#f8fbfa; border-top:1px solid #e8edf2; padding:20px;">
                            <p style="margin:0; font-size:12px; color:#888888;">
                                Regards,<br><strong>NMB Haematology Laboratory</strong>
                            </p>
                        </td>
                    </tr>
                </table>
            </td>
        </tr>
    </table>
</body>
</html>