        color: var(--ink);
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    button, input, textarea {
        font-family: 'Inter', 'Segoe UI', sans-serif;
    }

    .verify-page {
        max-width: 1500px;
        margin: 30px auto 50px;
        padding: 0 20px;
    }


    /* =========================================================
       PAGE HEADER
       ========================================================= */

    .verify-header {
        position: relative;
        overflow: hidden;
        min-height: 120px;
        padding: 27px 32px;
        border-radius: 24px;
        color: white;
        background: linear-gradient(120deg, #13a094 0%, #0e8579 55%, #0b6a60 100%);
