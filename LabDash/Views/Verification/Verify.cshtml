        font-size: 11.5px;
        font-weight: 800;
        margin-bottom: 5px;
        display: block;
    }


    .verification-textarea {
        width: 100%;
        min-height: 105px;
        padding: 10px 12px;
        border: 1px solid #d9e8e6;
        border-radius: 10px;
        font-family: 'Inter', sans-serif;
        font-size: 11.5px;
        color: var(--ink);
        resize: vertical;
    }


        .verification-textarea:focus {
            outline: none;
            border-color: var(--teal-500);
            box-shadow: 0 0 0 3px rgba(0,150,136,.10);
        }


    /* =========================================================
           RULES
           ========================================================= */

    .rules-box {
        margin-top: 14px;
        background: var(--warning-soft);
        border: 1px solid #f0dfb8;
        border-left: 4px solid var(--warning);
        border-radius: 10px;
        padding: 11px 13px;
    }


        .rules-box h5 {
            margin: 0 0 6px;
            color: #755a21;
            font-size: 11.5px;
            font-weight: 800;
            display: flex;
            align-items: center;
            gap: 6px;
        }


        .rules-box ul {
            margin: 0;
            padding-left: 17px;
            color: #5e593f;
            font-size: 10.5px;
            line-height: 1.45;
        }


        .rules-box li {
            margin-bottom: 3px;
        }


    /* =========================================================
           SUMMARY
           ========================================================= */

    .summary-tile {
        background: #eef8f7;
        border: 1px solid #dcece9;
        border-radius: 10px;
        padding: 11px 8px;
        text-align: center;
        height: 100%;
    }


        .summary-tile i {
            display: block;
            margin-bottom: 5px;
            font-size: 17px;
        }


        .summary-tile h6 {
            margin: 0 0 2px;
            color: #315f65;
            font-size: 8.5px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: .04em;
        }


        .summary-tile small {
            color: #6c8588;
            font-size: 9px;
        }


    /* =========================================================
           BUTTONS
           ========================================================= */

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 9px;
        flex-wrap: wrap;
        margin-top: 15px;
    }


    .btn-back {
        background: white;
        color: #5d7478;
        border: 1px solid #d7e5e3;
        border-radius: 9px;
        padding: 8px 15px;
        font-size: 11px;
        font-weight: 600;
    }


    .btn-return {
        background: #f3a623;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 8px 15px;
        font-size: 11px;
        font-weight: 700;
    }


    .btn-verify {
        background: #008f88;
        color: white;
        border: none;
        border-radius: 9px;
        padding: 8px 15px;
        font-size: 11px;
        font-weight: 700;
    }


    .btn-back:hover {
        background: #f2f9f8;
        color: var(--teal-700);
        border-color: var(--teal-400);
    }


    .btn-return:hover {
        background: #d88b0a;
        color: white;
    }


    .btn-verify:hover {
        background: #006f69;
        color: white;
    }


    .empty-text {
        color: #7b9093;
        font-style: italic;
    }


    /* =========================================================
           RESPONSIVE
           ========================================================= */

    @@media (max-width: 1000px) {

        .main-info-grid {
            grid-template-columns: 1fr;
        }
    }


    @@media (max-width: 700px) {

        .verify-page {
            padding: 0 10px;
            margin-top: 18px;
        }


        .verify-header {
            padding: 22px 18px;
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }


            .verify-header h2 {
                font-size: 22px;
                justify-content: center;
            }


        .sample-highlight {
            grid-template-columns: 1fr;
        }


        .test-detail-grid {
            grid-template-columns: 1fr;
        }


        .result-summary {
            grid-template-columns: 1fr;
        }


        .result-main {
            grid-column: span 1;
        }


        .abnormal-banner {
            align-items: flex-start;
        }


        .abnormal-banner-value {
            display: none;
        }


        .info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }


        .info-value {
            text-align: left;
        }


        .result-table th {
            width: 40%;
        }


        .action-buttons {
            justify-content: stretch;
        }


            .action-buttons .btn {
                flex: 1;
            }
    }

</style>


<div class="verify-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="verify-header">

        <div>

            <h2>

                <i class="fa-solid fa-check-double"></i>

                Verify Laboratory Result

            </h2>

            <p>
                Review the patient's information, clinical notes,
                laboratory test and captured result before verification.
            </p>

        </div>


        <div class="header-icon">

            <i class="fa-solid fa-microscope"></i>

        </div>

    </div>


    <!-- =========================================================
         ABNORMAL RESULT BANNER
         ========================================================= -->
    @if (isAbnormal)
    {
        <div class="abnormal-banner">

            <div class="abnormal-banner-icon">

                <i class="fa-solid fa-triangle-exclamation"></i>

            </div>


            <div class="abnormal-banner-content">

                <strong>
                    Abnormal Result Detected
                </strong>

                <span>
                    The captured value is outside the configured
                    reference range for this laboratory test.
                </span>

            </div>


            <div class="abnormal-banner-value">

                <small>
                    Current Result
                </small>

                <strong>
                    @resultDisplay
                </strong>

            </div>

        </div>
    }
    else if (hasReferenceRange && validNumericResult)
    {
        <div class="normal-banner">

            <div class="normal-banner-icon">

                <i class="fa-solid fa-circle-check"></i>

            </div>

            <div class="normal-banner-content">

                <strong>
                    Result Within Reference Range
                </strong>

                <span>
                    The captured value falls between
                    @referenceLow.ToString("0.##")
                    and
                    @referenceHigh.ToString("0.##")
                    @configuredUnit.
                </span>

            </div>

        </div>
    }


    <!-- =========================================================
         RETURNED FOR REVIEW
         ========================================================= -->
    @if (currentStatus == "To Be Reviewed")
    {
        <div class="review-banner">

            <strong>

                <i class="fa-solid fa-rotate-left"></i>

                Result Returned For Review

            </strong>

            <span>

                This result was previously returned for correction.
                The value displayed below is the latest captured result.

            </span>

        </div>
    }


    <!-- =========================================================
         PATIENT LEFT / TEST RIGHT
         ========================================================= -->

    <div class="main-info-grid">


        <!-- =====================================================
             LEFT: PATIENT INFORMATION
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header-teal">

                <i class="fa-solid fa-user"></i>

                Patient Information

            </div>


            <div class="card-body-custom">


                <!-- PATIENT NAME -->

                <div class="patient-name-highlight">

                    <div class="patient-avatar">

                        <i class="fa-solid fa-user"></i>

                    </div>


                    <div>

                        <div class="patient-name-label">
                            Patient
                        </div>

                        <div class="patient-name">
                            @patientName
                        </div>

                    </div>

                </div>


                <!-- PATIENT DETAILS -->

                <div class="info-row">

                    <span class="info-label">
                        ID Number
                    </span>

                    <span class="info-value">
                        @(patient?.IDNumber ?? "Not available")
                    </span>

                </div>


                <div class="info-row">

                    <span class="info-label">
                        Email
                    </span>

                    <span class="info-value">
                        @(patient?.Email ?? "Not available")
                    </span>

                </div>


                <!-- =================================================
                     CLINICAL INFORMATION
                     ================================================= -->

                <div class="clinical-information">

                    <div class="clinical-title">

                        <i class="fa-solid fa-notes-medical"></i>

                        Clinical Information

                    </div>


                    <!-- ALLERGIES -->

                    <div class="clinical-item clinical-allergies">

                        <div class="clinical-item-title">

                            <i class="fa-solid fa-triangle-exclamation"></i>

                            Allergies

                        </div>

                        <div class="clinical-item-content">

                            @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                            {
                                @patient.Allergies
                            }
                            else
                            {
                                @:None recorded
                            }

                        </div>

                    </div>


                    <!-- MEDICAL CONDITIONS -->

                    <div class="clinical-item clinical-conditions">

                        <div class="clinical-item-title">

                            <i class="fa-solid fa-heart-pulse"></i>

                            Medical Conditions

                        </div>

                        <div class="clinical-item-content">

                            @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                            {
                                @patient.MedicalConditions
                            }
                            else
                            {
                                @:None recorded
                            }

                        </div>

                    </div>


                    <!-- MEDICATION -->

                    <div class="clinical-item clinical-medication">

                        <div class="clinical-item-title">

                            <i class="fa-solid fa-pills"></i>

                            Medication

                        </div>

                        <div class="clinical-item-content">

                            @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                            {
                                @patient.Medication
                            }
                            else
                            {
                                @:None recorded
                            }

                        </div>

                    </div>


                    <!-- =================================================
                         DOCTOR CLINICAL NOTES
                         ================================================= -->

                    <div class="clinical-information">

                        <div class="clinical-title">

                            <i class="fa-solid fa-file-medical"></i>

                            Doctor Clinical Notes

                        </div>


                        <div class="doctor-notes">

                            <div class="doctor-notes-heading">

                                <i class="fa-solid fa-user-doctor"></i>

                                Doctor's Notes

                            </div>


                            @if (!string.IsNullOrWhiteSpace(clinicalNotes))
                            {
                                @clinicalNotes
                            }
                            else
                            {
                                <span class="empty-text">
                                    No clinical notes were provided by the doctor.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             RIGHT: TEST INFORMATION
             ===================================================== -->

        <div class="dashboard-card">

            <div class="card-header-teal">

                <i class="fa-solid fa-vials"></i>

                Test Information

            </div>


            <div class="card-body-custom">


                <!-- =================================================
                     TEST TYPE HIGHLIGHT
                     ================================================= -->

                <div class="test-highlight">

                    <div class="test-highlight-top">

                        <div class="test-highlight-icon">

                            <i class="fa-solid fa-vial"></i>

                        </div>


                        <div>

                            <div class="test-highlight-label">

                                Laboratory Test

                            </div>


                            <div class="test-highlight-name">

                                @testName

                            </div>


                            <span class="test-category">

                                <i class="fa-solid fa-layer-group"></i>

                                @category

                            </span>

                        </div>

                    </div>


                    <!-- SAMPLE TYPE -->

                    <div class="sample-highlight">


                        <div class="sample-box sample-type">

                            <span class="sample-box-label">

                                <i class="fa-solid fa-droplet me-1"></i>

                                Sample Type

                            </span>


                            <div class="sample-box-value">

                                @sampleType

                            </div>

                        </div>


                        <div class="sample-box category-box">

                            <span class="sample-box-label">

                                <i class="fa-solid fa-flask me-1"></i>

                                Test Category

                            </span>


                            <div class="sample-box-value">

                                @category

                            </div>

                        </div>

                    </div>

                </div>


                <!-- =================================================
                     TEST DETAILS
                     ================================================= -->

                <div class="test-detail-grid">


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Request Number
                        </span>

                        <strong>
                            TR-@(test?.RequestId.ToString() ?? "N/A")
                        </strong>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Test Item
                        </span>

                        <strong>
                            #@(test?.TestRequestItemId.ToString() ?? "N/A")
                        </strong>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Unit of Measurement
                        </span>

                        <strong>

                            @(string.IsNullOrWhiteSpace(configuredUnit)
                                ? "Not specified"
                                : configuredUnit)

                        </strong>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Reference Range
                        </span>

                        <strong>
                            @configuredReferenceRange
                        </strong>

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Current Status
                        </span>


                        @if (currentStatus == "Completed")
                        {
                            <span class="status-badge status-completed">

                                <i class="fa-solid fa-circle-check"></i>

                                Completed

                            </span>
                        }
                        else if (currentStatus == "To Be Reviewed")
                        {
                            <span class="status-badge status-review">

                                <i class="fa-solid fa-rotate-left"></i>

                                To Be Reviewed

                            </span>
                        }
                        else if (currentStatus == "Verified")
                        {
                            <span class="status-badge status-verified">

                                <i class="fa-solid fa-shield-halved"></i>

                                Verified

                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-default">

                                <i class="fa-solid fa-circle-info"></i>

                                @currentStatus

                            </span>
                        }

                    </div>


                    <div class="test-detail-box">

                        <span class="test-detail-box-label">
                            Result Classification
                        </span>


                        @if (isAbnormal)
                        {
                            <span class="status-badge"
                                  style="background:#fde5e7;color:#dc3545;">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                                Abnormal

                            </span>
                        }
                        else
                        {
                            <span class="status-badge"
                                  style="background:#eaf7ef;color:#198754;">

                                <i class="fa-solid fa-circle-check"></i>

                                Within Range

                            </span>
                        }

                    </div>

                </div>


                <!-- REFERENCE RANGE -->
                @if (hasReferenceRange)
                {
                    <div class="reference-box">

                        <div class="reference-title">

                            Configured Reference Range

                        </div>


                        <div class="reference-value">

                            @configuredReferenceRange

                            @if (!string.IsNullOrWhiteSpace(configuredUnit))
                            {
                                <span class="reference-unit">

                                    @configuredUnit

                                </span>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CAPTURED LABORATORY RESULT
         ========================================================= -->

    <div class="dashboard-card result-card">

        <div class="card-header-teal">

            <i class="fa-solid fa-flask"></i>

            Captured Laboratory Result

        </div>


        <div class="card-body-custom">


            <!-- RESULT SUMMARY -->

            <div class="result-summary">


                <div class="result-main @(isAbnormal ? "abnormal" : "")">

                    <div class="result-main-label">

                        Captured Result

                    </div>


                    <div class="result-main-value @(isAbnormal ? "abnormal" : "")">

                        @resultDisplay

                        @if (!string.IsNullOrWhiteSpace(configuredUnit))
                        {
                            <span style="font-size:12px;font-weight:700;margin-left:4px;">
                                @configuredUnit
                            </span>
                        }

                    </div>

                </div>


                <div class="result-status @(isAbnormal ? "abnormal" : "")">

                    @if (isAbnormal)
                    {
                        <i class="fa-solid fa-triangle-exclamation"
                           style="color:#dc3545;"></i>

                        <strong style="color:#dc3545;">
                            Abnormal
                        </strong>

                        <small>
                            Outside reference range
                        </small>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-check"
                           style="color:#198754;"></i>

                        <strong style="color:#198754;">
                            Within Range
                        </strong>

                        <small>
                            Within reference range
                        </small>
                    }

                </div>

            </div>


            <!-- RESULT TABLE -->

            <div class="result-table-wrapper">

                <table class="result-table">

                    <tbody>


                        <!-- RESULT VALUE -->

                        <tr>

                            <th>
                                Result Value
                            </th>

                            <td>

                                <span class="result-value @(isAbnormal ? "abnormal" : "")">

                                    @resultDisplay

                                </span>


                                @if (isAbnormal)
                                {
                                    <span class="abnormal-badge">

                                        <i class="fa-solid fa-triangle-exclamation"></i>

                                        Abnormal

                                    </span>
                                }
                                else
                                {
                                    <span class="normal-badge">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Within Range

                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- UNIT -->

                        <tr>

                            <th>
                                Units
                            </th>

                            <td>

                                @(string.IsNullOrWhiteSpace(configuredUnit)
                                    ? "N/A"
                                    : configuredUnit)

                            </td>

                        </tr>


                        <!-- REFERENCE RANGE -->

                        <tr>

                            <th>
                                Reference Range
                            </th>

                            <td>

                                <strong>
                                    @configuredReferenceRange
                                </strong>

                                @if (!string.IsNullOrWhiteSpace(configuredUnit))
                                {
                                    <span>
                                        @configuredUnit
                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- LAB COMMENTS -->

                        <tr>

                            <th>
                                Laboratory Comments
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(result?.Comments))
                                {
                                    @result.Comments
                                }
                                else
                                {
                                    <span class="empty-text">
                                        No laboratory comments captured.
                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- CAPTURED BY -->

                        <tr>

                            <th>
                                Captured By
                            </th>

                            <td>

                                @(result?.CapturedByTechnician?.FullName
                                    ?? "Not available")

                            </td>

                        </tr>


                        <!-- DATE -->

                        <tr>

                            <th>
                                Date Captured
                            </th>

                            <td>

                                @(result != null
                                    ? result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                                    : "N/A")

                            </td>

                        </tr>


                        <!-- STATUS -->

                        <tr>

                            <th>
                                Current Status
                            </th>

                            <td>

                                @if (currentStatus == "Completed")
                                {
                                    <span class="status-badge status-completed">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Completed

                                    </span>
                                }
                                else if (currentStatus == "To Be Reviewed")
                                {
                                    <span class="status-badge status-review">

                                        <i class="fa-solid fa-rotate-left"></i>

                                        To Be Reviewed

                                    </span>
                                }
                                else if (currentStatus == "Verified")
                                {
                                    <span class="status-badge status-verified">

                                        <i class="fa-solid fa-shield-halved"></i>

                                        Verified

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-default">

                                        <i class="fa-solid fa-circle-info"></i>

                                        @currentStatus

                                    </span>
                                }

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- =================================================
                 REMINDER
                 ================================================= -->

            <div class="reminder-box">

                <div class="reminder-title">

                    <i class="fa-solid fa-circle-info"></i>

                    Verification Reminder

                </div>


                Carefully review the laboratory result together with
                the patient's medical conditions, allergies, medication
                and doctor's clinical notes before approving the result.


                @if (isAbnormal)
                {
                    <br />

                    <strong style="color:#c52f3c;">

                        This result is outside the configured reference
                        range and has been detected as abnormal.

                    </strong>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         VERIFICATION DECISION
         ========================================================= -->

    <div class="dashboard-card">

        <div class="card-header-teal">

            <i class="fa-solid fa-shield-halved"></i>

            Verification Decision

        </div>


        <div class="card-body-custom">


            <form asp-action="Verify" method="post">

                <input asp-for="TestRequestItemId"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>


                <!-- VERIFICATION NOTES -->

                <div>

                    <label asp-for="VerificationNotes"
                           class="verification-label">

                        Verification Notes

                    </label>


                    <textarea asp-for="VerificationNotes"
                              class="verification-textarea"
                              placeholder="Provide comments if approving or explain why the result is being returned for review..."></textarea>


                    <span asp-validation-for="VerificationNotes"
                          class="text-danger">
                    </span>

                </div>


                <!-- RULES -->

                <div class="rules-box">

                    <h5>

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Verification Rules

                    </h5>


                    <ul>

                        <li>
                            Review the captured laboratory result carefully
                            before making a decision.
                        </li>

                        <li>
                            Verify the patient's clinical notes support
                            the laboratory findings.
                        </li>

                        <li>
                            Confirm the patient's allergies, medical
                            conditions and medication.
                        </li>

                        <li>
                            If the result is incorrect, return it for review
                            with detailed notes.
                        </li>

                        <li>
                            A laboratory technician may
                            <strong>
                                not verify a result that they personally captured.
                            </strong>
                        </li>


                        @if (isAbnormal)
                        {
                            <li>

                                <strong style="color:#c52f3c;">

                                    This result is abnormal.
                                    Confirm the value against the configured
                                    reference range before verification.

                                </strong>

                            </li>
                        }

                    </ul>

                </div>


                <!-- SUMMARY -->

                <div class="row g-3 mt-3">


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-user-check"
                               style="color:#008f88;">
                            </i>

                            <h6>
                                Verifier
                            </h6>

                            <small>
                                Logged-in Laboratory Technician
                            </small>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-calendar-check"
                               style="color:#0d6efd;">
                            </i>

                            <h6>
                                Date
                            </h6>

                            <small>
                                @DateTime.Now.ToString("dd MMM yyyy")
                            </small>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-clock"
                               style="color:#009688;">
                            </i>

                            <h6>
                                Time
                            </h6>

                            <small>
                                @DateTime.Now.ToString("HH:mm")
                            </small>

                        </div>

                    </div>

                </div>


                <!-- ACTION BUTTONS -->

                <div class="action-buttons">


                    <a asp-action="Index"
                       class="btn btn-back">

                        <i class="fa-solid fa-arrow-left me-1"></i>

                        Back

                    </a>


                    <button type="submit"
                            name="Status"
                            value="To Be Reviewed"
                            class="btn btn-return">

                        <i class="fa-solid fa-rotate-left me-1"></i>

                        Return For Review

                    </button>


                    <button type="submit"
                            name="Status"
                            value="Verified"
                            class="btn btn-verify">

                        <i class="fa-solid fa-check-double me-1"></i>

                        Verify Result

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


