@model LabDash.Models.TestVerification

@using LabDash.Models
@using System.Globalization

@{
    ViewData["Title"] = "Verify Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;

    var testType = test?.TestType;

    // ============================================================
    // RETURN HISTORY
    // Supplied by the controller as ViewBag.ReturnHistory: every earlier
    // TestVerification for this test item that was returned for review.
    // Each one carries a snapshot of the result as it was when returned:
    //   PreviousResultValue, PreviousComments, PreviousIsAbnormal.
    // Optional ViewBag.VerifierNames: Dictionary<string,string> mapping
    // VerifiedByTechnicianId.ToString() -> technician name.
    // ============================================================

    var returnHistory = (ViewBag.ReturnHistory as IEnumerable<TestVerification>
                            ?? Enumerable.Empty<TestVerification>())
                        .OrderByDescending(v => v.VerificationDate)
                        .ToList();

    var verifierNames = ViewBag.VerifierNames as Dictionary<string, string>;

    Func<TestVerification, string> verifierLabel = v =>
    {
        var id = v.VerifiedByTechnicianId?.ToString();
        if (id != null && verifierNames != null && verifierNames.TryGetValue(id, out var name))
        {
            return name;
        }
        return id != null ? $"Technician #{id}" : "Not available";
    };

    var latestReturn = returnHistory.FirstOrDefault();

    // ============================================================
    // REFERENCE RANGE
    // ============================================================

    bool hasReferenceRange =
        testType?.ReferenceRangeLow.HasValue == true &&
        testType?.ReferenceRangeHigh.HasValue == true;

    decimal referenceLow = 0;
    decimal referenceHigh = 0;

    if (hasReferenceRange)
    {
        referenceLow = testType!.ReferenceRangeLow!.Value;
        referenceHigh = testType.ReferenceRangeHigh!.Value;
    }

    string configuredReferenceRange = hasReferenceRange
        ? $"{referenceLow:0.##} - {referenceHigh:0.##}"
        : "Not specified";

    string configuredUnit =
        !string.IsNullOrWhiteSpace(testType?.UnitOfMeasurement)
            ? testType.UnitOfMeasurement
            : result?.Units ?? "";

    // ============================================================
    // RESULT VALUE
    // Parses 5.5 / 5,5 / "5.5 " correctly.
    // ============================================================

    decimal numericResult = 0;
    bool validNumericResult = false;

    if (result != null && !string.IsNullOrWhiteSpace(result.ResultValue))
    {
        string rawResult = result.ResultValue.Trim();

        validNumericResult = decimal.TryParse(
            rawResult,
            NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
            CultureInfo.InvariantCulture,
            out numericResult
        );

        if (!validNumericResult)
        {
            validNumericResult = decimal.TryParse(
                rawResult,
                NumberStyles.Number,
                CultureInfo.CurrentCulture,
                out numericResult
            );
        }

        if (!validNumericResult)
        {
            string normalizedResult = rawResult.Replace(',', '.');

            validNumericResult = decimal.TryParse(
                normalizedResult,
                NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out numericResult
            );
        }
    }

    // ============================================================
    // ABNORMAL RESULT CALCULATION
    // Configured numeric range wins; otherwise use stored flag.
    // ============================================================

    bool isAbnormal = false;

    if (hasReferenceRange && validNumericResult)
    {
        isAbnormal = numericResult < referenceLow || numericResult > referenceHigh;
    }
    else
    {
        isAbnormal = result?.IsAbnormal == true;
    }

    string abnormalClass = isAbnormal ? "abnormal" : "";

    string abnormalDirection = "";
    if (isAbnormal && hasReferenceRange && validNumericResult)
    {
        abnormalDirection = numericResult < referenceLow ? "Below" : "Above";
    }

    // Classifies any stored value against the configured range (null = cannot tell)
    Func<string, bool?> isAbnormalValue = raw =>
    {
        if (!hasReferenceRange || string.IsNullOrWhiteSpace(raw)) return null;

        var cleaned = raw.Trim().Replace(',', '.');

        if (decimal.TryParse(cleaned,
                NumberStyles.AllowDecimalPoint | NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture, out var parsed))
        {
            return parsed < referenceLow || parsed > referenceHigh;
        }

        return null;
    };

    // ============================================================
    // STATUS
    // ============================================================

    string currentStatus = result?.Status ?? "Unknown";

    // A result counts as "previously returned" if there is a recorded return,
    // or it is currently sitting in the To Be Reviewed status.
    bool wasReturned = returnHistory.Any() || currentStatus == "To Be Reviewed";
    bool awaitingCorrection = currentStatus == "To Be Reviewed";

    // ============================================================
    // DISPLAY VALUES
    // ============================================================

    string patientName =
        $"{patient?.Name ?? ""} {patient?.Surname ?? ""}".Trim();

    if (string.IsNullOrWhiteSpace(patientName))
    {
        patientName = "Patient not available";
    }

    string testName =
        !string.IsNullOrWhiteSpace(testType?.Name)
            ? testType.Name
            : "Laboratory Test";

    string sampleType =
        !string.IsNullOrWhiteSpace(testType?.RequiredSampleType)
            ? testType.RequiredSampleType
            : "Not specified";

    string category =
        !string.IsNullOrWhiteSpace(testType?.Category)
            ? testType.Category
            : "Not specified";

    string resultDisplay =
        !string.IsNullOrWhiteSpace(result?.ResultValue)
            ? result.ResultValue
            : "No result";

    string clinicalNotes =
        test?.TestRequest?.ClinicalNotes ?? "";
}


<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />

<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
