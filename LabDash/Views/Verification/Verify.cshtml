@model LabDash.Models.TestVerification

@using LabDash.Models
@using System.Globalization

@{
    ViewData["Title"] = "Verify Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;

    var testType = test?.TestType;

    // ============================================================
    // REFERENCE RANGE
    // ============================================================

    bool hasReferenceRange =
        testType?.ReferenceRangeLow.HasValue == true &&
        testType?.ReferenceRangeHigh.HasValue == true;

    decimal referenceLow = 0;
    decimal referenceHigh = 0;

    if (hasReferenceRange)
    {
        referenceLow = testType!.ReferenceRangeLow!.Value;
        referenceHigh = testType.ReferenceRangeHigh!.Value;
    }

    string configuredReferenceRange = hasReferenceRange
        ? $"{referenceLow:0.##} - {referenceHigh:0.##}"
        : "Not specified";

    string configuredUnit =
        !string.IsNullOrWhiteSpace(testType?.UnitOfMeasurement)
            ? testType.UnitOfMeasurement
            : result?.Units ?? "";

    // ============================================================
    // RESULT VALUE
    //
    // Parse using multiple formats so values such as:
    // 5.5
    // 5,5
    // "5.5 "
    // can all be correctly evaluated.
    // ============================================================

    decimal numericResult = 0;
    bool validNumericResult = false;

    if (result != null && !string.IsNullOrWhiteSpace(result.ResultValue))
    {
        string rawResult = result.ResultValue.Trim();

        // First try normal invariant decimal format
        validNumericResult = decimal.TryParse(
            rawResult,
            NumberStyles.AllowDecimalPoint |
            NumberStyles.AllowLeadingSign,
            CultureInfo.InvariantCulture,
            out numericResult
        );

        // Try current culture
        if (!validNumericResult)
        {
            validNumericResult = decimal.TryParse(
                rawResult,
                NumberStyles.Number,
                CultureInfo.CurrentCulture,
                out numericResult
            );
        }

        // Try South African/common comma decimal format
        if (!validNumericResult)
        {
            string normalizedResult = rawResult.Replace(',', '.');

            validNumericResult = decimal.TryParse(
                normalizedResult,
                NumberStyles.AllowDecimalPoint |
                NumberStyles.AllowLeadingSign,
                CultureInfo.InvariantCulture,
                out numericResult
            );
        }
    }

    // ============================================================
    // ABNORMAL RESULT CALCULATION
    //
    // If the test has a configured numeric reference range,
    // calculate the result ourselves.
    //
    // Otherwise use the stored IsAbnormal value.
    // ============================================================

    bool isAbnormal = false;

    if (hasReferenceRange && validNumericResult)
    {
        isAbnormal =
            numericResult < referenceLow ||
            numericResult > referenceHigh;
    }
    else
    {
        isAbnormal = result?.IsAbnormal == true;
    }

    // ============================================================
    // STATUS
    // ============================================================

    string currentStatus = result?.Status ?? "Unknown";

    // ============================================================
    // DISPLAY VALUES
    // ============================================================

    string patientName =
        $"{patient?.Name ?? ""} {patient?.Surname ?? ""}".Trim();

    if (string.IsNullOrWhiteSpace(patientName))
    {
        patientName = "Patient not available";
    }

    string testName =
        !string.IsNullOrWhiteSpace(testType?.Name)
            ? testType.Name
            : "Laboratory Test";

    string sampleType =
        !string.IsNullOrWhiteSpace(testType?.RequiredSampleType)
            ? testType.RequiredSampleType
            : "Not specified";

    string category =
        !string.IsNullOrWhiteSpace(testType?.Category)
            ? testType.Category
            : "Not specified";

    string resultDisplay =
        !string.IsNullOrWhiteSpace(result?.ResultValue)
            ? result.ResultValue
            : "No result";

    string clinicalNotes =
        test?.TestRequest?.ClinicalNotes ?? "";
}


