    /* =========================================================
       LAYOUT + CARDS
       ========================================================= */

    .main-info-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        gap: 20px;
        align-items: stretch;
        margin-bottom: 20px;
    }

    .dashboard-card {
        background: #fff;
