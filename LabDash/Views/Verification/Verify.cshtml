<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b5f56;
        --teal-deep: #084d46;
        --ink: #0f2f2c;
        --ink-soft: #315f65;
        --muted: #6a8387;
        --line: #e7efee;
        --field: #f0f6f5;
        --field-line: #cfe3e0;
