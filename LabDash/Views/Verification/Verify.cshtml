        font-size: 11.5px;
    }

    .compare-arrow {
        display: flex;
        align-items: center;
        color: var(--warning);
        font-size: 18px;
    }

    @@media (max-width: 700px) {
        .compare-grid {
            grid-template-columns: minmax(0, 1fr);
        }

        .compare-arrow {
            justify-content: center;
            transform: rotate(90deg);
        }
