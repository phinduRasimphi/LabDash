@model LabDash.Models.TestVerification

@using LabDash.Models

@{
    ViewData["Title"] = "Verify Laboratory Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;

    var testType = test?.TestType;

    // =========================================================
    // CONFIGURED REFERENCE RANGE
    // Always use the TestType configuration as the source
    // of the laboratory reference range.
    // =========================================================

    bool hasReferenceRange =
        testType?.ReferenceRangeLow.HasValue == true &&
        testType?.ReferenceRangeHigh.HasValue == true;

    string configuredReferenceRange = hasReferenceRange
        ? $"{testType!.ReferenceRangeLow!.Value:0.##} - {testType.ReferenceRangeHigh!.Value:0.##}"
        : "Not specified";

    string configuredUnit =
        !string.IsNullOrWhiteSpace(testType?.UnitOfMeasurement)
            ? testType.UnitOfMeasurement
            : result?.Units ?? "";

    // =========================================================
    // CALCULATE ABNORMALITY FROM THE CURRENT RESULT
    // =========================================================

    bool calculatedAbnormal = false;

    if (result != null &&
        hasReferenceRange &&
        decimal.TryParse(result.ResultValue, out decimal numericResult))
    {
        calculatedAbnormal =
            numericResult < testType!.ReferenceRangeLow!.Value ||
            numericResult > testType.ReferenceRangeHigh!.Value;
    }

    // Use the calculated result when a numeric reference range exists.
    // Otherwise fall back to the database IsAbnormal value.
    bool isAbnormal = hasReferenceRange
        ? calculatedAbnormal
        : result?.IsAbnormal == true;

    string currentStatus = result?.Status ?? "Unknown";
}


