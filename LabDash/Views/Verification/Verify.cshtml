<div class="verify-page">


    <!-- =====================================================
         PAGE HEADER
         ===================================================== -->

    <div class="verify-header">

        <div>

            <h2>

                <i class="fa-solid fa-check-double"></i>

                Verify Laboratory Result

            </h2>

            <p>
                Review the captured laboratory result before approving
                or returning it for review.
            </p>

        </div>


        <div class="header-icon">

            <i class="fa-solid fa-microscope"></i>

        </div>

    </div>



    <!-- =====================================================
         ABNORMAL RESULT
         ===================================================== -->
    @if (isAbnormal)
    {
        <div class="abnormal-banner">

            <div class="abnormal-banner-icon">

                <i class="fa-solid fa-triangle-exclamation"></i>

            </div>


            <div class="abnormal-banner-content">

                <strong>
                    Abnormal Result Detected
                </strong>

                <span>
                    The current captured value is outside the configured
                    reference range for this laboratory test.
                </span>

            </div>


            <div class="abnormal-banner-value">

                <small>
                    Current Result
                </small>

                <strong>
                    @result?.ResultValue
                </strong>

            </div>

        </div>
    }



    <!-- =====================================================
         RETURNED FOR REVIEW
         ===================================================== -->
    @if (currentStatus == "To Be Reviewed")
    {
        <div class="review-banner">

            <strong>

                <i class="fa-solid fa-rotate-left"></i>

                Result Returned For Review

            </strong>

            <span>

                This result was previously returned for correction.
                The value displayed below is the latest captured result.

            </span>

        </div>
    }



    <!-- =====================================================
     PATIENT + TEST INFORMATION
     LEFT = PATIENT
     RIGHT = TEST
     ===================================================== -->

    <div class="row g-4">

        <!-- =================================================
         LEFT COLUMN - PATIENT INFORMATION
         ================================================= -->

        <div class="col-lg-6">

            <div class="dashboard-card h-100">

                <div class="card-header-teal">

                    <i class="fa-solid fa-user"></i>

                    Patient Information

                </div>

                <div class="card-body-custom">

                    <!-- PATIENT DETAILS -->

                    <div class="info-row">

                        <span class="info-label">
                            Patient Name
                        </span>

                        <span class="info-value">
                            @patient?.Name @patient?.Surname
                        </span>

                    </div>


                    <div class="info-row">

                        <span class="info-label">
                            ID Number
                        </span>

                        <span class="info-value">

                            @(patient?.IDNumber ?? "Not available")

                        </span>

                    </div>


                    <div class="info-row">

                        <span class="info-label">
                            Email
                        </span>

                        <span class="info-value">

                            @(patient?.Email ?? "Not available")

                        </span>

                    </div>


                    <!-- =================================================
                     CLINICAL INFORMATION
                     ================================================= -->

                    <div class="clinical-information">

                        <div class="clinical-title">

                            <i class="fa-solid fa-notes-medical"></i>

                            Clinical Information

                        </div>


                        <!-- ALLERGIES -->

                        <div class="clinical-item clinical-allergies">

                            <div class="clinical-item-title">

                                <i class="fa-solid fa-triangle-exclamation"></i>

                                Allergies

                            </div>

                            <div class="clinical-item-content">

                                @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                                {
                                    @patient.Allergies
                                }
                                else
                                {
                                    @:None recorded
                                }

                            </div>

                        </div>


                        <!-- MEDICAL CONDITIONS -->

                        <div class="clinical-item clinical-conditions">

                            <div class="clinical-item-title">

                                <i class="fa-solid fa-heart-pulse"></i>

                                Medical Conditions

                            </div>

                            <div class="clinical-item-content">

                                @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                                {
                                    @patient.MedicalConditions
                                }
                                else
                                {
                                    @:None recorded
                                }

                            </div>

                        </div>


                        <!-- MEDICATION -->

                        <div class="clinical-item clinical-medication">

                            <div class="clinical-item-title">

                                <i class="fa-solid fa-pills"></i>

                                Medication

                            </div>

                            <div class="clinical-item-content">

                                @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                                {
                                    @patient.Medication
                                }
                                else
                                {
                                    @:None recorded
                                }

                            </div>

                        </div>

                    </div>

                </div>

            </div>

        </div>



        <!-- =================================================
         RIGHT COLUMN - TEST INFORMATION
         ================================================= -->

        <div class="col-lg-6">

            <div class="dashboard-card h-100">

                <div class="card-header-teal">

                    <i class="fa-solid fa-vials"></i>

                    Test Information

                </div>

                <div class="card-body-custom">


                    <!-- TEST NAME -->

                    <div class="test-highlight">

                        <div class="test-highlight-icon">

                            <i class="fa-solid fa-vial"></i>

                        </div>

                        <div>

                            <div class="test-highlight-label">
                                Laboratory Test
                            </div>

                            <div class="test-highlight-name">

                                @(testType?.Name ?? "Laboratory Test")

                            </div>

                            <span class="test-category">

                                <i class="fa-solid fa-layer-group"></i>

                                @(testType?.Category ?? "Not specified")

                            </span>

                        </div>

                    </div>


                    <!-- TEST DETAILS -->

                    <div class="test-detail-grid">


                        <!-- REQUEST NUMBER -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Request Number
                            </span>

                            <strong>
                                TR-@(test?.RequestId.ToString() ?? "N/A")
                            </strong>

                        </div>


                        <!-- TEST ITEM -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Test Item
                            </span>

                            <strong>
                                #@(test?.TestRequestItemId.ToString() ?? "N/A")
                            </strong>

                        </div>


                        <!-- SAMPLE TYPE -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Sample Type
                            </span>

                            <strong>

                                @(testType?.RequiredSampleType ?? "Not specified")

                            </strong>

                        </div>


                        <!-- UNIT -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Unit of Measurement
                            </span>

                            <strong>

                                @(string.IsNullOrWhiteSpace(configuredUnit)
                                    ? "Not specified"
                                    : configuredUnit)

                            </strong>

                        </div>


                        <!-- REFERENCE RANGE -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Configured Reference Range
                            </span>

                            <strong>

                                @configuredReferenceRange

                            </strong>

                        </div>


                        <!-- STATUS -->

                        <div class="test-detail-box">

                            <span class="test-detail-box-label">
                                Current Status
                            </span>

                            @if (currentStatus == "Completed")
                            {
                                <span class="status-badge status-completed">

                                    <i class="fa-solid fa-circle-check"></i>

                                    Completed

                                </span>
                            }
                            else if (currentStatus == "To Be Reviewed")
                            {
                                <span class="status-badge status-review">

                                    <i class="fa-solid fa-rotate-left"></i>

                                    To Be Reviewed

                                </span>
                            }
                            else if (currentStatus == "Verified")
                            {
                                <span class="status-badge status-verified">

                                    <i class="fa-solid fa-shield-check"></i>

                                    Verified

                                </span>
                            }
                            else
                            {
                                <span class="status-badge status-default">

                                    <i class="fa-solid fa-circle-info"></i>

                                    @currentStatus

                                </span>
                            }

                        </div>

                    </div>


                    <!-- =================================================
                     DOCTOR CLINICAL NOTES
                     ================================================= -->

                    <div class="clinical-information">

                        <div class="clinical-title">

                            <i class="fa-solid fa-file-medical"></i>

                            Doctor Clinical Notes

                        </div>


                        @if (!string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes))
                        {
                            <div class="doctor-notes">

                                <i class="fa-solid fa-clipboard-list me-1"></i>

                                @test.TestRequest.ClinicalNotes

                            </div>
                        }
                        else
                        {
                            <div class="doctor-notes">

                                <span class="empty-text">
                                    No clinical notes were provided.
                                </span>

                            </div>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =====================================================
         CAPTURED LABORATORY RESULT
         ===================================================== -->

    <div class="dashboard-card">

        <div class="card-header-teal">

            <i class="fa-solid fa-flask"></i>

            Captured Laboratory Result

        </div>


        <div class="card-body-custom">


            <div class="result-table-wrapper">

                <table class="result-table">

                    <tbody>


                        <!-- RESULT VALUE -->

                        <tr>

                            <th>
                                Result Value
                            </th>

                            <td>

                                <span class="result-value @(isAbnormal ? "abnormal" : "")">

                                    @(result?.ResultValue ?? "N/A")

                                </span>


                                @if (isAbnormal)
                                {
                                    <span class="abnormal-badge">

                                        <i class="fa-solid fa-triangle-exclamation"></i>

                                        Abnormal

                                    </span>
                                }
                                else
                                {
                                    <span class="normal-badge">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Within Range

                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- UNITS -->

                        <tr>

                            <th>
                                Units
                            </th>

                            <td>

                                @(string.IsNullOrWhiteSpace(configuredUnit)
                                    ? "N/A"
                                    : configuredUnit)

                            </td>

                        </tr>


                        <!-- REFERENCE RANGE -->

                        <tr>

                            <th>
                                Reference Range
                            </th>

                            <td>

                                <strong>

                                    @configuredReferenceRange

                                </strong>

                                @if (!string.IsNullOrWhiteSpace(configuredUnit))
                                {
                                    <span>
                                        @configuredUnit
                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- LAB COMMENTS -->

                        <tr>

                            <th>
                                Laboratory Comments
                            </th>

                            <td>

                                @if (!string.IsNullOrWhiteSpace(result?.Comments))
                                {
                                    @result.Comments
                                }
                                else
                                {
                                    <span class="empty-text">
                                        No laboratory comments captured.
                                    </span>
                                }

                            </td>

                        </tr>


                        <!-- CAPTURED BY -->

                        <tr>

                            <th>
                                Captured By
                            </th>

                            <td>

                                @(result?.CapturedByTechnician?.FullName ?? "Not available")

                            </td>

                        </tr>


                        <!-- DATE -->

                        <tr>

                            <th>
                                Date Captured
                            </th>

                            <td>

                                @(result != null
                                    ? result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                                    : "N/A")

                            </td>

                        </tr>


                        <!-- STATUS -->

                        <tr>

                            <th>
                                Current Status
                            </th>

                            <td>

                                @if (currentStatus == "Completed")
                                {
                                    <span class="status-badge status-completed">

                                        <i class="fa-solid fa-circle-check"></i>

                                        Completed

                                    </span>
                                }
                                else if (currentStatus == "To Be Reviewed")
                                {
                                    <span class="status-badge status-review">

                                        <i class="fa-solid fa-rotate-left"></i>

                                        To Be Reviewed

                                    </span>
                                }
                                else if (currentStatus == "Verified")
                                {
                                    <span class="status-badge status-verified">

                                        <i class="fa-solid fa-shield-check"></i>

                                        Verified

                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-default">

                                        <i class="fa-solid fa-circle-info"></i>

                                        @currentStatus

                                    </span>
                                }

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>



            <!-- =================================================
                 CONFIGURED REFERENCE RANGE
                 ================================================= -->
            @if (hasReferenceRange)
            {
                <div class="reference-box">

                    <div class="reference-title">

                        Configured Reference Range

                    </div>


                    <div class="reference-value">

                        @configuredReferenceRange

                        @if (!string.IsNullOrWhiteSpace(configuredUnit))
                        {
                            <span class="reference-unit">

                                @configuredUnit

                            </span>
                        }

                    </div>

                </div>
            }



            <!-- =================================================
                 VERIFICATION REMINDER
                 ================================================= -->

            <div class="reminder-box">

                <div class="reminder-title">

                    <i class="fa-solid fa-circle-info"></i>

                    Verification Reminder

                </div>


                Carefully review the laboratory result together with
                the patient's medical conditions, allergies, medication
                and doctor's clinical notes before approving the result.


                @if (isAbnormal)
                {
                    <br />

                    <strong style="color:#c52f3c;">

                        This result is outside the configured reference
                        range and has been detected as abnormal.

                    </strong>
                }

            </div>

        </div>

    </div>



    <!-- =====================================================
         VERIFICATION DECISION
         ===================================================== -->

    <div class="dashboard-card">

        <div class="card-header-teal">

            <i class="fa-solid fa-shield-halved"></i>

            Verification Decision

        </div>


        <div class="card-body-custom">


            <form asp-action="Verify" method="post">

                <input asp-for="TestRequestItemId"
                       type="hidden" />


                <div asp-validation-summary="ModelOnly"
                     class="alert alert-danger">
                </div>



                <!-- VERIFICATION NOTES -->

                <div>

                    <label asp-for="VerificationNotes"
                           class="verification-label">

                        Verification Notes

                    </label>


                    <textarea asp-for="VerificationNotes"
                              class="verification-textarea"
                              placeholder="Provide comments if approving or explain why the result is being returned for review..."></textarea>


                    <span asp-validation-for="VerificationNotes"
                          class="text-danger">
                    </span>

                </div>



                <!-- RULES -->

                <div class="rules-box">

                    <h5>

                        <i class="fa-solid fa-triangle-exclamation"></i>

                        Verification Rules

                    </h5>


                    <ul>

                        <li>
                            Review the captured laboratory result carefully
                            before making a decision.
                        </li>

                        <li>
                            Verify the patient's clinical notes support
                            the laboratory findings.
                        </li>

                        <li>
                            Confirm the patient's allergies, medical
                            conditions and medication.
                        </li>

                        <li>
                            If the result is incorrect, return it for review
                            with detailed notes.
                        </li>

                        <li>
                            A laboratory technician may
                            <strong>not verify a result that they personally captured.</strong>
                        </li>

                        @if (isAbnormal)
                        {
                            <li>

                                <strong style="color:#c52f3c;">

                                    This result is abnormal.
                                    Confirm the value against the configured
                                    reference range before verification.

                                </strong>

                            </li>
                        }

                    </ul>

                </div>



                <!-- SUMMARY -->

                <div class="row g-3 mt-3">


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-user-check"
                               style="color:#008f88;">
                            </i>

                            <h6>
                                Verifier
                            </h6>

                            <small>
                                Logged-in Laboratory Technician
                            </small>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-calendar-check"
                               style="color:#0d6efd;">
                            </i>

                            <h6>
                                Date
                            </h6>

                            <small>
                                @DateTime.Now.ToString("dd MMM yyyy")
                            </small>

                        </div>

                    </div>


                    <div class="col-md-4">

                        <div class="summary-tile">

                            <i class="fa-solid fa-clock"
                               style="color:#009688;">
                            </i>

                            <h6>
                                Time
                            </h6>

                            <small>
                                @DateTime.Now.ToString("HH:mm")
                            </small>

                        </div>

                    </div>

                </div>



                <!-- ACTION BUTTONS -->

                <div class="action-buttons">


                    <a asp-action="Index"
                       class="btn btn-back">

                        <i class="fa-solid fa-arrow-left me-1"></i>

                        Back

                    </a>


                    <button type="submit"
                            name="Status"
                            value="To Be Reviewed"
                            class="btn btn-return">

                        <i class="fa-solid fa-rotate-left me-1"></i>

                        Return For Review

                    </button>


                    <button type="submit"
                            name="Status"
                            value="Verified"
                            class="btn btn-verify">

                        <i class="fa-solid fa-check-double me-1"></i>

                        Verify Result

                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function() {

            const notes =
                document.getElementById("VerificationNotes");

            if (notes) {
                notes.focus();
            }

        });

    </script>
}