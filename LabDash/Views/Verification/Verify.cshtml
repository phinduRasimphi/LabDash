@model LabDash.Models.TestVerification

@using LabDash.Models

@{
    ViewData["Title"] = "Verify Test";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var result = ViewBag.Result as TestResult;
}

<div class="container-fluid">

    <div class="card shadow-lg border-0">

        <div class="card-header text-white"
             style="background:#0d766e;">

            <h3 class="mb-0">
                <i class="fa-solid fa-check-double"></i>
                Verify Test Result
            </h3>

        </div>

        <div class="card-body">

            <!-- ======================= -->
            <!-- Patient Information -->
            <!-- ======================= -->

            <div class="row mb-4">

                <div class="col-md-6">

                    <div class="card border-success">

                        <div class="card-header bg-success text-white">
                            Patient Information
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Name:</strong>
                                @patient?.Name @patient?.Surname
                            </p>

                            <p>
                                <strong>ID Number:</strong>
                                @patient?.IDNumber
                            </p>

                            <p>
                                <strong>Email:</strong>
                                @patient?.Email
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-info">

                        <div class="card-header bg-info text-white">
                            Test Details
                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Request:</strong>
                                TR-@test?.RequestId
                            </p>

                            <p>
                                <strong>Test:</strong>
                                @test?.TestType?.Name
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @test?.TestType?.Category
                            </p>

                            <p>
                                <strong>Captured By:</strong>
                                @test?.AssignedTechnician?.FullName
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- ======================= -->
            <!-- Clinical Notes -->
            <!-- ======================= -->

            <div class="card border-warning mb-4">

                <div class="card-header bg-warning">
                    Doctor Clinical Notes
                </div>

                <div class="card-body">

                    @test?.TestRequest?.ClinicalNotes

                </div>

            </div>

            <!-- ======================= -->
            <!-- Captured Result -->
            <!-- ======================= -->

            <div class="card border-primary mb-4">

                <div class="card-header bg-primary text-white">

                    Captured Result

                </div>

                <div class="card-body">

                    <table class="table table-bordered">

                        <tr>
                            <th style="width:220px;">Result</th>
                            <td>@result?.ResultValue</td>
                        </tr>

                        <tr>
                            <th>Units</th>
                            <td>@result?.Units</td>
                        </tr>

                        <tr>
                            <th>Reference Range</th>
                            <td>@result?.ReferenceRange</td>
                        </tr>

                        <tr>
                            <th>Comments</th>
                            <td>@result?.Comments</td>
                        </tr>

                        <tr>
                            <th>Date Captured</th>
                            <td>@result?.DateCaptured.ToString("dd MMM yyyy HH:mm")</td>
                        </tr>

                    </table>

                </div>

            </div>

            <!-- ======================= -->
            <!-- Verification -->
            <!-- ======================= -->

            <form asp-action="Verify" method="post">

                <input asp-for="TestRequestItemId" type="hidden" />

                <div class="mb-4">

                    <label asp-for="VerificationNotes"
                           class="form-label fw-bold">

                        Verification Notes

                    </label>

                    <textarea asp-for="VerificationNotes"
                              class="form-control"
                              rows="5"
                              placeholder="Enter comments if returning for review..."></textarea>

                </div>

                <div class="d-flex gap-3">

                    <button type="submit"
                            name="Status"
                            value="Verified"
                            class="btn btn-success btn-lg">

                        <i class="fa-solid fa-circle-check"></i>

                        Verify Test

                    </button>

                    <button type="submit"
                            name="Status"
                            value="To Be Reviewed"
                            class="btn btn-warning btn-lg">

                        <i class="fa-solid fa-rotate-left"></i>

                        Return For Review

                    </button>

                    <a asp-action="Index"
                       class="btn btn-secondary btn-lg">

                        Cancel

                    </a>

                </div>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}