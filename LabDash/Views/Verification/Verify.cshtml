    .reminder-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #075ca8;
        font-size: 12.5px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .reminder-box.abnormal .reminder-title {
        color: var(--danger-dark);
    }

    .abnormal-text {
        color: var(--danger-dark);
    }


    /* =========================================================
       VERIFICATION
       ========================================================= */

    .verification-label {
        color: var(--ink-soft);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .verification-textarea {
        width: 100%;
        min-height: 110px;
        padding: 14px 16px;
        background: var(--field);
        border: 1px solid var(--field-line);
        border-radius: 14px;
        font-size: 13.5px;
        color: var(--ink);
        resize: vertical;
    }

        .verification-textarea::placeholder {
            color: #7b9093;
        }

        .verification-textarea:focus {
            outline: none;
            background: #fff;
            border-color: var(--teal);
            box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
        }

    .rules-box {
        margin-top: 16px;
        background: var(--warning-soft);
        border: 1px solid #f0dfb8;
        border-left: 4px solid var(--warning);
        border-radius: 12px;
        padding: 13px 15px;
    }

        .rules-box h5 {
            margin: 0 0 6px;
            color: #755a21;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .rules-box ul {
            margin: 0;
            padding-left: 18px;
            color: #5e593f;
            font-size: 12.5px;
            line-height: 1.5;
        }

        .rules-box li {
            margin-bottom: 3px;
        }

    .summary-tile {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 13px 8px;
        text-align: center;
        height: 100%;
    }

        .summary-tile i {
            display: block;
            margin-bottom: 5px;
            font-size: 18px;
        }

        .summary-tile h6 {
            margin: 0 0 2px;
            color: var(--ink-soft);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .summary-tile small {
            color: #6c8588;
            font-size: 11px;
        }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .btn-back,
    .btn-return,
    .btn-verify {
        border-radius: 12px;
        padding: 11px 22px;
        font-size: 13.5px;
        font-weight: 600;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .btn-back {
        background: #fff;
        color: var(--teal-dark);
        border: 1px solid var(--field-line);
    }

        .btn-back:hover {
            background: #f2f9f8;
            color: var(--teal-dark);
            border-color: var(--teal);
        }

    .btn-return {
        background: #f3a623;
        color: white;
        border: none;
        box-shadow: 0 6px 16px rgba(243, 166, 35, .25);
    }

        .btn-return:hover {
            background: #d88b0a;
            color: white;
            transform: translateY(-1px);
        }

    .btn-verify {
        background: linear-gradient(135deg, var(--teal), var(--teal-dark));
        color: white;
        border: none;
        box-shadow: 0 6px 16px rgba(11, 95, 86, .28);
    }

        .btn-verify:hover {
            background: linear-gradient(135deg, #0c8479, var(--teal-deep));
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(11, 95, 86, .35);
        }

    .empty-text {
        color: #7b9093;
        font-style: italic;
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1000px) {

        .main-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .verify-page {
            padding: 0 10px;
            margin-top: 18px;
        }

        .verify-header {
            padding: 22px 18px;
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }

            .verify-header h2 {
                font-size: 21px;
                justify-content: center;
            }

        .card-body-custom {
            padding: 18px;
        }

        .sample-highlight,
        .test-detail-grid,
        .result-summary {
            grid-template-columns: 1fr;
        }

        .result-main {
            grid-column: span 1;
        }

        .abnormal-banner {
            align-items: flex-start;
        }

        .abnormal-banner-value {
            display: none;
        }

        .info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .info-value {
            text-align: left;
        }

        .result-table th {
            width: 40%;
        }

        .action-buttons {
            justify-content: stretch;
        }

            .action-buttons .btn {
                flex: 1;
            }
    }

</style>


<div class="verify-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="verify-header">

        <div>

            <h2>
                <i class="fa-solid fa-check-double"></i>
                Verify Laboratory Result
            </h2>

            <p>
                Review the patient's information, clinical notes,
                laboratory test and captured result before verification.
            </p>

        </div>

        <div class="header-icon">
            <i class="fa-solid fa-microscope"></i>
        </div>

    </div>


    <!-- =========================================================
         ABNORMAL / NORMAL BANNER
         ========================================================= -->
    @if (isAbnormal)
    {
        <div class="abnormal-banner">

            <div class="abnormal-banner-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="abnormal-banner-content">

                <strong>
                    Abnormal Result Detected
                </strong>

                <span>
                    @if (!string.IsNullOrEmpty(abnormalDirection))
                    {
                        @:The captured value is @abnormalDirection.ToLower() the configured reference range (@configuredReferenceRange @configuredUnit) for this laboratory test.
                    }
                    else
                    {
                        @:This result has been flagged as abnormal for this laboratory test.
                    }
                </span>

            </div>

            <div class="abnormal-banner-value">

                <small>Current Result</small>

                <strong>
                    @resultDisplay @configuredUnit
                </strong>

            </div>

        </div>
    }
    else if (hasReferenceRange && validNumericResult)
    {
        <div class="normal-banner">

            <div class="normal-banner-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="normal-banner-content">

                <strong>
                    Result Within Reference Range
                </strong>

                <span>
                    The captured value falls between
                    @referenceLow.ToString("0.##")
                    and
                    @referenceHigh.ToString("0.##")
                    @configuredUnit.
                </span>

            </div>

        </div>
    }


    <!-- =========================================================
         RETURNED FOR REVIEW
         ========================================================= -->
    @if (currentStatus == "To Be Reviewed")
    {
        <div class="review-banner">

            <strong>
                <i class="fa-solid fa-rotate-left"></i>
                Result Returned For Review
            </strong>

            <span>
                This result was previously returned for correction.
                The value displayed below is the latest captured result.
            </span>

        </div>
    }


    <!-- =========================================================
         PATIENT LEFT / TEST RIGHT
         ========================================================= -->

    <div class="main-info-grid">


        <!-- LEFT: PATIENT INFORMATION -->

        <div class="dashboard-card">

            <div class="card-header-teal">
                <i class="fa-solid fa-user"></i>
                Patient Information
            </div>

            <div class="card-body-custom">

                <div class="patient-name-highlight">

                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <div class="patient-name-label">Patient</div>
                        <div class="patient-name">@patientName</div>
                    </div>

                </div>


                <div class="info-row">
                    <span class="info-label">ID Number</span>
                    <span class="info-value">@(patient?.IDNumber ?? "Not available")</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">@(patient?.Email ?? "Not available")</span>
                </div>


                <!-- CLINICAL INFORMATION -->

                <div class="clinical-information">

                    <div class="clinical-title">
                        <i class="fa-solid fa-notes-medical"></i>
                        Clinical Information
                    </div>

                    <div class="clinical-item clinical-allergies">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                            {
                                @patient.Allergies
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>

                    <div class="clinical-item clinical-conditions">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical Conditions
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                            {
                                @patient.MedicalConditions
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>

                    <div class="clinical-item clinical-medication">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                            {
                                @patient.Medication
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>


                    <!-- DOCTOR CLINICAL NOTES -->

                    <div class="clinical-information">

                        <div class="clinical-title">
                            <i class="fa-solid fa-file-medical"></i>
                            Doctor Clinical Notes
                        </div>

                        <div class="doctor-notes">

                            <div class="doctor-notes-heading">
                                <i class="fa-solid fa-user-doctor"></i>
                                Doctor's Notes
                            </div>

                            @if (!string.IsNullOrWhiteSpace(clinicalNotes))
                            {
                                @clinicalNotes
                            }
                            else
                            {
                                <span class="empty-text">
                                    No clinical notes were provided by the doctor.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT: TEST INFORMATION -->

        <div class="dashboard-card">

            <div class="card-header-teal">
                <i class="fa-solid fa-vials"></i>
                Test Information
            </div>

            <div class="card-body-custom">

                <div class="test-highlight">

                    <div class="test-highlight-top">

                        <div class="test-highlight-icon">
                            <i class="fa-solid fa-vial"></i>
                        </div>

                        <div>

                            <div class="test-highlight-label">Laboratory Test</div>

                            <div class="test-highlight-name">@testName</div>

                            <span class="test-category">
                                <i class="fa-solid fa-layer-group"></i>
                                @category
                            </span>

                        </div>

                    </div>

                    <div class="sample-highlight">

                        <div class="sample-box sample-type">

                            <span class="sample-box-label">
                                <i class="fa-solid fa-droplet me-1"></i>
                                Sample Type
                            </span>

                            <div class="sample-box-value">@sampleType</div>

                        </div>

                        <div class="sample-box">

                            <span class="sample-box-label">
                                <i class="fa-solid fa-flask me-1"></i>
                                Test Category
                            </span>

                            <div class="sample-box-value">@category</div>

                        </div>

                    </div>

                </div>


                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Request Number</span>
                        <strong>TR-@(test?.RequestId.ToString() ?? "N/A")</strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Test Item</span>
                        <strong>#@(test?.TestRequestItemId.ToString() ?? "N/A")</strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Unit of Measurement</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(configuredUnit) ? "Not specified" : configuredUnit)
                        </strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Reference Range</span>
                        <strong>@configuredReferenceRange</strong>
                    </div>

                    <div class="test-detail-box">

                        <span class="test-detail-box-label">Current Status</span>

                        @if (currentStatus == "Completed")
                        {
                            <span class="status-badge status-completed">
                                <i class="fa-solid fa-circle-check"></i>
                                Completed
                            </span>
                        }
                        else if (currentStatus == "To Be Reviewed")
                        {
                            <span class="status-badge status-review">
                                <i class="fa-solid fa-rotate-left"></i>
                                To Be Reviewed
                            </span>
                        }
                        else if (currentStatus == "Verified")
                        {
                            <span class="status-badge status-verified">
                                <i class="fa-solid fa-shield-halved"></i>
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-default">
                                <i class="fa-solid fa-circle-info"></i>
                                @currentStatus
                            </span>
                        }

                    </div>

                    <div class="test-detail-box @abnormalClass">

                        <span class="test-detail-box-label">Result Classification</span>

                        @if (isAbnormal)
                        {
                            <span class="status-badge status-abnormal">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-within">
                                <i class="fa-solid fa-circle-check"></i>
                                Within Range
                            </span>
                        }

                    </div>

                </div>


                @if (hasReferenceRange)
                {
                    <div class="reference-box">

                        <div class="reference-title">Configured Reference Range</div>

                        <div class="reference-value">

                            @configuredReferenceRange

                            @if (!string.IsNullOrWhiteSpace(configuredUnit))
                            {
                                <span class="reference-unit">@configuredUnit</span>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CAPTURED LABORATORY RESULT
         ========================================================= -->

    <div class="dashboard-card result-card @abnormalClass">

        <div class="card-header-teal">
            <i class="fa-solid fa-flask"></i>
            Captured Laboratory Result
        </div>

        <div class="card-body-custom">


            <!-- RESULT SUMMARY -->

            <div class="result-summary">

                <div class="result-main @abnormalClass">

                    <div class="result-main-label">Captured Result</div>

                    <div class="result-main-value @abnormalClass">

                        @resultDisplay

                        @if (!string.IsNullOrWhiteSpace(configuredUnit))
                        {
                            <span style="font-size:13px;font-weight:600;margin-left:4px;">
                                @configuredUnit
                            </span>
                        }

                    </div>

                </div>

                <div class="result-status @abnormalClass">

                    @if (isAbnormal)
                    {
                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <strong>Abnormal</strong>

                        <small>
                            @(string.IsNullOrEmpty(abnormalDirection)
                                ? "Flagged as abnormal"
                                : $"{abnormalDirection} reference range")
                        </small>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-check" style="color:#198754;"></i>

                        <strong style="color:#198754;">Within Range</strong>

                        <small>Within reference range</small>
                    }

                </div>

            </div>


            <!-- RESULT TABLE -->

            <div class="result-table-wrapper">

                <table class="result-table">

                    <tbody>

                        <tr class="@(isAbnormal ? "row-abnormal" : "")">

                            <th>Result Value</th>

                            <td>

                                <span class="result-value @abnormalClass">
                                    @resultDisplay
                                </span>

                                @if (isAbnormal)
                                {
                                    <span class="abnormal-badge">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        Abnormal
                                    </span>
                                }
                                else
                                {
                                    <span class="normal-badge">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Within Range
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>Units</th>

                            <td>
                                @(string.IsNullOrWhiteSpace(configuredUnit) ? "N/A" : configuredUnit)
                            </td>

                        </tr>

                        <tr>

                            <th>Reference Range</th>

                            <td>

                                <strong>@configuredReferenceRange</strong>

                                @if (!string.IsNullOrWhiteSpace(configuredUnit))
                                {
                                    <span>@configuredUnit</span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>Laboratory Comments</th>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(result?.Comments))
                                {
                                    @result.Comments
                                }
                                else
                                {
                                    <span class="empty-text">
                                        No laboratory comments captured.
                                    </span>
                                }
                            </td>

                        </tr>

                        <tr>

                            <th>Captured By</th>

                            <td>
                                @(result?.CapturedByTechnician?.FullName ?? "Not available")
                            </td>

                        </tr>

                        <tr>

                            <th>Date Captured</th>

                            <td>
                                @(result != null
                                    ? result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                                    : "N/A")
                            </td>

                        </tr>

                        <tr>

                            <th>Current Status</th>

                            <td>

                                @if (currentStatus == "Completed")
                                {
                                    <span class="status-badge status-completed">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Completed
                                    </span>
                                }
                                else if (currentStatus == "To Be Reviewed")
                                {
                                    <span class="status-badge status-review">
                                        <i class="fa-solid fa-rotate-left"></i>
                                        To Be Reviewed
                                    </span>
                                }
                                else if (currentStatus == "Verified")
                                {
                                    <span class="status-badge status-verified">
                                        <i class="fa-solid fa-shield-halved"></i>
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-default">
                                        <i class="fa-solid fa-circle-info"></i>
                                        @currentStatus
                                    </span>
                                }

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- REMINDER -->

            <div class="reminder-box @abnormalClass">

                <div class="reminder-title">
                    <i class="fa-solid fa-circle-info"></i>
                    Verification Reminder
                </div>

                Carefully review the laboratory result together with
                the patient's medical conditions, allergies, medication
                and doctor's clinical notes before approving the result.

                @if (isAbnormal)
                {
                    <br />

                    <strong class="abnormal-text">
                        This result is outside the configured reference
                        range and has been detected as abnormal.
                    </strong>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         VERIFICATION DECISION
         ========================================================= -->

    <div class="dashboard-card">

        <div class="card-header-teal">
            <i class="fa-solid fa-shield-halved"></i>
            Verification Decision
        </div>

        <div class="card-body-custom">

            <form asp-action="Verify" method="post">

                <input asp-for="TestRequestItemId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div>

                    <label asp-for="VerificationNotes" class="verification-label">
                        Verification Notes
                    </label>

                    <textarea asp-for="VerificationNotes"
                              class="verification-textarea"
                              placeholder="Provide comments if approving or explain why the result is being returned for review..."></textarea>

                    <span asp-validation-for="VerificationNotes" class="text-danger"></span>

                </div>


                <!-- RULES -->

                <div class="rules-box">

                    <h5>
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Verification Rules
                    </h5>

                    <ul>

                        <li>
                            Review the captured laboratory result carefully
                            before making a decision.
                        </li>

                        <li>
                            Verify the patient's clinical notes support
                            the laboratory findings.
                        </li>

                        <li>
                            Confirm the patient's allergies, medical
                            conditions and medication.
                        </li>

                        <li>
                            If the result is incorrect, return it for review
                            with detailed notes.
                        </li>

                        <li>
                            A laboratory technician may
                            <strong>not verify a result that they personally captured.</strong>
                        </li>

                        @if (isAbnormal)
                        {
                            <li>
                                <strong class="abnormal-text">
                                    This result is abnormal.
                                    Confirm the value against the configured
                                    reference range before verification.
                                </strong>
                            </li>
                        }

                    </ul>

                </div>


                <!-- SUMMARY -->

                <div class="row g-3 mt-3">

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-user-check" style="color:#0f9488;"></i>
                            <h6>Verifier</h6>
                            <small>Logged-in Laboratory Technician</small>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-calendar-check" style="color:#0d6efd;"></i>
                            <h6>Date</h6>
                            <small>@DateTime.Now.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-clock" style="color:#0f9488;"></i>
                            <h6>Time</h6>
                            <small>@DateTime.Now.ToString("HH:mm")</small>
                        </div>
                    </div>

                </div>


                <!-- ACTION BUTTONS -->

                <div class="action-buttons">

                    <a asp-action="Index" class="btn btn-back">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Back
                    </a>

                    <button type="submit"
                            name="Status"
                            value="To Be Reviewed"
                            class="btn btn-return">
                        <i class="fa-solid fa-rotate-left me-1"></i>
                        Return For Review
                    </button>

                    <button type="submit"
                            name="Status"
                            value="Verified"
                            class="btn btn-verify">
                        <i class="fa-solid fa-check-double me-1"></i>
                        Verify Result
                    </button>

                </div>

            </form>

        </div>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const notes = document.getElementById("VerificationNotes");

            if (notes) {
                notes.focus();
            }

        });

    </script>
} 