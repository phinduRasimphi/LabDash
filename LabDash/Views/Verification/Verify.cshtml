        --pill-text: #0e6b62;

        --danger: #d62839;
        --danger-dark: #a31d2b;
        --danger-soft: #fdebed;
        --danger-line: #f3c4c9;

        --warning: #c98500;
        --warning-dark: #805b13;
        --warning-soft: #fff3d9;
        --warning-line: #f0dfb7;

