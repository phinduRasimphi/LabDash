    .clinical-item {
        border-radius: 12px;
        padding: 11px 13px;
        margin-bottom: 9px;
        min-height: 58px;
    }

        .clinical-item:last-child {
            margin-bottom: 0;
        }

    .clinical-allergies {
        background: #fde9e9;
        border: 1px solid #f5d2d2;
        color: #a72d38;
    }

    .clinical-conditions {
        background: #fff3d9;
        border: 1px solid #f3e2b8;
        color: #805b13;
    }

    .clinical-medication {
        background: #e2f4f3;
        border: 1px solid #c9e8e5;
        color: #006b70;
    }

    .clinical-item-title {
        display: flex;
        align-items: center;
        gap: 7px;
        font-size: 12.5px;
        font-weight: 700;
        margin-bottom: 3px;
    }

        .clinical-item-title i {
            font-size: 11px;
        }

    .clinical-item-content {
        font-size: 12.5px;
        line-height: 1.45;
        opacity: .92;
    }


    /* =========================================================
       DOCTOR NOTES
       ========================================================= */

    .doctor-notes {
        background: #eaf6f4;
        border: 1px solid #cbe8e5;
        border-left: 4px solid var(--teal);
        border-radius: 12px;
        padding: 14px 15px;
        color: #075f67;
        font-size: 13px;
        line-height: 1.55;
    }

    .doctor-notes-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--pill-text);
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .06em;
        text-transform: uppercase;
        margin-bottom: 6px;
    }


    /* =========================================================
       TEST INFORMATION
       ========================================================= */

    .test-highlight {
        padding: 16px;
        background: var(--field);
        border: 1px solid var(--field-line);
        border-radius: 16px;
        margin-bottom: 16px;
    }

    .test-highlight-top {
        display: flex;
        align-items: center;
        gap: 13px;
    }

    .test-highlight-icon {
        width: 52px;
        height: 52px;
        min-width: 52px;
        border-radius: 14px;
        background: var(--pill-bg);
        color: var(--teal-dark);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 21px;
    }

    .test-highlight-name {
        color: var(--ink);
        font-size: 18px;
        font-weight: 700;
        margin-top: 1px;
    }

    .test-category {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        background: var(--pill-bg);
        color: var(--pill-text);
        border-radius: 999px;
        padding: 5px 12px;
        font-size: 11px;
        font-weight: 600;
        margin-top: 6px;
    }

    .sample-highlight {
        margin-top: 14px;
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
    }

    .sample-box {
        background: white;
        border: 1px solid var(--field-line);
        border-radius: 14px;
        padding: 12px 13px;
    }

        .sample-box.sample-type {
            border-left: 4px solid var(--teal);
        }

    .sample-box-label {
        display: block;
        margin-bottom: 4px;
    }

    .sample-box-value {
        color: #075f67;
        font-size: 13.5px;
        font-weight: 700;
    }

    .test-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 10px;
        margin-top: 16px;
    }

    .test-detail-box {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 11px 12px;
    }

        .test-detail-box.abnormal {
            background: var(--danger-soft);
            border-color: var(--danger-line);
        }

    .test-detail-box-label {
        display: block;
        margin-bottom: 5px;
    }

    .test-detail-box strong {
        color: #174952;
        font-size: 13px;
        font-weight: 700;
    }

    .reference-box {
        margin-top: 14px;
        background: var(--field);
        border: 1px solid var(--field-line);
        border-radius: 14px;
        padding: 13px 15px;
    }

    .reference-title {
        margin-bottom: 4px;
    }

    .reference-value {
        color: #07545c;
        font-size: 16px;
        font-weight: 700;
    }

    .reference-unit {
        font-size: 12px;
        font-weight: 600;
        margin-left: 4px;
        color: #567579;
    }


    /* =========================================================
       CAPTURED RESULT
       ========================================================= */

    .result-card {
        margin-bottom: 20px;
    }

        .result-card.abnormal {
            border: 2px solid var(--danger);
            box-shadow: 0 10px 30px rgba(214, 40, 57, .16);
        }

            .result-card.abnormal .card-header-teal {
                background: var(--danger-soft);
                color: var(--danger-dark);
                border-bottom-color: var(--danger-line);
            }

                .result-card.abnormal .card-header-teal i {
                    color: var(--danger);
                }

    .result-summary {
        display: grid;
        grid-template-columns: 1fr 1fr 1fr;
        gap: 12px;
        margin-bottom: 16px;
    }

    .result-main {
        grid-column: span 2;
        border-radius: 16px;
        padding: 16px 19px;
        background: var(--field);
        border: 1px solid var(--line);
    }

        .result-main.abnormal {
            background: var(--danger-soft);
            border: 2px solid var(--danger);
        }

            .result-main.abnormal .result-main-label {
                color: var(--danger-dark);
            }

    .result-main-value {
        margin-top: 4px;
        font-size: 30px;
        font-weight: 700;
        color: var(--teal-dark);
    }

        .result-main-value.abnormal {
            color: var(--danger);
        }

    .result-status {
        display: flex;
        flex-direction: column;
        justify-content: center;
        align-items: center;
        text-align: center;
        border-radius: 16px;
        padding: 12px;
        background: var(--success-soft);
        border: 1px solid #cde8d6;
    }

        .result-status.abnormal {
            background: var(--danger);
            border-color: var(--danger);
        }

            .result-status.abnormal i,
            .result-status.abnormal strong,
            .result-status.abnormal small {
                color: white !important;
            }

        .result-status i {
            font-size: 24px;
            margin-bottom: 5px;
        }

        .result-status strong {
            font-size: 12px;
            font-weight: 700;
            letter-spacing: .04em;
            text-transform: uppercase;
        }

        .result-status small {
            margin-top: 2px;
            font-size: 10.5px;
            color: var(--muted);
        }

    .result-table-wrapper {
        border: 1px solid var(--line);
        border-radius: 14px;
        overflow: hidden;
    }

    .result-table {
        width: 100%;
        border-collapse: collapse;
        margin: 0;
    }

        .result-table th {
            width: 210px;
            background: var(--field);
            color: var(--ink-soft);
            padding: 12px 15px;
            font-size: 12.5px;
            font-weight: 600;
            text-align: left;
            border-bottom: 1px solid var(--line);
        }

        .result-table td {
            background: white;
            color: #193f47;
            padding: 12px 15px;
            font-size: 13px;
            border-bottom: 1px solid var(--line);
        }

        .result-table tr:last-child th,
        .result-table tr:last-child td {
            border-bottom: none;
        }

        .result-table tr.row-abnormal th {
            background: #fbd9dd;
            color: var(--danger-dark);
        }

        .result-table tr.row-abnormal td {
            background: var(--danger-soft);
        }

    .result-value {
        font-size: 20px;
        font-weight: 700;
        color: var(--teal-dark);
    }

        .result-value.abnormal {
            color: var(--danger);
        }


    /* =========================================================
       BADGES
       ========================================================= */

    .status-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 5px 12px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .status-completed {
        background: var(--pill-bg);
        color: var(--pill-text);
    }

    .status-review {
        background: var(--warning-soft);
        color: var(--warning);
    }

    .status-verified {
        background: var(--info-soft);
        color: var(--info);
    }

    .status-default {
        background: #edf1f2;
        color: #66767a;
    }

    .status-abnormal {
        background: var(--danger);
        color: white;
    }

    .status-within {
        background: var(--success-soft);
        color: var(--success);
    }

    .abnormal-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: 8px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--danger);
        color: white;
        font-size: 10.5px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .normal-badge {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: 8px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--success-soft);
        color: var(--success);
        font-size: 10.5px;
        font-weight: 700;
    }

    .returned-badge-inline {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        margin-left: 8px;
        padding: 5px 12px;
        border-radius: 999px;
        background: var(--warning-soft);
        color: var(--warning-dark);
        font-size: 10.5px;
        font-weight: 700;
    }


    /* =========================================================
       REMINDER
       ========================================================= */

    .reminder-box {
        margin-top: 16px;
        padding: 13px 15px;
        background: var(--info-soft);
        border-left: 4px solid var(--info);
        border-radius: 12px;
        color: #31576f;
        font-size: 12.5px;
        line-height: 1.5;
    }

        .reminder-box.abnormal {
            background: var(--danger-soft);
            border-left-color: var(--danger);
            color: #6e3038;
        }

    .reminder-title {
        display: flex;
        align-items: center;
        gap: 6px;
        color: #075ca8;
        font-size: 12.5px;
        font-weight: 700;
        margin-bottom: 3px;
    }

    .reminder-box.abnormal .reminder-title {
        color: var(--danger-dark);
    }

    .abnormal-text {
        color: var(--danger-dark);
    }


    /* =========================================================
       VERIFICATION
       ========================================================= */

    .verification-label {
        color: var(--ink-soft);
        font-size: 13px;
        font-weight: 600;
        margin-bottom: 6px;
        display: block;
    }

    .verification-textarea {
        width: 100%;
        min-height: 110px;
        padding: 14px 16px;
        background: var(--field);
        border: 1px solid var(--field-line);
        border-radius: 14px;
        font-size: 13.5px;
        color: var(--ink);
        resize: vertical;
    }

        .verification-textarea::placeholder {
            color: #7b9093;
        }

        .verification-textarea:focus {
            outline: none;
            background: #fff;
            border-color: var(--teal);
            box-shadow: 0 0 0 4px rgba(15, 148, 136, .12);
        }

    .rules-box {
        margin-top: 16px;
        background: var(--warning-soft);
        border: 1px solid #f0dfb8;
        border-left: 4px solid var(--warning);
        border-radius: 12px;
        padding: 13px 15px;
    }

        .rules-box h5 {
            margin: 0 0 6px;
            color: #755a21;
            font-size: 13px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 6px;
        }

        .rules-box ul {
            margin: 0;
            padding-left: 18px;
            color: #5e593f;
            font-size: 12.5px;
            line-height: 1.5;
        }

        .rules-box li {
            margin-bottom: 3px;
        }

    .summary-tile {
        background: var(--field);
        border: 1px solid var(--line);
        border-radius: 14px;
        padding: 13px 8px;
        text-align: center;
        height: 100%;
    }

        .summary-tile i {
            display: block;
            margin-bottom: 5px;
            font-size: 18px;
        }

        .summary-tile h6 {
            margin: 0 0 2px;
            color: var(--ink-soft);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .summary-tile small {
            color: #6c8588;
            font-size: 11px;
        }


    /* =========================================================
       BUTTONS
       ========================================================= */

    .action-buttons {
        display: flex;
        justify-content: flex-end;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-top: 18px;
    }

    .btn-back,
    .btn-return,
    .btn-verify {
        border-radius: 12px;
        padding: 11px 22px;
        font-size: 13.5px;
        font-weight: 600;
        transition: transform .15s ease, box-shadow .15s ease, background .15s ease;
    }

    .btn-back {
        background: #fff;
        color: var(--teal-dark);
        border: 1px solid var(--field-line);
    }

        .btn-back:hover {
            background: #f2f9f8;
            color: var(--teal-dark);
            border-color: var(--teal);
        }

    .btn-return {
        background: #f3a623;
        color: white;
        border: none;
        box-shadow: 0 6px 16px rgba(243, 166, 35, .25);
    }

        .btn-return:hover {
            background: #d88b0a;
            color: white;
            transform: translateY(-1px);
        }

    .btn-verify {
        background: linear-gradient(135deg, var(--teal), var(--teal-dark));
        color: white;
        border: none;
        box-shadow: 0 6px 16px rgba(11, 95, 86, .28);
    }

        .btn-verify:hover {
            background: linear-gradient(135deg, #0c8479, var(--teal-deep));
            color: white;
            transform: translateY(-1px);
            box-shadow: 0 8px 20px rgba(11, 95, 86, .35);
        }

    .empty-text {
        color: #7b9093;
        font-style: italic;
    }


    /* =========================================================
       CONFIRMATION POPUP
       ========================================================= */

    .confirm-overlay {
        position: fixed;
        inset: 0;
        z-index: 2000;
        display: none;
        align-items: center;
        justify-content: center;
        padding: 20px;
        background: rgba(8, 40, 37, .55);
        backdrop-filter: blur(3px);
    }

        .confirm-overlay.open {
            display: flex;
            animation: confirmFade .15s ease;
        }

    .confirm-dialog {
        width: 100%;
        max-width: 440px;
        padding: 30px 28px 24px;
        background: #fff;
        border-radius: 22px;
        text-align: center;
        box-shadow: 0 24px 60px rgba(8, 40, 37, .3);
        animation: confirmPop .18s ease;
    }

        .confirm-dialog h3 {
            margin: 0 0 8px;
            color: var(--ink);
            font-size: 19px;
            font-weight: 700;
        }

        .confirm-dialog p {
            margin: 0;
            color: var(--ink-soft);
            font-size: 13.5px;
            line-height: 1.6;
        }

    .confirm-icon {
        width: 64px;
        height: 64px;
        margin: 0 auto 16px;
        border-radius: 18px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 26px;
    }

        .confirm-icon.verify {
            background: var(--pill-bg);
            color: var(--teal-dark);
        }

        .confirm-icon.return {
            background: var(--warning-soft);
            color: var(--warning);
        }

    .confirm-warning {
        margin-top: 14px;
        padding: 10px 13px;
        background: var(--danger-soft);
        border: 1px solid var(--danger-line);
        border-left: 4px solid var(--danger);
        border-radius: 12px;
        color: var(--danger-dark);
        font-size: 12.5px;
        font-weight: 600;
        text-align: left;
    }

    .confirm-actions {
        display: flex;
        justify-content: center;
        gap: 10px;
        margin-top: 22px;
    }

        .confirm-actions .btn {
            flex: 1;
            border-radius: 12px;
            padding: 11px 18px;
            font-size: 13.5px;
            font-weight: 600;
        }

            .confirm-actions .btn:disabled {
                opacity: .5;
                cursor: not-allowed;
                transform: none;
            }

    @@keyframes confirmFade {
        from { opacity: 0; }
        to { opacity: 1; }
    }

    @@keyframes confirmPop {
        from { opacity: 0; transform: translateY(8px) scale(.97); }
        to { opacity: 1; transform: none; }
    }


    /* =========================================================
       RESPONSIVE
       ========================================================= */

    @@media (max-width: 1000px) {
        .main-info-grid {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 700px) {

        .verify-page {
            padding: 0 10px;
            margin-top: 18px;
        }

        .verify-header {
            padding: 22px 18px;
            flex-direction: column;
            text-align: center;
            gap: 15px;
        }

            .verify-header h2 {
                font-size: 21px;
                justify-content: center;
            }

        .card-body-custom {
            padding: 18px;
        }

        .sample-highlight,
        .test-detail-grid,
        .result-summary,
        .returned-meta {
            grid-template-columns: 1fr;
        }

        .result-main {
            grid-column: span 1;
        }

        .abnormal-banner {
            align-items: flex-start;
        }

        .abnormal-banner-value {
            display: none;
        }

        .returned-panel-top {
            align-items: flex-start;
        }

        .info-row {
            flex-direction: column;
            align-items: flex-start;
            gap: 2px;
        }

        .info-value {
            text-align: left;
        }

        .result-table th {
            width: 40%;
        }

        .action-buttons {
            justify-content: stretch;
        }

            .action-buttons .btn {
                flex: 1;
            }
    }

</style>


<div class="verify-page">


    <!-- =========================================================
         HEADER
         ========================================================= -->

    <div class="verify-header">

        <div>

            <h2>
                <i class="fa-solid fa-check-double"></i>
                Verify Laboratory Result
            </h2>

            <p>
                Review the patient's information, clinical notes,
                laboratory test and captured result before verification.
            </p>

        </div>

        <div class="header-icon">
            <i class="fa-solid fa-microscope"></i>
        </div>

    </div>


    <!-- =========================================================
         PREVIOUSLY RETURNED FOR REVIEW: before vs after
         ========================================================= -->
    @if (wasReturned)
    {
        <div class="returned-panel">

            <div class="returned-panel-top">

                <div class="returned-panel-icon">
                    <i class="fa-solid fa-rotate-left"></i>
                </div>

                <div class="returned-panel-title">
                    <strong>
                        @(awaitingCorrection
                            ? "This result was returned for review"
                            : "This result was previously returned for review")
                    </strong>
                    <span>
                        @(awaitingCorrection
                            ? "It is still waiting for the technician to correct and resubmit it."
                            : "Compare the result before review with the corrected result, and check the reason it was returned.")
                    </span>
                </div>

                @if (returnHistory.Count > 0)
                {
                    <span class="returned-count">
                        Returned @returnHistory.Count @(returnHistory.Count == 1 ? "time" : "times")
                    </span>
                }

            </div>

            @if (!returnHistory.Any())
            {
                <div class="returned-reason">
                    <span>Reason it was returned</span>
                    <p>No return reason was recorded for this result.</p>
                </div>
            }

            @for (int i = 0; i < returnHistory.Count; i++)
            {
                var ret = returnHistory[i];
                var newer = i > 0 ? returnHistory[i - 1] : null;
                bool isLatest = i == 0;
                int returnNumber = returnHistory.Count - i;

                // BEFORE = snapshot saved when this return happened
                string beforeValue = ret.PreviousResultValue;
                string beforeComments = ret.PreviousComments;
                bool? beforeAbnormal = isAbnormalValue(beforeValue) ?? ret.PreviousIsAbnormal;

                // AFTER = the current result (latest return) or the snapshot taken at the next return
                bool afterPending = isLatest && awaitingCorrection;
                string afterValue = isLatest ? result?.ResultValue : newer?.PreviousResultValue;
                string afterComments = isLatest ? result?.Comments : newer?.PreviousComments;
                bool? afterAbnormal = isLatest
                    ? (bool?)isAbnormal
                    : (isAbnormalValue(afterValue) ?? newer?.PreviousIsAbnormal);

                <details class="return-case" open="@isLatest">

                    <summary>
                        <span class="return-case-title">
                            Return @returnNumber of @returnHistory.Count
                            @if (isLatest)
                            {
                                <span class="return-case-tag">Latest</span>
                            }
                        </span>
                        <span class="return-case-date">@ret.VerificationDate.ToString("dd MMM yyyy HH:mm")</span>
                    </summary>

                    <div class="returned-meta">

                        <div>
                            <span>Returned by</span>
                            <strong>@verifierLabel(ret)</strong>
                        </div>

                        <div>
                            <span>Date returned</span>
                            <strong>@ret.VerificationDate.ToString("dd MMM yyyy HH:mm")</strong>
                        </div>

                    </div>

                    <div class="returned-reason">
                        <span>Reason it was returned</span>
                        <p>
                            @(string.IsNullOrWhiteSpace(ret.VerificationNotes)
                                ? "No reason was recorded."
                                : ret.VerificationNotes)
                        </p>
                    </div>

                    <div class="compare-grid">

                        <!-- BEFORE REVIEW -->
                        <div class="compare-box before">

                            <div class="compare-label">
                                <i class="fa-solid fa-clock-rotate-left"></i>
                                Result before review
                            </div>

                            <div class="compare-value">
                                @(string.IsNullOrWhiteSpace(beforeValue) ? "Not recorded" : beforeValue)
                                @if (!string.IsNullOrWhiteSpace(beforeValue) && !string.IsNullOrWhiteSpace(configuredUnit))
                                {
                                    <small>@configuredUnit</small>
                                }
                            </div>

                            @if (beforeAbnormal == true)
                            {
                                <span class="status-badge status-abnormal">
                                    <i class="fa-solid fa-triangle-exclamation"></i> Abnormal
                                </span>
                            }
                            else if (beforeAbnormal == false)
                            {
                                <span class="status-badge status-within">
                                    <i class="fa-solid fa-circle-check"></i> Within Range
                                </span>
                            }

                            <div class="compare-comments">
                                <span>Laboratory comments</span>
                                @if (!string.IsNullOrWhiteSpace(beforeComments))
                                {
                                    <p>@beforeComments</p>
                                }
                                else
                                {
                                    <p class="empty-text">No comments captured.</p>
                                }
                            </div>

                        </div>

                        <div class="compare-arrow">
                            <i class="fa-solid fa-arrow-right"></i>
                        </div>

                        <!-- AFTER REVIEW -->
                        <div class="compare-box after">

                            <div class="compare-label">
                                <i class="fa-solid fa-circle-check"></i>
                                @(isLatest ? "Corrected result after review" : "Result after this return")
                            </div>

                            @if (afterPending)
                            {
                                <div class="compare-value compare-pending">
                                    <i class="fa-solid fa-hourglass-half"></i>
                                    Waiting for corrected result
                                </div>
                            }
                            else
                            {
                                <div class="compare-value">
                                    @(string.IsNullOrWhiteSpace(afterValue) ? "Not recorded" : afterValue)
                                    @if (!string.IsNullOrWhiteSpace(afterValue) && !string.IsNullOrWhiteSpace(configuredUnit))
                                    {
                                        <small>@configuredUnit</small>
                                    }
                                </div>

                                @if (afterAbnormal == true)
                                {
                                    <span class="status-badge status-abnormal">
                                        <i class="fa-solid fa-triangle-exclamation"></i> Abnormal
                                    </span>
                                }
                                else if (afterAbnormal == false)
                                {
                                    <span class="status-badge status-within">
                                        <i class="fa-solid fa-circle-check"></i> Within Range
                                    </span>
                                }

                                <div class="compare-comments">
                                    <span>Laboratory comments</span>
                                    @if (!string.IsNullOrWhiteSpace(afterComments))
                                    {
                                        <p>@afterComments</p>
                                    }
                                    else
                                    {
                                        <p class="empty-text">No comments captured.</p>
                                    }
                                </div>

                                @if (isLatest && result != null)
                                {
                                    <div class="compare-captured">
                                        Captured @result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                                        @if (!string.IsNullOrWhiteSpace(result.CapturedByTechnician?.FullName))
                                        {
                                            @:by @result.CapturedByTechnician.FullName
                                        }
                                    </div>
                                }
                            }

                        </div>

                    </div>

                </details>
            }

            @if (awaitingCorrection)
            {
                <div class="returned-state waiting">
                    <i class="fa-solid fa-hourglass-half"></i>
                    Waiting for the corrected result
                </div>
            }
            else
            {
                <div class="returned-state resubmitted">
                    <i class="fa-solid fa-circle-check"></i>
                    Resubmitted. The corrected result is shown below.
                </div>
            }

        </div>
    }


    <!-- =========================================================
         ABNORMAL / NORMAL BANNER
         ========================================================= -->
    @if (isAbnormal)
    {
        <div class="abnormal-banner">

            <div class="abnormal-banner-icon">
                <i class="fa-solid fa-triangle-exclamation"></i>
            </div>

            <div class="abnormal-banner-content">

                <strong>
                    Abnormal Result Detected
                </strong>

                <span>
                    @if (!string.IsNullOrEmpty(abnormalDirection))
                    {
                        @:The captured value is @abnormalDirection.ToLower() the configured reference range (@configuredReferenceRange @configuredUnit) for this laboratory test.
                    }
                    else
                    {
                        @:This result has been flagged as abnormal for this laboratory test.
                    }
                </span>

            </div>

            <div class="abnormal-banner-value">

                <small>Current Result</small>

                <strong>
                    @resultDisplay @configuredUnit
                </strong>

            </div>

        </div>
    }
    else if (hasReferenceRange && validNumericResult)
    {
        <div class="normal-banner">

            <div class="normal-banner-icon">
                <i class="fa-solid fa-circle-check"></i>
            </div>

            <div class="normal-banner-content">

                <strong>
                    Result Within Reference Range
                </strong>

                <span>
                    The captured value falls between
                    @referenceLow.ToString("0.##")
                    and
                    @referenceHigh.ToString("0.##")
                    @configuredUnit.
                </span>

            </div>

        </div>
    }


    <!-- =========================================================
         PATIENT LEFT / TEST RIGHT
         ========================================================= -->

    <div class="main-info-grid">


        <!-- LEFT: PATIENT INFORMATION -->

        <div class="dashboard-card">

            <div class="card-header-teal">
                <i class="fa-solid fa-user"></i>
                Patient Information
            </div>

            <div class="card-body-custom">

                <div class="patient-name-highlight">

                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div>
                        <div class="patient-name-label">Patient</div>
                        <div class="patient-name">@patientName</div>
                    </div>

                </div>


                <div class="info-row">
                    <span class="info-label">ID Number</span>
                    <span class="info-value">@(patient?.IDNumber ?? "Not available")</span>
                </div>

                <div class="info-row">
                    <span class="info-label">Email</span>
                    <span class="info-value">@(patient?.Email ?? "Not available")</span>
                </div>


                <!-- CLINICAL INFORMATION -->

                <div class="clinical-information">

                    <div class="clinical-title">
                        <i class="fa-solid fa-notes-medical"></i>
                        Clinical Information
                    </div>

                    <div class="clinical-item clinical-allergies">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            Allergies
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.Allergies))
                            {
                                @patient.Allergies
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>

                    <div class="clinical-item clinical-conditions">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-heart-pulse"></i>
                            Medical Conditions
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                            {
                                @patient.MedicalConditions
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>

                    <div class="clinical-item clinical-medication">

                        <div class="clinical-item-title">
                            <i class="fa-solid fa-pills"></i>
                            Medication
                        </div>

                        <div class="clinical-item-content">
                            @if (!string.IsNullOrWhiteSpace(patient?.Medication))
                            {
                                @patient.Medication
                            }
                            else
                            {
                                @:None recorded
                            }
                        </div>

                    </div>


                    <!-- DOCTOR CLINICAL NOTES -->

                    <div class="clinical-information">

                        <div class="clinical-title">
                            <i class="fa-solid fa-file-medical"></i>
                            Doctor Clinical Notes
                        </div>

                        <div class="doctor-notes">

                            <div class="doctor-notes-heading">
                                <i class="fa-solid fa-user-doctor"></i>
                                Doctor's Notes
                            </div>

                            @if (!string.IsNullOrWhiteSpace(clinicalNotes))
                            {
                                @clinicalNotes
                            }
                            else
                            {
                                <span class="empty-text">
                                    No clinical notes were provided by the doctor.
                                </span>
                            }

                        </div>

                    </div>

                </div>

            </div>

        </div>


        <!-- RIGHT: TEST INFORMATION -->

        <div class="dashboard-card">

            <div class="card-header-teal">
                <i class="fa-solid fa-vials"></i>
                Test Information
            </div>

            <div class="card-body-custom">

                <div class="test-highlight">

                    <div class="test-highlight-top">

                        <div class="test-highlight-icon">
                            <i class="fa-solid fa-vial"></i>
                        </div>

                        <div>

                            <div class="test-highlight-label">Laboratory Test</div>

                            <div class="test-highlight-name">@testName</div>

                            <span class="test-category">
                                <i class="fa-solid fa-layer-group"></i>
                                @category
                            </span>

                        </div>

                    </div>

                    <div class="sample-highlight">

                        <div class="sample-box sample-type">

                            <span class="sample-box-label">
                                <i class="fa-solid fa-droplet me-1"></i>
                                Sample Type
                            </span>

                            <div class="sample-box-value">@sampleType</div>

                        </div>

                        <div class="sample-box">

                            <span class="sample-box-label">
                                <i class="fa-solid fa-flask me-1"></i>
                                Test Category
                            </span>

                            <div class="sample-box-value">@category</div>

                        </div>

                    </div>

                </div>


                <!-- TEST DETAILS -->

                <div class="test-detail-grid">

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Request Number</span>
                        <strong>TR-@(test?.RequestId.ToString() ?? "N/A")</strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Test Item</span>
                        <strong>#@(test?.TestRequestItemId.ToString() ?? "N/A")</strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Unit of Measurement</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(configuredUnit) ? "Not specified" : configuredUnit)
                        </strong>
                    </div>

                    <div class="test-detail-box">
                        <span class="test-detail-box-label">Reference Range</span>
                        <strong>@configuredReferenceRange</strong>
                    </div>

                    <div class="test-detail-box">

                        <span class="test-detail-box-label">Current Status</span>

                        @if (currentStatus == "Completed")
                        {
                            <span class="status-badge status-completed">
                                <i class="fa-solid fa-circle-check"></i>
                                Completed
                            </span>
                        }
                        else if (currentStatus == "To Be Reviewed")
                        {
                            <span class="status-badge status-review">
                                <i class="fa-solid fa-rotate-left"></i>
                                To Be Reviewed
                            </span>
                        }
                        else if (currentStatus == "Verified")
                        {
                            <span class="status-badge status-verified">
                                <i class="fa-solid fa-shield-halved"></i>
                                Verified
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-default">
                                <i class="fa-solid fa-circle-info"></i>
                                @currentStatus
                            </span>
                        }

                    </div>

                    <div class="test-detail-box @abnormalClass">

                        <span class="test-detail-box-label">Result Classification</span>

                        @if (isAbnormal)
                        {
                            <span class="status-badge status-abnormal">
                                <i class="fa-solid fa-triangle-exclamation"></i>
                                Abnormal
                            </span>
                        }
                        else
                        {
                            <span class="status-badge status-within">
                                <i class="fa-solid fa-circle-check"></i>
                                Within Range
                            </span>
                        }

                    </div>

                </div>


                @if (hasReferenceRange)
                {
                    <div class="reference-box">

                        <div class="reference-title">Configured Reference Range</div>

                        <div class="reference-value">

                            @configuredReferenceRange

                            @if (!string.IsNullOrWhiteSpace(configuredUnit))
                            {
                                <span class="reference-unit">@configuredUnit</span>
                            }

                        </div>

                    </div>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         CAPTURED LABORATORY RESULT
         ========================================================= -->

    <div class="dashboard-card result-card @abnormalClass">

        <div class="card-header-teal">
            <i class="fa-solid fa-flask"></i>
            Captured Laboratory Result
        </div>

        <div class="card-body-custom">


            <!-- RESULT SUMMARY -->

            <div class="result-summary">

                <div class="result-main @abnormalClass">

                    <div class="result-main-label">Captured Result</div>

                    <div class="result-main-value @abnormalClass">

                        @resultDisplay

                        @if (!string.IsNullOrWhiteSpace(configuredUnit))
                        {
                            <span style="font-size:13px;font-weight:600;margin-left:4px;">
                                @configuredUnit
                            </span>
                        }

                    </div>

                </div>

                <div class="result-status @abnormalClass">

                    @if (isAbnormal)
                    {
                        <i class="fa-solid fa-triangle-exclamation"></i>

                        <strong>Abnormal</strong>

                        <small>
                            @(string.IsNullOrEmpty(abnormalDirection)
                                ? "Flagged as abnormal"
                                : $"{abnormalDirection} reference range")
                        </small>
                    }
                    else
                    {
                        <i class="fa-solid fa-circle-check" style="color:#198754;"></i>

                        <strong style="color:#198754;">Within Range</strong>

                        <small>Within reference range</small>
                    }

                </div>

            </div>


            <!-- RESULT TABLE -->

            <div class="result-table-wrapper">

                <table class="result-table">

                    <tbody>

                        <tr class="@(isAbnormal ? "row-abnormal" : "")">

                            <th>Result Value</th>

                            <td>

                                <span class="result-value @abnormalClass">
                                    @resultDisplay
                                </span>

                                @if (isAbnormal)
                                {
                                    <span class="abnormal-badge">
                                        <i class="fa-solid fa-triangle-exclamation"></i>
                                        Abnormal
                                    </span>
                                }
                                else
                                {
                                    <span class="normal-badge">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Within Range
                                    </span>
                                }

                                @if (wasReturned && !awaitingCorrection)
                                {
                                    <span class="returned-badge-inline">
                                        <i class="fa-solid fa-rotate-left"></i>
                                        Corrected after return
                                    </span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>Units</th>

                            <td>
                                @(string.IsNullOrWhiteSpace(configuredUnit) ? "N/A" : configuredUnit)
                            </td>

                        </tr>

                        <tr>

                            <th>Reference Range</th>

                            <td>

                                <strong>@configuredReferenceRange</strong>

                                @if (!string.IsNullOrWhiteSpace(configuredUnit))
                                {
                                    <span>@configuredUnit</span>
                                }

                            </td>

                        </tr>

                        <tr>

                            <th>Laboratory Comments</th>

                            <td>
                                @if (!string.IsNullOrWhiteSpace(result?.Comments))
                                {
                                    @result.Comments
                                }
                                else
                                {
                                    <span class="empty-text">
                                        No laboratory comments captured.
                                    </span>
                                }
                            </td>

                        </tr>

                        <tr>

                            <th>Captured By</th>

                            <td>
                                @(result?.CapturedByTechnician?.FullName ?? "Not available")
                            </td>

                        </tr>

                        <tr>

                            <th>Date Captured</th>

                            <td>
                                @(result != null
                                    ? result.DateCaptured.ToString("dd MMM yyyy HH:mm")
                                    : "N/A")
                            </td>

                        </tr>

                        <tr>

                            <th>Current Status</th>

                            <td>

                                @if (currentStatus == "Completed")
                                {
                                    <span class="status-badge status-completed">
                                        <i class="fa-solid fa-circle-check"></i>
                                        Completed
                                    </span>
                                }
                                else if (currentStatus == "To Be Reviewed")
                                {
                                    <span class="status-badge status-review">
                                        <i class="fa-solid fa-rotate-left"></i>
                                        To Be Reviewed
                                    </span>
                                }
                                else if (currentStatus == "Verified")
                                {
                                    <span class="status-badge status-verified">
                                        <i class="fa-solid fa-shield-halved"></i>
                                        Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="status-badge status-default">
                                        <i class="fa-solid fa-circle-info"></i>
                                        @currentStatus
                                    </span>
                                }

                            </td>

                        </tr>

                    </tbody>

                </table>

            </div>


            <!-- REMINDER -->

            <div class="reminder-box @abnormalClass">

                <div class="reminder-title">
                    <i class="fa-solid fa-circle-info"></i>
                    Verification Reminder
                </div>

                Carefully review the laboratory result together with
                the patient's medical conditions, allergies, medication
                and doctor's clinical notes before approving the result.

                @if (wasReturned && latestReturn != null)
                {
                    <br />

                    <strong>
                        This result was returned before. Compare it with the result
                        before review and confirm the correction fixes the reason given.
                    </strong>
                }

                @if (isAbnormal)
                {
                    <br />

                    <strong class="abnormal-text">
                        This result is outside the configured reference
                        range and has been detected as abnormal.
                    </strong>
                }

            </div>

        </div>

    </div>


    <!-- =========================================================
         VERIFICATION DECISION
         ========================================================= -->

    <div class="dashboard-card">

        <div class="card-header-teal">
            <i class="fa-solid fa-shield-halved"></i>
            Verification Decision
        </div>

        <div class="card-body-custom">

            <form id="verifyForm" asp-action="Verify" method="post">

                <input asp-for="TestRequestItemId" type="hidden" />

                <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

                <div>

                    <label asp-for="VerificationNotes" class="verification-label">
                        Verification Notes
                    </label>

                    <textarea asp-for="VerificationNotes"
                              class="verification-textarea"
                              placeholder="Provide comments if approving or explain why the result is being returned for review..."></textarea>

                    <span asp-validation-for="VerificationNotes" class="text-danger"></span>

                </div>


                <!-- RULES -->

                <div class="rules-box">

                    <h5>
                        <i class="fa-solid fa-triangle-exclamation"></i>
                        Verification Rules
                    </h5>

                    <ul>

                        <li>
                            Review the captured laboratory result carefully
                            before making a decision.
                        </li>

                        <li>
                            Verify the patient's clinical notes support
                            the laboratory findings.
                        </li>

                        <li>
                            Confirm the patient's allergies, medical
                            conditions and medication.
                        </li>

                        <li>
                            If the result is incorrect, return it for review
                            with detailed notes.
                        </li>

                        <li>
                            A laboratory technician may
                            <strong>not verify a result that they personally captured.</strong>
                        </li>

                        @if (isAbnormal)
                        {
                            <li>
                                <strong class="abnormal-text">
                                    This result is abnormal.
                                    Confirm the value against the configured
                                    reference range before verification.
                                </strong>
                            </li>
                        }

                    </ul>

                </div>


                <!-- SUMMARY -->

                <div class="row g-3 mt-3">

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-user-check" style="color:#0f9488;"></i>
                            <h6>Verifier</h6>
                            <small>Logged-in Laboratory Technician</small>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-calendar-check" style="color:#0d6efd;"></i>
                            <h6>Date</h6>
                            <small>@DateTime.Now.ToString("dd MMM yyyy")</small>
                        </div>
                    </div>

                    <div class="col-md-4">
                        <div class="summary-tile">
                            <i class="fa-solid fa-clock" style="color:#0f9488;"></i>
                            <h6>Time</h6>
                            <small>@DateTime.Now.ToString("HH:mm")</small>
                        </div>
                    </div>

                </div>


                <!-- ACTION BUTTONS -->

                <div class="action-buttons">

                    <a asp-action="Index" class="btn btn-back">
                        <i class="fa-solid fa-arrow-left me-1"></i>
                        Back
                    </a>

                    <button type="button"
                            class="btn btn-return js-decision-btn"
                            data-status="To Be Reviewed">
                        <i class="fa-solid fa-rotate-left me-1"></i>
                        Return For Review
                    </button>

                    <button type="button"
                            class="btn btn-verify js-decision-btn"
                            data-status="Verified">
                        <i class="fa-solid fa-check-double me-1"></i>
                        Verify Result
                    </button>

                </div>

            </form>

        </div>

    </div>


    <!-- =========================================================
         CONFIRMATION POPUP
         ========================================================= -->

    <div class="confirm-overlay" id="confirmOverlay" aria-hidden="true">
        <div class="confirm-dialog" role="dialog" aria-modal="true" aria-labelledby="confirmTitle">

            <div class="confirm-icon verify" id="confirmIcon">
                <i class="fa-solid fa-check-double" id="confirmIconGlyph"></i>
            </div>

            <h3 id="confirmTitle">Are you sure?</h3>
            <p id="confirmMessage"></p>

            <div class="confirm-warning" id="confirmWarning" style="display:none;"></div>

            <div class="confirm-actions">
                <button type="button" class="btn btn-back" id="confirmCancel">Cancel</button>
                <button type="button" class="btn btn-verify" id="confirmOk">Confirm</button>
            </div>

        </div>
    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />

    <script>

        document.addEventListener("DOMContentLoaded", function () {

            const form      = document.getElementById("verifyForm");
            const notes     = document.getElementById("VerificationNotes");
            const overlay   = document.getElementById("confirmOverlay");
            const title     = document.getElementById("confirmTitle");
            const message   = document.getElementById("confirmMessage");
            const warning   = document.getElementById("confirmWarning");
            const icon      = document.getElementById("confirmIcon");
            const iconGlyph = document.getElementById("confirmIconGlyph");
            const btnOk     = document.getElementById("confirmOk");
            const btnCancel = document.getElementById("confirmCancel");

            let pendingStatus = null;
            let submitting = false;

            if (notes) notes.focus();

            function openConfirm(status) {

                pendingStatus = status;

                const hasNotes = notes && notes.value.trim().length > 0;
                const isVerify = status === "Verified";

                warning.style.display = "none";
                btnOk.disabled = false;

                if (isVerify) {

                    title.textContent   = "Verify this result?";
                    message.textContent = "You are confirming that the laboratory result has been reviewed and is correct. It will be marked as Verified.";

                    icon.className = "confirm-icon verify";
                    iconGlyph.className = "fa-solid fa-check-double";

                    btnOk.className = "btn btn-verify";
                    btnOk.textContent = "Yes, Verify Result";

                } else {

                    title.textContent   = "Return this result for review?";
                    message.textContent = "The result will be sent back to the technician to be corrected and resubmitted.";

                    icon.className = "confirm-icon return";
                    iconGlyph.className = "fa-solid fa-rotate-left";

                    btnOk.className = "btn btn-return";
                    btnOk.textContent = "Yes, Return For Review";

                    // A reason is required when returning
                    if (!hasNotes) {
                        warning.textContent = "Please close this popup and enter the reason for returning this result in the Verification Notes.";
                        warning.style.display = "block";
                        btnOk.disabled = true;
                    }
                }

                overlay.classList.add("open");
                overlay.setAttribute("aria-hidden", "false");
                (btnOk.disabled ? btnCancel : btnOk).focus();
            }

            function closeConfirm() {
                overlay.classList.remove("open");
                overlay.setAttribute("aria-hidden", "true");
                pendingStatus = null;
            }

            // Open the popup instead of submitting
            document.querySelectorAll(".js-decision-btn").forEach(function (btn) {
                btn.addEventListener("click", function () {
                    openConfirm(btn.getAttribute("data-status"));
                });
            });

            // Confirm -> submit with the chosen Status
            btnOk.addEventListener("click", function () {

                if (submitting || !pendingStatus) return;
                submitting = true;

                const hidden = document.createElement("input");
                hidden.type  = "hidden";
                hidden.name  = "Status";
                hidden.value = pendingStatus;
                form.appendChild(hidden);

                btnOk.disabled = true;
                btnOk.textContent = "Submitting...";

                form.submit();
            });

            // Cancel / click outside / Escape
            btnCancel.addEventListener("click", function () {
                closeConfirm();
                if (notes) notes.focus();
            });

            overlay.addEventListener("click", function (e) {
                if (e.target === overlay) closeConfirm();
            });

            document.addEventListener("keydown", function (e) {
                if (e.key === "Escape" && overlay.classList.contains("open")) {
                    closeConfirm();
                }
            });

        });

    </script>
}