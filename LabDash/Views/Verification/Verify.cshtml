        border-radius: 999px;
        background: white;
        border: 1px solid var(--warning-line);
        color: var(--warning-dark);
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .returned-meta {
        display: grid;
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 10px;
        margin-bottom: 12px;
    }

        .returned-meta > div {
            background: white;
            border: 1px solid var(--warning-line);
            border-radius: 12px;
            padding: 10px 13px;
        }

        .returned-meta span {
            display: block;
            margin-bottom: 3px;
            color: #8a6d2d;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .returned-meta strong {
            color: #4d3b10;
            font-size: 13px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

    .returned-reason {
        background: white;
        border: 1px solid var(--warning-line);
        border-left: 4px solid var(--warning);
        border-radius: 12px;
        padding: 13px 15px;
    }

        .returned-reason span {
            display: block;
            margin-bottom: 5px;
            color: #8a6d2d;
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .returned-reason p {
            margin: 0;
            color: #4d3b10;
            font-size: 13.5px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

    .returned-state {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-top: 12px;
        font-size: 12.5px;
        font-weight: 600;
    }

        .returned-state.resubmitted {
            color: var(--success);
        }

        .returned-state.waiting {
            color: var(--warning-dark);
        }

    .returned-history {
        margin-top: 14px;
        border-top: 1px dashed var(--warning-line);
        padding-top: 12px;
    }

        .returned-history summary {
            cursor: pointer;
            color: var(--warning-dark);
            font-size: 12.5px;
            font-weight: 700;
        }

    .returned-history-item {
        margin-top: 10px;
        padding: 11px 14px;
        background: white;
        border: 1px solid var(--warning-line);
        border-radius: 12px;
    }

        .returned-history-item header {
            display: flex;
            justify-content: space-between;
            flex-wrap: wrap;
            gap: 6px;
            margin-bottom: 5px;
            color: #8a6d2d;
            font-size: 11.5px;
            font-weight: 600;
        }

        .returned-history-item p {
            margin: 0;
            color: #4d3b10;
            font-size: 13px;
            line-height: 1.6;
            overflow-wrap: anywhere;
        }



    /* ---------- BEFORE vs AFTER REVIEW ---------- */

    .returned-meta {
        grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .return-case {
        margin-top: 12px;
        padding: 14px 16px;
        background: rgba(255,255,255,.55);
        border: 1px solid var(--warning-line);
        border-radius: 14px;
    }

        .return-case > summary {
            cursor: pointer;
            display: flex;
            justify-content: space-between;
            align-items: center;
            gap: 10px;
            margin: -2px 0 12px;
            list-style: none;
            color: var(--warning-dark);
            font-size: 13px;
            font-weight: 700;
        }

            .return-case > summary::-webkit-details-marker {
                display: none;
            }

        .return-case:not([open]) > summary {
            margin-bottom: 0;
        }

    .return-case-tag {
        margin-left: 8px;
        padding: 3px 10px;
        border-radius: 999px;
        background: var(--warning);
        color: white;
        font-size: 10px;
        font-weight: 700;
    }

    .return-case-date {
        color: #8a6d2d;
        font-size: 11.5px;
        font-weight: 600;
    }

    .compare-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
        gap: 12px;
        align-items: stretch;
        margin-top: 12px;
    }

    .compare-box {
        padding: 14px 16px;
        border-radius: 14px;
        background: white;
        border: 1px solid var(--line);
    }

        .compare-box.before {
            border-left: 4px solid var(--warning);
        }

        .compare-box.after {
            border-left: 4px solid var(--teal);
            background: #f6fbfa;
        }

    .compare-label {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 8px;
        font-size: 11px;
        font-weight: 700;
        letter-spacing: .04em;
        text-transform: uppercase;
    }

    .compare-box.before .compare-label {
        color: var(--warning-dark);
    }

    .compare-box.after .compare-label {
        color: var(--teal-dark);
    }

    .compare-value {
        margin-bottom: 8px;
        color: var(--ink);
        font-size: 26px;
        font-weight: 800;
        letter-spacing: -.5px;
        overflow-wrap: anywhere;
    }

        .compare-value small {
            margin-left: 6px;
            color: var(--muted);
            font-size: 12px;
            font-weight: 500;
            letter-spacing: 0;
        }

    .compare-box.before .compare-value {
        color: #6f5a2d;
    }

    .compare-box.after .compare-value {
        color: var(--teal-dark);
    }

    .compare-pending {
        color: var(--muted) !important;
        font-size: 15px;
        font-weight: 600;
        letter-spacing: 0;
    }

    .compare-comments {
        margin-top: 12px;
        padding-top: 10px;
        border-top: 1px solid var(--line);
    }

        .compare-comments span {
            display: block;
            margin-bottom: 4px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .06em;
            text-transform: uppercase;
        }

        .compare-comments p {
            margin: 0;
            color: #3f605d;
            font-size: 13px;
            line-height: 1.65;
            overflow-wrap: anywhere;
        }

    .compare-captured {
        margin-top: 10px;
