@model IEnumerable<LabDash.Models.TestVerification>

@using LabDash.Models

@{
    ViewData["Title"] = "Verification History";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var currentResult = ViewBag.CurrentResult as TestResult;

    var history = Model.OrderBy(v => v.VerificationDate).ToList();
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet" />

<style>

    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --ink: #0f2f2d;
        --muted: #6b817f;
        --line: #e3ecec;
        --page-bg: #e9f0f1;
        --danger: #c0443f;
        --danger-soft: #fde8e8;
        --warning: #a87308;
        --warning-soft: #fff3d9;
        --success: #198754;
        --success-soft: #e2f5e9;
        --radius-lg: 20px;
        --shadow-soft: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .page-container,
    .page-container * {
        box-sizing: border-box;
    }

    .page-container {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--ink);
        background: var(--page-bg);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

        .page-container *:focus-visible {
            outline: 3px solid rgba(15, 148, 136, .4);
            outline-offset: 2px;
            border-radius: 8px;
        }

    /*================ BACK LINK =================*/

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 16px;
        padding: 9px 16px;
        color: #3f605d;
        background: #fff;
        border: 1px solid var(--teal-border);
        border-radius: 12px;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        transition: background .15s, color .15s;
    }

        .back-link:hover {
            color: var(--teal-dark);
            background: var(--teal-soft);
        }

    /*================ HERO HEADER =================*/

    .page-header {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .header-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .page-header h2 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .page-header p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .header-stat {
        min-width: 150px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

        .header-stat span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .header-stat strong {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

    /*================ SUMMARY CARD =================*/

    .summary-card {
        display: grid;
        grid-template-columns: repeat(auto-fit, minmax(190px, 1fr));
        gap: 14px;
        padding: 22px 26px;
        margin-bottom: 22px;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .summary-item {
        min-width: 0;
        padding: 14px 16px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

        .summary-item h6 {
            margin: 0 0 6px;
            color: var(--muted);
            font-size: 11px;
            font-weight: 600;
            letter-spacing: .4px;
            text-transform: uppercase;
        }

        .summary-item > div {
            color: var(--ink);
            font-size: 15px;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

    /*================ BADGES =================*/

    .badge-status {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
    }

    .badge-completed {
        color: var(--teal-dark);
        background: var(--teal-light);
    }

    .badge-review {
        color: var(--warning);
        background: var(--warning-soft);
    }

    .badge-verified {
        color: var(--success);
        background: var(--success-soft);
    }

    .badge-default {
        color: #607572;
        background: #edf4f3;
    }

    .badge-abnormal {
        color: var(--danger);
        background: var(--danger-soft);
    }

    /*================ TIMELINE =================*/

    .timeline-card {
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
    }

    .timeline-header {
        display: flex;
        align-items: center;
        gap: 11px;
        padding: 18px 26px;
        color: var(--ink);
        border-bottom: 1px solid var(--line);
        font-size: 17px;
        font-weight: 700;
    }

        .timeline-header > i {
            color: var(--teal);
            font-size: 16px;
        }

    .timeline-body {
        padding: 28px 30px 14px;
    }

    .timeline {
        position: relative;
        padding-left: 44px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 15px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: var(--teal-border);
        }

    .timeline-entry {
        position: relative;
        padding-bottom: 26px;
    }

        .timeline-entry:last-child {
            padding-bottom: 8px;
        }

    .timeline-dot {
        position: absolute;
        left: -44px;
        top: 0;
        width: 32px;
        height: 32px;
        display: flex;
        align-items: center;
        justify-content: center;
        border: 3px solid #fff;
        border-radius: 50%;
        box-shadow: 0 4px 10px rgba(10, 93, 85, .18);
        color: #fff;
        font-size: 13px;
    }

        .timeline-dot.verified {
            background: var(--btn-gradient);
        }

        .timeline-dot.returned {
            background: #c58a00;
        }

    .timeline-entry-header {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

        .timeline-entry-header .round {
            color: var(--ink);
            font-size: 14px;
            font-weight: 700;
        }

    .timeline-meta {
        margin-bottom: 10px;
        color: var(--muted);
        font-size: 13px;
    }

        .timeline-meta i {
            margin-right: 4px;
            color: var(--teal);
        }

    .timeline-note {
        padding: 14px 16px;
        color: #3f605d;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 14px;
        font-size: 13px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

        .timeline-note.empty {
            color: var(--muted);
            font-style: italic;
            border-left-color: var(--teal-border);
        }

    /*================ EMPTY =================*/

    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state i {
            margin-bottom: 14px;
            color: var(--teal);
            font-size: 48px;
            opacity: .85;
        }

        .empty-state h3 {
            color: var(--ink);
            font-size: 18px;
            font-weight: 700;
        }

        .empty-state p {
            color: var(--muted);
        }

    /*================ RESPONSIVE =================*/

    @@media (max-width: 768px) {

        .header-stat {
            display: none;
        }
    }

    @@media (max-width: 500px) {

        .page-container {
            padding: 12px 9px 28px;
        }

        .page-header {
            padding: 18px;
            border-radius: 20px;
        }

            .page-header h2 {
                font-size: 19px;
            }

        .summary-card,
        .timeline-body {
            padding-left: 16px;
            padding-right: 16px;
        }

        .timeline-header {
            padding: 14px 16px;
            font-size: 15px;
        }
    }

</style>

<div class="page-container">

    <a asp-controller="Verification" asp-action="Index" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Verification Queue
    </a>

    <div class="page-header">

        <div class="header-icon">
            <i class="fa-solid fa-clock-rotate-left"></i>
        </div>

        <div>
            <h2>Verification History</h2>
            <p>Full record of review decisions and notes for TR-@test?.RequestId.</p>
        </div>

        <div class="header-stat">
            <span>Review rounds</span>
            <strong>@history.Count</strong>
        </div>

    </div>

    <div class="summary-card">

        <div class="summary-item">
            <h6>Patient</h6>
            <div>@patient?.Name @patient?.Surname</div>
        </div>

        <div class="summary-item">
            <h6>Test</h6>
            <div>@test?.TestType?.Name</div>
        </div>

        <div class="summary-item">
            <h6>Current Status</h6>
            <div>
                @{
                    var status = test?.Status;
                    var statusBadgeClass = status == "Completed" ? "badge-completed"
                        : status == "Verified" ? "badge-verified"
                        : status == "To Be Reviewed" ? "badge-review"
                        : "badge-default";
                }
                <span class="badge-status @statusBadgeClass">@status</span>
            </div>
        </div>

        <div class="summary-item">
            <h6>Current Result</h6>
            <div>
                @(currentResult?.ResultValue ?? "-")
                @if (currentResult != null && !string.IsNullOrWhiteSpace(currentResult.Units))
                {
                    <text> @currentResult.Units</text>
                }
                @if (currentResult != null && currentResult.IsAbnormal)
                {
                    <span class="badge-status badge-abnormal ms-1">
                        <i class="fa-solid fa-triangle-exclamation"></i> Abnormal
                    </span>
                }
            </div>
        </div>

        <div class="summary-item">
            <h6>Review Rounds</h6>
            <div>@history.Count</div>
        </div>

    </div>

    <div class="timeline-card">

        <div class="timeline-header">
            <i class="fa-solid fa-list-check"></i>
            Review Timeline
        </div>

        <div class="timeline-body">

            @if (!history.Any())
            {
                <div class="empty-state">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <h3>No verification decisions yet</h3>
                    <p>This result hasn't been reviewed by a verifier yet.</p>
                </div>
            }
            else
            {
                <div class="timeline">

                    @for (int i = 0; i < history.Count; i++)
                    {
                        var entry = history[i];
                        var wasVerified = entry.Status == "Verified";

                        <div class="timeline-entry">

                            <div class="timeline-dot @(wasVerified ? "verified" : "returned")">
                                <i class="fa-solid @(wasVerified ? "fa-check" : "fa-rotate-left")"></i>
                            </div>

                            <div class="timeline-entry-header">
                                <span class="round">Round @(i + 1)</span>
                                @if (wasVerified)
                                {
                                    <span class="badge-status badge-verified">
                                        <i class="fa-solid fa-check-double"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-review">
                                        <i class="fa-solid fa-rotate-left"></i> Returned For Review
                                    </span>
                                }
                            </div>

                            <div class="timeline-meta">
                                <i class="fa-solid fa-user-check"></i>
                                @entry.VerifiedByTechnician?.FullName
                                &middot;
                                @entry.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            </div>

                            @if (!string.IsNullOrWhiteSpace(entry.VerificationNotes))
                            {
                                <div class="timeline-note">@entry.VerificationNotes</div>
                            }
                            else
                            {
                                <div class="timeline-note empty">No note provided.</div>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>