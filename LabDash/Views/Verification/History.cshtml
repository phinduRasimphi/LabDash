@model IEnumerable<LabDash.Models.TestVerification>

@using LabDash.Models

@{
    ViewData["Title"] = "Verification History";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var currentResult = ViewBag.CurrentResult as TestResult;

    var history = Model.OrderBy(v => v.VerificationDate).ToList();
}

<link rel="stylesheet"
      href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.2/css/all.min.css" />
<link rel="preconnect" href="https://fonts.googleapis.com" />
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=Segoe+UI&display=swap" rel="stylesheet" />

<style>

    :root {
        --teal-900: #00453d;
        --teal-700: #00695c;
        --teal-600: #00796B;
        --teal-500: #009688;
        --teal-100: rgba(0,150,136,.12);
        --teal-50: #eef7f8;
        --ink: #173a3a;
        --muted: #5f7a78;
        --danger: #e13b3b;
        --danger-soft: rgba(225,59,59,.1);
        --warning: #c98400;
        --warning-soft: rgba(201,132,0,.12);
        --info: #0d6efd;
        --info-soft: rgba(13,110,253,.1);
        --line: #e5efee;
        --radius-lg: 20px;
        --radius-md: 14px;
        --shadow-soft: 0 8px 24px rgba(9,50,46,.07);
        --shadow-lift: 0 16px 34px rgba(9,50,46,.12);
    }

    body {
        background: var(--teal-50);
        font-family: 'Inter','Segoe UI',sans-serif;
        color: var(--ink);
    }

    .page-container {
        max-width: 1100px;
        margin: 35px auto;
        padding: 0 16px;
    }

    *:focus-visible {
        outline: 3px solid #4fb8ac;
        outline-offset: 2px;
        border-radius: 6px;
    }

    /*================ HEADER =================*/

    .page-header {
        background: linear-gradient(135deg,var(--teal-500),var(--teal-900));
        color: white;
        padding: 30px 36px;
        border-radius: var(--radius-lg);
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 26px;
        box-shadow: var(--shadow-lift);
        position: relative;
        overflow: hidden;
    }

        .page-header::after {
            content: "";
            position: absolute;
            right: -60px;
            top: -60px;
            width: 220px;
            height: 220px;
            border-radius: 50%;
            background: rgba(255,255,255,.07);
        }

        .page-header h2 {
            margin: 0;
            font-size: 27px;
            font-weight: 800;
            letter-spacing: -.02em;
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .page-header p {
            margin-top: 6px;
            opacity: .9;
            font-size: 14.5px;
        }

    .header-icon {
        width: 72px;
        height: 72px;
        border-radius: 18px;
        background: rgba(255,255,255,.16);
        display: flex;
        justify-content: center;
        align-items: center;
        font-size: 28px;
        flex-shrink: 0;
        z-index: 1;
    }

    /*================ SUMMARY CARD =================*/

    .summary-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        padding: 24px 26px;
        margin-bottom: 26px;
        display: flex;
        flex-wrap: wrap;
        gap: 24px;
        justify-content: space-between;
    }

    .summary-item h6 {
        color: var(--muted);
        font-size: 12.5px;
        text-transform: uppercase;
        letter-spacing: .04em;
        font-weight: 700;
        margin-bottom: 4px;
    }

    .summary-item div {
        font-size: 15px;
        font-weight: 600;
        color: var(--ink);
    }

    /*================ BADGES =================*/

    .badge-status {
        border-radius: 25px;
        padding: 6px 14px;
        font-size: 12.5px;
        font-weight: 600;
        display: inline-flex;
        align-items: center;
        gap: 6px;
    }

    .badge-completed {
        background: rgba(25,160,90,.12);
        color: #188a52;
    }

    .badge-review {
        background: var(--warning-soft);
        color: var(--warning);
    }

    .badge-verified {
        background: var(--info-soft);
        color: var(--info);
    }

    .badge-default {
        background: #eef0f2;
        color: #5c6670;
    }

    .badge-abnormal {
        background: var(--danger-soft);
        color: var(--danger);
    }

    /*================ TIMELINE =================*/

    .timeline-card {
        background: white;
        border-radius: var(--radius-lg);
        box-shadow: var(--shadow-soft);
        overflow: hidden;
    }

    .timeline-header {
        background: var(--teal-600);
        color: white;
        padding: 18px 26px;
        font-size: 17px;
        font-weight: 700;
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .timeline-body {
        padding: 30px 30px 10px 30px;
    }

    .timeline {
        position: relative;
        padding-left: 38px;
    }

        .timeline::before {
            content: "";
            position: absolute;
            left: 14px;
            top: 6px;
            bottom: 6px;
            width: 2px;
            background: var(--line);
        }

    .timeline-entry {
        position: relative;
        padding-bottom: 28px;
    }

        .timeline-entry:last-child {
            padding-bottom: 4px;
        }

    .timeline-dot {
        position: absolute;
        left: -38px;
        top: 2px;
        width: 30px;
        height: 30px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 13px;
        color: white;
    }

        .timeline-dot.verified {
            background: #188a52;
        }

        .timeline-dot.returned {
            background: var(--warning);
        }

    .timeline-entry-header {
        display: flex;
        align-items: center;
        gap: 10px;
        flex-wrap: wrap;
        margin-bottom: 6px;
    }

        .timeline-entry-header .round {
            font-size: 12.5px;
            font-weight: 700;
            color: var(--muted);
            text-transform: uppercase;
            letter-spacing: .04em;
        }

    .timeline-meta {
        font-size: 13px;
        color: var(--muted);
        margin-bottom: 8px;
    }

    .timeline-note {
        background: var(--teal-50);
        border-radius: 12px;
        padding: 14px 16px;
        font-size: 14.5px;
        color: var(--ink);
    }

        .timeline-note.empty {
            color: var(--muted);
            font-style: italic;
        }

    /*================ EMPTY =================*/

    .empty-state {
        padding: 50px 20px;
        text-align: center;
    }

        .empty-state i {
            font-size: 50px;
            color: var(--teal-500);
            margin-bottom: 14px;
            opacity: .85;
        }

    /*================ BACK LINK =================*/

    .back-link {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        color: var(--teal-700);
        font-weight: 600;
        font-size: 14px;
        text-decoration: none;
        margin-bottom: 18px;
    }

        .back-link:hover {
            color: var(--teal-900);
        }

    /*================ RESPONSIVE =================*/

    @@media(max-width:768px) {

        .page-header {
            flex-direction: column;
            text-align: center;
            gap: 14px;
        }

        .summary-card {
            flex-direction: column;
            gap: 16px;
        }
    }

</style>

<div class="page-container">

    <a asp-controller="Verification" asp-action="Index" class="back-link">
        <i class="fa-solid fa-arrow-left"></i> Back to Verification Queue
    </a>

    <div class="page-header">

        <div>
            <h2>
                <i class="fa-solid fa-clock-rotate-left"></i>
                Verification History
            </h2>
            <p>Full record of review decisions and notes for TR-@test?.RequestId.</p>
        </div>

        <div class="header-icon">
            <i class="fa-solid fa-microscope"></i>
        </div>

    </div>

    <div class="summary-card">

        <div class="summary-item">
            <h6>Patient</h6>
            <div>@patient?.Name @patient?.Surname</div>
        </div>

        <div class="summary-item">
            <h6>Test</h6>
            <div>@test?.TestType?.Name</div>
        </div>

        <div class="summary-item">
            <h6>Current Status</h6>
            <div>
                @{
                    var status = test?.Status;
                    var statusBadgeClass = status == "Completed" ? "badge-completed"
                        : status == "Verified" ? "badge-verified"
                        : status == "To Be Reviewed" ? "badge-review"
                        : "badge-default";
                }
                <span class="badge-status @statusBadgeClass">@status</span>
            </div>
        </div>

        <div class="summary-item">
            <h6>Current Result</h6>
            <div>
                @(currentResult?.ResultValue ?? "-")
                @if (currentResult != null && !string.IsNullOrWhiteSpace(currentResult.Units))
                {
                    <text> @currentResult.Units</text>
                }
                @if (currentResult != null && currentResult.IsAbnormal)
                {
                    <span class="badge-status badge-abnormal ms-1">
                        <i class="fa-solid fa-triangle-exclamation"></i> Abnormal
                    </span>
                }
            </div>
        </div>

        <div class="summary-item">
            <h6>Review Rounds</h6>
            <div>@history.Count</div>
        </div>

    </div>

    <div class="timeline-card">

        <div class="timeline-header">
            <i class="fa-solid fa-list-check"></i>
            Review Timeline
        </div>

        <div class="timeline-body">

            @if (!history.Any())
            {
                <div class="empty-state">
                    <i class="fa-solid fa-hourglass-half"></i>
                    <h3>No verification decisions yet</h3>
                    <p class="text-muted">This result hasn't been reviewed by a verifier yet.</p>
                </div>
            }
            else
            {
                <div class="timeline">

                    @for (int i = 0; i < history.Count; i++)
                    {
                        var entry = history[i];
                        var wasVerified = entry.Status == "Verified";

                        <div class="timeline-entry">

                            <div class="timeline-dot @(wasVerified ? "verified" : "returned")">
                                <i class="fa-solid @(wasVerified ? "fa-check" : "fa-rotate-left")"></i>
                            </div>

                            <div class="timeline-entry-header">
                                <span class="round">Round @(i + 1)</span>
                                @if (wasVerified)
                                {
                                    <span class="badge-status badge-verified">
                                        <i class="fa-solid fa-check-double"></i> Verified
                                    </span>
                                }
                                else
                                {
                                    <span class="badge-status badge-review">
                                        <i class="fa-solid fa-rotate-left"></i> Returned For Review
                                    </span>
                                }
                            </div>

                            <div class="timeline-meta">
                                <i class="fa-solid fa-user-check"></i>
                                @entry.VerifiedByTechnician?.FullName
                                &middot;
                                @entry.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            </div>

                            @if (!string.IsNullOrWhiteSpace(entry.VerificationNotes))
                            {
                                <div class="timeline-note">@entry.VerificationNotes</div>
                            }
                            else
                            {
                                <div class="timeline-note empty">No note provided.</div>
                            }

                        </div>
                    }

                </div>
            }

        </div>

    </div>

</div>
