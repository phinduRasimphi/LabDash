@{
    ViewData["Title"] = "Password Reset Email Sent";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>

    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Password Reset Email Sent</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', sans-serif;
            }

            body {
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: #0b1f26;
            }

            .card {
                width: 480px;
                background: white;
                padding: 50px;
                border-radius: 20px;
                text-align: center;
                box-shadow: 0 20px 40px rgba(0,0,0,.3);
            }

            .icon {
                font-size: 70px;
                color: #0d766e;
                margin-bottom: 20px;
            }

            h2 {
                color: #0d766e;
                margin-bottom: 20px;
            }

            p {
                color: #555;
                line-height: 1.7;
                margin-bottom: 35px;
            }

            .btn {
                display: inline-block;
                padding: 14px 35px;
                background: #0d766e;
                color: white;
                text-decoration: none;
                border-radius: 10px;
                font-weight: 600;
                transition: .3s;
            }

                .btn:hover {
                    background: #095f59;
                }

    </style>

</head>

<body>

    <div class="card">

        <div class="icon">
            <i class="fas fa-paper-plane"></i>
        </div>

        <h2>Reset Link Sent</h2>

        <p>
            If the email address exists in our system,
            a password reset link has been sent.
        </p>

        <a asp-action="Login" class="btn">
            Return to Login
        </a>

    </div>

</body>
</html>
