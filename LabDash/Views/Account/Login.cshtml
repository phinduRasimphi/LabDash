
@model LabDash.Models.LoginModel

@{
    Layout = null;
    ViewData["Title"] = "Medical Laboratory Login";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Medical Laboratory Login</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI',sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background-image: url('https://thumbs.dreamstime.com/b/futuristic-laboratory-interior-teal-hues-modern-design-high-tech-bathed-cool-light-showcasing-equipment-sterile-environment-394211945.jpg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                overflow: hidden;
            }

                body::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0,0,0,.55);
                    backdrop-filter: blur(2px);
                }

            .login-container {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 1200px;
                display: grid;
                grid-template-columns: 1fr 450px;
                gap: 80px;
                align-items: center;
                padding: 40px;
            }

            .hero {
                color: white;
            }

                .hero h1 {
                    font-size: 65px;
                    font-weight: 700;
                    margin-bottom: 20px;
                    line-height: 1.1;
                }

                .hero p {
                    font-size: 20px;
                    line-height: 1.8;
                    max-width: 650px;
                    color: #e7f7f5;
                }

            .hero-icons {
                margin-top: 40px;
                display: flex;
                gap: 20px;
            }

                .hero-icons div {
                    width: 70px;
                    height: 70px;
                    border-radius: 20px;
                    background: rgba(255,255,255,.12);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 28px;
                    backdrop-filter: blur(10px);
                }

            .login-card {
                background: rgba(255,255,255,.12);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,.2);
                padding: 40px;
                border-radius: 30px;
                color: white;
                box-shadow: 0 25px 50px rgba(0,0,0,.35);
            }

                .login-card h2 {
                    text-align: center;
                    margin-bottom: 10px;
                    font-size: 32px;
                }

                .login-card p {
                    text-align: center;
                    margin-bottom: 30px;
                    color: #d9f4f1;
                }

            .form-group {
                margin-bottom: 20px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-weight: 500;
                }

            .form-control {
                width: 100%;
                padding: 15px;
                border: none;
                border-radius: 12px;
                outline: none;
                font-size: 15px;
            }

            /* Password field */

            .password-wrapper {
                position: relative;
                width: 100%;
            }

                .password-wrapper .form-control {
                    padding-right: 50px;
                }

            .password-toggle {
                position: absolute;
                right: 15px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #555;
                cursor: pointer;
                font-size: 17px;
                padding: 5px;
                z-index: 5;
            }

                .password-toggle:hover {
                    color: #0d766e;
                }

            .remember {
                display: flex;
                align-items: center;
                gap: 10px;
                margin-bottom: 25px;
            }

            .btn-login {
                width: 100%;
                border: none;
                border-radius: 12px;
                padding: 15px;
                background: #0d766e;
                color: white;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
            }

                .btn-login:hover {
                    background: #0a5f58;
                    transform: translateY(-2px);
                }

            .validation-summary-errors {
                color: #ffd6d6;
                margin-bottom: 15px;
            }

            @@media(max-width:900px) {

                .login-container {
                    grid-template-columns: 1fr;
                }

                .hero {
                    display: none;
                }

                .login-card {
                    max-width: 450px;
                    margin: auto;
                }
            }

    </style>
</head>

<body>

    <div class="login-container">

        <div class="hero">

            <h1>
                Medical<br />
                Laboratory System
            </h1>

            <p>
                Streamline patient management,
                laboratory testing, reporting,
                verification and healthcare workflows
                through a modern intelligent laboratory platform.
            </p>

            <div class="hero-icons">
                <div><i class="fas fa-microscope"></i></div>
                <div><i class="fas fa-vials"></i></div>
                <div><i class="fas fa-heartbeat"></i></div>
            </div>

        </div>

        <div class="login-card">

            <h2>Welcome Back</h2>

            <p>Sign in to continue</p>

            <form asp-action="Login" method="post">

                <div asp-validation-summary="All"></div>

                <div class="form-group">
                    <label>Email Address</label>

                    <input asp-for="Email"
                           class="form-control"
                           placeholder="Enter your email" />
                </div>

                <div class="form-group">

                    <label>Password</label>

                    <div class="password-wrapper">

                        <input asp-for="Password"
                               id="Password"
                               type="password"
                               class="form-control"
                               placeholder="Enter your password"
                               autocomplete="current-password" />

                        <button type="button"
                                class="password-toggle"
                                id="passwordToggle"
                                onclick="togglePassword()"
                                aria-label="Show password">

                            <i class="fas fa-eye"></i>

                        </button>

                    </div>

                </div>

                <div class="remember">
                    <input asp-for="RememberMe" />
                    <label asp-for="RememberMe">Remember Me</label>
                </div>

                <a asp-controller="Account"
                   asp-action="ForgotPassword"
                   style="color:#d9f4f1;text-decoration:none;">
                    Forgot Password?
                </a>

                <a asp-controller="Account"
                   asp-action="Register"
                   style="color:#d9f4f1;text-decoration:none;">
                    Create New Account
                </a>

                <button type="submit" class="btn-login">
                    <i class="fas fa-sign-in-alt"></i>
                    Login
                </button>

            </form>

        </div>

    </div>

    <script>

            function togglePassword() {

                const passwordInput = document.getElementById("Password");
                const toggleButton = document.getElementById("passwordToggle");
                const icon = toggleButton.querySelector("i");

                if (passwordInput.type === "password") {

                    passwordInput.type = "text";

                    icon.classList.remove("fa-eye");
                    icon.classList.add("fa-eye-slash");

                    toggleButton.setAttribute("aria-label", "Hide password");

                } else {

                    passwordInput.type = "password";

                    icon.classList.remove("fa-eye-slash");
                    icon.classList.add("fa-eye");

                    toggleButton.setAttribute("aria-label", "Show password");
                }
            }

    </script>

</body>
</html>

