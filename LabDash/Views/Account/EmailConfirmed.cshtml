@{
    Layout = null;
    ViewData["Title"] = "Email Confirmed";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Email Confirmed - Medical Laboratory</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background-image: url('https://thumbs.dreamstime.com/b/futuristic-laboratory-interior-teal-hues-modern-design-high-tech-bathed-cool-light-showcasing-equipment-sterile-environment-394211945.jpg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                overflow: hidden;
            }

                body::before {
                    content: '';
                    position: absolute;
                    inset: 0;
                    background: rgba(0,0,0,.55);
                    backdrop-filter: blur(2px);
                }

            .confirmation-card {
                position: relative;
                z-index: 2;
                background: rgba(255,255,255,.12);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,.2);
                padding: 50px 40px;
                border-radius: 30px;
                color: white;
                text-align: center;
                max-width: 480px;
                width: 90%;
                box-shadow: 0 25px 50px rgba(0,0,0,.35);
            }

            .icon-circle {
                width: 90px;
                height: 90px;
                margin: 0 auto 25px;
                border-radius: 50%;
                background: rgba(13,118,110,.35);
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 40px;
                color: #6be0d3;
            }

            .confirmation-card h2 {
                font-size: 28px;
                margin-bottom: 15px;
            }

            .confirmation-card p {
                color: #d9f4f1;
                line-height: 1.7;
                margin-bottom: 25px;
            }

            .back-link {
                display: inline-block;
                padding: 13px 30px;
                border-radius: 12px;
                background: #0d766e;
                color: white;
                text-decoration: none;
                font-weight: 600;
                transition: .3s;
            }

                .back-link:hover {
                    background: #0a5f58;
                    transform: translateY(-2px);
                }

    </style>
</head>

<body>

    <div class="confirmation-card">

        <div class="icon-circle">
            <i class="fas fa-circle-check"></i>
        </div>

        <h2>Email Confirmed!</h2>

        <p>
            Your account is now active. You can log in and start
            using the Patient Portal.
        </p>

        <a asp-controller="Account" asp-action="Login" class="back-link">
            <i class="fas fa-sign-in-alt"></i>
            Go to Login
        </a>

    </div>

</body>
</html>