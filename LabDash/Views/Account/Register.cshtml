@model LabDash.Models.PatientRegisterViewModel

@{
    Layout = null;
    ViewData["Title"] = "Patient Registration";
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>Create Account - Medical Laboratory</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.css">

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI', sans-serif;
            }

            body {
                min-height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background-image: url('https://thumbs.dreamstime.com/b/futuristic-laboratory-interior-teal-hues-modern-design-high-tech-bathed-cool-light-showcasing-equipment-sterile-environment-394211945.jpg');
                background-size: cover;
                background-position: center;
                background-repeat: no-repeat;
                overflow-x: hidden;
                padding: 40px 0;
            }

                body::before {
                    content: '';
                    position: fixed;
                    inset: 0;
                    background: rgba(0,0,0,.55);
                    backdrop-filter: blur(2px);
                }

            .register-container {
                position: relative;
                z-index: 2;
                width: 100%;
                max-width: 1200px;
                display: grid;
                grid-template-columns: 1fr 500px;
                gap: 80px;
                align-items: center;
                padding: 40px;
            }

            .hero {
                color: white;
            }

                .hero h1 {
                    font-size: 55px;
                    font-weight: 700;
                    margin-bottom: 20px;
                    line-height: 1.1;
                }

                .hero p {
                    font-size: 20px;
                    line-height: 1.8;
                    max-width: 650px;
                    color: #e7f7f5;
                }

            .hero-icons {
                margin-top: 40px;
                display: flex;
                gap: 20px;
            }

                .hero-icons div {
                    width: 70px;
                    height: 70px;
                    border-radius: 20px;
                    background: rgba(255,255,255,.12);
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    font-size: 28px;
                    backdrop-filter: blur(10px);
                }

            .register-card {
                background: rgba(255,255,255,.12);
                backdrop-filter: blur(20px);
                border: 1px solid rgba(255,255,255,.2);
                padding: 40px;
                border-radius: 30px;
                color: white;
                box-shadow: 0 25px 50px rgba(0,0,0,.35);
                max-height: 90vh;
                overflow-y: auto;
            }

                .register-card::-webkit-scrollbar {
                    width: 7px;
                }

                .register-card::-webkit-scrollbar-thumb {
                    background: rgba(255,255,255,.3);
                    border-radius: 10px;
                }

                .register-card h2 {
                    text-align: center;
                    margin-bottom: 10px;
                    font-size: 28px;
                }

            .subtitle {
                text-align: center;
                margin-bottom: 25px;
                color: #d9f4f1;
            }

            .section-title {
                display: flex;
                align-items: center;
                gap: 10px;
                margin: 28px 0 15px;
                padding-bottom: 9px;
                border-bottom: 1px solid rgba(255,255,255,.2);
                font-size: 17px;
                font-weight: 700;
                color: #ffffff;
            }

                .section-title i {
                    color: #76e0d4;
                }

            .section-help {
                font-size: 12px;
                color: #d9f4f1;
                margin-top: -7px;
                margin-bottom: 15px;
                line-height: 1.5;
            }

            .form-row {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 15px;
            }

            .form-group {
                margin-bottom: 18px;
            }

                .form-group label {
                    display: block;
                    margin-bottom: 8px;
                    font-weight: 500;
                    font-size: 14px;
                }

            .form-control {
                width: 100%;
                padding: 13px;
                border: none;
                border-radius: 12px;
                outline: none;
                font-size: 15px;
                background: rgba(255,255,255,.95);
                color: #222;
            }

                .form-control:focus {
                    box-shadow: 0 0 0 3px rgba(118,224,212,.35);
                }

            textarea.form-control {
                min-height: 80px;
                resize: vertical;
            }

            .validation-message,
            .field-validation-error {
                display: block;
                color: #ffd1d1;
                font-size: 12px;
                margin-top: 6px;
                line-height: 1.4;
            }

            .validation-summary-errors {
                color: #ffd6d6;
                background: rgba(160,0,0,.18);
                border: 1px solid rgba(255,150,150,.25);
                border-radius: 12px;
                padding: 12px 15px;
                margin-bottom: 18px;
                font-size: 13px;
            }

            .validation-summary-valid {
                display: none;
            }

            .medical-box {
                background: rgba(0,0,0,.14);
                border: 1px solid rgba(255,255,255,.12);
                border-radius: 16px;
                padding: 15px;
                margin-bottom: 16px;
            }

            .medical-box-title {
                font-size: 14px;
                font-weight: 600;
                margin-bottom: 10px;
            }

            .medical-select {
                min-height: 110px;
            }

                .medical-select option {
                    padding: 8px;
                }

            .password-wrapper {
                position: relative;
            }

                .password-wrapper .form-control {
                    padding-right: 45px;
                }

            .password-toggle {
                position: absolute;
                right: 12px;
                top: 50%;
                transform: translateY(-50%);
                border: none;
                background: transparent;
                color: #555;
                cursor: pointer;
                font-size: 16px;
                padding: 5px;
            }

                .password-toggle:hover {
                    color: #0d766e;
                }

            .password-help {
                font-size: 11px;
                color: #d9f4f1;
                margin-top: 7px;
                line-height: 1.5;
            }

            .btn-register {
                width: 100%;
                border: none;
                border-radius: 12px;
                padding: 15px;
                background: #0d766e;
                color: white;
                font-size: 16px;
                font-weight: 600;
                cursor: pointer;
                transition: .3s;
                margin-top: 10px;
            }

                .btn-register:hover {
                    background: #0a5f58;
                    transform: translateY(-2px);
                }

            .back-link {
                display: block;
                text-align: center;
                margin-top: 20px;
                color: #d9f4f1;
                text-decoration: none;
            }

                .back-link:hover {
                    color: white;
                }

            .required-star {
                color: #ffbaba;
            }

            /* ===== ADD YOUR OWN (conditions / allergies / medication) ===== */

            .add-entry {
                margin-top: 14px;
                padding-top: 14px;
                border-top: 1px dashed rgba(255,255,255,.25);
            }

            .add-head strong {
                display: block;
                margin-bottom: 3px;
                font-size: 13px;
                color: #fff;
            }

            .add-head span {
                display: block;
                font-size: 11.5px;
                line-height: 1.5;
                color: #d9f4f1;
            }

            .add-row {
                position: relative;
                margin-top: 12px;
                padding: 14px;
                background: rgba(255,255,255,.1);
                border: 1px solid rgba(255,255,255,.2);
                border-radius: 14px;
            }

            .add-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 10px;
            }

                .add-grid .full {
                    grid-column: 1 / -1;
                }

            .add-row label {
                display: block;
                margin-bottom: 5px;
                font-size: 11.5px;
                font-weight: 600;
                color: #e7f7f5;
            }

            .add-row input,
            .add-row select,
            .add-row textarea {
                width: 100%;
                padding: 10px 12px;
                border: none;
                border-radius: 10px;
                outline: none;
                background: rgba(255,255,255,.95);
                color: #222;
                font-size: 13px;
            }

                .add-row input:focus,
                .add-row select:focus,
                .add-row textarea:focus {
                    box-shadow: 0 0 0 3px rgba(118,224,212,.35);
                }

            .add-opt {
                font-weight: 400;
                color: #b9dcd8;
            }

            .add-remove {
                position: absolute;
                top: 8px;
                right: 8px;
                width: 28px;
                height: 28px;
                border: none;
                border-radius: 8px;
                background: rgba(255,255,255,.95);
                color: #B0463F;
                cursor: pointer;
            }

            .add-btn {
                margin-top: 12px;
                padding: 9px 16px;
                border: 1px solid rgba(255,255,255,.3);
                border-radius: 999px;
                background: rgba(255,255,255,.14);
                color: #fff;
                font-size: 12.5px;
                font-weight: 700;
                cursor: pointer;
                transition: background .2s;
            }

                .add-btn:hover {
                    background: rgba(255,255,255,.26);
                }

            @@media(max-width:900px) {

                .register-container {
                    grid-template-columns: 1fr;
                    padding: 20px;
                }

                .hero {
                    display: none;
                }

                .register-card {
                    max-width: 600px;
                    width: 100%;
                    margin: auto;
                }

                .form-row {
                    grid-template-columns: 1fr;
                }

                .add-grid {
                    grid-template-columns: 1fr;
                }
            }

    </style>
</head>

<body>

    <div class="register-container">

        <!-- LEFT SIDE -->
        <div class="hero">

            <h1>
                Join the<br />
                Patient Portal
            </h1>

            <p>
                Create your account to securely view test results,
                track your health history, and manage your
                details with your care team.
            </p>

            <div class="hero-icons">
                <div><i class="fas fa-user-plus"></i></div>
                <div><i class="fas fa-file-medical"></i></div>
                <div><i class="fas fa-shield-heart"></i></div>
            </div>

        </div>


        <!-- REGISTRATION CARD -->
        <div class="register-card">

            <h2>Create New Account</h2>

            <p class="subtitle">Patient registration</p>

            <form asp-controller="Account"
                  asp-action="Register"
                  method="post"
                  novalidate>

                @Html.AntiForgeryToken()

                <div asp-validation-summary="All"></div>


                <!-- PERSONAL DETAILS -->
                <div class="section-title">
                    <i class="fas fa-user"></i>
                    Personal Details
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Name">First Name <span class="required-star">*</span></label>
                        <input asp-for="Name" class="form-control" placeholder="First name" autocomplete="given-name" />
                        <span asp-validation-for="Name" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="Surname">Surname <span class="required-star">*</span></label>
                        <input asp-for="Surname" class="form-control" placeholder="Surname" autocomplete="family-name" />
                        <span asp-validation-for="Surname" class="field-validation-error"></span>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="IDNumber">SA ID Number <span class="required-star">*</span></label>
                        <input asp-for="IDNumber" id="idNumber" class="form-control"
                               placeholder="13-digit ID number" inputmode="numeric" maxlength="13" autocomplete="off" />
                        <span asp-validation-for="IDNumber" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="DOB">Date of Birth <span class="required-star">*</span></label>
                        <input asp-for="DOB" id="dobPicker" class="form-control"
                               placeholder="Select date" autocomplete="off" />
                        <span asp-validation-for="DOB" class="field-validation-error"></span>
                    </div>

                </div>

                <div class="form-group">
                    <label asp-for="CellphoneNumber">Cellphone Number <span class="required-star">*</span></label>
                    <input asp-for="CellphoneNumber" id="cellphone" class="form-control"
                           placeholder="0821234567" inputmode="numeric" maxlength="10" autocomplete="tel" />
                    <span asp-validation-for="CellphoneNumber" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="Email">Gmail Address <span class="required-star">*</span></label>
                    <input asp-for="Email" class="form-control" placeholder="example@gmail.com" autocomplete="email" />
                    <span asp-validation-for="Email" class="field-validation-error"></span>
                </div>


                <!-- ADDRESS -->
                <div class="section-title">
                    <i class="fas fa-location-dot"></i>
                    Address
                </div>

                <div class="form-group">
                    <label asp-for="AddressLine1">Address Line 1 <span class="required-star">*</span></label>
                    <input asp-for="AddressLine1" class="form-control"
                           placeholder="House number and street name" autocomplete="address-line1" />
                    <span asp-validation-for="AddressLine1" class="field-validation-error"></span>
                </div>

                <div class="form-group">
                    <label asp-for="AddressLine2">Address Line 2</label>
                    <input asp-for="AddressLine2" class="form-control"
                           placeholder="Apartment, complex, unit, etc." autocomplete="address-line2" />
                    <span asp-validation-for="AddressLine2" class="field-validation-error"></span>
                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Suburb">Suburb <span class="required-star">*</span></label>
                        <input asp-for="Suburb" class="form-control" placeholder="Suburb" autocomplete="address-level3" />
                        <span asp-validation-for="Suburb" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="City">City <span class="required-star">*</span></label>
                        <input asp-for="City" class="form-control" placeholder="City" autocomplete="address-level2" />
                        <span asp-validation-for="City" class="field-validation-error"></span>
                    </div>

                </div>

                <div class="form-row">

                    <div class="form-group">
                        <label asp-for="Province">Province <span class="required-star">*</span></label>
                        <input asp-for="Province" class="form-control" placeholder="Province" autocomplete="address-level1" />
                        <span asp-validation-for="Province" class="field-validation-error"></span>
                    </div>

                    <div class="form-group">
                        <label asp-for="PostalCode">Postal Code</label>
                        <input asp-for="PostalCode" id="postalCode" class="form-control"
                               placeholder="e.g. 6001" inputmode="numeric" maxlength="4" autocomplete="postal-code" />
                        <span asp-validation-for="PostalCode" class="field-validation-error"></span>
                    </div>

                </div>


                <!-- HEALTH INFORMATION -->
                <div class="section-title">
                    <i class="fas fa-heart-pulse"></i>
                    Health Information
                </div>

                <p class="section-help">
                    Select any known conditions, allergies or current medications.
                    If something is not listed, add it below. Only the name is needed,
                    and your clinician can complete the rest at your next visit.
                    You may leave these empty if they do not apply.
                </p>


                <!-- MEDICAL CONDITIONS -->
                <div class="medical-box">

                    <div class="medical-box-title">
                        <i class="fas fa-notes-medical"></i>
                        Medical Conditions
                    </div>

                    <select asp-for="SelectedMedicalConditionIds"
                            asp-items="Model.MedicalConditionOptions"
                            class="form-control medical-select"
                            multiple>
                    </select>

                    <span asp-validation-for="SelectedMedicalConditionIds" class="field-validation-error"></span>

                    <div class="add-entry">
                        <div class="add-head">
                            <strong>Not in the list? Add your own condition</strong>
                            <span>Only the name is needed.</span>
                        </div>
                        <div data-add-list="medical"></div>
                        <button type="button" class="add-btn" data-add-btn="medical">
                            <i class="fa-solid fa-plus"></i> Add condition
                        </button>
                    </div>

                </div>


                <!-- ALLERGIES -->
                <div class="medical-box">

                    <div class="medical-box-title">
                        <i class="fas fa-triangle-exclamation"></i>
                        Allergies
                    </div>

                    <select asp-for="SelectedAllergyIds"
                            asp-items="Model.AllergyOptions"
                            class="form-control medical-select"
                            multiple>
                    </select>

                    <span asp-validation-for="SelectedAllergyIds" class="field-validation-error"></span>

                    <div class="add-entry">
                        <div class="add-head">
                            <strong>Not in the list? Add your own allergy</strong>
                            <span>Only the name is needed.</span>
                        </div>
                        <div data-add-list="allergy"></div>
                        <button type="button" class="add-btn" data-add-btn="allergy">
                            <i class="fa-solid fa-plus"></i> Add allergy
                        </button>
                    </div>

                </div>


                <!-- MEDICATIONS -->
                <div class="medical-box">

                    <div class="medical-box-title">
                        <i class="fas fa-pills"></i>
                        Current Medications
                    </div>

                    <select asp-for="SelectedMedicationIds"
                            asp-items="Model.MedicationOptions"
                            class="form-control medical-select"
                            multiple>
                    </select>

                    <span asp-validation-for="SelectedMedicationIds" class="field-validation-error"></span>

                    <div class="add-entry">
                        <div class="add-head">
                            <strong>Not in the list? Add your own medication</strong>
                            <span>Only the name is needed.</span>
                        </div>
                        <div data-add-list="medication"></div>
                        <button type="button" class="add-btn" data-add-btn="medication">
                            <i class="fa-solid fa-plus"></i> Add medication
                        </button>
                    </div>

                </div>


                <!-- ACCOUNT SECURITY -->
                <div class="section-title">
                    <i class="fas fa-lock"></i>
                    Account Security
                </div>

                <div class="form-row">

                    <div class="form-group">

                        <label asp-for="Password">Password <span class="required-star">*</span></label>

                        <div class="password-wrapper">
                            <input asp-for="Password" id="password" type="password" class="form-control"
                                   placeholder="Create a password" autocomplete="new-password" />
                            <button type="button" class="password-toggle" data-target="password" aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="Password" class="field-validation-error"></span>

                        <div class="password-help">
                            Minimum 8 characters, including one uppercase letter,
                            one number and one special character.
                        </div>

                    </div>

                    <div class="form-group">

                        <label asp-for="ConfirmPassword">Confirm Password</label>

                        <div class="password-wrapper">
                            <input asp-for="ConfirmPassword" id="confirmPassword" type="password" class="form-control"
                                   placeholder="Re-enter password" autocomplete="new-password" />
                            <button type="button" class="password-toggle" data-target="confirmPassword" aria-label="Show password">
                                <i class="fas fa-eye"></i>
                            </button>
                        </div>

                        <span asp-validation-for="ConfirmPassword" class="field-validation-error"></span>

                    </div>

                </div>

                <button type="submit" class="btn-register">
                    <i class="fas fa-user-plus"></i>
                    Create Account
                </button>

            </form>

            <a asp-controller="Account" asp-action="Login" class="back-link">
                Already have an account? Log in
            </a>

        </div>

    </div>


    <script src="https://cdnjs.cloudflare.com/ajax/libs/flatpickr/4.6.13/flatpickr.min.js"></script>

    <script>

            flatpickr('#dobPicker', {
                dateFormat: 'Y-m-d',
                maxDate: 'today',
                minDate: '1930-01-01',
                allowInput: true,
                disableMobile: true
            });

            function digitsOnly(id, max) {
                const el = document.getElementById(id);
                if (!el) return;
                el.addEventListener('input', function() {
                    this.value = this.value.replace(/\D/g, '').substring(0, max);
                });
            }

            digitsOnly('idNumber', 13);
            digitsOnly('cellphone', 10);
            digitsOnly('postalCode', 4);

            document.querySelectorAll('.password-toggle').forEach(function(button) {
                button.addEventListener('click', function() {
                    const input = document.getElementById(this.getAttribute('data-target'));
                    const icon = this.querySelector('i');
                    if (!input) return;

                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    icon.classList.toggle('fa-eye', !show);
                    icon.classList.toggle('fa-eye-slash', show);
                    this.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                });
            });


            /* =====================================================
               ADD-YOUR-OWN ENTRIES (same fields as the Profile page)
               ===================================================== */

            const categoryData = {
                medication: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.MedicationCategories ?? Array.Empty<object>())),
                allergy:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.AllergyCategories ?? Array.Empty<object>())),
                medical:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.ConditionCategories ?? Array.Empty<object>()))
                    };

            // Entries the patient already typed (shown again if the form failed validation)
            const savedEntries = {
                medication: @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.NewMedications ?? Array.Empty<object>())),
                allergy:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.NewAllergies ?? Array.Empty<object>())),
                medical:    @Html.Raw(System.Text.Json.JsonSerializer.Serialize((object?)Model.NewConditions ?? Array.Empty<object>()))
                    };

            const addConfig = {
                medication: {
                    prop: 'NewMedications', nameLabel: 'Medication name', dateLabel: 'Started taking',
                    hasEnd: true, hasDose: true, hasSeverity: false
                },
                allergy: {
                    prop: 'NewAllergies', nameLabel: 'Allergy name', dateLabel: 'When it was noticed',
                    hasEnd: false, hasDose: false, hasSeverity: true
                },
                medical: {
                    prop: 'NewConditions', nameLabel: 'Condition name', dateLabel: 'Diagnosed',
                    hasEnd: false, hasDose: false, hasSeverity: true
                }
            };

            function esc(value) {
                return String(value == null ? '' : value).replace(/[&<>"']/g, function(c) {
                    return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c];
                });
            }

            // ASP.NET list binding needs 0,1,2... with no gaps
            function reindex(group) {
                const cfg = addConfig[group];
                document.querySelectorAll('[data-add-list="' + group + '"] .add-row').forEach(function(row, i) {
                    row.querySelectorAll('[data-field]').forEach(function(el) {
                        el.name = cfg.prop + '[' + i + '].' + el.dataset.field;
                    });
                });
            }

            function addRow(group, data) {

                const cfg = addConfig[group];
                const list = document.querySelector('[data-add-list="' + group + '"]');
                if (!list) return;

                const opt = '<span class="add-opt">(optional)</span>';

                const cats = (categoryData[group] || []).map(function(c) {
                    return '<option value="' + c.Id + '">' + esc(c.Name) + '</option>';
                }).join('');

                const row = document.createElement('div');
                row.className = 'add-row';

                row.innerHTML =
                    '<button type="button" class="add-remove" title="Remove"><i class="fa-solid fa-xmark"></i></button>' +
                    '<div class="add-grid">' +

                    '<div class="full"><label>' + cfg.nameLabel + ' *</label>' +
                    '<input type="text" data-field="Name" maxlength="100" placeholder="Type the name as you know it" /></div>' +

                    '<div><label>Category ' + opt + '</label>' +
                    '<select data-field="CategoryId" class="cat-select">' +
                    '<option value="">I\'m not sure</option>' + cats +
                    '<option value="new">+ New category...</option>' +
                    '</select></div>' +

                    '<div class="new-cat" style="display:none"><label>New category name</label>' +
                    '<input type="text" data-field="NewCategoryName" maxlength="100" /></div>' +

                    (cfg.hasDose ?
                        '<div><label>Dosage ' + opt + '</label>' +
                        '<input type="text" data-field="Dosage" maxlength="100" placeholder="e.g. 500 mg, or leave blank" /></div>' +
                        '<div><label>How often ' + opt + '</label>' +
                        '<input type="text" data-field="Frequency" maxlength="100" placeholder="e.g. Twice daily, or leave blank" /></div>'
                        : '') +

                    (cfg.hasSeverity ?
                        '<div><label>Severity ' + opt + '</label>' +
                        '<select data-field="Severity"><option value="">I\'m not sure</option>' +
                        '<option>Mild</option><option>Moderate</option><option>Severe</option></select></div>'
                        : '') +

                    '<div><label>' + cfg.dateLabel + ' ' + opt + '</label>' +
                    '<input type="month" data-field="StartDate" /></div>' +

                    (cfg.hasEnd ?
                        '<div><label>Stopped ' + opt + '</label>' +
                        '<input type="month" data-field="EndDate" /></div>'
                        : '') +

                    '<div class="full"><label>Notes ' + opt + '</label>' +
                    '<textarea data-field="Notes" rows="2" maxlength="500" ' +
                    'placeholder="Anything you remember, such as why or who prescribed it"></textarea></div>' +

                    '</div>';

                const catSelect = row.querySelector('.cat-select');
                const newCat = row.querySelector('.new-cat');

                row.querySelector('.add-remove').addEventListener('click', function() {
                    row.remove();
                    reindex(group);
                });

                catSelect.addEventListener('change', function() {
                    newCat.style.display = this.value === 'new' ? 'block' : 'none';
                });

                // refill values (used when the form comes back after a validation error)
                if (data) {
                    row.querySelectorAll('[data-field]').forEach(function(el) {
                        const v = data[el.dataset.field];
                        if (v !== null && v !== undefined && el.dataset.field !== 'CategoryId') el.value = v;
                    });
                    if (data.CategoryId) {
                        catSelect.value = String(data.CategoryId);
                    } else if (data.NewCategoryName) {
                        catSelect.value = 'new';
                        newCat.style.display = 'block';
                    }
                }

                list.appendChild(row);
                reindex(group);

                if (!data) row.querySelector('[data-field="Name"]').focus();
            }

            document.querySelectorAll('[data-add-btn]').forEach(function(btn) {
                btn.addEventListener('click', function() { addRow(this.dataset.addBtn); });
            });

            Object.keys(savedEntries).forEach(function(group) {
                (savedEntries[group] || []).forEach(function(entry) { addRow(group, entry); });
            });

            // "new" is not a real category id, so don't post it
            const regForm = document.querySelector("form[method='post']");
            if (regForm) {
                regForm.addEventListener('submit', function() {
                    document.querySelectorAll('.cat-select').forEach(function(sel) {
                        if (sel.value === 'new') sel.removeAttribute('name');
                    });
                });
            }

    </script>

    <partial name="_ValidationScriptsPartial" />

</body>
</html>
