@model LabDash.Models.ChangePasswordModel

@using LabDash.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity

@inject UserManager<LabUser> UserManager

@{
    Layout = null;
    ViewData["Title"] = "Change Password";

    var currentUser = await UserManager.GetUserAsync(User);

    var isAdmin = currentUser != null &&
                  await UserManager.IsInRoleAsync(currentUser, "Admin");

    var isPatient = currentUser != null &&
                    await UserManager.IsInRoleAsync(currentUser, "Patient");

    var isDoctor = currentUser != null &&
                   await UserManager.IsInRoleAsync(currentUser, "Doctor");

    var isLabTechnician = currentUser != null &&
                          await UserManager.IsInRoleAsync(currentUser, "Lab_Technician");

    var isLabManager = currentUser != null &&
                       await UserManager.IsInRoleAsync(currentUser, "Lab_Manager");
}

<!DOCTYPE html>
<html lang="en">

<head>

    <meta charset="utf-8" />

    <meta name="viewport"
          content="width=device-width, initial-scale=1" />

    <title>Change Password - LabDash</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', sans-serif;
        }

        body {
            min-height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background-image: url('https://thumbs.dreamstime.com/b/futuristic-laboratory-interior-teal-hues-modern-design-high-tech-bathed-cool-light-showcasing-equipment-sterile-environment-394211945.jpg');
            background-size: cover;
            background-position: center;
            background-repeat: no-repeat;
            padding: 30px;
        }

            body::before {
                content: '';
                position: fixed;
                inset: 0;
                background: rgba(0, 0, 0, .55);
                backdrop-filter: blur(2px);
                z-index: 0;
            }

        .password-container {
            position: relative;
            z-index: 2;
            width: 100%;
            max-width: 500px;
            background: rgba(255, 255, 255, .12);
            backdrop-filter: blur(20px);
            border: 1px solid rgba(255, 255, 255, .2);
            padding: 40px;
            border-radius: 30px;
            color: white;
            box-shadow: 0 25px 50px rgba(0, 0, 0, .35);
        }

        .icon-container {
            width: 70px;
            height: 70px;
            margin: 0 auto 20px;
            border-radius: 20px;
            background: rgba(13, 118, 110, .8);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        h1 {
            text-align: center;
            font-size: 32px;
            margin-bottom: 10px;
        }

        .subtitle {
            text-align: center;
            color: #d9f4f1;
            margin-bottom: 30px;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 22px;
        }

            .form-group label {
                display: block;
                margin-bottom: 8px;
                font-weight: 500;
            }

        .password-wrapper {
            position: relative;
            width: 100%;
        }

        .form-control {
            width: 100%;
            padding: 15px 50px 15px 15px;
            border: none;
            border-radius: 12px;
            outline: none;
            font-size: 15px;
            background: white;
            color: #222;
        }

            .form-control:focus {
                box-shadow: 0 0 0 3px rgba(13, 118, 110, .35);
            }

        .password-toggle {
            position: absolute;
            right: 12px;
            top: 50%;
            transform: translateY(-50%);
            border: none;
            background: transparent;
            color: #555;
            cursor: pointer;
            font-size: 17px;
            padding: 7px;
            z-index: 5;
        }

            .password-toggle:hover {
                color: #0d766e;
            }

        .validation-summary-errors {
            background: rgba(255, 80, 80, .15);
            border: 1px solid rgba(255, 150, 150, .3);
            border-radius: 10px;
            padding: 12px;
            margin-bottom: 20px;
            color: #ffd6d6;
        }

        .validation-summary-valid {
            display: none;
        }

        .field-validation-error {
            display: block;
            margin-top: 6px;
            color: #ffd6d6;
            font-size: 13px;
        }

        .btn-change {
            width: 100%;
            border: none;
            border-radius: 12px;
            padding: 15px;
            background: #0d766e;
            color: white;
            font-size: 16px;
            font-weight: 600;
            cursor: pointer;
            transition: .3s;
            margin-top: 5px;
        }

            .btn-change:hover {
                background: #0a5f58;
                transform: translateY(-2px);
            }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            color: #d9f4f1;
            text-decoration: none;
            font-size: 14px;
        }

            .back-link:hover {
                text-decoration: underline;
            }

        /* ===== PASSWORD STRENGTH, RULES AND MATCH ===== */

        .pw-strength {
            display: flex;
            gap: 6px;
            margin-top: 10px;
        }

            .pw-strength span {
                flex: 1;
                height: 6px;
                border-radius: 99px;
                background: rgba(255,255,255,.2);
                transition: background .25s;
            }

            .pw-strength[data-level="1"] span:nth-child(-n+1) { background: #ff7b7b; }
            .pw-strength[data-level="2"] span:nth-child(-n+2) { background: #ffb347; }
            .pw-strength[data-level="3"] span:nth-child(-n+3) { background: #f4e06d; }
            .pw-strength[data-level="4"] span:nth-child(-n+4) { background: #76e0d4; }

        .pw-strength-label,
        .pw-match-label {
            margin-top: 7px;
            font-size: 12.5px;
            color: #d9f4f1;
            min-height: 16px;
        }

            .pw-match-label.ok  { color: #76e0d4; }
            .pw-match-label.bad { color: #ffd1d1; }

        .pw-rules {
            list-style: none;
            margin: 12px 0 0;
            padding: 14px 16px;
            background: rgba(0,0,0,.14);
            border: 1px solid rgba(255,255,255,.12);
            border-radius: 12px;
        }

            .pw-rules li {
                display: flex;
                align-items: center;
                gap: 9px;
                font-size: 13px;
                color: #d9f4f1;
                padding: 3px 0;
                transition: color .2s;
            }

                .pw-rules li i {
                    width: 12px;
                    text-align: center;
                    font-size: 7px;
                    opacity: .6;
                }

                .pw-rules li.met {
                    color: #76e0d4;
                }

                    .pw-rules li.met i {
                        font-size: 12px;
                        opacity: 1;
                    }

    </style>

</head>

<body>

    <div class="password-container">

        <div class="icon-container">
            <i class="fas fa-lock"></i>
        </div>

        <h1>Change Password</h1>

        <p class="subtitle">
            Update your LabDash account password securely.
        </p>

        <form asp-controller="Account"
              asp-action="ChangePassword"
              method="post">

            @Html.AntiForgeryToken()

            <div asp-validation-summary="All"
                 class="validation-summary-errors">
            </div>

            <!-- CURRENT PASSWORD -->

            <div class="form-group">

                <label asp-for="CurrentPassword">
                    Current Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="CurrentPassword"
                           id="CurrentPassword"
                           type="password"
                           class="form-control"
                           placeholder="Enter your current password"
                           autocomplete="current-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('CurrentPassword', this)"
                            aria-label="Show current password">

                        <i class="fas fa-eye"></i>

                    </button>

                </div>

                <span asp-validation-for="CurrentPassword"
                      class="field-validation-error">
                </span>

            </div>

            <!-- NEW PASSWORD -->

            <div class="form-group">

                <label asp-for="NewPassword">
                    New Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="NewPassword"
                           id="NewPassword"
                           type="password"
                           class="form-control"
                           placeholder="Enter your new password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('NewPassword', this)"
                            aria-label="Show new password">

                        <i class="fas fa-eye"></i>

                    </button>

                </div>

                <div class="pw-strength" id="pwStrengthBars" data-level="0" aria-hidden="true">
                    <span></span><span></span><span></span><span></span>
                </div>
                <div class="pw-strength-label" id="pwStrengthLabel">Enter a password to see its strength</div>

                <ul class="pw-rules" id="pwRules">
                    <li data-rule="len"><i class="fas fa-circle"></i> At least 8 characters</li>
                    <li data-rule="upper"><i class="fas fa-circle"></i> One uppercase letter</li>
                    <li data-rule="lower"><i class="fas fa-circle"></i> One lowercase letter</li>
                    <li data-rule="num"><i class="fas fa-circle"></i> One number</li>
                    <li data-rule="sym"><i class="fas fa-circle"></i> One special character</li>
                </ul>

                <span asp-validation-for="NewPassword"
                      class="field-validation-error">
                </span>

            </div>

            <!-- CONFIRM PASSWORD -->

            <div class="form-group">

                <label asp-for="ConfirmPassword">
                    Confirm New Password
                </label>

                <div class="password-wrapper">

                    <input asp-for="ConfirmPassword"
                           id="ConfirmPassword"
                           type="password"
                           class="form-control"
                           placeholder="Confirm your new password"
                           autocomplete="new-password" />

                    <button type="button"
                            class="password-toggle"
                            onclick="togglePassword('ConfirmPassword', this)"
                            aria-label="Show confirmed password">

                        <i class="fas fa-eye"></i>

                    </button>

                </div>

                <div class="pw-match-label" id="pwMatchLabel"></div>

                <span asp-validation-for="ConfirmPassword"
                      class="field-validation-error">
                </span>

            </div>

            <button type="submit"
                    class="btn-change">

                <i class="fas fa-key"></i>

                Change Password

            </button>

        </form>

        <!-- =======================================================
             ROLE-AWARE BACK BUTTON
             ======================================================= -->
        @if (isAdmin)
        {
            <a asp-controller="Admin"
               asp-action="AdminProfile"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back to Profile

            </a>
        }
        else if (isPatient)
        {
            <a asp-controller="Patient"
               asp-action="Profile"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back to Profile

            </a>
        }
        else if (isDoctor)
        {
            <a asp-controller="DoctorHome"
               asp-action="Index"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back to Profile

            </a>
        }
        else if (isLabTechnician)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back to Dashboard

            </a>
        }
        else if (isLabManager)
        {
            <a asp-controller="Dashboard"
               asp-action="Index"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back to Dashboard

            </a>
        }
        else
        {
            <a asp-controller="Home"
               asp-action="Index"
               class="back-link">

                <i class="fas fa-arrow-left"></i>
                Back

            </a>
        }

    </div>

    <script>

        function togglePassword(inputId, button) {

            const passwordInput = document.getElementById(inputId);
            const icon = button.querySelector("i");

            if (passwordInput.type === "password") {
                passwordInput.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
                button.setAttribute("aria-label", "Hide password");
            }
            else {
                passwordInput.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
                button.setAttribute("aria-label", "Show password");
            }
        }

        /* =====================================================
           PASSWORD STRENGTH, RULES CHECKLIST, MATCH LABEL
           ===================================================== */
        (function () {

            var newPw = document.getElementById('NewPassword');
            var confirmPw = document.getElementById('ConfirmPassword');
            var bars = document.getElementById('pwStrengthBars');
            var strengthLabel = document.getElementById('pwStrengthLabel');
            var matchLabel = document.getElementById('pwMatchLabel');
            var rules = document.querySelectorAll('#pwRules li');

            var tests = {
                len:   function (v) { return v.length >= 8; },
                upper: function (v) { return /[A-Z]/.test(v); },
                lower: function (v) { return /[a-z]/.test(v); },
                num:   function (v) { return /\d/.test(v); },
                sym:   function (v) { return /[^A-Za-z0-9]/.test(v); }
            };

            var names = ['', 'Weak', 'Fair', 'Good', 'Strong'];

            function updateStrength() {

                var v = newPw.value;
                var met = 0;

                rules.forEach(function (li) {
                    var ok = tests[li.dataset.rule](v);
                    li.classList.toggle('met', ok);
                    li.querySelector('i').className = ok ? 'fas fa-check-circle' : 'fas fa-circle';
                    if (ok) met++;
                });

                var level = 0;
                if (v) {
                    if (met <= 2) level = 1;
                    else if (met === 3) level = 2;
                    else if (met === 4) level = 3;
                    else level = 4;
                }

                bars.setAttribute('data-level', level);

                strengthLabel.textContent = v
                    ? 'Strength: ' + names[level]
                    : 'Enter a password to see its strength';

                updateMatch();
            }

            function updateMatch() {

                if (!confirmPw.value) {
                    matchLabel.textContent = '';
                    matchLabel.className = 'pw-match-label';
                    return;
                }

                var same = confirmPw.value === newPw.value;
                matchLabel.textContent = same ? 'Passwords match' : 'Passwords do not match yet';
                matchLabel.className = 'pw-match-label ' + (same ? 'ok' : 'bad');
            }

            newPw.addEventListener('input', updateStrength);
            confirmPw.addEventListener('input', updateMatch);
            updateStrength();

        })();

    </script>

</body>

</html>