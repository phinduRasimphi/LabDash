@{
    ViewData["Title"] = "Password Reset Successful";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>

    <meta charset="utf-8" />

    <title>Password Reset Successful</title>

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI';
            }

            body {
                display: flex;
                justify-content: center;
                align-items: center;
                height: 100vh;
                background: #0b1f26;
            }

            .card {
                width: 500px;
                background: white;
                padding: 50px;
                border-radius: 20px;
                text-align: center;
                box-shadow: 0 20px 40px rgba(0,0,0,.3);
            }

            .icon {
                font-size: 70px;
                color: #0d766e;
                margin-bottom: 20px;
            }

            h2 {
                margin-bottom: 20px;
                color: #0d766e;
            }

            p {
                color: #555;
                margin-bottom: 35px;
                line-height: 1.7;
            }

            .btn {
                display: inline-block;
                padding: 14px 35px;
                background: #0d766e;
                color: white;
                text-decoration: none;
                border-radius: 10px;
            }

                .btn:hover {
                    background: #095f59;
                }

    </style>

</head>

<body>

    <div class="card">

        <div class="icon">
            ✔
        </div>

        <h2>Password Reset Successful</h2>

        <p>

            Your password has been successfully changed.

            You can now log in using your new password.

        </p>

        <a asp-action="Login" class="btn">
            Return to Login
        </a>

    </div>

</body>

</html>