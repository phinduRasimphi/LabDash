@model LabDash.Models.ForgotPasswordModel

@{
    ViewData["Title"] = "Forgot Password";
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Forgot Password</title>

    <link rel="stylesheet"
          href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" />

    <style>

            * {
                margin: 0;
                padding: 0;
                box-sizing: border-box;
                font-family: 'Segoe UI',sans-serif;
            }

            body {
                height: 100vh;
                display: flex;
                justify-content: center;
                align-items: center;
                background: #0b1f26;
            }

            .card {
                width: 420px;
                background: white;
                border-radius: 20px;
                padding: 40px;
                box-shadow: 0 20px 45px rgba(0,0,0,.3);
            }

            h2 {
                color: #0d766e;
                text-align: center;
                margin-bottom: 15px;
            }

            p {
                text-align: center;
                color: #666;
                margin-bottom: 30px;
            }

            .form-control {
                width: 100%;
                padding: 14px;
                border: 1px solid #ccc;
                border-radius: 10px;
                margin-bottom: 20px;
            }

            .btn {
                width: 100%;
                padding: 14px;
                border: none;
                border-radius: 10px;
                background: #0d766e;
                color: white;
                font-size: 16px;
                cursor: pointer;
            }

                .btn:hover {
                    background: #095f59;
                }

            .back {
                display: block;
                text-align: center;
                margin-top: 20px;
                text-decoration: none;
                color: #0d766e;
            }

            .validation-summary-errors {
                color: red;
                margin-bottom: 15px;
            }

    </style>

</head>

<body>

    <div class="card">

        <h2><i class="fas fa-key"></i> Forgot Password</h2>

        <p>Enter your email address and we'll send you a password reset link.</p>

        <form asp-action="ForgotPassword" method="post">

            <div asp-validation-summary="All"></div>

            <input asp-for="Email"
                   class="form-control"
                   placeholder="Email Address" />

            <button class="btn" type="submit">
                Send Reset Link
            </button>

        </form>

        <a asp-action="Login" class="back">
            ← Back to Login
        </a>

    </div>

</body>
</html>