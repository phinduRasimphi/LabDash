@model IEnumerable<LabDash.Models.ConsumableOrder>

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>
            <h2 class="fw-bold">Consumable Orders</h2>
            <p class="text-muted">
                Manage laboratory stock orders.
            </p>
        </div>

        <div class="d-flex gap-2">

            <a asp-action="LowStock"
               class="btn btn-warning">

                <i class="bi bi-exclamation-triangle"></i>
                Low Stock

            </a>

            <a asp-action="Create"
               class="btn btn-primary">

                <i class="bi bi-plus-circle"></i>
                Create Order

            </a>

        </div>

    </div>


    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }


    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-cart-x fs-1 text-muted"></i>

                    <h5 class="mt-3">
                        No consumable orders found
                    </h5>

                    <a asp-action="Create"
                       class="btn btn-primary mt-2">
                        Create First Order
                    </a>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover align-middle">

                        <thead>
                            <tr>

                                <th>Order Number</th>

                                <th>Supplier</th>

                                <th>Date Ordered</th>

                                <th>Items</th>

                                <th>Status</th>

                                <th>Actions</th>

                            </tr>
                        </thead>

                        <tbody>

                            @foreach (var order in Model)
                            {
                                <tr>

                                    <td class="fw-bold">
                                        @order.OrderNumber
                                    </td>

                                    <td>
                                        @order.Supplier?.SupplierName
                                    </td>

                                    <td>
                                        @order.DateOrdered.ToString("dd MMM yyyy")
                                    </td>

                                    <td>
                                        @order.Items.Count
                                    </td>

                                    <td>

                                        @if (order.Status == "Ordered")
                                        {
                                            <span class="badge bg-primary">
                                                Ordered
                                            </span>
                                        }
                                        else if (order.Status == "Partially complete")
                                        {
                                            <span class="badge bg-warning text-dark">
                                                Partially Complete
                                            </span>
                                        }
                                        else if (order.Status == "Complete")
                                        {
                                            <span class="badge bg-success">
                                                Complete
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge bg-danger">
                                                Cancelled
                                            </span>
                                        }

                                    </td>

                                    <td>

                                        <a asp-action="Details"
                                           asp-route-id="@order.ConsumableOrderId"
                                           class="btn btn-sm btn-outline-info">

                                            <i class="bi bi-eye"></i>

                                        </a>

                                        @if (order.Status == "Ordered")
                                        {
                                            <a asp-action="Edit"
                                               asp-route-id="@order.ConsumableOrderId"
                                               class="btn btn-sm btn-outline-primary">

                                                <i class="bi bi-pencil"></i>

                                            </a>
                                        }

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>