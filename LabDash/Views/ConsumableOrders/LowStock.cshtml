@model IEnumerable<LabDash.Models.Consumable>

@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<div class="container-fluid p-4">

    <div class="d-flex justify-content-between align-items-center mb-4">

        <div>

            <h2 class="fw-bold">
                Low Stock Consumables
            </h2>

            <p class="text-muted">
                Consumables at or within 10% above their reorder level.
            </p>

        </div>

        <a asp-action="Create"
           class="btn btn-primary">

            <i class="bi bi-cart-plus"></i>
            Create Order

        </a>

    </div>


    <div class="card shadow-sm">

        <div class="card-body">

            @if (!Model.Any())
            {
                <div class="text-center py-5">

                    <i class="bi bi-check-circle fs-1 text-success"></i>

                    <h5 class="mt-3">
                        No low-stock consumables
                    </h5>

                    <p class="text-muted">
                        All consumables are above their reorder threshold.
                    </p>

                </div>
            }
            else
            {
                <div class="table-responsive">

                    <table class="table table-hover">

                        <thead>

                            <tr>

                                <th>
                                    Consumable
                                </th>

                                <th>
                                    Supplier
                                </th>

                                <th>
                                    Stock Level
                                </th>

                                <th>
                                    Reorder Level
                                </th>

                                <th>
                                    Difference
                                </th>

                                <th>
                                    Action
                                </th>

                            </tr>

                        </thead>

                        <tbody>

                            @foreach (var item in Model)
                            {
                                <tr>

                                    <td class="fw-semibold">
                                        @item.Name
                                    </td>

                                    <td>
                                        @item.SupplierName
                                    </td>

                                    <td>

                                        <span class="badge bg-danger">

                                            @item.StockLevel

                                        </span>

                                    </td>

                                    <td>
                                        @item.ReorderLevel
                                    </td>

                                    <td>

                                        @(item.StockLevel -
                                            item.ReorderLevel)

                                    </td>

                                    <td>

                                        <a asp-action="Create"
                                           class="btn btn-sm btn-primary">

                                            Order Stock

                                        </a>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>
            }

        </div>

    </div>

</div>
