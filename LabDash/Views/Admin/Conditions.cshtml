                cursor: pointer;
                user-select: none;
            }

                .adm-table th.adm-sortable::after {
                    content: '\2195';
                    margin-left: 6px;
                    opacity: .45;
                }

                .adm-table th.adm-sortable.is-asc::after {
                    content: '\2191';
                    opacity: 1;
                    color: var(--adm-teal);
                }

                .adm-table th.adm-sortable.is-desc::after {
                    content: '\2193';
                    opacity: 1;
                    color: var(--adm-teal);
                }

                .adm-table th.adm-sortable:hover {
                    color: var(--adm-teal-deep);
                }

                .adm-table th.adm-sortable:focus-visible {
                    outline: 2px solid var(--adm-teal);
                    outline-offset: -2px;
                }

    .adm-th-actions {
        text-align: left;
    }

    .adm-table td {
        padding: 15px 18px;
        border-bottom: 1px solid var(--adm-line);
        vertical-align: middle;
        overflow-wrap: break-word;
        word-break: normal;
        white-space: normal;
        line-height: 1.45;
    }

    .adm-table tbody tr {
        cursor: pointer;
    }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

        .adm-table tbody tr:hover {
            background: var(--adm-paper);
        }

        /* pinned rows get a thin teal edge */
        .adm-table tbody tr.is-pinned td:first-child {
            box-shadow: inset 3px 0 0 var(--adm-teal);
        }

    .adm-td-strong {
        font-weight: 600;
        color: var(--adm-ink);
        overflow-wrap: anywhere;
    }

    .adm-td-muted {
        color: var(--adm-ink-soft);
        overflow-wrap: anywhere;
    }

    /* search match highlight */
    .adm-mark {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-radius: 4px;
        padding: 0 2px;
    }


    /* ==========================================================
               CATEGORY BADGES
            ========================================================== */

    .adm-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.3;
        text-align: center;
        background: var(--category-bg);
        color: var(--category-text);
        border: 1px solid var(--category-border);
        box-shadow: 0 0 8px var(--category-glow);
        transition: box-shadow .2s;
        max-width: 100%;
        box-sizing: border-box;
        white-space: normal;
        overflow-wrap: anywhere;
    }

        .adm-badge:hover {
            box-shadow: 0 0 14px var(--category-glow);
        }

    .adm-badge-muted {
        background: var(--adm-line);
        color: var(--adm-ink-faint);
        border-color: var(--adm-line);
        box-shadow: none;
        animation: none;
    }


    /* ==========================================================
               STATUS
            ========================================================== */

    .adm-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        box-sizing: border-box;
    }

    .adm-status-active {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
    }

    .adm-status-inactive {
        background: var(--adm-line);
        color: var(--adm-ink-faint);
    }

    .adm-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .adm-status-active .adm-status-dot {
        background: var(--adm-teal);
        animation: admGlowPulse 2s ease-in-out infinite;
    }

    .adm-status-inactive .adm-status-dot {
        background: var(--adm-ink-faint);
        box-shadow: 0 0 0 3px var(--adm-line);
    }


    /* ==========================================================
               ROW ACTIONS
            ========================================================== */

    .adm-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        width: 100%;
    }

    .adm-inline-form-tight {
        display: inline-flex;
        max-width: 100%;
    }

    .adm-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid var(--adm-line-strong);
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        border-radius: var(--adm-radius-sm);
        padding: 7px 10px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s, color .15s, border-color .15s;
        max-width: 100%;
    }

    .adm-icon-btn-edit:hover {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-color: var(--adm-teal-dim);
    }

    .adm-icon-btn-danger:hover {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-color: var(--adm-red-dim);
    }

    .adm-icon-btn-restore:hover {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-color: var(--adm-teal-dim);
    }

    /* pin star (conditions only) */
    .adm-pin-btn {
        padding: 7px 9px;
        color: var(--adm-ink-faint);
    }

        .adm-pin-btn:hover {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
            border-color: var(--adm-amber-dim);
        }

        .adm-pin-btn.is-on {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
            border-color: var(--adm-amber);
        }


    /* ==========================================================
               INLINE FORM
            ========================================================== */

    .adm-inline-form {
        display: flex;
        gap: 10px;
        margin-top: 14px;
    }

        .adm-inline-form input {
            flex: 1;
            min-width: 0;
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
        }

            .adm-inline-form input:focus {
                outline: none;
                border-color: var(--adm-teal);
                box-shadow: 0 0 0 3px var(--adm-teal-dim);
            }


    /* ==========================================================
               PAGINATION
            ========================================================== */

    .adm-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 12px 0 14px;
    }

    .adm-page-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--adm-line-strong);
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        border-radius: 10px;
        cursor: pointer;
        transition: all .15s;
    }

        .adm-page-btn:hover:not(:disabled) {
            background: var(--adm-teal-dim);
            color: var(--adm-teal-deep);
            border-color: var(--adm-teal);
        }

        .adm-page-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    .adm-page-info {
        min-width: 90px;
        text-align: center;
        font-size: 12px;
        color: var(--adm-ink-soft);
        font-weight: 600;
    }

    .adm-condition-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 26px 14px;
        border-top: 1px solid var(--adm-line);
    }

    .adm-pagination-left {
        color: var(--adm-ink-faint);
        font-size: 12px;
        font-weight: 600;
    }

    .adm-pagination-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }


    /* ==========================================================
               CATEGORY BREAKDOWN
            ========================================================== */

    .adm-breakdown {
        padding: 20px 26px 26px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .adm-breakdown-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        /* breakdown rows filter the table */
        .adm-breakdown-row.is-link {
            cursor: pointer;
            border-radius: 10px;
            padding: 6px 8px;
            margin: -6px -8px;
            transition: background .15s;
        }

            .adm-breakdown-row.is-link:hover {
                background: var(--adm-paper);
            }

            .adm-breakdown-row.is-link:focus-visible {
                outline: 2px solid var(--adm-teal);
                outline-offset: 1px;
            }

    .adm-breakdown-hint {
        margin: 2px 0 0;
        font-size: 11.5px;
    }

    .adm-breakdown-label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 13px;
        color: var(--adm-ink);
    }

        .adm-breakdown-label span {
            overflow-wrap: anywhere;
        }

        .adm-breakdown-label strong {
            color: var(--adm-ink-faint);
            font-weight: 700;
            flex-shrink: 0;
        }

            .adm-breakdown-label strong small {
                font-weight: 500;
                font-size: 11px;
            }

    .adm-breakdown-track {
        height: 8px;
        border-radius: 999px;
        background: var(--adm-paper);
        overflow: hidden;
    }

    .adm-breakdown-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--category-text);
        box-shadow: 0 0 8px var(--category-glow);
        opacity: .85;
        transition: width .3s ease;
    }


    /* ==========================================================
               EMPTY STATE
            ========================================================== */

    .adm-empty-state {
        padding: 48px 30px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .adm-empty-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: var(--adm-teal-dim);
        color: var(--adm-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .adm-empty-state h5 {
        margin: 0;
        font-size: 14.5px;
        font-weight: 700;
    }

    .adm-empty-state p {
        margin: 0;
        max-width: 340px;
        font-size: 13px;
        color: var(--adm-ink-soft);
        line-height: 1.6;
    }


    /* ==========================================================
               MODALS
            ========================================================== */

    .adm-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10, 44, 39, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

        .adm-modal-overlay.is-open {
            display: flex;
        }

    .adm-modal {
        background: var(--adm-raised);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        width: 100%;
        max-width: 440px;
        padding: 26px;
    }

    .adm-modal-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 20px;
    }

    .adm-modal-icon {
        margin-right: 8px;
        color: var(--adm-teal);
    }

    .adm-modal-close {
        cursor: pointer;
        color: var(--adm-ink-faint);
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .adm-modal-close:hover {
            background: var(--adm-paper);
            color: var(--adm-ink);
        }

    .adm-form-group {
        margin-bottom: 16px;
    }

        .adm-form-group label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--adm-ink-soft);
            margin-bottom: 6px;
        }

        .adm-form-group input,
        .adm-form-group select {
            width: 100%;
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            color: var(--adm-ink);
            box-sizing: border-box;
        }

            .adm-form-group input:focus,
            .adm-form-group select:focus {
                outline: none;
                border-color: var(--adm-teal);
                box-shadow: 0 0 0 3px var(--adm-teal-dim);
            }

    /* duplicate-name warning */
    .adm-field-warn {
        margin-top: 8px;
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
        border-radius: 10px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .adm-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 6px;
    }

    /* details modal */
    .adm-detail-list {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
        border: 1px solid var(--adm-line);
        border-radius: var(--adm-radius-sm);
        overflow: hidden;
    }

    .adm-detail-row {
        display: flex;
        gap: 16px;
        padding: 13px 16px;
        border-bottom: 1px solid var(--adm-line);
        font-size: 13px;
    }

        .adm-detail-row:last-child {
            border-bottom: none;
        }

    .adm-detail-label {
        width: 96px;
        flex-shrink: 0;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: var(--adm-ink-faint);
        padding-top: 2px;
    }

    .adm-detail-value {
        color: var(--adm-ink);
        font-weight: 600;
        overflow-wrap: anywhere;
        line-height: 1.5;
    }

        .adm-detail-value.is-empty {
            color: var(--adm-ink-faint);
            font-weight: 500;
            font-style: italic;
        }


    /* ==========================================================
               ANIMATIONS
            ========================================================== */

    @@keyframes categoryGlow {
        0%, 100% {
            box-shadow: 0 0 0 0 transparent;
        }

        50% {
            box-shadow: 0 0 10px var(--category-glow);
        }
    }

    @@keyframes admGlowPulse {
        0%, 100% {
            box-shadow: 0 0 0 3px var(--adm-teal-dim), 0 0 6px 1px rgba(14, 140, 127, .45);
        }

        50% {
            box-shadow: 0 0 0 3px var(--adm-teal-dim), 0 0 14px 4px rgba(14, 140, 127, .75);
        }
    }


    /* ==========================================================
               RESPONSIVE
            ========================================================== */

    @@media (max-width: 1000px) {

        .adm-split {
            grid-template-columns: 1fr;
        }

        .adm-insights {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 640px) {

        .adm-page {
            padding: 20px 16px 50px;
        }

        .adm-insights {
            grid-template-columns: 1fr;
        }

        .adm-page-banner {
            flex-direction: column;
            align-items: flex-start;
        }

        .adm-page-banner-right {
            width: 100%;
            justify-content: space-between;
        }

        .adm-row-actions {
            flex-wrap: wrap;
        }

        .adm-toolbar {
            align-items: stretch;
        }

        .adm-show-control {
            width: 100%;
            justify-content: flex-end;
        }

        .adm-condition-pagination {
            flex-direction: column;
            gap: 12px;
        }

        .adm-shortcuts-hint {
            display: none;
        }

        .adm-inline-form {
            flex-direction: column;
        }

        .adm-table th,
        .adm-table td {
            padding: 12px 10px;
        }

        .adm-table {
            font-size: 12px;
        }

            .adm-table th {
                font-size: 10px;
            }

        .adm-icon-btn {
            font-size: 10.5px;
            padding: 6px 8px;
        }

        .adm-badge {
            font-size: 10px;
            padding: 4px 8px;
        }

        .adm-detail-row {
            flex-direction: column;
            gap: 4px;
        }
    }


    /* ==========================================================
               DARK MODE (html.rq-dark, same switch as the rest of the app)
               The category chip/badge/bar colours come from the script
               (a dark palette is used while html.rq-dark is set).
            ========================================================== */

    /* 1. Re-point the page's variables at the shared dark palette */
    html.rq-dark {
        --adm-paper: #141C18;
        --adm-raised: #172019;
        --adm-ink: #E8EEEB;
        --adm-ink-soft: #A5B0AA;
        --adm-ink-faint: #7F8B85;
        --adm-line: #26302B;
        --adm-line-strong: #34403A;
        --adm-teal: #2CC4BA;
        --adm-teal-deep: #5ED0C4;
        --adm-teal-dim: #12302D;
        --adm-teal-grad-start: #0F7F74;
        --adm-teal-grad-end: #0A3A35;
        --adm-red: #E1736B;
        --adm-red-dim: #3A1B18;
        --adm-amber: #E8B84A;
        --adm-amber-dim: #3A2E12;
        --adm-shadow: 0 6px 24px rgba(0, 0, 0, .45);
        --adm-shadow-sm: 0 3px 10px rgba(0, 0, 0, .3);
    }

        /* 2. Beat the shared catch-all (it matches "panel" and "tag" in class names) */
        html.rq-dark .adm-page .adm-panel .adm-panel-head .adm-panel-tag {
            background-color: var(--adm-teal-dim) !important;
            color: var(--adm-teal-deep) !important;
            box-shadow: none !important;
            border-color: transparent !important;
        }

        html.rq-dark .adm-page .adm-panel .adm-panel-body {
            background-color: transparent !important;
            box-shadow: none !important;
        }

        /* 3. Beat the shared "color: inherit" rule for td / th / span / p / label */
        html.rq-dark .adm-page .adm-table-scroll .adm-table th {
            color: var(--adm-ink-faint);
            background: var(--adm-paper);
        }

            html.rq-dark .adm-page .adm-table-scroll .adm-table th.adm-sortable:hover {
                color: var(--adm-teal-deep);
            }

        html.rq-dark .adm-page .adm-table td.adm-td-muted {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-table tbody tr:hover {
            background: #1B2620;
        }

        html.rq-dark .adm-page .adm-page-banner .adm-page-banner-left h1 {
            color: #fff;
        }

        html.rq-dark .adm-page .adm-page-banner .adm-page-banner-left p {
            color: rgba(255, 255, 255, .85);
        }

        html.rq-dark .adm-page .adm-mini-stat span.num {
            color: #fff;
        }

        html.rq-dark .adm-page .adm-mini-stat span.label {
            color: rgba(255, 255, 255, .75);
        }

        /* "Add Condition" button on the banner: keep it light, with dark text */
        html.rq-dark .adm-page .adm-page-banner .adm-btn.adm-btn-light {
            background: #E8EEEB;
            color: #0A3A35;
        }

        /* tabs */
        html.rq-dark .adm-page .adm-tabs .adm-tab .adm-tab-count {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-tabs .adm-tab.is-active .adm-tab-count {
            color: var(--adm-teal-deep);
        }

        /* "Show N rows" and pagination text */
        html.rq-dark .adm-page .adm-toolbar .adm-show-control span {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-condition-pagination .adm-pagination-left span {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-condition-pagination .adm-page-info,
        html.rq-dark .adm-page .adm-pagination .adm-page-info {
            color: var(--adm-ink-soft);
        }

        /* hint + empty-state text */
        html.rq-dark .adm-page .adm-chips-container .adm-hint,
        html.rq-dark .adm-page .adm-breakdown .adm-hint {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-panel .adm-empty-state p {
            color: var(--adm-ink-soft);
        }

        /* category chips: the shared rules reset the text colour and border, so restore them */
        html.rq-dark .adm-page .adm-chips-row .adm-chip-form .adm-chip {
            color: var(--category-text);
            border-color: var(--category-border);
        }

        /* 4. Search inputs: sit transparent inside their box */
        html.rq-dark .adm-page .adm-search-box input {
            background: transparent;
            border: none;
            color: var(--adm-ink);
        }

            html.rq-dark .adm-page .adm-search-box input:focus {
                outline: none;
            }

        /* 5. Selects and form fields: match the shared field look, keep borders visible */
        html.rq-dark .adm-page .adm-toolbar select,
        html.rq-dark .adm-page .adm-show-control select,
        html.rq-dark .adm-page .adm-inline-form input,
        html.rq-dark .adm-page .adm-form-group input,
        html.rq-dark .adm-page .adm-form-group select {
            background-color: var(--adm-paper);
            color: var(--adm-ink);
            border-color: var(--adm-line-strong);
        }

            html.rq-dark .adm-page .adm-inline-form input:focus,
            html.rq-dark .adm-page .adm-form-group input:focus,
            html.rq-dark .adm-page .adm-form-group select:focus {
                outline: none;
                border-color: var(--adm-teal);
            }

        /* 6. Modals */
        html.rq-dark .adm-page .adm-modal-overlay {
            background: rgba(0, 0, 0, .65);
        }

        html.rq-dark .adm-page .adm-modal .adm-form-group label {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-modal .adm-modal-title .adm-modal-close {
            color: var(--adm-ink-faint);
        }

            html.rq-dark .adm-page .adm-modal .adm-modal-title .adm-modal-close:hover {
                background: var(--adm-paper);
                color: var(--adm-ink);
            }

        /* 7. New elements */
        html.rq-dark .adm-page .adm-insight .adm-insight-label {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-insight .adm-insight-value {
            color: var(--adm-ink);
        }

        html.rq-dark .adm-page .adm-insight .adm-insight-sub {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-insight:hover:not(:disabled):not(.adm-insight-static) {
            box-shadow: 0 10px 28px rgba(0, 0, 0, .5);
        }

        html.rq-dark .adm-page .adm-table td .adm-mark,
        html.rq-dark .adm-page .adm-table td mark.adm-mark {
            background: var(--adm-teal-dim);
            color: var(--adm-teal-deep);
        }

        html.rq-dark .adm-page .adm-shortcuts-hint span {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-kbd {
            background: var(--adm-raised);
            color: var(--adm-ink-faint);
            border-color: var(--adm-line-strong);
        }

        html.rq-dark .adm-page .adm-toggle {
            background: var(--adm-raised);
            color: var(--adm-ink-soft);
            border-color: var(--adm-line-strong);
        }

            html.rq-dark .adm-page .adm-toggle.is-on {
