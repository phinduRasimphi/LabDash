        }

        .adm-table th {
            text-align: left;
            padding: 13px 18px;
            font-weight: 600;
            font-size: 11px;
            letter-spacing: .03em;
            text-transform: uppercase;
            color: var(--adm-ink-faint);
            background: var(--adm-paper);
            border-bottom: 1px solid var(--adm-line);
