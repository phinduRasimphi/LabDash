@model LabDash.Models.AdminListViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Conditions";
    ViewData["ActivePage"] = "Conditions";
    var chipClass = "a-chip-cond";
    var badgeClass = "a-badge-cond";
}

@if (TempData["Success"] != null)
{
    <div class="a-alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

@if (TempData["Error"] != null)
{
    <div class="a-alert a-alert-error">
        <i class="fas fa-exclamation-circle"></i> @TempData["Error"]
    </div>
}

<div class="a-page-header">
    <div>
        <div class="a-page-title">
            <i class="fas fa-heartbeat"></i> Manage Conditions 🫀
        </div>
        <div class="a-page-sub">Maintain the list of medical conditions used across the system</div>
    </div>
    <button class="a-btn" onclick="openModal('modal-add')">
        <i class="fas fa-plus"></i> Add Condition
    </button>
</div>

<!-- Categories Card -->
<div class="a-card">
    <div class="a-ch">
        <div class="a-ct">
            <i class="fas fa-folder"></i> Condition Categories
        </div>
        <span class="a-cc">@Model.Categories.Count categories</span>
    </div>
    <div class="a-cb">
        <div class="a-chips-row" id="cat-chips">
            @foreach (var cat in Model.Categories)
            {
                <span class="a-chip @chipClass">@cat.Name</span>
            }
        </div>

        <form asp-action="AddCategory" method="post" class="a-tag-input">
            @Html.AntiForgeryToken()
            <input type="hidden" name="type" value="Condition" />
            <input name="name" placeholder="New category name…" required />
            <button class="a-btn" type="submit">
                <i class="fas fa-plus"></i> Add Category
            </button>
        </form>
    </div>
</div>

<!-- All Conditions Card -->
<div class="a-card">
    <div class="a-ch">
        <div class="a-ct">
            <i class="fas fa-heartbeat"></i> All Conditions
        </div>
        <span class="a-cc">@Model.Conditions.Count items</span>
    </div>

    <div style="padding: 16px 20px 0;">
        <div class="a-search">
            <input id="cond-search" placeholder="🔍  Search conditions…" oninput="filterTable('cond-search','cond-cat-filter','cond-tbody')" />
            <select id="cond-cat-filter" onchange="filterTable('cond-search','cond-cat-filter','cond-tbody')">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat.Name">@cat.Name</option>
                }
            </select>
        </div>
    </div>

    <table class="a-table">
        <thead>
            <tr>
                <th>Condition Name</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>

        <tbody id="cond-tbody">
            @foreach (var item in Model.Conditions)
            {
                <tr data-name="@item.ConditionName.ToLower()"
                    data-cat="@item.Category?.Name">

                    <td>@item.ConditionName</td>

                    <td>
                        <span class="a-badge a-badge-cond">
                            @item.Category?.Name
                        </span>
                    </td>

                    <td>@item.Description</td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>

                    <td>
                        <button class="a-btn-edit"
                                onclick="openEditModal('@item.MedicalConditionId',
                            '@item.ConditionName',
                            '@item.CategoryId',
                            '@Html.Raw(Html.Encode(item.Description ?? "").Replace("'", "\\'"))')">
                            <i class="fas fa-edit"></i> Edit
                        </button>

                        <form asp-action="DeleteCondition"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()

                            <input type="hidden"
                                   name="id"
                                   value="@item.MedicalConditionId" />

                            <button class="a-btn-danger">
                                <i class="fas fa-trash"></i> Deactivate
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Conditions.Any())
    {
        <div style="padding:40px;text-align:center;">
            No conditions found.
        </div>
    }
</div>

@if (Model.InactiveConditions.Any())
{
    <div class="a-card">
        <div class="a-ch">
            <div class="a-ct">
                <i class="fas fa-archive"></i> Deactivated Conditions
            </div>
            <span class="a-cc">@Model.InactiveConditions.Count items</span>
        </div>
        <table class="a-table">
            <thead>
                <tr>
                    <th>Condition Name</th>
                    <th>Category</th>
                    <th>Description</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model.InactiveConditions)
                {
                    <tr>
                        <td>@item.ConditionName</td>
                        <td>@item.Category?.Name</td>
                        <td>@item.Description</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
}

<!-- ADD MODAL -->
<div class="a-modal-overlay" id="modal-add">
    <div class="a-modal">
        <div class="a-modal-title">
            <span><i class="fas fa-plus-circle" style="color:var(--a-sidebar-bg);margin-right:8px;"></i>Add New Condition</span>
            <span class="a-modal-close" onclick="closeModal('modal-add')">✕</span>
        </div>
        <form asp-action="AddCondition" method="post">
            @Html.AntiForgeryToken()
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Condition Name</label>
                <input name="name" placeholder="e.g. Chronic Kidney Disease" required />
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Category</label>
                <select name="categoryId" required>
                    <option value="">-- Select Category --</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Description (optional)</label>
                <input name="description" placeholder="Short description" />
            </div>
            <div class="a-modal-actions">
                <button type="button" class="a-btn-cancel" onclick="closeModal('modal-add')">Cancel</button>
                <button type="submit" class="a-btn">
                    <i class="fas fa-save"></i> Save Condition
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="a-modal-overlay" id="modal-edit">
    <div class="a-modal">
        <div class="a-modal-title">
            <span><i class="fas fa-edit" style="color:var(--a-blue);margin-right:8px;"></i>Edit Condition</span>
            <span class="a-modal-close" onclick="closeModal('modal-edit')">✕</span>
        </div>
        <form asp-action="EditCondition" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-id" />
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Condition Name</label>
                <input name="name" id="edit-name" placeholder="e.g. Chronic Kidney Disease" required />
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Category</label>
                <select name="categoryId" id="edit-category" required>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.CategoryId">@cat.Name</option>
                    }
                </select>
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Description (optional)</label>
                <input name="description" id="edit-description" placeholder="Short description" />
            </div>
            <div class="a-modal-actions">
                <button type="button" class="a-btn-cancel" onclick="closeModal('modal-edit')">Cancel</button>
                <button type="submit" class="a-btn">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name, categoryId, description) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            document.getElementById('edit-description').value = description;

            var sel = document.getElementById('edit-category');
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === String(categoryId)) { sel.selectedIndex = i; break; }
            }
            openModal('modal-edit');
        }

        function filterTable(searchId, filterId, tbodyId) {
            var q = document.getElementById(searchId).value.toLowerCase();
            var cat = document.getElementById(filterId).value;
            var rows = document.getElementById(tbodyId).querySelectorAll('tr');
            rows.forEach(function(row) {
                var nameMatch = row.dataset.name.includes(q);
                var catMatch = !cat || row.dataset.cat === cat;
                row.style.display = (nameMatch && catMatch) ? '' : 'none';
            });
        }
    </script>
}
