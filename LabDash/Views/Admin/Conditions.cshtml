@model LabDash.Models.AdminListViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Conditions";
    ViewData["ActivePage"] = "Conditions";

    var breakdown = Model.Conditions
        .GroupBy(c => c.Category?.Name ?? "Uncategorized")
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(g => g.Count)
        .ToList();
    var breakdownMax = breakdown.Any() ? breakdown.Max(b => b.Count) : 0;
}

@*
    ============================================================================
    Fixes from last pass:
      1. openModal/closeModal were never actually defined anywhere in this
         file (I'd assumed _SystemLayout provided them — it doesn't seem to).
         That's why Add/Edit did nothing. Defined below, plus Escape-to-close
         and click-outside-to-close.
      2. Category chips/badges are back to red (they were never meant to be
         teal — that was me guessing at a palette). See --adm-cond-accent.
      3. Add Condition form fields are untouched from your original
         (name / categoryId / description, posts to AddCondition) — nothing
         about the controller contract changed, only the JS that opens it.
      4. Added a small page banner with live counts + a "By category"
         breakdown panel next to the table so the page doesn't feel sparse.
         No clock/weather — see chat for why.
    ============================================================================
*@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="adm-page">

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert">
            <i class="fas fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="adm-alert adm-alert-error">
            <i class="fas fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    <!-- ==========================================
        PAGE BANNER
    =========================================== -->
    <div class="adm-page-banner">
        <div class="adm-page-banner-pattern"></div>

        <div class="adm-page-banner-left">
            <div class="adm-page-banner-icon"><i class="fas fa-heart-pulse"></i></div>
            <div>
                <h1>Manage Conditions</h1>
                <p>Maintain the list of medical conditions used across the system</p>
            </div>
        </div>

        <div class="adm-page-banner-right">
            <div class="adm-mini-stats">
                <div class="adm-mini-stat">
                    <span class="num">@Model.Conditions.Count</span>
                    <span class="label">Active</span>
                </div>
                <div class="adm-mini-stat">
                    <span class="num">@Model.InactiveConditions.Count</span>
                    <span class="label">Archived</span>
                </div>
                <div class="adm-mini-stat">
                    <span class="num">@Model.Categories.Count</span>
                    <span class="label">Categories</span>
                </div>
            </div>
            <button class="adm-btn adm-btn-light" onclick="openModal('modal-add')">
                <i class="fas fa-plus"></i> Add Condition
            </button>
        </div>
    </div>

    <!-- ==========================================
        CATEGORIES PANEL
    =========================================== -->
    <div class="adm-panel">
        <div class="adm-panel-head">
            <span><i class="fas fa-folder"></i> Condition Categories</span>
            <span class="adm-panel-tag">@Model.Categories.Count categories</span>
        </div>
        <div class="adm-panel-body">
            <div class="adm-chips-row" id="cat-chips">
                @foreach (var cat in Model.Categories)
                {
                    <span class="adm-chip">@cat.Name</span>
                }
            </div>

            <form asp-action="AddCategory" method="post" class="adm-inline-form">
                @Html.AntiForgeryToken()
                <input type="hidden" name="type" value="Condition" />
                <input name="name" placeholder="New category name" required />
                <button class="adm-btn adm-btn-sm" type="submit">
                    <i class="fas fa-plus"></i> Add Category
                </button>
            </form>
        </div>
    </div>

    <!-- ==========================================
        CONDITIONS TABLE + CATEGORY BREAKDOWN
    =========================================== -->
    <div class="adm-split">

        <!-- Conditions table (tabbed: Active / Archived) -->
        <div class="adm-panel">
            <div class="adm-panel-head">
                <span><i class="fas fa-heart-pulse"></i> All Conditions</span>
                <span class="adm-panel-tag">@Model.Conditions.Count items</span>
            </div>

            <div class="adm-tabs">
                <button type="button" class="adm-tab is-active" data-tbody="cond-tbody" onclick="switchTab(this)">
                    Active <span class="adm-tab-count">@Model.Conditions.Count</span>
                </button>
                <button type="button" class="adm-tab" data-tbody="cond-tbody-archived" onclick="switchTab(this)">
                    Archived <span class="adm-tab-count">@Model.InactiveConditions.Count</span>
                </button>
            </div>

            <div class="adm-toolbar">
                <div class="adm-search-box">
                    <i class="fas fa-magnifying-glass"></i>
                    <input id="cond-search" placeholder="Search conditions…" oninput="filterActiveTable()" />
                </div>
                <select id="cond-cat-filter" onchange="filterActiveTable()">
                    <option value="">All Categories</option>
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat.Name">@cat.Name</option>
                    }
                </select>
            </div>

            <div class="adm-table-wrap">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Condition Name</th>
                            <th>Category</th>
                            <th>Description</th>
                            <th>Status</th>
                            <th class="adm-th-actions">Actions</th>
                        </tr>
                    </thead>

                    <!-- ACTIVE ROWS -->
                    <tbody id="cond-tbody">
                        @foreach (var item in Model.Conditions)
                        {
                            <tr data-name="@item.ConditionName.ToLower()" data-cat="@item.Category?.Name">
                                <td class="adm-td-strong">@item.ConditionName</td>
                                <td><span class="adm-badge">@item.Category?.Name</span></td>
                                <td class="adm-td-muted">@item.Description</td>
                                <td>
                                    <span class="adm-status-pill adm-status-active">
                                        <span class="adm-status-dot"></span> Active
                                    </span>
                                </td>
                                <td>
                                    <div class="adm-row-actions">
                                        <button type="button" class="adm-icon-btn adm-icon-btn-edit"
                                                data-id="@item.MedicalConditionId"
                                                data-name="@item.ConditionName"
                                                data-category="@item.CategoryId"
                                                data-description="@item.Description"
                                                onclick="openEditModalFromButton(this)">
                                            <i class="fas fa-pen"></i> Edit
                                        </button>

                                        <form asp-action="DeleteCondition" method="post" class="adm-inline-form-tight">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MedicalConditionId" />
                                            <button type="submit" class="adm-icon-btn adm-icon-btn-danger">
                                                <i class="fas fa-box-archive"></i> Deactivate
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>

                    <!-- ARCHIVED ROWS -->
                    <tbody id="cond-tbody-archived" style="display:none;">
                        @foreach (var item in Model.InactiveConditions)
                        {
                            <tr data-name="@item.ConditionName.ToLower()" data-cat="@item.Category?.Name">
                                <td class="adm-td-strong">@item.ConditionName</td>
                                <td><span class="adm-badge adm-badge-muted">@item.Category?.Name</span></td>
                                <td class="adm-td-muted">@item.Description</td>
                                <td>
                                    <span class="adm-status-pill adm-status-inactive">
                                        <span class="adm-status-dot"></span> Archived
                                    </span>
                                </td>
                                <td>
                                    <div class="adm-row-actions">
                                        <form asp-action="ReactivateCondition" method="post" class="adm-inline-form-tight">
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="id" value="@item.MedicalConditionId" />
                                            <button type="submit" class="adm-icon-btn adm-icon-btn-restore">
                                                <i class="fas fa-rotate-left"></i> Reactivate
                                            </button>
                                        </form>
                                    </div>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Conditions.Any())
                {
                    <div class="adm-empty-state" id="cond-empty-active">
                        <div class="adm-empty-icon"><i class="fas fa-heart-pulse"></i></div>
                        <h5>No conditions found</h5>
                        <p>Add your first condition using the button above.</p>
                    </div>
                }

                @if (!Model.InactiveConditions.Any())
                {
                    <div class="adm-empty-state" id="cond-empty-archived" style="display:none;">
                        <div class="adm-empty-icon"><i class="fas fa-box-archive"></i></div>
                        <h5>Nothing archived</h5>
                        <p>Conditions you deactivate will appear here and can be reactivated any time.</p>
                    </div>
                }
            </div>
        </div>

        <!-- Category breakdown -->
        <div class="adm-panel">
            <div class="adm-panel-head">
                <span><i class="fas fa-chart-simple"></i> By category</span>
            </div>
            <div class="adm-breakdown">
                @if (breakdown.Any())
                {
                    @foreach (var b in breakdown)
                    {
                        var pct = breakdownMax > 0 ? (int)Math.Round((double)b.Count / breakdownMax * 100) : 0;
                        <div class="adm-breakdown-row">
                            <div class="adm-breakdown-label">
                                <span>@b.Name</span>
                                <strong>@b.Count</strong>
                            </div>
                            <div class="adm-breakdown-track">
                                <div class="adm-breakdown-fill" style="width:@(pct)%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="adm-empty-state">
                        <div class="adm-empty-icon"><i class="fas fa-chart-simple"></i></div>
                        <h5>No data yet</h5>
                        <p>Once conditions are added, their spread across categories will show up here.</p>
                    </div>
                }
            </div>
        </div>

    </div>

    <!-- ==========================================
        ADD MODAL
    =========================================== -->
    <div class="adm-modal-overlay" id="modal-add">
        <div class="adm-modal">
            <div class="adm-modal-title">
                <span><i class="fas fa-circle-plus adm-modal-icon"></i>Add New Condition</span>
                <span class="adm-modal-close" onclick="closeModal('modal-add')"><i class="fas fa-xmark"></i></span>
            </div>
            <form asp-action="AddCondition" method="post">
                @Html.AntiForgeryToken()
                <div class="adm-form-group">
                    <label>Condition Name</label>
                    <input name="name" placeholder="e.g. Chronic Kidney Disease" required />
                </div>
                <div class="adm-form-group">
                    <label>Category</label>
                    <select name="categoryId" required>
                        <option value="">-- Select Category --</option>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="adm-form-group">
                    <label>Description (optional)</label>
                    <input name="description" placeholder="Short description" />
                </div>
                <div class="adm-modal-actions">
                    <button type="button" class="adm-btn-cancel" onclick="closeModal('modal-add')">Cancel</button>
                    <button type="submit" class="adm-btn">
                        <i class="fas fa-floppy-disk"></i> Save Condition
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- ==========================================
        EDIT MODAL
    =========================================== -->
    <div class="adm-modal-overlay" id="modal-edit">
        <div class="adm-modal">
            <div class="adm-modal-title">
                <span><i class="fas fa-pen adm-modal-icon"></i>Edit Condition</span>
                <span class="adm-modal-close" onclick="closeModal('modal-edit')"><i class="fas fa-xmark"></i></span>
            </div>
            <form asp-action="EditCondition" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" id="edit-id" />
                <div class="adm-form-group">
                    <label>Condition Name</label>
                    <input name="name" id="edit-name" placeholder="e.g. Chronic Kidney Disease" required />
                </div>
                <div class="adm-form-group">
                    <label>Category</label>
                    <select name="categoryId" id="edit-category" required>
                        @foreach (var cat in Model.Categories)
                        {
                            <option value="@cat.CategoryId">@cat.Name</option>
                        }
                    </select>
                </div>
                <div class="adm-form-group">
                    <label>Description (optional)</label>
                    <input name="description" id="edit-description" placeholder="Short description" />
                </div>
                <div class="adm-modal-actions">
                    <button type="button" class="adm-btn-cancel" onclick="closeModal('modal-edit')">Cancel</button>
                    <button type="submit" class="adm-btn">
                        <i class="fas fa-floppy-disk"></i> Save Changes
                    </button>
                </div>
            </form>
        </div>
    </div>

</div>

@section Scripts {
    <script>
        // These were missing entirely last time, which is why Add/Edit did nothing.
        function openModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.add('is-open');
            document.body.style.overflow = 'hidden';
        }

        function closeModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('is-open');
            document.body.style.overflow = '';
        }

        // Click outside the modal card, or press Escape, to close.
        document.querySelectorAll('.adm-modal-overlay').forEach(function(overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeModal(overlay.id);
            });
        });
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                document.querySelectorAll('.adm-modal-overlay.is-open').forEach(function(o) {
                    closeModal(o.id);
                });
            }
        });

        function openEditModalFromButton(btn) {
            document.getElementById('edit-id').value = btn.dataset.id;
            document.getElementById('edit-name').value = btn.dataset.name;
            document.getElementById('edit-description').value = btn.dataset.description || '';

            var sel = document.getElementById('edit-category');
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === String(btn.dataset.category)) { sel.selectedIndex = i; break; }
            }
            openModal('modal-edit');
        }

        function switchTab(tabBtn) {
            document.querySelectorAll('.adm-tab').forEach(t => t.classList.remove('is-active'));
            tabBtn.classList.add('is-active');

            document.getElementById('cond-tbody').style.display = 'none';
            document.getElementById('cond-tbody-archived').style.display = 'none';
            document.getElementById(tabBtn.dataset.tbody).style.display = '';

            var activeEmpty = document.getElementById('cond-empty-active');
            var archivedEmpty = document.getElementById('cond-empty-archived');
            if (activeEmpty) activeEmpty.style.display = tabBtn.dataset.tbody === 'cond-tbody' ? '' : 'none';
            if (archivedEmpty) archivedEmpty.style.display = tabBtn.dataset.tbody === 'cond-tbody-archived' ? '' : 'none';

            document.getElementById('cond-search').value = '';
            document.getElementById('cond-cat-filter').value = '';
            filterActiveTable();
        }

        function filterActiveTable() {
            var activeTab = document.querySelector('.adm-tab.is-active');
            var tbody = document.getElementById(activeTab.dataset.tbody);
            var q = document.getElementById('cond-search').value.toLowerCase();
            var cat = document.getElementById('cond-cat-filter').value;

            tbody.querySelectorAll('tr').forEach(function(row) {
                var nameMatch = row.dataset.name.includes(q);
                var catMatch = !cat || row.dataset.cat === cat;
                row.style.display = (nameMatch && catMatch) ? '' : 'none';
            });
        }
    </script>
}

<style>
    :root {
        --adm-paper: #F0F7F6;
        --adm-raised: #FFFFFF;
        --adm-ink: #102C27;
        --adm-ink-soft: #52716C;
        --adm-ink-faint: #8FA9A3;
        --adm-line: #E1EEEC;
        --adm-line-strong: #CCE3DF;
        --adm-teal: #0E8C7F;
        --adm-teal-deep: #0A5850;
        --adm-teal-dim: #E3F4F1;
        --adm-teal-grad-start: #12A392;
        --adm-teal-grad-end: #0A4F48;
        --adm-red: #B0463F;
        --adm-red-dim: #F7E8E7;
        --adm-radius: 20px;
        --adm-radius-sm: 13px;
        --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
        /* Category accent for THIS page — conditions are red, matching
               the original a-chip-cond / a-badge-cond styling. */
        --adm-cond-accent: var(--adm-red);
        --adm-cond-accent-dim: var(--adm-red-dim);
    }

    .adm-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--adm-ink);
        font-family: 'Inter', sans-serif;
    }

    /* ============ ALERTS ============ */
    .adm-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-left: 4px solid var(--adm-teal);
        border-radius: var(--adm-radius-sm);
        padding: 14px 18px;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .adm-alert-error {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-left-color: var(--adm-red);
    }

    /* ============ PAGE BANNER ============ */
    .adm-page-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        border-radius: var(--adm-radius);
        padding: 26px 32px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
        flex-wrap: wrap;
    }

    .adm-page-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .adm-page-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .adm-page-banner-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }

    .adm-page-banner-left h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 21px;
        margin: 0 0 3px;
        color: #fff;
    }

    .adm-page-banner-left p {
        margin: 0;
        color: rgba(255,255,255,.85);
        font-size: 13px;
    }

    .adm-page-banner-right {
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
    }

    .adm-mini-stats {
        display: flex;
        gap: 18px;
    }

    .adm-mini-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 58px;
    }

        .adm-mini-stat .num {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #fff;
        }

        .adm-mini-stat .label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: rgba(255,255,255,.75);
            margin-top: 2px;
        }

    /* ============ BUTTONS ============ */
    .adm-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        color: #fff;
        border: none;
        border-radius: var(--adm-radius-sm);
        padding: 11px 20px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(10, 90, 80, 0.22);
        transition: transform .15s, box-shadow .15s;
    }

        .adm-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(10, 90, 80, 0.28);
        }

    .adm-btn-sm {
        padding: 9px 16px;
        font-size: 12.5px;
        flex-shrink: 0;
    }

    .adm-btn-light {
        background: #fff;
        color: var(--adm-teal-deep);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

        .adm-btn-light:hover {
            box-shadow: 0 12px 24px rgba(0,0,0,0.16);
        }

    .adm-btn-cancel {
        background: var(--adm-paper);
        color: var(--adm-ink-soft);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 11px 20px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
    }

    /* ============ PANELS ============ */
    .adm-panel {
        background: var(--adm-raised);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .adm-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--adm-line);
    }

        .adm-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .adm-panel-head span:first-child i {
                color: var(--adm-teal);
            }

    .adm-panel-tag {
        font-weight: 600;
        font-size: 11.5px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    .adm-panel-body {
        padding: 20px 26px 24px;
    }

    /* ============ SPLIT LAYOUT ============ */
    .adm-split {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 18px;
        align-items: start;
    }

    /* ============ CHIPS (category accent = red) ============ */
    .adm-chips-row {
        display: flex;
        flex-wrap: wrap;
        gap: 8px;
        margin-bottom: 16px;
    }

    .adm-chip {
        background: var(--adm-cond-accent-dim);
        color: var(--adm-cond-accent);
        padding: 6px 14px;
        border-radius: 999px;
        font-size: 12.5px;
        font-weight: 600;
        animation: admGlowPulseRed 2.6s ease-in-out infinite;
    }

    .adm-inline-form {
        display: flex;
        gap: 10px;
    }

        .adm-inline-form input {
            flex: 1;
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
        }

    .adm-inline-form-tight {
        display: inline-flex;
    }

    /* ============ TABS ============ */
    .adm-tabs {
        display: flex;
        gap: 6px;
        padding: 16px 26px 0;
    }

    .adm-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: none;
