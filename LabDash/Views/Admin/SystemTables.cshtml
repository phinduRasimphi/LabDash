@model LabDash.Models.SystemTablesViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "System Tables";
    ViewData["ActivePage"] = "SystemTables";
}

<div class="a-page-title" style="margin-bottom:4px">System Tables 🗃️</div>
<div class="a-page-sub" style="margin-bottom:18px">Manage reference tables used across all subsystems</div>

<div class="a-alert" style="margin-bottom:14px">
    <i class="fas fa-info-circle"></i> Changes here affect all subsystems. Edit with caution.
</div>

<div class="a-r2">

    <!-- Sample Types -->
    <div class="a-card">
        <div class="a-ch">
            <div class="a-ct"><i class="fas fa-vial"></i> Sample Types</div>
            <span class="a-cc">@Model.SampleTypes.Count items</span>
        </div>
        <div class="a-cb" style="padding:0">
            <table class="a-table">
                <thead><tr><th>Sample Type</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.SampleTypes)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td style="display:flex;gap:5px;">
                                <button class="a-btn-edit"><i class="fas fa-edit"></i> Edit</button>
                                <button class="a-btn-danger"><i class="fas fa-trash"></i> Delete</button>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <div style="padding:12px 16px;border-top:0.5px solid var(--a-border);display:flex;gap:8px;">
                <input placeholder="Add sample type…" style="flex:1;border:0.5px solid var(--a-border);border-radius:var(--a-rad-sm);padding:7px 10px;font-size:11px;background:var(--a-bg);" />
                <button class="a-btn"><i class="fas fa-plus"></i> Add</button>
            </div>
        </div>
    </div>

    <!-- Units -->
    <div class="a-card">
        <div class="a-ch">
            <div class="a-ct"><i class="fas fa-ruler"></i> Units of Measurement</div>
            <span class="a-cc">@Model.Units.Count items</span>
        </div>
        <div class="a-cb" style="padding:0">
            <table class="a-table">
                <thead><tr><th>Unit</th><th>Description</th><th>Actions</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Units)
                    {
                        <tr>
                            <td><strong>@u.Name</strong></td>
                            <td>@u.Description</td>
                            <td><button class="a-btn-danger"><i class="fas fa-trash"></i> Delete</button></td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
