@model LabDash.Models.SystemTablesViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "System Tables";
    ViewData["ActivePage"] = "SystemTables";
}

<div class="a-page-title" style="margin-bottom:4px">System Tables 🗃️</div>
<div class="a-page-sub" style="margin-bottom:18px">Manage small reference lookups shared across subsystems</div>

@if (TempData["Error"] != null)
{
    <div class="a-alert a-alert-danger" style="margin-bottom:14px">
        <i class="fas fa-exclamation-triangle"></i> @TempData["Error"]
    </div>
}
@if (TempData["Success"] != null)
{
    <div class="a-alert a-alert-success" style="margin-bottom:14px">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}
<div class="a-alert" style="margin-bottom:14px">
    <i class="fas fa-info-circle"></i>
    Condition, Allergy, and Medication categories are managed on their own pages
    (<a asp-action="Conditions">Conditions</a>, <a asp-action="Allergies">Allergies</a>,
    <a asp-action="Medications">Medications</a>) — this page only covers Sample Types and Units.
</div>

<div class="a-r2">

    @* ================= SAMPLE TYPES ================= *@
    <div class="a-card">
        <div class="a-ch">
            <div class="a-ct"><i class="fas fa-vial"></i> Sample Types</div>
            <span class="a-cc">@Model.SampleTypes.Count items</span>
        </div>
        <div class="a-cb" style="padding:0">
            <table class="a-table">
                <thead><tr><th>Sample Type</th><th style="width:100px">Actions</th></tr></thead>
                <tbody>
                    @foreach (var s in Model.SampleTypes)
                    {
                        <tr>
                            <td>@s.Name</td>
                            <td>
                                <form asp-action="DeleteSampleType" method="post"
                                      onsubmit="return confirm('Delete this sample type? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@s.SampleTypeLookupId" />
                                    <button type="submit" class="a-btn-danger"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <form asp-action="AddSampleType" method="post"
                  style="padding:12px 16px;border-top:0.5px solid var(--a-border);display:flex;gap:8px;">
                <input name="name" required placeholder="Add sample type…"
                       style="flex:1;border:0.5px solid var(--a-border);border-radius:var(--a-rad-sm);padding:7px 10px;font-size:11px;background:var(--a-bg);" />
                <button type="submit" class="a-btn"><i class="fas fa-plus"></i> Add</button>
            </form>
        </div>
    </div>

    @* ================= UNITS ================= *@
    <div class="a-card">
        <div class="a-ch">
            <div class="a-ct"><i class="fas fa-ruler"></i> Units</div>
            <span class="a-cc">@Model.Units.Count items</span>
        </div>
        <div class="a-cb" style="padding:0">
            <table class="a-table">
                <thead><tr><th>Unit</th><th style="width:100px">Actions</th></tr></thead>
                <tbody>
                    @foreach (var u in Model.Units)
                    {
                        <tr>
                            <td>@u.Name</td>
                            <td>
                                <form asp-action="DeleteUnit" method="post"
                                      onsubmit="return confirm('Delete this unit? This cannot be undone.');">
                                    <input type="hidden" name="id" value="@u.UnitId" />
                                    <button type="submit" class="a-btn-danger"><i class="fas fa-trash"></i> Delete</button>
                                </form>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
            <form asp-action="AddUnit" method="post"
                  style="padding:12px 16px;border-top:0.5px solid var(--a-border);display:flex;gap:8px;">
                <input name="name" required placeholder="Add unit (e.g. mg/dL, mmol/L)…"
                       style="flex:1;border:0.5px solid var(--a-border);border-radius:var(--a-rad-sm);padding:7px 10px;font-size:11px;background:var(--a-bg);" />
                <button type="submit" class="a-btn"><i class="fas fa-plus"></i> Add</button>
            </form>
        </div>
    </div>

</div>
