@model LabDash.Models.SystemTablesViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "System Tables";
    ViewData["ActivePage"] = "SystemTables";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="adm-page">

    @if (TempData["Success"] != null)
    {
        <div class="adm-alert">
            <i class="fas fa-circle-check"></i> @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="adm-alert adm-alert-error">
            <i class="fas fa-circle-exclamation"></i> @TempData["Error"]
        </div>
    }

    <!-- PAGE BANNER -->
    <div class="adm-page-banner">
        <div class="adm-page-banner-pattern"></div>

        <div class="adm-page-banner-left">
            <div class="adm-page-banner-icon">
                <i class="fas fa-table-cells"></i>
            </div>

            <div>
                <h1>System Tables</h1>
                <p>Manage small reference lookups shared across subsystems</p>
            </div>
        </div>

        <div class="adm-page-banner-right">
            <div class="adm-mini-stats">

                <div class="adm-mini-stat">
                    <span class="num">@Model.SampleTypes.Count</span>
                    <span class="label">Sample Types</span>
                </div>

                <div class="adm-mini-stat">
                    <span class="num">@Model.Units.Count</span>
                    <span class="label">Units</span>
                </div>

                <div class="adm-mini-stat">
                    <span class="num">
                        @(Model.InactiveSampleTypes.Count + Model.InactiveUnits.Count)
                    </span>
                    <span class="label">Archived</span>
                </div>

            </div>
        </div>
    </div>

    <!-- INFO NOTE -->
    <div class="adm-alert adm-alert-info">
        <i class="fas fa-circle-info"></i>

        Condition, Allergy, and Medication categories are managed on their own pages
        (<a asp-action="Conditions">Conditions</a>,
        <a asp-action="Allergies">Allergies</a>,
        <a asp-action="Medications">Medications</a>)
        — this page only covers Sample Types and Units.
    </div>

    <!-- SAMPLE TYPES + UNITS -->
    <div class="adm-split adm-split-even">

        <!-- ==========================================
             SAMPLE TYPES
        =========================================== -->
        <div class="adm-panel">

            <div class="adm-panel-head">
                <span>
                    <i class="fas fa-vial"></i>
                    Sample Types
                </span>

                <span class="adm-panel-tag">
                    @Model.SampleTypes.Count items
                </span>
            </div>

            <!-- TABS -->
            <div class="adm-tabs">

                <button type="button"
                        class="adm-tab is-active"
                        data-tbody="sampletype-tbody"
                        onclick="switchTab(this, 'sampletype')">

                    Active

                    <span class="adm-tab-count">
                        @Model.SampleTypes.Count
                    </span>

                </button>

                <button type="button"
                        class="adm-tab"
                        data-tbody="sampletype-tbody-archived"
                        onclick="switchTab(this, 'sampletype')">

                    Archived

                    <span class="adm-tab-count">
                        @Model.InactiveSampleTypes.Count
                    </span>

                </button>

            </div>

            <!-- SHOW-ROWS CONTROL -->
            <div class="adm-toolbar-mini">

                <div class="adm-show-control">
                    <span>Show</span>

                    <select id="sampletype-page-size"
                            onchange="changeTablePageSize('sampletype', this)">

                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="15">15</option>
                        <option value="25">25</option>
                        <option value="all">All</option>

                    </select>
                </div>

            </div>

            <!-- TABLE -->
            <div class="adm-table-wrap adm-table-wrap-flush">

                <div class="adm-table-scroll">

                    <table class="adm-table">

                        <thead>
                            <tr>
                                <th>Sample Type</th>
                                <th>Description</th>
                                <th class="adm-th-actions-sm">Actions</th>
                            </tr>
                        </thead>

                        <!-- ACTIVE SAMPLE TYPES -->
                        <tbody id="sampletype-tbody">

                            @foreach (var s in Model.SampleTypes)
                            {
                                <tr>

                                    <td class="adm-td-strong">
                                        @s.Name
                                    </td>

                                    <td class="adm-description">
                                        @(string.IsNullOrWhiteSpace(s.Description)
                                            ? "No description"
                                            : s.Description)
                                    </td>

                                    <td>
                                        <div class="adm-row-actions">

                                            <button type="button"
                                                    class="adm-icon-btn"
                                                    data-type="sampletype"
                                                    data-id="@s.SampleTypeLookupId"
                                                    data-name="@s.Name"
                                                    data-description="@s.Description"
                                                    onclick="openEditModalFromButton(this)">

                                                <i class="fas fa-pen"></i>
                                                Edit

                                            </button>

                                            <form asp-action="DeactivateSampleType"
                                                  method="post"
                                                  class="adm-inline-form-tight">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@s.SampleTypeLookupId" />

                                                <button type="submit"
                                                        class="adm-icon-btn adm-icon-btn-danger">

                                                    <i class="fas fa-box-archive"></i>
                                                    Deactivate

                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                        <!-- ARCHIVED SAMPLE TYPES -->
                        <tbody id="sampletype-tbody-archived"
                               style="display:none;">

                            @foreach (var s in Model.InactiveSampleTypes)
                            {
                                <tr>

                                    <td class="adm-td-strong adm-td-muted">
                                        @s.Name
                                    </td>

                                    <td class="adm-description adm-td-muted">
                                        @(string.IsNullOrWhiteSpace(s.Description)
                                            ? "No description"
                                            : s.Description)
                                    </td>

                                    <td>

                                        <form asp-action="ReactivateSampleType"
                                              method="post"
                                              class="adm-inline-form-tight">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@s.SampleTypeLookupId" />

                                            <button type="submit"
                                                    class="adm-icon-btn adm-icon-btn-restore">

                                                <i class="fas fa-rotate-left"></i>
                                                Reactivate

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- ACTIVE EMPTY STATE -->
                @if (!Model.SampleTypes.Any())
                {
                    <div class="adm-empty-state"
                         id="sampletype-empty-active">

                        <div class="adm-empty-icon">
                            <i class="fas fa-vial"></i>
                        </div>

                        <h5>No sample types yet</h5>

                        <p>
                            Add your first sample type using the form below.
                        </p>

                    </div>
                }

                <!-- ARCHIVED EMPTY STATE -->
                @if (!Model.InactiveSampleTypes.Any())
                {
                    <div class="adm-empty-state"
                         id="sampletype-empty-archived"
                         style="display:none;">

                        <div class="adm-empty-icon">
                            <i class="fas fa-box-archive"></i>
                        </div>

                        <h5>Nothing archived</h5>

                        <p>
                            Sample types you deactivate will appear here
                            and can be reactivated any time.
                        </p>

                    </div>
                }

            </div>

            <!-- PAGINATION -->
            <div class="adm-table-pagination"
                 id="sampletype-pagination">

                <div class="adm-pagination-left">
                    <span id="sampletype-results-info">
                        Showing 0 of 0
                    </span>
                </div>

                <div class="adm-pagination-right">

                    <button type="button"
                            class="adm-page-btn"
                            id="sampletype-prev"
                            onclick="changeTablePage('sampletype', -1)">

                        <i class="fas fa-chevron-left"></i>

                    </button>

                    <span class="adm-page-info"
                          id="sampletype-page-info">
                        Page 1
                    </span>

                    <button type="button"
                            class="adm-page-btn"
                            id="sampletype-next"
                            onclick="changeTablePage('sampletype', 1)">

                        <i class="fas fa-chevron-right"></i>

                    </button>

                </div>

            </div>

            <!-- ADD SAMPLE TYPE -->
            <form asp-action="AddSampleType"
                  method="post"
                  class="adm-add-bar">

                @Html.AntiForgeryToken()

                <input name="name"
                       required
                       placeholder="Add sample type…" />

                <input name="description"
                       placeholder="Description…" />

                <button type="submit"
                        class="adm-btn adm-btn-sm">

                    <i class="fas fa-plus"></i>
                    Add

                </button>

            </form>

        </div>


        <!-- ==========================================
             UNITS
        =========================================== -->
        <div class="adm-panel">

            <div class="adm-panel-head">

                <span>
                    <i class="fas fa-ruler"></i>
                    Units
                </span>

                <span class="adm-panel-tag">
                    @Model.Units.Count items
                </span>

            </div>

            <!-- TABS -->
            <div class="adm-tabs">

                <button type="button"
                        class="adm-tab is-active"
                        data-tbody="unit-tbody"
                        onclick="switchTab(this, 'unit')">

                    Active

                    <span class="adm-tab-count">
                        @Model.Units.Count
                    </span>

                </button>

                <button type="button"
                        class="adm-tab"
                        data-tbody="unit-tbody-archived"
                        onclick="switchTab(this, 'unit')">

                    Archived

                    <span class="adm-tab-count">
                        @Model.InactiveUnits.Count
                    </span>

                </button>

            </div>

            <!-- SHOW-ROWS CONTROL -->
            <div class="adm-toolbar-mini">

                <div class="adm-show-control">
                    <span>Show</span>

                    <select id="unit-page-size"
                            onchange="changeTablePageSize('unit', this)">

                        <option value="5">5</option>
                        <option value="10" selected>10</option>
                        <option value="15">15</option>
                        <option value="25">25</option>
                        <option value="all">All</option>

                    </select>
                </div>

            </div>

            <!-- TABLE -->
            <div class="adm-table-wrap adm-table-wrap-flush">

                <div class="adm-table-scroll">

                    <table class="adm-table">

                        <thead>

                            <tr>

                                <th>Unit</th>

                                <th>Description</th>

                                <th class="adm-th-actions-sm">
                                    Actions
                                </th>

                            </tr>

                        </thead>

                        <!-- ACTIVE UNITS -->
                        <tbody id="unit-tbody">

                            @foreach (var u in Model.Units)
                            {
                                <tr>

                                    <td class="adm-td-strong">
                                        @u.Name
                                    </td>

                                    <td class="adm-description">
                                        @(string.IsNullOrWhiteSpace(u.Description)
                                            ? "No description"
                                            : u.Description)
                                    </td>

                                    <td>
                                        <div class="adm-row-actions">

                                            <button type="button"
                                                    class="adm-icon-btn"
                                                    data-type="unit"
                                                    data-id="@u.UnitId"
                                                    data-name="@u.Name"
                                                    data-description="@u.Description"
                                                    onclick="openEditModalFromButton(this)">

                                                <i class="fas fa-pen"></i>
                                                Edit

                                            </button>

                                            <form asp-action="DeactivateUnit"
                                                  method="post"
                                                  class="adm-inline-form-tight">

                                                @Html.AntiForgeryToken()

                                                <input type="hidden"
                                                       name="id"
                                                       value="@u.UnitId" />

                                                <button type="submit"
                                                        class="adm-icon-btn adm-icon-btn-danger">

                                                    <i class="fas fa-box-archive"></i>
                                                    Deactivate

                                                </button>

                                            </form>

                                        </div>
                                    </td>

                                </tr>
                            }

                        </tbody>

                        <!-- ARCHIVED UNITS -->
                        <tbody id="unit-tbody-archived"
                               style="display:none;">

                            @foreach (var u in Model.InactiveUnits)
                            {
                                <tr>

                                    <td class="adm-td-strong adm-td-muted">
                                        @u.Name
                                    </td>

                                    <td class="adm-description adm-td-muted">
                                        @(string.IsNullOrWhiteSpace(u.Description)
                                            ? "No description"
                                            : u.Description)
                                    </td>

                                    <td>

                                        <form asp-action="ReactivateUnit"
                                              method="post"
                                              class="adm-inline-form-tight">

                                            @Html.AntiForgeryToken()

                                            <input type="hidden"
                                                   name="id"
                                                   value="@u.UnitId" />

                                            <button type="submit"
                                                    class="adm-icon-btn adm-icon-btn-restore">

                                                <i class="fas fa-rotate-left"></i>
                                                Reactivate

                                            </button>

                                        </form>

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>

                <!-- ACTIVE EMPTY STATE -->
                @if (!Model.Units.Any())
                {
                    <div class="adm-empty-state"
                         id="unit-empty-active">

                        <div class="adm-empty-icon">
                            <i class="fas fa-ruler"></i>
                        </div>

                        <h5>No units yet</h5>

                        <p>
                            Add your first unit using the form below.
                        </p>

                    </div>
                }

                <!-- ARCHIVED EMPTY STATE -->
                @if (!Model.InactiveUnits.Any())
                {
                    <div class="adm-empty-state"
                         id="unit-empty-archived"
                         style="display:none;">

                        <div class="adm-empty-icon">
                            <i class="fas fa-box-archive"></i>
                        </div>

                        <h5>Nothing archived</h5>

                        <p>
                            Units you deactivate will appear here
                            and can be reactivated any time.
                        </p>

                    </div>
                }

            </div>

            <!-- PAGINATION -->
            <div class="adm-table-pagination"
                 id="unit-pagination">

                <div class="adm-pagination-left">
                    <span id="unit-results-info">
                        Showing 0 of 0
                    </span>
                </div>

                <div class="adm-pagination-right">

                    <button type="button"
                            class="adm-page-btn"
                            id="unit-prev"
                            onclick="changeTablePage('unit', -1)">

                        <i class="fas fa-chevron-left"></i>

                    </button>

                    <span class="adm-page-info"
                          id="unit-page-info">
                        Page 1
                    </span>

                    <button type="button"
                            class="adm-page-btn"
                            id="unit-next"
                            onclick="changeTablePage('unit', 1)">

                        <i class="fas fa-chevron-right"></i>

                    </button>

                </div>

            </div>

            <!-- ADD UNIT -->
            <form asp-action="AddUnit"
                  method="post"
                  class="adm-add-bar">

                @Html.AntiForgeryToken()

                <input name="name"
                       required
                       placeholder="Add unit (e.g. mg/dL, mmol/L)…" />

                <input name="description"
                       placeholder="Description…" />

                <button type="submit"
                        class="adm-btn adm-btn-sm">

                    <i class="fas fa-plus"></i>
                    Add

                </button>

            </form>

        </div>

    </div>

</div>

<!-- ==========================================
     EDIT MODAL (shared by Sample Types + Units)
=========================================== -->
<div id="editModal" class="adm-modal-overlay" style="display:none;">
    <div class="adm-modal">

        <h3 id="editModalTitle">Edit Item</h3>

        <form id="editModalForm" method="post">

            @Html.AntiForgeryToken()

            <input type="hidden" name="id" id="editModalId" />

            <label for="editModalName">Name</label>
            <input type="text"
                   name="name"
                   id="editModalName"
                   required />

            <label for="editModalDescription">Description</label>
            <input type="text"
                   name="description"
                   id="editModalDescription" />

            <div class="adm-modal-actions">

                <button type="button"
                        class="adm-icon-btn"
                        onclick="closeEditModal()">
                    Cancel
                </button>

                <button type="submit"
                        class="adm-btn adm-btn-sm">
                    Save
                </button>

            </div>

        </form>

    </div>
</div>


@section Scripts {

    <script>

        /* ==========================================================
           PAGINATION / ROW-COUNT STATE
           One shared engine drives both the Sample Types and Units
           tables, keyed by prefix ('sampletype' | 'unit'), so both
           tables behave exactly the same way as the Conditions page.
        ========================================================== */

        var tableState = {
            sampletype: { page: { active: 1, archived: 1 }, pageSize: 10 },
            unit: { page: { active: 1, archived: 1 }, pageSize: 10 }
        };

        function getCurrentType(prefix) {

            var activeTab = document.querySelector(
                '[data-tbody="' + prefix + '-tbody"].is-active, ' +
                '[data-tbody="' + prefix + '-tbody-archived"].is-active'
            );

            if (!activeTab) {
                return 'active';
            }

            return activeTab.dataset.tbody === prefix + '-tbody-archived'
                ? 'archived'
                : 'active';
        }

        function renderTable(prefix) {

            var type = getCurrentType(prefix);

            var tbody = document.getElementById(
                prefix + '-tbody' + (type === 'archived' ? '-archived' : '')
            );

            if (!tbody) {
                return;
            }

            var rows = Array.from(tbody.querySelectorAll('tr'));
            var state = tableState[prefix];

            var allResults = state.pageSize === 'all';
            var pageSize = allResults ? rows.length : state.pageSize;

            if (!pageSize || pageSize < 1) {
                pageSize = 10;
            }

            var totalPages = allResults
                ? 1
                : Math.max(1, Math.ceil(rows.length / pageSize));

            if (state.page[type] > totalPages) {
                state.page[type] = totalPages;
            }

            var currentPage = state.page[type];

            var start = allResults ? 0 : (currentPage - 1) * pageSize;
            var end = allResults ? rows.length : start + pageSize;

            rows.forEach(function(row) {
                row.style.display = 'none';
            });

            rows.slice(start, end).forEach(function(row) {
                row.style.display = '';
            });

            updateTablePagination(
                prefix, rows.length, currentPage, totalPages, allResults, start, end
            );
        }

        function updateTablePagination(prefix, total, currentPage, totalPages, allResults, start, end) {

            var pagination = document.getElementById(prefix + '-pagination');

            if (!pagination) {
                return;
            }

            if (total === 0) {
                pagination.style.display = 'none';
                return;
            }

            if (allResults) {
                start = 0;
                end = total;
            }

            var showingStart = start + 1;
            var showingEnd = Math.min(end, total);

            document.getElementById(prefix + '-results-info').textContent =
                'Showing ' + showingStart + '–' + showingEnd + ' of ' + total;

            document.getElementById(prefix + '-page-info').textContent =
                allResults ? 'All' : 'Page ' + currentPage + ' of ' + totalPages;

            var prevBtn = document.getElementById(prefix + '-prev');
            var nextBtn = document.getElementById(prefix + '-next');

            prevBtn.disabled = allResults || currentPage <= 1;
            nextBtn.disabled = allResults || currentPage >= totalPages;

            pagination.style.display = 'flex';
        }

        function changeTablePage(prefix, direction) {

            var type = getCurrentType(prefix);
            var state = tableState[prefix];

            state.page[type] += direction;

            if (state.page[type] < 1) {
                state.page[type] = 1;
            }

            renderTable(prefix);
        }

        function changeTablePageSize(prefix, selectEl) {

            var value = selectEl.value;

            tableState[prefix].pageSize = value === 'all' ? 'all' : parseInt(value);
            tableState[prefix].page.active = 1;
            tableState[prefix].page.archived = 1;

            renderTable(prefix);
        }


        /* ==========================================================
           TABS
        ========================================================== */

        function switchTab(tabBtn, prefix) {

            var panel = tabBtn.closest('.adm-panel');

            panel.querySelectorAll('.adm-tab')
                .forEach(function(t) {
                    t.classList.remove('is-active');
                });

            tabBtn.classList.add('is-active');

            document.getElementById(prefix + '-tbody').style.display = 'none';

            document.getElementById(prefix + '-tbody-archived').style.display = 'none';

            document.getElementById(tabBtn.dataset.tbody).style.display = '';

            var activeEmpty =
                document.getElementById(prefix + '-empty-active');

            var archivedEmpty =
                document.getElementById(prefix + '-empty-archived');

            if (activeEmpty) {

                activeEmpty.style.display =
                    tabBtn.dataset.tbody === prefix + '-tbody'
                        ? ''
                        : 'none';

            }

            if (archivedEmpty) {

                archivedEmpty.style.display =
                    tabBtn.dataset.tbody === prefix + '-tbody-archived'
                        ? ''
                        : 'none';

            }

            tableState[prefix].page.active = 1;
            tableState[prefix].page.archived = 1;

            renderTable(prefix);
        }

        // ===========================
        // EDIT MODAL
        // ===========================

        var editModalUrls = {
            sampletype: '@Url.Action("EditSampleType", "Admin")',
            unit: '@Url.Action("EditUnit", "Admin")'
        };

        function openEditModalFromButton(btn) {

            var type = btn.dataset.type;
            var id = btn.dataset.id;
            var name = btn.dataset.name;
            var description = btn.dataset.description;

            document.getElementById('editModalId').value = id;
            document.getElementById('editModalName').value = name;
            document.getElementById('editModalDescription').value = description || '';

            document.getElementById('editModalTitle').innerText =
                type === 'sampletype' ? 'Edit Sample Type' : 'Edit Unit';

            document.getElementById('editModalForm').action = editModalUrls[type];

            document.getElementById('editModal').style.display = 'flex';
        }

        function closeEditModal() {
            document.getElementById('editModal').style.display = 'none';
        }

        // Close modal on overlay click (but not when clicking inside the card)
        document.getElementById('editModal').addEventListener('click', function(e) {
            if (e.target === this) {
                closeEditModal();
            }
        });

        // Close modal on Escape key
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                closeEditModal();
            }
        });

        // ===========================
        // INITIALISE
        // ===========================

        document.addEventListener('DOMContentLoaded', function() {
            renderTable('sampletype');
            renderTable('unit');
        });

    </script>

}


<style>

    :root {
        --adm-paper: #F0F7F6;
        --adm-raised: #FFFFFF;
        --adm-ink: #102C27;
        --adm-ink-soft: #52716C;
        --adm-ink-faint: #8FA9A3;
        --adm-line: #E1EEEC;
        --adm-line-strong: #CCE3DF;
        --adm-teal: #0E8C7F;
        --adm-teal-deep: #0A5850;
        --adm-teal-dim: #E3F4F1;
        --adm-teal-grad-start: #12A392;
        --adm-teal-grad-end: #0A4F48;
        --adm-red: #B0463F;
        --adm-red-dim: #F7E8E7;
        --adm-blue: #2E6FA7;
        --adm-blue-dim: #E4EEF7;
        --adm-radius: 20px;
        --adm-radius-sm: 13px;
        --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }


    .adm-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--adm-ink);
        font-family: 'Inter', sans-serif;
    }


    /* ALERTS */

    .adm-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-left: 4px solid var(--adm-teal);
        border-radius: var(--adm-radius-sm);
        padding: 14px 18px;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .adm-alert-error {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-left-color: var(--adm-red);
    }

    .adm-alert-info {
        background: var(--adm-blue-dim);
        color: var(--adm-blue);
        border-left-color: var(--adm-blue);
        font-weight: 500;
    }

        .adm-alert-info a {
            color: var(--adm-blue);
            font-weight: 700;
            text-decoration: underline;
        }


    /* PAGE BANNER */

    .adm-page-banner {
