    .ao-col .adm-insights-track {
        display: block;
        height: 8px;
        border-radius: 99px;
        background: var(--adm-line);
        overflow: hidden;
    }

    .ao-col .adm-insights-fill {
        display: block;
        height: 100%;
        border-radius: 99px;
        background: var(--adm-allergy-accent);
