        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--adm-allergy-accent-dim);
        color: var(--adm-allergy-accent);
        font-size: 13px;
    }

    .ao-queue-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .ao-queue-text strong {
            font-size: 13px;
            font-weight: 600;
        }

        .ao-queue-text small {
            font-size: 12px;
            color: var(--adm-ink-faint);
        }

    .ao-queue-count {
        min-width: 30px;
        padding: 4px 9px;
        border-radius: 8px;
        background: var(--adm-allergy-accent-dim);
        color: var(--adm-allergy-accent);
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .ao-queue-item:hover .ao-queue-text strong {
        color: var(--adm-allergy-accent);
    }

    /* ---------- responsive ---------- */
    @@media (max-width: 1100px) {
        .ao-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ao-metric:nth-child(2n) {
            border-right: 0;
        }

        .ao-metric:nth-child(-n+2) {
            border-bottom: 1px solid var(--adm-line);
        }
    }

    @@media (max-width: 900px) {
        .ao-body {
            grid-template-columns: 1fr;
        }

        .ao-col + .ao-col {
            border-left: 0;
            border-top: 1px solid var(--adm-line);
        }
    }

    @@media (max-width: 760px) {
        .aq-row {
            grid-template-columns: 40px minmax(0, 1fr) auto;
            grid-template-areas: "icon main count" ". state action";
            row-gap: 12px;
            padding: 16px 18px;
        }

        .aq-row-icon {
            grid-area: icon;
        }

        .aq-row-main {
            grid-area: main;
        }

        .aq-count {
            grid-area: count;
        }

        .aq-state {
            grid-area: state;
        }

        .aq-link {
            grid-area: action;
            justify-self: end;
            width: auto;
        }

        .aq-head,
        .ao-head {
            padding: 18px;
        }

        .aq-dupes {
            padding: 16px 18px;
        }

            .aq-dupes ul {
                grid-template-columns: 1fr;
            }

        .ao-col,
        .ao-metric,
        .sec-foot {
            padding-left: 18px;
            padding-right: 18px;
        }
    }

    @@media (max-width: 520px) {
        .ao-metrics {
            grid-template-columns: 1fr;
        }

        .ao-metric {
            border-right: 0;
            border-bottom: 1px solid var(--adm-line);
        }

            .ao-metric:last-child {
                border-bottom: 0;
            }

        .ao-head-actions,
        .aq-head-actions {
            width: 100%;
        }

        .ao-btn,
        .aq-btn {
            flex: 1;
        }

        .ao-col .adm-insights-category-row {
            grid-template-columns: minmax(80px, .9fr) minmax(40px, 1fr) auto;
            gap: 8px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ao-meter-fill,
        .ao-col .adm-insights-fill {
            transition: none;
        }
    }

