    .ao-col .adm-insights-category-value {
        font-size: 12px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--adm-ink-soft);
    }

    .ao-col .adm-insights-empty {
        padding: 24px 10px;
        text-align: center;
        font-size: 12.5px;
        color: var(--adm-ink-faint);
    }

        .ao-col .adm-insights-empty[hidden] {
            display: none;
        }

    /* review queue */
    .ao-queue-item {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto 12px;
        align-items: center;
        gap: 14px;
        width: calc(100% + 20px);
        margin: 0 -10px;
        padding: 13px 10px;
        border: 0;
        border-top: 1px solid var(--adm-line);
        background: transparent;
        color: var(--adm-ink);
        text-align: left;
        cursor: pointer;
        transition: background .15s;
    }

        .ao-queue-item:hover {
            background: var(--adm-paper);
        }

        .ao-queue-item > i {
            font-size: 10px;
            color: var(--adm-ink-faint);
        }

