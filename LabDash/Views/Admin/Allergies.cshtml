        .ao-col .adm-insights-category-row:hover {
            background: var(--adm-paper);
        }

    .ao-col .adm-insights-category-name {
        overflow: hidden;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--adm-ink);
        text-overflow: ellipsis;
