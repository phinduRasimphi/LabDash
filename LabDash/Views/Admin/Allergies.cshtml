@model LabDash.Models.AllergyListViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Allergies";
    ViewData["ActivePage"] = "Allergies";
}

@if (TempData["Success"] != null)
{
    <div class="a-alert">
        <i class="fas fa-check-circle"></i> @TempData["Success"]
    </div>
}

<div class="a-page-header">
    <div>
        <div class="a-page-title">
            <i class="fas fa-allergies"></i> Manage Allergies 🌿
        </div>
        <div class="a-page-sub">Maintain the list of allergies used across the system</div>
    </div>
    <button class="a-btn" onclick="openModal('modal-add')">
        <i class="fas fa-plus"></i> Add Allergy
    </button>
</div>

<!-- Categories Card -->
<div class="a-card">
    <div class="a-ch">
        <div class="a-ct">
            <i class="fas fa-folder"></i> Allergy Categories
        </div>
        <span class="a-cc">@Model.Categories.Count categories</span>
    </div>
    <div class="a-cb">
        <div class="a-chips-row" id="cat-chips">
            @foreach (var cat in Model.Categories)
            {
                <span class="a-chip a-chip-allergy">
                    @cat
                    <span class="a-chip-rm" onclick="removeChip(this)">✕</span>
                </span>
            }
        </div>
        <div class="a-tag-input">
            <input id="new-cat" placeholder="New category name…" />
            <button class="a-btn" type="button" onclick="addChip('cat-chips','new-cat','a-chip a-chip-allergy')">
                <i class="fas fa-plus"></i> Add Category
            </button>
        </div>
    </div>
</div>

<!-- All Allergies Card -->
<div class="a-card">
    <div class="a-ch">
        <div class="a-ct">
            <i class="fas fa-allergies"></i> All Allergies
        </div>
        <span class="a-cc">@Model.Allergies.Count items</span>
    </div>

    <div style="padding: 16px 20px 0;">
        <div class="a-search">
            <input id="allergy-search" placeholder="🔍  Search allergies…" oninput="filterTable('allergy-search','allergy-cat-filter','allergy-tbody')" />
            <select id="allergy-cat-filter" onchange="filterTable('allergy-search','allergy-cat-filter','allergy-tbody')">
                <option value="">All Categories</option>
                @foreach (var cat in Model.Categories)
                {
                    <option value="@cat">@cat</option>
                }
            </select>
        </div>
    </div>

    <table class="a-table">
        <thead>
            <tr>
                <th>Allergy Name</th>
                <th>Category</th>
                <th>Description</th>
                <th>Status</th>
                <th style="width:180px;">Actions</th>
            </tr>
        </thead>

        <tbody>
            @foreach (var item in Model.Allergies)
            {
                <tr>
                    <td>@item.AllergyName</td>

                    <td>
                        <span class="a-badge a-badge-allergy">
                            @item.Category
                        </span>
                    </td>

                    <td>@item.Description</td>

                    <td>
                        @if (item.IsActive)
                        {
                            <span class="badge bg-success">Active</span>
                        }
                        else
                        {
                            <span class="badge bg-danger">Inactive</span>
                        }
                    </td>

                    <td>
                        <button class="a-btn-edit"
                                onclick="openEditModal('@item.AllergyId','@item.AllergyName','@item.Category')">
                            <i class="fas fa-edit"></i> Edit
                        </button>

                        <form asp-action="DeleteAllergy"
                              method="post"
                              style="display:inline;">
                            @Html.AntiForgeryToken()
                            <input type="hidden"
                                   name="id"
                                   value="@item.AllergyId" />

                            <button class="a-btn-danger">
                                <i class="fas fa-trash"></i> Deactivate
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>

    @if (!Model.Allergies.Any())
    {
        <div style="padding:40px;text-align:center;">
            No allergies found.
        </div>
    }

</div>

<!-- ADD MODAL -->
<div class="a-modal-overlay" id="modal-add">
    <div class="a-modal">
        <div class="a-modal-title">
            <span><i class="fas fa-plus-circle" style="color:var(--a-sidebar-bg);margin-right:8px;"></i>Add New Allergy</span>
            <span class="a-modal-close" onclick="closeModal('modal-add')">✕</span>
        </div>
        <form asp-action="AddAllergy" method="post">
            @Html.AntiForgeryToken()
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Allergy Name</label>
                <input name="name" placeholder="e.g. Penicillin" required />
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Category</label>
                <select name="category">
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="a-modal-actions">
                <button type="button" class="a-btn-cancel" onclick="closeModal('modal-add')">Cancel</button>
                <button type="submit" class="a-btn">
                    <i class="fas fa-save"></i> Save Allergy
                </button>
            </div>
        </form>
    </div>
</div>

<!-- EDIT MODAL -->
<div class="a-modal-overlay" id="modal-edit">
    <div class="a-modal">
        <div class="a-modal-title">
            <span><i class="fas fa-edit" style="color:var(--a-blue);margin-right:8px;"></i>Edit Allergy</span>
            <span class="a-modal-close" onclick="closeModal('modal-edit')">✕</span>
        </div>
        <form asp-action="EditAllergy" method="post">
            @Html.AntiForgeryToken()
            <input type="hidden" name="id" id="edit-id" />
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Allergy Name</label>
                <input name="name" id="edit-name" placeholder="e.g. Penicillin" required />
            </div>
            <div class="a-form-group" style="margin-bottom:16px;">
                <label>Category</label>
                <select name="category" id="edit-category">
                    @foreach (var cat in Model.Categories)
                    {
                        <option value="@cat">@cat</option>
                    }
                </select>
            </div>
            <div class="a-modal-actions">
                <button type="button" class="a-btn-cancel" onclick="closeModal('modal-edit')">Cancel</button>
                <button type="submit" class="a-btn">
                    <i class="fas fa-save"></i> Save Changes
                </button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
    <script>
        function openEditModal(id, name, category) {
            document.getElementById('edit-id').value = id;
            document.getElementById('edit-name').value = name;
            var sel = document.getElementById('edit-category');
            for (var i = 0; i < sel.options.length; i++) {
                if (sel.options[i].value === category) { sel.selectedIndex = i; break; }
            }
            openModal('modal-edit');
        }

        function filterTable(searchId, filterId, tbodyId) {
            var q = document.getElementById(searchId).value.toLowerCase();
            var cat = document.getElementById(filterId).value;
            var rows = document.getElementById(tbodyId).querySelectorAll('tr');
            rows.forEach(function(row) {
                var nameMatch = row.dataset.name.includes(q);
                var catMatch = !cat || row.dataset.cat === cat;
                row.style.display = (nameMatch && catMatch) ? '' : 'none';
            });
        }
    </script>
}
