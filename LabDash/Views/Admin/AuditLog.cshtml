@model LabDash.Models.AuditLogViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Audit Log";
    ViewData["ActivePage"] = "AuditLog";

    var roleBreakdown = Model.Entries
        .GroupBy(e => string.IsNullOrWhiteSpace(e.Role) ? "Unspecified" : e.Role)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(g => g.Count)
        .ToList();
    var roleBreakdownMax = roleBreakdown.Any() ? roleBreakdown.Max(b => b.Count) : 0;

    var distinctRoles = Model.Entries
        .Select(e => e.Role)
        .Where(r => !string.IsNullOrWhiteSpace(r))
        .Distinct()
        .OrderBy(r => r)
        .ToList();

    var distinctActions = Model.Entries
        .Select(e => e.Action)
        .Where(a => !string.IsNullOrWhiteSpace(a))
        .Distinct()
        .OrderBy(a => a)
        .ToList();
}

@*
    ============================================================================
    Same "adm-" treatment as Conditions.cshtml / Allergies.cshtml / Medications.cshtml
    / SystemTables.cshtml. This page is read-only (no add/edit/delete — it's a
    log), so no modals, no tabs, no actions column. What was ported/fixed:

      1. The search box and the two <select> filters existed but were never
         wired to anything — no oninput/onchange, no JS at all. Wired them up
         below: text search matches user/action/details, plus role and action
         dropdowns, all combined.
      2. The role/action dropdowns had hardcoded <option> lists (Admin/
         Doctors/Technicians/Patients, Create/Update/Delete/Login) that don't
         necessarily match what's actually in the log. Replaced with options
         built from the distinct values actually present in Model.Entries, so
         the filter never has a dead option or misses a role/action that
         exists but wasn't in the hardcoded list.
      3. Added a "By role" breakdown panel, same pattern as the category
         breakdown on Allergies/Medications, since this page didn't have a
         second column to fill.

    NOTE — not fixable from the view: AdminController.AuditLog() currently
    hardcodes Role = "" for every entry, so every row falls into the
    "Unspecified" bucket below and every badge renders the same color until
    the controller actually populates Role (e.g. from the acting user's
    Identity role, or a Role column on the AuditLog entity itself).
    ============================================================================
*@

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">

<div class="adm-page">

    <!-- ==========================================
        PAGE BANNER
    =========================================== -->
    <div class="adm-page-banner">
        <div class="adm-page-banner-pattern"></div>

        <div class="adm-page-banner-left">
            <div class="adm-page-banner-icon"><i class="fas fa-shield-halved"></i></div>
            <div>
                <h1>Audit Log</h1>
                <p>Recent system activity across all users and roles</p>
            </div>
        </div>

        <div class="adm-page-banner-right">
            <div class="adm-mini-stats">
                <div class="adm-mini-stat">
                    <span class="num">@Model.Entries.Count</span>
                    <span class="label">Entries</span>
                </div>
                <div class="adm-mini-stat">
                    <span class="num">@distinctRoles.Count</span>
                    <span class="label">Roles</span>
                </div>
                <div class="adm-mini-stat">
                    <span class="num">@distinctActions.Count</span>
                    <span class="label">Action Types</span>
                </div>
            </div>
        </div>
    </div>

    <!-- ==========================================
        LOG TABLE + ROLE BREAKDOWN
    =========================================== -->
    <div class="adm-split">

        <!-- Log table -->
        <div class="adm-panel">
            <div class="adm-panel-head">
                <span><i class="fas fa-history"></i> Recent System Activity</span>
                <span class="adm-panel-tag">@Model.Entries.Count entries</span>
            </div>

            <div class="adm-toolbar">
                <div class="adm-search-box">
                    <i class="fas fa-magnifying-glass"></i>
                    <input id="log-search" placeholder="Search logs…" oninput="filterLog()" />
                </div>
                <select id="log-role-filter" onchange="filterLog()">
                    <option value="">All Roles</option>
                    @foreach (var role in distinctRoles)
                    {
                        <option value="@role">@role</option>
                    }
                </select>
                <select id="log-action-filter" onchange="filterLog()">
                    <option value="">All Actions</option>
                    @foreach (var action in distinctActions)
                    {
                        <option value="@action">@action</option>
                    }
                </select>
            </div>

            <div class="adm-table-wrap">
                <table class="adm-table">
                    <thead>
                        <tr>
                            <th>Timestamp</th>
                            <th>User</th>
                            <th>Role</th>
                            <th>Action</th>
                            <th>Details</th>
                        </tr>
                    </thead>
                    <tbody id="log-tbody">
                        @foreach (var e in Model.Entries)
                        {
                            <tr data-user="@((e.User ?? "").ToLower())"
                                data-role="@(e.Role ?? "")"
                                data-action="@(e.Action ?? "")"
                                data-search="@(($"{e.User} {e.Action} {e.Details}").ToLower())">
                                <td class="adm-td-nowrap">@e.Timestamp</td>
                                <td class="adm-td-strong">@e.User</td>
                                <td>
                                    <span class="adm-badge @RoleBadgeClass(e.Role)">
                                        @(string.IsNullOrWhiteSpace(e.Role) ? "Unspecified" : e.Role)
                                    </span>
                                </td>
                                <td>@e.Action</td>
                                <td class="adm-td-muted">@e.Details</td>
                            </tr>
                        }
                    </tbody>
                </table>

                @if (!Model.Entries.Any())
                {
                    <div class="adm-empty-state" id="log-empty">
                        <div class="adm-empty-icon"><i class="fas fa-shield-halved"></i></div>
                        <h5>No activity recorded yet</h5>
                        <p>System actions will appear here as they happen.</p>
                    </div>
                }

                <div class="adm-empty-state" id="log-empty-filtered" style="display:none;">
                    <div class="adm-empty-icon"><i class="fas fa-magnifying-glass"></i></div>
                    <h5>No matching entries</h5>
                    <p>Try adjusting your search or filters.</p>
                </div>
            </div>
        </div>

        <!-- Role breakdown -->
        <div class="adm-panel">
            <div class="adm-panel-head">
                <span><i class="fas fa-chart-simple"></i> By role</span>
            </div>
            <div class="adm-breakdown">
                @if (roleBreakdown.Any())
                {
                    @foreach (var b in roleBreakdown)
                    {
                        var pct = roleBreakdownMax > 0 ? (int)Math.Round((double)b.Count / roleBreakdownMax * 100) : 0;
                        <div class="adm-breakdown-row">
                            <div class="adm-breakdown-label">
                                <span>@b.Name</span>
                                <strong>@b.Count</strong>
                            </div>
                            <div class="adm-breakdown-track">
                                <div class="adm-breakdown-fill @RoleBreakdownFillClass(b.Name)" style="width:@(pct)%;"></div>
                            </div>
                        </div>
                    }
                }
                else
                {
                    <div class="adm-empty-state">
                        <div class="adm-empty-icon"><i class="fas fa-chart-simple"></i></div>
                        <h5>No data yet</h5>
                        <p>Once activity is logged, its spread across roles will show up here.</p>
                    </div>
                }
            </div>
        </div>

    </div>

</div>

@functions {
    // Badge/fill color per role. Falls back to the neutral "unspecified"
    // style for anything that doesn't match a known role — see the note
    // at the top of this file about AdminController.AuditLog() currently
    // leaving Role blank for every entry.
    string RoleBadgeClass(string? role) => role switch
    {
        "Admin" => "adm-badge-admin",
        "Doctor" => "adm-badge-doctor",
        "Technician" => "adm-badge-tech",
        "Patient" => "adm-badge-patient",
        _ => "adm-badge-unspecified"
    };

    string RoleBreakdownFillClass(string role) => role switch
    {
        "Admin" => "adm-fill-admin",
        "Doctor" => "adm-fill-doctor",
        "Technician" => "adm-fill-tech",
        "Patient" => "adm-fill-patient",
        _ => "adm-fill-unspecified"
    };
}

@section Scripts {
    <script>
        function filterLog() {
            var q = document.getElementById('log-search').value.toLowerCase();
            var role = document.getElementById('log-role-filter').value;
            var action = document.getElementById('log-action-filter').value;

            var rows = document.getElementById('log-tbody').querySelectorAll('tr');
            var visibleCount = 0;

            rows.forEach(function(row) {
                var searchMatch = !q || row.dataset.search.includes(q);
                var roleMatch = !role || row.dataset.role === role;
                var actionMatch = !action || row.dataset.action === action;
                var show = searchMatch && roleMatch && actionMatch;
                row.style.display = show ? '' : 'none';
                if (show) visibleCount++;
            });

            var filteredEmpty = document.getElementById('log-empty-filtered');
            if (filteredEmpty) {
                filteredEmpty.style.display = (visibleCount === 0 && rows.length > 0) ? '' : 'none';
            }
        }
    </script>
}

<style>
    :root {
        --adm-paper: #F0F7F6;
        --adm-raised: #FFFFFF;
        --adm-ink: #102C27;
        --adm-ink-soft: #52716C;
        --adm-ink-faint: #8FA9A3;
        --adm-line: #E1EEEC;
        --adm-line-strong: #CCE3DF;
        --adm-teal: #0E8C7F;
        --adm-teal-deep: #0A5850;
        --adm-teal-dim: #E3F4F1;
        --adm-teal-grad-start: #12A392;
        --adm-teal-grad-end: #0A4F48;
        --adm-red: #B0463F;
        --adm-red-dim: #F7E8E7;
        --adm-blue: #2E6FA7;
        --adm-blue-dim: #E4EEF7;
        --adm-purple: #6D4EA8;
        --adm-purple-dim: #EEE8F9;
        --adm-amber: #B0791F;
        --adm-amber-dim: #FBF0DE;
        --adm-radius: 20px;
        --adm-radius-sm: 13px;
        --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }

    .adm-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--adm-ink);
        font-family: 'Inter', sans-serif;
    }

    /* ============ PAGE BANNER ============ */
    .adm-page-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        border-radius: var(--adm-radius);
        padding: 26px 32px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
        flex-wrap: wrap;
    }

    .adm-page-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .adm-page-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .adm-page-banner-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }

    .adm-page-banner-left h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 21px;
        margin: 0 0 3px;
        color: #fff;
    }

    .adm-page-banner-left p {
        margin: 0;
        color: rgba(255,255,255,.85);
        font-size: 13px;
    }

    .adm-page-banner-right {
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
    }

    .adm-mini-stats {
        display: flex;
        gap: 18px;
    }

    .adm-mini-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 58px;
    }

        .adm-mini-stat .num {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #fff;
        }

        .adm-mini-stat .label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: rgba(255,255,255,.75);
            margin-top: 2px;
        }

    /* ============ PANELS ============ */
    .adm-panel {
        background: var(--adm-raised);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .adm-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--adm-line);
    }

        .adm-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .adm-panel-head span:first-child i {
                color: var(--adm-teal);
            }

    .adm-panel-tag {
        font-weight: 600;
        font-size: 11.5px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    /* ============ SPLIT LAYOUT ============ */
    .adm-split {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 18px;
        align-items: start;
    }

    /* ============ TOOLBAR ============ */
    .adm-toolbar {
        display: flex;
        gap: 12px;
        padding: 16px 26px 0;
        flex-wrap: wrap;
    }

    .adm-search-box {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-paper);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
    }

        .adm-search-box i {
            color: var(--adm-ink-faint);
            font-size: 13px;
        }

        .adm-search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            width: 100%;
        }

    .adm-toolbar select {
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        color: var(--adm-ink);
        background: var(--adm-raised);
    }

    /* ============ TABLE ============ */
    .adm-table-wrap {
        padding: 16px 0 6px;
        overflow-x: auto;
    }

    .adm-table {
        width: 100%;
        border-collapse: collapse;
        font-size: 13.5px;
    }

        .adm-table th {
            text-align: left;
            padding: 12px 26px;
            font-weight: 600;
            font-size: 11.5px;
            letter-spacing: .03em;
            text-transform: uppercase;
            color: var(--adm-ink-faint);
            background: var(--adm-paper);
            border-bottom: 1px solid var(--adm-line);
        }

        .adm-table td {
            padding: 14px 26px;
            border-bottom: 1px solid var(--adm-line);
            vertical-align: middle;
        }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

        .adm-table tbody tr:hover {
            background: var(--adm-paper);
        }

    .adm-td-strong {
        font-weight: 600;
    }

    .adm-td-muted {
        color: var(--adm-ink-soft);
        font-size: 12.5px;
    }

    .adm-td-nowrap {
        white-space: nowrap;
        color: var(--adm-ink-soft);
    }

    /* ============ ROLE BADGES ============ */
    .adm-badge {
        display: inline-flex;
        padding: 4px 12px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
    }

    .adm-badge-admin {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
    }

    .adm-badge-doctor {
        background: var(--adm-blue-dim);
        color: var(--adm-blue);
    }

    .adm-badge-tech {
        background: var(--adm-purple-dim);
        color: var(--adm-purple);
    }

    .adm-badge-patient {
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
    }

    .adm-badge-unspecified {
        background: var(--adm-line);
        color: var(--adm-ink-faint);
    }

    /* ============ ROLE BREAKDOWN ============ */
    .adm-breakdown {
        padding: 20px 26px 26px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .adm-breakdown-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

    .adm-breakdown-label {
        display: flex;
        justify-content: space-between;
        font-size: 13px;
        color: var(--adm-ink);
    }

        .adm-breakdown-label strong {
            color: var(--adm-ink-faint);
            font-weight: 700;
        }

    .adm-breakdown-track {
        height: 8px;
        border-radius: 999px;
        background: var(--adm-paper);
        overflow: hidden;
    }

    .adm-breakdown-fill {
        height: 100%;
        border-radius: 999px;
        opacity: .85;
        background: linear-gradient(90deg, var(--adm-teal), var(--adm-teal));
    }

    .adm-fill-admin {
        background: linear-gradient(90deg, var(--adm-teal), var(--adm-teal));
    }

    .adm-fill-doctor {
        background: linear-gradient(90deg, var(--adm-blue), var(--adm-blue));
    }

    .adm-fill-tech {
        background: linear-gradient(90deg, var(--adm-purple), var(--adm-purple));
    }

    .adm-fill-patient {
        background: linear-gradient(90deg, var(--adm-amber), var(--adm-amber));
    }

    .adm-fill-unspecified {
        background: linear-gradient(90deg, var(--adm-ink-faint), var(--adm-ink-faint));
    }

    /* ============ EMPTY STATE ============ */
    .adm-empty-state {
        padding: 48px 30px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .adm-empty-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: var(--adm-teal-dim);
        color: var(--adm-teal);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .adm-empty-state h5 {
        margin: 0;
        font-size: 14.5px;
        font-weight: 700;
    }

    .adm-empty-state p {
        margin: 0;
        max-width: 340px;
        font-size: 13px;
        color: var(--adm-ink-soft);
        line-height: 1.6;
    }

    /* ============ RESPONSIVE ============ */
    @@media (max-width: 1000px) {
        .adm-split {
            grid-template-columns: 1fr;
        }
    }

    @@media (max-width: 640px) {
        .adm-page {
            padding: 20px 16px 50px;
        }

        .adm-page-banner {
            flex-direction: column;
            align-items: flex-start;
        }

        .adm-page-banner-right {
            width: 100%;
            justify-content: space-between;
        }
    }
</style>
