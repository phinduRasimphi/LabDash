        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }



    /* ==========================================================
           SPLIT
        ========================================================== */

    .adm-split {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 18px;
        align-items: start;
    }



    /* ==========================================================
           TOOLBAR
        ========================================================== */

    .adm-toolbar {
        display: flex;
        gap: 12px;
        padding: 16px 26px 0;
        flex-wrap: wrap;
    }



    .adm-search-box {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-paper);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
    }



        .adm-search-box i {
            color: var(--adm-ink-faint);
            font-size: 13px;
        }



        .adm-search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            width: 100%;
        }



    .adm-toolbar select {
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        color: var(--adm-ink);
        background: var(--adm-raised);
    }



    /* ==========================================================
           SHOW ROWS
        ========================================================== */

    .adm-toolbar-mini {
        display: flex;
        justify-content: flex-end;
        padding: 14px 26px 0;
    }



    .adm-show-control {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--adm-ink-soft);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }



        .adm-show-control select {
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 7px 10px;
            min-width: 64px;
            font-size: 12.5px;
            font-family: 'Inter', sans-serif;
            color: var(--adm-ink);
            background: var(--adm-raised);
        }



    /* ==========================================================
           TABLE
        ========================================================== */

    .adm-table-wrap {
        padding: 16px 0 6px;
        overflow-x: auto;
    }



    .adm-table-wrap-flush {
        padding-bottom: 0;
    }



    .adm-table-scroll {
        width: 100%;
        max-width: 100%;
        max-height: 500px;
        overflow-y: auto;
        overflow-x: auto;
