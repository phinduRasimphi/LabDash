        z-index: 1;
        flex-wrap: wrap;
    }



    .adm-mini-stats {
        display: flex;
        gap: 18px;
    }



    .adm-mini-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 58px;
    }



        .adm-mini-stat .num {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 20px;
