@model LabDash.Models.AuditLogViewModel
@{
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
    ViewData["Title"] = "Audit Log";
    ViewData["ActivePage"] = "AuditLog";

    var roleBreakdown = Model.Entries
        .GroupBy(e => string.IsNullOrWhiteSpace(e.Role) ? "Unspecified" : e.Role)
        .Select(g => new { Name = g.Key, Count = g.Count() })
        .OrderByDescending(g => g.Count)
        .ToList();

    var roleBreakdownMax = roleBreakdown.Any()
        ? roleBreakdown.Max(b => b.Count)
        : 0;

    var distinctRoles = Model.Entries
        .Select(e => e.Role)
        .Where(r => !string.IsNullOrWhiteSpace(r))
        .Distinct()
        .OrderBy(r => r)
        .ToList();

    var distinctActions = Model.Entries
        .Select(e => e.Action)
        .Where(a => !string.IsNullOrWhiteSpace(a))
        .Distinct()
        .OrderBy(a => a)
        .ToList();
}

<link rel="preconnect" href="https://fonts.googleapis.com">

<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">


<div class="adm-page">

    <!-- ==========================================================
         PAGE BANNER
    =========================================================== -->

    <div class="adm-page-banner">

        <div class="adm-page-banner-pattern"></div>

        <div class="adm-page-banner-left">

            <div class="adm-page-banner-icon">
                <i class="fas fa-shield-halved"></i>
            </div>

            <div>

                <h1>Audit Log</h1>

                <p>
                    Recent system activity across all users and roles
                </p>

            </div>

        </div>


        <div class="adm-page-banner-right">

            <div class="adm-mini-stats">

                <div class="adm-mini-stat">

                    <span class="num">
                        @Model.Entries.Count
                    </span>

                    <span class="label">
                        Entries
                    </span>

                </div>


                <div class="adm-mini-stat">

                    <span class="num">
                        @distinctRoles.Count
                    </span>

                    <span class="label">
                        Roles
                    </span>

                </div>


                <div class="adm-mini-stat">

                    <span class="num">
                        @distinctActions.Count
                    </span>

                    <span class="label">
                        Action Types
                    </span>

                </div>

            </div>

        </div>

    </div>


    <!-- ==========================================================
         LOG TABLE + ROLE BREAKDOWN
    =========================================================== -->

    <div class="adm-split">


        <!-- ======================================================
             AUDIT LOG TABLE
        ======================================================= -->

        <div class="adm-panel">


            <!-- HEADER -->

            <div class="adm-panel-head">

                <span>

                    <i class="fas fa-history"></i>

                    Recent System Activity

                </span>


                <span class="adm-panel-tag">

                    @Model.Entries.Count entries

                </span>

            </div>



            <!-- ==================================================
                 SEARCH / FILTER TOOLBAR
            =================================================== -->

            <div class="adm-toolbar">


                <!-- SEARCH -->

                <div class="adm-search-box">

                    <i class="fas fa-magnifying-glass"></i>

                    <input id="log-search"
                           type="text"
                           placeholder="Search logs…"
                           oninput="filterLog()" />

                </div>


                <!-- ROLE -->

                <select id="log-role-filter"
                        onchange="filterLog()">

                    <option value="">
                        All Roles
                    </option>

                    @foreach (var role in distinctRoles)
                    {
                        <option value="@role">
                            @role
                        </option>
                    }

                </select>


                <!-- ACTION -->

                <select id="log-action-filter"
                        onchange="filterLog()">

                    <option value="">
                        All Actions
                    </option>

                    @foreach (var action in distinctActions)
                    {
                        <option value="@action">
                            @action
                        </option>
                    }

                </select>


            </div>



            <!-- ==================================================
                 SHOW ROWS
            =================================================== -->

            <div class="adm-toolbar-mini">

                <div class="adm-show-control">

                    <span>
                        Show
                    </span>


                    <select id="audit-page-size"
                            onchange="changeAuditPageSize(this)">

                        <option value="5">
                            5
                        </option>

                        <option value="10" selected>
                            10
                        </option>

                        <option value="15">
                            15
                        </option>

                        <option value="25">
                            25
                        </option>

                        <option value="all">
                            All
                        </option>

                    </select>

                    <span>
                        rows
                    </span>

                </div>

            </div>



            <!-- ==================================================
                 TABLE
            =================================================== -->

            <div class="adm-table-wrap adm-table-wrap-flush">

                <div class="adm-table-scroll">

                    <table class="adm-table">

                        <thead>

                            <tr>

                                <th>
                                    Timestamp
                                </th>

                                <th>
                                    User
                                </th>

                                <th>
                                    Role
                                </th>

                                <th>
                                    Action
                                </th>

                                <th>
                                    Details
                                </th>

                            </tr>

                        </thead>


                        <tbody id="log-tbody">

                            @foreach (var e in Model.Entries)
                            {
                                <tr data-user="@((e.User ?? "").ToLower())"
                                    data-role="@(e.Role ?? "")"
                                    data-action="@(e.Action ?? "")"
                                    data-search="@(($"{e.User} {e.Action} {e.Details}").ToLower())">

                                    <td class="adm-td-nowrap">

                                        @e.Timestamp

                                    </td>


                                    <td class="adm-td-strong">

                                        @e.User

                                    </td>


                                    <td>

                                        <span class="adm-badge @RoleBadgeClass(e.Role)">

                                            @(string.IsNullOrWhiteSpace(e.Role)
                                                ? "Unspecified"
                                                : e.Role)

                                        </span>

                                    </td>


                                    <td>

                                        <span class="adm-action-text">

                                            @e.Action

                                        </span>

                                    </td>


                                    <td class="adm-td-muted">

                                        @e.Details

                                    </td>

                                </tr>
                            }

                        </tbody>

                    </table>

                </div>



                <!-- ==================================================
                     EMPTY DATABASE STATE
                =================================================== -->
                @if (!Model.Entries.Any())
                {
                    <div class="adm-empty-state"
                         id="log-empty">

                        <div class="adm-empty-icon">

                            <i class="fas fa-shield-halved"></i>

                        </div>

                        <h5>
                            No activity recorded yet
                        </h5>

                        <p>
                            System actions will appear here as they happen.
                        </p>

                    </div>
                }


                <!-- ==================================================
                     FILTERED EMPTY STATE
                =================================================== -->

                <div class="adm-empty-state"
                     id="log-empty-filtered"
                     style="display:none;">

                    <div class="adm-empty-icon">

                        <i class="fas fa-magnifying-glass"></i>

                    </div>

                    <h5>
                        No matching entries
                    </h5>

                    <p>
                        Try adjusting your search or filters.
                    </p>

                </div>

            </div>



            <!-- ==================================================
                 PAGINATION
            =================================================== -->

            <div class="adm-table-pagination"
                 id="audit-pagination">


                <div class="adm-pagination-left">

                    <span id="audit-results-info">

                        Showing 0 of 0

                    </span>

                </div>



                <div class="adm-pagination-right">


                    <button type="button"
                            class="adm-page-btn"
                            id="audit-prev"
                            onclick="changeAuditPage(-1)">

                        <i class="fas fa-chevron-left"></i>

                    </button>


                    <span class="adm-page-info"
                          id="audit-page-info">

                        Page 1

                    </span>


                    <button type="button"
                            class="adm-page-btn"
                            id="audit-next"
                            onclick="changeAuditPage(1)">

                        <i class="fas fa-chevron-right"></i>

                    </button>

                </div>

            </div>


        </div>



        <!-- ======================================================
             ROLE BREAKDOWN
        ======================================================= -->

        <div class="adm-panel">


            <div class="adm-panel-head">

                <span>

                    <i class="fas fa-chart-simple"></i>

                    By Role

                </span>

            </div>


            <div class="adm-breakdown">

                @if (roleBreakdown.Any())
                {
                    @foreach (var b in roleBreakdown)
                    {
                        var pct = roleBreakdownMax > 0
                            ? (int)Math.Round(
                                (double)b.Count /
                                roleBreakdownMax *
                                100)
                            : 0;

                        <div class="adm-breakdown-row">


                            <div class="adm-breakdown-label">

                                <span>
                                    @b.Name
                                </span>

                                <strong>
                                    @b.Count
                                </strong>

                            </div>


                            <div class="adm-breakdown-track">

                                <div class="adm-breakdown-fill @RoleBreakdownFillClass(b.Name)"
                                     style="width:@(pct)%;">
                                </div>

                            </div>

                        </div>
                    }
                }
                else
                {
                    <div class="adm-empty-state">

                        <div class="adm-empty-icon">

                            <i class="fas fa-chart-simple"></i>

                        </div>

                        <h5>
                            No data yet
                        </h5>

                        <p>
                            Once activity is logged, its spread across roles
                            will show up here.
                        </p>

                    </div>
                }

            </div>

        </div>

    </div>

</div>



@functions
{

    string RoleBadgeClass(string? role) => role switch
    {
        "Admin" => "adm-badge-admin",

        "Doctor" => "adm-badge-doctor",

        "Technician" => "adm-badge-tech",

        "Patient" => "adm-badge-patient",

        _ => "adm-badge-unspecified"
    };


    string RoleBreakdownFillClass(string role) => role switch
    {
        "Admin" => "adm-fill-admin",

        "Doctor" => "adm-fill-doctor",

        "Technician" => "adm-fill-tech",

        "Patient" => "adm-fill-patient",

        _ => "adm-fill-unspecified"
    };

}



@section Scripts
{

    <script>

        /* ==========================================================
           AUDIT LOG TABLE STATE
        ========================================================== */

        var auditState = {

            page: 1,

            pageSize: 10,

            filteredRows: []

        };



        /* ==========================================================
           GET ALL TABLE ROWS
        ========================================================== */

        function getAuditRows() {

            var tbody =
                document.getElementById('log-tbody');

            if (!tbody) {
                return [];
            }

            return Array.from(
                tbody.querySelectorAll('tr')
            );

        }



        /* ==========================================================
           FILTER LOG
        ========================================================== */

        function filterLog() {

            var searchInput =
                document.getElementById('log-search');

            var roleSelect =
                document.getElementById('log-role-filter');

            var actionSelect =
                document.getElementById('log-action-filter');


            var q =
                searchInput.value
                    .toLowerCase()
                    .trim();


            var role =
                roleSelect.value;


            var action =
                actionSelect.value;


            var rows =
                getAuditRows();


            auditState.filteredRows =
                rows.filter(function(row) {

                    var searchText =
                        row.dataset.search || "";


                    var rowRole =
                        row.dataset.role || "";


                    var rowAction =
                        row.dataset.action || "";


                    var searchMatch =
                        !q ||
                        searchText.includes(q);


                    var roleMatch =
                        !role ||
                        rowRole === role;


                    var actionMatch =
                        !action ||
                        rowAction === action;


                    return (
                        searchMatch &&
                        roleMatch &&
                        actionMatch
                    );

                });


            /*
             * Reset to first page whenever
             * the filter changes.
             */

            auditState.page = 1;


            renderAuditTable();

        }



        /* ==========================================================
           RENDER TABLE
        ========================================================== */

        function renderAuditTable() {

            var allRows =
                getAuditRows();


            var filteredRows =
                auditState.filteredRows;


            /*
             * If no filter has been run yet,
             * use every row.
             */

            if (
                !filteredRows ||
                filteredRows.length === 0
            ) {

                var search =
                    document
                        .getElementById('log-search')
                        .value
                        .trim();


                var role =
                    document
                        .getElementById('log-role-filter')
                        .value;


                var action =
                    document
                        .getElementById('log-action-filter')
                        .value;


                if (
                    !search &&
                    !role &&
                    !action
                ) {

                    filteredRows =
                        allRows;

                    auditState.filteredRows =
                        allRows;

                }

            }


            var total =
                filteredRows.length;


            var pageSize =
                auditState.pageSize;


            /*
             * ALL
             */

            if (pageSize === 'all') {

                allRows.forEach(function(row) {
                    row.style.display = 'none';
                });


                filteredRows.forEach(function(row) {
                    row.style.display = '';
                });


                updateAuditPagination(
                    total,
                    1,
                    1,
                    true
                );

            }

            /*
             * NORMAL PAGINATION
             */

            else {

                var size =
                    parseInt(pageSize);


                var totalPages =
                    Math.max(
                        1,
                        Math.ceil(total / size)
                    );


                if (
                    auditState.page >
                    totalPages
                ) {

                    auditState.page =
                        totalPages;

                }


                var start =
                    (auditState.page - 1) *
                    size;


                var end =
                    Math.min(
                        start + size,
                        total
                    );


                /*
                 * Hide every row first.
                 */

                allRows.forEach(function(row) {
                    row.style.display = 'none';
                });


                /*
                 * Show only rows
                 * belonging to current page.
                 */

                filteredRows
                    .slice(start, end)
                    .forEach(function(row) {
                        row.style.display = '';
                    });


                updateAuditPagination(
                    total,
                    auditState.page,
                    totalPages,
                    false,
                    start,
                    end
                );

            }


            /*
             * FILTERED EMPTY STATE
             */

            var filteredEmpty =
                document.getElementById(
                    'log-empty-filtered'
                );


            if (filteredEmpty) {

                filteredEmpty.style.display =
                    total === 0 &&
                        allRows.length > 0
                        ? ''
                        : 'none';

            }

        }



        /* ==========================================================
           UPDATE PAGINATION UI
        ========================================================== */

        function updateAuditPagination(
            total,
            currentPage,
            totalPages,
            allResults,
            start,
            end
        ) {

            var pagination =
                document.getElementById(
                    'audit-pagination'
                );


            if (!pagination) {
                return;
            }


            /*
             * No records.
             */

            if (total === 0) {

                pagination.style.display =
                    'none';

                return;

            }


            if (allResults) {

                start = 0;

                end = total;

            }


            var showingStart =
                total === 0
                    ? 0
                    : start + 1;


            var showingEnd =
                Math.min(
                    end,
                    total
                );


            document.getElementById(
                'audit-results-info'
            ).textContent =
                'Showing ' +
                showingStart +
                '–' +
                showingEnd +
                ' of ' +
                total;


            document.getElementById(
                'audit-page-info'
            ).textContent =
                allResults
                    ? 'All'
                    : 'Page ' +
                    currentPage +
                    ' of ' +
                    totalPages;


            var prev =
                document.getElementById(
                    'audit-prev'
                );


            var next =
                document.getElementById(
                    'audit-next'
                );


            prev.disabled =
                allResults ||
                currentPage <= 1;


            next.disabled =
                allResults ||
                currentPage >= totalPages;


            pagination.style.display =
                'flex';

        }



        /* ==========================================================
           PREVIOUS / NEXT
        ========================================================== */

        function changeAuditPage(direction) {

            if (
                auditState.pageSize === 'all'
            ) {
                return;
            }


            auditState.page +=
                direction;


            if (auditState.page < 1) {

                auditState.page = 1;

            }


            renderAuditTable();

        }



        /* ==========================================================
           CHANGE PAGE SIZE
        ========================================================== */

        function changeAuditPageSize(select) {

            var value =
                select.value;


            if (value === 'all') {

                auditState.pageSize =
                    'all';

            }
            else {

                auditState.pageSize =
                    parseInt(value);

            }


            auditState.page = 1;


            renderAuditTable();

        }



        /* ==========================================================
           INITIALISE
        ========================================================== */

        document.addEventListener(
            'DOMContentLoaded',
            function() {

                /*
                 * Start with every row available.
                 */

                auditState.filteredRows =
                    getAuditRows();


                /*
                 * Render first page.
                 */

                renderAuditTable();

            }
        );

    </script>

}



<style>

    :root {
        --adm-paper: #F0F7F6;
        --adm-raised: #FFFFFF;
        --adm-ink: #102C27;
        --adm-ink-soft: #52716C;
        --adm-ink-faint: #8FA9A3;
        --adm-line: #E1EEEC;
        --adm-line-strong: #CCE3DF;
        --adm-teal: #0E8C7F;
        --adm-teal-deep: #0A5850;
        --adm-teal-dim: #E3F4F1;
        --adm-teal-grad-start: #12A392;
        --adm-teal-grad-end: #0A4F48;
        --adm-red: #B0463F;
        --adm-red-dim: #F7E8E7;
        --adm-blue: #2E6FA7;
        --adm-blue-dim: #E4EEF7;
        --adm-purple: #6D4EA8;
        --adm-purple-dim: #EEE8F9;
        --adm-amber: #B0791F;
        --adm-amber-dim: #FBF0DE;
        --adm-radius: 20px;
        --adm-radius-sm: 13px;
        --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }



