        /* ==========================================================
           MEDICATION FILTER + PAGINATION
        ========================================================== */

        function getCurrentMedicationBody() {
            var selectedTab = document.querySelector(
                '.adm-split > .adm-panel:first-child .adm-tabs .adm-tab.is-active'
            );
            if (!selectedTab) return null;
            return document.getElementById(selectedTab.dataset.tbody);
        }

        function getCurrentMedicationType() {
            var activeTab = document.querySelector(
                '.adm-split > .adm-panel:first-child .adm-tabs .adm-tab.is-active'
            );
            if (!activeTab) return 'active';
            return activeTab.dataset.tbody === 'medication-tbody-archived' ? 'archived' : 'active';
        }

        function filterActiveTable() {
            var tbody = getCurrentMedicationBody();
            if (!tbody) return;

            var type = getCurrentMedicationType();
            medicationPages[type] = 1;

            renderMedications();
        }

        function highlightName(row, query) {
            var cell = row.children[0];
            if (!cell) return;

            if (cell.dataset.orig === undefined) cell.dataset.orig = cell.textContent.trim();
            var text = cell.dataset.orig;

            var idx = query ? text.toLowerCase().indexOf(query) : -1;

            if (idx < 0) {
                if (cell.querySelector('mark')) cell.textContent = text;
                return;
            }

            cell.textContent = '';
            cell.appendChild(document.createTextNode(text.slice(0, idx)));

            var m = document.createElement('mark');
            m.className = 'adm-mark';
            m.textContent = text.slice(idx, idx + query.length);
            cell.appendChild(m);

            cell.appendChild(document.createTextNode(text.slice(idx + query.length)));
        }

        function renderMedications() {
            var tbody = getCurrentMedicationBody();
            if (!tbody) return;

            var type = getCurrentMedicationType();

            var query = document.getElementById('medication-search').value.toLowerCase().trim();
            var category = document.getElementById('medication-cat-filter').value;

            var rows = Array.from(tbody.querySelectorAll('tr'));

            var matchingRows = rows.filter(function(row) {
                var name = row.dataset.name || '';
                var rowCategory = row.dataset.cat || '';
                var nameMatch = name.includes(query);
                var categoryMatch = !category ||
                    (category === '__none__' ? rowCategory === '' : rowCategory === category);
                var descMatch = !medFlags.noDesc || row.dataset.nodesc === '1';
                var pinMatch = !medFlags.pinned || row.dataset.pinned === '1';
                var strengthMatch = !medFlags.noStrength || !row.dataset.strength;
                var formMatch = !medFlags.form || row.dataset.form === medFlags.form;
                return nameMatch && categoryMatch && descMatch && pinMatch && strengthMatch && formMatch;
            });

            lastMatching = matchingRows;

            rows.forEach(function(row) { highlightName(row, ''); });
            if (query) matchingRows.forEach(function(row) { highlightName(row, query); });

            var pageSizeValue = document.getElementById('medication-page-size').value;
            var allResults = pageSizeValue === 'all';
            var pageSize = allResults ? matchingRows.length : parseInt(pageSizeValue);
            if (pageSize < 1) pageSize = 5;

            var totalPages = allResults
                ? 1
                : Math.max(1, Math.ceil(matchingRows.length / pageSize));

            if (medicationPages[type] > totalPages) {
                medicationPages[type] = totalPages;
            }

            var currentPage = medicationPages[type];
            var start = allResults ? 0 : (currentPage - 1) * pageSize;
            var end = allResults ? matchingRows.length : start + pageSize;

            rows.forEach(function(row) { row.style.display = 'none'; });

            matchingRows.slice(start, end).forEach(function(row) {
                row.style.display = '';
            });

            updateMedicationPagination(matchingRows.length, currentPage, totalPages, allResults, start, end);
            updateFilterState();
        }

        function updateMedicationPagination(total, currentPage, totalPages, allResults, start, end) {
            var pagination = document.getElementById('medication-pagination');
            var noResults = document.getElementById('medication-no-results');

            if (total === 0) {
                if (pagination) pagination.style.display = 'none';

                // only say "no matching" when the tab actually has rows to match against
                var body = getCurrentMedicationBody();
                var hasRows = body && body.querySelectorAll('tr').length > 0;
                if (noResults) noResults.style.display = hasRows ? '' : 'none';
                return;
            }

            if (noResults) noResults.style.display = 'none';

            if (allResults) {
                start = 0;
                end = total;
            }

            var showingStart = total === 0 ? 0 : start + 1;
            var showingEnd = Math.min(end, total);

            document.getElementById('medication-results-info').textContent =
                'Showing ' + showingStart + '\u2013' + showingEnd + ' of ' + total;

            document.getElementById('medication-page-info').textContent =
                allResults ? 'All' : 'Page ' + currentPage + ' of ' + totalPages;

            var previous = document.getElementById('medication-prev');
            var next = document.getElementById('medication-next');

            previous.disabled = allResults || currentPage <= 1;
            next.disabled = allResults || currentPage >= totalPages;

            pagination.style.display = totalPages <= 1 ? 'none' : 'flex';
        }

        function changeMedicationPage(direction) {
            var type = getCurrentMedicationType();
            medicationPages[type] += direction;
            if (medicationPages[type] < 1) medicationPages[type] = 1;
            renderMedications();
        }

        function changePageSize() {
            medicationPages.active = 1;
            medicationPages.archived = 1;

            try {
                localStorage.setItem('medicationPageSize', document.getElementById('medication-page-size').value);
            } catch (e) { }

            renderMedications();
        }


        /* ==========================================================
           SORTING
        ========================================================== */

        function cellText(row, col) {
            var c = row.children[col];
            if (!c) return '';
            return (c.dataset.orig !== undefined ? c.dataset.orig : c.textContent).trim();
        }

        function sortMedications(th) {
            var col = parseInt(th.dataset.col, 10);

            sortState.dir = sortState.col === col ? -sortState.dir : 1;
            sortState.col = col;

            document.querySelectorAll('.adm-sortable').forEach(function(h) {
                h.classList.remove('is-asc', 'is-desc');
            });
            th.classList.add(sortState.dir === 1 ? 'is-asc' : 'is-desc');

            ['medication-tbody', 'medication-tbody-archived'].forEach(function(id) {
                var tb = document.getElementById(id);
                if (!tb) return;

                var rows = Array.from(tb.querySelectorAll('tr'));
                rows.sort(function(a, b) {
                    var av = cellText(a, col);
                    var bv = cellText(b, col);

                    // blanks always go last
                    if (!av && bv) return 1;
                    if (av && !bv) return -1;

                    return av.localeCompare(bv, undefined, { sensitivity: 'base', numeric: true }) * sortState.dir;
                });
                rows.forEach(function(r) { tb.appendChild(r); });
            });

            medicationPages.active = 1;
            medicationPages.archived = 1;
            renderMedications();
        }


