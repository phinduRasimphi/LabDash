@section Scripts {
    <script>

        /* ==========================================================
           GLOBAL STATE
        ========================================================== */

        var medicationPages = { active: 1, archived: 1 };
        var categoryPages = { active: 1, archived: 1 };
        var categoryPageSize = 6;

        var medFlags = { noDesc: false, pinned: false, noStrength: false, form: '' };
        var sortState = { col: -1, dir: 1 };
        var lastMatching = [];
        var currentDetailRow = null;
        var pinnedIds = {};
        var PIN_KEY = 'medicationPins';
        var fmState = { showAll: false };


        /* ==========================================================
           MEDICATION NAME PARSER (strength, dosage form, drug family)
           Runs in the browser on the names already on the page.
        ========================================================== */

        var STRENGTH_RE = /\d+(?:[.,]\d+)?\s?(?:mg|mcg|\u00B5g|ug|kg|g|ml|iu|units?|%)(?:\s?\/\s?\d*(?:[.,]\d+)?\s?(?:mg|mcg|g|ml|l|dose|actuation))?/gi;

        var FORM_MAP = {
            tablets: 'Tablet', tablet: 'Tablet', tabs: 'Tablet', tab: 'Tablet',
            capsules: 'Capsule', capsule: 'Capsule', caps: 'Capsule', cap: 'Capsule',
            syrup: 'Liquid', suspension: 'Liquid', solution: 'Liquid', drops: 'Liquid', liquid: 'Liquid',
            injection: 'Injection', injectable: 'Injection', inj: 'Injection',
            cream: 'Topical', ointment: 'Topical', gel: 'Topical', lotion: 'Topical',
            inhaler: 'Inhaled', spray: 'Inhaled',
            sachet: 'Sachet', suppository: 'Suppository', patch: 'Patch'
        };

        function parseMedicationName(name) {
            var raw = String(name || '');
            var strengths = (raw.match(STRENGTH_RE) || []).map(function(s) {
                return s.replace(/\s+/g, '').toLowerCase();
            });

            var form = '';
            var base = raw.replace(STRENGTH_RE, ' ').replace(/[()\[\],]/g, ' ');

            Object.keys(FORM_MAP).forEach(function(word) {
                var re = new RegExp('\\b' + word + '\\b', 'gi');
                if (re.test(base)) {
                    if (!form) form = FORM_MAP[word];
                    base = base.replace(new RegExp('\\b' + word + '\\b', 'gi'), ' ');
                }
            });

            base = base.replace(/\s+/g, ' ').trim().toLowerCase();

            return { strengths: strengths, form: form, base: base };
        }

        function titleCase(text) {
            return String(text).replace(/\b\w/g, function(c) { return c.toUpperCase(); });
        }

        function annotateRows() {
            document.querySelectorAll('#medication-tbody tr, #medication-tbody-archived tr').forEach(function(row) {
                var info = parseMedicationName(row.children[0].textContent.trim());
                row.dataset.base = info.base;
                row.dataset.strength = info.strengths.join('|');
                row.dataset.form = info.form;
            });
        }

        function activeMedRows() {
            return Array.from(document.querySelectorAll('#medication-tbody tr'));
        }

        function rowCategoryLabel(row) {
            return (row.dataset.cat || '').trim() || 'Uncategorized';
        }


        /* ==========================================================
           MODALS
        ========================================================== */

        function openModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.add('is-open');
            document.body.style.overflow = 'hidden';

            if (id === 'modal-add') {
                var w = document.getElementById('add-name-warn');
                if (w) w.style.display = 'none';
            }

            var first = el.querySelector('input:not([type=hidden]), select');
            if (first) setTimeout(function() { first.focus(); }, 50);
        }

        function closeModal(id) {
            var el = document.getElementById(id);
            if (!el) return;
            el.classList.remove('is-open');
            document.body.style.overflow = '';
        }

        document.querySelectorAll('.adm-modal-overlay').forEach(function(overlay) {
            overlay.addEventListener('click', function(e) {
                if (e.target === overlay) closeModal(overlay.id);
            });
        });

        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {

                // a confirmation popup is open: let it handle Escape on its own
                var pp = document.getElementById('ppOverlay');
                if (pp && !pp.hidden) return;

                document.querySelectorAll('.adm-modal-overlay.is-open').forEach(function(o) {
                    closeModal(o.id);
                });
            }
        });

        /* keyboard shortcuts: "/" focuses search, "N" opens Add Medication */
        document.addEventListener('keydown', function(e) {
            if (e.ctrlKey || e.metaKey || e.altKey) return;

            var t = e.target;
            var tag = (t.tagName || '').toLowerCase();
            if (tag === 'input' || tag === 'textarea' || tag === 'select' || t.isContentEditable) return;

            if (document.querySelector('.adm-modal-overlay.is-open')) return;

            var pp = document.getElementById('ppOverlay');
            if (pp && !pp.hidden) return;

            if (e.key === '/') {
                e.preventDefault();
                document.getElementById('medication-search').focus();
            } else if (e.key === 'n' || e.key === 'N') {
                e.preventDefault();
                openModal('modal-add');
            }
        });


        /* ==========================================================
           EDIT MEDICATION
        ========================================================== */

        function openEditModalFromButton(btn) {
            document.getElementById('edit-id').value = btn.dataset.id;
            document.getElementById('edit-name').value = btn.dataset.name;
            document.getElementById('edit-description').value = btn.dataset.description || '';

            var warn = document.getElementById('edit-name-warn');
            if (warn) warn.style.display = 'none';

            var select = document.getElementById('edit-category');
            for (var i = 0; i < select.options.length; i++) {
                if (select.options[i].value === String(btn.dataset.category)) {
                    select.selectedIndex = i;
                    break;
                }
            }

            openModal('modal-edit');
        }


        /* ==========================================================
           DUPLICATE NAME / SAME-FAMILY WARNING (soft, never blocks saving)
        ========================================================== */

        function checkDuplicateName(input, warnId, excludeId) {
            var warn = document.getElementById(warnId);
            if (!warn) return;

            var val = input.value.trim().toLowerCase();
            if (!val) { warn.style.display = 'none'; return; }

            var hit = null;
            var info = parseMedicationName(input.value.trim());
            var familyStrengths = [];

            document.querySelectorAll('#medication-tbody tr, #medication-tbody-archived tr').forEach(function(r) {
                var idInput = r.querySelector('input[name="id"]');
                var isSelf = excludeId && idInput && idInput.value === String(excludeId);
                if (isSelf) return;

                if ((r.dataset.name || '') === val) {
                    hit = r.parentElement.id === 'medication-tbody' ? 'active' : 'archived';
                    return;
                }

                if (info.base && r.dataset.base === info.base && r.parentElement.id === 'medication-tbody') {
                    familyStrengths.push(cellText(r, 0));
                }
            });

            if (hit === 'active') {
                warn.textContent = 'An active medication with this name already exists.';
                warn.style.display = '';
            } else if (hit === 'archived') {
                warn.textContent = 'This name is in the Archived tab. Consider reactivating it instead.';
                warn.style.display = '';
            } else if (familyStrengths.length) {
                var shown = familyStrengths.slice(0, 3).join(', ');
                var more = familyStrengths.length > 3 ? ' and ' + (familyStrengths.length - 3) + ' more' : '';
                warn.textContent = 'Same drug already listed: ' + shown + more + '.';
                warn.style.display = '';
            } else {
                warn.style.display = 'none';
            }
        }


        /* ==========================================================
           ROW DETAILS MODAL
        ========================================================== */

        function openDetails(row) {
            currentDetailRow = row;

            var nameCell = row.children[0];
            var name = nameCell.dataset.orig !== undefined ? nameCell.dataset.orig : nameCell.textContent.trim();
            var category = row.children[1].textContent.trim();
            var description = row.children[2].textContent.trim();
            var isArchived = row.parentElement.id === 'medication-tbody-archived';
            var strength = (row.dataset.strength || '').split('|').filter(Boolean).join(', ');

            document.getElementById('det-name').textContent = name;
            document.getElementById('det-category').textContent = category;
            document.getElementById('det-strength').textContent = strength || 'Not stated in the name';
            document.getElementById('det-form').textContent = row.dataset.form || 'Not stated in the name';
            document.getElementById('det-status').textContent = isArchived ? 'Archived' : 'Active';
            document.getElementById('det-pinned').textContent = row.dataset.pinned === '1' ? 'Yes' : 'No';

            var descEl = document.getElementById('det-description');
