        /* ==========================================================
           CSV HELPERS + EXPORT FILTERED LIST
        ========================================================== */

        function csvCell(value) {
            var s = String(value == null ? '' : value);

            // stop spreadsheet apps treating text as a formula
            var danger = ['=', '+', '-', '\u0040'];
            if (s.length && danger.indexOf(s.charAt(0)) !== -1) s = "'" + s;

            return '"' + s.replace(/"/g, '""') + '"';
        }

        function downloadCsv(lines, fileName) {
            var blob = new Blob(['\uFEFF' + lines.join('\r\n')], { type: 'text/csv;charset=utf-8;' });
            var url = URL.createObjectURL(blob);

            var a = document.createElement('a');
            a.href = url;
            a.download = fileName + '-' + new Date().toISOString().slice(0, 10) + '.csv';
            document.body.appendChild(a);
            a.click();
            document.body.removeChild(a);

            setTimeout(function() { URL.revokeObjectURL(url); }, 500);
        }

        function exportMedicationsCsv() {
            if (!lastMatching.length) return;

            var type = getCurrentMedicationType();
            var status = type === 'archived' ? 'Archived' : 'Active';

            var lines = [['Medication Name', 'Category', 'Description', 'Status'].map(csvCell).join(',')];

            lastMatching.forEach(function(row) {
                lines.push([
                    cellText(row, 0),
                    cellText(row, 1),
                    cellText(row, 2),
                    status
                ].map(csvCell).join(','));
            });

            downloadCsv(lines, 'medications-' + type);
        }

        function exportMedicationsPdf() {
            var url = '@Url.Action("DownloadMedicationsPdf")' +
                '?status=' + encodeURIComponent(getCurrentMedicationType()) +
                '&category=' + encodeURIComponent(document.getElementById('medication-cat-filter').value) +
                '&q=' + encodeURIComponent(document.getElementById('medication-search').value.trim()) +
                '&noDesc=' + (medFlags.noDesc ? 'true' : 'false');
            window.location.href = url;
        }
        /* ==========================================================
           CATEGORY TABS
        ========================================================== */

        function switchCatTab(tabBtn) {
            var panel = tabBtn.closest('.adm-panel');

            panel.querySelectorAll('.adm-tabs .adm-tab').forEach(function(tab) {
                tab.classList.remove('is-active');
            });
