        /* ==========================================================
           CATEGORY FILTER + PAGINATION
        ========================================================== */

        function filterCatChips() {
            var activeTab = document.querySelector('.adm-panel .adm-tabs .adm-tab.is-active[data-target]');
            if (!activeTab) return;

            var container = document.getElementById(activeTab.dataset.target);
            if (!container) return;

            var search = document.getElementById('cat-search').value.toLowerCase().trim();
            var type = activeTab.dataset.target === 'cat-chips-archived' ? 'archived' : 'active';

            var forms = Array.from(container.querySelectorAll('.adm-chip-form'));
            var matching = forms.filter(function(form) {
                return (form.dataset.name || '').includes(search);
            });

            categoryPages[type] = Math.min(
                categoryPages[type],
                Math.max(1, Math.ceil(matching.length / categoryPageSize))
            );

            var currentPage = categoryPages[type];
            var start = (currentPage - 1) * categoryPageSize;
            var end = start + categoryPageSize;

            forms.forEach(function(form) { form.style.display = 'none'; });
            matching.slice(start, end).forEach(function(form) { form.style.display = ''; });

            updateCategoryPagination(matching.length, currentPage, type);
        }

        function updateCategoryPagination(total, currentPage, type) {
            var pagination = document.getElementById('category-pagination');

            pagination.style.display = total === 0 ? 'none' : 'flex';

            var totalPages = Math.max(1, Math.ceil(total / categoryPageSize));

            document.getElementById('cat-page-info').textContent =
                'Page ' + currentPage + ' of ' + totalPages;

            document.getElementById('cat-prev').disabled = currentPage <= 1;
            document.getElementById('cat-next').disabled = currentPage >= totalPages;
        }

        function changeCategoryPage(direction) {
            var activeTab = document.querySelector('.adm-panel .adm-tabs .adm-tab.is-active[data-target]');
            if (!activeTab) return;

            var type = activeTab.dataset.target === 'cat-chips-archived' ? 'archived' : 'active';

            categoryPages[type] += direction;
            if (categoryPages[type] < 1) categoryPages[type] = 1;

            filterCatChips();
        }


        /* ==========================================================
           QUALITY CHECK + REGISTER INSIGHTS (client-side only)
        ========================================================== */

        function loadPrefs() {
            try {
                var saved = localStorage.getItem('medicationPageSize');
                if (!saved) return;

                var select = document.getElementById('medication-page-size');
                for (var i = 0; i < select.options.length; i++) {
                    if (select.options[i].value === saved) {
                        select.value = saved;
                        break;
                    }
                }
            } catch (e) { }
        }

        function setQualityState(countId, value) {
            var el = document.getElementById(countId);
            var row = el ? el.closest('.aq-row') : null;
            if (row) row.dataset.state = value > 0 ? 'warn' : 'ok';
        }

        function escapeQualityText(value) {
            return String(value).replace(/[&<>\"']/g, function(char) {
                return { '&': '&amp;', '<': '&lt;', '>': '&gt;', '\"': '&quot;', "'": '&#39;' }[char];
            });
        }

        function refreshMedicationQualityCheck() {
            var activeRows = activeMedRows();
            var missingDescriptions = activeRows.filter(function(row) { return row.dataset.nodesc === '1'; }).length;
            var uncategorized = activeRows.filter(function(row) { return !((row.dataset.cat || '').trim()); }).length;
            var noStrength = activeRows.filter(function(row) { return !row.dataset.strength; }).length;
            var names = {};

            activeRows.forEach(function(row) {
                var name = (row.dataset.name || '').trim().toLocaleLowerCase();
                if (!name) return;
                if (!names[name]) names[name] = { label: cellText(row, 0) || name, count: 0 };
                names[name].count++;
            });

            var duplicates = Object.keys(names).filter(function(name) { return names[name].count > 1; })
                .map(function(name) { return names[name]; })
                .sort(function(a, b) { return a.label.localeCompare(b.label); });

            document.getElementById('quality-missing-description').textContent = missingDescriptions;
            document.getElementById('quality-uncategorized').textContent = uncategorized;
            document.getElementById('quality-nostrength').textContent = noStrength;
            document.getElementById('quality-duplicate-count').textContent = duplicates.length;
            setQualityState('quality-missing-description', missingDescriptions);
            setQualityState('quality-uncategorized', uncategorized);
            setQualityState('quality-nostrength', noStrength);
            setQualityState('quality-duplicate-count', duplicates.length);

            var issueCount = (missingDescriptions > 0 ? 1 : 0) + (uncategorized > 0 ? 1 : 0) +
                (noStrength > 0 ? 1 : 0) + (duplicates.length > 0 ? 1 : 0);
            var summary = document.getElementById('quality-summary');
            if (summary) {
                summary.dataset.state = issueCount ? 'warn' : 'ok';
                summary.querySelector('.aq-summary-text').textContent = issueCount
                    ? issueCount + (issueCount === 1 ? ' check needs review' : ' checks need review')
                    : 'All checks clear';
            }

            var detail = document.getElementById('quality-duplicate-details');
            if (duplicates.length === 0) {
                detail.innerHTML = '<div class="adm-quality-clean"><i class="fas fa-circle-check"></i><span>No repeated medication names were found in the active register.</span></div>';
            } else {
                detail.innerHTML = '<strong>Names to review</strong><ul>' + duplicates.map(function(item) {
                    return '<li><span></span>' + escapeQualityText(item.label) + ' <small>appears ' + item.count + ' times</small></li>';
                }).join('') + '</ul>';
            }
        }

        function toggleMedicationDuplicateDetails() {
            var detail = document.getElementById('quality-duplicate-details');
            refreshMedicationQualityCheck();
            detail.hidden = !detail.hidden;
            var button = document.getElementById('quality-duplicates-toggle');
            if (button) button.innerHTML = detail.hidden ? 'Check names <i class="fas fa-chevron-down"></i>' : 'Hide names <i class="fas fa-chevron-up"></i>';
            if (!detail.hidden) detail.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
        }

        function reviewMedicationsWithoutDescriptions() {
            showActiveMedicationTab();
            clearMedicationFilters();
            toggleNoDesc(true);
        }

        function reviewMedicationsWithoutStrength() {
            showActiveMedicationTab();
            clearMedicationFilters();
            toggleNoStrength(true);
        }

        function reviewUncategorizedMedications() {
            showActiveMedicationTab();
            clearMedicationFilters();
            document.getElementById('medication-cat-filter').value = '__none__';
            medicationPages.active = 1;
            renderMedications();
            scrollToMedicationTable();
        }

        function medicationInsightRows(bodyId) {
            var body = document.getElementById(bodyId);
            return body ? Array.from(body.querySelectorAll('tr')) : [];
        }

        function refreshMedicationInsights() {
            var activeRows = medicationInsightRows('medication-tbody');
            var archivedRows = medicationInsightRows('medication-tbody-archived');
            var categorized = activeRows.filter(function(row) { return (row.dataset.cat || '').trim() !== ''; }).length;
            var described = activeRows.filter(function(row) { return row.dataset.nodesc !== '1'; }).length;
            var activeTotal = activeRows.length;
            var categoryCounts = {};

            activeRows.forEach(function(row) {
                var category = rowCategoryLabel(row);
                categoryCounts[category] = (categoryCounts[category] || 0) + 1;
            });

            var seenNames = {};
            activeRows.forEach(function(row) {
                var name = (row.dataset.name || '').trim().toLocaleLowerCase();
                if (!name) return;
                seenNames[name] = (seenNames[name] || 0) + 1;
            });
            var duplicateCount = Object.keys(seenNames).filter(function(name) { return seenNames[name] > 1; }).length;

            var catPct = activeTotal ? Math.round(categorized / activeTotal * 100) : 0;
            var descPct = activeTotal ? Math.round(described / activeTotal * 100) : 0;

            document.getElementById('insight-total-records').textContent = activeTotal + archivedRows.length;
            document.getElementById('insight-category-coverage').textContent = catPct + '%';
            document.getElementById('insight-description-coverage').textContent = descPct + '%';
            document.getElementById('insight-description-sub').textContent = described + ' of ' + activeTotal + ' active records have descriptions';
            document.getElementById('insight-category-sub').textContent = categorized + ' of ' + activeTotal + ' active records assigned to a category';
            document.getElementById('insight-archived-records').textContent = archivedRows.length;
            document.getElementById('insight-category-meter').style.width = catPct + '%';
            document.getElementById('insight-description-meter').style.width = descPct + '%';
            document.getElementById('insight-review-missing').textContent = activeRows.filter(function(row) { return row.dataset.nodesc === '1'; }).length;
            document.getElementById('insight-review-uncategorized').textContent = activeRows.filter(function(row) { return !(row.dataset.cat || '').trim(); }).length;
            document.getElementById('insight-review-duplicates').textContent = duplicateCount;
            document.getElementById('insight-review-archived').textContent = archivedRows.length;
            updatePinnedCount();

            var list = document.getElementById('medication-insights-category-list');
            var empty = document.getElementById('medication-insights-category-empty');
            list.textContent = '';

            var entries = Object.keys(categoryCounts).map(function(name) { return { name: name, count: categoryCounts[name] }; })
                .sort(function(a, b) { return b.count - a.count || a.name.localeCompare(b.name); });
            empty.hidden = entries.length > 0;

            entries.forEach(function(entry) {
                list.appendChild(buildBarRow(entry.name, entry.count, activeTotal, function() { filterByCategory(entry.name); },
                    'Filter active medications by ' + entry.name));
            });
        }

        function buildBarRow(labelText, count, total, onClick, title) {
            var row = document.createElement('button');
            row.type = 'button';
            row.className = 'adm-insights-category-row';
            row.title = title;
            row.addEventListener('click', onClick);

            var label = document.createElement('span');
            label.className = 'adm-insights-category-name';
            label.textContent = labelText;

            var track = document.createElement('span');
            track.className = 'adm-insights-track';
            var fill = document.createElement('span');
            fill.className = 'adm-insights-fill';
            fill.style.width = (total ? count / total * 100 : 0) + '%';
            track.appendChild(fill);

            var value = document.createElement('strong');
            value.className = 'adm-insights-category-value';
            value.textContent = count + ' \u00B7 ' + (total ? Math.round(count / total * 100) : 0) + '%';

            row.appendChild(label);
            row.appendChild(track);
            row.appendChild(value);
            return row;
        }

        function showMedicationDuplicateReview() {
            toggleMedicationDuplicateDetails();
            var detail = document.getElementById('quality-duplicate-details');
            if (detail) detail.scrollIntoView({ behavior: 'smooth', block: 'center' });
        }

        function showArchivedMedications() {
            var archivedTab = document.querySelector('.adm-tab[data-tbody="medication-tbody-archived"]');
            if (archivedTab) {
                switchTab(archivedTab);
                scrollToMedicationTable();
            }
        }

        function downloadMedicationAuditReport() {
            var lines = [['Medication Name', 'Category', 'Description', 'Status', 'Strength', 'Form', 'Review Note'].map(csvCell).join(',')];
            [['medication-tbody', 'Active'], ['medication-tbody-archived', 'Archived']].forEach(function(config) {
                medicationInsightRows(config[0]).forEach(function(row) {
                    var issues = [];
                    if (config[1] === 'Active' && row.dataset.nodesc === '1') issues.push('Missing description');
                    if (config[1] === 'Active' && !(row.dataset.cat || '').trim()) issues.push('Uncategorized');
                    if (config[1] === 'Active' && !row.dataset.strength) issues.push('No strength in name');
                    lines.push([
                        cellText(row, 0),
                        cellText(row, 1),
                        cellText(row, 2),
                        config[1],
                        (row.dataset.strength || '').split('|').filter(Boolean).join(' / '),
                        row.dataset.form || '',
                        issues.join('; ') || 'No basic completeness issue detected'
                    ].map(csvCell).join(','));
                });
            });

            downloadCsv(lines, 'medication-register-audit');
        }

        function printMedicationInsights() {
            var activeRows = medicationInsightRows('medication-tbody');
            var archivedRows = medicationInsightRows('medication-tbody-archived');
            var categorized = activeRows.filter(function(row) { return (row.dataset.cat || '').trim(); }).length;
            var described = activeRows.filter(function(row) { return row.dataset.nodesc !== '1'; }).length;
            var categories = {};
            activeRows.forEach(function(row) {
                var name = rowCategoryLabel(row);
                categories[name] = (categories[name] || 0) + 1;
            });

            var win = window.open('', '_blank', 'width=900,height=700');
            if (!win) {
                alert('Please allow pop-ups to print the medication overview.');
                return;
            }

            // Build the print document with DOM APIs. Keeping markup out of a long
            // JavaScript string avoids Razor/HTML parser collisions in this view.
            var doc = win.document;
            doc.open();
            doc.close();
            doc.title = 'Medication Register Overview';

            var style = doc.createElement('style');
            style.textContent = 'body{font:14px Arial,sans-serif;color:#18312f;padding:28px}h1{margin-bottom:4px}p{color:#526762}.stats{display:flex;gap:12px;flex-wrap:wrap;margin:22px 0}.stat{border:1px solid #cfdcea;border-radius:8px;padding:12px 16px;min-width:130px}.stat strong{display:block;font-size:24px;margin-top:6px}table{width:100%;border-collapse:collapse;margin-top:12px}th,td{text-align:left;border-bottom:1px solid #cfdcea;padding:10px}th{background:#eaf1f8}@@media print{button{display:none}}';
            doc.head.appendChild(style);

            var heading = doc.createElement('h1');
            heading.textContent = 'Medication Register Overview';
            doc.body.appendChild(heading);

            var generated = doc.createElement('p');
            generated.textContent = 'Generated locally on ' + new Date().toLocaleString() + '. Based on records rendered on the Manage Medications page.';
            doc.body.appendChild(generated);

            var stats = doc.createElement('div');
            stats.className = 'stats';
            function addStat(label, value) {
                var item = doc.createElement('div');
                item.className = 'stat';
                item.appendChild(doc.createTextNode(label));
                var strong = doc.createElement('strong');
                strong.textContent = value;
                item.appendChild(strong);
                stats.appendChild(item);
            }
            addStat('Total records', activeRows.length + archivedRows.length);
            addStat('Active', activeRows.length);
            addStat('Archived', archivedRows.length);
            addStat('Category coverage', (activeRows.length ? Math.round(categorized / activeRows.length * 100) : 0) + '%');
            addStat('Description coverage', (activeRows.length ? Math.round(described / activeRows.length * 100) : 0) + '%');
            doc.body.appendChild(stats);

            var subheading = doc.createElement('h2');
            subheading.textContent = 'Active category distribution';
            doc.body.appendChild(subheading);

            var table = doc.createElement('table');
            var thead = doc.createElement('thead');
            var headerRow = doc.createElement('tr');
            ['Category', 'Active records'].forEach(function(label) {
                var th = doc.createElement('th');
                th.textContent = label;
                headerRow.appendChild(th);
            });
            thead.appendChild(headerRow);
            table.appendChild(thead);

            var tbody = doc.createElement('tbody');
            Object.keys(categories).sort(function(a, b) { return a.localeCompare(b); }).forEach(function(name) {
                var row = doc.createElement('tr');
                var categoryCell = doc.createElement('td');
                categoryCell.textContent = name;
                var countCell = doc.createElement('td');
                countCell.textContent = categories[name];
                row.appendChild(categoryCell);
                row.appendChild(countCell);
                tbody.appendChild(row);
            });
            table.appendChild(tbody);
            doc.body.appendChild(table);

            var note = doc.createElement('p');
            note.textContent = 'Completeness indicators are administrative checks only and do not assess clinical suitability.';
            doc.body.appendChild(note);

            var printButton = doc.createElement('button');
            printButton.textContent = 'Print this overview';
            printButton.addEventListener('click', function() { win.print(); });
            doc.body.appendChild(printButton);
            win.focus();
        }


        /* ==========================================================
           FORMULARY EXPLORER (medications only, client-side)
        ========================================================== */

        function buildFamilies() {
            var map = {};

            activeMedRows().forEach(function(row) {
                var base = row.dataset.base || '';
                if (!base) return;

                var fam = map[base];
                if (!fam) {
                    fam = map[base] = { key: base, label: titleCase(base), rows: [], cats: {}, missingStrength: 0 };
                }

                fam.rows.push(row);
                fam.cats[rowCategoryLabel(row)] = true;
                if (!row.dataset.strength) fam.missingStrength++;
            });

            return Object.keys(map).map(function(k) {
                var fam = map[k];
                fam.catCount = Object.keys(fam.cats).length;
                return fam;
            }).sort(function(a, b) {
                return b.rows.length - a.rows.length || a.label.localeCompare(b.label);
            });
        }

        function refreshFormulary() {
            var families = buildFamilies();
            var activeRows = activeMedRows();

            var multi = families.filter(function(f) { return f.rows.length > 1; }).length;
            var split = families.filter(function(f) { return f.catCount > 1; }).length;
            var noStrength = activeRows.filter(function(r) { return !r.dataset.strength; }).length;

            document.getElementById('fm-families').textContent = families.length;
            document.getElementById('fm-multi').textContent = multi;
            document.getElementById('fm-nostrength').textContent = noStrength;
            document.getElementById('fm-split').textContent = split;

            renderFormularyFamilies(families);
            renderFormMix(activeRows);
        }

        function showFamilyInTable(key) {
            showActiveMedicationTab();
            clearMedicationFilters();

            var first = String(key).split(' ')[0] || key;
            document.getElementById('medication-search').value = first;
            medicationPages.active = 1;
            renderMedications();
            scrollToMedicationTable();
        }

        function renderFormularyFamilies(families) {
            families = families || buildFamilies();

            var filter = document.getElementById('fm-filter').value;
            var list = document.getElementById('fm-family-list');
            var empty = document.getElementById('fm-family-empty');
            var moreBtn = document.getElementById('fm-more');
            list.textContent = '';

            var shown = families.filter(function(f) {
                if (filter === 'multi') return f.rows.length > 1;
                if (filter === 'split') return f.catCount > 1;
                if (filter === 'nostrength') return f.missingStrength > 0;
                return true;
            });

            empty.hidden = shown.length > 0;

            var limit = 6;
            var visible = fmState.showAll ? shown : shown.slice(0, limit);

            visible.forEach(function(fam) {
                var item = document.createElement('div');
                item.className = 'fm-item';

                var head = document.createElement('div');
                head.className = 'fm-item-head';

                var title = document.createElement('div');
                title.className = 'fm-item-title';
                var strong = document.createElement('strong');
                strong.textContent = fam.label;
                var meta = document.createElement('small');
                meta.textContent = fam.rows.length + (fam.rows.length === 1 ? ' entry' : ' entries') +
                    ' \u00B7 ' + fam.catCount + (fam.catCount === 1 ? ' category' : ' categories');
                title.appendChild(strong);
                title.appendChild(meta);

                var btn = document.createElement('button');
                btn.type = 'button';
                btn.className = 'fm-show';
                btn.innerHTML = 'Show in table <i class="fas fa-chevron-right"></i>';
                btn.addEventListener('click', function() { showFamilyInTable(fam.key); });

                head.appendChild(title);
                head.appendChild(btn);
                item.appendChild(head);

                var chips = document.createElement('div');
                chips.className = 'fm-chips';
                fam.rows.forEach(function(row) {
                    var chip = document.createElement('span');
                    var s = (row.dataset.strength || '').split('|').filter(Boolean).join(' / ');
                    chip.className = 'fm-chip' + (s ? '' : ' is-missing');
                    chip.textContent = (s || 'no strength') + (row.dataset.form ? ' \u00B7 ' + row.dataset.form : '');
                    chips.appendChild(chip);
                });
                item.appendChild(chips);

                if (fam.catCount > 1) {
                    var cats = document.createElement('div');
                    cats.className = 'fm-cats';
                    cats.textContent = 'Filed under: ' + Object.keys(fam.cats).sort().join(', ');
                    item.appendChild(cats);
                }

                list.appendChild(item);
            });

            if (shown.length > limit) {
                moreBtn.style.display = '';
                moreBtn.textContent = fmState.showAll ? 'Show fewer' : 'Show all ' + shown.length + ' families';
            } else {
                moreBtn.style.display = 'none';
            }
        }

        function renderFormMix(activeRows) {
            var counts = {};
            var detected = 0;

            activeRows.forEach(function(row) {
                var f = row.dataset.form;
                if (!f) return;
                counts[f] = (counts[f] || 0) + 1;
                detected++;
            });

            var list = document.getElementById('fm-form-list');
            var empty = document.getElementById('fm-form-empty');
            list.textContent = '';

            var entries = Object.keys(counts).map(function(k) { return { name: k, count: counts[k] }; })
                .sort(function(a, b) { return b.count - a.count || a.name.localeCompare(b.name); });

            empty.hidden = entries.length > 0;

            entries.forEach(function(entry) {
                list.appendChild(buildBarRow(entry.name, entry.count, activeRows.length,
                    function() { filterByForm(entry.name); }, 'Filter the table by ' + entry.name));
            });

            if (entries.length && detected < activeRows.length) {
                var rest = document.createElement('div');
                rest.className = 'fm-rest';
                rest.textContent = (activeRows.length - detected) + ' active ' +
                    (activeRows.length - detected === 1 ? 'name has' : 'names have') + ' no dosage form in the name.';
                list.appendChild(rest);
            }
        }

        function downloadFormularyCsv() {
            var lines = [['Drug Family', 'Entries', 'Names', 'Strengths', 'Forms', 'Categories'].map(csvCell).join(',')];

            buildFamilies().forEach(function(fam) {
                var strengths = {};
                var forms = {};
                fam.rows.forEach(function(row) {
                    (row.dataset.strength || '').split('|').filter(Boolean).forEach(function(s) { strengths[s] = true; });
                    if (row.dataset.form) forms[row.dataset.form] = true;
                });

                lines.push([
                    fam.label,
                    fam.rows.length,
                    fam.rows.map(function(r) { return cellText(r, 0); }).join('; '),
                    Object.keys(strengths).join('; '),
                    Object.keys(forms).join('; '),
                    Object.keys(fam.cats).sort().join('; ')
                ].map(csvCell).join(','));
            });

            downloadCsv(lines, 'medication-formulary');
        }


        /* ==========================================================
           INITIALISE
        ========================================================== */

        document.addEventListener('DOMContentLoaded', function() {

            annotateRows();
            loadPins();
            paintAllPins();

            refreshMedicationQualityCheck();
            refreshMedicationInsights();
            refreshFormulary();
            loadPrefs();
            bindRowClicks();

            // Esc inside the search box clears it
            document.getElementById('medication-search').addEventListener('keydown', function(e) {
                if (e.key === 'Escape' && this.value) {
                    this.value = '';
                    filterActiveTable();
                    e.stopPropagation();
                }
            });

            filterCatChips();
            renderMedications();
        });

    </script>
}


@section Head {
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <style>

    /* ==========================================================
               VARIABLES: blue stays fixed for medications, everything
               else matches the shared admin page look.
            ========================================================== */

    :root {
        --adm-paper: #F0F7F6;
        --adm-raised: #FFFFFF;
        --adm-ink: #102C27;
        --adm-ink-soft: #52716C;
        --adm-ink-faint: #8FA9A3;
        --adm-line: #E1EEEC;
        --adm-line-strong: #CCE3DF;
        --adm-teal: #0E8C7F;
        --adm-teal-deep: #0A5850;
        --adm-teal-dim: #E3F4F1;
        --adm-teal-grad-start: #12A392;
        --adm-teal-grad-end: #0A4F48;
        --adm-red: #B0463F;
        --adm-red-dim: #F7E8E7;
        --adm-amber: #94650A;
        --adm-amber-dim: #FFF3D6;
        --adm-blue: #2E6FA7;
        --adm-blue-dim: #E4EEF7;
        --adm-med-accent: var(--adm-blue);
        --adm-med-accent-dim: var(--adm-blue-dim);
        --adm-med-accent-deep: #1F5282;
        --adm-radius: 20px;
        --adm-radius-sm: 13px;
        --adm-shadow: 0 6px 24px rgba(10, 60, 55, 0.08);
        --adm-shadow-sm: 0 3px 10px rgba(10, 60, 55, 0.06);
    }


    /* PAGE */
    .adm-page {
        max-width: 1280px;
        margin: 0 auto;
        padding: 26px 24px 60px;
        color: var(--adm-ink);
        font-family: 'Inter', sans-serif;
    }

    /* ALERTS */
    .adm-alert {
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-left: 4px solid var(--adm-teal);
        border-radius: var(--adm-radius-sm);
        padding: 14px 18px;
        font-size: 13.5px;
        font-weight: 600;
        margin-bottom: 18px;
    }

    .adm-alert-error {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-left-color: var(--adm-red);
    }

    /* PAGE BANNER */
    .adm-page-banner {
        position: relative;
        display: flex;
        justify-content: space-between;
        align-items: center;
        gap: 24px;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        border-radius: var(--adm-radius);
        padding: 26px 32px;
        margin-bottom: 22px;
        box-shadow: 0 18px 40px rgba(10, 90, 80, 0.2);
        overflow: hidden;
        flex-wrap: wrap;
    }

    .adm-page-banner-pattern {
        position: absolute;
        inset: 0;
        background-image: radial-gradient(circle at 85% 20%, rgba(255,255,255,.10) 0, transparent 45%), radial-gradient(circle at 95% 85%, rgba(255,255,255,.08) 0, transparent 40%);
        pointer-events: none;
    }

    .adm-page-banner-left {
        display: flex;
        align-items: center;
        gap: 18px;
        position: relative;
        z-index: 1;
    }

    .adm-page-banner-icon {
        width: 58px;
        height: 58px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        border: 2px solid rgba(255,255,255,.32);
        display: flex;
        align-items: center;
        justify-content: center;
        color: #fff;
        font-size: 22px;
        flex-shrink: 0;
    }

    .adm-page-banner-left h1 {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 21px;
        margin: 0 0 3px;
        color: #fff;
    }

    .adm-page-banner-left p {
        margin: 0;
        color: rgba(255,255,255,.85);
        font-size: 13px;
    }

    .adm-page-banner-right {
        display: flex;
        align-items: center;
        gap: 20px;
        position: relative;
        z-index: 1;
        flex-wrap: wrap;
    }

    .adm-mini-stats {
        display: flex;
        gap: 18px;
    }

    .adm-mini-stat {
        display: flex;
        flex-direction: column;
        align-items: center;
        min-width: 58px;
    }

        .adm-mini-stat .num {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 20px;
            color: #fff;
        }

        .adm-mini-stat .label {
            font-size: 10.5px;
            text-transform: uppercase;
            letter-spacing: .04em;
            color: rgba(255,255,255,.75);
            margin-top: 2px;
        }

    /* BUTTONS */
    .adm-btn {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        color: #fff;
        border: none;
        border-radius: var(--adm-radius-sm);
        padding: 11px 20px;
        font-family: 'Inter', sans-serif;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
        box-shadow: 0 8px 20px rgba(10, 90, 80, 0.22);
        transition: transform .15s, box-shadow .15s;
    }

        .adm-btn:hover {
            transform: translateY(-2px);
            box-shadow: 0 12px 26px rgba(10, 90, 80, 0.28);
        }

    .adm-btn-sm {
        padding: 9px 16px;
        font-size: 12.5px;
        flex-shrink: 0;
    }

    .adm-btn-light {
        background: #fff;
        color: var(--adm-teal-deep);
        box-shadow: 0 8px 20px rgba(0,0,0,0.12);
    }

        .adm-btn-light:hover {
            box-shadow: 0 12px 24px rgba(0,0,0,0.16);
        }

    .adm-btn-cancel {
        background: var(--adm-paper);
        color: var(--adm-ink-soft);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 11px 20px;
        font-weight: 600;
        font-size: 13.5px;
        cursor: pointer;
    }


    /* ==========================================================
       INSIGHTS STRIP — MEDICATION BLUE THEME
       ========================================================== */

    .adm-insights {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        gap: 16px;
        margin-bottom: 22px;
    }

    .adm-insight {
        display: flex;
        align-items: center;
        gap: 14px;
        text-align: left;
        font-family: 'Inter', sans-serif;
        background: #fff;
        color: var(--adm-ink);
        border: 1px solid #bfdbfe;
        border-radius: var(--adm-radius);
        box-shadow: 0 4px 12px rgba(37, 99, 235, 0.08);
        padding: 16px 18px;
        cursor: pointer;
        transition: transform .15s, border-color .15s, box-shadow .15s;
        min-width: 0;
    }

        .adm-insight:hover:not(:disabled):not(.adm-insight-static) {
            transform: translateY(-2px);
            border-color: #3b82f6;
            box-shadow: 0 6px 16px rgba(37, 99, 235, 0.14);
        }

        .adm-insight:focus-visible {
            outline: 2px solid #2563eb;
            outline-offset: 2px;
        }

        .adm-insight:disabled,
        .adm-insight-static {
            cursor: default;
        }

    .adm-insight-icon {
        width: 42px;
        height: 42px;
        border-radius: 13px;
        background: #dbeafe;
        color: #1d4ed8;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 16px;
        flex-shrink: 0;
    }

    .adm-insight.is-warn .adm-insight-icon {
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
    }

    .adm-insight-body {
        display: flex;
        flex-direction: column;
        min-width: 0;
    }

    .adm-insight-label {
        font-size: 10.5px;
        font-weight: 600;
        letter-spacing: .04em;
        text-transform: uppercase;
        color: #64748b;
    }

    .adm-insight-value {
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 17px;
        color: #1e40af;
        overflow: hidden;
        text-overflow: ellipsis;
        white-space: nowrap;
        margin: 2px 0 1px;
    }

    .adm-insight-sub {
        font-size: 11.5px;
        color: #3b82f6;
    }

    @@media (max-width: 1000px) {
        .adm-insights {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }
    }

    @@media (max-width: 640px) {
        .adm-insights {
            grid-template-columns: 1fr;
        }
    }

    /* PANELS */
    .adm-panel {
        background: var(--adm-raised);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        overflow: hidden;
        margin-bottom: 22px;
    }

    .adm-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--adm-line);
    }

        .adm-panel-head span:first-child {
            font-family: 'Poppins', sans-serif;
            font-weight: 700;
            font-size: 15.5px;
            display: flex;
            align-items: center;
            gap: 10px;
        }

            .adm-panel-head span:first-child i {
                color: var(--adm-teal);
            }

    .adm-panel-tag {
        font-weight: 600;
        font-size: 11.5px;
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        padding: 6px 13px;
        border-radius: 999px;
    }

    .adm-panel-body {
        padding: 20px 26px 24px;
    }

    /* SPLIT */
    .adm-split {
        display: grid;
        grid-template-columns: 1.7fr 1fr;
        gap: 18px;
        align-items: start;
    }

    /* CATEGORY CHIPS: fixed blue */
    .adm-chips-container {
        margin-bottom: 12px;
        min-height: 54px;
    }

    .adm-chips-row {
        display: flex;
        flex-wrap: wrap;
        gap: 10px;
        min-height: 48px;
    }

    .adm-chip-form {
        display: inline-flex;
    }

    .adm-chip {
        display: inline-flex;
        align-items: center;
        gap: 4px;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        border: 1px solid transparent;
        padding: 8px 10px 8px 14px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 700;
        transition: transform .18s, box-shadow .18s;
        animation: admGlowPulseBlue 2.8s ease-in-out infinite;
    }

        .adm-chip:hover {
            transform: translateY(-2px);
        }

    .adm-chip-name {
        white-space: nowrap;
    }

    /* the category name is clickable (opens the actions popup) */
    button.adm-chip-name {
        background: transparent;
        border: none;
        padding: 0;
        color: inherit;
        font: inherit;
        cursor: pointer;
    }

        button.adm-chip-name:hover {
            text-decoration: underline;
        }

    .adm-chip-rm {
        background: transparent;
        border: none;
        padding: 3px 4px;
        margin-left: 4px;
        cursor: pointer;
        color: inherit;
        opacity: .55;
        display: inline-flex;
        align-items: center;
        justify-content: center;
    }

        .adm-chip-rm:hover {
            opacity: 1;
        }

    .adm-chip-muted {
        opacity: .55;
        animation: none;
    }

        .adm-chip-muted:hover {
            opacity: .8;
        }

    .adm-cat-search {
        margin-bottom: 14px;
    }

    .adm-hint {
        color: var(--adm-ink-faint);
        font-size: 13px;
        margin: 12px 0;
    }

    /* TABS */
    .adm-tabs {
        display: flex;
        gap: 6px;
        padding: 16px 26px 0;
    }

    .adm-tab {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        background: transparent;
        border: none;
        border-bottom: 2px solid transparent;
        color: var(--adm-ink-soft);
        font-weight: 600;
        font-size: 13.5px;
        padding: 10px 6px;
        cursor: pointer;
        margin-right: 18px;
    }

        .adm-tab.is-active {
            color: var(--adm-teal-deep);
            border-bottom-color: var(--adm-teal);
        }

    .adm-tab-count {
        background: var(--adm-paper);
        color: var(--adm-ink-faint);
        font-size: 11px;
        padding: 2px 8px;
        border-radius: 999px;
    }

    .adm-tab.is-active .adm-tab-count {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
    }

    /* TOOLBAR */
    .adm-toolbar {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 16px 26px 0;
        flex-wrap: wrap;
    }

    .adm-search-box {
        flex: 1;
        min-width: 200px;
        display: flex;
        align-items: center;
        gap: 10px;
        background: var(--adm-paper);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
    }

        .adm-search-box i {
            color: var(--adm-ink-faint);
            font-size: 13px;
        }

        .adm-search-box input {
            border: none;
            background: transparent;
            outline: none;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            width: 100%;
        }

    .adm-toolbar select {
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
        font-size: 13px;
        font-family: 'Inter', sans-serif;
        color: var(--adm-ink);
        background: var(--adm-raised);
    }

    .adm-show-control {
        display: flex;
        align-items: center;
        gap: 7px;
        color: var(--adm-ink-soft);
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .adm-show-control select {
            padding: 9px 10px;
            min-width: 64px;
        }

    /* toolbar toggle buttons (medication blue when on) */
    .adm-toggle {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 10px 14px;
        font-family: 'Inter', sans-serif;
        font-size: 12.5px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s, color .15s, border-color .15s;
    }

        .adm-toggle:hover:not(:disabled) {
            background: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
            border-color: var(--adm-med-accent-dim);
        }

        .adm-toggle.is-on {
            background: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
            border-color: var(--adm-med-accent);
        }

        .adm-toggle:disabled {
            opacity: .45;
            cursor: not-allowed;
        }

    .adm-toggle-clear:hover:not(:disabled) {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-color: var(--adm-red-dim);
    }

    .adm-toggle-star {
        color: var(--adm-amber);
        font-size: 11.5px;
    }

    .adm-toggle-count {
        background: var(--adm-paper);
        color: var(--adm-ink-faint);
        font-size: 10.5px;
        padding: 1px 7px;
        border-radius: 999px;
    }

    .adm-toggle.is-on .adm-toggle-count {
        background: var(--adm-raised);
        color: var(--adm-med-accent);
    }

    /* keyboard hint */
    .adm-kbd {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 20px;
        height: 20px;
        padding: 0 6px;
        border: 1px solid var(--adm-line-strong);
        border-bottom-width: 2px;
        border-radius: 6px;
        background: var(--adm-raised);
        color: var(--adm-ink-faint);
        font-family: 'Inter', sans-serif;
        font-size: 11px;
        font-weight: 600;
    }

    .adm-shortcuts-hint {
        display: flex;
        flex-wrap: wrap;
        gap: 18px;
        align-items: center;
        padding: 0 26px 18px;
        color: var(--adm-ink-faint);
        font-size: 11.5px;
    }

        .adm-shortcuts-hint span {
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

    .adm-hint-star {
        color: var(--adm-amber);
    }

    /* TABLE */
    .adm-table-wrap {
        padding: 16px 0 6px;
        width: 100%;
        box-sizing: border-box;
        overflow: visible;
    }

    .adm-table-scroll {
        width: 100%;
        max-width: 100%;
        max-height: 430px;
        overflow-y: auto;
        overflow-x: hidden;
        box-sizing: border-box;
        scrollbar-width: thin;
        scrollbar-color: var(--adm-line-strong) var(--adm-paper);
    }

        .adm-table-scroll::-webkit-scrollbar {
            width: 8px;
        }

        .adm-table-scroll::-webkit-scrollbar-track {
            background: var(--adm-paper);
            border-radius: 10px;
        }

        .adm-table-scroll::-webkit-scrollbar-thumb {
            background: var(--adm-line-strong);
            border-radius: 10px;
        }

            .adm-table-scroll::-webkit-scrollbar-thumb:hover {
                background: var(--adm-med-accent);
            }

    .adm-table {
        width: 100%;
        max-width: 100%;
        table-layout: auto;
        border-collapse: collapse;
        font-size: 13px;
    }

        .adm-table th:nth-child(1), .adm-table td:nth-child(1) {
            width: 20%;
        }

        .adm-table th:nth-child(2), .adm-table td:nth-child(2) {
            width: 17%;
        }

        .adm-table th:nth-child(3), .adm-table td:nth-child(3) {
            width: 27%;
        }

        .adm-table th:nth-child(4), .adm-table td:nth-child(4) {
            width: 13%;
        }

        .adm-table th:nth-child(5), .adm-table td:nth-child(5) {
            width: 23%;
        }

        .adm-table th {
            text-align: left;
            padding: 13px 18px;
            font-weight: 600;
            font-size: 11px;
            letter-spacing: .03em;
            text-transform: uppercase;
            color: var(--adm-ink-faint);
            background: var(--adm-paper);
            border-bottom: 1px solid var(--adm-line);
            position: sticky;
            top: 0;
            z-index: 5;
        }

            /* sortable headers */
            .adm-table th.adm-sortable {
                cursor: pointer;
                user-select: none;
            }

                .adm-table th.adm-sortable::after {
                    content: '\2195';
                    margin-left: 6px;
                    opacity: .45;
                }

                .adm-table th.adm-sortable.is-asc::after {
                    content: '\2191';
                    opacity: 1;
                    color: var(--adm-med-accent);
                }

                .adm-table th.adm-sortable.is-desc::after {
                    content: '\2193';
                    opacity: 1;
                    color: var(--adm-med-accent);
                }

                .adm-table th.adm-sortable:hover {
                    color: var(--adm-med-accent);
                }

                .adm-table th.adm-sortable:focus-visible {
                    outline: 2px solid var(--adm-med-accent);
                    outline-offset: -2px;
                }

    .adm-th-actions {
        text-align: left;
    }

    .adm-table td {
        padding: 15px 18px;
        border-bottom: 1px solid var(--adm-line);
        vertical-align: middle;
        overflow-wrap: break-word;
        word-break: normal;
        white-space: normal;
        line-height: 1.45;
    }

    .adm-table tbody tr {
        cursor: pointer;
    }

        .adm-table tbody tr:last-child td {
            border-bottom: none;
        }

        .adm-table tbody tr:hover {
            background: var(--adm-paper);
        }

        /* pinned rows get a thin blue edge */
        .adm-table tbody tr.is-pinned td:first-child {
            box-shadow: inset 3px 0 0 var(--adm-med-accent);
        }

    .adm-td-strong {
        font-weight: 600;
        color: var(--adm-ink);
        overflow-wrap: anywhere;
    }

    .adm-td-muted {
        color: var(--adm-ink-soft);
        overflow-wrap: anywhere;
    }

    /* search match highlight */
    .adm-mark {
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        border-radius: 4px;
        padding: 0 2px;
    }

    /* BADGES: fixed blue */
    .adm-badge {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        line-height: 1.3;
        text-align: center;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        max-width: 100%;
        box-sizing: border-box;
        white-space: normal;
        overflow-wrap: anywhere;
        animation: admGlowPulseBlue 2.6s ease-in-out infinite;
    }

    .adm-badge-muted {
        background: var(--adm-line);
        color: var(--adm-ink-faint);
        animation: none;
    }

    /* STATUS */
    .adm-status-pill {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        padding: 5px 10px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
        box-sizing: border-box;
    }

    .adm-status-active {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
    }

    .adm-status-inactive {
        background: var(--adm-line);
        color: var(--adm-ink-faint);
    }

    .adm-status-dot {
        width: 8px;
        height: 8px;
        border-radius: 50%;
        flex-shrink: 0;
    }

    .adm-status-active .adm-status-dot {
        background: var(--adm-teal);
        animation: admGlowPulse 2s ease-in-out infinite;
    }

    .adm-status-inactive .adm-status-dot {
        background: var(--adm-ink-faint);
        box-shadow: 0 0 0 3px var(--adm-line);
    }

    /* ROW ACTIONS */
    .adm-row-actions {
        display: flex;
        align-items: center;
        gap: 6px;
        flex-wrap: wrap;
        width: 100%;
    }

    .adm-inline-form-tight {
        display: inline-flex;
        max-width: 100%;
    }

    .adm-icon-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 6px;
        border: 1px solid var(--adm-line-strong);
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        border-radius: var(--adm-radius-sm);
        padding: 7px 10px;
        font-size: 11.5px;
        font-weight: 600;
        cursor: pointer;
        white-space: nowrap;
        transition: background .15s, color .15s, border-color .15s;
        max-width: 100%;
    }

    .adm-icon-btn-edit:hover {
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        border-color: var(--adm-med-accent-dim);
    }

    .adm-icon-btn-danger:hover {
        background: var(--adm-red-dim);
        color: var(--adm-red);
        border-color: var(--adm-red-dim);
    }

    .adm-icon-btn-restore:hover {
        background: var(--adm-teal-dim);
        color: var(--adm-teal-deep);
        border-color: var(--adm-teal-dim);
    }

    /* pin star */
    .adm-pin-btn {
        padding: 7px 9px;
        color: var(--adm-ink-faint);
    }

        .adm-pin-btn:hover {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
            border-color: var(--adm-amber-dim);
        }

        .adm-pin-btn.is-on {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
            border-color: var(--adm-amber);
        }

    /* INLINE FORM */
    .adm-inline-form {
        display: flex;
        gap: 10px;
        margin-top: 14px;
    }

        .adm-inline-form input {
            flex: 1;
            min-width: 0;
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
        }

            .adm-inline-form input:focus {
                outline: none;
                border-color: var(--adm-med-accent);
                box-shadow: 0 0 0 3px var(--adm-med-accent-dim);
            }

    /* PAGINATION */
    .adm-pagination {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 12px;
        margin: 12px 0 14px;
    }

    .adm-page-btn {
        width: 34px;
        height: 34px;
        display: inline-flex;
        align-items: center;
        justify-content: center;
        border: 1px solid var(--adm-line-strong);
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        border-radius: 10px;
        cursor: pointer;
        transition: all .15s;
    }

        .adm-page-btn:hover:not(:disabled) {
            background: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
            border-color: var(--adm-med-accent);
        }

        .adm-page-btn:disabled {
            opacity: .35;
            cursor: not-allowed;
        }

    .adm-page-info {
        min-width: 90px;
        text-align: center;
        font-size: 12px;
        color: var(--adm-ink-soft);
        font-weight: 600;
    }

    .adm-condition-pagination {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 12px 26px 14px;
        border-top: 1px solid var(--adm-line);
    }

    .adm-pagination-left {
        color: var(--adm-ink-faint);
        font-size: 12px;
        font-weight: 600;
    }

    .adm-pagination-right {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    /* CATEGORY BREAKDOWN: fixed blue bars */
    .adm-breakdown {
        padding: 20px 26px 26px;
        display: flex;
        flex-direction: column;
        gap: 16px;
    }

    .adm-breakdown-row {
        display: flex;
        flex-direction: column;
        gap: 6px;
    }

        .adm-breakdown-row.is-link {
            cursor: pointer;
            border-radius: 10px;
            padding: 6px 8px;
            margin: -6px -8px;
            transition: background .15s;
        }

            .adm-breakdown-row.is-link:hover {
                background: var(--adm-paper);
            }

            .adm-breakdown-row.is-link:focus-visible {
                outline: 2px solid var(--adm-med-accent);
                outline-offset: 1px;
            }

    .adm-breakdown-hint {
        margin: 2px 0 0;
        font-size: 11.5px;
    }

    .adm-breakdown-label {
        display: flex;
        justify-content: space-between;
        gap: 10px;
        font-size: 13px;
        color: var(--adm-ink);
    }

        .adm-breakdown-label span {
            overflow-wrap: anywhere;
        }

        .adm-breakdown-label strong {
            color: var(--adm-ink-faint);
            font-weight: 700;
            flex-shrink: 0;
        }

            .adm-breakdown-label strong small {
                font-weight: 500;
                font-size: 11px;
            }

    .adm-breakdown-track {
        height: 8px;
        border-radius: 999px;
        background: var(--adm-paper);
        overflow: hidden;
    }

    .adm-breakdown-fill {
        height: 100%;
        border-radius: 999px;
        background: var(--adm-med-accent);
        opacity: .85;
        transition: width .3s ease;
    }

    /* EMPTY STATE */
    .adm-empty-state {
        padding: 48px 30px;
        text-align: center;
        display: flex;
        flex-direction: column;
        align-items: center;
        gap: 10px;
    }

    .adm-empty-icon {
        width: 58px;
        height: 58px;
        border-radius: 50%;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 22px;
    }

    .adm-empty-state h5 {
        margin: 0;
        font-size: 14.5px;
        font-weight: 700;
    }

    .adm-empty-state p {
        margin: 0 auto;
        max-width: 340px;
        font-size: 13px;
        color: var(--adm-ink-soft);
        line-height: 1.6;
    }

    /* MODALS */
    .adm-modal-overlay {
        display: none;
        position: fixed;
        inset: 0;
        background: rgba(10, 44, 39, 0.45);
        align-items: center;
        justify-content: center;
        z-index: 1000;
    }

        .adm-modal-overlay.is-open {
            display: flex;
        }

    .adm-modal {
        background: var(--adm-raised);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        width: 100%;
        max-width: 440px;
        padding: 26px;
    }

    .adm-modal-title {
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-family: 'Poppins', sans-serif;
        font-weight: 700;
        font-size: 16px;
        margin-bottom: 20px;
    }

    .adm-modal-icon {
        margin-right: 8px;
        color: var(--adm-med-accent);
    }

    .adm-modal-close {
        cursor: pointer;
        color: var(--adm-ink-faint);
        width: 28px;
        height: 28px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
    }

        .adm-modal-close:hover {
            background: var(--adm-paper);
            color: var(--adm-ink);
        }

    .adm-form-group {
        margin-bottom: 16px;
    }

        .adm-form-group label {
            display: block;
            font-size: 12.5px;
            font-weight: 600;
            color: var(--adm-ink-soft);
            margin-bottom: 6px;
        }

        .adm-form-group input, .adm-form-group select {
            width: 100%;
            border: 1px solid var(--adm-line-strong);
            border-radius: var(--adm-radius-sm);
            padding: 10px 14px;
            font-size: 13px;
            font-family: 'Inter', sans-serif;
            color: var(--adm-ink);
            box-sizing: border-box;
        }

            .adm-form-group input:focus, .adm-form-group select:focus {
                outline: none;
                border-color: var(--adm-med-accent);
                box-shadow: 0 0 0 3px var(--adm-med-accent-dim);
            }

    /* duplicate-name / same-family warning */
    .adm-field-warn {
        margin-top: 8px;
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
        border-radius: 10px;
        padding: 8px 12px;
        font-size: 12px;
        font-weight: 600;
    }

    .adm-modal-actions {
        display: flex;
        justify-content: flex-end;
        gap: 10px;
        margin-top: 6px;
    }

    /* details modal */
    .adm-detail-list {
        display: flex;
        flex-direction: column;
        margin-bottom: 20px;
        border: 1px solid var(--adm-line);
        border-radius: var(--adm-radius-sm);
        overflow: hidden;
    }

    .adm-detail-row {
        display: flex;
        gap: 16px;
        padding: 13px 16px;
        border-bottom: 1px solid var(--adm-line);
        font-size: 13px;
    }

        .adm-detail-row:last-child {
            border-bottom: none;
        }

    .adm-detail-label {
        width: 96px;
        flex-shrink: 0;
        font-size: 11px;
        font-weight: 600;
        letter-spacing: .03em;
        text-transform: uppercase;
        color: var(--adm-ink-faint);
        padding-top: 2px;
    }

    .adm-detail-value {
        color: var(--adm-ink);
        font-weight: 600;
        overflow-wrap: anywhere;
        line-height: 1.5;
    }

        .adm-detail-value.is-empty {
            color: var(--adm-ink-faint);
            font-weight: 500;
            font-style: italic;
        }

    /* ANIMATIONS */
    @@keyframes admGlowPulseBlue {
        0%, 100% {
            box-shadow: 0 0 6px 0px rgba(46, 111, 167, .25);
        }

        50% {
            box-shadow: 0 0 10px 2px rgba(46, 111, 167, .45);
        }
    }

    @@keyframes admGlowPulseBlueDark {
        0%, 100% {
            box-shadow: 0 0 6px 0px rgba(108, 176, 232, .18);
        }

        50% {
            box-shadow: 0 0 10px 2px rgba(108, 176, 232, .35);
        }
    }

    @@keyframes admGlowPulse {
        0%, 100% {
            box-shadow: 0 0 0 3px var(--adm-teal-dim), 0 0 6px 1px rgba(14, 140, 127, .45);
        }

        50% {
            box-shadow: 0 0 0 3px var(--adm-teal-dim), 0 0 14px 4px rgba(14, 140, 127, .75);
        }
    }


    /* ==========================================================
               DATA QUALITY + REGISTER OVERVIEW + FORMULARY
               Medication blue is used for all functional colour here.
            ========================================================== */

    .aq-section,
    .ao-section {
        background: var(--adm-raised);
        color: var(--adm-ink);
        border-radius: var(--adm-radius);
        box-shadow: var(--adm-shadow);
        margin: 0 0 22px;
        overflow: hidden;
    }

    /* ---------- headers ---------- */
    .aq-head,
    .ao-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        flex-wrap: wrap;
        gap: 16px;
        padding: 20px 26px;
        border-bottom: 1px solid var(--adm-line);
    }

        .aq-head h2,
        .ao-head h2 {
            margin: 0 0 4px;
            font: 700 16px/1.3 'Poppins', sans-serif;
            color: var(--adm-ink);
        }

        .aq-head p,
        .ao-head p {
            margin: 0;
            font-size: 13px;
            line-height: 1.5;
            color: var(--adm-ink-soft);
        }

    .aq-head-actions,
    .ao-head-actions {
        display: flex;
        align-items: center;
        flex-wrap: wrap;
        gap: 10px;
    }

    /* ---------- buttons ---------- */
    .aq-btn,
    .ao-btn {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        gap: 8px;
        padding: 9px 15px;
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        background: var(--adm-raised);
        color: var(--adm-ink);
        font: 600 12.5px 'Inter', sans-serif;
        cursor: pointer;
        transition: background .15s, border-color .15s, color .15s, box-shadow .15s;
    }

        .aq-btn:hover,
        .ao-btn:hover {
            background: var(--adm-paper);
            border-color: var(--adm-med-accent);
            color: var(--adm-med-accent);
        }

    .ao-btn-primary {
        border-color: transparent;
        background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
        color: #fff;
        box-shadow: 0 6px 16px rgba(10, 90, 80, .22);
    }

        .ao-btn-primary:hover {
            background: linear-gradient(125deg, var(--adm-teal-grad-start), var(--adm-teal-grad-end));
            border-color: transparent;
            color: #fff;
            box-shadow: 0 10px 22px rgba(10, 90, 80, .28);
        }

    .aq-btn:focus-visible,
    .ao-btn:focus-visible,
    .aq-link:focus-visible,
    .ao-queue-item:focus-visible,
    .fm-show:focus-visible,
    .fm-more:focus-visible,
    .adm-insights-category-row:focus-visible {
        outline: 2px solid var(--adm-med-accent);
        outline-offset: 2px;
    }

    /* ---------- overall status pill ---------- */
    .aq-summary {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 7px 12px;
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

        .aq-summary::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

        .aq-summary[data-state="ok"] {
            background: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
        }

        .aq-summary[data-state="warn"] {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
        }

    /* ---------- quality check rows ---------- */
    .aq-list {
        list-style: none;
        margin: 0;
        padding: 0;
    }

    .aq-row {
        display: grid;
        grid-template-columns: 40px minmax(0, 1fr) 56px 118px 156px;
        align-items: center;
        gap: 16px;
        padding: 16px 26px;
        border-bottom: 1px solid var(--adm-line);
        transition: background .15s;
    }

        .aq-row:last-child {
            border-bottom: 0;
        }

        .aq-row:hover {
            background: var(--adm-paper);
        }

    .aq-row-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 40px;
        height: 40px;
        border-radius: 12px;
        font-size: 15px;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
    }

    .aq-row[data-state="warn"] .aq-row-icon {
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
    }

    .aq-row-main {
        display: flex;
        flex-direction: column;
        gap: 3px;
        min-width: 0;
    }

    .aq-row-title {
        font-size: 13.5px;
        font-weight: 600;
        color: var(--adm-ink);
    }

    .aq-row-desc {
        font-size: 12.5px;
        color: var(--adm-ink-soft);
    }

    .aq-count {
        font: 700 22px/1 'Poppins', sans-serif;
        font-variant-numeric: tabular-nums;
        text-align: right;
        color: var(--adm-ink);
    }

    .aq-row[data-state="warn"] .aq-count {
        color: var(--adm-amber);
    }

    .aq-state {
        display: inline-flex;
        align-items: center;
        gap: 7px;
        justify-self: start;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11.5px;
        font-weight: 600;
        white-space: nowrap;
    }

        .aq-state::before {
            content: "";
            width: 7px;
            height: 7px;
            border-radius: 50%;
            background: currentColor;
        }

    .aq-row[data-state="ok"] .aq-state {
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
    }

        .aq-row[data-state="ok"] .aq-state::after {
            content: "Clear";
        }

    .aq-row[data-state="warn"] .aq-state {
        background: var(--adm-amber-dim);
        color: var(--adm-amber);
    }

        .aq-row[data-state="warn"] .aq-state::after {
            content: "Needs review";
        }

    .aq-link {
        display: inline-flex;
        align-items: center;
        justify-content: space-between;
        gap: 10px;
        width: 100%;
        padding: 8px 12px;
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        font: 600 12px 'Inter', sans-serif;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
    }

        .aq-link i {
            font-size: 10px;
        }

        .aq-link:hover {
            background: var(--adm-med-accent-dim);
            border-color: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
        }

    /* ---------- duplicate names detail ---------- */
    .aq-dupes {
        margin: 0;
        padding: 16px 26px 18px;
        border-top: 1px solid var(--adm-line);
        background: var(--adm-paper);
        font-size: 13px;
        color: var(--adm-ink);
    }

        .aq-dupes[hidden] {
            display: none;
        }

        .aq-dupes > strong {
            display: block;
            margin-bottom: 10px;
            font-size: 12.5px;
        }

        .aq-dupes ul {
            display: grid;
            grid-template-columns: repeat(2, minmax(0, 1fr));
            gap: 8px 24px;
            margin: 0;
            padding: 0;
            list-style: none;
        }

        .aq-dupes li {
            display: flex;
            align-items: center;
            gap: 9px;
            min-width: 0;
            padding: 8px 12px;
            border: 1px solid var(--adm-line);
            border-radius: 10px;
            background: var(--adm-raised);
        }

            .aq-dupes li span {
                width: 6px;
                height: 6px;
                flex-shrink: 0;
                border-radius: 50%;
                background: var(--adm-amber);
            }

            .aq-dupes li small {
                margin-left: auto;
                white-space: nowrap;
                color: var(--adm-ink-faint);
            }

        .aq-dupes .adm-quality-clean {
            display: flex;
            align-items: center;
            gap: 9px;
            font-weight: 600;
            color: var(--adm-med-accent);
        }

    /* ---------- shared footer note ---------- */
    .sec-foot {
        display: flex;
        align-items: center;
        gap: 9px;
        padding: 13px 26px;
        border-top: 1px solid var(--adm-line);
        background: var(--adm-paper);
        font-size: 12px;
        color: var(--adm-ink-faint);
    }

    /* ---------- overview: metric strip ---------- */
    .ao-metrics {
        display: grid;
        grid-template-columns: repeat(4, minmax(0, 1fr));
        border-bottom: 1px solid var(--adm-line);
    }

    .ao-metric {
        display: flex;
        flex-direction: column;
        gap: 6px;
        min-width: 0;
        padding: 20px 26px;
        border-right: 1px solid var(--adm-line);
    }

        .ao-metric:last-child {
            border-right: 0;
        }

    .ao-metric-label {
        display: flex;
        align-items: center;
        gap: 8px;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--adm-ink-soft);
    }

        .ao-metric-label i {
            color: var(--adm-med-accent);
            font-size: 12px;
        }

    .ao-metric strong {
        font: 700 28px/1.15 'Poppins', sans-serif;
        font-variant-numeric: tabular-nums;
        color: var(--adm-ink);
    }

    .ao-metric small {
        font-size: 12px;
        line-height: 1.45;
        color: var(--adm-ink-faint);
    }

    .ao-meter {
        display: block;
        height: 6px;
        margin-top: auto;
        padding-top: 0;
        border-radius: 99px;
        background: var(--adm-line);
        overflow: hidden;
    }

    .ao-meter-fill {
        display: block;
        width: 0;
        height: 100%;
        border-radius: 99px;
        background: var(--adm-med-accent);
        transition: width .4s ease;
    }

    /* ---------- overview: body ---------- */
    .ao-body {
        display: grid;
        grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    }

    .ao-col {
        min-width: 0;
        padding: 22px 26px 24px;
    }

        .ao-col + .ao-col {
            border-left: 1px solid var(--adm-line);
        }

    .ao-col-head {
        margin-bottom: 16px;
    }

        .ao-col-head h3 {
            margin: 0 0 3px;
            font: 700 14.5px 'Poppins', sans-serif;
            color: var(--adm-ink);
        }

        .ao-col-head p {
            margin: 0;
            font-size: 12.5px;
            color: var(--adm-ink-soft);
        }

    /* bar rows (category distribution and dosage form mix) */
    .ao-col .adm-insights-category-list {
        display: flex;
        flex-direction: column;
        gap: 4px;
    }

    .ao-col .adm-insights-category-row {
        display: grid;
        grid-template-columns: minmax(100px, .9fr) minmax(60px, 1.4fr) auto;
        align-items: center;
        gap: 14px;
        width: calc(100% + 20px);
        margin: 0 -10px;
        padding: 9px 10px;
        border: 0;
        border-radius: 10px;
        background: transparent;
        text-align: left;
        cursor: pointer;
        transition: background .15s;
    }

        .ao-col .adm-insights-category-row:hover {
            background: var(--adm-paper);
        }

    .ao-col .adm-insights-category-name {
        overflow: hidden;
        font-size: 12.5px;
        font-weight: 600;
        color: var(--adm-ink);
        text-overflow: ellipsis;
        white-space: nowrap;
    }

    .ao-col .adm-insights-track {
        display: block;
        height: 8px;
        border-radius: 99px;
        background: var(--adm-line);
        overflow: hidden;
    }

    .ao-col .adm-insights-fill {
        display: block;
        height: 100%;
        border-radius: 99px;
        background: var(--adm-med-accent);
        opacity: .9;
        transition: width .4s ease;
    }

    .ao-col .adm-insights-category-value {
        font-size: 12px;
        font-weight: 700;
        font-variant-numeric: tabular-nums;
        white-space: nowrap;
        color: var(--adm-ink-soft);
    }

    .ao-col .adm-insights-empty {
        padding: 24px 10px;
        text-align: center;
        font-size: 12.5px;
        color: var(--adm-ink-faint);
    }

        .ao-col .adm-insights-empty[hidden] {
            display: none;
        }

    /* review queue */
    .ao-queue-item {
        display: grid;
        grid-template-columns: 36px minmax(0, 1fr) auto 12px;
        align-items: center;
        gap: 14px;
        width: calc(100% + 20px);
        margin: 0 -10px;
        padding: 13px 10px;
        border: 0;
        border-top: 1px solid var(--adm-line);
        background: transparent;
        color: var(--adm-ink);
        text-align: left;
        cursor: pointer;
        transition: background .15s;
    }

        .ao-queue-item:hover {
            background: var(--adm-paper);
        }

        .ao-queue-item > i {
            font-size: 10px;
            color: var(--adm-ink-faint);
        }

    .ao-queue-icon {
        display: flex;
        align-items: center;
        justify-content: center;
        width: 36px;
        height: 36px;
        border-radius: 10px;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        font-size: 13px;
    }

    .ao-queue-text {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .ao-queue-text strong {
            font-size: 13px;
            font-weight: 600;
        }

        .ao-queue-text small {
            font-size: 12px;
            color: var(--adm-ink-faint);
        }

    .ao-queue-count {
        min-width: 30px;
        padding: 4px 9px;
        border-radius: 8px;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        font-size: 12px;
        font-weight: 700;
        text-align: center;
        font-variant-numeric: tabular-nums;
    }

    .ao-queue-item:hover .ao-queue-text strong {
        color: var(--adm-med-accent);
    }

    /* ---------- formulary explorer ---------- */
    .fm-col-head {
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 12px;
        flex-wrap: wrap;
    }

    .fm-select {
        border: 1px solid var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        padding: 8px 12px;
        font: 600 12px 'Inter', sans-serif;
        color: var(--adm-ink);
        background: var(--adm-raised);
    }

        .fm-select:focus {
            outline: none;
            border-color: var(--adm-med-accent);
            box-shadow: 0 0 0 3px var(--adm-med-accent-dim);
        }

    .fm-list {
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .fm-item {
        border: 1px solid var(--adm-line);
        border-radius: var(--adm-radius-sm);
        padding: 12px 14px;
        background: var(--adm-raised);
        transition: border-color .15s, background .15s;
    }

        .fm-item:hover {
            border-color: var(--adm-med-accent-dim);
            background: var(--adm-paper);
        }

    .fm-item-head {
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        margin-bottom: 8px;
    }

    .fm-item-title {
        display: flex;
        flex-direction: column;
        gap: 2px;
        min-width: 0;
    }

        .fm-item-title strong {
            font-size: 13.5px;
            font-weight: 600;
            color: var(--adm-ink);
            overflow-wrap: anywhere;
        }

        .fm-item-title small {
            font-size: 11.5px;
            color: var(--adm-ink-faint);
        }

    .fm-show {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        flex-shrink: 0;
        padding: 6px 11px;
        border: 1px solid var(--adm-line-strong);
        border-radius: 10px;
        background: var(--adm-raised);
        color: var(--adm-ink-soft);
        font: 600 11.5px 'Inter', sans-serif;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
    }

        .fm-show i {
            font-size: 9px;
        }

        .fm-show:hover {
            background: var(--adm-med-accent-dim);
            border-color: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
        }

    .fm-chips {
        display: flex;
        flex-wrap: wrap;
        gap: 6px;
    }

    .fm-chip {
        padding: 4px 10px;
        border-radius: 999px;
        background: var(--adm-med-accent-dim);
        color: var(--adm-med-accent);
        font-size: 11.5px;
        font-weight: 700;
    }

        .fm-chip.is-missing {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
        }

    .fm-cats {
        margin-top: 8px;
        font-size: 11.5px;
        color: var(--adm-ink-faint);
    }

    .fm-more {
        display: block;
        width: 100%;
        margin-top: 12px;
        padding: 9px 12px;
        border: 1px dashed var(--adm-line-strong);
        border-radius: var(--adm-radius-sm);
        background: transparent;
        color: var(--adm-ink-soft);
        font: 600 12px 'Inter', sans-serif;
        cursor: pointer;
        transition: background .15s, color .15s, border-color .15s;
    }

        .fm-more:hover {
            background: var(--adm-med-accent-dim);
            border-color: var(--adm-med-accent);
            color: var(--adm-med-accent);
        }

    .fm-rest {
        margin: 8px 0 0;
        font-size: 12px;
        color: var(--adm-ink-faint);
    }

    .fm-hint {
        margin: 14px 0 0;
        font-size: 11.5px;
    }

    /* ---------- responsive ---------- */
    @@media (max-width: 1100px) {
        .ao-metrics {
            grid-template-columns: repeat(2, minmax(0, 1fr));
        }

        .ao-metric:nth-child(2n) {
            border-right: 0;
        }

        .ao-metric:nth-child(-n+2) {
            border-bottom: 1px solid var(--adm-line);
        }
    }

    @@media (max-width: 1000px) {
        .adm-split {
            grid-template-columns: 1fr;
        }

        .adm-insights {
            grid-template-columns: repeat(2, 1fr);
        }
    }

    @@media (max-width: 900px) {
        .ao-body {
            grid-template-columns: 1fr;
        }

        .ao-col + .ao-col {
            border-left: 0;
            border-top: 1px solid var(--adm-line);
        }
    }

    @@media (max-width: 760px) {
        .aq-row {
            grid-template-columns: 40px minmax(0, 1fr) auto;
            grid-template-areas: "icon main count" ". state action";
            row-gap: 12px;
            padding: 16px 18px;
        }

        .aq-row-icon {
            grid-area: icon;
        }

        .aq-row-main {
            grid-area: main;
        }

        .aq-count {
            grid-area: count;
        }

        .aq-state {
            grid-area: state;
        }

        .aq-link {
            grid-area: action;
            justify-self: end;
            width: auto;
        }

        .aq-head,
        .ao-head {
            padding: 18px;
        }

        .aq-dupes {
            padding: 16px 18px;
        }

            .aq-dupes ul {
                grid-template-columns: 1fr;
            }

        .ao-col,
        .ao-metric,
        .sec-foot {
            padding-left: 18px;
            padding-right: 18px;
        }
    }

    @@media (max-width: 640px) {
        .adm-page {
            padding: 20px 16px 50px;
        }

        .adm-insights {
            grid-template-columns: 1fr;
        }

        .adm-page-banner {
            flex-direction: column;
            align-items: flex-start;
        }

        .adm-page-banner-right {
            width: 100%;
            justify-content: space-between;
        }

        .adm-row-actions {
            flex-wrap: wrap;
        }

        .adm-toolbar {
            align-items: stretch;
        }

        .adm-show-control {
            width: 100%;
            justify-content: flex-end;
        }

        .adm-condition-pagination {
            flex-direction: column;
            gap: 12px;
        }

        .adm-shortcuts-hint {
            display: none;
        }

        .adm-inline-form {
            flex-direction: column;
        }

        .adm-table th, .adm-table td {
            padding: 12px 10px;
        }

        .adm-table {
            font-size: 12px;
        }

            .adm-table th {
                font-size: 10px;
            }

        .adm-icon-btn {
            font-size: 10.5px;
            padding: 6px 8px;
        }

        .adm-badge {
            font-size: 10px;
            padding: 4px 8px;
        }

        .adm-detail-row {
            flex-direction: column;
            gap: 4px;
        }
    }

    @@media (max-width: 520px) {
        .ao-metrics {
            grid-template-columns: 1fr;
        }

        .ao-metric {
            border-right: 0;
            border-bottom: 1px solid var(--adm-line);
        }

            .ao-metric:last-child {
                border-bottom: 0;
            }

        .ao-head-actions,
        .aq-head-actions {
            width: 100%;
        }

        .ao-btn,
        .aq-btn {
            flex: 1;
        }

        .ao-col .adm-insights-category-row {
            grid-template-columns: minmax(80px, .9fr) minmax(40px, 1fr) auto;
            gap: 8px;
        }
    }

    @@media (prefers-reduced-motion: reduce) {
        .ao-meter-fill,
        .ao-col .adm-insights-fill {
            transition: none;
        }
    }


    /* ==========================================================
               DARK MODE (html.rq-dark, same switch as the rest of the app)
            ========================================================== */

    /* 1. Re-point the page's variables at the shared dark palette */
    html.rq-dark {
        --adm-paper: #141C18;
        --adm-raised: #172019;
        --adm-ink: #E8EEEB;
        --adm-ink-soft: #A5B0AA;
        --adm-ink-faint: #7F8B85;
        --adm-line: #26302B;
        --adm-line-strong: #34403A;
        --adm-teal: #2CC4BA;
        --adm-teal-deep: #5ED0C4;
        --adm-teal-dim: #12302D;
        --adm-teal-grad-start: #0F7F74;
        --adm-teal-grad-end: #0A3A35;
        --adm-red: #E1736B;
        --adm-red-dim: #3A1B18;
        --adm-amber: #E8B84A;
        --adm-amber-dim: #3A2E12;
        --adm-blue: #6CB0E8;
        --adm-blue-dim: #14283A;
        --adm-med-accent: #6CB0E8;
        --adm-med-accent-dim: #14283A;
        --adm-med-accent-deep: #8CC4F0;
        --adm-shadow: 0 6px 24px rgba(0, 0, 0, .45);
        --adm-shadow-sm: 0 3px 10px rgba(0, 0, 0, .3);
    }

        /* 2. Beat the shared catch-all (it matches "panel" and "tag" in class names) */
        html.rq-dark .adm-page .adm-panel .adm-panel-head .adm-panel-tag {
            background-color: var(--adm-teal-dim) !important;
            color: var(--adm-teal-deep) !important;
            box-shadow: none !important;
            border-color: transparent !important;
        }

        html.rq-dark .adm-page .adm-panel .adm-panel-body {
            background-color: transparent !important;
            box-shadow: none !important;
        }

        /* 3. Beat the shared "color: inherit" rule for td / th / span / p / label */
        html.rq-dark .adm-page .adm-table-scroll .adm-table th {
            color: var(--adm-ink-faint);
            background: var(--adm-paper);
        }

            html.rq-dark .adm-page .adm-table-scroll .adm-table th.adm-sortable:hover {
                color: var(--adm-med-accent);
            }

        html.rq-dark .adm-page .adm-table td.adm-td-muted {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-table tbody tr:hover {
            background: #1B2620;
        }

        html.rq-dark .adm-page .adm-page-banner .adm-page-banner-left h1 {
            color: #fff;
        }

        html.rq-dark .adm-page .adm-page-banner .adm-page-banner-left p {
            color: rgba(255, 255, 255, .85);
        }

        html.rq-dark .adm-page .adm-mini-stat span.num {
            color: #fff;
        }

        html.rq-dark .adm-page .adm-mini-stat span.label {
            color: rgba(255, 255, 255, .75);
        }

        /* "Add Medication" button on the banner: keep it light, with dark text */
        html.rq-dark .adm-page .adm-page-banner .adm-btn.adm-btn-light {
            background: #E8EEEB;
            color: #0A3A35;
        }

        /* tabs */
        html.rq-dark .adm-page .adm-tabs .adm-tab .adm-tab-count {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-tabs .adm-tab.is-active .adm-tab-count {
            color: var(--adm-teal-deep);
        }

        /* "Show N rows" and pagination text */
        html.rq-dark .adm-page .adm-toolbar .adm-show-control span {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-condition-pagination .adm-pagination-left span {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-condition-pagination .adm-page-info,
        html.rq-dark .adm-page .adm-pagination .adm-page-info {
            color: var(--adm-ink-soft);
        }

        /* hint + empty-state text */
        html.rq-dark .adm-page .adm-chips-container .adm-hint,
        html.rq-dark .adm-page .adm-breakdown .adm-hint,
        html.rq-dark .adm-page .fm-hint {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-panel .adm-empty-state p {
            color: var(--adm-ink-soft);
        }

        /* category chips: keep the blue text and a transparent border */
        html.rq-dark .adm-page .adm-chips-row .adm-chip-form .adm-chip {
            color: var(--adm-med-accent);
            border-color: transparent;
            animation-name: admGlowPulseBlueDark;
        }

            html.rq-dark .adm-page .adm-chips-row .adm-chip-form .adm-chip.adm-chip-muted {
                animation: none;
            }

        html.rq-dark .adm-page .adm-table .adm-badge {
            animation-name: admGlowPulseBlueDark;
        }

            html.rq-dark .adm-page .adm-table .adm-badge.adm-badge-muted {
                animation: none;
            }

        /* 4. Search inputs: sit transparent inside their box */
        html.rq-dark .adm-page .adm-search-box input {
            background: transparent;
            border: none;
            color: var(--adm-ink);
        }

            html.rq-dark .adm-page .adm-search-box input:focus {
                outline: none;
            }

        /* 5. Selects and form fields: match the shared field look, keep borders visible */
        html.rq-dark .adm-page .adm-toolbar select,
        html.rq-dark .adm-page .adm-show-control select,
        html.rq-dark .adm-page .fm-select,
        html.rq-dark .adm-page .adm-inline-form input,
        html.rq-dark .adm-page .adm-form-group input,
        html.rq-dark .adm-page .adm-form-group select {
            background-color: var(--adm-paper);
            color: var(--adm-ink);
            border-color: var(--adm-line-strong);
        }

            html.rq-dark .adm-page .adm-inline-form input:focus,
            html.rq-dark .adm-page .adm-form-group input:focus,
            html.rq-dark .adm-page .adm-form-group select:focus {
                outline: none;
                border-color: var(--adm-med-accent);
            }

        /* 6. Modals */
        html.rq-dark .adm-page .adm-modal-overlay {
            background: rgba(0, 0, 0, .65);
        }

        html.rq-dark .adm-page .adm-modal .adm-form-group label {
            color: var(--adm-ink-soft);
        }

        html.rq-dark .adm-page .adm-modal .adm-modal-title .adm-modal-close {
            color: var(--adm-ink-faint);
        }

            html.rq-dark .adm-page .adm-modal .adm-modal-title .adm-modal-close:hover {
                background: var(--adm-paper);
                color: var(--adm-ink);
            }

        html.rq-dark .adm-page .adm-modal .adm-detail-label {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-modal .adm-detail-value {
            color: var(--adm-ink);
        }

            html.rq-dark .adm-page .adm-modal .adm-detail-value.is-empty {
                color: var(--adm-ink-faint);
            }

        /* 7. Insight cards, toggles and other new elements */
        html.rq-dark .adm-page .adm-insight .adm-insight-label {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-insight .adm-insight-value {
            color: var(--adm-ink);
        }

        html.rq-dark .adm-page .adm-insight .adm-insight-sub {
