        }

        html.rq-dark .adm-page .adm-insight:hover:not(:disabled):not(.adm-insight-static) {
            box-shadow: 0 10px 28px rgba(0, 0, 0, .5);
        }

        html.rq-dark .adm-page .adm-table td .adm-mark,
        html.rq-dark .adm-page .adm-table td mark.adm-mark {
            background: var(--adm-med-accent-dim);
            color: var(--adm-med-accent);
        }

        html.rq-dark .adm-page .adm-shortcuts-hint span {
            color: var(--adm-ink-faint);
        }

        html.rq-dark .adm-page .adm-kbd {
            background: var(--adm-raised);
            color: var(--adm-ink-faint);
            border-color: var(--adm-line-strong);
        }

        html.rq-dark .adm-page .adm-toggle {
            background: var(--adm-raised);
            color: var(--adm-ink-soft);
            border-color: var(--adm-line-strong);
        }

            html.rq-dark .adm-page .adm-toggle.is-on {
                background: var(--adm-med-accent-dim);
                color: var(--adm-med-accent);
                border-color: var(--adm-med-accent);
            }

            html.rq-dark .adm-page .adm-toggle span.adm-toggle-count {
                background: var(--adm-paper);
                color: var(--adm-ink-faint);
            }

            html.rq-dark .adm-page .adm-toggle.is-on span.adm-toggle-count {
                background: var(--adm-raised);
                color: var(--adm-med-accent);
            }

        html.rq-dark .adm-page .adm-pin-btn {
            color: var(--adm-ink-faint);
        }

            html.rq-dark .adm-page .adm-pin-btn.is-on {
                background: var(--adm-amber-dim);
                color: var(--adm-amber);
                border-color: var(--adm-amber);
            }

        html.rq-dark .adm-page .adm-field-warn {
            background: var(--adm-amber-dim);
            color: var(--adm-amber);
        }

        html.rq-dark .adm-page .adm-breakdown-row.is-link:hover {
