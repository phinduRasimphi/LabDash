<script>
    // Runs before the page paints: no flash of the wrong theme.
    // Same key and class as the Test Requests page, so every page agrees.
    (function() {
        try {
            var t = localStorage.getItem('rqTheme');
            var sysDark = window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches;
            if (t === 'dark' || (t === null && sysDark)) { document.documentElement.classList.add('rq-dark'); }
        } catch (e) { }

        var r = document.documentElement;
        function cur() { return r.classList.contains('rq-dark') ? 'dark' : 'light'; }
        function paint() {
            var d = cur() === 'dark';
            document.querySelectorAll('[data-ld-theme-toggle]').forEach(function(b) {
                var i = b.querySelector('i'), s = b.querySelector('span');
                if (i) { i.className = d ? 'fas fa-sun' : 'fas fa-moon'; }
                if (s) { s.textContent = d ? 'Light mode' : 'Dark mode'; }
            });
        }
        function set(t) {
            r.classList.toggle('rq-dark', t === 'dark');
            try { localStorage.setItem('rqTheme', t); } catch (e) { }
            paint();
        }
        window.ldTheme = { set: set, get: cur, toggle: function() { set(cur() === 'dark' ? 'light' : 'dark'); } };

        document.addEventListener('DOMContentLoaded', function() {
            paint();
            document.querySelectorAll('[data-ld-theme-toggle]').forEach(function(b) {
                b.addEventListener('click', function() { window.ldTheme.toggle(); });
            });
            // keeps the icon right when another script (e.g. the Requests banner button) changes the theme
            new MutationObserver(paint).observe(r, { attributes: true, attributeFilter: ['class'] });
        });
        // keep other open tabs in step
        window.addEventListener('storage', function(e) {
            if (e.key === 'rqTheme') { r.classList.toggle('rq-dark', e.newValue === 'dark'); }
        });
    })();
</script>

