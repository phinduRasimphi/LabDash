                <div class="p-shell">

                    <!-- ═══════════════════════════
                         GREEN SIDEBAR
                    ═══════════════════════════ -->
                    <aside class="p-sidebar">

                        <!-- Logo / Branding -->
                        <div class="p-logo">
                            <div class="p-logo-icon">
