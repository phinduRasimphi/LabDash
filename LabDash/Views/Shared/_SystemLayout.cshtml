                    </div>
                    <div class="profile-modal-body">
                        <div class="profile-info-row">
                            <span class="profile-info-label">Full Name</span>
                            <span class="profile-info-value">MAKUWA KAMOGELO</span>
                        </div>
                        <div class="profile-info-row">
                            <span class="profile-info-label">Employee Number</span>
                            <span class="profile-info-value">DR001</span>
                        </div>
                        <div class="profile-info-row">
                            <span class="profile-info-label">Email</span>
                            <span class="profile-info-value">doctor@email.com</span>
                        </div>
                        <div class="profile-info-row">
                            <span class="profile-info-label">Phone</span>
                            <span class="profile-info-value">012 109 8765</span>
                        </div>
                        <div class="profile-info-row">
                            <span class="profile-info-label">Department</span>
                            <span class="profile-info-value">Health</span>
                        </div>
