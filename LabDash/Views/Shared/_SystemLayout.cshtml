                            <div class="p-nav-label">Health</div>

                            <a href="@Url.Action("MedicalHistory", "Patient")"
                            class="p-nav-link @(ViewData["ActivePage"]?.ToString() == "MedicalHistory" ? "p-active" : "")">
                                <span class="p-nav-icon"><i class="fas fa-notes-medical"></i></span>
                                <span>Medical History</span>
                            </a>

                            <div class="p-nav-label">Access & Reports</div>

                            <a href="@Url.Action("Consent", "Patient")"
                            class="p-nav-link @(ViewData["ActivePage"]?.ToString() == "Consent" ? "p-active" : "")">
                                <span class="p-nav-icon"><i class="fas fa-user-shield"></i></span>
                                <span>Consent</span>
                            </a>

                            <a href="@Url.Action("Reports", "Patient")"
                            class="p-nav-link @(ViewData["ActivePage"]?.ToString() == "Reports" ? "p-active" : "")">
                                <span class="p-nav-icon"><i class="fas fa-file-pdf"></i></span>
                                <span>Reports</span>
                            </a>

                        </nav>

                    <!-- Sidebar footer -->
                    <div class="p-sidebar-footer">


                        <button type="button" class="ld-foot-btn ld-foot-neutral ld-theme-btn" data-ld-theme-toggle>
                            <i class="fas fa-moon"></i> <span>Dark mode</span>
                        </button>

                        <a href="@Url.Action("Index", "Home")" class="ld-foot-btn ld-foot-logout"
                           data-cs-confirm="You'll need to sign in again to view your records."
                           data-cs-title="Log out?"
                           data-cs-yes="Log out"
                           data-cs-icon="fa-right-from-bracket">
                            <i class="fas fa-right-from-bracket"></i> <span>Log Out</span>
                        </a>

                        <div class="footer-copy">LabDASH &copy; 2026</div>
                    </div>
                    </aside>

                    <!-- ═══════════════════════════
                    MAIN AREA
                    ═══════════════════════════ -->
                    <div class="p-main">

                      

                        <!-- PAGE CONTENT -->
                        <div class="p-content">
                            @RenderBody()
                        </div>

                    </div>

                </div>

                <!-- Toast -->
                <div class="p-toast" id="p-toast"></div>

                <script>
                    function showToast(message, duration) {
                    duration = duration || 3000;
                    var t = document.getElementById('p-toast');
                    t.textContent = message;
                    t.classList.add('show');
                    setTimeout(function() { t.classList.remove('show'); }, duration);
                    }
                    function removeTag(btn) { btn.closest('span').remove(); }
                    function addTag(containerId, inputId, cssClass) {
                    var input = document.getElementById(inputId);
                    var val = input.value.trim();
                    if (!val) return;
                    var span = document.createElement('span');
                    span.className = cssClass;
                    if (cssClass === 'p-tag-cond') {
                    span.innerHTML = val + ' <i class="fas fa-times p-tag-rm" onclick="removeTag(this)"></i>';
                    } else {
                    span.textContent = val;
                    }
                    document.getElementById(containerId).appendChild(span);
                    input.value = '';
                    showToast('Added successfully.');
                    }
                    function toggleConsent(btn) {
                    if (btn.textContent.trim() === 'Revoke') {
                    btn.textContent = 'Grant';
                    btn.className = 'p-cbtn p-cb-grant';
                    showToast('Access revoked.');
                    } else {
                    btn.textContent = 'Revoke';
                    btn.className = 'p-cbtn p-cb-revoke';
                    showToast('Access granted. Doctor notified.');
                    }
                    }
                    function switchTab(el, showId, hideIds) {
                    document.querySelectorAll('.p-tab').forEach(function(t) { t.classList.remove('p-tab-on'); });
                    el.classList.add('p-tab-on');
                    hideIds.forEach(function(id) { var e = document.getElementById(id); if (e) e.style.display = 'none'; });
                    var s = document.getElementById(showId); if (s) s.style.display = '';
                    }
                </script>

                @await RenderSectionAsync("Scripts", required: false)
            }
            else { }
        }
    @await Html.PartialAsync("_Popups")
</body>
</html>
