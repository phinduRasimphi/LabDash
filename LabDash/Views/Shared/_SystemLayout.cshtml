            <!-- LOGOUT MODAL JAVASCRIPT -->
            <script>
                    function openLogoutModal() {
                        const modal = document.getElementById('logoutModal');
                        const checkbox = document.getElementById('confirmLogoutCheckbox');
                        const confirmButton = document.getElementById('confirmLogoutBtn');
                        const cancelButton = modal.querySelector('.cancel-logout-btn');

                        checkbox.checked = false;
                        confirmButton.disabled = true;
                        modal.classList.add('show');

                        cancelButton.focus();
                    }

                    function closeLogoutModal() {
                        document.getElementById('logoutModal').classList.remove('show');
                    }

                    document.getElementById('confirmLogoutCheckbox')
                        .addEventListener('change', function() {
                            document.getElementById('confirmLogoutBtn').disabled = !this.checked;
                        });

                    function confirmLogout() {
                        const checkbox = document.getElementById('confirmLogoutCheckbox');

                        if (!checkbox.checked) {
                            return;
                        }

                        document.getElementById('logoutForm').submit();
                    }

                    document.getElementById('logoutModal')
                        .addEventListener('click', function(event) {
                            if (event.target === this) {
                                closeLogoutModal();
                            }
                        });

                    document.addEventListener('keydown', function(event) {
                        const modal = document.getElementById('logoutModal');

                        if (event.key === 'Escape' && modal.classList.contains('show')) {
                            closeLogoutModal();
                        }
                    });
            </script>

