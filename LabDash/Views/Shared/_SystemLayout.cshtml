@using LabDash.Areas.Identity.Data
@using Microsoft.AspNetCore.Identity
@inject SignInManager<LabUser> SignInManager
@inject UserManager<LabUser> UserManager
<!DOCTYPE html>

<html>
<head>
    <meta name="viewport" content="width=device-width" />
    <title>@ViewBag.Title</title>
</head>
<body>
     @if (SignInManager.IsSignedIn(User))
    {
        if (User.IsInRole("Admin"))
        {
            <div class="a-shell">

                <!-- ═══════════════════════════
                     GREEN SIDEBAR
                ═══════════════════════════ -->
                <aside class="a-sidebar">

                    <!-- Logo -->
                    <div class="a-logo">
                        <div class="a-logo-icon"><i class="fas fa-shield-alt"></i></div>
                        <div class="a-logo-text">Admin<span>Panel</span></div>
                    </div>

                    <!-- Admin identity strip -->
                    <div class="a-user-strip">
                        <div class="a-user-av">AD</div>
                        <div>
                            <div class="a-user-name">Administrator</div>
                            <div class="a-user-role"><i class="fas fa-circle"></i> Online</div>
                        </div>
                    </div>

                    <!-- Navigation -->
                    <nav class="a-nav">

                        <div class="a-nav-label">Overview</div>
                        <a href="@Url.Action("Dashboard", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "Dashboard" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-th-large"></i></span>
                            <span>Dashboard</span>
                        </a>

                        <div class="a-nav-label">Medical Reference Data</div>
                        <a href="@Url.Action("Conditions", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "Conditions" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-heartbeat"></i></span>
                            <span>Conditions</span>
                        </a>
                        <a href="@Url.Action("Allergies", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "Allergies" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-allergies"></i></span>
                            <span>Allergies</span>
                        </a>
                        <a href="@Url.Action("Medications", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "Medications" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-pills"></i></span>
                            <span>Medications</span>
                        </a>

                        <div class="a-nav-label">System</div>
                        <a href="@Url.Action("SystemTables", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "SystemTables" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-database"></i></span>
                            <span>System Tables</span>
                        </a>
                        <a href="@Url.Action("AuditLog", "Admin")"
                           class="a-nav-link @(ViewData["ActivePage"]?.ToString() == "AuditLog" ? "a-active" : "")">
                            <span class="a-nav-icon"><i class="fas fa-history"></i></span>
                            <span>Audit Log</span>
                        </a>

                    </nav>
                    <!-- Sidebar footer -->
                    <div class="a-sidebar-footer">
                        <a href="@Url.Action("Landing", "Home")" class="a-logout">
                            <i class="fas fa-sign-out-alt"></i> Log Out
                        </a>
                        <div class="a-footer-note">LabPulse ; 2026</div>
                    </div>


                </aside>

                <!-- ═══════════════════════════
                     MAIN AREA
                ═══════════════════════════ -->
                <div class="a-main">

                    <!-- TOP BAR -->
                    <div class="a-topbar">
                        <div class="a-tb-left">
                            <div class="a-tb-title">@(ViewData["Title"] ?? "Dashboard")</div>
                            <div class="a-tb-sub">
                                @DateTime.Now.ToString("dddd, dd MMMM yyyy") &nbsp;·&nbsp; Admin Panel
                            </div>
                        </div>
                        <div class="a-tb-right">
                            <div class="a-notif">
                                <i class="fas fa-bell"></i>
                                <div class="a-ndot"></div>
                            </div>
                        </div>
                    </div>

                    <!-- PAGE CONTENT -->
                    <div class="a-content">
                        @RenderBody()
                    </div>

                </div>

            </div>

            <!-- Toast -->
            <div class="a-toast" id="a-toast"></div>

            <script>
                function showToast(message, duration) {
                    duration = duration || 3000;
                    var t = document.getElementById('a-toast');
                    t.textContent = message;
                    t.classList.add('show');
                    setTimeout(function () { t.classList.remove('show'); }, duration);
                }
                function removeChip(el) { el.parentElement.remove(); }
                function addChip(containerId, inputId, cls) {
                    var input = document.getElementById(inputId);
                    var val = input.value.trim();
                    if (!val) return;
                    var span = document.createElement('span');
                    span.className = 'a-chip ' + cls;
                    span.innerHTML = val + ' <span class="a-chip-rm" onclick="removeChip(this)">✕</span>';
                    document.getElementById(containerId).appendChild(span);
                    input.value = '';
                    showToast('Category added.');
                }
                function openModal(id) { document.getElementById(id).classList.add('open'); }
                function closeModal(id) { document.getElementById(id).classList.remove('open'); }
            </script>

            @await RenderSectionAsync("Scripts", required: false)
                
        }

        else if (User.IsInRole("Doctor"))
