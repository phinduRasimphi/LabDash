@inject SignInManager<LabUser> SignInManager
@inject UserManager<LabUser> UserManager
<!DOCTYPE html>

<html>
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title</title>
    @if (User.IsInRole("Admin") || User.IsInRole("Patient"))
    {
        @await Html.PartialAsync("_Theme")
    }

    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.0/css/all.min.css" />
    <link rel="icon" type="image/png" href="~/images/labdash-icon.png" />
<style>
    .ld-brand { display: flex; align-items: center; padding: 0 22px 22px; }
    .ld-brand img, .sidebar-brand img { height: 34px; width: auto; display: block; }
    .ld-mini { display: none; }
    @@media (max-width: 700px) {
        .sidebar-brand .ld-full { display: none; }
        .sidebar-brand .ld-mini { display: block; }
    }
</style>
    @if (User.IsInRole("Admin"))
    {
        <link rel="stylesheet" href="~/css/AdminDashboard.css" asp-append-version="true" />
    }
    else if (User.IsInRole("Doctor"))
    {
        <link rel="stylesheet" href="~/css/DoctorDashboard.css" asp-append-version="true" />
    }
    else if (User.IsInRole("Lab_Technician"))
    {
        <link rel="stylesheet" href="~/css/TechnicianDashboard.css" asp-append-version="true" />
    }
    else if (User.IsInRole("Patient"))
    {
        <link rel="stylesheet" href="~/css/PatientDashboard.css" asp-append-version="true" />
    }
    else if (User.IsInRole("Lab_Manager"))
    {
        <link rel="stylesheet" href="~/css/TechnicianDashboard.css" asp-append-version="true" />
    }

    @await RenderSectionAsync("Head", required: false)
</head>
