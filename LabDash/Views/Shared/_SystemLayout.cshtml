                    color: #334155;
                    font-size: 13px;
                    }

                    .stock-alert small {
                    color: #94a3b8;
                    }


                    /* =========================================
                    QUICK ACTIONS
                    ========================================= */

                    .quick-actions {
                    display: grid;
                    grid-template-columns: repeat(4, 1fr);
                    gap: 15px;
                    }

                    .quick-action {
                    text-decoration: none;
                    text-align: center;
                    background: white;
                    border: 1px solid #ccfbf1;
                    border-radius: 12px;
                    padding: 20px;
                    transition: 0.2s;
                    }

                    .quick-action:hover {
                    border-color: #0f766e;
                    transform: translateY(-2px);
                    box-shadow: 0 5px 15px rgba(15,118,110,0.12);
                    }

                    .quick-action i {
