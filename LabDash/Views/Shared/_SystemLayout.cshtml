                <!-- Toast -->
                <div class="p-toast" id="p-toast"></div>

                <script>
                    function showToast(message, duration) {
                        duration = duration || 3000;
                        var t = document.getElementById('p-toast');
                        t.textContent = message;
                        t.classList.add('show');
                        setTimeout(function () { t.classList.remove('show'); }, duration);
                    }
                    function removeTag(btn) { btn.closest('span').remove(); }
                    function addTag(containerId, inputId, cssClass) {
                        var input = document.getElementById(inputId);
                        var val = input.value.trim();
                        if (!val) return;
                        var span = document.createElement('span');
                        span.className = cssClass;
                        if (cssClass === 'p-tag-cond') {
                            span.innerHTML = val + ' <i class="fas fa-times p-tag-rm" onclick="removeTag(this)"></i>';
                        } else {
                            span.textContent = val;
                        }
                        document.getElementById(containerId).appendChild(span);
                        input.value = '';
                        showToast('Added successfully.');
                    }
                    function toggleConsent(btn) {
                        if (btn.textContent.trim() === 'Revoke') {
                            btn.textContent = 'Grant';
                            btn.className = 'p-cbtn p-cb-grant';
                            showToast('Access revoked.');
                        } else {
                            btn.textContent = 'Revoke';
                            btn.className = 'p-cbtn p-cb-revoke';
                            showToast('Access granted. Doctor notified.');
                        }
                    }
                    function switchTab(el, showId, hideIds) {
                        document.querySelectorAll('.p-tab').forEach(function (t) { t.classList.remove('p-tab-on'); });
                        el.classList.add('p-tab-on');
                        hideIds.forEach(function (id) { var e = document.getElementById(id); if (e) e.style.display = 'none'; });
                        var s = document.getElementById(showId); if (s) s.style.display = '';
                    }
                </script>

                @await RenderSectionAsync("Scripts", required: false)
        }

        }

            
    <div>
        @RenderBody()
    </div>
</body>
</html>
