                        <div class="d-logo-text">NMB<span>LAB</span></div>
                    </div>

                    <!-- Doctor identity strip -->
                    <div class="d-user-strip" id="doctorProfileBtn">
                        <div class="d-user-av">DM</div>
                        <div>
                            <div class="d-user-name">Dr. Makuwa</div>
                            <div class="d-user-role"><i class="fas fa-circle"></i> Online</div>
                        </div>
                    </div>

                    <!-- Navigation -->
