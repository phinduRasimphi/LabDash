@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Review Test Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var verification = ViewBag.Verification as TestVerification;

    // Every time this test was returned for review, newest first.
    var returnHistory = ViewBag.ReturnHistory as List<TestVerification>
                        ?? new List<TestVerification>();

    var patientName = $"{patient?.Name} {patient?.Surname}".Trim();

    var referenceRange = test?.TestType?.ReferenceRangeLow != null
        && test?.TestType?.ReferenceRangeHigh != null
        ? $"{test.TestType.ReferenceRangeLow} - {test.TestType.ReferenceRangeHigh}"
        : "Not specified";

    var displayUnits = string.IsNullOrWhiteSpace(Model.Units)
        ? test?.TestType?.UnitOfMeasurement ?? "Not specified"
        : Model.Units;

    var displayReferenceRange = string.IsNullOrWhiteSpace(Model.ReferenceRange)
        ? referenceRange
        : Model.ReferenceRange;

    // On first load (GET) the model holds the PREVIOUS result, so the new-result fields start blank.
    // After a failed validation (POST) the model holds what the user just typed, so we keep it.
    var isPost = Context.Request.Method == "POST";
    var newValue = isPost ? Model.ResultValue : "";
    var newComments = isPost ? Model.Comments : "";

    var latestReturn = returnHistory.FirstOrDefault();
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

<div class="review-page">

    <!-- HEADER -->

    <div class="review-heading">
        <div class="review-heading-icon">
            <i class="fa-solid fa-rotate-left"></i>
        </div>

        <div>
            <h1>Review Test Result</h1>
            <p>Check the verifier's feedback, capture a new result and resubmit it.</p>
        </div>

        <div class="heading-test">
            <span>Current Laboratory Test</span>
            <strong>@(test?.TestType?.Name ?? "Laboratory Test")</strong>
        </div>
    </div>

    <!-- PATIENT + TEST INFORMATION -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION: LEFT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-user"></i> Patient Information</span>
            </div>

            <div class="card-body">

                <div class="patient-profile">
                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="profile-details">
                        <span class="eyebrow">PATIENT</span>
                        <h2>@patientName</h2>
                    </div>
                </div>

                <div class="patient-detail-list">

                    <div class="patient-detail-row">
                        <span>ID Number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of Birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-label">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical Information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <strong>Allergies</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            <strong>Medical Conditions</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            <strong>Medication</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-label">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor Clinical Notes
                </div>

                <div class="doctor-notes">
                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's Notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided."
                            : test.TestRequest.ClinicalNotes)
                    </p>
                </div>

            </div>
        </section>

        <!-- TEST INFORMATION: RIGHT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-vials"></i> Test Information</span>
            </div>

            <div class="card-body">

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">LABORATORY TEST</span>

                        <h2>@(test?.TestType?.Name ?? "Laboratory Test")</h2>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(test?.TestType?.Category ?? "Uncategorised")
                        </span>
                    </div>

                    <span class="request-pill">
                        TR-@test?.RequestId
                    </span>

                </div>

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span><i class="fa-solid fa-droplet"></i> Sample Type</span>
                        <strong>
                            @(test?.TestType?.RequiredSampleType ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-flask"></i> Test Category</span>
                        <strong>
                            @(test?.TestType?.Category ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Request Number</span>
                        <strong>TR-@test?.RequestId</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test Item</span>
                        <strong>#@Model.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-ruler"></i> Unit of Measurement</span>
                        <strong>@displayUnits</strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-chart-line"></i> Reference Range</span>
                        <strong>@displayReferenceRange</strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-circle-check"></i> Current Status</span>
                        <strong>
                            <span class="status-pill returned">
                                <i class="fa-solid fa-rotate-left"></i>
                                Returned for review
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-rotate-left"></i> Times Returned</span>
                        <strong>
                            @(returnHistory.Count > 0
                                ? returnHistory.Count
                                : (test?.ReviewReturnCount ?? 0))
                        </strong>
                    </div>

                </div>

                <div class="configured-range">
                    <span>Configured Reference Range</span>
                    <strong>
                        @referenceRange
                        @if (!string.IsNullOrWhiteSpace(test?.TestType?.UnitOfMeasurement))
                        {
                            <small>@test.TestType.UnitOfMeasurement</small>
                        }
                    </strong>
                </div>

            </div>
        </section>

    </div>

    <!-- VERIFICATION FEEDBACK (latest return) -->

    <section class="information-card feedback-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-rotate-left"></i>
                Latest Verification Feedback
            </span>

            <span class="returned-badge">Returned for Correction</span>
        </div>

        <div class="feedback-body">

            <div class="feedback-meta">

                <div>
                    <span>Returned By</span>
                    <strong>
                        @(ViewBag.VerifierName as string
                            ?? latestReturn?.VerifiedByTechnician?.FullName
                            ?? verification?.VerifiedByTechnician?.FullName
                            ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Date Returned</span>
                    <strong>
                        @(verification != null
                            ? verification.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            : latestReturn != null
                                ? latestReturn.VerificationDate.ToString("dd MMM yyyy HH:mm")
                                : "Not available")
                    </strong>
                </div>

            </div>

            <div class="feedback-reason">
                <span>Reason for Return</span>
                <p>
                    @(!string.IsNullOrWhiteSpace(verification?.VerificationNotes)
                        ? verification.VerificationNotes
                        : !string.IsNullOrWhiteSpace(latestReturn?.VerificationNotes)
                            ? latestReturn.VerificationNotes
                            : "No verification comments were recorded.")
                </p>
            </div>

        </div>
    </section>

    <!-- RESULT HISTORY + CAPTURE NEW RESULT -->

    <section class="information-card result-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-pen-to-square"></i>
                Capture New Result
            </span>

            <span class="header-subtitle">Compare with every previous result, then resubmit</span>
        </div>

        <form asp-action="Review" method="post" class="result-form" id="reviewForm">

            <input asp-for="ResultId" type="hidden" />
            <input asp-for="TestRequestItemId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <!-- RESULT HISTORY (read-only): every attempt that was returned -->

            <div class="history-heading">
                <i class="fa-solid fa-clock-rotate-left"></i>
                Result history
                <span class="previous-tag">
                    @returnHistory.Count @(returnHistory.Count == 1 ? "previous result" : "previous results")
                </span>
            </div>

            @if (!returnHistory.Any())
            {
                <div class="previous-result">
                    <em class="history-empty">No previous results have been recorded for this test.</em>
                </div>
            }
            else
            {
                <div class="history-list @(returnHistory.Count > 3 ? "scrollable" : "")">

                    @for (var i = 0; i < returnHistory.Count; i++)
                    {
                        var h = returnHistory[i];
                        var attemptNumber = returnHistory.Count - i;
                        var isLatest = i == 0;
                        var hasValue = !string.IsNullOrWhiteSpace(h.PreviousResultValue);

                        <div class="previous-result @(isLatest ? "latest" : "")">

                            <div class="previous-result-heading">
                                <i class="fa-solid fa-flask"></i>
                                Attempt @attemptNumber

                                @if (isLatest)
                                {
                                    <span class="previous-tag">Latest</span>
                                }

                                <span class="previous-tag muted-tag">
                                    Returned @h.VerificationDate.ToString("dd MMM yyyy HH:mm")
                                </span>
                            </div>

                            <div class="previous-result-body">

                                <div class="previous-value">
                                    <span>Result value</span>
                                    <strong>
                                        @(hasValue ? h.PreviousResultValue : "Not recorded")
                                        @if (hasValue)
                                        {
                                            <small>@displayUnits</small>
                                        }
                                    </strong>
                                </div>

                                <div class="previous-class">
                                    <span>Classification</span>
                                    @if (!hasValue)
                                    {
                                        <strong class="previous-range">Not recorded</strong>
                                    }
                                    else if (h.PreviousIsAbnormal == true)
                                    {
                                        <span class="status-pill abnormal">
                                            <i class="fa-solid fa-triangle-exclamation"></i>
                                            Abnormal
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="status-pill normal">
                                            <i class="fa-solid fa-circle-check"></i>
                                            Within Range
                                        </span>
                                    }
                                </div>

                                <div class="previous-class">
                                    <span>Reference range</span>
                                    <strong class="previous-range">@displayReferenceRange</strong>
                                </div>

                            </div>

                            @if (!string.IsNullOrWhiteSpace(h.PreviousComments))
                            {
                                <div class="previous-comments">
                                    <span>Laboratory comments</span>
                                    <p>@h.PreviousComments</p>
                                </div>
                            }

                            <div class="previous-comments return-reason">
                                <span>
                                    Returned by @(h.VerifiedByTechnician?.FullName ?? "Verifier")
                                </span>
                                <p>
                                    @(string.IsNullOrWhiteSpace(h.VerificationNotes)
                                        ? "No verification comments were recorded."
                                        : h.VerificationNotes)
                                </p>
                            </div>

                        </div>
                    }

                </div>
            }

            <!-- NEW RESULT (editable) -->

            <div class="new-result-heading">
                <i class="fa-solid fa-circle-plus"></i>
                New result
            </div>

            <div class="result-grid">

                <div class="form-field full-width">
                    <label for="ResultValue">New result value</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-flask"></i>
                        <input id="ResultValue"
                               name="ResultValue"
                               value="@newValue"
                               type="text"
                               inputmode="decimal"
                               autocomplete="off"
                               maxlength="20"
                               class="form-control"
                               placeholder="Enter the new numeric value, e.g. 12.5"
                               data-numeric-only="true"
                               data-val="true"
                               data-val-required="Please enter the new result value."
                               data-val-regex="Result value must be a number (digits and one decimal point only)."
                               data-val-regex-pattern="^[0-9]+([.][0-9]+)?$" />
                    </div>

                    <span asp-validation-for="ResultValue"
                          class="validation-error"></span>
                </div>

                <!-- READ-ONLY: Units (set by the test configuration, not posted) -->

                <div class="form-field">
                    <label>Units</label>

                    <div class="input-wrapper readonly-field">
                        <i class="fa-solid fa-ruler"></i>
                        <input type="text"
                               class="form-control"
                               value="@displayUnits"
                               readonly
                               tabindex="-1"
                               aria-readonly="true" />
                        <i class="fa-solid fa-lock readonly-lock"
                           title="Set by the test configuration"></i>
                    </div>
                </div>

                <!-- READ-ONLY: Reference Range (set by the test configuration, not posted) -->

                <div class="form-field">
                    <label>Reference Range</label>

                    <div class="input-wrapper readonly-field">
                        <i class="fa-solid fa-chart-line"></i>
                        <input type="text"
                               class="form-control"
                               value="@displayReferenceRange"
                               readonly
                               tabindex="-1"
                               aria-readonly="true" />
                        <i class="fa-solid fa-lock readonly-lock"
                           title="Set by the test configuration"></i>
                    </div>
                </div>

                <div class="form-field full-width">
                    <label for="Comments">New laboratory comments</label>

                    <textarea id="Comments"
                              name="Comments"
                              class="form-control result-textarea"
                              rows="4"
                              placeholder="Describe the correction made or add any relevant comments...">@newComments</textarea>

                    <span asp-validation-for="Comments"
                          class="validation-error"></span>
                </div>

            </div>

            <div class="result-actions">

                <a asp-action="Index" class="cancel-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel
                </a>

                <button type="submit" class="submit-button">
                    <i class="fa-solid fa-paper-plane"></i>
                    Save &amp; Resubmit
                </button>

            </div>

        </form>
    </section>

    <!-- CONFIRM RESUBMIT MODAL -->

    <div class="confirm-overlay" id="confirmOverlay" hidden>
        <div class="confirm-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="confirmTitle"
             aria-describedby="confirmText">

            <div class="confirm-icon">
                <i class="fa-solid fa-paper-plane"></i>
            </div>

            <h3 id="confirmTitle">Submit these results?</h3>

            <p id="confirmText">
                The corrected result will be saved and sent back to the
                verification queue. You won't be able to edit it afterwards.
            </p>

            <div class="confirm-summary">
                <div>
                    <span>New result value</span>
                    <strong id="confirmValue">—</strong>
                </div>
                <div>
                    <span>Comments</span>
                    <strong id="confirmComments">—</strong>
                </div>
            </div>

            <div class="confirm-actions">
                <button type="button" class="cancel-button" id="confirmNo">
                    <i class="fa-solid fa-xmark"></i>
                    No, go back
                </button>

                <button type="button" class="submit-button" id="confirmYes">
                    <i class="fa-solid fa-check"></i>
                    Yes, submit
                </button>
            </div>
        </div>
    </div>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        (function() {
            var input = document.querySelector('[data-numeric-only="true"]');
            if (!input) return;

            // Keeps only digits and a single decimal point.
            // A comma is converted to a dot (South African keyboards often use a comma).
            function sanitise(value) {
                value = value.replace(/,/g, '.').replace(/[^0-9.]/g, '');

                var firstDot = value.indexOf('.');
                if (firstDot !== -1) {
                    value = value.slice(0, firstDot + 1) +
                        value.slice(firstDot + 1).replace(/\./g, '');
                }
                return value;
            }

            input.addEventListener('input', function() {
                var cleaned = sanitise(input.value);
                if (input.value !== cleaned) input.value = cleaned;
            });

            // Also clean up pasted text
            input.addEventListener('paste', function(e) {
                e.preventDefault();
                var text = (e.clipboardData || window.clipboardData).getData('text');
                var cleaned = sanitise(text);
                var start = input.selectionStart, end = input.selectionEnd;
                input.value = sanitise(
                    input.value.slice(0, start) + cleaned + input.value.slice(end)
                );
            });
        })();
    </script>

    <script>
        (function () {
            var form = document.getElementById('reviewForm');
            var overlay = document.getElementById('confirmOverlay');
            if (!form || !overlay) return;

            var yes = document.getElementById('confirmYes');
            var no = document.getElementById('confirmNo');
            var valueEl = document.getElementById('confirmValue');
            var commentsEl = document.getElementById('confirmComments');
            var valueInput = document.getElementById('ResultValue');
            var commentsInput = document.getElementById('Comments');
            var units = @Html.Raw(System.Text.Json.JsonSerializer.Serialize(displayUnits));

            var confirmed = false;
            var lastFocus = null;

            function isValid() {
                // Use the built-in jQuery validation when it is loaded
                if (window.jQuery && jQuery.fn.valid) {
                    return jQuery(form).valid();
                }
                return /^[0-9]+([.][0-9]+)?$/.test(valueInput.value.trim());
            }

            function openModal() {
                lastFocus = document.activeElement;

                valueEl.textContent = valueInput.value.trim() + ' ' + units;
                commentsEl.textContent = commentsInput.value.trim() || 'No comments added';

                overlay.hidden = false;
                document.body.style.overflow = 'hidden';
                no.focus();
            }

            function closeModal() {
                overlay.hidden = true;
                document.body.style.overflow = '';
                if (lastFocus) lastFocus.focus();
            }

            // Intercept every submit (button click AND the Enter key)
            form.addEventListener('submit', function (e) {
                if (confirmed) return;          // already confirmed, let it post

                e.preventDefault();
                if (isValid()) openModal();
            });

            yes.addEventListener('click', function () {
                confirmed = true;
                yes.disabled = true;            // stop double-clicks
                no.disabled = true;
                form.submit();                  // native submit, skips the handler above
            });

            no.addEventListener('click', closeModal);

            // Click outside the box to close
            overlay.addEventListener('mousedown', function (e) {
                if (e.target === overlay) closeModal();
            });

            // Escape closes it
            document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && !overlay.hidden) closeModal();
            });
        })();
    </script>
}

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --text: #0f2f2d;
        --muted: #6b817f;
        --border: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --red: #c0443f;
        --red-bg: #fde8e8;
        --red-border: #f3c4c4;
        --gold: #a87308;
        --gold-bg: #fff3d9;
        --success: #198754;
        --success-bg: #e2f5e9;
        --card-radius: 20px;
        --card-shadow: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .review-page,
    .review-page * {
        box-sizing: border-box;
    }

    .review-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        background: var(--page-bg);
        color: var(--text);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    /* ---------- HERO HEADER ---------- */

    .review-heading {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .review-heading-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .review-heading h1 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .review-heading p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .heading-test {
        min-width: 220px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

        .heading-test span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .heading-test strong {
            color: #fff;
            font-size: 18px;
            font-weight: 700;
        }

    /* ---------- MAIN TWO-COLUMN LAYOUT ---------- */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 22px;
        margin-bottom: 22px;
    }

    .information-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }

    .information-grid > .information-card {
        height: 100%;
    }

    /* white card header with teal icon + bold title (scoped to override Bootstrap's .card-header) */
    .review-page .card-header {
        min-height: 64px;
        padding: 18px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #fff;
        color: var(--text);
        border: 0;
        border-bottom: 1px solid var(--border);
        border-radius: 0;
