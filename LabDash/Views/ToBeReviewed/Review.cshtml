@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Review Test Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var verification = ViewBag.Verification as TestVerification;

    var patientName = $"{patient?.Name} {patient?.Surname}".Trim();
    var initials = !string.IsNullOrWhiteSpace(patient?.Name)
        ? patient.Name.Substring(0, 1).ToUpper()
        : "P";

    var referenceRange = test?.TestType?.ReferenceRangeLow != null
        && test?.TestType?.ReferenceRangeHigh != null
        ? $"{test.TestType.ReferenceRangeLow} - {test.TestType.ReferenceRangeHigh}"
        : "Not specified";

    var isAbnormal = Model.IsAbnormal;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap"
      rel="stylesheet">

<div class="review-page">

    <!-- HEADER -->

    <div class="review-heading">
        <div class="review-heading-icon">
            <i class="fa-solid fa-rotate-left"></i>
        </div>

        <div>
            <h1>Review Test Result</h1>
            <p>Check the verifier's feedback, correct the result and resubmit it.</p>
        </div>

        <div class="heading-test">
            <span>Current Laboratory Test</span>
            <strong>@(test?.TestType?.Name ?? "Laboratory Test")</strong>
        </div>
    </div>

    <!-- PATIENT + TEST INFORMATION -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION: LEFT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-user"></i> Patient Information</span>
            </div>

            <div class="card-body">

                <div class="patient-profile">
                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="profile-details">
                        <span class="eyebrow">PATIENT</span>
                        <h2>@patientName</h2>
                    </div>
                </div>

                <div class="patient-detail-list">

                    <div class="patient-detail-row">
                        <span>ID Number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of Birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-label">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical Information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <strong>Allergies</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            <strong>Medical Conditions</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            <strong>Medication</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-label">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor Clinical Notes
                </div>

                <div class="doctor-notes">
                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's Notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided."
                            : test.TestRequest.ClinicalNotes)
                    </p>
                </div>

            </div>
        </section>

        <!-- TEST INFORMATION: RIGHT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-vials"></i> Test Information</span>
            </div>

            <div class="card-body">

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">LABORATORY TEST</span>

                        <h2>@(test?.TestType?.Name ?? "Laboratory Test")</h2>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(test?.TestType?.Category ?? "Uncategorised")
                        </span>
                    </div>

                    <span class="request-pill">
                        TR-@test?.RequestId
                    </span>

                </div>

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span><i class="fa-solid fa-droplet"></i> Sample Type</span>
                        <strong>
                            @(test?.TestType?.RequiredSampleType ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-flask"></i> Test Category</span>
                        <strong>
                            @(test?.TestType?.Category ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Request Number</span>
                        <strong>TR-@test?.RequestId</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test Item</span>
                        <strong>#@Model.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-ruler"></i> Unit of Measurement</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Units)
                                ? test?.TestType?.UnitOfMeasurement ?? "Not specified"
                                : Model.Units)
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-chart-line"></i> Reference Range</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.ReferenceRange)
                                ? referenceRange
                                : Model.ReferenceRange)
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-circle-check"></i> Current Status</span>
                        <strong>
                            <span class="status-pill completed">
                                <i class="fa-solid fa-circle-check"></i>
                                Completed
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-triangle-exclamation"></i> Result Classification</span>
                        <strong>
                            @if (isAbnormal)
                            {
                                <span class="status-pill abnormal">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    Abnormal
                                </span>
                            }
                            else
                            {
                                <span class="status-pill normal">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Within Range
                                </span>
                            }
                        </strong>
                    </div>

                </div>

                <div class="configured-range">
                    <span>Configured Reference Range</span>
                    <strong>
                        @referenceRange
                        @if (!string.IsNullOrWhiteSpace(test?.TestType?.UnitOfMeasurement))
                        {
                            <small>@test.TestType.UnitOfMeasurement</small>
                        }
                    </strong>
                </div>

                <!-- CURRENT RESULT -->

                <div class="current-result">
                    <div class="current-result-heading">
                        <i class="fa-solid fa-file-waveform"></i>
                        Previously Captured Result
                    </div>

                    <div class="current-result-value">
                        <span>Result Value</span>
                        <strong>@(Model.ResultValue ?? "Not recorded")</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Comments))
                    {
                        <div class="current-result-comments">
                            <span>Laboratory Comments</span>
                            <p>@Model.Comments</p>
                        </div>
                    }
                </div>

            </div>
        </section>

    </div>

    <!-- VERIFICATION FEEDBACK -->

    <section class="information-card feedback-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-rotate-left"></i>
                Verification Feedback
            </span>

            <span class="returned-badge">Returned for Correction</span>
        </div>

        <div class="feedback-body">

            <div class="feedback-meta">

                <div>
                    <span>Returned By</span>
                    <strong>
                        @(verification?.VerifiedByTechnicianId?.ToString()
                            ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Date Returned</span>
                    <strong>
                        @(verification != null
                            ? verification.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            : "Not available")
                    </strong>
                </div>

            </div>

            <div class="feedback-reason">
                <span>Reason for Return</span>
                <p>
                    @(string.IsNullOrWhiteSpace(verification?.VerificationNotes)
                        ? "No verification comments were recorded."
                        : verification.VerificationNotes)
                </p>
            </div>

        </div>
    </section>

    <!-- UPDATE RESULT -->

    <section class="information-card result-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-pen-to-square"></i>
                Update Laboratory Result
            </span>

            <span class="header-subtitle">Correct and resubmit the result</span>
        </div>

        <form asp-action="Review" method="post" class="result-form">

            <input asp-for="ResultId" type="hidden" />
            <input asp-for="TestRequestItemId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="result-grid">

                <div class="form-field">
                    <label asp-for="ResultValue">Result Value</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-flask"></i>
                        <input asp-for="ResultValue"
                               class="form-control"
                               placeholder="Enter result value" />
                    </div>

                    <span asp-validation-for="ResultValue"
                          class="validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Units">Units</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-ruler"></i>
                        <input asp-for="Units"
                               class="form-control"
                               placeholder="e.g. g/dL, %, mmol/L" />
                    </div>

                    <span asp-validation-for="Units"
                          class="validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label asp-for="ReferenceRange">Reference Range</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-chart-line"></i>
                        <input asp-for="ReferenceRange"
                               class="form-control"
                               placeholder="Enter the reference range" />
                    </div>

                    <span asp-validation-for="ReferenceRange"
                          class="validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Comments">Laboratory Comments</label>

                    <textarea asp-for="Comments"
                              class="form-control result-textarea"
                              rows="4"
                              placeholder="Enter any relevant laboratory comments..."></textarea>

                    <span asp-validation-for="Comments"
                          class="validation-error"></span>
                </div>

            </div>

            <div class="result-actions">

                <a asp-action="Index" class="cancel-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel
                </a>

                <button type="submit" class="submit-button">
                    <i class="fa-solid fa-paper-plane"></i>
                    Save &amp; Resubmit
                </button>

            </div>

        </form>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    :root {
        --teal: #0f9488;
        --teal-dark: #0b6f66;
        --teal-deep: #0a5a52;
        --teal-light: #e1f3f0;
        --teal-soft: #eef7f6;
        --teal-border: #cfe6e3;
        --text: #0f2f2d;
        --muted: #6b817f;
        --border: #e3ecec;
        --page-bg: #e9f0f1;
        --field-bg: #eff5f4;
        --red: #c0443f;
        --red-bg: #fde8e8;
        --red-border: #f3c4c4;
        --gold: #a87308;
        --gold-bg: #fff3d9;
        --success: #198754;
        --success-bg: #e2f5e9;
        --card-radius: 20px;
        --card-shadow: 0 10px 30px rgba(15, 80, 72, .08);
        --hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .review-page,
    .review-page * {
        box-sizing: border-box;
    }

    .review-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        background: var(--page-bg);
        color: var(--text);
        font-family: "Inter", sans-serif;
        font-size: 14px;
    }

    /* ---------- HERO HEADER ---------- */

    .review-heading {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .review-heading-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .review-heading h1 {
        margin: 0 0 4px;
        color: #fff;
        font-family: "Inter", sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .review-heading p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .heading-test {
        min-width: 220px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

    .heading-test span {
        display: block;
        margin-bottom: 4px;
        color: rgba(255, 255, 255, .78);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .heading-test strong {
        color: #fff;
        font-size: 18px;
        font-weight: 700;
    }

    /* ---------- MAIN TWO-COLUMN LAYOUT ---------- */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 22px;
        margin-bottom: 22px;
    }

    .information-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--card-radius);
        box-shadow: var(--card-shadow);
    }

    .information-grid > .information-card {
        height: 100%;
    }

    /* white card header with teal icon + bold title (scoped to override Bootstrap's .card-header) */
    .review-page .card-header {
        min-height: 64px;
        padding: 18px 26px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: #fff;
        color: var(--text);
        border: 0;
        border-bottom: 1px solid var(--border);
        border-radius: 0;
        font-family: "Inter", sans-serif;
        font-size: 17px;
        font-weight: 700;
    }

    .review-page .card-header > span:first-child {
        display: inline-flex;
        align-items: center;
        gap: 11px;
    }

    .review-page .card-header > span:first-child > i {
        flex-shrink: 0;
        color: var(--teal);
        font-size: 16px;
    }

    .review-page .card-body {
        padding: 22px 26px 26px;
    }

    /* ---------- PATIENT PROFILE ---------- */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        padding: 15px;
        margin-bottom: 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .patient-avatar,
    .test-icon {
        width: 52px;
        height: 52px;
        flex: 0 0 52px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 50%;
        background: #fff;
        color: var(--teal-dark);
        border: 2px solid #d5c98a;
        font-size: 20px;
    }

    .profile-details,
    .test-profile-details {
        min-width: 0;
    }

    .eyebrow {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 10px;
        font-weight: 600;
        letter-spacing: .5px;
        text-transform: uppercase;
    }

    .patient-profile h2,
    .test-profile h2 {
        margin: 0;
        color: var(--text);
        font-family: "Inter", sans-serif;
        font-size: 18px;
        line-height: 1.4;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .patient-detail-list {
        margin-bottom: 18px;
    }

    .patient-detail-row {
        min-height: 40px;
        padding: 11px 2px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid var(--border);
        font-size: 13px;
    }

    .patient-detail-row span {
        color: var(--muted);
        flex-shrink: 0;
    }

    .patient-detail-row strong {
        max-width: 65%;
        text-align: right;
        font-weight: 600;
        overflow-wrap: anywhere;
    }

    /* ---------- SECTION LABELS ---------- */

    .section-label {
        display: flex;
        align-items: center;
        gap: 9px;
        margin: 22px 0 12px;
        color: var(--teal-deep);
        font-family: "Inter", sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

    .section-label i {
        color: var(--teal);
    }

    /* ---------- CLINICAL INFORMATION ---------- */

    .clinical-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 10px;
    }

    .clinical-item {
        padding: 12px 15px;
        border: 1px solid transparent;
        border-radius: 14px;
    }

    .clinical-item.allergy {
        color: #a23a3a;
        background: var(--red-bg);
        border-color: var(--red-border);
    }

    .clinical-item.condition {
        color: #8c6108;
        background: var(--gold-bg);
        border-color: #f5dfaa;
    }

    .clinical-item.medication {
        color: var(--teal-dark);
        background: var(--teal-light);
        border-color: var(--teal-border);
    }

    .clinical-item-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 4px;
        font-size: 12px;
    }

    .clinical-item p {
        margin: 0;
        font-size: 13px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    /* ---------- DOCTOR NOTES ---------- */

    .doctor-notes {
        padding: 15px 16px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 14px;
    }

    .notes-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--teal-dark);
        font-size: 12px;
        font-weight: 700;
    }

    .doctor-notes p {
        margin: 0;
        color: #3f605d;
        font-size: 13px;
        line-height: 1.75;
        overflow-wrap: anywhere;
    }

    /* ---------- TEST PROFILE ---------- */

    .test-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        position: relative;
        padding: 15px;
        margin-bottom: 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 16px;
    }

    .test-icon {
        border: 0;
        border-radius: 14px;
        background: var(--teal-light);
        font-size: 22px;
    }

    .test-profile-details {
        flex: 1;
    }

    .test-profile h2 {
        margin-bottom: 6px;
    }

    .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 11px;
        color: var(--teal-dark);
        background: var(--teal-light);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 600;
    }

    .request-pill {
        align-self: flex-start;
        flex-shrink: 0;
        padding: 4px 12px;
        background: #fff;
        color: var(--teal-dark);
        border: 1px solid var(--teal-border);
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
    }

    /* ---------- TEST DETAIL GRID ---------- */

    .test-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 11px;
    }

    .test-detail {
        min-width: 0;
        min-height: 64px;
        padding: 12px 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 14px;
    }

    .test-detail > span {
        display: block;
        margin-bottom: 5px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
    }

    .test-detail > span i {
        margin-right: 4px;
        color: var(--teal);
    }

    .test-detail > strong {
        display: block;
        color: var(--text);
        font-size: 13px;
        font-weight: 700;
        line-height: 1.5;
        overflow-wrap: anywhere;
    }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 5px 11px;
        border-radius: 999px;
        font-size: 11px;
        font-weight: 700;
        white-space: nowrap;
    }

    .status-pill.completed,
    .status-pill.normal {
        color: var(--success);
        background: var(--success-bg);
    }

    .status-pill.abnormal {
        color: var(--red);
        background: var(--red-bg);
    }

    .configured-range {
        padding: 14px 16px;
        margin-top: 12px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-radius: 14px;
    }

    .configured-range > span,
    .current-result-value > span,
    .current-result-comments > span {
        display: block;
        margin-bottom: 5px;
        color: var(--muted);
        font-size: 11px;
        font-weight: 600;
    }

    .configured-range > strong {
        color: var(--teal-deep);
        font-family: "Inter", sans-serif;
        font-size: 17px;
        font-weight: 700;
        overflow-wrap: anywhere;
    }

    .configured-range small {
        margin-left: 5px;
        color: var(--muted);
        font-family: "Inter", sans-serif;
