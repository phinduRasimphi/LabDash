@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Review Test Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var verification = ViewBag.Verification as TestVerification;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">

<div class="review-page">

    <!-- =========================================================
         PAGE HEADER
         ========================================================= -->

    <div class="review-header">

        <div class="review-header-icon">
            <i class="fa-solid fa-rotate-left"></i>
        </div>

        <div>
            <h1>Returned Test Review</h1>
            <p>
                Review the patient's information, correct the result,
                and resubmit it for verification.
            </p>
        </div>

    </div>


    <!-- =========================================================
         PATIENT + TEST INFORMATION
         ========================================================= -->

    <div class="information-grid">

        <!-- =====================================================
             PATIENT INFORMATION
             ===================================================== -->

        <div class="information-card">

            <div class="card-header patient-header">

                <div>
                    <i class="fa-solid fa-user"></i>
                    Patient Information
                </div>

            </div>

            <div class="card-body">

                <div class="patient-profile">

                    <div class="patient-avatar">
                        @patient?.Name?.Substring(0, 1).ToUpper()
                    </div>

                    <div>
                        <span class="patient-label">Patient</span>

                        <h2>
                            @patient?.Name @patient?.Surname
                        </h2>

                        <span class="patient-id">
                            ID: @patient?.IDNumber
                        </span>
                    </div>

                </div>


                <div class="detail-grid">

                    <div class="detail-item">
                        <small>
                            <i class="fa-solid fa-envelope"></i>
                            Email
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(patient?.Email)
                                ? "Not provided"
                                : patient.Email)
                        </strong>
                    </div>


                    <div class="detail-item">
                        <small>
                            <i class="fa-solid fa-phone"></i>
                            Cellphone
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(patient?.CellphoneNumber)
                                ? "Not provided"
                                : patient.CellphoneNumber)
                        </strong>
                    </div>


                    <div class="detail-item">
                        <small>
                            <i class="fa-solid fa-calendar"></i>
                            Date of Birth
                        </small>

                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>


                    <div class="detail-item">
                        <small>
                            <i class="fa-solid fa-location-dot"></i>
                            Address
                        </small>

                        <strong>
                            @(string.IsNullOrWhiteSpace(patient?.HomeAddress)
                                ? "Not provided"
                                : patient.HomeAddress)
                        </strong>
                    </div>

                </div>

            </div>

        </div>


        <!-- =====================================================
             TEST INFORMATION
             ===================================================== -->

        <div class="information-card test-information-card">

            <div class="card-header test-header">

                <div>
                    <i class="fa-solid fa-flask"></i>
                    Test Information
                </div>

                <span class="request-pill">
                    TR-@test?.RequestId
                </span>

            </div>

            <div class="card-body">

                <div class="test-main">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-main-info">

                        <span>Laboratory Test</span>

                        <h2>
                            @test?.TestType?.Name
                        </h2>

                        <div class="test-category">

                            <i class="fa-solid fa-layer-group"></i>

                            @test?.TestType?.Category

                        </div>

                    </div>

                </div>


                <div class="test-detail-grid">

                    <!-- Sample Type -->

                    <div class="test-detail-item">

                        <div class="test-detail-icon sample">
                            <i class="fa-solid fa-droplet"></i>
                        </div>

                        <div>

                            <small>Sample Type</small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(
                                    test?.TestType?.RequiredSampleType)
                                    ? "Not specified"
                                    : test.TestType.RequiredSampleType)
                            </strong>

                        </div>

                    </div>


                    <!-- Unit -->

                    <div class="test-detail-item">

                        <div class="test-detail-icon unit">
                            <i class="fa-solid fa-ruler"></i>
                        </div>

                        <div>

                            <small>Unit of Measurement</small>

                            <strong>
                                @(string.IsNullOrWhiteSpace(
                                    test?.TestType?.UnitOfMeasurement)
                                    ? "Not specified"
                                    : test.TestType.UnitOfMeasurement)
                            </strong>

                        </div>

                    </div>


                    <!-- Reference Range -->

                    <div class="test-detail-item">

                        <div class="test-detail-icon range">
                            <i class="fa-solid fa-chart-line"></i>
                        </div>

                        <div>

                            <small>Reference Range</small>

                            <strong>

                                @if (test?.TestType?.ReferenceRangeLow != null &&
                                     test?.TestType?.ReferenceRangeHigh != null)
                                {
                                    @($"{test.TestType.ReferenceRangeLow} - {test.TestType.ReferenceRangeHigh}")
                                }
                                else
                                {
                                    <text>Not specified</text>
                                }

                            </strong>

                        </div>

                    </div>


                    <!-- Turnaround -->

                    <div class="test-detail-item">

                        <div class="test-detail-icon time">
                            <i class="fa-solid fa-clock"></i>
                        </div>

                        <div>

                            <small>Turnaround Time</small>

                            <strong>

                                @if (test?.TestType?.TurnaroundTimeHours != null)
                                {
                                    @($"{test.TestType.TurnaroundTimeHours} hours")
                                }
                                else
                                {
                                    <text>Not specified</text>
                                }

                            </strong>

                        </div>

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         CLINICAL INFORMATION
         ========================================================= -->

    <div class="clinical-card">

        <div class="clinical-header">

            <div>
                <i class="fa-solid fa-notes-medical"></i>
                Patient Clinical Information
            </div>

            <span>
                Important patient history
            </span>

        </div>


        <div class="clinical-body">

            <div class="clinical-grid">


                <!-- ALLERGIES -->

                <div class="clinical-item allergy">

                    <div class="clinical-icon">
                        <i class="fa-solid fa-triangle-exclamation"></i>
                    </div>

                    <div class="clinical-content">

                        <span>Allergies</span>

                        @if (string.IsNullOrWhiteSpace(patient?.Allergies))
                        {
                            <strong class="clinical-none">
                                No allergies recorded
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.Allergies
                            </strong>
                        }

                    </div>

                </div>


                <!-- MEDICAL CONDITIONS -->

                <div class="clinical-item condition">

                    <div class="clinical-icon">
                        <i class="fa-solid fa-heart-pulse"></i>
                    </div>

                    <div class="clinical-content">

                        <span>Medical Conditions</span>

                        @if (string.IsNullOrWhiteSpace(patient?.MedicalConditions))
                        {
                            <strong class="clinical-none">
                                No medical conditions recorded
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.MedicalConditions
                            </strong>
                        }

                    </div>

                </div>


                <!-- MEDICATION -->

                <div class="clinical-item medication">

                    <div class="clinical-icon">
                        <i class="fa-solid fa-pills"></i>
                    </div>

                    <div class="clinical-content">

                        <span>Current Medication</span>

                        @if (string.IsNullOrWhiteSpace(patient?.Medication))
                        {
                            <strong class="clinical-none">
                                No medication recorded
                            </strong>
                        }
                        else
                        {
                            <strong>
                                @patient.Medication
                            </strong>
                        }

                    </div>

                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         DOCTOR CLINICAL NOTES
         ========================================================= -->

    <div class="notes-card">

        <div class="section-header">

            <i class="fa-solid fa-notes-medical"></i>

            <span>Doctor Clinical Notes</span>

        </div>

        <div class="notes-body">

            @if (string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes))
            {
                <span class="empty-text">
                    No clinical notes were provided.
                </span>
            }
            else
            {
                <p>
                    @test.TestRequest.ClinicalNotes
                </p>
            }

        </div>

    </div>


    <!-- =========================================================
         VERIFICATION FEEDBACK
         ========================================================= -->

    <div class="feedback-card">

        <div class="feedback-header">

            <div>
                <i class="fa-solid fa-triangle-exclamation"></i>
                Verification Feedback
            </div>

            <span>Returned for correction</span>

        </div>


        <div class="feedback-body">

            <div class="feedback-meta">

                <div>
                    <small>Returned by</small>

                    <strong>
                        @verification?.VerifiedByTechnicianId
                    </strong>
                </div>

                <div>
                    <small>Date</small>

                    <strong>
                        @(verification != null
                            ? verification.VerificationDate.ToString(
                                "dd MMM yyyy HH:mm")
                            : "Not available")
                    </strong>
                </div>

            </div>


            <div class="feedback-reason">

                <small>Reason for return</small>

                <div>
                    @verification?.VerificationNotes
                </div>

            </div>

        </div>

    </div>


    <!-- =========================================================
         UPDATE RESULT
         ========================================================= -->

    <div class="result-card">

        <div class="result-header">

            <div>
                <i class="fa-solid fa-pen-to-square"></i>
                Update Laboratory Result
            </div>

            <span>
                Correct the returned result
            </span>

        </div>


        <form asp-action="Review"
              method="post"
              class="result-form">

            <input asp-for="ResultId" type="hidden" />

            <input asp-for="TestRequestItemId" type="hidden" />


            <div class="result-grid">


                <!-- RESULT VALUE -->

                <div class="form-field">

                    <label asp-for="ResultValue">
                        Result Value
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-flask"></i>

                        <input asp-for="ResultValue"
                               class="result-input"
                               placeholder="Enter result value" />

                    </div>

                    <span asp-validation-for="ResultValue"
                          class="validation-error">
                    </span>

                </div>


                <!-- UNITS -->

                <div class="form-field">

                    <label asp-for="Units">
                        Units
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-ruler"></i>

                        <input asp-for="Units"
                               class="result-input"
                               placeholder="e.g. g/dL" />

                    </div>

                </div>


                <!-- REFERENCE RANGE -->

                <div class="form-field full-width">

                    <label asp-for="ReferenceRange">
                        Reference Range
                    </label>

                    <div class="input-wrapper">

                        <i class="fa-solid fa-chart-line"></i>

                        <input asp-for="ReferenceRange"
                               class="result-input"
                               placeholder="e.g. 12.0 - 16.0" />

                    </div>

                </div>


                <!-- COMMENTS -->

                <div class="form-field full-width">

                    <label asp-for="Comments">
                        Laboratory Comments
                    </label>

                    <textarea asp-for="Comments"
                              class="result-textarea"
                              rows="5"
                              placeholder="Enter any relevant laboratory comments...">
                    </textarea>

                </div>

            </div>


            <!-- ACTIONS -->

            <div class="result-actions">

                <a asp-action="Index"
                   class="cancel-button">

                    <i class="fa-solid fa-arrow-left"></i>

                    Cancel

                </a>


                <button type="submit"
                        class="submit-button">

                    <i class="fa-solid fa-paper-plane"></i>

                    Save & Resubmit

                </button>

            </div>

        </form>

    </div>

</div>


@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}


<style>

    :root {
        --rv-primary: #0d766e;
        --rv-primary-dark: #095a54;
        --rv-primary-light: #e7f5f3;
        --rv-text: #1f2937;
        --rv-muted: #6b7280;
        --rv-border: #e5e7eb;
        --rv-bg: #f5f7fa;
        --rv-card: #ffffff;
        --rv-red: #dc3545;
        --rv-red-light: #fbe9ea;
        --rv-gold: #b98900;
        --rv-gold-light: #fbf2dc;
        --rv-blue: #3578a6;
        --rv-blue-light: #e8f1f7;
        --rv-green: #2e8b57;
        --rv-green-light: #e7f4ec;
    }


    /* =========================================================
           PAGE
           ========================================================= */

    .review-page {
        max-width: 1200px;
        margin: 0 auto;
        padding: 25px 20px 60px;
        font-family: "Segoe UI", Arial, sans-serif;
        color: var(--rv-text);
    }


    /* =========================================================
           HEADER
           ========================================================= */

    .review-header {
        background: linear-gradient( 135deg, #0d766e, #0a5d57 );
        color: white;
        border-radius: 18px;
        padding: 28px 32px;
        display: flex;
        align-items: center;
        gap: 20px;
        margin-bottom: 22px;
        box-shadow: 0 8px 25px rgba(0,0,0,.08);
    }


    .review-header-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: rgba(255,255,255,.16);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 28px;
        flex-shrink: 0;
    }


    .review-header h1 {
        margin: 0 0 5px;
        font-size: 27px;
        font-weight: 700;
    }


    .review-header p {
        margin: 0;
        font-size: 14px;
        opacity: .9;
    }


    /* =========================================================
           INFORMATION GRID
           ========================================================= */

    .information-grid {
        display: grid;
        grid-template-columns: 1fr 1.45fr;
        gap: 20px;
        margin-bottom: 20px;
        align-items: stretch;
    }


    .information-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--rv-border);
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
    }


    .card-header {
        padding: 17px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 14px;
    }


        .card-header i {
            margin-right: 8px;
        }


    .patient-header {
        background: linear-gradient( 135deg, #0d766e, #0a5d57 );
        color: white;
    }


    .test-header {
        background: linear-gradient( 135deg, #3578a6, #285f86 );
        color: white;
    }


    .request-pill {
        background: rgba(255,255,255,.18);
        padding: 6px 12px;
        border-radius: 30px;
        font-size: 11px;
    }


    .card-body {
        padding: 22px;
    }


    /* =========================================================
           PATIENT PROFILE
           ========================================================= */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 14px;
        padding-bottom: 18px;
        margin-bottom: 18px;
        border-bottom: 1px solid var(--rv-border);
    }


    .patient-avatar {
        width: 54px;
        height: 54px;
        border-radius: 50%;
        background: var(--rv-primary);
        color: white;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 20px;
        font-weight: 700;
        flex-shrink: 0;
    }


    .patient-label {
        display: block;
        color: var(--rv-muted);
        font-size: 11px;
        text-transform: uppercase;
        margin-bottom: 3px;
    }


    .patient-profile h2 {
        margin: 0 0 3px;
        font-size: 19px;
        font-weight: 700;
    }


    .patient-id {
        font-size: 12px;
        color: var(--rv-muted);
    }


    /* =========================================================
           DETAIL GRID
           ========================================================= */

    .detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 17px 14px;
    }


    .detail-item small {
        display: block;
        color: var(--rv-muted);
        font-size: 10px;
        text-transform: uppercase;
        margin-bottom: 5px;
    }


        .detail-item small i {
            color: var(--rv-primary);
            margin-right: 4px;
        }


    .detail-item strong {
        display: block;
        font-size: 12.5px;
        line-height: 1.4;
        word-break: break-word;
    }


    /* =========================================================
           TEST MAIN
           ========================================================= */

    .test-main {
        display: flex;
        align-items: center;
        gap: 16px;
        padding-bottom: 20px;
        margin-bottom: 20px;
        border-bottom: 1px solid var(--rv-border);
    }


    .test-icon {
        width: 62px;
        height: 62px;
        border-radius: 16px;
        background: var(--rv-blue-light);
        color: var(--rv-blue);
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 25px;
        flex-shrink: 0;
    }


    .test-main-info > span {
        display: block;
        color: var(--rv-muted);
        font-size: 11px;
        text-transform: uppercase;
        margin-bottom: 3px;
    }


    .test-main-info h2 {
        margin: 0 0 7px;
        font-size: 22px;
        font-weight: 700;
    }


    .test-category {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        background: var(--rv-blue-light);
        color: var(--rv-blue);
        padding: 5px 10px;
        border-radius: 20px;
        font-size: 11px;
        font-weight: 600;
    }


    /* =========================================================
           TEST DETAILS
           ========================================================= */

    .test-detail-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
        gap: 13px;
    }


    .test-detail-item {
        display: flex;
        align-items: center;
        gap: 10px;
        padding: 12px;
        border: 1px solid var(--rv-border);
        border-radius: 11px;
        background: #fafcfc;
    }


    .test-detail-icon {
        width: 36px;
        height: 36px;
        border-radius: 9px;
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
    }


        .test-detail-icon.sample {
            background: var(--rv-red-light);
            color: var(--rv-red);
        }


        .test-detail-icon.unit {
            background: var(--rv-primary-light);
            color: var(--rv-primary);
        }


        .test-detail-icon.range {
            background: var(--rv-gold-light);
            color: var(--rv-gold);
        }


        .test-detail-icon.time {
            background: var(--rv-blue-light);
            color: var(--rv-blue);
        }


    .test-detail-item small {
        display: block;
        color: var(--rv-muted);
        font-size: 10px;
        margin-bottom: 3px;
    }


    .test-detail-item strong {
        font-size: 12px;
    }


    /* =========================================================
           CLINICAL INFORMATION
           ========================================================= */

    .clinical-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--rv-border);
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
        margin-bottom: 20px;
    }


    .clinical-header {
        background: linear-gradient( 135deg, #0d766e, #0a5d57 );
        color: white;
        padding: 17px 20px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        font-weight: 700;
        font-size: 14px;
    }


        .clinical-header i {
            margin-right: 8px;
        }


        .clinical-header span {
            background: rgba(255,255,255,.16);
            padding: 5px 11px;
            border-radius: 20px;
            font-size: 10px;
            font-weight: 500;
        }


    .clinical-body {
        padding: 18px;
    }


    .clinical-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
        gap: 14px;
    }


    .clinical-item {
        display: flex;
        align-items: flex-start;
        gap: 12px;
        padding: 15px;
        border-radius: 12px;
    }


        .clinical-item.allergy {
            background: var(--rv-red-light);
            color: #8b2e33;
        }


        .clinical-item.condition {
            background: var(--rv-gold-light);
            color: #76591c;
        }


        .clinical-item.medication {
            background: var(--rv-primary-light);
            color: var(--rv-primary-dark);
        }


    .clinical-icon {
        width: 38px;
        height: 38px;
        border-radius: 10px;
        background: rgba(255,255,255,.65);
        display: flex;
        align-items: center;
        justify-content: center;
        flex-shrink: 0;
        font-size: 16px;
    }


    .clinical-content {
        min-width: 0;
    }


        .clinical-content span {
            display: block;
            font-size: 10px;
            text-transform: uppercase;
            font-weight: 700;
            margin-bottom: 5px;
            opacity: .75;
        }


        .clinical-content strong {
            display: block;
            font-size: 13px;
            line-height: 1.5;
            word-break: break-word;
        }


    .clinical-none {
        opacity: .65;
        font-weight: 500 !important;
    }


    /* =========================================================
           NOTES
           ========================================================= */

    .notes-card {
        background: white;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid var(--rv-border);
        box-shadow: 0 4px 20px rgba(0,0,0,.05);
        margin-bottom: 20px;
    }


    .section-header {
        background: var(--rv-primary-light);
        color: var(--rv-primary-dark);
        padding: 14px 20px;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }


        .section-header i {
            margin-right: 8px;
        }


    .notes-body {
        padding: 18px 20px;
        font-size: 13.5px;
        line-height: 1.7;
    }


        .notes-body p {
            margin: 0;
        }


    .empty-text {
        color: var(--rv-muted);
        font-style: italic;
    }


    /* =========================================================
           FEEDBACK
           ========================================================= */

    .feedback-card {
        background: #fffdf7;
        border-radius: 18px;
        overflow: hidden;
        border: 1px solid #f1dfb4;
        box-shadow: 0 4px 20px rgba(0,0,0,.04);
        margin-bottom: 20px;
    }


    .feedback-header {
        background: var(--rv-gold-light);
        color: var(--rv-gold);
        padding: 15px 20px;
        display: flex;
        justify-content: space-between;
        align-items: center;
        font-size: 13px;
        font-weight: 700;
        text-transform: uppercase;
    }


        .feedback-header i {
            margin-right: 8px;
        }


        .feedback-header span {
            background: rgba(185,137,0,.12);
            padding: 5px 10px;
            border-radius: 20px;
            font-size: 10px;
        }


    .feedback-body {
        padding: 20px;
    }


    .feedback-meta {
        display: flex;
        gap: 50px;
        margin-bottom: 18px;
        flex-wrap: wrap;
    }


        .feedback-meta small,
        .feedback-reason > small {
            display: block;
            color: var(--rv-muted);
            font-size: 10px;
            text-transform: uppercase;
            margin-bottom: 5px;
        }


        .feedback-meta strong {
            font-size: 13px;
        }


    .feedback-reason div {
        background: white;
        border: 1px solid #f1dfb4;
