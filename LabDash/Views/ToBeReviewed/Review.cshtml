@model LabDash.Models.TestResult
@using LabDash.Models

@{
    ViewData["Title"] = "Review Test Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var verification = ViewBag.Verification as TestVerification;

    var patientName = $"{patient?.Name} {patient?.Surname}".Trim();
    var initials = !string.IsNullOrWhiteSpace(patient?.Name)
        ? patient.Name.Substring(0, 1).ToUpper()
        : "P";

    var referenceRange = test?.TestType?.ReferenceRangeLow != null
        && test?.TestType?.ReferenceRangeHigh != null
        ? $"{test.TestType.ReferenceRangeLow} - {test.TestType.ReferenceRangeHigh}"
        : "Not specified";

    var isAbnormal = Model.IsAbnormal;
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link href="https://fonts.googleapis.com/css2?family=Poppins:wght@500;600;700;800&family=Inter:wght@400;500;600;700&display=swap"
      rel="stylesheet">

<div class="review-page">

    <!-- PATIENT + TEST INFORMATION -->

    <div class="information-grid">

        <!-- PATIENT INFORMATION: LEFT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-user"></i> Patient Information</span>
            </div>

            <div class="card-body">

                <div class="patient-profile">
                    <div class="patient-avatar">
                        <i class="fa-solid fa-user"></i>
                    </div>

                    <div class="profile-details">
                        <span class="eyebrow">PATIENT</span>
                        <h2>@patientName</h2>
                    </div>
                </div>

                <div class="patient-detail-list">

                    <div class="patient-detail-row">
                        <span>ID Number</span>
                        <strong>@(patient?.IDNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Email</span>
                        <strong>@(patient?.Email ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Cellphone</span>
                        <strong>@(patient?.CellphoneNumber ?? "Not provided")</strong>
                    </div>

                    <div class="patient-detail-row">
                        <span>Date of Birth</span>
                        <strong>
                            @(patient != null
                                ? patient.DOB.ToString("dd MMM yyyy")
                                : "Not provided")
                        </strong>
                    </div>

                </div>

                <!-- CLINICAL INFORMATION -->

                <div class="section-label">
                    <i class="fa-solid fa-notes-medical"></i>
                    Clinical Information
                </div>

                <div class="clinical-list">

                    <div class="clinical-item allergy">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-triangle-exclamation"></i>
                            <strong>Allergies</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Allergies)
                                ? "None recorded"
                                : patient.Allergies)
                        </p>
                    </div>

                    <div class="clinical-item condition">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-heart-pulse"></i>
                            <strong>Medical Conditions</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.MedicalConditions)
                                ? "None recorded"
                                : patient.MedicalConditions)
                        </p>
                    </div>

                    <div class="clinical-item medication">
                        <div class="clinical-item-heading">
                            <i class="fa-solid fa-pills"></i>
                            <strong>Medication</strong>
                        </div>
                        <p>
                            @(string.IsNullOrWhiteSpace(patient?.Medication)
                                ? "None recorded"
                                : patient.Medication)
                        </p>
                    </div>

                </div>

                <!-- DOCTOR NOTES -->

                <div class="section-label">
                    <i class="fa-solid fa-file-medical"></i>
                    Doctor Clinical Notes
                </div>

                <div class="doctor-notes">
                    <div class="notes-heading">
                        <i class="fa-solid fa-user-doctor"></i>
                        Doctor's Notes
                    </div>

                    <p>
                        @(string.IsNullOrWhiteSpace(test?.TestRequest?.ClinicalNotes)
                            ? "No clinical notes were provided."
                            : test.TestRequest.ClinicalNotes)
                    </p>
                </div>

            </div>
        </section>

        <!-- TEST INFORMATION: RIGHT -->

        <section class="information-card">

            <div class="card-header">
                <span><i class="fa-solid fa-vials"></i> Test Information</span>
            </div>

            <div class="card-body">

                <div class="test-profile">

                    <div class="test-icon">
                        <i class="fa-solid fa-vial"></i>
                    </div>

                    <div class="test-profile-details">
                        <span class="eyebrow">LABORATORY TEST</span>

                        <h2>@(test?.TestType?.Name ?? "Laboratory Test")</h2>

                        <span class="category-pill">
                            <i class="fa-solid fa-layer-group"></i>
                            @(test?.TestType?.Category ?? "Uncategorised")
                        </span>
                    </div>

                    <span class="request-pill">
                        TR-@test?.RequestId
                    </span>

                </div>

                <div class="test-detail-grid">

                    <div class="test-detail">
                        <span><i class="fa-solid fa-droplet"></i> Sample Type</span>
                        <strong>
                            @(test?.TestType?.RequiredSampleType ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-flask"></i> Test Category</span>
                        <strong>
                            @(test?.TestType?.Category ?? "Not specified")
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span>Request Number</span>
                        <strong>TR-@test?.RequestId</strong>
                    </div>

                    <div class="test-detail">
                        <span>Test Item</span>
                        <strong>#@Model.TestRequestItemId</strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-ruler"></i> Unit of Measurement</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.Units)
                                ? test?.TestType?.UnitOfMeasurement ?? "Not specified"
                                : Model.Units)
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-chart-line"></i> Reference Range</span>
                        <strong>
                            @(string.IsNullOrWhiteSpace(Model.ReferenceRange)
                                ? referenceRange
                                : Model.ReferenceRange)
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-circle-check"></i> Current Status</span>
                        <strong>
                            <span class="status-pill completed">
                                <i class="fa-solid fa-circle-check"></i>
                                Completed
                            </span>
                        </strong>
                    </div>

                    <div class="test-detail">
                        <span><i class="fa-solid fa-triangle-exclamation"></i> Result Classification</span>
                        <strong>
                            @if (isAbnormal)
                            {
                                <span class="status-pill abnormal">
                                    <i class="fa-solid fa-triangle-exclamation"></i>
                                    Abnormal
                                </span>
                            }
                            else
                            {
                                <span class="status-pill normal">
                                    <i class="fa-solid fa-circle-check"></i>
                                    Within Range
                                </span>
                            }
                        </strong>
                    </div>

                </div>

                <div class="configured-range">
                    <span>Configured Reference Range</span>
                    <strong>
                        @referenceRange
                        @if (!string.IsNullOrWhiteSpace(test?.TestType?.UnitOfMeasurement))
                        {
                            <small>@test.TestType.UnitOfMeasurement</small>
                        }
                    </strong>
                </div>

                <!-- CURRENT RESULT -->

                <div class="current-result">
                    <div class="current-result-heading">
                        <i class="fa-solid fa-file-waveform"></i>
                        Previously Captured Result
                    </div>

                    <div class="current-result-value">
                        <span>Result Value</span>
                        <strong>@(Model.ResultValue ?? "Not recorded")</strong>
                    </div>

                    @if (!string.IsNullOrWhiteSpace(Model.Comments))
                    {
                        <div class="current-result-comments">
                            <span>Laboratory Comments</span>
                            <p>@Model.Comments</p>
                        </div>
                    }
                </div>

            </div>
        </section>

    </div>

    <!-- VERIFICATION FEEDBACK -->

    <section class="information-card feedback-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-rotate-left"></i>
                Verification Feedback
            </span>

            <span class="returned-badge">Returned for Correction</span>
        </div>

        <div class="feedback-body">

            <div class="feedback-meta">

                <div>
                    <span>Returned By</span>
                    <strong>
                        @(verification?.VerifiedByTechnicianId?.ToString()
                            ?? "Not available")
                    </strong>
                </div>

                <div>
                    <span>Date Returned</span>
                    <strong>
                        @(verification != null
                            ? verification.VerificationDate.ToString("dd MMM yyyy HH:mm")
                            : "Not available")
                    </strong>
                </div>

            </div>

            <div class="feedback-reason">
                <span>Reason for Return</span>
                <p>
                    @(string.IsNullOrWhiteSpace(verification?.VerificationNotes)
                        ? "No verification comments were recorded."
                        : verification.VerificationNotes)
                </p>
            </div>

        </div>
    </section>

    <!-- UPDATE RESULT -->

    <section class="information-card result-card">

        <div class="card-header">
            <span>
                <i class="fa-solid fa-pen-to-square"></i>
                Update Laboratory Result
            </span>

            <span class="header-subtitle">Correct and resubmit the result</span>
        </div>

        <form asp-action="Review" method="post" class="result-form">

            <input asp-for="ResultId" type="hidden" />
            <input asp-for="TestRequestItemId" type="hidden" />

            <div asp-validation-summary="ModelOnly"
                 class="validation-summary"></div>

            <div class="result-grid">

                <div class="form-field">
                    <label asp-for="ResultValue">Result Value</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-flask"></i>
                        <input asp-for="ResultValue"
                               class="form-control"
                               placeholder="Enter result value" />
                    </div>

                    <span asp-validation-for="ResultValue"
                          class="validation-error"></span>
                </div>

                <div class="form-field">
                    <label asp-for="Units">Units</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-ruler"></i>
                        <input asp-for="Units"
                               class="form-control"
                               placeholder="e.g. g/dL, %, mmol/L" />
                    </div>

                    <span asp-validation-for="Units"
                          class="validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label asp-for="ReferenceRange">Reference Range</label>

                    <div class="input-wrapper">
                        <i class="fa-solid fa-chart-line"></i>
                        <input asp-for="ReferenceRange"
                               class="form-control"
                               placeholder="Enter the reference range" />
                    </div>

                    <span asp-validation-for="ReferenceRange"
                          class="validation-error"></span>
                </div>

                <div class="form-field full-width">
                    <label asp-for="Comments">Laboratory Comments</label>

                    <textarea asp-for="Comments"
                              class="form-control result-textarea"
                              rows="4"
                              placeholder="Enter any relevant laboratory comments..."></textarea>

                    <span asp-validation-for="Comments"
                          class="validation-error"></span>
                </div>

            </div>

            <div class="result-actions">

                <a asp-action="Index" class="cancel-button">
                    <i class="fa-solid fa-arrow-left"></i>
                    Cancel
                </a>

                <button type="submit" class="submit-button">
                    <i class="fa-solid fa-paper-plane"></i>
                    Save &amp; Resubmit
                </button>

            </div>

        </form>
    </section>

</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}

<style>
    :root {
        --teal: #008f83;
        --teal-dark: #006f67;
        --teal-deep: #005c55;
        --teal-bright: #00a99a;
        --teal-light: #e8f7f5;
        --teal-soft: #f1faf8;
        --teal-border: #ccebe7;
        --text: #173a3a;
        --muted: #718785;
        --page-bg: #f3faf9;
        --border: #dfedeb;
        --red: #dc3545;
        --red-bg: #fde9eb;
        --gold: #a87308;
        --gold-bg: #fff3d9;
    }

    .review-page,
    .review-page * {
        box-sizing: border-box;
    }

    .review-page {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 22px 24px 48px;
        background: var(--page-bg);
        color: var(--text);
        font-family: "Inter", sans-serif;
    }

    /* MAIN TWO-COLUMN LAYOUT */

    .information-grid {
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
        align-items: stretch;
        gap: 20px;
        margin-bottom: 20px;
    }

    .information-card {
        min-width: 0;
        overflow: hidden;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 17px;
        box-shadow: 0 5px 20px rgba(16, 79, 72, .055);
    }

    .information-grid > .information-card {
        height: 100%;
    }

    /* TEAL CARD HEADERS */

    .card-header {
        min-height: 47px;
        padding: 13px 19px;
        display: flex;
        align-items: center;
        justify-content: space-between;
        gap: 12px;
        background: var(--teal);
        color: #fff;
        font-family: "Poppins", sans-serif;
        font-size: 13px;
        font-weight: 700;
    }

        .card-header > span:first-child {
            display: inline-flex;
            align-items: center;
            gap: 9px;
        }

        .card-header i {
            flex-shrink: 0;
        }

    .card-body {
        padding: 18px;
    }

    /* PATIENT PROFILE */

    .patient-profile {
        display: flex;
        align-items: center;
        gap: 13px;
        padding: 14px;
        margin-bottom: 14px;
        background: linear-gradient(120deg, var(--teal-light), #f8fcfb);
        border: 1px solid var(--teal-border);
        border-radius: 13px;
    }

    .patient-avatar,
    .test-icon {
        width: 49px;
        height: 49px;
        flex: 0 0 49px;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 13px;
        background: #d4efeb;
        color: var(--teal-dark);
        font-size: 21px;
    }

    .profile-details,
    .test-profile-details {
        min-width: 0;
    }

    .eyebrow {
        display: block;
        margin-bottom: 3px;
        color: var(--muted);
        font-size: 9px;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: .35px;
    }

    .patient-profile h2,
    .test-profile h2 {
        margin: 0;
        color: var(--teal-deep);
        font-family: "Poppins", sans-serif;
        font-size: 16px;
        line-height: 1.4;
        font-weight: 800;
        overflow-wrap: anywhere;
    }

    .patient-detail-list {
        margin-bottom: 17px;
    }

    .patient-detail-row {
        min-height: 35px;
        padding: 9px 2px;
        display: flex;
        align-items: flex-start;
        justify-content: space-between;
        gap: 14px;
        border-bottom: 1px solid #e8f0ef;
        font-size: 11px;
    }

        .patient-detail-row span {
            color: var(--muted);
            flex-shrink: 0;
        }

        .patient-detail-row strong {
            max-width: 65%;
            text-align: right;
            font-weight: 700;
            overflow-wrap: anywhere;
        }

    /* SECTION LABELS */

    .section-label {
        display: flex;
        align-items: center;
        gap: 8px;
        margin: 17px 0 10px;
        color: var(--teal-dark);
        font-family: "Poppins", sans-serif;
        font-size: 11px;
        font-weight: 800;
        text-transform: uppercase;
    }

    /* CLINICAL INFORMATION */

    .clinical-list {
        display: grid;
        grid-template-columns: 1fr;
        gap: 8px;
    }

    .clinical-item {
        padding: 10px 12px;
        border: 1px solid transparent;
        border-radius: 11px;
    }

        .clinical-item.allergy {
            color: #a52b36;
            background: var(--red-bg);
            border-color: #f8cdd1;
        }

        .clinical-item.condition {
            color: #8c6108;
            background: var(--gold-bg);
            border-color: #f5dfaa;
        }

        .clinical-item.medication {
            color: var(--teal-dark);
            background: #e1f4f2;
            border-color: #c4e9e5;
        }

    .clinical-item-heading {
        display: flex;
        align-items: center;
        gap: 7px;
        margin-bottom: 4px;
        font-size: 10px;
    }

    .clinical-item p {
        margin: 0;
        font-size: 11px;
        line-height: 1.6;
        overflow-wrap: anywhere;
    }

    /* DOCTOR NOTES */

    .doctor-notes {
        padding: 13px 14px;
        background: var(--teal-soft);
        border: 1px solid var(--teal-border);
        border-left: 4px solid var(--teal);
        border-radius: 11px;
    }

    .notes-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 8px;
        color: var(--teal-dark);
        font-size: 10px;
        font-weight: 800;
        text-transform: uppercase;
    }

    .doctor-notes p {
        margin: 0;
        color: #456764;
        font-size: 11px;
        line-height: 1.8;
        overflow-wrap: anywhere;
    }

    /* TEST PROFILE */

    .test-profile {
        display: flex;
        align-items: center;
        gap: 12px;
        position: relative;
        padding: 15px;
        margin-bottom: 15px;
        background: linear-gradient(120deg, var(--teal-light), #f8fcfb);
        border: 2px solid #b9e3dd;
        border-radius: 14px;
    }

    .test-icon {
        width: 51px;
        height: 51px;
        flex-basis: 51px;
        font-size: 22px;
    }

    .test-profile-details {
        flex: 1;
    }

    .test-profile h2 {
        margin-bottom: 5px;
        font-size: 16px;
    }

    .category-pill {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 4px 9px;
        color: var(--teal-dark);
        background: #fff;
        border: 1px solid var(--teal-border);
        border-radius: 20px;
        font-size: 9px;
        font-weight: 700;
    }

    .request-pill {
        align-self: flex-start;
        flex-shrink: 0;
        padding: 5px 8px;
        background: #fff;
        color: var(--teal-dark);
        border: 1px solid var(--teal-border);
        border-radius: 20px;
        font-size: 10px;
        font-weight: 800;
    }

    /* TEST DETAIL GRID */

    .test-detail-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 9px;
    }

    .test-detail {
        min-width: 0;
        min-height: 58px;
        padding: 10px;
        background: #f7fbfa;
        border: 1px solid var(--border);
        border-radius: 11px;
    }

        .test-detail > span {
            display: block;
            margin-bottom: 5px;
            color: #68817e;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
        }

            .test-detail > span i {
                margin-right: 3px;
                color: var(--teal);
            }

        .test-detail > strong {
            display: block;
            color: var(--text);
            font-size: 11px;
            line-height: 1.5;
            overflow-wrap: anywhere;
        }

    .status-pill {
        display: inline-flex;
        align-items: center;
        gap: 5px;
        padding: 4px 8px;
        border-radius: 20px;
        font-size: 9px;
        font-weight: 800;
        white-space: nowrap;
    }

        .status-pill.completed,
        .status-pill.normal {
            color: #16834e;
            background: #e2f5e9;
        }

        .status-pill.abnormal {
            color: #c52f42;
            background: #fde6e9;
        }

    .configured-range {
        padding: 13px;
        margin-top: 13px;
        background: #edf8f6;
        border: 1px solid var(--teal-border);
        border-radius: 11px;
    }

        .configured-range > span,
        .current-result-value > span,
        .current-result-comments > span {
            display: block;
            margin-bottom: 5px;
            color: #68817e;
            font-size: 9px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .configured-range > strong {
            color: var(--teal-deep);
            font-family: "Poppins", sans-serif;
            font-size: 14px;
            overflow-wrap: anywhere;
        }

        .configured-range small {
            margin-left: 4px;
            font-family: "Inter", sans-serif;
            font-size: 10px;
            font-weight: 500;
        }

    /* PREVIOUS RESULT */

    .current-result {
        margin-top: 16px;
        padding: 14px;
        background: #fff;
        border: 1px solid var(--border);
        border-radius: 12px;
    }

    .current-result-heading {
        display: flex;
        align-items: center;
        gap: 8px;
        margin-bottom: 13px;
        color: var(--teal-dark);
        font-size: 11px;
        font-weight: 800;
    }

    .current-result-value strong {
        color: var(--text);
        font-family: "Poppins", sans-serif;
        font-size: 19px;
        overflow-wrap: anywhere;
    }

    .current-result-comments {
        margin-top: 12px;
        padding-top: 11px;
        border-top: 1px solid var(--border);
    }

        .current-result-comments p {
            margin: 0;
            color: #526b68;
            font-size: 11px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

    /* VERIFICATION FEEDBACK */

    .feedback-card,
    .result-card {
        margin-bottom: 20px;
    }

    .returned-badge {
        padding: 5px 9px;
        background: rgba(255,255,255,.16);
        border-radius: 20px;
        font-family: "Inter", sans-serif;
        font-size: 9px;
        font-weight: 600;
    }

    .feedback-body {
        padding: 19px;
    }

    .feedback-meta {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 15px;
        margin-bottom: 17px;
    }

        .feedback-meta > div {
            padding: 12px;
            background: #f7fbfa;
            border: 1px solid var(--border);
            border-radius: 10px;
        }

        .feedback-meta span,
        .feedback-reason > span {
            display: block;
            margin-bottom: 6px;
            color: var(--muted);
            font-size: 10px;
            font-weight: 700;
            text-transform: uppercase;
        }

        .feedback-meta strong {
            font-size: 12px;
            overflow-wrap: anywhere;
        }

    .feedback-reason {
        padding: 14px;
        background: #fff8e9;
        border: 1px solid #f1dfb4;
        border-left: 4px solid #d8a12a;
        border-radius: 10px;
    }

        .feedback-reason p {
            margin: 0;
            color: #70551c;
            font-size: 12px;
            line-height: 1.7;
            overflow-wrap: anywhere;
        }

    /* RESULT FORM */

    .header-subtitle {
        color: rgba(255,255,255,.9);
        font-family: "Inter", sans-serif;
        font-size: 10px;
        font-weight: 500;
    }

    .result-form {
        padding: 22px;
    }

    .result-grid {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 18px;
    }

