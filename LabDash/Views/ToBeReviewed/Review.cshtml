@model LabDash.Models.TestResult

@using LabDash.Models

@{
    ViewData["Title"] = "Review Test Result";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";

    var test = ViewBag.TestItem as TestRequestItem;
    var patient = ViewBag.Patient as Patient;
    var verification = ViewBag.Verification as TestVerification;
}

<div class="container-fluid">

    <div class="card shadow-lg border-0">

        <div class="card-header text-white" style="background:#0d766e;">

            <h3 class="mb-0">
                <i class="fa-solid fa-rotate-left"></i>
                Returned Test Review
            </h3>

        </div>

        <div class="card-body">

            <!-- Patient Information -->

            <div class="row mb-4">

                <div class="col-md-6">

                    <div class="card border-success">

                        <div class="card-header bg-success text-white">

                            Patient Information

                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Name:</strong>
                                @patient?.Name @patient?.Surname
                            </p>

                            <p>
                                <strong>ID Number:</strong>
                                @patient?.IDNumber
                            </p>

                            <p>
                                <strong>Email:</strong>
                                @patient?.Email
                            </p>

                        </div>

                    </div>

                </div>

                <div class="col-md-6">

                    <div class="card border-primary">

                        <div class="card-header bg-primary text-white">

                            Test Information

                        </div>

                        <div class="card-body">

                            <p>
                                <strong>Request:</strong>
                                TR-@test?.RequestId
                            </p>

                            <p>
                                <strong>Test:</strong>
                                @test?.TestType?.Name
                            </p>

                            <p>
                                <strong>Category:</strong>
                                @test?.TestType?.Category
                            </p>

                        </div>

                    </div>

                </div>

            </div>

            <!-- Doctor Notes -->

            <div class="card border-info mb-4">

                <div class="card-header bg-info text-white">

                    Doctor Clinical Notes

                </div>

                <div class="card-body">

                    @test?.TestRequest?.ClinicalNotes

                </div>

            </div>

            <!-- Verification Feedback -->

            <div class="card border-warning mb-4">

                <div class="card-header bg-warning">

                    Verification Feedback

                </div>

                <div class="card-body">

                    <p>

                        <strong>Returned By:</strong>

                        @verification?.VerifiedByTechnicianId

                    </p>

                    <p>

                        <strong>Date:</strong>

                        @verification?.VerificationDate.ToString("dd MMM yyyy HH:mm")

                    </p>

                    <p>

                        <strong>Reason:</strong>

                    </p>

                    <div class="alert alert-warning">

                        @verification?.VerificationNotes

                    </div>

                </div>

            </div>

            <!-- Edit Result -->

            <form asp-action="Review" method="post">

                <input asp-for="ResultId" type="hidden" />

                <input asp-for="TestRequestItemId" type="hidden" />

                <div class="mb-3">

                    <label asp-for="ResultValue" class="form-label"></label>

                    <input asp-for="ResultValue"
                           class="form-control" />

                    <span asp-validation-for="ResultValue"
                          class="text-danger"></span>

                </div>

                <div class="mb-3">

                    <label asp-for="Units" class="form-label"></label>

                    <input asp-for="Units"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="ReferenceRange"
                           class="form-label"></label>

                    <input asp-for="ReferenceRange"
                           class="form-control" />

                </div>

                <div class="mb-3">

                    <label asp-for="Comments"
                           class="form-label"></label>

                    <textarea asp-for="Comments"
                              rows="4"
                              class="form-control"></textarea>

                </div>

                <button type="submit"
                        class="btn btn-success">

                    <i class="fa-solid fa-paper-plane"></i>

                    Save & Resubmit

                </button>

                <a asp-action="Index"
                   class="btn btn-secondary">

                    Cancel

                </a>

            </form>

        </div>

    </div>

</div>

@section Scripts
{
    <partial name="_ValidationScriptsPartial" />
}