@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Tests Returned For Review";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

@if (TempData["Success"] != null)
{
    <div class="alert alert-success">
        <i class="fa-solid fa-circle-check"></i>
        @TempData["Success"]
    </div>
}

<div class="card shadow-lg border-0">

    <div class="card-header text-white"
         style="background:#0d766e;">

        <h3 class="mb-0">
            <i class="fa-solid fa-rotate-left"></i>
            Tests Returned For Review
        </h3>

    </div>

    <div class="card-body">

        @if (!Model.Any())
        {
            <div class="alert alert-info">

                <i class="fa-solid fa-circle-info"></i>

                You have no tests waiting for review.

            </div>
        }
        else
        {

            <table class="table table-hover table-bordered align-middle">

                <thead class="table-light">

                    <tr>

                        <th>Request</th>

                        <th>Test Type</th>

                        <th>Category</th>

                        <th>Completed</th>

                        <th>Status</th>

                        <th>Action</th>

                    </tr>

                </thead>

                <tbody>

                    @foreach (var item in Model)
                    {
                        <tr>

                            <td>
                                TR-@item.RequestId
                            </td>

                            <td>
                                @item.TestType.Name
                            </td>

                            <td>
                                @item.TestType.Category
                            </td>

                            <td>
                                @(item.CompletionDateTime?.ToString("dd MMM yyyy HH:mm"))
                            </td>

                            <td>

                                <span class="badge bg-warning text-dark">

                                    @item.Status

                                </span>

                            </td>

                            <td>

                                <a asp-action="Review"
                                   asp-route-id="@item.TestRequestItemId"
                                   class="btn btn-warning">

                                    <i class="fa-solid fa-pen"></i>

                                    Review Result

                                </a>

                            </td>

                        </tr>
                    }

                </tbody>

            </table>

        }

    </div>

</div>