@model IEnumerable<LabDash.Models.TestRequestItem>

@{
    ViewData["Title"] = "Tests Returned For Review";
    Layout = "~/Views/Shared/_SystemLayout.cshtml";
}

<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&display=swap" rel="stylesheet">

<div class="rv-wrap">

    <!-- HEADER -->

    <div class="rv-hero">
        <div class="rv-hero-icon"><i class="fa-solid fa-rotate-left"></i></div>

        <div>
            <h2>Tests Returned For Review</h2>
            <p>Results awaiting your review and sign-off.</p>
        </div>

        <div class="rv-hero-stat">
            <span>Waiting</span>
            <strong>@Model.Count()</strong>
        </div>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="rv-alert rv-alert-success" role="alert">
            <i class="fa-solid fa-circle-check"></i>
            <span>@TempData["Success"]</span>
        </div>
    }

    <div class="rv-panel">

        <div class="rv-panel-head">
            <h4>
                <i class="fa-solid fa-list-check"></i>
                Returned Tests
                @if (Model.Any())
                {
                    <span class="rv-panel-count">@Model.Count() waiting</span>
                }
            </h4>
        </div>

        <div class="rv-panel-body">

            @if (!Model.Any())
            {
                <div class="rv-empty">
                    <i class="fa-solid fa-circle-check"></i>
                    <h4>All caught up</h4>
                    <p>You have no tests waiting for review right now.</p>
                </div>
            }
            else
            {
                <div class="rv-table-wrap">
                    <table class="rv-table">
                        <thead>
                            <tr>
                                <th>Request</th>
                                <th>Test type</th>
                                <th>Category</th>
                                <th>Completed</th>
                                <th>Status</th>
                                <th class="rv-text-center">Action</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in Model)
                            {
                                <tr>
                                    <td><span class="rv-request-id">TR-@item.RequestId</span></td>
                                    <td class="rv-strong">@item.TestType.Name</td>
                                    <td>
                                        <span class="rv-cat-pill">@item.TestType.Category</span>
                                    </td>
                                    <td class="rv-muted">
                                        @(item.CompletionDateTime?.ToString("dd MMM yyyy HH:mm") ?? "—")
                                    </td>
                                    <td>
                                        <span class="rv-badge rv-badge-warning">
                                            <i class="fa-solid fa-clock-rotate-left"></i>
                                            @item.Status
                                        </span>
                                    </td>
                                    <td class="rv-text-center">
                                        <a asp-action="Review" asp-route-id="@item.TestRequestItemId" class="rv-btn-review">
                                            <i class="fa-solid fa-pen"></i>
                                            Review result
                                        </a>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }

        </div>
    </div>
</div>

<style>
    :root {
        --rv-teal: #0f9488;
        --rv-teal-dark: #0b6f66;
        --rv-teal-deep: #0a5a52;
        --rv-teal-dim: #e1f3f0;
        --rv-teal-soft: #eef7f6;
        --rv-teal-border: #cfe6e3;
        --rv-ink: #0f2f2d;
        --rv-ink-soft: #6b817f;
        --rv-line: #e3ecec;
        --rv-page-bg: #e9f0f1;
        --rv-amber: #a87308;
        --rv-amber-dim: #fff3d9;
        --rv-green: #198754;
        --rv-green-dim: #e2f5e9;
        --rv-radius: 20px;
        --rv-shadow: 0 10px 30px rgba(15, 80, 72, .08);
        --rv-hero-gradient: linear-gradient(135deg, #12a193 0%, #0e857a 45%, #0a5f57 100%);
        --rv-btn-gradient: linear-gradient(135deg, #10978a 0%, #0a5d55 100%);
    }

    .rv-wrap,
    .rv-wrap * {
        box-sizing: border-box;
    }

    .rv-wrap {
        width: 100%;
        max-width: 1500px;
        margin: 0 auto;
        padding: 24px 26px 52px;
        color: var(--rv-ink);
        background: var(--rv-page-bg);
        font-family: 'Inter', sans-serif;
        font-size: 14px;
    }

        .rv-wrap *:focus-visible {
            outline: 3px solid rgba(15, 148, 136, .4);
            outline-offset: 2px;
            border-radius: 8px;
        }

    /* ============ HERO HEADER ============ */

    .rv-hero {
        display: flex;
        align-items: center;
        gap: 16px;
        padding: 24px 28px;
        margin-bottom: 22px;
        color: #fff;
        background: var(--rv-hero-gradient);
        border-radius: 24px;
        box-shadow: 0 12px 30px rgba(10, 95, 87, .22);
    }

    .rv-hero-icon {
        width: 54px;
        height: 54px;
        flex-shrink: 0;
        display: flex;
        align-items: center;
        justify-content: center;
        border-radius: 15px;
        color: #fff;
        background: rgba(255, 255, 255, .16);
        border: 1px solid rgba(255, 255, 255, .32);
        font-size: 22px;
    }

    .rv-hero h2 {
        margin: 0 0 4px;
        color: #fff;
        font-family: 'Inter', sans-serif;
        font-size: 24px;
        font-weight: 700;
        letter-spacing: -.2px;
    }

    .rv-hero p {
        margin: 0;
        color: rgba(255, 255, 255, .86);
        font-size: 13px;
        line-height: 1.5;
    }

    .rv-hero-stat {
        min-width: 150px;
        margin-left: auto;
        padding: 4px 0 4px 22px;
        border-left: 1px solid rgba(255, 255, 255, .28);
    }

        .rv-hero-stat span {
            display: block;
            margin-bottom: 4px;
            color: rgba(255, 255, 255, .78);
            font-size: 10px;
            font-weight: 600;
            letter-spacing: .5px;
            text-transform: uppercase;
        }

        .rv-hero-stat strong {
            color: #fff;
            font-size: 22px;
            font-weight: 700;
        }

    /* ============ ALERT ============ */

    .rv-alert {
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 18px;
        margin-bottom: 22px;
        border-radius: 16px;
        box-shadow: var(--rv-shadow);
        font-size: 13px;
        font-weight: 600;
    }

    .rv-alert-success {
        color: #187341;
        background: var(--rv-green-dim);
        border: 1px solid #ccebd8;
        border-left: 4px solid var(--rv-green);
    }

    .rv-alert i {
        font-size: 16px;
    }

    /* ============ TABLE CARD ============ */

    .rv-panel {
        overflow: hidden;
        background: #fff;
        border: 1px solid rgba(255, 255, 255, .8);
        border-radius: var(--rv-radius);
        box-shadow: var(--rv-shadow);
    }

    .rv-panel-head {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 18px 26px;
        border-bottom: 1px solid var(--rv-line);
    }

        .rv-panel-head h4 {
            display: flex;
            align-items: center;
            gap: 11px;
            margin: 0;
            color: var(--rv-ink);
            font-family: 'Inter', sans-serif;
            font-size: 17px;
            font-weight: 700;
        }

            .rv-panel-head h4 > i {
                color: var(--rv-teal);
                font-size: 16px;
            }

    .rv-panel-count {
        padding: 4px 12px;
        color: var(--rv-teal-dark);
        background: var(--rv-teal-dim);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
        white-space: nowrap;
    }

    .rv-panel-body {
        padding: 0;
    }

    /* ============ EMPTY STATE ============ */

    .rv-empty {
        padding: 60px 24px;
        text-align: center;
    }

        .rv-empty i {
            width: 72px;
            height: 72px;
            margin: 0 auto 18px;
            border-radius: 50%;
            background: var(--rv-teal-dim);
            color: var(--rv-teal);
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 30px;
        }

        .rv-empty h4 {
            margin: 0 0 6px;
            color: var(--rv-ink);
            font-family: 'Inter', sans-serif;
            font-size: 18px;
            font-weight: 700;
        }

        .rv-empty p {
            margin: 0;
            color: var(--rv-ink-soft);
            font-size: 13px;
        }

    /* ============ TABLE ============ */

    .rv-table-wrap {
        overflow-x: auto;
    }

    .rv-table {
        width: 100%;
        border-collapse: separate;
        border-spacing: 0;
        font-size: 14px;
    }

        .rv-table thead th {
            padding: 15px 26px;
            color: var(--rv-teal-dark);
            background: var(--rv-teal-dim);
            border: 0;
            font-family: 'Inter', sans-serif;
            font-size: 11px;
            font-weight: 700;
            letter-spacing: .4px;
            text-align: left;
            text-transform: uppercase;
            white-space: nowrap;
        }

        .rv-table tbody td {
            padding: 18px 26px;
            color: var(--rv-ink);
            background: #fff;
            border-bottom: 1px solid var(--rv-line);
            vertical-align: middle;
        }

        .rv-table tbody tr:last-child td {
            border-bottom: 0;
        }

        .rv-table tbody tr:hover td {
            background: var(--rv-teal-soft);
        }

        .rv-table thead th.rv-text-center,
        .rv-table tbody td.rv-text-center {
            text-align: center;
        }

    .rv-strong {
        font-weight: 600;
    }

    .rv-muted {
        color: var(--rv-ink-soft);
    }

    .rv-request-id {
        color: var(--rv-ink);
        font-family: 'Inter', sans-serif;
        font-size: 14px;
        font-weight: 700;
    }

    .rv-cat-pill {
        display: inline-block;
        padding: 5px 12px;
        color: var(--rv-teal-dark);
        background: var(--rv-teal-dim);
        border-radius: 999px;
        font-size: 12px;
        font-weight: 600;
    }

    .rv-badge {
        display: inline-flex;
        align-items: center;
        gap: 6px;
        padding: 6px 13px;
        border-radius: 999px;
        font-family: 'Inter', sans-serif;
        font-size: 12px;
        font-weight: 700;
    }

    .rv-badge-warning {
        color: var(--rv-amber);
        background: var(--rv-amber-dim);
    }

    .rv-btn-review {
        display: inline-flex;
        align-items: center;
        gap: 8px;
        padding: 10px 18px;
        color: #fff;
        background: var(--rv-btn-gradient);
        border-radius: 12px;
        box-shadow: 0 6px 14px rgba(10, 93, 85, .25);
        font-family: 'Inter', sans-serif;
        font-size: 13px;
        font-weight: 600;
        text-decoration: none;
        white-space: nowrap;
        transition: transform .15s, box-shadow .15s;
    }

        .rv-btn-review:hover {
            color: #fff;
            transform: translateY(-1px);
            box-shadow: 0 9px 20px rgba(10, 93, 85, .34);
        }

    /* ============ RESPONSIVE ============ */

    @@media (max-width: 700px) {
        .rv-hero-stat {
            display: none;
        }

        .rv-table thead th,
        .rv-table tbody td {
            padding: 12px 16px;
        }

        .rv-panel-head {
            padding: 14px 16px;
        }
    }

    @@media (max-width: 500px) {
        .rv-wrap {
            padding: 12px 9px 28px;
        }

        .rv-hero {
            padding: 18px;
            border-radius: 20px;
        }

            .rv-hero h2 {
                font-size: 19px;
            }
    }
</style>